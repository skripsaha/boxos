// boxcxx — <variant>  (C++23, incl. constexpr visit and valueless_by_exception)
//
// Storage is a recursive variadic union so the whole type is usable in
// constant expressions (a byte buffer + reinterpret_cast would not be).
// Conditional triviality rides the same dtor→ctor→assign layer chain as
// <optional>/<expected>. A 3-state-equivalent is encoded directly in the
// index: kValueless (all-ones of the index type) marks both the genuine
// valueless_by_exception state and the transient window inside a copy/move
// constructor body, which is what makes a throw there safe — the storage
// dtor destroys nothing while the index is kValueless.
//
// Alternative dispatch (destroy / copy / move / visit / compare) is an
// O(N) constexpr index match rather than a function-pointer vtable: simpler
// and constexpr-clean. For the small alternative counts variants use in
// practice this is the right trade; see the honest-leftovers note.
#ifndef BOXCXX_VARIANT
#define BOXCXX_VARIANT

#include <__bits/allocator_core>
#include <__bits/enable_special>
#include <compare>
#include <concepts>
#include <cstddef>
#include <functional>
#include <initializer_list>
#include <new>
#include <type_traits>
#include <utility>

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_variant
#include <__bits/version_variant>

namespace std {

template <class... Types>
class variant;

// The free visit is defined far below, after the visitation machinery, but
// variant::visit (P2637R3) delegates to it from inside the class -- and
// std::visit there is a qualified name, looked up where the member is defined,
// not where it is instantiated. Hence these two declarations.
template <class Vis, class... Vars>
constexpr decltype(auto) visit(Vis &&vis, Vars &&...vars);
template <class R, class Vis, class... Vars>
constexpr R visit(Vis &&vis, Vars &&...vars);

inline constexpr size_t variant_npos = static_cast<size_t>(-1);

// ── variant_size / variant_alternative ───────────────────────────────────

template <class T>
struct variant_size;
template <class T>
struct variant_size<const T> : variant_size<T> {};
template <class... Ts>
struct variant_size<variant<Ts...>>
    : integral_constant<size_t, sizeof...(Ts)> {};
template <class T>
inline constexpr size_t variant_size_v = variant_size<T>::value;

template <size_t I, class T>
struct variant_alternative;
template <size_t I, class T>
struct variant_alternative<I, const T> {
    using type = add_const_t<typename variant_alternative<I, T>::type>;
};
template <size_t I, class... Ts>
struct variant_alternative<I, variant<Ts...>> {
    static_assert(I < sizeof...(Ts), "variant_alternative index out of range");
    using type = __type_pack_element<I, Ts...>;
};
template <size_t I, class T>
using variant_alternative_t = typename variant_alternative<I, T>::type;

// ── monostate ────────────────────────────────────────────────────────────

struct monostate {};
constexpr bool operator==(monostate, monostate) noexcept { return true; }
constexpr strong_ordering operator<=>(monostate, monostate) noexcept
{
    return strong_ordering::equal;
}

