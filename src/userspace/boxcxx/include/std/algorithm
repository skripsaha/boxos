// boxcxx — <algorithm>
// Public entry point: the classic std:: algorithms (implementation notes in
// <__bits/algorithm_classic>) plus the ranges:: constrained overloads (with
// projections, sentinels and dangling-safe result types), appended from the
// <__bits/ranges_algo*> files.
#ifndef BOXCXX_ALGORITHM
#define BOXCXX_ALGORITHM

#include <__bits/algorithm_classic>

// The ranges:: constrained algorithms ([algorithms.results] + the niebloids)
// build on everything above plus the Ф29a indirect-callable foundation. Order
// matters: ranges_algo defines the result-type aggregates; _fold and _mut
// consume them; _sort/_set reuse ranges::copy/move and __algo::SortComp from
// _mut/_sort and delegate the heavy reordering to the classic engines above.
#include <__bits/ranges_algo>       // result-types + [alg.nonmodifying]  (Ф29b-1)
#include <__bits/ranges_algo_fold>  // fold + min/max + binary-search + lex (Ф29b-1)
#include <__bits/ranges_algo_mut>   // [alg.modifying] + sample/shuffle    (Ф29b-2)
#include <__bits/ranges_algo_sort>  // partition/sort/heap/permutation     (Ф29b-2)
#include <__bits/ranges_algo_set>   // merge + set operations              (Ф29b-2)

