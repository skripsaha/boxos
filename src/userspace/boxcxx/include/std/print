// boxcxx — <print>  (Ф9B-2: std::print / std::println over the BoxOS console)
//
// std::print / println format through <format> and write the bytes to the
// console via boxlib's print_bytes (src/print.c) — the same VGA / display-
// daemon path printf uses, with its colour state and UTF-8->'?' filtering.
//
// Deviations from the standard synopsis (documented; BoxOS has no <cstdio>
// FILE*):
//   * the FILE*-taking overloads and vprint_unicode/nonunicode(FILE*, ...)
//     are not provided — there is no FILE*. The console-targeting forms below
//     drop the stream argument.
//   * unicode and nonunicode output coincide: the console renders ASCII and
//     substitutes '?' for multi-byte UTF-8 (kernel font limitation), so there
//     is no separate well-formed-UTF-8 transcoding step.
//   * the format string is still consteval-checked (basic_format_string).
//
// Concurrency contract (many strands share a cabin, so this is not academic):
//   * the screen channel handle is a function-local static, so the FIRST
//     strand to print opens it and the rest reuse it. Racing first-touches are
//     safe — __cxa_guard_acquire publishes BUSY plus an owner token atomically,
//     so exactly one strand runs the initializer.
//   * the handle is read-only afterwards, and a screen Current's write is a
//     straight pass-through to print_bytes, which keeps its buffer and colour
//     state PER STRAND. Concurrent print/println from any number of strands is
//     therefore free of data races without a lock.
//   * what is NOT promised is interleaving. The unit is one print_bytes call,
//     not one line: println formats its '\n' into the same buffer so boxcxx
//     never splits a line itself, but in IPC mode boxlib flushes a strand's
//     io_buf at 256 bytes, so a longer line can still reach the display in
//     pieces that another strand's output may sit between.
#ifndef BOXCXX_PRINT
#define BOXCXX_PRINT

#include <cstddef>
#include <format>
#include <string>
#include <string_view>

#include "box/current.h"   // route console output through the Current spine

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_print
#include <__bits/version_print>

// boxlib console byte writer — routes to VGA or the display daemon, applies
// the current colour and the console's UTF-8->'?' filtering. Declared here so
// <print> need not pull the C header into namespace std.
extern "C" void print_bytes(const char *data, size_t len);

namespace std {

namespace __print {
// Route std::print's console output through the BoxOS Current spine. The
// "screen" Current's backend IS print_bytes, so the emitted bytes are
// identical to a direct call (STRICT serial logs stay byte-exact) — but the
// console now has a single road: the screen Current channel. The handle is
// opened once per process and lives for its lifetime; flushing stays with the
// shared io_buf (exit() / 256-byte threshold), unchanged. Falls back to a
// direct print_bytes if the channel can't be opened.
// The one screen channel, opened on first use and held for the process. It
// is a function rather than a local static inside ToConsole because <iostream>
// needs the SAME handle: std::cout and std::print sharing one road is what
// makes their output interleave in call order instead of in the order two
// buffers happened to drain.
inline ::Current *Console()
{
    static ::Current *screen = ::current_open("screen", CURRENT_WRITE, 0, 0);
    return screen;
}

inline void ToConsole(string_view s)
{
    if (s.empty()) return;
    if (::Current *screen = Console()) ::current_write(screen, s.data(), s.size());
    else                               print_bytes(s.data(), s.size());
}
} // namespace __print

inline void vprint_nonunicode(string_view fmt, format_args args)
{
    const string s = vformat(fmt, args);
    __print::ToConsole(string_view(s.data(), s.size()));
}
inline void vprint_unicode(string_view fmt, format_args args)
{
    vprint_nonunicode(fmt, args);
}

template <class... Args>
void print(format_string<Args...> fmt, Args &&...args)
{
    vprint_unicode(fmt.get(), make_format_args(args...));
}

template <class... Args>
void println(format_string<Args...> fmt, Args &&...args)
{
    // Format with the trailing newline in one buffer so a line is never split
    // across two console flushes (and so it interleaves cleanly with printf).
    string s = vformat(fmt.get(), make_format_args(args...));
    s.push_back('\n');
    __print::ToConsole(string_view(s.data(), s.size()));
}

// Same road as every other overload: the console has one channel, and a bare
// println() that called print_bytes directly would be the one byte that
// bypassed it.
inline void println() { __print::ToConsole(string_view("\n", 1)); }

} // namespace std

#endif // BOXCXX_PRINT
