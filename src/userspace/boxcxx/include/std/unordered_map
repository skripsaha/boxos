// boxcxx — <unordered_map>
// unordered_map / unordered_multimap over the chaining hash engine
// (__bits/hash_table). Conforming bucket semantics; the robin-hood
// table ships separately as box::flat_hash_map (owner decision).
// node_handle extract/insert(node)/merge shipped Ф28b.
#ifndef BOXCXX_UNORDERED_MAP
#define BOXCXX_UNORDERED_MAP

#include <__bits/hash_table>
#include <__bits/node_handle>
#include <__bits/ranges_core>
#include <__bits/throw_helpers>
#include <__bits/version_containers>
#include <functional>
#include <initializer_list>
#include <tuple>
#include <utility>

namespace std {

namespace __ht {

template <typename Pair>
struct SelectFirst {
    const typename Pair::first_type &operator()(const Pair &p) const noexcept
    {
        return p.first;
    }
};

// Key/mapped-type extraction for the deduction guides below — same
// rationale as __rb::DeductKey/DeductMapped in <map>.
template <typename It>
using DeductKey = remove_const_t<typename iter_value_t<It>::first_type>;
template <typename It>
using DeductMapped = typename iter_value_t<It>::second_type;
template <typename R>
using DeductRangeKey = remove_const_t<typename ranges::range_value_t<R>::first_type>;
template <typename R>
using DeductRangeMapped = typename ranges::range_value_t<R>::second_type;

} // namespace __ht

// unordered_multimap named by unordered_map::merge (defined later here).
template <typename Key, typename T, typename Hash, typename KeyEq,
          typename Alloc>
class unordered_multimap;

template <typename Key, typename T, typename Hash = hash<Key>,
          typename KeyEq = equal_to<Key>,
          typename Alloc = allocator<pair<const Key, T>>>
class unordered_map {
    using TableT = __ht::Table<Key, pair<const Key, T>,
                               __ht::SelectFirst<pair<const Key, T>>, Hash,
                               KeyEq, Alloc>;

public:
    using key_type        = Key;
    using mapped_type     = T;
    using value_type      = pair<const Key, T>;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;
    using hasher          = Hash;
    using key_equal       = KeyEq;
    using allocator_type  = Alloc;
    using iterator        = typename TableT::iterator;
    using const_iterator  = typename TableT::const_iterator;
    using local_iterator       = typename TableT::local_iterator;
    using const_local_iterator = typename TableT::const_local_iterator;
    using node_type = __node::NodeHandle<Key, value_type, typename TableT::NodeType,
                                         typename TableT::NodeAllocType>;
    using insert_return_type = __node::NodeInsertReturn<iterator, node_type>;

    unordered_map() = default;
    explicit unordered_map(size_type buckets, const Hash &h = Hash(),
                           const KeyEq &eq = KeyEq(),
                           const Alloc &a  = Alloc())
        : __t(buckets, h, eq, a)
    {
    }
    template <typename It>
    unordered_map(It first, It last, size_type buckets = 0,
                  const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                  const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert(first, last);
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_map(from_range_t, R &&rg, size_type buckets = 0,
                  const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                  const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert_range(std::forward<R>(rg));
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_map(from_range_t, R &&rg, size_type buckets, const Alloc &a)
        : __t(buckets, Hash(), KeyEq(), a)
    {
        insert_range(std::forward<R>(rg));
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_map(from_range_t, R &&rg, size_type buckets, const Hash &h,
                  const Alloc &a)
        : __t(buckets, h, KeyEq(), a)
    {
        insert_range(std::forward<R>(rg));
    }
    unordered_map(initializer_list<value_type> il, size_type buckets = 0,
                  const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                  const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert(il.begin(), il.end());
    }
    unordered_map(const unordered_map &) = default;
    unordered_map(unordered_map &&) noexcept = default;
    unordered_map(const unordered_map &other, const Alloc &a)
        : __t(other.__t, a)
    {
    }
    unordered_map(unordered_map &&other, const Alloc &a)
        : __t(std::move(other.__t), a)
    {
    }
    unordered_map &operator=(const unordered_map &) = default;
    unordered_map &operator=(unordered_map &&) = default;
    unordered_map &operator=(initializer_list<value_type> il)
    {
        clear();
        insert(il.begin(), il.end());
        return *this;
    }

    allocator_type get_allocator() const noexcept
    {
        return __t.get_allocator();
    }

    iterator begin() noexcept { return __t.begin(); }
    const_iterator begin() const noexcept { return __t.begin(); }
    const_iterator cbegin() const noexcept { return __t.begin(); }
    iterator end() noexcept { return __t.end(); }
    const_iterator end() const noexcept { return __t.end(); }
    const_iterator cend() const noexcept { return __t.end(); }

    [[nodiscard]] bool empty() const noexcept { return __t.empty(); }
    size_type size() const noexcept { return __t.size(); }
    size_type max_size() const noexcept { return __t.max_size(); }

    // ── element access ──────────────────────────────────────────────────

    T &operator[](const Key &key) { return try_emplace(key).first->second; }
    T &operator[](Key &&key)
    {
        return try_emplace(std::move(key)).first->second;
    }
    T &at(const Key &key)
    {
        iterator it = find(key);
        if (it == end()) boxcxx::ThrowOutOfRange("unordered_map::at");
        return it->second;
    }
    const T &at(const Key &key) const
    {
        const_iterator it = find(key);
        if (it == end()) boxcxx::ThrowOutOfRange("unordered_map::at");
        return it->second;
    }

    // ── modifiers ───────────────────────────────────────────────────────

    pair<iterator, bool> insert(const value_type &v)
    {
        return __t.EmplaceUnique(v);
    }
    pair<iterator, bool> insert(value_type &&v)
    {
        return __t.EmplaceUnique(std::move(v));
    }
    template <typename P>
        requires is_constructible_v<value_type, P &&>
    pair<iterator, bool> insert(P &&v)
    {
        return __t.EmplaceUnique(std::forward<P>(v));
    }
    iterator insert(const_iterator, const value_type &v)
    {
        return insert(v).first;
    }
    template <typename It>
    void insert(It first, It last)
    {
        for (; first != last; ++first) __t.EmplaceUnique(*first);
    }
    void insert(initializer_list<value_type> il)
    {
        insert(il.begin(), il.end());
    }
    template <ContainerCompatibleRange<value_type> R>
    void insert_range(R &&rg)
    {
        for (auto &&v : rg) __t.EmplaceUnique(std::forward<decltype(v)>(v));
    }
    template <typename... Args>
    pair<iterator, bool> emplace(Args &&...args)
    {
        return __t.EmplaceUnique(std::forward<Args>(args)...);
    }
    template <typename... Args>
    pair<iterator, bool> try_emplace(const Key &key, Args &&...args)
    {
        iterator hit = find(key);
        if (hit != end()) return {hit, false};
        return __t.EmplaceUnique(piecewise_construct, forward_as_tuple(key),
                                 forward_as_tuple(std::forward<Args>(args)...));
    }
    template <typename... Args>
    pair<iterator, bool> try_emplace(Key &&key, Args &&...args)
    {
        iterator hit = find(key);
        if (hit != end()) return {hit, false};
        return __t.EmplaceUnique(
            piecewise_construct, forward_as_tuple(std::move(key)),
            forward_as_tuple(std::forward<Args>(args)...));
    }
    template <typename M>
    pair<iterator, bool> insert_or_assign(const Key &key, M &&obj)
    {
        auto [it, inserted] = try_emplace(key, std::forward<M>(obj));
        if (!inserted) it->second = std::forward<M>(obj);
        return {it, inserted};
    }

    iterator erase(const_iterator where) { return __t.Erase(where); }
    iterator erase(iterator where) { return __t.Erase(where); }
    iterator erase(const_iterator first, const_iterator last)
    {
        while (first != last) first = __t.Erase(first);
        return iterator(first.__n, first.__t);
    }
    size_type erase(const Key &key) { return __t.EraseKey(key); }
    template <typename K>
        requires(__detail::TransparentHashEq<Hash, KeyEq> &&
                 !is_convertible_v<K &&, iterator> &&
                 !is_convertible_v<K &&, const_iterator>)
    size_type erase(K &&x)
    {
        return __t.EraseKey(std::forward<K>(x));
    }
    void clear() noexcept { __t.clear(); }
    void swap(unordered_map &other) noexcept { __t.swap(other.__t); }

    // ── node handle / merge (Ф28b) ──────────────────────────────────────

    node_type extract(const_iterator pos)
    {
        return node_type(__t.ExtractNode(pos), __t.GetNodeAlloc());
    }
    node_type extract(const Key &key)
    {
        iterator it = find(key);
        if (it == end()) return node_type();
        return extract(const_iterator(it));
    }
    template <typename K>
        requires(__detail::TransparentHashEq<Hash, KeyEq> &&
                 !is_convertible_v<K &&, iterator> &&
                 !is_convertible_v<K &&, const_iterator>)
    node_type extract(K &&x)
    {
        iterator it = find(x);
        if (it == end()) return node_type();
        return extract(const_iterator(it));
    }
    insert_return_type insert(node_type &&nh)
    {
        if (nh.empty()) return {end(), false, node_type()};
        auto [it, ok] = __t.ReinsertUnique(nh.__Ptr());
        if (ok) nh.__Disown();
        return {it, ok, std::move(nh)};
    }
    iterator insert(const_iterator, node_type &&nh)
    {
        if (nh.empty()) return end();
        auto [it, ok] = __t.ReinsertUnique(nh.__Ptr());
        if (ok) nh.__Disown();
        return it;
    }
    template <typename H2, typename E2>
    void merge(unordered_map<Key, T, H2, E2, Alloc> &source)
    {
        __t.MergeUnique(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_map<Key, T, H2, E2, Alloc> &&source)
    {
        __t.MergeUnique(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_multimap<Key, T, H2, E2, Alloc> &source)
    {
        __t.MergeUnique(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_multimap<Key, T, H2, E2, Alloc> &&source)
    {
        __t.MergeUnique(source.__Table());
    }
    TableT &__Table() noexcept { return __t; }

    // ── lookup ──────────────────────────────────────────────────────────

    iterator find(const Key &key) { return __t.Find(key); }
    const_iterator find(const Key &key) const
    {
        return const_cast<unordered_map *>(this)->__t.Find(key);
    }
    size_type count(const Key &key) const
    {
        return const_cast<unordered_map *>(this)->__t.Count(key);
    }
    bool contains(const Key &key) const { return find(key) != end(); }
    pair<iterator, iterator> equal_range(const Key &key)
    {
        return __t.EqualRange(key);
    }
    pair<const_iterator, const_iterator> equal_range(const Key &key) const
    {
        return const_cast<unordered_map *>(this)->__t.EqualRange(key);
    }

    // ── heterogeneous lookup (C++23, transparent Hash+KeyEq only) ───────

    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    iterator find(const K &key) { return __t.Find(key); }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    const_iterator find(const K &key) const
    {
        return const_cast<unordered_map *>(this)->__t.Find(key);
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    size_type count(const K &key) const
    {
        return const_cast<unordered_map *>(this)->__t.Count(key);
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    bool contains(const K &key) const { return find(key) != end(); }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    pair<iterator, iterator> equal_range(const K &key)
    {
        return __t.EqualRange(key);
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    pair<const_iterator, const_iterator> equal_range(const K &key) const
    {
        return const_cast<unordered_map *>(this)->__t.EqualRange(key);
    }

    // ── bucket / hash policy ────────────────────────────────────────────

    size_type bucket_count() const noexcept { return __t.bucket_count(); }
    size_type bucket_size(size_type i) const noexcept
    {
        return __t.bucket_size(i);
    }
    size_type bucket(const Key &key) const { return __t.bucket(key); }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    size_type bucket(const K &key) const { return __t.bucket(key); }
    local_iterator       begin(size_type n) { return __t.begin(n); }
    local_iterator       end(size_type n) { return __t.end(n); }
    const_local_iterator begin(size_type n) const { return __t.begin(n); }
    const_local_iterator end(size_type n) const { return __t.end(n); }
    const_local_iterator cbegin(size_type n) const { return __t.begin(n); }
    const_local_iterator cend(size_type n) const { return __t.end(n); }
    float load_factor() const noexcept { return __t.load_factor(); }
    float max_load_factor() const noexcept { return __t.max_load_factor(); }
    void max_load_factor(float lf) noexcept { __t.max_load_factor(lf); }
    void rehash(size_type n) { __t.Rehash(n ? n : 8); }
    void reserve(size_type n) { __t.Reserve(n); }
    hasher hash_function() const { return __t.hash_function(); }
    key_equal key_eq() const { return __t.key_eq(); }

private:
    TableT __t;
};

template <typename Key, typename T, typename Hash = hash<Key>,
          typename KeyEq = equal_to<Key>,
          typename Alloc = allocator<pair<const Key, T>>>
class unordered_multimap {
    using TableT = __ht::Table<Key, pair<const Key, T>,
                               __ht::SelectFirst<pair<const Key, T>>, Hash,
                               KeyEq, Alloc>;

public:
    using key_type        = Key;
    using mapped_type     = T;
    using value_type      = pair<const Key, T>;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;
    using hasher          = Hash;
    using key_equal       = KeyEq;
    using allocator_type  = Alloc;
    using iterator        = typename TableT::iterator;
    using const_iterator  = typename TableT::const_iterator;
    using local_iterator       = typename TableT::local_iterator;
    using const_local_iterator = typename TableT::const_local_iterator;
    using node_type = __node::NodeHandle<Key, value_type, typename TableT::NodeType,
                                         typename TableT::NodeAllocType>;

    unordered_multimap() = default;
    explicit unordered_multimap(size_type buckets, const Hash &h = Hash(),
                                const KeyEq &eq = KeyEq(),
                                const Alloc &a  = Alloc())
        : __t(buckets, h, eq, a)
    {
    }
    template <typename It>
    unordered_multimap(It first, It last, size_type buckets = 0,
                       const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                       const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert(first, last);
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_multimap(from_range_t, R &&rg, size_type buckets = 0,
                       const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                       const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert_range(std::forward<R>(rg));
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_multimap(from_range_t, R &&rg, size_type buckets, const Alloc &a)
        : __t(buckets, Hash(), KeyEq(), a)
    {
        insert_range(std::forward<R>(rg));
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_multimap(from_range_t, R &&rg, size_type buckets,
                       const Hash &h, const Alloc &a)
