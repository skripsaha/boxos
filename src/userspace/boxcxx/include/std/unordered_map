    {
        insert_range(std::forward<R>(rg));
    }
    unordered_multimap(initializer_list<value_type> il, size_type buckets = 0,
                       const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                       const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert(il.begin(), il.end());
    }
    unordered_multimap(const unordered_multimap &) = default;
    unordered_multimap(unordered_multimap &&) noexcept = default;
    unordered_multimap(const unordered_multimap &other, const Alloc &a)
        : __t(other.__t, a)
    {
    }
    unordered_multimap(unordered_multimap &&other, const Alloc &a)
        : __t(std::move(other.__t), a)
    {
    }
    unordered_multimap &operator=(const unordered_multimap &) = default;
    unordered_multimap &operator=(unordered_multimap &&) = default;
    unordered_multimap &operator=(initializer_list<value_type> il)
    {
        clear();
        insert(il.begin(), il.end());
        return *this;
    }

    allocator_type get_allocator() const noexcept
    {
        return __t.get_allocator();
    }

    iterator begin() noexcept { return __t.begin(); }
    const_iterator begin() const noexcept { return __t.begin(); }
    const_iterator cbegin() const noexcept { return __t.begin(); }
    iterator end() noexcept { return __t.end(); }
    const_iterator end() const noexcept { return __t.end(); }
    const_iterator cend() const noexcept { return __t.end(); }

    [[nodiscard]] bool empty() const noexcept { return __t.empty(); }
    size_type size() const noexcept { return __t.size(); }
    size_type max_size() const noexcept { return __t.max_size(); }

    iterator insert(const value_type &v) { return __t.EmplaceMulti(v); }
    iterator insert(value_type &&v) { return __t.EmplaceMulti(std::move(v)); }
    template <typename P>
        requires is_constructible_v<value_type, P &&>
    iterator insert(P &&v)
    {
        return __t.EmplaceMulti(std::forward<P>(v));
    }
    iterator insert(const_iterator, const value_type &v)
    {
        return __t.EmplaceMulti(v); // hint accepted, not exploited
    }
    template <typename... Args>
    iterator emplace(Args &&...args)
    {
        return __t.EmplaceMulti(std::forward<Args>(args)...);
    }
    template <typename... Args>
    iterator emplace_hint(const_iterator, Args &&...args)
    {
        return __t.EmplaceMulti(std::forward<Args>(args)...);
    }
    template <typename It>
    void insert(It first, It last)
    {
        for (; first != last; ++first) __t.EmplaceMulti(*first);
    }
    void insert(initializer_list<value_type> il)
    {
        insert(il.begin(), il.end());
    }
    template <ContainerCompatibleRange<value_type> R>
    void insert_range(R &&rg)
    {
        for (auto &&v : rg) __t.EmplaceMulti(std::forward<decltype(v)>(v));
    }

    iterator erase(const_iterator where) { return __t.Erase(where); }
    iterator erase(iterator where) { return __t.Erase(where); }
    iterator erase(const_iterator first, const_iterator last)
    {
        while (first != last) first = __t.Erase(first);
        return iterator(first.__n, first.__t);
    }
    size_type erase(const Key &key) { return __t.EraseKey(key); }
    template <typename K>
        requires(__detail::TransparentHashEq<Hash, KeyEq> &&
                 !is_convertible_v<K &&, iterator> &&
                 !is_convertible_v<K &&, const_iterator>)
    size_type erase(K &&x)
    {
        return __t.EraseKey(std::forward<K>(x));
    }
    void clear() noexcept { __t.clear(); }
    void swap(unordered_multimap &other) noexcept { __t.swap(other.__t); }

    // ── node handle / merge (Ф28b) ──────────────────────────────────────

    node_type extract(const_iterator pos)
    {
        return node_type(__t.ExtractNode(pos), __t.GetNodeAlloc());
    }
    node_type extract(const Key &key)
    {
        iterator it = __t.Find(key);
        if (it == end()) return node_type();
        return extract(const_iterator(it));
    }
    template <typename K>
        requires(__detail::TransparentHashEq<Hash, KeyEq> &&
                 !is_convertible_v<K &&, iterator> &&
                 !is_convertible_v<K &&, const_iterator>)
    node_type extract(K &&x)
    {
        iterator it = __t.Find(x);
        if (it == end()) return node_type();
        return extract(const_iterator(it));
    }
    iterator insert(node_type &&nh)
    {
        if (nh.empty()) return end();
        iterator it = __t.ReinsertMulti(nh.__Ptr());
        nh.__Disown();
        return it;
    }
    iterator insert(const_iterator, node_type &&nh)
    {
        return insert(std::move(nh));
    }
    template <typename H2, typename E2>
    void merge(unordered_map<Key, T, H2, E2, Alloc> &source)
    {
        __t.MergeMulti(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_map<Key, T, H2, E2, Alloc> &&source)
    {
        __t.MergeMulti(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_multimap<Key, T, H2, E2, Alloc> &source)
    {
        __t.MergeMulti(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_multimap<Key, T, H2, E2, Alloc> &&source)
    {
        __t.MergeMulti(source.__Table());
    }
    TableT &__Table() noexcept { return __t; }

    iterator find(const Key &key) { return __t.Find(key); }
    const_iterator find(const Key &key) const
    {
        return const_cast<unordered_multimap *>(this)->__t.Find(key);
    }
    size_type count(const Key &key) const
    {
        return const_cast<unordered_multimap *>(this)->__t.Count(key);
    }
    bool contains(const Key &key) const
    {
        return const_cast<unordered_multimap *>(this)->__t.Find(key) != end();
    }
    pair<iterator, iterator> equal_range(const Key &key)
    {
        return __t.EqualRange(key);
    }
    pair<const_iterator, const_iterator> equal_range(const Key &key) const
    {
        return const_cast<unordered_multimap *>(this)->__t.EqualRange(key);
    }

    // ── heterogeneous lookup (C++23, transparent Hash+KeyEq only) ───────

    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    iterator find(const K &key) { return __t.Find(key); }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    const_iterator find(const K &key) const
    {
        return const_cast<unordered_multimap *>(this)->__t.Find(key);
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    size_type count(const K &key) const
    {
        return const_cast<unordered_multimap *>(this)->__t.Count(key);
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    bool contains(const K &key) const
    {
        return const_cast<unordered_multimap *>(this)->__t.Find(key) != end();
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    pair<iterator, iterator> equal_range(const K &key)
    {
        return __t.EqualRange(key);
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    pair<const_iterator, const_iterator> equal_range(const K &key) const
    {
        return const_cast<unordered_multimap *>(this)->__t.EqualRange(key);
    }

    size_type bucket_count() const noexcept { return __t.bucket_count(); }
    size_type bucket_size(size_type i) const noexcept
    {
        return __t.bucket_size(i);
    }
    size_type bucket(const Key &key) const { return __t.bucket(key); }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    size_type bucket(const K &key) const { return __t.bucket(key); }
    local_iterator       begin(size_type n) { return __t.begin(n); }
    local_iterator       end(size_type n) { return __t.end(n); }
    const_local_iterator begin(size_type n) const { return __t.begin(n); }
    const_local_iterator end(size_type n) const { return __t.end(n); }
    const_local_iterator cbegin(size_type n) const { return __t.begin(n); }
    const_local_iterator cend(size_type n) const { return __t.end(n); }
    float load_factor() const noexcept { return __t.load_factor(); }
    float max_load_factor() const noexcept { return __t.max_load_factor(); }
    void max_load_factor(float lf) noexcept { __t.max_load_factor(lf); }
    void rehash(size_type n) { __t.Rehash(n ? n : 8); }
    void reserve(size_type n) { __t.Reserve(n); }
    hasher hash_function() const { return __t.hash_function(); }
    key_equal key_eq() const { return __t.key_eq(); }

private:
    TableT __t;
};

template <typename K, typename T, typename H, typename E, typename A>
bool operator==(const unordered_map<K, T, H, E, A> &a,
                const unordered_map<K, T, H, E, A> &b)
{
    if (a.size() != b.size()) return false;
    for (const auto &kv : a) {
        auto hit = b.find(kv.first);
        if (hit == b.end() || !(hit->second == kv.second)) return false;
    }
    return true;
}

template <typename K, typename T, typename H, typename E, typename A>
void swap(unordered_map<K, T, H, E, A> &a,
          unordered_map<K, T, H, E, A> &b) noexcept
{
    a.swap(b);
}

template <typename K, typename T, typename H, typename E, typename A,
          typename Pred>
typename unordered_map<K, T, H, E, A>::size_type
erase_if(unordered_map<K, T, H, E, A> &m, Pred pred)
{
    typename unordered_map<K, T, H, E, A>::size_type removed = 0;
    for (auto it = m.begin(); it != m.end();) {
        if (pred(*it)) {
            it = m.erase(it);
            ++removed;
        } else {
            ++it;
        }
    }
    return removed;
}

// Equal iff same size and, for every key, the equal-range in `a` is a
// permutation (by element operator==) of the equal-range in `b` — a
// multimap group is all-same-key, so this reduces to a multiset compare of
// the mapped values, which is the conforming [unord.req] semantics.
template <typename K, typename T, typename H, typename E, typename A>
bool operator==(const unordered_multimap<K, T, H, E, A> &a,
                const unordered_multimap<K, T, H, E, A> &b)
{
    if (a.size() != b.size()) return false;
    for (auto it = a.begin(); it != a.end();) {
        auto ra = a.equal_range(it->first);
        auto rb = b.equal_range(it->first);
        size_t na = 0;
        for (auto x = ra.first; x != ra.second; ++x) ++na;
        size_t nb = 0;
        for (auto x = rb.first; x != rb.second; ++x) ++nb;
        if (na != nb) return false;
        if (!__ht::RangeIsPermutation(ra.first, ra.second, rb.first, rb.second))
            return false;
        it = ra.second;
    }
    return true;
}

template <typename K, typename T, typename H, typename E, typename A>
void swap(unordered_multimap<K, T, H, E, A> &a,
          unordered_multimap<K, T, H, E, A> &b) noexcept
{
    a.swap(b);
}

template <typename K, typename T, typename H, typename E, typename A,
          typename Pred>
typename unordered_multimap<K, T, H, E, A>::size_type
erase_if(unordered_multimap<K, T, H, E, A> &m, Pred pred)
{
    typename unordered_multimap<K, T, H, E, A>::size_type removed = 0;
    for (auto it = m.begin(); it != m.end();) {
        if (pred(*it)) {
            it = m.erase(it);
            ++removed;
        } else {
            ++it;
        }
    }
    return removed;
}

// ── deduction guides ([unord.map.overview] / [unord.multimap.overview]) ──
// Iterator-pair and from_range_t forms only, with the bucket-count param
// per the standard's guides. Same "no competing candidate" reasoning as
// map's: the (buckets,Hash,KeyEq,Alloc) ctor's Key/T never appear in any
// of its parameter types, so its implicit guide can never deduce Key/T.
template <typename It, typename Hash = hash<__ht::DeductKey<It>>,
          typename KeyEq = equal_to<__ht::DeductKey<It>>,
          typename Alloc = allocator<pair<const __ht::DeductKey<It>, __ht::DeductMapped<It>>>>
unordered_map(It, It, size_t = 0, Hash = Hash(), KeyEq = KeyEq(), Alloc = Alloc())
    -> unordered_map<__ht::DeductKey<It>, __ht::DeductMapped<It>, Hash, KeyEq, Alloc>;

// Both Hash and KeyEq (not just Hash) must be NotAllocatorLike: with only
// Hash constrained, a 5-arg (from_range_t,R&&,buckets,Hash,Alloc) call
// stays ambiguous against the new bucket+Hash+Alloc guide below, because
// this guide's KeyEq slot would still happily (mis)deduce from the Alloc
// argument (verified empirically — an unconstrained trailing slot always
// wins template argument deduction, it never rejects on its own).
template <ranges::input_range R, NotAllocatorLike Hash = hash<__ht::DeductRangeKey<R>>,
          NotAllocatorLike KeyEq = equal_to<__ht::DeductRangeKey<R>>,
          typename Alloc = allocator<pair<const __ht::DeductRangeKey<R>, __ht::DeductRangeMapped<R>>>>
unordered_map(from_range_t, R &&, size_t = 0, Hash = Hash(), KeyEq = KeyEq(), Alloc = Alloc())
    -> unordered_map<__ht::DeductRangeKey<R>, __ht::DeductRangeMapped<R>, Hash, KeyEq, Alloc>;

template <ranges::input_range R, AllocatorLike Alloc>
unordered_map(from_range_t, R &&, size_t, Alloc)
    -> unordered_map<__ht::DeductRangeKey<R>, __ht::DeductRangeMapped<R>,
                     hash<__ht::DeductRangeKey<R>>, equal_to<__ht::DeductRangeKey<R>>, Alloc>;

template <ranges::input_range R, typename Hash, AllocatorLike Alloc>
unordered_map(from_range_t, R &&, size_t, Hash, Alloc)
    -> unordered_map<__ht::DeductRangeKey<R>, __ht::DeductRangeMapped<R>, Hash,
