    atomic_ref &operator=(const atomic_ref &) = delete;

    bool is_lock_free() const noexcept { return is_always_lock_free; }

    void store(T v, memory_order m = memory_order_seq_cst) const noexcept
    {
        __atomic_impl::Store(__p, v, m);
    }
    T load(memory_order m = memory_order_seq_cst) const noexcept
    {
        return __atomic_impl::Load<T, T>(__p, m);
    }
    operator T() const noexcept { return load(); }
    T operator=(T v) const noexcept
    {
        store(v);
        return v;
    }
    T exchange(T v, memory_order m = memory_order_seq_cst) const noexcept
    {
        return __atomic_impl::Exchange(__p, v, m);
    }

    bool compare_exchange_weak(T &expected, T desired, memory_order success,
                               memory_order failure) const noexcept
    {
        return __atomic_impl::Cas(__p, expected, desired, true, success,
                                  failure);
    }
    bool compare_exchange_weak(
        T &expected, T desired,
        memory_order m = memory_order_seq_cst) const noexcept
    {
        return compare_exchange_weak(expected, desired, m,
                                     __atomic_impl::FailOrder(m));
    }
    bool compare_exchange_strong(T &expected, T desired, memory_order success,
                                 memory_order failure) const noexcept
    {
        return __atomic_impl::Cas(__p, expected, desired, false, success,
                                  failure);
    }
    bool compare_exchange_strong(
        T &expected, T desired,
        memory_order m = memory_order_seq_cst) const noexcept
    {
        return compare_exchange_strong(expected, desired, m,
                                       __atomic_impl::FailOrder(m));
    }

    void wait(T old, memory_order m = memory_order_seq_cst) const noexcept
    {
        __atomic_impl::Wait<T, T>(__p, old, m);
    }
    void notify_one() const noexcept { __boxcxx_atomic_notify(__p, false); }
    void notify_all() const noexcept { __boxcxx_atomic_notify(__p, true); }

    // integral / floating extras, same constraint style as atomic<T>
    T fetch_add(T d, memory_order m = memory_order_seq_cst) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_add(__p, d, __atomic_impl::Order(m));
    }
    T fetch_sub(T d, memory_order m = memory_order_seq_cst) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_sub(__p, d, __atomic_impl::Order(m));
    }
    T fetch_and(T d, memory_order m = memory_order_seq_cst) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_and(__p, d, __atomic_impl::Order(m));
    }
    T fetch_or(T d, memory_order m = memory_order_seq_cst) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_or(__p, d, __atomic_impl::Order(m));
    }
    T fetch_xor(T d, memory_order m = memory_order_seq_cst) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_xor(__p, d, __atomic_impl::Order(m));
    }
    // P0493R5 ([atomics.ref.int]) — the same loop as atomic<T>'s, and this is
    // where a lockless high-water mark over a caller-owned cell actually
    // reaches for it.
    T fetch_max(T d, memory_order m = memory_order_seq_cst) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_impl::FetchMinMax<true>(__p, d, m);
    }
    T fetch_min(T d, memory_order m = memory_order_seq_cst) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_impl::FetchMinMax<false>(__p, d, m);
    }
    T fetch_add(T d, memory_order m = memory_order_seq_cst) const noexcept
        requires is_floating_point_v<T>
    {
        T old = load(memory_order_relaxed);
        while (!compare_exchange_weak(old, old + d, m, memory_order_relaxed)) {
        }
        return old;
    }
    T fetch_sub(T d, memory_order m = memory_order_seq_cst) const noexcept
        requires is_floating_point_v<T>
    {
        T old = load(memory_order_relaxed);
        while (!compare_exchange_weak(old, old - d, m, memory_order_relaxed)) {
        }
        return old;
    }

    T operator++() const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_add_fetch(__p, T(1), __ATOMIC_SEQ_CST);
    }
    T operator++(int) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return fetch_add(T(1));
    }
    T operator--() const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_sub_fetch(__p, T(1), __ATOMIC_SEQ_CST);
    }
    T operator--(int) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return fetch_sub(T(1));
    }
    // [atomics.ref.int] and [atomics.ref.float] give atomic_ref the same
    // compound-assignment set as atomic. All five were absent, and with them
    // difference_type (now inherited, exactly as atomic<T> inherits it), so
