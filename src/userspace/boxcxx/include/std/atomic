    T operator+=(T d) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_add_fetch(__p, d, __ATOMIC_SEQ_CST);
    }
    T operator+=(T d) const noexcept
        requires is_floating_point_v<T>
    {
        return fetch_add(d) + d;
    }
    T operator-=(T d) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_sub_fetch(__p, d, __ATOMIC_SEQ_CST);
    }
    T operator-=(T d) const noexcept
        requires is_floating_point_v<T>
    {
        return fetch_sub(d) - d;
    }
    T operator&=(T d) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_and_fetch(__p, d, __ATOMIC_SEQ_CST);
    }
    T operator|=(T d) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_or_fetch(__p, d, __ATOMIC_SEQ_CST);
    }
    T operator^=(T d) const noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_xor_fetch(__p, d, __ATOMIC_SEQ_CST);
    }

private:
    T *__p;
};

