// Atomic operations applied to a plain object the caller owns — the
// BoxOS-native fit for Bay shared-memory cells. Precondition: the
// referenced object is aligned to required_alignment for its lifetime.

template <typename T>
struct atomic_ref : __atomic_impl::DifferenceType<T> {
