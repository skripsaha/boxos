    {
        return __atomic_load_n(&__v, __atomic_impl::Order(m));
    }
    T *load(memory_order m = memory_order_seq_cst) const volatile noexcept
    {
        return __atomic_load_n(&__v, __atomic_impl::Order(m));
    }

    operator T *() const noexcept { return load(); }
    operator T *() const volatile noexcept { return load(); }

    T *operator=(T *v) noexcept
    {
        store(v);
        return v;
    }
    T *operator=(T *v) volatile noexcept
    {
        store(v);
        return v;
    }

    T *exchange(T *v, memory_order m = memory_order_seq_cst) noexcept
    {
        return __atomic_exchange_n(&__v, v, __atomic_impl::Order(m));
    }
    T *exchange(T *v, memory_order m = memory_order_seq_cst) volatile noexcept
    {
        return __atomic_exchange_n(&__v, v, __atomic_impl::Order(m));
    }

    bool compare_exchange_weak(T *&expected, T *desired, memory_order success,
                               memory_order failure) noexcept
    {
        return __atomic_compare_exchange_n(&__v, &expected, desired, true,
                                           __atomic_impl::Order(success),
                                           __atomic_impl::Order(failure));
    }
    bool compare_exchange_weak(T *&expected, T *desired, memory_order success,
                               memory_order failure) volatile noexcept
    {
