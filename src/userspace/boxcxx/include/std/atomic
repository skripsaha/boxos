                                  __atomic_impl::Order(m));
    }
    T *fetch_add(ptrdiff_t d,
                 memory_order m = memory_order_seq_cst) volatile noexcept
    {
        return __atomic_fetch_add(&__v, d * static_cast<ptrdiff_t>(sizeof(T)),
                                  __atomic_impl::Order(m));
    }
    T *fetch_sub(ptrdiff_t d, memory_order m = memory_order_seq_cst) noexcept
    {
        return __atomic_fetch_sub(&__v, d * static_cast<ptrdiff_t>(sizeof(T)),
                                  __atomic_impl::Order(m));
    }
    T *fetch_sub(ptrdiff_t d,
                 memory_order m = memory_order_seq_cst) volatile noexcept
    {
        return __atomic_fetch_sub(&__v, d * static_cast<ptrdiff_t>(sizeof(T)),
                                  __atomic_impl::Order(m));
