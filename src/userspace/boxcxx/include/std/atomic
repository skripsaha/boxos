                                       __atomic_impl::FailOrder(m));
    }
    bool compare_exchange_strong(
        T *&expected, T *desired,
        memory_order m = memory_order_seq_cst) volatile noexcept
    {
        return compare_exchange_strong(expected, desired, m,
                                       __atomic_impl::FailOrder(m));
    }

    void wait(T *old, memory_order m = memory_order_seq_cst) const noexcept
    {
        unsigned spin = 0;
        T *obs = old;
        while (load(m) == old)
            __boxcxx_atomic_wait_cycle(&__v, &obs, sizeof(__v), ~0ull, &spin);
    }
    void wait(T *old,
              memory_order m = memory_order_seq_cst) const volatile noexcept
    {
        unsigned spin = 0;
        T *obs = old;
        while (load(m) == old)
            __boxcxx_atomic_wait_cycle(&__v, &obs, sizeof(__v), ~0ull, &spin);
    }

    void notify_one() noexcept { __boxcxx_atomic_notify(&__v, false); }
    void notify_one() volatile noexcept { __boxcxx_atomic_notify(&__v, false); }
    void notify_all() noexcept { __boxcxx_atomic_notify(&__v, true); }
    void notify_all() volatile noexcept { __boxcxx_atomic_notify(&__v, true); }

