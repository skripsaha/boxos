// ── atomic<T> ───────────────────────────────────────────────────────────

template <typename T>
struct atomic : __atomic_impl::DifferenceType<T> {
    static_assert(is_trivially_copyable_v<T> && is_copy_constructible_v<T> &&
                      is_move_constructible_v<T> && is_copy_assignable_v<T> &&
                      is_move_assignable_v<T>,
                  "std::atomic<T> requires a trivially copyable type");

    using value_type = T;

    static constexpr bool is_always_lock_free =
        __atomic_impl::LockFreeSize(sizeof(T));

    constexpr atomic() noexcept(is_nothrow_default_constructible_v<T>)
        requires is_default_constructible_v<T>
        : __v() {}
    constexpr atomic(T v) noexcept : __v(__atomic_impl::Canonical(v)) {}
    atomic(const atomic &) = delete;
    atomic &operator=(const atomic &) = delete;
    atomic &operator=(const atomic &) volatile = delete;

    bool is_lock_free() const noexcept { return is_always_lock_free; }
    bool is_lock_free() const volatile noexcept { return is_always_lock_free; }

    void store(T v, memory_order m = memory_order_seq_cst) noexcept
    {
        __atomic_impl::Store(&__v, v, m);
    }
    void store(T v, memory_order m = memory_order_seq_cst) volatile noexcept
    {
        __atomic_impl::Store(&__v, v, m);
    }

    T load(memory_order m = memory_order_seq_cst) const noexcept
    {
        return __atomic_impl::Load<const T, T>(&__v, m);
    }
    T load(memory_order m = memory_order_seq_cst) const volatile noexcept
    {
        return __atomic_impl::Load<const volatile T, T>(&__v, m);
    }

    operator T() const noexcept { return load(); }
    operator T() const volatile noexcept { return load(); }

    T operator=(T v) noexcept
    {
        store(v);
        return v;
    }
    T operator=(T v) volatile noexcept
    {
        store(v);
        return v;
    }

    T exchange(T v, memory_order m = memory_order_seq_cst) noexcept
    {
        return __atomic_impl::Exchange(&__v, v, m);
    }
    T exchange(T v, memory_order m = memory_order_seq_cst) volatile noexcept
    {
        return __atomic_impl::Exchange(&__v, v, m);
    }

    bool compare_exchange_weak(T &expected, T desired, memory_order success,
                               memory_order failure) noexcept
    {
        return __atomic_impl::Cas(&__v, expected, desired, true, success,
                                  failure);
    }
    bool compare_exchange_weak(T &expected, T desired, memory_order success,
                               memory_order failure) volatile noexcept
    {
        return __atomic_impl::Cas(&__v, expected, desired, true, success,
                                  failure);
    }
    bool compare_exchange_weak(T &expected, T desired,
                               memory_order m = memory_order_seq_cst) noexcept
    {
        return compare_exchange_weak(expected, desired, m,
                                     __atomic_impl::FailOrder(m));
    }
    bool compare_exchange_weak(
        T &expected, T desired,
        memory_order m = memory_order_seq_cst) volatile noexcept
    {
        return compare_exchange_weak(expected, desired, m,
                                     __atomic_impl::FailOrder(m));
    }

    bool compare_exchange_strong(T &expected, T desired, memory_order success,
                                 memory_order failure) noexcept
    {
        return __atomic_impl::Cas(&__v, expected, desired, false, success,
                                  failure);
    }
    bool compare_exchange_strong(T &expected, T desired, memory_order success,
                                 memory_order failure) volatile noexcept
    {
        return __atomic_impl::Cas(&__v, expected, desired, false, success,
                                  failure);
    }
    bool compare_exchange_strong(T &expected, T desired,
                                 memory_order m = memory_order_seq_cst) noexcept
    {
        return compare_exchange_strong(expected, desired, m,
                                       __atomic_impl::FailOrder(m));
    }
    bool compare_exchange_strong(
        T &expected, T desired,
        memory_order m = memory_order_seq_cst) volatile noexcept
    {
        return compare_exchange_strong(expected, desired, m,
                                       __atomic_impl::FailOrder(m));
    }

    void wait(T old, memory_order m = memory_order_seq_cst) const noexcept
    {
        __atomic_impl::Wait<const T, T>(&__v, old, m);
    }
    void wait(T old,
              memory_order m = memory_order_seq_cst) const volatile noexcept
    {
        __atomic_impl::Wait<const volatile T, T>(&__v, old, m);
    }

    void notify_one() noexcept { __boxcxx_atomic_notify(&__v, false); }
    void notify_one() volatile noexcept { __boxcxx_atomic_notify(&__v, false); }
    void notify_all() noexcept { __boxcxx_atomic_notify(&__v, true); }
    void notify_all() volatile noexcept { __boxcxx_atomic_notify(&__v, true); }

    // ── integral extras ([atomics.types.int]) ──────────────────────────
    // NOTE: requires-constrained members replace the classic
    // per-integral-type specialization zoo.

    T fetch_add(T d, memory_order m = memory_order_seq_cst) noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_add(&__v, d, __atomic_impl::Order(m));
    }
    T fetch_add(T d, memory_order m = memory_order_seq_cst) volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_add(&__v, d, __atomic_impl::Order(m));
    }
    T fetch_sub(T d, memory_order m = memory_order_seq_cst) noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_sub(&__v, d, __atomic_impl::Order(m));
    }
    T fetch_sub(T d, memory_order m = memory_order_seq_cst) volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_sub(&__v, d, __atomic_impl::Order(m));
    }
    T fetch_and(T d, memory_order m = memory_order_seq_cst) noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_and(&__v, d, __atomic_impl::Order(m));
    }
    T fetch_and(T d, memory_order m = memory_order_seq_cst) volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_and(&__v, d, __atomic_impl::Order(m));
    }
    T fetch_or(T d, memory_order m = memory_order_seq_cst) noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_or(&__v, d, __atomic_impl::Order(m));
    }
    T fetch_or(T d, memory_order m = memory_order_seq_cst) volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_or(&__v, d, __atomic_impl::Order(m));
    }
    T fetch_xor(T d, memory_order m = memory_order_seq_cst) noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_xor(&__v, d, __atomic_impl::Order(m));
    }
    T fetch_xor(T d, memory_order m = memory_order_seq_cst) volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_fetch_xor(&__v, d, __atomic_impl::Order(m));
    }

    // P0493R5 ([atomics.types.int]): "keep the largest value anyone has
    // published" is one of the few atomic idioms in wide use with nothing
    // behind it, so everyone wrote the CAS loop by hand. It is written once,
    // in __atomic_impl::FetchMinMax, with the read-modify-write semantics the
    // paper settled on. bool is excluded because it is not an integral-type
    // in [atomics.types.int]'s sense, and floating point because R5 dropped
    // the [atomics.types.float] changes outright -- NaN and signed zero do
    // not survive std::max.
    T fetch_max(T d, memory_order m = memory_order_seq_cst) noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_impl::FetchMinMax<true>(&__v, d, m);
    }
    T fetch_max(T d, memory_order m = memory_order_seq_cst) volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_impl::FetchMinMax<true>(&__v, d, m);
    }
    T fetch_min(T d, memory_order m = memory_order_seq_cst) noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_impl::FetchMinMax<false>(&__v, d, m);
    }
    T fetch_min(T d, memory_order m = memory_order_seq_cst) volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_impl::FetchMinMax<false>(&__v, d, m);
    }

    // ── floating extras (C++20 [atomics.types.float]) ───────────────────
    // A read-modify-write on a floating value has no hardware instruction, so
    // it is a CAS loop. Both cv-forms are required; the volatile one resolves
    // to the volatile load/CAS through `this`.

    T fetch_add(T d, memory_order m = memory_order_seq_cst) noexcept
        requires is_floating_point_v<T>
    {
        T old = load(memory_order_relaxed);
        while (!compare_exchange_weak(old, old + d, m, memory_order_relaxed)) {
        }
        return old;
    }
    T fetch_add(T d, memory_order m = memory_order_seq_cst) volatile noexcept
        requires is_floating_point_v<T>
    {
        T old = load(memory_order_relaxed);
        while (!compare_exchange_weak(old, old + d, m, memory_order_relaxed)) {
        }
        return old;
    }
    T fetch_sub(T d, memory_order m = memory_order_seq_cst) noexcept
        requires is_floating_point_v<T>
    {
        T old = load(memory_order_relaxed);
        while (!compare_exchange_weak(old, old - d, m, memory_order_relaxed)) {
        }
        return old;
    }
    T fetch_sub(T d, memory_order m = memory_order_seq_cst) volatile noexcept
        requires is_floating_point_v<T>
    {
        T old = load(memory_order_relaxed);
        while (!compare_exchange_weak(old, old - d, m, memory_order_relaxed)) {
        }
        return old;
    }

    // ── operator sugar (constrained the same way) ───────────────────────
    // [atomics.types.int] and [atomics.types.float] list every one of these
    // twice, volatile and not. The volatile halves were absent, so
    // `volatile atomic<int> c; ++c;` did not compile at all — the shape a
    // memory-mapped or Bay-shared counter takes.

    T operator++() noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_add_fetch(&__v, T(1), __ATOMIC_SEQ_CST);
    }
    T operator++() volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_add_fetch(&__v, T(1), __ATOMIC_SEQ_CST);
    }
    T operator++(int) noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return fetch_add(T(1));
    }
    T operator++(int) volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return fetch_add(T(1));
    }
    T operator--() noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_sub_fetch(&__v, T(1), __ATOMIC_SEQ_CST);
    }
    T operator--() volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return __atomic_sub_fetch(&__v, T(1), __ATOMIC_SEQ_CST);
    }
    T operator--(int) noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
        return fetch_sub(T(1));
    }
    T operator--(int) volatile noexcept
        requires(is_integral_v<T> && !is_same_v<T, bool>)
    {
