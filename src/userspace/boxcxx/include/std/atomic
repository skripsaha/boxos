// boxcxx — <atomic>
//
// Full C++23 atomic surface over the GCC __atomic builtins. Sizes
// 1/2/4/8 lower to inline LOCK-prefixed instructions; size 16 lowers to
// __atomic_*_16 calls served by boxcxx's cmpxchg16b implementations
// (src/runtime/atomic_support.cpp); every other size goes through the
// generic libatomic protocol backed by an address-hashed lock pool.
//
// wait/notify park on a per-pool version counter: wait() loops over
// load-compare + one __boxcxx_atomic_wait_cycle, which bounded-spins
// (UMONITOR/UMWAIT when WAITPKG is present, PAUSE otherwise) and then
// parks the strand in the kernel until a matching notify (or a backstop
// timeout). notify_one / notify_all call __boxcxx_atomic_notify, which
// bumps the version and wakes the waiters — no longer no-ops.
//
// DO NOT CONFUSE the two "notify"s. notify_one / notify_all here are the C++
// standard's WAKE side of atomic::wait (mandated names — cannot be renamed).
// They are NOT the BoxOS kernel `notify`: in BoxOS, `notify` / notify_entry is
// the syscall entry gate ("a Cabin notifies the kernel"). Same word, different
// layers, by coincidence. This C++ wake bottoms out in addr_wake, which is a
// syscall and therefore enters the kernel through that `notify` gate — it RIDES
// on the kernel notify, it does not duplicate or replace it.
//
// Cross-cabin (Bay) usage contract: lock-free objects only — the lock
// pool is cabin-private, so non-lock-free atomics are coherent only
// within one cabin.
#ifndef BOXCXX_ATOMIC
#define BOXCXX_ATOMIC

#include <cstddef>
#include <cstdint>
#include <type_traits>
#include <__bits/version_atomic>

extern "C" {
// One park/wake cycle on `addr`'s version-pool. `observed` points to the
// `width`-byte value the caller saw while its predicate still said "wait";
// `mask` selects the bits that actually drive the predicate (so a co-packed
// unrelated field — e.g. a barrier's count beside its phase — churning does not
// spuriously end the park). Whole-value waiters pass mask = ~0. The cycle
// bounded-spins, then parks until a matching notify (or a backstop timeout),
// after which the caller's loop re-checks its predicate.
void __boxcxx_atomic_wait_cycle(const volatile void *addr, const void *observed,
                                unsigned width, unsigned long long mask,
                                unsigned *spin_state);
// Timed sibling: parks bounded by `timeout_ms` (the caller's remaining budget);
// a notify wakes it early, otherwise it returns true when the budget elapsed.
// Used by the timed primitives (counting_semaphore::try_acquire_*,
// shared_timed_mutex::try_lock_*) to wait event-driven instead of spinning.
bool __boxcxx_atomic_wait_until(const volatile void *addr, const void *observed,
                                unsigned width, unsigned long long mask,
                                unsigned timeout_ms, unsigned *spin_state);
// Wake waiters parked for `addr` (bumps the version, wakes the whole pool).
void __boxcxx_atomic_notify(const volatile void *addr, bool all);
}

namespace std {

// ── memory orders / fences ──────────────────────────────────────────────

enum class memory_order : int {
    relaxed = __ATOMIC_RELAXED,
    consume = __ATOMIC_CONSUME,
    acquire = __ATOMIC_ACQUIRE,
    release = __ATOMIC_RELEASE,
    acq_rel = __ATOMIC_ACQ_REL,
    seq_cst = __ATOMIC_SEQ_CST,
};

inline constexpr memory_order memory_order_relaxed = memory_order::relaxed;
inline constexpr memory_order memory_order_consume = memory_order::consume;
inline constexpr memory_order memory_order_acquire = memory_order::acquire;
inline constexpr memory_order memory_order_release = memory_order::release;
inline constexpr memory_order memory_order_acq_rel = memory_order::acq_rel;
inline constexpr memory_order memory_order_seq_cst = memory_order::seq_cst;

inline void atomic_thread_fence(memory_order order) noexcept
{
    __atomic_thread_fence(static_cast<int>(order));
}

inline void atomic_signal_fence(memory_order order) noexcept
{
    __atomic_signal_fence(static_cast<int>(order));
}

template <typename T>
inline T kill_dependency(T y) noexcept
{
    return y;
}

// ── implementation helpers ──────────────────────────────────────────────

namespace __atomic_impl {

constexpr int Order(memory_order m) noexcept
{
    return static_cast<int>(m);
}

// CAS failure order must not be release/acq_rel
// ([atomics.types.operations]); derive the strongest legal one.
constexpr memory_order FailOrder(memory_order m) noexcept
{
    return m == memory_order_acq_rel   ? memory_order_acquire
           : m == memory_order_release ? memory_order_relaxed
                                       : m;
}

// ── P0493R5 fetch_max / fetch_min ───────────────────────────────────────
// x86-64 has no instruction for either, and GCC 15 has no builtin, so both
// are a CAS loop -- written once here rather than twelve times across the
// four class templates that owe them.
//
// The obvious loop ("skip the store when the value already wins") is the one
// the paper writes out in §5.1 and REJECTS: that is read-and-conditional-
// store, and these are read-modify-write operations like every other
// fetch_key. The single relaxation §5.3 grants is what keeps this from being
// an unconditional CAS: a store is only REQUIRED when the caller asked for a
// release, because a release that stores nothing releases nothing. Below
// that, the omitted store would have added a modification-order entry
// carrying the value that was already there -- indistinguishable from its
// absence -- and omitting it is what keeps a many-core high-water mark off an
// exclusive cache line it never needed.
constexpr memory_order DropRelease(memory_order m) noexcept
{
    return m == memory_order_release ? memory_order_relaxed
           : (m == memory_order_acq_rel || m == memory_order_seq_cst)
               ? memory_order_acquire
               : m;
}

// Does the object's own value already win? "The maximum and minimum
// computation is performed as if by the max and min algorithms
// ([alg.min.max]), with the object value and the first parameter as the
// arguments" -- both compare with <, and both keep the first argument, the
// object's value, when the two are equivalent. Comparison is SIGNED for
// signed types: the convert-to-unsigned rule the other fetch_key operations
// carry is worded "except for fetch_max and fetch_min".
template <bool Max, typename V>
constexpr bool MinMaxHolds(V cur, V d) noexcept
{
    if constexpr (Max)
        return !(cur < d);
    else
        return !(d < cur);
}

template <bool Max, typename P, typename V>
inline V FetchMinMax(P *addr, V d, memory_order m) noexcept
{
    const memory_order mr = DropRelease(m);
    V                  old = __atomic_load_n(addr, Order(mr));
    if (mr != m) {
        // A release was asked for, so something has to be stored: write the
        // value straight back when it already wins. Exactly one read-modify-
        // write, always -- cheaper than the paper's §5.3 sketch, which primes
        // with a dummy no-op RMW and can then take a second one on top.
        while (!__atomic_compare_exchange_n(
            addr, &old, MinMaxHolds<Max>(old, d) ? old : d, true, Order(m),
            Order(mr)))
            ;
        return old;
    }
    while (!MinMaxHolds<Max>(old, d) &&
           !__atomic_compare_exchange_n(addr, &old, d, true, Order(m),
                                        Order(mr)))
        ;
    return old;
}

// Over-align storage to the operation width so 2/4/8-byte objects take
// the inline path and 16-byte objects satisfy cmpxchg16b alignment.
constexpr size_t StorageAlign(size_t size, size_t align) noexcept
{
    return (size == 2 || size == 4 || size == 8 || size == 16) &&
                   align < size
               ? size
               : align;
}

constexpr bool LockFreeSize(size_t size) noexcept
{
    return size == 1 || size == 2 || size == 4 || size == 8 || size == 16;
}

// P0528: padding bits do not participate in atomic comparisons.
// Canonicalise them to zero in every value representation that reaches
// storage or a comparison. No-op for padding-free types; unions are
// skipped (their active member is unknowable here) — documented caveat.
template <typename T>
constexpr void ClearPadding([[maybe_unused]] T *v) noexcept
{
#if __has_builtin(__builtin_clear_padding)
    if constexpr (!has_unique_object_representations_v<T> &&
                  !is_union_v<T>)
        __builtin_clear_padding(v);
#endif
}

template <typename T>
constexpr T Canonical(T v) noexcept
{
    ClearPadding(&v);
    return v;
}

template <typename T>
inline bool SameRepresentation(const T &a, const T &b) noexcept
{
    return __builtin_memcmp(&a, &b, sizeof(T)) == 0;
}

// Core ops templated on the (possibly volatile) storage pointer so the
// volatile member overloads share one body each.

template <typename P, typename T>
inline void Store(P *addr, T v, memory_order m) noexcept
{
    ClearPadding(&v);
    __atomic_store(addr, &v, Order(m));
}

template <typename P, typename T>
inline T Load(P *addr, memory_order m) noexcept
{
    T ret;
    __atomic_load(addr, &ret, Order(m));
    return ret;
}

template <typename P, typename T>
inline T Exchange(P *addr, T v, memory_order m) noexcept
{
    ClearPadding(&v);
    T ret;
    __atomic_exchange(addr, &v, &ret, Order(m));
    return ret;
}

// `weak` participates only in the lock-free lowering; the generic
// (lock-pool) protocol is always strong, hence maybe_unused.
template <typename P, typename T>
inline bool Cas(P *addr, T &expected, T desired, [[maybe_unused]] bool weak,
                memory_order success, memory_order failure) noexcept
{
    ClearPadding(&expected);
    ClearPadding(&desired);
    return __atomic_compare_exchange(addr, &expected, &desired, weak,
                                     Order(success), Order(failure));
}

template <typename P, typename T>
inline void Wait(P *addr, T old, memory_order m) noexcept
{
    ClearPadding(&old);
    unsigned spin = 0;
    for (;;) {
        T cur = Load<P, T>(addr, m);
        ClearPadding(&cur);
        if (!SameRepresentation(cur, old)) return;
        __boxcxx_atomic_wait_cycle(addr, &old, sizeof(T), ~0ull, &spin);
    }
}

// difference_type exists only for integral, floating and pointer
// specializations — provided through a conditional base.
template <typename T,
          bool = (is_integral_v<T> && !is_same_v<T, bool>) ||
                 is_floating_point_v<T>>
struct DifferenceType {};

template <typename T>
struct DifferenceType<T, true> {
    using difference_type = T;
};

} // namespace __atomic_impl

// ── atomic_flag ─────────────────────────────────────────────────────────

struct atomic_flag {
    constexpr atomic_flag() noexcept = default;
    atomic_flag(const atomic_flag &) = delete;
    atomic_flag &operator=(const atomic_flag &) = delete;
    atomic_flag &operator=(const atomic_flag &) volatile = delete;

    bool test_and_set(memory_order m = memory_order_seq_cst) noexcept
    {
        return __atomic_test_and_set(&__flag, __atomic_impl::Order(m));
    }
    bool test_and_set(memory_order m = memory_order_seq_cst) volatile noexcept
    {
        return __atomic_test_and_set(&__flag, __atomic_impl::Order(m));
    }

    void clear(memory_order m = memory_order_seq_cst) noexcept
    {
        __atomic_clear(&__flag, __atomic_impl::Order(m));
    }
    void clear(memory_order m = memory_order_seq_cst) volatile noexcept
    {
        __atomic_clear(&__flag, __atomic_impl::Order(m));
    }

    [[nodiscard]] bool test(memory_order m = memory_order_seq_cst) const noexcept
    {
        return __atomic_load_n(&__flag, __atomic_impl::Order(m));
    }
    [[nodiscard]] bool test(memory_order m = memory_order_seq_cst)
        const volatile noexcept
    {
        return __atomic_load_n(&__flag, __atomic_impl::Order(m));
    }

    void wait(bool old, memory_order m = memory_order_seq_cst) const noexcept
    {
        unsigned spin = 0;
        while (test(m) == old) {
            unsigned char cur = __atomic_load_n(&__flag, __atomic_impl::Order(m));
            __boxcxx_atomic_wait_cycle(&__flag, &cur, sizeof(__flag), ~0ull,
                                       &spin);
        }
    }
    void wait(bool old, memory_order m = memory_order_seq_cst)
        const volatile noexcept
    {
        unsigned spin = 0;
        while (test(m) == old) {
            unsigned char cur = __atomic_load_n(&__flag, __atomic_impl::Order(m));
            __boxcxx_atomic_wait_cycle(&__flag, &cur, sizeof(__flag), ~0ull,
                                       &spin);
        }
    }

    void notify_one() noexcept { __boxcxx_atomic_notify(&__flag, false); }
    void notify_one() volatile noexcept { __boxcxx_atomic_notify(&__flag, false); }
    void notify_all() noexcept { __boxcxx_atomic_notify(&__flag, true); }
    void notify_all() volatile noexcept { __boxcxx_atomic_notify(&__flag, true); }

    unsigned char __flag = 0;
};

