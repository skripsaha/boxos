    atomic &operator=(const atomic &) = delete;
    atomic &operator=(const atomic &) volatile = delete;

    bool is_lock_free() const noexcept { return true; }
    bool is_lock_free() const volatile noexcept { return true; }

    void store(T *v, memory_order m = memory_order_seq_cst) noexcept
    {
        __atomic_store_n(&__v, v, __atomic_impl::Order(m));
    }
    void store(T *v, memory_order m = memory_order_seq_cst) volatile noexcept
    {
        __atomic_store_n(&__v, v, __atomic_impl::Order(m));
    }

