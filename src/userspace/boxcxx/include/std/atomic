template <typename T>
struct atomic<T *> {
    using value_type      = T *;
    using difference_type = ptrdiff_t;

    static constexpr bool is_always_lock_free = true;

    constexpr atomic() noexcept : __v(nullptr) {}
    constexpr atomic(T *v) noexcept : __v(v) {}
