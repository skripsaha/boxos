// ── basic_ios<CharT, Traits> [ios] ───────────────────────────────────────

// Traits' default (= char_traits<CharT>) already comes from <iosfwd>'s
// forward declaration — a class template's default template argument may
// only be specified once per scope, so it is not repeated here.
template <class CharT, class Traits>
class basic_ios : public ios_base {
public:
    using char_type   = CharT;
    using int_type    = typename Traits::int_type;
    using pos_type    = typename Traits::pos_type;
    using off_type    = typename Traits::off_type;
    using traits_type = Traits;

    explicit operator bool() const { return !fail(); }
    bool operator!() const { return fail(); }

    iostate rdstate() const noexcept { return __state; }
    void clear(iostate state = iostate::goodbit)
    {
        __state = __sb ? state : (state | iostate::badbit);
        if ((rdstate() & exceptions()) != iostate::goodbit)
            throw ios_base::failure("basic_ios::clear: iostate matches the exceptions() mask");
    }
    void setstate(iostate state) { clear(rdstate() | state); }
    bool good() const noexcept { return rdstate() == iostate::goodbit; }
    bool eof() const noexcept { return (rdstate() & iostate::eofbit) != iostate::goodbit; }
    bool fail() const noexcept
    {
        return (rdstate() & (iostate::failbit | iostate::badbit)) != iostate::goodbit;
    }
    bool bad() const noexcept { return (rdstate() & iostate::badbit) != iostate::goodbit; }
    iostate exceptions() const noexcept { return __except; }
    void exceptions(iostate except)
    {
        __except = except;
        clear(rdstate());
    }

    explicit basic_ios(basic_streambuf<CharT, Traits> *sb) { init(sb); }
    virtual ~basic_ios() = default;

    basic_ostream<CharT, Traits> *tie() const noexcept { return __tie; }
    basic_ostream<CharT, Traits> *tie(basic_ostream<CharT, Traits> *t) noexcept
    {
        auto old = __tie;
        __tie    = t;
        return old;
    }

    basic_streambuf<CharT, Traits> *rdbuf() const noexcept { return __sb; }
    basic_streambuf<CharT, Traits> *rdbuf(basic_streambuf<CharT, Traits> *sb)
    {
        auto old = __sb;
        __sb     = sb;
        clear();
        return old;
    }

    // [basic.ios.members]/copyfmt — verbatim sequence: (1) fire *this*'s
    // OWN, pre-copy callbacks with erase_event; (2) bulk-copy every member
    // except rdstate()/rdbuf()/exceptions(); (3) fire the NEWLY-copied
    // callback list with copyfmt_event; (4) set exceptions() last, via the
    // real setter (which itself re-checks rdstate() and can throw).
    basic_ios &copyfmt(const basic_ios &rhs)
    {
        if (this == &rhs) return *this;
        this->FireEvent(ios_base::erase_event);
        this->CopyStateFrom(rhs);
        __tie  = rhs.__tie;
        __fill = rhs.__fill;
        this->FireEvent(ios_base::copyfmt_event);
        this->exceptions(rhs.exceptions());
        return *this;
    }

    char_type fill() const noexcept { return __fill; }
    char_type fill(char_type ch) noexcept
    {
        auto old = __fill;
        __fill   = ch;
        return old;
    }

    // Shadows ios_base::imbue (same name, non-virtual in both) — also
    // imbues rdbuf() when present, then delegates to the base for the
    // actual locale bookkeeping + imbue_event.
    locale imbue(const locale &loc)
    {
        // [basic.ios.members]/9 Effects order: ios_base::imbue(loc) FIRST
        // (it updates getloc() and fires imbue_event — a callback may observe
        // rdbuf()'s locale), THEN rdbuf()->pubimbue(loc).
        locale old = ios_base::imbue(loc);
        if (__sb) __sb->pubimbue(loc);
        return old;
    }

    // widen/narrow are the identity for CharT=char, which IS the fully
    // correct "C"-locale behaviour for a char stream and not a shortcut.
    // Ф42-f made the other instantiation reachable and found two things wrong
    // with the generic spelling, neither visible while char was the only one:
    //
    // * widen SIGN-EXTENDED. char is signed here, so widen('\xD0') produced
    //   the wchar_t -48 — and <ostream>'s WriteRun, widening the very same
    //   byte on its way into a wide stream, produced U+00D0. Two answers to
    //   one question. They agree now, on WriteRun's: a byte widens to the
    //   code point with its own value.
    //
    // * narrow TRUNCATED. narrow(L'ж', '?') returned 0x36, the low byte of
    //   U+0436, which is the digit '6' — a plausible character, silently
    //   wrong, from a function whose second parameter exists precisely to say
    //   "there is no such character". Only ASCII has a single-byte form in
    //   this system's encoding, and <cwchar>'s wctob already says so
    //   (measured in Ф42-b: wctob(L'ж') is EOF). narrow says it too now.
    //
    // The pair is deliberately NOT a round trip above ASCII: widen has no
    // default parameter and must return something, narrow has one and uses
    // it. [locale.ctype] only ever requires the round trip for the basic
    // character set.
    // [basic.ios.members]: both are defined as calls into the ctype facet of
    // THIS stream's locale, and since Ф43-a that is a real question — a
    // program can install its own ctype and imbue the stream with it. Until
    // Ф43-b these two answered by themselves, so an installed ctype would
    // have been ignored in silence. The answers for the classic facet are the
    // same ones, and the reasoning that produced them now lives in
    // <__bits/locale_ctype> beside the facet that gives them.
    char narrow(char_type c, char dflt) const
    {
        return use_facet<ctype<char_type>>(this->__loc_ref()).narrow(c, dflt);
    }
    char_type widen(char c) const
    {
        return use_facet<ctype<char_type>>(this->__loc_ref()).widen(c);
    }

    basic_ios(const basic_ios &) = delete;
    basic_ios &operator=(const basic_ios &) = delete;

protected:
    basic_ios() noexcept = default;

    void init(basic_streambuf<CharT, Traits> *sb)
    {
        __sb     = sb;
        __tie    = nullptr;
        __state  = sb ? iostate::goodbit : iostate::badbit;
        __except = iostate::goodbit;
        this->flags(fmtflags::skipws | fmtflags::dec);
        this->width(0);
        this->precision(6);
        __fill = widen(' ');
    }

    // [basic.ios.members]/move — postconditions: *this takes rhs's ENTIRE
    // state (including rdstate()/exceptions(), unlike copyfmt) except that
    // this->rdbuf() becomes null; rhs keeps its OWN rdbuf() unchanged and
    // its tie() becomes null. No events fire (move is not copyfmt).
    void move(basic_ios &rhs)
    {
        this->MoveStateFrom(rhs);
        __tie      = rhs.__tie;
        __fill     = rhs.__fill;
        __state    = rhs.__state;
        __except   = rhs.__except;
        __sb       = nullptr;
        rhs.__tie  = nullptr;
    }
    void move(basic_ios &&rhs) { move(rhs); }

    // swap: both rdbuf()s are EXPLICITLY left untouched (neither this-> nor
    // rhs's streambuf pointer participates) — everything else is swapped.
    void swap(basic_ios &rhs) noexcept
    {
        this->SwapStateWith(rhs);
        using std::swap;
        swap(__tie, rhs.__tie);
        swap(__state, rhs.__state);
        swap(__except, rhs.__except);
        swap(__fill, rhs.__fill);
    }

    void set_rdbuf(basic_streambuf<CharT, Traits> *sb) noexcept { __sb = sb; }

private:
    basic_streambuf<CharT, Traits> *__sb = nullptr;
    basic_ostream<CharT, Traits> *__tie  = nullptr;
    iostate __state                     = iostate::goodbit;
    iostate __except                    = iostate::goodbit;
    char_type __fill                    = CharT();
};

