// here per the real <ios> synopsis -- endl/ends/flush/ws (which DO need a
// concrete stream) belong in <ostream>/<istream> instead (later commit).
// Every stream's operator<<(ios_base&(*)(ios_base&))/operator>>(...) hook
// (declared on basic_ostream/basic_istream) is what lets `os << std::hex`
// find these.
inline ios_base &boolalpha(ios_base &s)
{
    s.setf(ios_base::boolalpha);
    return s;
}
