// boxcxx — <ios>
// ios_base [ios.base] + basic_ios<CharT,Traits> [ios] — the shared state,
// formatting, and error-reporting base of the whole iostream hierarchy.
// No streambuf, no ostream/istream, no concrete stream classes here — see
// <streambuf>, <ostream>/<istream>, <sstream> (later commits).
//
// iword/pword/register_callback/xalloc are backed by real growable storage
// (vector<long>/vector<void*>/a small callback list), never a fixed-size
// array — mandated by ios_base's synopsis right now, not speculative.
//
// sync_with_stdio is an honest no-op: BoxOS has no C <stdio.h> buffer to
// (de)synchronize with (boxlib's own printf in print.c is an unrelated
// subsystem no stream in this header ever touches), so there is nothing for
// the flag to switch on or off. It returns the previous value and is
// otherwise inert.
//
// ios_base::Init is NOT a no-op any more. Since Ф36 there are four global
// stream objects for it to sequence — see <iostream>. Its ctor/dtor are
// defined in src/runtime/iostream.cpp, with the objects they answer for.
#ifndef BOXCXX_IOS
#define BOXCXX_IOS

#include <atomic>
#include <iosfwd>
#include <__bits/locale_core>   // locale — the facets that need ios_base are in <locale>
#include <__bits/locale_ctype>  // ctype — [basic.ios.members] defines widen/narrow as calls into it
#include <system_error>
#include <vector>

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_ios_noreplace
#include <__bits/version_iostreams>


namespace std {

// ── io_errc [ios.errc] ──────────────────────────────────────────────────

enum class io_errc {
    stream = 1
};

const error_category &iostream_category() noexcept;

inline error_code make_error_code(io_errc e) noexcept
{
    return error_code(static_cast<int>(e), iostream_category());
}
inline error_condition make_error_condition(io_errc e) noexcept
{
    return error_condition(static_cast<int>(e), iostream_category());
}

template <>
struct is_error_code_enum<io_errc> : true_type {};

// ── ios_base [ios.base] ──────────────────────────────────────────────────

class ios_base {
public:
    // fmtflags — bitmask type, hidden-friend operators keep it a real,
    // non-int-convertible type (safer than a plain unscoped enum).
    enum class fmtflags : unsigned {
        skipws     = 1u << 0,
        unitbuf    = 1u << 1,
        uppercase  = 1u << 2,
        showbase   = 1u << 3,
        showpoint  = 1u << 4,
        showpos    = 1u << 5,
        left       = 1u << 6,
        right      = 1u << 7,
        internal   = 1u << 8,
        dec        = 1u << 9,
        oct        = 1u << 10,
        hex        = 1u << 11,
        scientific = 1u << 12,
        fixed      = 1u << 13,
        boolalpha  = 1u << 14,
        adjustfield = left | right | internal,
        basefield   = dec | oct | hex,
        floatfield  = scientific | fixed, // hexfloat == both bits set
    };
    friend constexpr fmtflags operator|(fmtflags a, fmtflags b) noexcept
    {
        return static_cast<fmtflags>(static_cast<unsigned>(a) | static_cast<unsigned>(b));
    }
    friend constexpr fmtflags operator&(fmtflags a, fmtflags b) noexcept
    {
        return static_cast<fmtflags>(static_cast<unsigned>(a) & static_cast<unsigned>(b));
    }
    friend constexpr fmtflags operator^(fmtflags a, fmtflags b) noexcept
    {
        return static_cast<fmtflags>(static_cast<unsigned>(a) ^ static_cast<unsigned>(b));
    }
    friend constexpr fmtflags operator~(fmtflags a) noexcept
    {
        return static_cast<fmtflags>(~static_cast<unsigned>(a));
    }
    friend constexpr fmtflags &operator|=(fmtflags &a, fmtflags b) noexcept { return a = a | b; }
    friend constexpr fmtflags &operator&=(fmtflags &a, fmtflags b) noexcept { return a = a & b; }
    friend constexpr fmtflags &operator^=(fmtflags &a, fmtflags b) noexcept { return a = a ^ b; }

    static constexpr fmtflags skipws      = fmtflags::skipws;
    static constexpr fmtflags unitbuf     = fmtflags::unitbuf;
    static constexpr fmtflags uppercase   = fmtflags::uppercase;
    static constexpr fmtflags showbase    = fmtflags::showbase;
    static constexpr fmtflags showpoint   = fmtflags::showpoint;
    static constexpr fmtflags showpos     = fmtflags::showpos;
    static constexpr fmtflags left        = fmtflags::left;
    static constexpr fmtflags right       = fmtflags::right;
    static constexpr fmtflags internal    = fmtflags::internal;
    static constexpr fmtflags dec         = fmtflags::dec;
    static constexpr fmtflags oct         = fmtflags::oct;
    static constexpr fmtflags hex         = fmtflags::hex;
    static constexpr fmtflags scientific  = fmtflags::scientific;
    static constexpr fmtflags fixed       = fmtflags::fixed;
    static constexpr fmtflags boolalpha   = fmtflags::boolalpha;
    static constexpr fmtflags adjustfield = fmtflags::adjustfield;
    static constexpr fmtflags basefield   = fmtflags::basefield;
    static constexpr fmtflags floatfield  = fmtflags::floatfield;

    // iostate — bitmask type.
    enum class iostate : unsigned {
        goodbit = 0,
        badbit  = 1u << 0,
        failbit = 1u << 1,
        eofbit  = 1u << 2,
    };
    friend constexpr iostate operator|(iostate a, iostate b) noexcept
    {
        return static_cast<iostate>(static_cast<unsigned>(a) | static_cast<unsigned>(b));
    }
    friend constexpr iostate operator&(iostate a, iostate b) noexcept
    {
        return static_cast<iostate>(static_cast<unsigned>(a) & static_cast<unsigned>(b));
    }
    friend constexpr iostate operator^(iostate a, iostate b) noexcept
    {
        return static_cast<iostate>(static_cast<unsigned>(a) ^ static_cast<unsigned>(b));
    }
    friend constexpr iostate operator~(iostate a) noexcept
    {
        return static_cast<iostate>(~static_cast<unsigned>(a));
    }
    friend constexpr iostate &operator|=(iostate &a, iostate b) noexcept { return a = a | b; }
    friend constexpr iostate &operator&=(iostate &a, iostate b) noexcept { return a = a & b; }
    friend constexpr iostate &operator^=(iostate &a, iostate b) noexcept { return a = a ^ b; }

    static constexpr iostate goodbit = iostate::goodbit;
    static constexpr iostate badbit  = iostate::badbit;
    static constexpr iostate failbit = iostate::failbit;
    static constexpr iostate eofbit  = iostate::eofbit;

    // openmode — bitmask type.
    enum class openmode : unsigned {
        app       = 1u << 0,
        binary    = 1u << 1,
        in        = 1u << 2,
        out       = 1u << 3,
        trunc     = 1u << 4,
        ate       = 1u << 5,
        noreplace = 1u << 6, // C++23, P2467R1
    };
    friend constexpr openmode operator|(openmode a, openmode b) noexcept
    {
        return static_cast<openmode>(static_cast<unsigned>(a) | static_cast<unsigned>(b));
    }
    friend constexpr openmode operator&(openmode a, openmode b) noexcept
    {
        return static_cast<openmode>(static_cast<unsigned>(a) & static_cast<unsigned>(b));
    }
    friend constexpr openmode operator^(openmode a, openmode b) noexcept
    {
        return static_cast<openmode>(static_cast<unsigned>(a) ^ static_cast<unsigned>(b));
    }
    friend constexpr openmode operator~(openmode a) noexcept
    {
        return static_cast<openmode>(~static_cast<unsigned>(a));
    }
    friend constexpr openmode &operator|=(openmode &a, openmode b) noexcept { return a = a | b; }
    friend constexpr openmode &operator&=(openmode &a, openmode b) noexcept { return a = a & b; }
    friend constexpr openmode &operator^=(openmode &a, openmode b) noexcept { return a = a ^ b; }

    static constexpr openmode app       = openmode::app;
    static constexpr openmode binary    = openmode::binary;
    static constexpr openmode in        = openmode::in;
    static constexpr openmode out       = openmode::out;
    static constexpr openmode trunc     = openmode::trunc;
    static constexpr openmode ate       = openmode::ate;
    static constexpr openmode noreplace = openmode::noreplace;

    // seekdir — plain enum, NOT a bitmask (no combining needed).
    enum class seekdir { beg, cur, end };
    static constexpr seekdir beg = seekdir::beg;
    static constexpr seekdir cur = seekdir::cur;
    static constexpr seekdir end = seekdir::end;

    class failure;
    class Init;

    // ── formatting state [ios.base] ───────────────────────────────────
    fmtflags flags() const noexcept { return __flags; }
    fmtflags flags(fmtflags fmtfl) noexcept
    {
        fmtflags old = __flags;
        __flags      = fmtfl;
        return old;
    }
    fmtflags setf(fmtflags fmtfl) noexcept
    {
        fmtflags old = __flags;
        __flags      = __flags | fmtfl;
        return old;
    }
    fmtflags setf(fmtflags fmtfl, fmtflags mask) noexcept
    {
        fmtflags old = __flags;
        __flags      = (__flags & ~mask) | (fmtfl & mask);
        return old;
    }
    void unsetf(fmtflags mask) noexcept { __flags = __flags & ~mask; }

    streamsize precision() const noexcept { return __precision; }
    streamsize precision(streamsize prec) noexcept
    {
        streamsize old = __precision;
        __precision    = prec;
        return old;
    }
    streamsize width() const noexcept { return __width; }
    streamsize width(streamsize w) noexcept
    {
        streamsize old = __width;
        __width        = w;
        return old;
    }

    // ── locale ─────────────────────────────────────────────────────────
    locale imbue(const locale &loc)
    {
        locale old = __loc;
        __loc       = loc;
        FireEvent(imbue_event);
        return old;
    }
    locale getloc() const { return __loc; }

    // The locale itself, not the copy getloc() returns. use_facet hands back a
    // reference INTO the table a locale names, so binding one to a temporary
    // is the shape basic_streambuf::__loc_ref() exists to avoid. Public rather
    // than protected because the formatted inserters are FREE functions in
    // __ios — the standard's own model, where operator<< is not a member — and
    // they are the ones that need the locale without paying for a copy of it
    // on every number. The name is not part of any public interface.
    const locale &__loc_ref() const noexcept { return __loc; }

    // ── extensible storage [ios.base.storage] ─────────────────────────
    // xalloc() hands out a fresh, process-wide-unique, monotonically
    // increasing index; iword/pword grow their own per-object storage
    // on demand so any index xalloc() ever returns is always valid.
    static int xalloc() noexcept;

    long &iword(int idx)
    {
        // A negative index never comes from a valid xalloc() (its mandated
        // source), but idx is a raw caller-supplied int and xalloc()'s own
        // atomic<int> counter wraps negative after ~2^31 handouts over a
        // long-lived system — guard it so a bad index can never wrap
        // static_cast<size_t>(idx) huge and index out of bounds. Returns a
        // shared static sink (as libstdc++ does for a bad index).
        if (idx < 0) { static long __sink = 0; return __sink; }
        size_t at = static_cast<size_t>(idx);
        if (at >= __iwords.size()) __iwords.resize(at + 1, 0L);
        return __iwords[at];
    }
    void *&pword(int idx)
    {
        if (idx < 0) { static void *__sink = nullptr; return __sink; }
        size_t at = static_cast<size_t>(idx);
        if (at >= __pwords.size()) __pwords.resize(at + 1, nullptr);
        return __pwords[at];
    }

    enum event { erase_event, imbue_event, copyfmt_event };
    using event_callback = void (*)(event, ios_base &, int);
    void register_callback(event_callback fn, int idx) { __callbacks.push_back({fn, idx}); }

    virtual ~ios_base();
    ios_base(const ios_base &) = delete;
    ios_base &operator=(const ios_base &) = delete;

    static bool sync_with_stdio(bool sync = true) noexcept
    {
        static bool synced = true;
        bool old            = synced;
        synced              = sync;
        return old;
    }

protected:
    ios_base() noexcept = default;

    // Fires every registered callback in OPPOSITE order of registration
    // (LIFO) — [ios.base]: "Functions registered are called ... in
    // opposite order of registration."
    void FireEvent(event ev)
    {
        for (size_t i = __callbacks.size(); i-- > 0;)
            __callbacks[i].Fn(ev, *this, __callbacks[i].Idx);
    }
    // Plain field copy, no event firing — shared by copyfmt() (which
    // brackets this with erase_event/copyfmt_event itself) and by
    // basic_ios::move() (which per [basic.ios.members] fires no events
    // at all).
    void CopyStateFrom(const ios_base &rhs)
    {
        __flags     = rhs.__flags;
        __precision = rhs.__precision;
        __width     = rhs.__width;
        __loc       = rhs.__loc;
        __iwords    = rhs.__iwords;
        __pwords    = rhs.__pwords;
        __callbacks = rhs.__callbacks;
    }
    // Move variant for basic_ios::move — TRANSFERS the growable storage so
    // the moved-from object is left with EMPTY iword/pword/callback vectors.
    // A plain copy (CopyStateFrom) would leave BOTH objects holding the same
    // callback registrations and identical pword pointer values; each would
    // then fire erase_event over that shared list at destruction, so a
    // callback that releases its pword resource would run — and free — twice.
    void MoveStateFrom(ios_base &rhs)
    {
        __flags     = rhs.__flags;
        __precision = rhs.__precision;
        __width     = rhs.__width;
        __loc       = rhs.__loc;
        __iwords    = std::move(rhs.__iwords);
        __pwords    = std::move(rhs.__pwords);
        __callbacks = std::move(rhs.__callbacks);
    }
    void SwapStateWith(ios_base &rhs) noexcept
    {
        using std::swap;
        swap(__flags, rhs.__flags);
        swap(__precision, rhs.__precision);
        swap(__width, rhs.__width);
        swap(__loc, rhs.__loc);
        swap(__iwords, rhs.__iwords);
        swap(__pwords, rhs.__pwords);
        swap(__callbacks, rhs.__callbacks);
    }

private:
    struct CallbackEntry {
        event_callback Fn;
        int Idx;
    };

    fmtflags __flags        = fmtflags{};
    streamsize __precision  = 0;
    streamsize __width      = 0;
    locale __loc;   // [basic.ios.cons]: init() leaves getloc() == locale()
    vector<long> __iwords;
    vector<void *> __pwords;
    vector<CallbackEntry> __callbacks;
};

