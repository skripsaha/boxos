    }
    template <class F>
    constexpr auto transform(F &&f) &&
    {
        using U = remove_cv_t<invoke_result_t<F, T>>;
        if (has_value()) {
            if constexpr (is_void_v<U>) {
                invoke(static_cast<F &&>(f), static_cast<T &&>(this->val_));
                return expected<U, E>();
            } else
                return expected<U, E>(__expected::InvokeValTag{},
                                      static_cast<F &&>(f),
                                      static_cast<T &&>(this->val_));
        }
        return expected<U, E>(unexpect, static_cast<E &&>(this->err_));
    }
    template <class F>
    constexpr auto transform(F &&f) const &&
    {
        using U = remove_cv_t<invoke_result_t<F, const T>>;
        if (has_value()) {
            if constexpr (is_void_v<U>) {
                invoke(static_cast<F &&>(f),
                       static_cast<const T &&>(this->val_));
                return expected<U, E>();
            } else
                return expected<U, E>(__expected::InvokeValTag{},
                                      static_cast<F &&>(f),
                                      static_cast<const T &&>(this->val_));
        }
        return expected<U, E>(unexpect, static_cast<const E &&>(this->err_));
    }

    template <class F>
    constexpr auto transform_error(F &&f) &
    {
        using G = remove_cv_t<invoke_result_t<F, E &>>;
        if (has_value()) return expected<T, G>(in_place, this->val_);
        return expected<T, G>(__expected::InvokeErrTag{},
                              static_cast<F &&>(f), this->err_);
    }
    template <class F>
    constexpr auto transform_error(F &&f) const &
    {
        using G = remove_cv_t<invoke_result_t<F, const E &>>;
        if (has_value()) return expected<T, G>(in_place, this->val_);
        return expected<T, G>(__expected::InvokeErrTag{},
                              static_cast<F &&>(f), this->err_);
    }
    template <class F>
    constexpr auto transform_error(F &&f) &&
    {
        using G = remove_cv_t<invoke_result_t<F, E>>;
        if (has_value())
            return expected<T, G>(in_place, static_cast<T &&>(this->val_));
        return expected<T, G>(__expected::InvokeErrTag{},
                              static_cast<F &&>(f),
                              static_cast<E &&>(this->err_));
    }
    template <class F>
    constexpr auto transform_error(F &&f) const &&
    {
        using G = remove_cv_t<invoke_result_t<F, const E>>;
        if (has_value())
            return expected<T, G>(in_place,
                                  static_cast<const T &&>(this->val_));
        return expected<T, G>(__expected::InvokeErrTag{},
                              static_cast<F &&>(f),
                              static_cast<const E &&>(this->err_));
    }

    friend constexpr void swap(expected &a, expected &b) noexcept(
        noexcept(a.swap(b)))
        requires requires { a.swap(b); }
    {
        a.swap(b);
    }

    // P2944R3 turned these Mandates into Constraints: an expected whose
    // value type has no operator== must not SATISFY equality_comparable
    // and then fail inside the body, where no concept can see it.
    template <class U2, class E2>
        requires(!is_void_v<U2>) && __bits::EqComparableWith<T, U2> &&
                __bits::EqComparableWith<E, E2>
    friend constexpr bool operator==(const expected &a,
                                     const expected<U2, E2> &b)
    {
        if (a.has_value() != b.has_value()) return false;
        return a.has_value() ? static_cast<bool>(*a == *b)
                             : static_cast<bool>(a.error() == b.error());
    }
    // [expected.object.eq]/3's own "T2 is not a specialization of expected"
    // has to come FIRST: without it this candidate is considered for
    // expected-vs-expected too, and its constraint then asks whether
    // T == expected<...> compares -- which re-enters this same check.
    // GCC reports that as "satisfaction of atomic constraint depends on
    // itself", and it is not a compiler quirk: the recursion is real.
    template <class U2>
        requires(!__expected::IsExpected<U2>) &&
                (!__expected::IsUnexpected<U2>) &&
                __bits::EqComparableWith<T, U2>
    friend constexpr bool operator==(const expected &a, const U2 &v)
    {
        return a.has_value() && static_cast<bool>(*a == v);
    }
    template <class E2>
        requires __bits::EqComparableWith<E, E2>
    friend constexpr bool operator==(const expected &a,
                                     const unexpected<E2> &u)
    {
        return !a.has_value() && static_cast<bool>(a.error() == u.error());
    }

private:
    // raw alternative access for cross-type conversions (different
    // specialization, so the friend grant below is required).
    constexpr T       &Raw_Val() & noexcept { return this->val_; }
    constexpr const T &Raw_Val() const & noexcept { return this->val_; }
    constexpr E       &Raw_Err() & noexcept { return this->err_; }
    constexpr const E &Raw_Err() const & noexcept { return this->err_; }

    template <class F, class... A>
    constexpr explicit expected(__expected::InvokeValTag t, F &&f, A &&...a)
        : Base(t, static_cast<F &&>(f), static_cast<A &&>(a)...)
    {
    }
    template <class F, class... A>
    constexpr explicit expected(__expected::InvokeErrTag t, F &&f, A &&...a)
        : Base(t, static_cast<F &&>(f), static_cast<A &&>(a)...)
    {
    }

    template <class, class>
    friend class expected;
};

// ── expected<void, E> ────────────────────────────────────────────────────
// Reuses optional<E>'s conditional-triviality chain: "engaged" == holds an
// error. has_value() is therefore !Engaged().

template <class T, class E>
    requires is_void_v<T>
class expected<T, E>
    : private __optional::MoveAssign<E>,
      private __bits::EnableSpecial<
          is_copy_constructible_v<E>, is_move_constructible_v<E>,
          is_copy_assignable_v<E> && is_copy_constructible_v<E>,
          is_move_assignable_v<E> && is_move_constructible_v<E>,
          expected<T, E>> {
    static_assert(is_object_v<E> && !is_array_v<E> && !is_const_v<E> &&
                      !is_volatile_v<E>,
                  "expected<void,E>: E must be a cv-unqualified object type");

    using Base = __optional::MoveAssign<E>;

public:
    using value_type      = T;
    using error_type      = E;
    using unexpected_type = unexpected<E>;
    template <class U>
    using rebind = expected<U, error_type>;

    constexpr expected() noexcept {}
    constexpr expected(const expected &) = default;
    constexpr expected(expected &&)      = default;

    template <class U, class G>
        requires(is_void_v<U> && is_constructible_v<E, const G &>)
    constexpr explicit(!is_convertible_v<const G &, E>)
        expected(const expected<U, G> &o)
    {
        if (!o.has_value()) this->Construct(o.error());
    }
    template <class U, class G>
        requires(is_void_v<U> && is_constructible_v<E, G>)
    constexpr explicit(!is_convertible_v<G, E>) expected(expected<U, G> &&o)
    {
        if (!o.has_value())
            this->Construct(static_cast<G &&>(o.error()));
    }

    template <class G>
        requires is_constructible_v<E, const G &>
    constexpr explicit(!is_convertible_v<const G &, E>)
        expected(const unexpected<G> &u)
        : Base(in_place, u.error())
    {
    }
    template <class G>
        requires is_constructible_v<E, G>
    constexpr explicit(!is_convertible_v<G, E>) expected(unexpected<G> &&u)
        : Base(in_place, static_cast<G &&>(u.error()))
    {
    }

    constexpr explicit expected(in_place_t) noexcept {}
    template <class... A>
        requires is_constructible_v<E, A...>
    constexpr explicit expected(unexpect_t, A &&...a)
        : Base(in_place, static_cast<A &&>(a)...)
    {
    }
    template <class U, class... A>
        requires is_constructible_v<E, initializer_list<U> &, A...>
    constexpr explicit expected(unexpect_t, initializer_list<U> il, A &&...a)
        : Base(in_place, il, static_cast<A &&>(a)...)
    {
    }

    constexpr expected &operator=(const expected &) = default;
    constexpr expected &operator=(expected &&)      = default;
    ~expected()                                     = default;

    template <class G>
        requires(is_constructible_v<E, const G &> &&
                 is_assignable_v<E &, const G &>)
    constexpr expected &operator=(const unexpected<G> &u)
    {
        if (has_value())
            this->Construct(u.error());
        else
            this->Get() = u.error();
        return *this;
    }
    template <class G>
        requires(is_constructible_v<E, G> && is_assignable_v<E &, G>)
    constexpr expected &operator=(unexpected<G> &&u)
    {
        if (has_value())
            this->Construct(static_cast<G &&>(u.error()));
        else
            this->Get() = static_cast<G &&>(u.error());
        return *this;
    }

    constexpr void emplace() noexcept { this->Reset(); }

    constexpr void swap(expected &o) noexcept(
        is_nothrow_move_constructible_v<E> && is_nothrow_swappable_v<E>)
        requires(is_swappable_v<E> && is_move_constructible_v<E>)
    {
        if (!has_value() && !o.has_value()) {
            using std::swap;
            swap(this->Get(), o.Get());
        } else if (!has_value()) {
            o.Construct(static_cast<E &&>(this->Get()));
            this->Reset();
        } else if (!o.has_value()) {
            this->Construct(static_cast<E &&>(o.Get()));
            o.Reset();
        }
    }

    constexpr explicit operator bool() const noexcept
    {
        return !this->Engaged();
    }
    constexpr bool has_value() const noexcept { return !this->Engaged(); }

    constexpr void operator*() const noexcept {}
    constexpr void value() const &
    {
        if (!has_value()) throw bad_expected_access<E>(this->Get());
    }
    constexpr void value() &&
    {
        if (!has_value())
            throw bad_expected_access<E>(static_cast<E &&>(this->Get()));
    }

    constexpr const E &error() const & noexcept { return this->Get(); }
    constexpr E &error() & noexcept { return this->Get(); }
    constexpr const E &&error() const && noexcept
    {
        return static_cast<const E &&>(this->Get());
    }
    constexpr E &&error() && noexcept
    {
        return static_cast<E &&>(this->Get());
    }
    template <class G = E>
    constexpr E error_or(G &&d) const &
    {
        return has_value() ? static_cast<E>(static_cast<G &&>(d))
                           : this->Get();
    }
    template <class G = E>
    constexpr E error_or(G &&d) &&
    {
        return has_value() ? static_cast<E>(static_cast<G &&>(d))
                           : static_cast<E &&>(this->Get());
    }

    template <class F>
    constexpr auto and_then(F &&f) &
    {
        using U = remove_cvref_t<invoke_result_t<F>>;
        if (has_value()) return invoke(static_cast<F &&>(f));
        return U(unexpect, this->Get());
    }
    template <class F>
    constexpr auto and_then(F &&f) const &
    {
        using U = remove_cvref_t<invoke_result_t<F>>;
        if (has_value()) return invoke(static_cast<F &&>(f));
        return U(unexpect, this->Get());
    }
    template <class F>
    constexpr auto and_then(F &&f) &&
    {
        using U = remove_cvref_t<invoke_result_t<F>>;
        if (has_value()) return invoke(static_cast<F &&>(f));
        return U(unexpect, static_cast<E &&>(this->Get()));
    }

    template <class F>
    constexpr auto or_else(F &&f) &
    {
        using G = remove_cvref_t<invoke_result_t<F, E &>>;
        if (has_value()) return G();
        return invoke(static_cast<F &&>(f), this->Get());
    }
    template <class F>
    constexpr auto or_else(F &&f) const &
    {
        using G = remove_cvref_t<invoke_result_t<F, const E &>>;
        if (has_value()) return G();
        return invoke(static_cast<F &&>(f), this->Get());
    }
    template <class F>
    constexpr auto or_else(F &&f) &&
    {
        using G = remove_cvref_t<invoke_result_t<F, E>>;
        if (has_value()) return G();
        return invoke(static_cast<F &&>(f), static_cast<E &&>(this->Get()));
    }

    template <class F>
    constexpr auto transform(F &&f) &
    {
        using U = remove_cv_t<invoke_result_t<F>>;
        if (has_value()) {
            if constexpr (is_void_v<U>) {
                invoke(static_cast<F &&>(f));
                return expected<U, E>();
            } else {
                return expected<U, E>(in_place, invoke(static_cast<F &&>(f)));
            }
        }
        return expected<U, E>(unexpect, this->Get());
    }
    template <class F>
    constexpr auto transform(F &&f) &&
    {
        using U = remove_cv_t<invoke_result_t<F>>;
        if (has_value()) {
            if constexpr (is_void_v<U>) {
                invoke(static_cast<F &&>(f));
                return expected<U, E>();
            } else {
                return expected<U, E>(in_place, invoke(static_cast<F &&>(f)));
            }
        }
        return expected<U, E>(unexpect, static_cast<E &&>(this->Get()));
    }

    template <class F>
    constexpr auto transform_error(F &&f) &
    {
        using G = remove_cv_t<invoke_result_t<F, E &>>;
        if (has_value()) return expected<T, G>();
        return expected<T, G>(unexpect, invoke(static_cast<F &&>(f),
                                               this->Get()));
    }
    template <class F>
    constexpr auto transform_error(F &&f) &&
    {
        using G = remove_cv_t<invoke_result_t<F, E>>;
        if (has_value()) return expected<T, G>();
        return expected<T, G>(
            unexpect, invoke(static_cast<F &&>(f),
                             static_cast<E &&>(this->Get())));
    }

    friend constexpr void swap(expected &a, expected &b) noexcept(
        noexcept(a.swap(b)))
        requires requires { a.swap(b); }
    {
        a.swap(b);
    }

    template <class U2, class E2>
        requires is_void_v<U2> && __bits::EqComparableWith<E, E2>
    friend constexpr bool operator==(const expected &a,
                                     const expected<U2, E2> &b)
    {
        if (a.has_value() != b.has_value()) return false;
        return a.has_value() ||
               static_cast<bool>(a.error() == b.error());
    }
    template <class E2>
        requires __bits::EqComparableWith<E, E2>
    friend constexpr bool operator==(const expected &a,
                                     const unexpected<E2> &u)
    {
        return !a.has_value() && static_cast<bool>(a.error() == u.error());
    }

    template <class, class>
    friend class expected;
};

