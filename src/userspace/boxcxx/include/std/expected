    }

    constexpr const E &error() const & noexcept { return this->err_; }
    constexpr E &error() & noexcept { return this->err_; }
    constexpr const E &&error() const && noexcept
    {
        return static_cast<const E &&>(this->err_);
    }
    constexpr E &&error() && noexcept { return static_cast<E &&>(this->err_); }

    template <class U>
    constexpr T value_or(U &&d) const &
    {
        return has_value() ? this->val_
                           : static_cast<T>(static_cast<U &&>(d));
    }
    template <class U>
