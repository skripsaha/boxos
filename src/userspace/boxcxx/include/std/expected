    constexpr auto and_then(F &&f) &&
    {
        using U = remove_cvref_t<invoke_result_t<F, T>>;
        if (has_value())
            return invoke(static_cast<F &&>(f),
                          static_cast<T &&>(this->val_));
        return U(unexpect, static_cast<E &&>(this->err_));
    }
    template <class F>
    constexpr auto and_then(F &&f) const &&
    {
        using U = remove_cvref_t<invoke_result_t<F, const T>>;
        if (has_value())
            return invoke(static_cast<F &&>(f),
                          static_cast<const T &&>(this->val_));
        return U(unexpect, static_cast<const E &&>(this->err_));
    }

    template <class F>
    constexpr auto or_else(F &&f) &
    {
        using G = remove_cvref_t<invoke_result_t<F, E &>>;
        if (has_value()) return G(in_place, this->val_);
        return invoke(static_cast<F &&>(f), this->err_);
    }
    template <class F>
    constexpr auto or_else(F &&f) const &
    {
        using G = remove_cvref_t<invoke_result_t<F, const E &>>;
        if (has_value()) return G(in_place, this->val_);
        return invoke(static_cast<F &&>(f), this->err_);
    }
    template <class F>
    constexpr auto or_else(F &&f) &&
    {
        using G = remove_cvref_t<invoke_result_t<F, E>>;
        if (has_value()) return G(in_place, static_cast<T &&>(this->val_));
        return invoke(static_cast<F &&>(f), static_cast<E &&>(this->err_));
    }
    template <class F>
    constexpr auto or_else(F &&f) const &&
    {
        using G = remove_cvref_t<invoke_result_t<F, const E>>;
        if (has_value())
            return G(in_place, static_cast<const T &&>(this->val_));
        return invoke(static_cast<F &&>(f),
                      static_cast<const E &&>(this->err_));
    }

    template <class F>
    constexpr auto transform(F &&f) &
    {
        using U = remove_cv_t<invoke_result_t<F, T &>>;
        if (has_value()) {
            if constexpr (is_void_v<U>) {
                invoke(static_cast<F &&>(f), this->val_);
                return expected<U, E>();
            } else
                return expected<U, E>(__expected::InvokeValTag{},
                                      static_cast<F &&>(f), this->val_);
        }
        return expected<U, E>(unexpect, this->err_);
    }
    template <class F>
    constexpr auto transform(F &&f) const &
    {
        using U = remove_cv_t<invoke_result_t<F, const T &>>;
        if (has_value()) {
            if constexpr (is_void_v<U>) {
                invoke(static_cast<F &&>(f), this->val_);
                return expected<U, E>();
            } else
                return expected<U, E>(__expected::InvokeValTag{},
                                      static_cast<F &&>(f), this->val_);
