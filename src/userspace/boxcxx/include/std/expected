                           : static_cast<E &&>(this->err_);
    }

    // monadic (C++23) ----------------------------------------------------
    template <class F>
    constexpr auto and_then(F &&f) &
    {
        using U = remove_cvref_t<invoke_result_t<F, T &>>;
        if (has_value()) return invoke(static_cast<F &&>(f), this->val_);
        return U(unexpect, this->err_);
    }
    template <class F>
    constexpr auto and_then(F &&f) const &
    {
        using U = remove_cvref_t<invoke_result_t<F, const T &>>;
        if (has_value()) return invoke(static_cast<F &&>(f), this->val_);
