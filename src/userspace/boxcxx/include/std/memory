// ── [ptr.align] pointer alignment ────────────────────────────────────────
// Carve an aligned sub-buffer out of raw storage, in place: on success ptr
// moves forward to the first suitably aligned byte and space shrinks by
// exactly the padding consumed, so the same buffer can be walked with
// repeated calls of differing alignment. The two guards are written as
// subtractions rather than `pad + size > space` because the sum can wrap
// on a buffer near the top of the address space -- and on this kernel a
// caller really can hand it one.
inline void *align(size_t alignment, size_t size, void *&ptr, size_t &space)
{
    const uintptr_t p   = reinterpret_cast<uintptr_t>(ptr);
    const uintptr_t a   = (p + (alignment - 1)) & ~static_cast<uintptr_t>(alignment - 1);
    const size_t    pad = static_cast<size_t>(a - p);
    if (space < pad || space - pad < size) return nullptr;
    space -= pad;
    ptr = reinterpret_cast<void *>(a);
    return ptr;
}

// is_sufficiently_aligned ([ptr.align], P2897R7). assume_aligned TELLS the
// compiler an alignment holds and is undefined behaviour when it does not;
// this ASKS. They are the two halves of the same fact and only one of them
// existed.
template <size_t N, class T>
[[nodiscard]] bool is_sufficiently_aligned(T *ptr)
{
    return (reinterpret_cast<uintptr_t>(ptr) % N) == 0;
}


// [ptr.align]/4: a promise to the optimiser, not a check. The constant-
// evaluation branch is mandatory, not an optimisation:
// __builtin_assume_aligned is not a constant expression, so without it
// assume_aligned could never appear in a constexpr call chain -- and the
// standard requires exactly that ("the return value is usable in constant
// expressions" whenever the argument is).
template <size_t N, class T>
[[nodiscard]] constexpr T *assume_aligned(T *ptr)
{
    static_assert(N != 0 && (N & (N - 1)) == 0,
                  "std::assume_aligned<N>: N must be a power of two");
    if (is_constant_evaluated()) return ptr;
    return static_cast<T *>(__builtin_assume_aligned(ptr, N));
}

// ── [obj.lifetime] explicit lifetime management ─────────────────────────
// P2590R2. This is the sanctioned way to say "there are already bytes
// there; treat them as an object of implicit-lifetime type T" -- exactly
// what a driver does with a DMA descriptor a device wrote, or what this
// kernel does when it maps a structure onto a firmware table. The cast
// alone would be undefined behaviour: no T was ever created there.
//
// The implementation is a self-move through __builtin_memmove. That is
// not a no-op dressed up: [intro.object]/13 makes memmove one of the
// operations that IMPLICITLY CREATES objects in its destination region,
// which is precisely the effect being asked for, and the compiler folds
// the byte movement itself away because source and destination are the
// same address. launder then keeps the returned pointer from being
// constant-folded back onto whatever the front end thought was living
// there before. __builtin_memmove (rather than a memmove declaration) is
// deliberate: it survives -fno-builtin, which this tree compiles with.
//
// Not constexpr, per the standard: implicit object creation has no
// constant-evaluation model.
//
// One Mandates goes unchecked: "T is an implicit-lifetime type". Checking
// it needs __builtin_is_implicit_lifetime, which x86_64-elf-g++ 15.2.0
// does not have -- the same missing builtin that keeps
// __cpp_lib_is_implicit_lifetime undefined in <version>. The other half,
// "not an incomplete type", the sizeof below enforces on its own.
template <class T>
T *start_lifetime_as(void *p) noexcept
{
    return launder(static_cast<T *>(__builtin_memmove(p, p, sizeof(T))));
}
template <class T>
const T *start_lifetime_as(const void *p) noexcept
{
    return start_lifetime_as<T>(const_cast<void *>(p));
}
template <class T>
volatile T *start_lifetime_as(volatile void *p) noexcept
{
    return start_lifetime_as<T>(const_cast<void *>(p));
}
template <class T>
const volatile T *start_lifetime_as(const volatile void *p) noexcept
{
    return start_lifetime_as<T>(const_cast<void *>(p));
}

// n == 0 has no effects at all and returns p unchanged ([obj.lifetime]/6)
// -- note that this is the one case where the returned pointer is not the
// address of any created object, and the standard says so explicitly.
template <class T>
T *start_lifetime_as_array(void *p, size_t n) noexcept
{
    if (n == 0) return static_cast<T *>(p);
    return launder(
        static_cast<T *>(__builtin_memmove(p, p, n * sizeof(T))));
}
template <class T>
const T *start_lifetime_as_array(const void *p, size_t n) noexcept
{
    return start_lifetime_as_array<T>(const_cast<void *>(p), n);
}
template <class T>
volatile T *start_lifetime_as_array(volatile void *p, size_t n) noexcept
{
    return start_lifetime_as_array<T>(const_cast<void *>(p), n);
}
template <class T>
const volatile T *start_lifetime_as_array(const volatile void *p,
                                          size_t n) noexcept
{
    return start_lifetime_as_array<T>(const_cast<void *>(p), n);
}

// ── uninitialized-memory algorithms ([uninitialized]) ────────────────────

template <class It, class Size>
constexpr It uninitialized_default_construct_n(It first, Size n)
{
    using T = typename iterator_traits<It>::value_type;
    It cur  = first;
    if constexpr (is_trivially_default_constructible_v<T>) {
        for (; n > 0; --n, (void)++cur)
            ;
        return cur;
    } else {
        try {
            for (; n > 0; --n, (void)++cur)
                ::new (static_cast<void *>(addressof(*cur))) T;
            return cur;
        } catch (...) {
            destroy(first, cur);
            throw;
        }
    }
}
template <class It>
constexpr void uninitialized_default_construct(It first, It last)
{
    using T = typename iterator_traits<It>::value_type;
    It cur  = first;
    try {
        for (; cur != last; ++cur)
            ::new (static_cast<void *>(addressof(*cur))) T;
    } catch (...) {
        destroy(first, cur);
        throw;
    }
}

template <class It, class Size>
constexpr It uninitialized_value_construct_n(It first, Size n)
{
    using T = typename iterator_traits<It>::value_type;
    It cur  = first;
    try {
        for (; n > 0; --n, (void)++cur)
            ::new (static_cast<void *>(addressof(*cur))) T();
        return cur;
    } catch (...) {
        destroy(first, cur);
        throw;
    }
}
template <class It>
constexpr void uninitialized_value_construct(It first, It last)
{
    using T = typename iterator_traits<It>::value_type;
    It cur  = first;
    try {
        for (; cur != last; ++cur)
            ::new (static_cast<void *>(addressof(*cur))) T();
    } catch (...) {
        destroy(first, cur);
        throw;
    }
}

template <class In, class Out>
constexpr Out uninitialized_copy(In first, In last, Out d)
{
    using T = typename iterator_traits<Out>::value_type;
    Out cur = d;
    try {
        for (; first != last; ++first, (void)++cur)
            ::new (static_cast<void *>(addressof(*cur))) T(*first);
        return cur;
    } catch (...) {
        destroy(d, cur);
        throw;
    }
}
template <class In, class Size, class Out>
constexpr Out uninitialized_copy_n(In first, Size n, Out d)
{
    using T = typename iterator_traits<Out>::value_type;
    Out cur = d;
    try {
        for (; n > 0; --n, (void)++first, (void)++cur)
            ::new (static_cast<void *>(addressof(*cur))) T(*first);
        return cur;
    } catch (...) {
        destroy(d, cur);
        throw;
    }
}

template <class In, class Out>
constexpr Out uninitialized_move(In first, In last, Out d)
{
    using T = typename iterator_traits<Out>::value_type;
    Out cur = d;
    try {
        for (; first != last; ++first, (void)++cur)
            ::new (static_cast<void *>(addressof(*cur)))
                T(static_cast<typename iterator_traits<In>::value_type &&>(
                    *first));
        return cur;
    } catch (...) {
        destroy(d, cur);
        throw;
    }
}
template <class In, class Size, class Out>
constexpr pair<In, Out> uninitialized_move_n(In first, Size n, Out d)
{
    using T = typename iterator_traits<Out>::value_type;
    Out cur = d;
    try {
        for (; n > 0; --n, (void)++first, (void)++cur)
            ::new (static_cast<void *>(addressof(*cur)))
                T(static_cast<typename iterator_traits<In>::value_type &&>(
                    *first));
        return {first, cur};
    } catch (...) {
        destroy(d, cur);
        throw;
    }
}

