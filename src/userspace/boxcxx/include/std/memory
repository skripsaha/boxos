} // namespace __shared

template <class T>
class shared_ptr {
public:
    using element_type = remove_extent_t<T>;
    using weak_type    = weak_ptr<T>;

private:
    element_type          *ptr_  = nullptr;
    __shared::CountedBase *ctrl_ = nullptr;

    template <class>
    friend class shared_ptr;
    template <class>
    friend class weak_ptr;

public:
    constexpr shared_ptr() noexcept = default;
    constexpr shared_ptr(nullptr_t) noexcept {}

    // Internal: adopt an already-+1'd control block (make_shared path).
    constexpr shared_ptr(__shared::AdoptTag, element_type *p,
                         __shared::CountedBase *c) noexcept
        : ptr_(p), ctrl_(c)
    {
    }

    // Internal: if Y derives from enable_shared_from_this<U>, seed its
    // weak_this_ exactly once. The void* overload is the no-op fallback.
    template <class U, class Y>
    static void EnableShared(const enable_shared_from_this<U> *e, Y *p,
                             __shared::CountedBase *c) noexcept
    {
        if (e) {
            auto *base = const_cast<enable_shared_from_this<U> *>(e);
            if (base->weak_this_.expired())
                base->weak_this_.InternalAssign(
                    static_cast<U *>(const_cast<remove_cv_t<Y> *>(p)), c);
        }
    }
    static void EnableShared(const volatile void *, const volatile void *,
                             __shared::CountedBase *) noexcept
    {
    }

    template <class Y>
        requires(is_convertible_v<Y *, element_type *> ||
                 (is_array_v<T> &&
                  is_convertible_v<Y (*)[], remove_extent_t<T> (*)[]>))
    explicit shared_ptr(Y *p) : ptr_(p)
    {
        ctrl_ = new __shared::CountedPtr<Y *>(p);
        EnableShared(p, p, ctrl_);
    }

    template <class Y, class Deleter>
        requires(is_move_constructible_v<Deleter> &&
                 requires(Deleter d, Y *p) { d(p); })
    shared_ptr(Y *p, Deleter d) : ptr_(p)
    {
        using Block =
            __shared::CountedDeleter<Y *, Deleter, allocator<Y>>;
        ctrl_ = new Block(p, static_cast<Deleter &&>(d), allocator<Y>());
        EnableShared(p, p, ctrl_);
    }
    template <class Y, class Deleter, class Alloc>
    shared_ptr(Y *p, Deleter d, Alloc a) : ptr_(p)
    {
        using Block = __shared::CountedDeleter<Y *, Deleter, Alloc>;
        using BA    = typename allocator_traits<
            Alloc>::template rebind_alloc<Block>;
        BA     ba(a);
        Block *b = allocator_traits<BA>::allocate(ba, 1);
        ::new (static_cast<void *>(b))
            Block(p, static_cast<Deleter &&>(d), a);
        ctrl_ = b;
        EnableShared(p, p, ctrl_);
    }
    template <class Deleter>
    shared_ptr(nullptr_t, Deleter d)
    {
        using Block =
            __shared::CountedDeleter<element_type *, Deleter, allocator<T>>;
        ctrl_ = new Block(nullptr, static_cast<Deleter &&>(d), allocator<T>());
    }

    // aliasing
    template <class Y>
    shared_ptr(const shared_ptr<Y> &r, element_type *p) noexcept
        : ptr_(p), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->AddRef();
    }
    template <class Y>
    shared_ptr(shared_ptr<Y> &&r, element_type *p) noexcept
        : ptr_(p), ctrl_(r.ctrl_)
    {
        r.ptr_  = nullptr;
        r.ctrl_ = nullptr;
    }

    shared_ptr(const shared_ptr &r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->AddRef();
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    shared_ptr(const shared_ptr<Y> &r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->AddRef();
    }
    shared_ptr(shared_ptr &&r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        r.ptr_  = nullptr;
        r.ctrl_ = nullptr;
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    shared_ptr(shared_ptr<Y> &&r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        r.ptr_  = nullptr;
        r.ctrl_ = nullptr;
    }

    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    explicit shared_ptr(const weak_ptr<Y> &r) : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (!ctrl_ || !ctrl_->AddRefLock()) __throw_bad_weak_ptr();
    }

    template <class Y, class D>
        requires is_convertible_v<typename unique_ptr<Y, D>::pointer,
                                  element_type *>
    shared_ptr(unique_ptr<Y, D> &&u)
    {
        if (u.get()) {
            auto *p = u.get();
            if constexpr (is_reference_v<D>)
                ctrl_ = new __shared::CountedDeleter<
                    typename unique_ptr<Y, D>::pointer, D &, allocator<Y>>(
                    p, u.get_deleter(), allocator<Y>());
            else
                ctrl_ = new __shared::CountedDeleter<
                    typename unique_ptr<Y, D>::pointer, D, allocator<Y>>(
                    p, static_cast<D &&>(u.get_deleter()), allocator<Y>());
            ptr_ = p;
            EnableShared(p, p, ctrl_);
            u.release();
        }
    }

    ~shared_ptr()
    {
        if (ctrl_) ctrl_->Release();
    }

    shared_ptr &operator=(const shared_ptr &r) noexcept
    {
        shared_ptr(r).swap(*this);
        return *this;
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    shared_ptr &operator=(const shared_ptr<Y> &r) noexcept
    {
        shared_ptr(r).swap(*this);
        return *this;
    }
    shared_ptr &operator=(shared_ptr &&r) noexcept
    {
        shared_ptr(static_cast<shared_ptr &&>(r)).swap(*this);
        return *this;
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    shared_ptr &operator=(shared_ptr<Y> &&r) noexcept
    {
        shared_ptr(static_cast<shared_ptr<Y> &&>(r)).swap(*this);
        return *this;
    }
    template <class Y, class D>
    shared_ptr &operator=(unique_ptr<Y, D> &&u)
    {
        shared_ptr(static_cast<unique_ptr<Y, D> &&>(u)).swap(*this);
        return *this;
    }

    void reset() noexcept { shared_ptr().swap(*this); }
    template <class Y>
    void reset(Y *p)
    {
        shared_ptr(p).swap(*this);
    }
    template <class Y, class Deleter>
    void reset(Y *p, Deleter d)
    {
        shared_ptr(p, static_cast<Deleter &&>(d)).swap(*this);
    }
    void swap(shared_ptr &o) noexcept
    {
        element_type *tp = ptr_;
        ptr_             = o.ptr_;
        o.ptr_           = tp;
        __shared::CountedBase *tc = ctrl_;
        ctrl_                     = o.ctrl_;
        o.ctrl_                   = tc;
    }

    element_type *get() const noexcept { return ptr_; }
    T            &operator*() const noexcept
        requires(!is_array_v<T> && !is_void_v<T>)
    {
        return *ptr_;
    }
    element_type *operator->() const noexcept
        requires(!is_array_v<T>)
    {
        return ptr_;
    }
    element_type &operator[](ptrdiff_t i) const
        requires is_array_v<T>
    {
        return ptr_[i];
    }
    long use_count() const noexcept { return ctrl_ ? ctrl_->UseCount() : 0; }
    explicit operator bool() const noexcept { return ptr_ != nullptr; }

    template <class U>
    bool owner_before(const shared_ptr<U> &o) const noexcept
    {
        return ctrl_ < o.ctrl_;
    }
    template <class U>
    bool owner_before(const weak_ptr<U> &o) const noexcept
    {
        return ctrl_ < o.ctrl_;
    }

    template <class D, class U>
    friend D *get_deleter(const shared_ptr<U> &) noexcept;
};

template <class T>
shared_ptr(weak_ptr<T>) -> shared_ptr<T>;
template <class T, class D>
shared_ptr(unique_ptr<T, D>) -> shared_ptr<T>;

template <class T>
class weak_ptr {
public:
    using element_type = remove_extent_t<T>;

private:
    element_type          *ptr_  = nullptr;
    __shared::CountedBase *ctrl_ = nullptr;

    template <class>
    friend class weak_ptr;
    template <class>
    friend class shared_ptr;
    template <class>
    friend class enable_shared_from_this;

    void InternalAssign(element_type *p, __shared::CountedBase *c) noexcept
    {
        if (c) c->WeakAddRef();
        if (ctrl_) ctrl_->WeakRelease();
        ptr_  = p;
        ctrl_ = c;
    }

public:
    constexpr weak_ptr() noexcept = default;

    weak_ptr(const weak_ptr &r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->WeakAddRef();
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    weak_ptr(const weak_ptr<Y> &r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->WeakAddRef();
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    weak_ptr(const shared_ptr<Y> &r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->WeakAddRef();
    }
    weak_ptr(weak_ptr &&r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        r.ptr_  = nullptr;
        r.ctrl_ = nullptr;
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    weak_ptr(weak_ptr<Y> &&r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        r.ptr_  = nullptr;
        r.ctrl_ = nullptr;
    }

    ~weak_ptr()
    {
        if (ctrl_) ctrl_->WeakRelease();
    }

    weak_ptr &operator=(const weak_ptr &r) noexcept
    {
        weak_ptr(r).swap(*this);
        return *this;
    }
    template <class Y>
    weak_ptr &operator=(const weak_ptr<Y> &r) noexcept
    {
        weak_ptr(r).swap(*this);
        return *this;
    }
    template <class Y>
    weak_ptr &operator=(const shared_ptr<Y> &r) noexcept
    {
        weak_ptr(r).swap(*this);
        return *this;
    }
    weak_ptr &operator=(weak_ptr &&r) noexcept
    {
        weak_ptr(static_cast<weak_ptr &&>(r)).swap(*this);
        return *this;
    }
    template <class Y>
    weak_ptr &operator=(weak_ptr<Y> &&r) noexcept
    {
        weak_ptr(static_cast<weak_ptr<Y> &&>(r)).swap(*this);
        return *this;
    }

    long use_count() const noexcept { return ctrl_ ? ctrl_->UseCount() : 0; }
    bool expired() const noexcept { return use_count() == 0; }
    void reset() noexcept { weak_ptr().swap(*this); }
    void swap(weak_ptr &o) noexcept
    {
        element_type *tp = ptr_;
        ptr_             = o.ptr_;
        o.ptr_           = tp;
        __shared::CountedBase *tc = ctrl_;
        ctrl_                     = o.ctrl_;
        o.ctrl_                   = tc;
    }
    shared_ptr<T> lock() const noexcept
    {
        shared_ptr<T> r;
        if (ctrl_ && ctrl_->AddRefLock()) {
            r.ptr_  = ptr_;
            r.ctrl_ = ctrl_;
        }
        return r;
    }
    template <class U>
    bool owner_before(const weak_ptr<U> &o) const noexcept
    {
        return ctrl_ < o.ctrl_;
    }
    template <class U>
    bool owner_before(const shared_ptr<U> &o) const noexcept
    {
        return ctrl_ < o.ctrl_;
    }
};

template <class T>
weak_ptr(shared_ptr<T>) -> weak_ptr<T>;

template <class T>
class enable_shared_from_this {
    mutable weak_ptr<T> weak_this_;

    template <class>
    friend class shared_ptr;

protected:
    constexpr enable_shared_from_this() noexcept {}
    enable_shared_from_this(const enable_shared_from_this &) noexcept {}
    enable_shared_from_this &
    operator=(const enable_shared_from_this &) noexcept
    {
        return *this;
    }
    ~enable_shared_from_this() = default;

public:
    shared_ptr<T>       shared_from_this() { return shared_ptr<T>(weak_this_); }
    shared_ptr<const T> shared_from_this() const
    {
        return shared_ptr<const T>(weak_this_);
    }
    weak_ptr<T>       weak_from_this() noexcept { return weak_this_; }
    weak_ptr<const T> weak_from_this() const noexcept { return weak_this_; }
};

// ── make_shared / allocate_shared ────────────────────────────────────────

template <class T, class... A>
    requires(!is_array_v<T>)
shared_ptr<T> make_shared(A &&...args)
{
    using Block = __shared::CountedInplace<T, allocator<T>>;
    allocator<Block> ba;
    Block           *b = ba.allocate(1);
    try {
        ::new (static_cast<void *>(b))
            Block(allocator<T>(), static_cast<A &&>(args)...);
    } catch (...) {
        ba.deallocate(b, 1);
        throw;
    }
    shared_ptr<T> sp(__shared::AdoptTag{}, b->Get(), b);
    shared_ptr<T>::EnableShared(b->Get(), b->Get(), b);
    return sp;
}
template <class T>
    requires(!is_array_v<T>)
shared_ptr<T> make_shared_for_overwrite()
{
    return make_shared<T>();
}
template <class T, class Alloc, class... A>
    requires(!is_array_v<T>)
shared_ptr<T> allocate_shared(const Alloc &a, A &&...args)
{
    using Block = __shared::CountedInplace<T, Alloc>;
    using BA = typename allocator_traits<Alloc>::template rebind_alloc<Block>;
    BA     ba(a);
    Block *b = allocator_traits<BA>::allocate(ba, 1);
    try {
        ::new (static_cast<void *>(b)) Block(a, static_cast<A &&>(args)...);
    } catch (...) {
        allocator_traits<BA>::deallocate(ba, b, 1);
        throw;
    }
    shared_ptr<T> sp(__shared::AdoptTag{}, b->Get(), b);
    shared_ptr<T>::EnableShared(b->Get(), b->Get(), b);
    return sp;
}

// make_shared / allocate_shared — array forms -----------------------------

template <class T>
    requires __shared::IsUnboundedArray<T>
shared_ptr<T> make_shared(size_t n)
{
    using E = remove_extent_t<T>;
    return __shared::MakeSharedArray<T>(allocator<E>(), n,
                                        [](E *p) { construct_at(p); });
}
template <class T>
    requires __shared::IsUnboundedArray<T>
shared_ptr<T> make_shared(size_t n, const remove_extent_t<T> &u)
{
    using E = remove_extent_t<T>;
    return __shared::MakeSharedArray<T>(allocator<E>(), n,
                                        [&](E *p) { construct_at(p, u); });
}
template <class T>
    requires(is_array_v<T> && extent_v<T> != 0)
shared_ptr<T> make_shared()
{
    using E = remove_extent_t<T>;
    return __shared::MakeSharedArray<T>(allocator<E>(), extent_v<T>,
                                        [](E *p) { construct_at(p); });
}
template <class T>
    requires(is_array_v<T> && extent_v<T> != 0)
shared_ptr<T> make_shared(const remove_extent_t<T> &u)
{
    using E = remove_extent_t<T>;
    return __shared::MakeSharedArray<T>(allocator<E>(), extent_v<T>,
                                        [&](E *p) { construct_at(p, u); });
}
template <class T>
    requires __shared::IsUnboundedArray<T>
shared_ptr<T> make_shared_for_overwrite(size_t n)
{
    using E = remove_extent_t<T>;
    return __shared::MakeSharedArray<T>(
        allocator<E>(), n, [](E *p) { ::new (static_cast<void *>(p)) E; });
}
template <class T>
    requires(is_array_v<T> && extent_v<T> != 0)
shared_ptr<T> make_shared_for_overwrite()
{
    using E = remove_extent_t<T>;
    return __shared::MakeSharedArray<T>(
        allocator<E>(), extent_v<T>,
        [](E *p) { ::new (static_cast<void *>(p)) E; });
}
template <class T, class Alloc>
    requires __shared::IsUnboundedArray<T>
shared_ptr<T> allocate_shared(const Alloc &a, size_t n)
{
    using E = remove_extent_t<T>;
    return __shared::MakeSharedArray<T>(a, n, [](E *p) { construct_at(p); });
}
template <class T, class Alloc>
    requires __shared::IsUnboundedArray<T>
shared_ptr<T> allocate_shared(const Alloc &a, size_t n,
                              const remove_extent_t<T> &u)
{
    using E = remove_extent_t<T>;
    return __shared::MakeSharedArray<T>(a, n,
                                        [&](E *p) { construct_at(p, u); });
}

// ── pointer casts ────────────────────────────────────────────────────────

template <class T, class U>
shared_ptr<T> static_pointer_cast(const shared_ptr<U> &r) noexcept
{
    return shared_ptr<T>(r,
                         static_cast<typename shared_ptr<T>::element_type *>(
                             r.get()));
}
template <class T, class U>
shared_ptr<T> dynamic_pointer_cast(const shared_ptr<U> &r) noexcept
{
    using E = typename shared_ptr<T>::element_type;
    if (auto *p = dynamic_cast<E *>(r.get())) return shared_ptr<T>(r, p);
    return shared_ptr<T>();
}
template <class T, class U>
shared_ptr<T> const_pointer_cast(const shared_ptr<U> &r) noexcept
{
    return shared_ptr<T>(r,
                         const_cast<typename shared_ptr<T>::element_type *>(
                             r.get()));
}
template <class T, class U>
shared_ptr<T> reinterpret_pointer_cast(const shared_ptr<U> &r) noexcept
{
    return shared_ptr<T>(
        r, reinterpret_cast<typename shared_ptr<T>::element_type *>(r.get()));
}

template <class D, class U>
D *get_deleter(const shared_ptr<U> &p) noexcept
{
    if (p.ctrl_)
        return static_cast<D *>(p.ctrl_->GetDeleter(typeid(remove_cv_t<D>)));
    return nullptr;
}

// ── comparisons / swap / owner_less / hash ───────────────────────────────

template <class T, class U>
bool operator==(const shared_ptr<T> &a, const shared_ptr<U> &b) noexcept
{
    return a.get() == b.get();
}
template <class T, class U>
strong_ordering operator<=>(const shared_ptr<T> &a,
                            const shared_ptr<U> &b) noexcept
{
    return compare_three_way{}(a.get(), b.get());
}
template <class T>
bool operator==(const shared_ptr<T> &a, nullptr_t) noexcept
{
    return !a;
}
template <class T>
strong_ordering operator<=>(const shared_ptr<T> &a, nullptr_t) noexcept
{
    return compare_three_way{}(
        a.get(), static_cast<typename shared_ptr<T>::element_type *>(nullptr));
}

template <class T>
void swap(shared_ptr<T> &a, shared_ptr<T> &b) noexcept
{
    a.swap(b);
}
template <class T>
void swap(weak_ptr<T> &a, weak_ptr<T> &b) noexcept
{
    a.swap(b);
}

template <class T = void>
struct owner_less;
template <class T>
struct owner_less<shared_ptr<T>> {
    bool operator()(const shared_ptr<T> &a, const shared_ptr<T> &b) const noexcept
    {
        return a.owner_before(b);
    }
