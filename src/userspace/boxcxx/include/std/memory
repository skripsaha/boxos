// ── Annex D: the free shared_ptr atomic functions ───────────────────────
// [depr.util.smartptr.shared.atomic]. Deprecated in C++20 and removed in
// C++26, but normative in C++23, which is what this library targets — the
// C++26 phase deletes them. They are NOT the atomic<shared_ptr> above with a
// different spelling: they act on a shared_ptr the program owns and has not
// wrapped, so they take their exclusion from the address-hashed pool rather
// than from a control word inside the object, and only these functions
// (never atomic<shared_ptr>) are atomic with respect to each other.
// The standard declares them without noexcept; matched exactly.

template <class T>
bool atomic_is_lock_free(const shared_ptr<T> *)
{
    return false;
}

template <class T>
shared_ptr<T> atomic_load(const shared_ptr<T> *p)
{
    __smartptr_atomic::Guard g(__smartptr_atomic::FreeCtlFor(p));
    return *p;
}
template <class T>
shared_ptr<T> atomic_load_explicit(const shared_ptr<T> *p, memory_order)
{
    return atomic_load(p);
}

template <class T>
void atomic_store(shared_ptr<T> *p, shared_ptr<T> r)
{
    __smartptr_atomic::Guard g(__smartptr_atomic::FreeCtlFor(p));
    p->swap(r);
    g.Mutated();
}
template <class T>
void atomic_store_explicit(shared_ptr<T> *p, shared_ptr<T> r, memory_order)
{
    atomic_store(p, static_cast<shared_ptr<T> &&>(r));
}

template <class T>
shared_ptr<T> atomic_exchange(shared_ptr<T> *p, shared_ptr<T> r)
{
