// ── atomic<shared_ptr> / atomic<weak_ptr> ([util.smartptr.atomic]) ───────
// Spinlock-guarded (is_lock_free() == false), as in every mainstream
// implementation: the control-block refcounts are already atomic, but the
// {pointer, control-block} pair must move together. Two smart pointers are
// "equivalent" iff they store the same pointer AND share ownership (neither
// owner_before the other). notify_* are no-ops, matching boxcxx's address-
// monitor atomic wait policy ([[cxx-honest-leftovers]]).

template <class T>
struct atomic<shared_ptr<T>> {
private:
    shared_ptr<T>         p_;
    mutable unsigned char lock_ = 0;
    void Acquire() const noexcept
    {
        while (__atomic_test_and_set(&lock_, __ATOMIC_ACQUIRE))
            ;
    }
    void ReleaseLock() const noexcept
    {
        __atomic_clear(&lock_, __ATOMIC_RELEASE);
    }
    static bool Equiv(const shared_ptr<T> &a, const shared_ptr<T> &b) noexcept
    {
        return a.get() == b.get() && !a.owner_before(b) && !b.owner_before(a);
    }

public:
    static constexpr bool is_always_lock_free = false;

    constexpr atomic() noexcept = default;
    constexpr atomic(nullptr_t) noexcept {}
    atomic(shared_ptr<T> d) noexcept : p_(static_cast<shared_ptr<T> &&>(d)) {}
    atomic(const atomic &)        = delete;
    void operator=(const atomic &) = delete;

    bool is_lock_free() const noexcept { return false; }

    void store(shared_ptr<T> d, memory_order = memory_order_seq_cst) noexcept
    {
        Acquire();
        p_.swap(d);
        ReleaseLock();
    }
    void operator=(shared_ptr<T> d) noexcept
    {
        store(static_cast<shared_ptr<T> &&>(d));
    }
    shared_ptr<T> load(memory_order = memory_order_seq_cst) const noexcept
    {
        Acquire();
        shared_ptr<T> r = p_;
        ReleaseLock();
        return r;
    }
    operator shared_ptr<T>() const noexcept { return load(); }

    shared_ptr<T> exchange(shared_ptr<T> d,
                           memory_order = memory_order_seq_cst) noexcept
    {
        Acquire();
        p_.swap(d);
        ReleaseLock();
        return d;
    }

    bool compare_exchange_strong(shared_ptr<T> &expected, shared_ptr<T> desired,
                                 memory_order = memory_order_seq_cst,
                                 memory_order = memory_order_seq_cst) noexcept
    {
        shared_ptr<T> old;
        Acquire();
        if (Equiv(p_, expected)) {
            old.swap(p_);
            p_.swap(desired);
            ReleaseLock();
            return true;
        }
        old = p_;
        ReleaseLock();
        expected = static_cast<shared_ptr<T> &&>(old);
        return false;
    }
    bool compare_exchange_weak(shared_ptr<T> &e, shared_ptr<T> d,
                               memory_order s = memory_order_seq_cst,
                               memory_order f = memory_order_seq_cst) noexcept
    {
        return compare_exchange_strong(e, static_cast<shared_ptr<T> &&>(d), s,
                                       f);
    }
    bool compare_exchange_strong(shared_ptr<T> &e, shared_ptr<T> d,
                                 memory_order o) noexcept
    {
        return compare_exchange_strong(e, static_cast<shared_ptr<T> &&>(d), o,
                                       o);
    }
    bool compare_exchange_weak(shared_ptr<T> &e, shared_ptr<T> d,
                               memory_order o) noexcept
    {
        return compare_exchange_strong(e, static_cast<shared_ptr<T> &&>(d), o,
                                       o);
    }

    void wait(shared_ptr<T> old, memory_order = memory_order_seq_cst) const
        noexcept
    {
        while (Equiv(load(), old))
            ;
    }
    void notify_one() noexcept {}
    void notify_all() noexcept {}
};

template <class T>
struct atomic<weak_ptr<T>> {
private:
    weak_ptr<T>           p_;
    mutable unsigned char lock_ = 0;
    void Acquire() const noexcept
    {
        while (__atomic_test_and_set(&lock_, __ATOMIC_ACQUIRE))
            ;
    }
    void ReleaseLock() const noexcept
    {
        __atomic_clear(&lock_, __ATOMIC_RELEASE);
    }
    static bool Equiv(const weak_ptr<T> &a, const weak_ptr<T> &b) noexcept
    {
        return !a.owner_before(b) && !b.owner_before(a);
    }

public:
    static constexpr bool is_always_lock_free = false;

    constexpr atomic() noexcept = default;
    atomic(weak_ptr<T> d) noexcept : p_(static_cast<weak_ptr<T> &&>(d)) {}
    atomic(const atomic &)        = delete;
    void operator=(const atomic &) = delete;

    bool is_lock_free() const noexcept { return false; }

    void store(weak_ptr<T> d, memory_order = memory_order_seq_cst) noexcept
    {
        Acquire();
        p_.swap(d);
        ReleaseLock();
    }
    void operator=(weak_ptr<T> d) noexcept
    {
        store(static_cast<weak_ptr<T> &&>(d));
    }
    weak_ptr<T> load(memory_order = memory_order_seq_cst) const noexcept
    {
        Acquire();
        weak_ptr<T> r = p_;
        ReleaseLock();
        return r;
    }
    operator weak_ptr<T>() const noexcept { return load(); }

    weak_ptr<T> exchange(weak_ptr<T> d,
                         memory_order = memory_order_seq_cst) noexcept
    {
        Acquire();
        p_.swap(d);
        ReleaseLock();
        return d;
    }
    bool compare_exchange_strong(weak_ptr<T> &expected, weak_ptr<T> desired,
                                 memory_order = memory_order_seq_cst,
                                 memory_order = memory_order_seq_cst) noexcept
    {
        weak_ptr<T> old;
        Acquire();
        if (Equiv(p_, expected)) {
            old.swap(p_);
            p_.swap(desired);
            ReleaseLock();
            return true;
        }
        old = p_;
        ReleaseLock();
        expected = static_cast<weak_ptr<T> &&>(old);
        return false;
    }
    bool compare_exchange_weak(weak_ptr<T> &e, weak_ptr<T> d,
                               memory_order s = memory_order_seq_cst,
                               memory_order f = memory_order_seq_cst) noexcept
    {
        return compare_exchange_strong(e, static_cast<weak_ptr<T> &&>(d), s, f);
    }
    void notify_one() noexcept {}
    void notify_all() noexcept {}
};

