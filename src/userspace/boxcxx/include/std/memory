// ── default_delete ───────────────────────────────────────────────────────

template <class T>
struct default_delete {
    constexpr default_delete() noexcept = default;
    // constexpr, per P2273R3: without it a converting unique_ptr move
    // (unique_ptr<Derived> -> unique_ptr<Base>) is not a constant
    // expression, which is the one hole that kept
    // __cpp_lib_constexpr_memory undefined.
    template <class U>
        requires is_convertible_v<U *, T *>
    constexpr default_delete(const default_delete<U> &) noexcept
    {
    }
    constexpr void operator()(T *p) const
    {
        static_assert(sizeof(T) > 0, "default_delete: incomplete type");
        delete p;
    }
};

template <class T>
struct default_delete<T[]> {
    constexpr default_delete() noexcept = default;
    template <class U>
        requires is_convertible_v<U (*)[], T (*)[]>
    constexpr default_delete(const default_delete<U[]> &) noexcept
    {
    }
    template <class U>
        requires is_convertible_v<U (*)[], T (*)[]>
    constexpr void operator()(U *p) const
    {
        static_assert(sizeof(U) > 0, "default_delete: incomplete type");
        delete[] p;
    }
};

// ── unique_ptr ───────────────────────────────────────────────────────────

namespace __uptr {
template <class T, class D>
struct PtrType {
    using type = T *;
};
template <class T, class D>
    requires requires { typename remove_reference_t<D>::pointer; }
struct PtrType<T, D> {
    using type = typename remove_reference_t<D>::pointer;
};
} // namespace __uptr

template <class T, class D = default_delete<T>>
class unique_ptr {
public:
    using pointer      = typename __uptr::PtrType<T, D>::type;
    using element_type = T;
    using deleter_type = D;

private:
    pointer               ptr_;
    [[no_unique_address]] D del_;

public:
    constexpr unique_ptr() noexcept
        requires(!is_pointer_v<D> && is_default_constructible_v<D>)
        : ptr_(), del_()
    {
    }
    constexpr unique_ptr(nullptr_t) noexcept
        requires(!is_pointer_v<D> && is_default_constructible_v<D>)
        : ptr_(), del_()
    {
    }
    constexpr explicit unique_ptr(pointer p) noexcept
        requires(!is_pointer_v<D> && is_default_constructible_v<D>)
        : ptr_(p), del_()
    {
    }

    constexpr unique_ptr(pointer p, const D &d) noexcept
        requires is_constructible_v<D, const D &>
        : ptr_(p), del_(d)
    {
    }
    constexpr unique_ptr(pointer p, remove_reference_t<D> &&d) noexcept
        requires(!is_reference_v<D> && is_constructible_v<D, remove_reference_t<D>>)
        : ptr_(p), del_(static_cast<remove_reference_t<D> &&>(d))
    {
    }

    constexpr unique_ptr(unique_ptr &&u) noexcept
        requires is_move_constructible_v<D>
        : ptr_(u.release()), del_(static_cast<D &&>(u.del_))
    {
    }
    template <class U, class E>
        requires(is_convertible_v<typename unique_ptr<U, E>::pointer, pointer> &&
                 !is_array_v<U> &&
                 ((is_reference_v<D> && is_same_v<D, E>) ||
                  (!is_reference_v<D> && is_convertible_v<E, D>)))
    constexpr unique_ptr(unique_ptr<U, E> &&u) noexcept
        : ptr_(u.release()), del_(static_cast<E &&>(u.get_deleter()))
    {
    }

    constexpr ~unique_ptr()
    {
        if (ptr_) del_(ptr_);
    }

    unique_ptr(const unique_ptr &)            = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;

    constexpr unique_ptr &operator=(unique_ptr &&u) noexcept
        requires is_move_assignable_v<D>
    {
        reset(u.release());
        del_ = static_cast<D &&>(u.del_);
        return *this;
    }
    template <class U, class E>
        requires(is_convertible_v<typename unique_ptr<U, E>::pointer, pointer> &&
                 !is_array_v<U> && is_assignable_v<D &, E &&>)
    constexpr unique_ptr &operator=(unique_ptr<U, E> &&u) noexcept
    {
        reset(u.release());
        del_ = static_cast<E &&>(u.get_deleter());
        return *this;
    }
    constexpr unique_ptr &operator=(nullptr_t) noexcept
    {
        reset();
        return *this;
    }

    constexpr add_lvalue_reference_t<T> operator*() const
        noexcept(noexcept(*declval<pointer>()))
    {
        return *ptr_;
    }
    constexpr pointer operator->() const noexcept { return ptr_; }
    constexpr pointer get() const noexcept { return ptr_; }
    constexpr D       &get_deleter() noexcept { return del_; }
    constexpr const D &get_deleter() const noexcept { return del_; }
    constexpr explicit operator bool() const noexcept { return ptr_ != nullptr; }

    constexpr pointer release() noexcept
    {
        pointer p = ptr_;
        ptr_      = nullptr;
        return p;
    }
    constexpr void reset(pointer p = pointer()) noexcept
    {
        pointer old = ptr_;
        ptr_        = p;
        if (old) del_(old);
    }
    constexpr void swap(unique_ptr &o) noexcept
    {
        using std::swap;
        swap(ptr_, o.ptr_);
        swap(del_, o.del_);
    }
};

template <class T, class D>
class unique_ptr<T[], D> {
public:
    using pointer      = typename __uptr::PtrType<T, D>::type;
    using element_type = T;
    using deleter_type = D;

private:
    pointer               ptr_;
    [[no_unique_address]] D del_;

    template <class U>
    static constexpr bool SafePtr =
        is_same_v<U, pointer> || is_same_v<U, nullptr_t> ||
        (is_pointer_v<U> &&
         is_convertible_v<remove_pointer_t<U> (*)[], T (*)[]>);

public:
    constexpr unique_ptr() noexcept
        requires(!is_pointer_v<D> && is_default_constructible_v<D>)
        : ptr_(), del_()
    {
    }
    constexpr unique_ptr(nullptr_t) noexcept
        requires(!is_pointer_v<D> && is_default_constructible_v<D>)
        : ptr_(), del_()
    {
    }
    template <class U>
        requires(SafePtr<U> && !is_pointer_v<D> &&
                 is_default_constructible_v<D>)
    constexpr explicit unique_ptr(U p) noexcept : ptr_(p), del_()
    {
    }
    template <class U>
        requires(SafePtr<U> && is_constructible_v<D, const D &>)
    constexpr unique_ptr(U p, const D &d) noexcept : ptr_(p), del_(d)
    {
    }
    template <class U>
        requires(SafePtr<U> && !is_reference_v<D> &&
                 is_constructible_v<D, remove_reference_t<D>>)
    constexpr unique_ptr(U p, remove_reference_t<D> &&d) noexcept
        : ptr_(p), del_(static_cast<remove_reference_t<D> &&>(d))
    {
    }

    constexpr unique_ptr(unique_ptr &&u) noexcept
        requires is_move_constructible_v<D>
        : ptr_(u.release()), del_(static_cast<D &&>(u.get_deleter()))
    {
    }
    template <class U, class E>
        requires(is_array_v<U> &&
                 is_same_v<pointer, element_type *> &&
                 is_same_v<typename unique_ptr<U, E>::pointer,
                           typename unique_ptr<U, E>::element_type *> &&
                 is_convertible_v<typename unique_ptr<U, E>::element_type (*)[],
                                  T (*)[]> &&
                 ((is_reference_v<D> && is_same_v<D, E>) ||
                  (!is_reference_v<D> && is_convertible_v<E, D>)))
    constexpr unique_ptr(unique_ptr<U, E> &&u) noexcept
        : ptr_(u.release()), del_(static_cast<E &&>(u.get_deleter()))
    {
    }

    constexpr ~unique_ptr()
    {
        if (ptr_) del_(ptr_);
    }

    unique_ptr(const unique_ptr &)            = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;

    constexpr unique_ptr &operator=(unique_ptr &&u) noexcept
        requires is_move_assignable_v<D>
    {
        reset(u.release());
        del_ = static_cast<D &&>(u.get_deleter());
        return *this;
    }
    constexpr unique_ptr &operator=(nullptr_t) noexcept
    {
        reset();
        return *this;
    }

    constexpr T       &operator[](size_t i) const { return ptr_[i]; }
    constexpr pointer  get() const noexcept { return ptr_; }
    constexpr D       &get_deleter() noexcept { return del_; }
    constexpr const D &get_deleter() const noexcept { return del_; }
    constexpr explicit operator bool() const noexcept { return ptr_ != nullptr; }

    constexpr pointer release() noexcept
    {
        pointer p = ptr_;
        ptr_      = nullptr;
        return p;
    }
    template <class U = pointer>
        requires SafePtr<U>
    constexpr void reset(U p) noexcept
    {
        pointer old = ptr_;
        ptr_        = p;
        if (old) del_(old);
    }
    constexpr void reset(nullptr_t = nullptr) noexcept
    {
        pointer old = ptr_;
        ptr_        = nullptr;
        if (old) del_(old);
    }
    constexpr void swap(unique_ptr &o) noexcept
    {
        using std::swap;
        swap(ptr_, o.ptr_);
        swap(del_, o.del_);
    }
};

template <class T, class D>
    requires is_swappable_v<D>
constexpr void swap(unique_ptr<T, D> &a, unique_ptr<T, D> &b) noexcept
{
    a.swap(b);
}

template <class T1, class D1, class T2, class D2>
constexpr bool operator==(const unique_ptr<T1, D1> &a,
                          const unique_ptr<T2, D2> &b)
{
    return a.get() == b.get();
}
template <class T1, class D1, class T2, class D2>
    requires three_way_comparable_with<typename unique_ptr<T1, D1>::pointer,
                                       typename unique_ptr<T2, D2>::pointer>
constexpr compare_three_way_result_t<typename unique_ptr<T1, D1>::pointer,
                                     typename unique_ptr<T2, D2>::pointer>
operator<=>(const unique_ptr<T1, D1> &a, const unique_ptr<T2, D2> &b)
{
    return compare_three_way{}(a.get(), b.get());
}
template <class T, class D>
constexpr bool operator==(const unique_ptr<T, D> &a, nullptr_t) noexcept
{
    return !a;
}
template <class T, class D>
constexpr compare_three_way_result_t<typename unique_ptr<T, D>::pointer>
operator<=>(const unique_ptr<T, D> &a, nullptr_t)
{
    using P = typename unique_ptr<T, D>::pointer;
    return compare_three_way{}(a.get(), static_cast<P>(nullptr));
}

