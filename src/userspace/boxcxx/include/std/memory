// Atomic-refcounted control block. use_ governs the managed object; weak_
// governs the control block itself, with one extra weak ref held while
// use_ != 0 — so weak_ptr::lock and shared_from_this keep working right up
// to the last shared_ptr.
class CountedBase {
    mutable long use_  = 1;
    mutable long weak_ = 1;

public:
    CountedBase() noexcept                     = default;
    CountedBase(const CountedBase &)            = delete;
    CountedBase &operator=(const CountedBase &) = delete;
    virtual ~CountedBase() noexcept            = default;

    virtual void  Dispose() noexcept            = 0;
    virtual void  DestroyBlock() noexcept { delete this; }
    virtual void *GetDeleter(const type_info &) noexcept { return nullptr; }

    void AddRef() noexcept { __atomic_add_fetch(&use_, 1, __ATOMIC_RELAXED); }
    bool AddRefLock() noexcept
    {
        long c = __atomic_load_n(&use_, __ATOMIC_RELAXED);
        while (c != 0)
            if (__atomic_compare_exchange_n(&use_, &c, c + 1, true,
                                            __ATOMIC_ACQ_REL, __ATOMIC_RELAXED))
                return true;
        return false;
    }
    void Release() noexcept
    {
        if (__atomic_sub_fetch(&use_, 1, __ATOMIC_ACQ_REL) == 0) {
            Dispose();
            WeakRelease();
        }
    }
    void WeakAddRef() noexcept
    {
        __atomic_add_fetch(&weak_, 1, __ATOMIC_RELAXED);
    }
    void WeakRelease() noexcept
    {
        if (__atomic_sub_fetch(&weak_, 1, __ATOMIC_ACQ_REL) == 0)
            DestroyBlock();
    }
    long UseCount() const noexcept
    {
        return __atomic_load_n(&use_, __ATOMIC_RELAXED);
    }
};

template <class Ptr>
class CountedPtr final : public CountedBase {
    Ptr ptr_;

public:
    explicit CountedPtr(Ptr p) noexcept : ptr_(p) {}
    void Dispose() noexcept override { delete ptr_; }
};

template <class Ptr, class Deleter, class Alloc>
class CountedDeleter final : public CountedBase {
    Ptr                     ptr_;
    [[no_unique_address]] Deleter del_;
    [[no_unique_address]] Alloc   alloc_;

public:
    CountedDeleter(Ptr p, Deleter d, Alloc a) noexcept
        : ptr_(p), del_(static_cast<Deleter &&>(d)),
          alloc_(static_cast<Alloc &&>(a))
    {
    }
    void  Dispose() noexcept override { del_(ptr_); }
    void *GetDeleter(const type_info &ti) noexcept override
    {
        return ti == typeid(Deleter) ? __builtin_addressof(del_) : nullptr;
    }
    void DestroyBlock() noexcept override
    {
        using A = typename allocator_traits<
            Alloc>::template rebind_alloc<CountedDeleter>;
        A a(alloc_);
        this->~CountedDeleter();
        allocator_traits<A>::deallocate(a, this, 1);
    }
};

template <class T, class Alloc>
class CountedInplace final : public CountedBase {
    [[no_unique_address]] Alloc alloc_;
    union {
        T obj_;
    };

public:
    template <class... A>
    explicit CountedInplace(const Alloc &a, A &&...args) : alloc_(a)
    {
        ::new (static_cast<void *>(__builtin_addressof(obj_)))
            T(static_cast<A &&>(args)...);
    }
    ~CountedInplace() {} // obj_ destroyed in Dispose; alloc_ trivially gone
    T   *Get() noexcept { return __builtin_addressof(obj_); }
    void Dispose() noexcept override
    {
        __builtin_addressof(obj_)->~T();
    }
    void DestroyBlock() noexcept override
    {
        using A = typename allocator_traits<
            Alloc>::template rebind_alloc<CountedInplace>;
        A a(alloc_);
        this->~CountedInplace();
        allocator_traits<A>::deallocate(a, this, 1);
    }
};

// Tag for the internal "adopt an already-+1'd control block" constructor
// (used by make_shared/allocate_shared). Lives here so those factories can
// name it; users cannot reach __shared.
struct AdoptTag {};

// Array control block for make_shared<T[]> / allocate_shared<T[]>: header +
// n elements in one allocation, aligned for the element type. Allocation
// goes through the allocator rebound to an over-aligned Chunk so both
// make_shared (allocator<Elem>) and allocate_shared (custom) get the right
// alignment.
template <class T, class Alloc>
class CountedArray final : public CountedBase {
public:
    using Elem = remove_extent_t<T>;
    static constexpr size_t kAlign =
        alignof(CountedArray) > alignof(Elem) ? alignof(CountedArray)
                                              : alignof(Elem);
    struct alignas(kAlign) Chunk {
        unsigned char b[kAlign];
    };

private:
    [[no_unique_address]] Alloc alloc_;
    size_t                      n_;

    static constexpr size_t HdrSize()
    {
        return (sizeof(CountedArray) + alignof(Elem) - 1) & ~(alignof(Elem) - 1);
    }

public:
    CountedArray(const Alloc &a, size_t n) noexcept : alloc_(a), n_(n) {}
    Elem *Get() noexcept
    {
        return reinterpret_cast<Elem *>(reinterpret_cast<char *>(this) +
                                        HdrSize());
    }
    static size_t Bytes(size_t n) { return HdrSize() + n * sizeof(Elem); }
    static size_t Chunks(size_t bytes)
    {
        return (bytes + sizeof(Chunk) - 1) / sizeof(Chunk);
    }
    void Dispose() noexcept override
    {
        Elem *e = Get();
        for (size_t i = n_; i-- > 0;) e[i].~Elem();
    }
    void DestroyBlock() noexcept override
    {
        using CA =
            typename allocator_traits<Alloc>::template rebind_alloc<Chunk>;
        CA     ca(alloc_);
        size_t nch = Chunks(Bytes(n_));
        this->~CountedArray();
        allocator_traits<CA>::deallocate(ca, reinterpret_cast<Chunk *>(this),
                                         nch);
    }
};

template <class T, class Alloc, class Init>
shared_ptr<T> MakeSharedArray(const Alloc &alloc, size_t n, Init init)
{
    using Block = CountedArray<T, Alloc>;
    using Elem  = typename Block::Elem;
    using CA = typename allocator_traits<Alloc>::template rebind_alloc<
        typename Block::Chunk>;
    CA     ca(alloc);
    size_t nch = Block::Chunks(Block::Bytes(n));
    auto  *raw = allocator_traits<CA>::allocate(ca, nch);
    Block *b   = ::new (static_cast<void *>(raw)) Block(alloc, n);
    Elem  *e   = b->Get();
    size_t i   = 0;
    try {
        for (; i < n; ++i) init(e + i);
    } catch (...) {
        for (size_t j = i; j-- > 0;) e[j].~Elem();
        b->~Block();
        allocator_traits<CA>::deallocate(ca, raw, nch);
        throw;
    }
    return shared_ptr<T>(AdoptTag{}, e, b);
}

