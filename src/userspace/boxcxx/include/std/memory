template <class T, class... A>
    requires(!is_array_v<T>)
constexpr unique_ptr<T> make_unique(A &&...a)
{
    return unique_ptr<T>(new T(static_cast<A &&>(a)...));
}
template <class T>
    requires(is_array_v<T> && extent_v<T> == 0)
