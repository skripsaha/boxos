class bad_weak_ptr : public exception {
public:
    bad_weak_ptr() noexcept = default;
    ~bad_weak_ptr() override;
    const char *what() const noexcept override;
};
[[noreturn]] void __throw_bad_weak_ptr();

template <class T>
class shared_ptr;
template <class T>
class weak_ptr;
template <class T>
class enable_shared_from_this;

namespace __shared {

// Atomic-refcounted control block. use_ governs the managed object; weak_
// governs the control block itself, with one extra weak ref held while
// use_ != 0 — so weak_ptr::lock and shared_from_this keep working right up
// to the last shared_ptr.
class CountedBase {
    mutable long use_  = 1;
    mutable long weak_ = 1;

public:
    CountedBase() noexcept                     = default;
    CountedBase(const CountedBase &)            = delete;
    CountedBase &operator=(const CountedBase &) = delete;
    virtual ~CountedBase() noexcept            = default;

    virtual void  Dispose() noexcept            = 0;
    virtual void  DestroyBlock() noexcept { delete this; }
    virtual void *GetDeleter(const type_info &) noexcept { return nullptr; }

    void AddRef() noexcept { __atomic_add_fetch(&use_, 1, __ATOMIC_RELAXED); }
    bool AddRefLock() noexcept
    {
        long c = __atomic_load_n(&use_, __ATOMIC_RELAXED);
        while (c != 0)
            if (__atomic_compare_exchange_n(&use_, &c, c + 1, true,
                                            __ATOMIC_ACQ_REL, __ATOMIC_RELAXED))
                return true;
        return false;
    }
    void Release() noexcept
    {
        if (__atomic_sub_fetch(&use_, 1, __ATOMIC_ACQ_REL) == 0) {
            Dispose();
            WeakRelease();
        }
    }
    void WeakAddRef() noexcept
    {
        __atomic_add_fetch(&weak_, 1, __ATOMIC_RELAXED);
    }
    void WeakRelease() noexcept
    {
        if (__atomic_sub_fetch(&weak_, 1, __ATOMIC_ACQ_REL) == 0)
            DestroyBlock();
    }
    long UseCount() const noexcept
    {
        return __atomic_load_n(&use_, __ATOMIC_RELAXED);
    }
};

template <class Ptr>
class CountedPtr final : public CountedBase {
    Ptr ptr_;

public:
    explicit CountedPtr(Ptr p) noexcept : ptr_(p) {}
    void Dispose() noexcept override { delete ptr_; }
};

template <class Ptr, class Deleter, class Alloc>
class CountedDeleter final : public CountedBase {
    Ptr                     ptr_;
    [[no_unique_address]] Deleter del_;
    [[no_unique_address]] Alloc   alloc_;

public:
    CountedDeleter(Ptr p, Deleter d, Alloc a) noexcept
        : ptr_(p), del_(static_cast<Deleter &&>(d)),
          alloc_(static_cast<Alloc &&>(a))
    {
    }
    void  Dispose() noexcept override { del_(ptr_); }
    void *GetDeleter(const type_info &ti) noexcept override
    {
        return ti == typeid(Deleter) ? __builtin_addressof(del_) : nullptr;
    }
    void DestroyBlock() noexcept override
    {
        using A = typename allocator_traits<
            Alloc>::template rebind_alloc<CountedDeleter>;
        A a(alloc_);
        this->~CountedDeleter();
        allocator_traits<A>::deallocate(a, this, 1);
    }
};

// Tag selecting default-initialisation (`::new (pv) U`, indeterminate
// value) over value-initialisation. This is the entire point of the
// *_for_overwrite factories, so it has to reach the control block: a
// factory that quietly value-initialises has done the one thing the
// caller asked it not to do.
struct DefaultInitTag {};

// The element/object allocator [util.smartptr.shared.create]/7 calls a2:
// "a rebound copy of the allocator a ... such that its value_type is
// remove_cv_t<U>". Made once per factory call, not once per element.
template <class T, class Alloc>
using ObjAlloc = typename allocator_traits<Alloc>::template rebind_alloc<
    remove_cv_t<remove_extent_t<T>>>;

// ViaAlloc distinguishes allocate_shared from make_shared. It is not a
// micro-optimisation: [util.smartptr.shared.create]/7 spells out that
// make_shared initialises via `::new (pv) U(...)` while allocate_shared
// initialises via `allocator_traits<A2>::construct(a2, pv, ...)`, and /8
// mirrors the split for destruction. The difference is observable and
// load-bearing -- polymorphic_allocator::construct is what performs
// uses-allocator construction, so an allocate_shared that placement-news
// hands back a pmr container that silently kept the DEFAULT resource
// instead of the one it was allocated from.
//
// The *_for_overwrite factories stay on the placement-new side even when
// they take an allocator: /7's for_overwrite bullet names `::new (pv) U`
// explicitly, and an object built that way must be destroyed the
// symmetric way.
//
// The stored object is remove_cv_t<T>, never T: shared_ptr<const U> is
// ordinary (make_shared<const U>(...)), and storage that is itself const
// cannot be placement-new'd into at all.
template <class T, class Alloc, bool ViaAlloc>
class CountedInplace final : public CountedBase {
    using Obj = remove_cv_t<T>;
    using A2  = ObjAlloc<T, Alloc>;

    [[no_unique_address]] Alloc alloc_;
    union {
        Obj obj_;
    };

public:
    template <class... A>
    explicit CountedInplace(const Alloc &a, A &&...args) : alloc_(a)
    {
        if constexpr (ViaAlloc) {
            A2 a2(alloc_);
            allocator_traits<A2>::construct(a2, __builtin_addressof(obj_),
                                            static_cast<A &&>(args)...);
        } else {
            ::new (static_cast<void *>(__builtin_addressof(obj_)))
                Obj(static_cast<A &&>(args)...);
        }
    }
    // Tag last, so it is an ordinary trailing argument of the factory's
    // pack; a non-template constructor beats the variadic one above on an
    // exact match, which is what keeps the two apart.
    explicit CountedInplace(const Alloc &a, DefaultInitTag) : alloc_(a)
    {
        static_assert(!ViaAlloc,
                      "*_for_overwrite initialises via ::new (pv) U by "
                      "[util.smartptr.shared.create]/7, never through the "
                      "allocator");
        ::new (static_cast<void *>(__builtin_addressof(obj_))) Obj;
    }
    ~CountedInplace() {} // obj_ destroyed in Dispose; alloc_ trivially gone
    Obj *Get() noexcept { return __builtin_addressof(obj_); }
    void Dispose() noexcept override
    {
        if constexpr (ViaAlloc) {
            A2 a2(alloc_);
            allocator_traits<A2>::destroy(a2, __builtin_addressof(obj_));
        } else {
            __builtin_addressof(obj_)->~Obj();
        }
    }
    void DestroyBlock() noexcept override
    {
        using A = typename allocator_traits<
            Alloc>::template rebind_alloc<CountedInplace>;
        A a(alloc_);
        this->~CountedInplace();
        allocator_traits<A>::deallocate(a, this, 1);
    }
};

// Tag for the internal "adopt an already-+1'd control block" constructor
// (used by make_shared/allocate_shared). Lives here so those factories can
// name it; users cannot reach __shared.
struct AdoptTag {};

// Array control block for make_shared<T[]> / allocate_shared<T[]>: header +
// n elements in one allocation, aligned for the element type. Allocation
// goes through the allocator rebound to an over-aligned Chunk so both
// make_shared (allocator<Elem>) and allocate_shared (custom) get the right
// alignment.
template <class T, class Alloc, bool ViaAlloc>
class CountedArray final : public CountedBase {
public:
    using Elem = remove_cv_t<remove_extent_t<T>>;
    using A2   = ObjAlloc<T, Alloc>;
    static constexpr size_t kAlign =
        alignof(CountedArray) > alignof(Elem) ? alignof(CountedArray)
                                              : alignof(Elem);
    struct alignas(kAlign) Chunk {
        unsigned char b[kAlign];
    };

private:
    [[no_unique_address]] Alloc alloc_;
    size_t                      n_;

    static constexpr size_t HdrSize()
    {
        return (sizeof(CountedArray) + alignof(Elem) - 1) & ~(alignof(Elem) - 1);
    }

public:
    CountedArray(const Alloc &a, size_t n) noexcept : alloc_(a), n_(n) {}
    Elem *Get() noexcept
    {
        return reinterpret_cast<Elem *>(reinterpret_cast<char *>(this) +
                                        HdrSize());
    }
    static size_t Bytes(size_t n) { return HdrSize() + n * sizeof(Elem); }
    static size_t Chunks(size_t bytes)
    {
        return (bytes + sizeof(Chunk) - 1) / sizeof(Chunk);
    }
    // Reverse order of construction, and the same route the elements were
    // built by. Shared with MakeSharedArray's unwind path so a throw
    // halfway through element k destroys exactly the k that exist.
    void DestroyElems(size_t built) noexcept
    {
        Elem *e = Get();
        if constexpr (ViaAlloc) {
            A2 a2(alloc_);
            for (size_t i = built; i-- > 0;)
                allocator_traits<A2>::destroy(a2, e + i);
        } else {
            for (size_t i = built; i-- > 0;) e[i].~Elem();
        }
    }
    void Dispose() noexcept override { DestroyElems(n_); }
    void DestroyBlock() noexcept override
    {
        using CA =
            typename allocator_traits<Alloc>::template rebind_alloc<Chunk>;
        CA     ca(alloc_);
        size_t nch = Chunks(Bytes(n_));
        this->~CountedArray();
        allocator_traits<CA>::deallocate(ca, reinterpret_cast<Chunk *>(this),
                                         nch);
    }
};

template <class T, bool ViaAlloc, class Alloc, class Init>
shared_ptr<T> MakeSharedArray(const Alloc &alloc, size_t n, Init init)
{
    using Block = CountedArray<T, Alloc, ViaAlloc>;
    using Elem  = typename Block::Elem;
    using CA = typename allocator_traits<Alloc>::template rebind_alloc<
        typename Block::Chunk>;
    CA     ca(alloc);
    size_t nch = Block::Chunks(Block::Bytes(n));
    auto  *raw = allocator_traits<CA>::allocate(ca, nch);
    Block *b   = ::new (static_cast<void *>(raw)) Block(alloc, n);
    Elem  *e   = b->Get();
    size_t i   = 0;
    try {
        for (; i < n; ++i) init(e + i);
    } catch (...) {
        b->DestroyElems(i);
        b->~Block();
        allocator_traits<CA>::deallocate(ca, raw, nch);
        throw;
    }
    return shared_ptr<T>(AdoptTag{}, e, b);
}

template <class T>
inline constexpr bool IsUnboundedArray = false;
template <class T>
inline constexpr bool IsUnboundedArray<T[]> = true;

} // namespace __shared

template <class T>
class shared_ptr {
public:
    using element_type = remove_extent_t<T>;
    using weak_type    = weak_ptr<T>;

private:
    element_type          *ptr_  = nullptr;
    __shared::CountedBase *ctrl_ = nullptr;

    template <class>
    friend class shared_ptr;
    template <class>
    friend class weak_ptr;

public:
    constexpr shared_ptr() noexcept = default;
    constexpr shared_ptr(nullptr_t) noexcept {}

    // Internal: adopt an already-+1'd control block (make_shared path).
    constexpr shared_ptr(__shared::AdoptTag, element_type *p,
                         __shared::CountedBase *c) noexcept
        : ptr_(p), ctrl_(c)
    {
    }

    // Internal: if Y derives from enable_shared_from_this<U>, seed its
    // weak_this_ exactly once. The void* overload is the no-op fallback.
    template <class U, class Y>
    static void EnableShared(const enable_shared_from_this<U> *e, Y *p,
                             __shared::CountedBase *c) noexcept
    {
        if (e) {
            auto *base = const_cast<enable_shared_from_this<U> *>(e);
            if (base->weak_this_.expired())
                base->weak_this_.InternalAssign(
                    static_cast<U *>(const_cast<remove_cv_t<Y> *>(p)), c);
        }
    }
    static void EnableShared(const volatile void *, const volatile void *,
                             __shared::CountedBase *) noexcept
    {
    }

    template <class Y>
        requires(is_convertible_v<Y *, element_type *> ||
                 (is_array_v<T> &&
                  is_convertible_v<Y (*)[], remove_extent_t<T> (*)[]>))
    explicit shared_ptr(Y *p) : ptr_(p)
    {
        try {
            if constexpr (is_array_v<T>)
                // [util.smartptr.shared.const]: an array T is disposed with
                // delete[]. Route through default_delete<T> (= the delete[]
                // specialization default_delete<U[]>) rather than CountedPtr,
                // whose Dispose does a scalar `delete ptr_` -- wrong for arrays.
                ctrl_ = new __shared::CountedDeleter<Y *, default_delete<T>,
                                                     allocator<Y>>(
                    p, default_delete<T>{}, allocator<Y>{});
            else
                ctrl_ = new __shared::CountedPtr<Y *>(p);
        } catch (...) {
            // [util.smartptr.shared.const]: delete[] p for array T, else delete p.
            if constexpr (is_array_v<T>)
                delete[] p;
            else
                delete p;
            throw;
        }
        EnableShared(p, p, ctrl_);
    }

    template <class Y, class Deleter>
        requires(is_move_constructible_v<Deleter> &&
                 requires(Deleter d, Y *p) { d(p); })
    shared_ptr(Y *p, Deleter d) : ptr_(p)
    {
        using Block =
            __shared::CountedDeleter<Y *, Deleter, allocator<Y>>;
        try {
            ctrl_ = new Block(p, static_cast<Deleter &&>(d), allocator<Y>());
        } catch (...) {
            d(p); // [util.smartptr.shared.const]: d(p) on throw
            throw;
        }
        EnableShared(p, p, ctrl_);
    }
    template <class Y, class Deleter, class Alloc>
    shared_ptr(Y *p, Deleter d, Alloc a) : ptr_(p)
    {
        using Block = __shared::CountedDeleter<Y *, Deleter, Alloc>;
        using BA    = typename allocator_traits<
            Alloc>::template rebind_alloc<Block>;
        BA     ba(a);
        Block *b;
        try {
            // Only the allocation can throw; the Block ctor is
            // precondition-noexcept ([util.smartptr.shared.const]: deleter
            // move and allocator copy do not throw), so d is still intact.
            b = allocator_traits<BA>::allocate(ba, 1);
        } catch (...) {
            d(p); // [util.smartptr.shared.const]: d(p) on throw
            throw;
        }
        ::new (static_cast<void *>(b))
            Block(p, static_cast<Deleter &&>(d), a);
        ctrl_ = b;
        EnableShared(p, p, ctrl_);
    }
    template <class Deleter>
    shared_ptr(nullptr_t, Deleter d)
    {
        using Block =
            __shared::CountedDeleter<element_type *, Deleter, allocator<T>>;
        try {
            ctrl_ = new Block(nullptr, static_cast<Deleter &&>(d), allocator<T>());
        } catch (...) {
            d(static_cast<element_type *>(nullptr)); // [util.smartptr.shared.const]
            throw;
        }
    }
    template <class Deleter, class Alloc>
    shared_ptr(nullptr_t, Deleter d, Alloc a)
    {
        using Block = __shared::CountedDeleter<element_type *, Deleter, Alloc>;
        using BA    = typename allocator_traits<
            Alloc>::template rebind_alloc<Block>;
        BA     ba(a);
        Block *b;
        try {
            b = allocator_traits<BA>::allocate(ba, 1);
        } catch (...) {
            d(static_cast<element_type *>(nullptr));
            throw;
        }
        ::new (static_cast<void *>(b))
            Block(nullptr, static_cast<Deleter &&>(d), a);
        ctrl_ = b;
    }

    // aliasing
    template <class Y>
    shared_ptr(const shared_ptr<Y> &r, element_type *p) noexcept
        : ptr_(p), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->AddRef();
    }
    template <class Y>
    shared_ptr(shared_ptr<Y> &&r, element_type *p) noexcept
        : ptr_(p), ctrl_(r.ctrl_)
    {
        r.ptr_  = nullptr;
        r.ctrl_ = nullptr;
    }

    shared_ptr(const shared_ptr &r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->AddRef();
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    shared_ptr(const shared_ptr<Y> &r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->AddRef();
    }
    shared_ptr(shared_ptr &&r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        r.ptr_  = nullptr;
        r.ctrl_ = nullptr;
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    shared_ptr(shared_ptr<Y> &&r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        r.ptr_  = nullptr;
        r.ctrl_ = nullptr;
    }

    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    explicit shared_ptr(const weak_ptr<Y> &r) : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (!ctrl_ || !ctrl_->AddRefLock()) __throw_bad_weak_ptr();
    }

    template <class Y, class D>
        requires is_convertible_v<typename unique_ptr<Y, D>::pointer,
                                  element_type *>
    shared_ptr(unique_ptr<Y, D> &&u)
    {
        if (u.get()) {
            auto *p = u.get();
            if constexpr (is_reference_v<D>)
                ctrl_ = new __shared::CountedDeleter<
                    typename unique_ptr<Y, D>::pointer, D &, allocator<Y>>(
                    p, u.get_deleter(), allocator<Y>());
            else
                ctrl_ = new __shared::CountedDeleter<
                    typename unique_ptr<Y, D>::pointer, D, allocator<Y>>(
                    p, static_cast<D &&>(u.get_deleter()), allocator<Y>());
            ptr_ = p;
            EnableShared(p, p, ctrl_);
            u.release();
        }
    }

    ~shared_ptr()
    {
        if (ctrl_) ctrl_->Release();
    }

    shared_ptr &operator=(const shared_ptr &r) noexcept
    {
        shared_ptr(r).swap(*this);
        return *this;
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    shared_ptr &operator=(const shared_ptr<Y> &r) noexcept
    {
        shared_ptr(r).swap(*this);
        return *this;
    }
    shared_ptr &operator=(shared_ptr &&r) noexcept
    {
        shared_ptr(static_cast<shared_ptr &&>(r)).swap(*this);
        return *this;
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    shared_ptr &operator=(shared_ptr<Y> &&r) noexcept
    {
        shared_ptr(static_cast<shared_ptr<Y> &&>(r)).swap(*this);
        return *this;
    }
    template <class Y, class D>
    shared_ptr &operator=(unique_ptr<Y, D> &&u)
    {
        shared_ptr(static_cast<unique_ptr<Y, D> &&>(u)).swap(*this);
        return *this;
    }

    void reset() noexcept { shared_ptr().swap(*this); }
    template <class Y>
    void reset(Y *p)
    {
        shared_ptr(p).swap(*this);
    }
    template <class Y, class Deleter>
    void reset(Y *p, Deleter d)
    {
        shared_ptr(p, static_cast<Deleter &&>(d)).swap(*this);
    }
    template <class Y, class Deleter, class Alloc>
    void reset(Y *p, Deleter d, Alloc a)
    {
        shared_ptr(p, static_cast<Deleter &&>(d), a).swap(*this);
    }
    void swap(shared_ptr &o) noexcept
    {
        element_type *tp = ptr_;
        ptr_             = o.ptr_;
        o.ptr_           = tp;
        __shared::CountedBase *tc = ctrl_;
        ctrl_                     = o.ctrl_;
        o.ctrl_                   = tc;
    }

    element_type *get() const noexcept { return ptr_; }
    T            &operator*() const noexcept
        requires(!is_array_v<T> && !is_void_v<T>)
    {
        return *ptr_;
    }
    element_type *operator->() const noexcept
        requires(!is_array_v<T>)
    {
        return ptr_;
    }
    element_type &operator[](ptrdiff_t i) const
        requires is_array_v<T>
    {
        return ptr_[i];
    }
    long use_count() const noexcept { return ctrl_ ? ctrl_->UseCount() : 0; }
    explicit operator bool() const noexcept { return ptr_ != nullptr; }

    template <class U>
    bool owner_before(const shared_ptr<U> &o) const noexcept
    {
        return ctrl_ < o.ctrl_;
    }
    template <class U>
    bool owner_before(const weak_ptr<U> &o) const noexcept
    {
        return ctrl_ < o.ctrl_;
    }

    template <class D, class U>
    friend D *get_deleter(const shared_ptr<U> &) noexcept;
};

template <class T>
shared_ptr(weak_ptr<T>) -> shared_ptr<T>;
template <class T, class D>
shared_ptr(unique_ptr<T, D>) -> shared_ptr<T>;

template <class T>
class weak_ptr {
public:
    using element_type = remove_extent_t<T>;

private:
    element_type          *ptr_  = nullptr;
    __shared::CountedBase *ctrl_ = nullptr;

    template <class>
    friend class weak_ptr;
    template <class>
    friend class shared_ptr;
    template <class>
    friend class enable_shared_from_this;

    void InternalAssign(element_type *p, __shared::CountedBase *c) noexcept
    {
        if (c) c->WeakAddRef();
        if (ctrl_) ctrl_->WeakRelease();
        ptr_  = p;
        ctrl_ = c;
    }

public:
    constexpr weak_ptr() noexcept = default;

    weak_ptr(const weak_ptr &r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->WeakAddRef();
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    weak_ptr(const weak_ptr<Y> &r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->WeakAddRef();
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    weak_ptr(const shared_ptr<Y> &r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        if (ctrl_) ctrl_->WeakAddRef();
    }
    weak_ptr(weak_ptr &&r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        r.ptr_  = nullptr;
        r.ctrl_ = nullptr;
    }
    template <class Y>
        requires is_convertible_v<Y *, element_type *>
    weak_ptr(weak_ptr<Y> &&r) noexcept : ptr_(r.ptr_), ctrl_(r.ctrl_)
    {
        r.ptr_  = nullptr;
        r.ctrl_ = nullptr;
    }

    ~weak_ptr()
    {
        if (ctrl_) ctrl_->WeakRelease();
    }

    weak_ptr &operator=(const weak_ptr &r) noexcept
    {
        weak_ptr(r).swap(*this);
        return *this;
    }
    template <class Y>
    weak_ptr &operator=(const weak_ptr<Y> &r) noexcept
    {
        weak_ptr(r).swap(*this);
        return *this;
    }
    template <class Y>
    weak_ptr &operator=(const shared_ptr<Y> &r) noexcept
    {
        weak_ptr(r).swap(*this);
        return *this;
    }
    weak_ptr &operator=(weak_ptr &&r) noexcept
    {
        weak_ptr(static_cast<weak_ptr &&>(r)).swap(*this);
        return *this;
    }
    template <class Y>
    weak_ptr &operator=(weak_ptr<Y> &&r) noexcept
    {
        weak_ptr(static_cast<weak_ptr<Y> &&>(r)).swap(*this);
        return *this;
    }

    long use_count() const noexcept { return ctrl_ ? ctrl_->UseCount() : 0; }
    bool expired() const noexcept { return use_count() == 0; }
    void reset() noexcept { weak_ptr().swap(*this); }
    void swap(weak_ptr &o) noexcept
    {
        element_type *tp = ptr_;
        ptr_             = o.ptr_;
        o.ptr_           = tp;
        __shared::CountedBase *tc = ctrl_;
        ctrl_                     = o.ctrl_;
        o.ctrl_                   = tc;
    }
    shared_ptr<T> lock() const noexcept
    {
        shared_ptr<T> r;
        if (ctrl_ && ctrl_->AddRefLock()) {
            r.ptr_  = ptr_;
            r.ctrl_ = ctrl_;
        }
        return r;
    }
    template <class U>
    bool owner_before(const weak_ptr<U> &o) const noexcept
    {
        return ctrl_ < o.ctrl_;
    }
    template <class U>
    bool owner_before(const shared_ptr<U> &o) const noexcept
    {
        return ctrl_ < o.ctrl_;
    }
};

