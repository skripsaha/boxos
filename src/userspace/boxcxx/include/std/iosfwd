// boxcxx — <iosfwd>
// Forward declarations for the whole iostream class-template family, plus
// the leaf types they are built from (streamoff/streamsize/fpos/mbstate_t).
// A genuine leaf: only <cstddef> is included, and nothing declared here can
// pull anything back in — every other iostream header, and <__bits/
// char_traits>, sits safely underneath this one.
//
// mbstate_t belongs to <cwchar>/<cuchar> in the real standard, and as of Ф41-e
// <cuchar> exists — so the eight-byte opaque placeholder that used to be
// defined here moved out, exactly as the note that stood in its place said it
// would. It could not move INTO <cuchar>: this header must keep pulling
// nothing in. It lives in <__bits/c_mbstate>, which both include, and it
// stopped being opaque on the way, because the restartable conversions need
// real fields. Nothing here cares what is inside it — char_traits::state_type
// and fpos<mbstate_t> need the name and the properties C requires of it
// (distinct, trivially copyable, default-constructible, all-bits-zero being
// the initial state).
//
// Every class template below is generic in CharT/Traits (and, for the
// sstream family, Allocator) so a future wchar_t instantiation is not
// structurally blocked — but only the char-based typedefs are shipped;
// wide streams are a documented, out-of-scope exclusion.
#ifndef BOXCXX_IOSFWD
#define BOXCXX_IOSFWD

#include <cstddef>
#include <__bits/c_mbstate>

// [version.syn] names THIS header an owner of __cpp_lib_syncbuf alongside
// <syncstream> — basic_syncbuf/basic_osyncstream and their typedefs are
// declared below, which is this header's whole share of the feature, and a
// program that asks the question here must get the answer here. The leaf
// included next includes nothing itself, so <iosfwd> stays a leaf too.
#define BOXCXX_OWNS_syncbuf
#include <__bits/version_iostreams>

namespace std {

template <class CharT> struct char_traits;
template <class T> class allocator;

using streamoff  = long long;
using streamsize = ptrdiff_t;

template <class StateT>
class fpos {
public:
    constexpr fpos() noexcept : __off(0), __state{} {}
    constexpr fpos(streamoff off) noexcept : __off(off), __state{} {}

    constexpr StateT state() const noexcept { return __state; }
    constexpr void state(StateT s) noexcept { __state = s; }

    constexpr fpos &operator+=(streamoff off) noexcept
    {
        __off += off;
        return *this;
    }
    constexpr fpos &operator-=(streamoff off) noexcept
    {
        __off -= off;
        return *this;
    }
    constexpr fpos operator+(streamoff off) const noexcept
    {
        fpos p(*this);
        p += off;
        return p;
    }
    constexpr fpos operator-(streamoff off) const noexcept
    {
        fpos p(*this);
        p -= off;
        return p;
    }
    constexpr streamoff operator-(const fpos &rhs) const noexcept { return __off - rhs.__off; }

    // Implicit per [fpos]/synopsis (NOT explicit) — a real fpos converts to
    // streamoff on demand (e.g. passed where an offset is expected).
    constexpr operator streamoff() const noexcept { return __off; }

    // state_ deliberately excluded from equality per [fpos]: two positions
    // compare equal purely on their stream offset.
    friend constexpr bool operator==(const fpos &a, const fpos &b) noexcept
    {
        return a.__off == b.__off;
    }

private:
    streamoff __off;
    StateT __state;
};

template <class CharT, class Traits = char_traits<CharT>>
class basic_ios;
template <class CharT, class Traits = char_traits<CharT>>
class basic_streambuf;
template <class CharT, class Traits = char_traits<CharT>>
class basic_istream;
template <class CharT, class Traits = char_traits<CharT>>
class basic_ostream;
template <class CharT, class Traits = char_traits<CharT>>
class basic_iostream;
template <class CharT, class Traits = char_traits<CharT>, class Allocator = allocator<CharT>>
class basic_stringbuf;
template <class CharT, class Traits = char_traits<CharT>, class Allocator = allocator<CharT>>
class basic_istringstream;
template <class CharT, class Traits = char_traits<CharT>, class Allocator = allocator<CharT>>
class basic_ostringstream;
template <class CharT, class Traits = char_traits<CharT>, class Allocator = allocator<CharT>>
class basic_stringstream;
template <class CharT, class Traits = char_traits<CharT>, class Allocator = allocator<CharT>>
class basic_syncbuf;
template <class CharT, class Traits = char_traits<CharT>, class Allocator = allocator<CharT>>
class basic_osyncstream;
template <class CharT, class Traits = char_traits<CharT>>
class basic_filebuf;
template <class CharT, class Traits = char_traits<CharT>>
class basic_ifstream;
template <class CharT, class Traits = char_traits<CharT>>
class basic_ofstream;
template <class CharT, class Traits = char_traits<CharT>>
class basic_fstream;

class ios_base;
class locale; // full definition in <locale>

using ios           = basic_ios<char>;
using streambuf     = basic_streambuf<char>;
using istream       = basic_istream<char>;
using ostream       = basic_ostream<char>;
using iostream      = basic_iostream<char>;
using stringbuf     = basic_stringbuf<char>;
using syncbuf       = basic_syncbuf<char>;
using osyncstream   = basic_osyncstream<char>;
using istringstream = basic_istringstream<char>;
using ostringstream = basic_ostringstream<char>;
using stringstream  = basic_stringstream<char>;
using filebuf       = basic_filebuf<char>;
using ifstream      = basic_ifstream<char>;
using ofstream      = basic_ofstream<char>;
using fstream       = basic_fstream<char>;

// The wide half, as of Ф42-f. This block used to be a sentence saying these
// were "a documented, out-of-scope exclusion", which stopped being true one
// piece at a time: Ф42-d made the numeric engine generic, Ф42-e built the
// codecvt a wide filebuf stands on, and this is where the names arrive.
using wios           = basic_ios<wchar_t>;
using wstreambuf     = basic_streambuf<wchar_t>;
using wistream       = basic_istream<wchar_t>;
using wostream       = basic_ostream<wchar_t>;
using wiostream      = basic_iostream<wchar_t>;
using wstringbuf     = basic_stringbuf<wchar_t>;
using wsyncbuf       = basic_syncbuf<wchar_t>;
using wosyncstream   = basic_osyncstream<wchar_t>;
using wistringstream = basic_istringstream<wchar_t>;
using wostringstream = basic_ostringstream<wchar_t>;
using wstringstream  = basic_stringstream<wchar_t>;
using wfilebuf       = basic_filebuf<wchar_t>;
using wifstream      = basic_ifstream<wchar_t>;
using wofstream      = basic_ofstream<wchar_t>;
using wfstream       = basic_fstream<wchar_t>;

// ‼ The five position aliases of [iosfwd.syn], which were in NEITHER column
// until Ф42-f: not in the tree, and not recorded as absent either — the same
// shape of gap §1.1 found for <ctime>, and found the same way, by reading the
// synopsis against the file rather than against the list.
//
// All five name the SAME type, and that is not a shortcut. Each is defined as
// fpos<char_traits<X>::state_type>, and every char_traits here reports
// state_type = mbstate_t, because a conversion state does not depend on which
// character type it is producing. They are spelled as fpos<mbstate_t> rather
// than through char_traits because <iosfwd> only forward-declares that
// template — naming a member would make this header pull in what it exists
// not to pull in.
using streampos    = fpos<mbstate_t>;
using wstreampos   = fpos<mbstate_t>;
using u8streampos  = fpos<mbstate_t>;
using u16streampos = fpos<mbstate_t>;
using u32streampos = fpos<mbstate_t>;

} // namespace std

#endif // BOXCXX_IOSFWD
