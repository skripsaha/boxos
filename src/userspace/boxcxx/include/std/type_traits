template <class T, class U>
struct is_nothrow_swappable_with
    : bool_constant<is_swappable_with<T, U>::value &&
                    __bits::SwappableWithImpl<T, U>::kNothrow> {};
template <class T, class U>
inline constexpr bool is_nothrow_swappable_with_v =
    is_nothrow_swappable_with<T, U>::value;

template <class T>
struct is_nothrow_swappable
    : bool_constant<is_swappable<T>::value &&
                    __bits::SwappableWithImpl<
                        typename __bits::SwappableRef<T>::LRef,
                        typename __bits::SwappableRef<T>::LRef>::kNothrow> {};
template <class T>
inline constexpr bool is_nothrow_swappable_v = is_nothrow_swappable<T>::value;

