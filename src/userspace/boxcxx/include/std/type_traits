namespace __bits {
// remove_all_extents is defined later in this header; local pre-version
// breaks the ordering dependency.
template <class T> struct RemoveAllExtentsPre { using type = T; };
template <class T> struct RemoveAllExtentsPre<T[]>
{ using type = typename RemoveAllExtentsPre<T>::type; };
template <class T, size_t N> struct RemoveAllExtentsPre<T[N]>
{ using type = typename RemoveAllExtentsPre<T>::type; };
template <class T>
using RemoveAllExtentsPreT = typename RemoveAllExtentsPre<T>::type;

template <class T, class = void> struct IsDestructibleImpl : false_type {};
template <class T>
struct IsDestructibleImpl<T, void_t<decltype(declval<T &>().~T())>>
    : true_type {};

template <class T,
          bool = is_void<T>::value || is_unbounded_array<T>::value ||
                 is_function<T>::value,
          bool = is_reference<T>::value || is_scalar<T>::value>
struct IsDestructibleSafe;
template <class T>
struct IsDestructibleSafe<T, false, false>
    : IsDestructibleImpl<RemoveAllExtentsPreT<T>> {};
template <class T> struct IsDestructibleSafe<T, true, false> : false_type {};
template <class T> struct IsDestructibleSafe<T, false, true> : true_type {};
} // namespace __bits

template <class T>
struct is_destructible : __bits::IsDestructibleSafe<T> {};
template <class T>
inline constexpr bool is_destructible_v = is_destructible<T>::value;

namespace __bits {
template <class T, bool = is_reference<T>::value || is_scalar<T>::value,
          bool = is_destructible<T>::value>
struct IsNothrowDestructible : false_type {};
template <class T> struct IsNothrowDestructible<T, true, true> : true_type {};
template <class T>
struct IsNothrowDestructible<T, false, true>
    : bool_constant<noexcept(
          declval<RemoveAllExtentsPreT<T> &>().~RemoveAllExtentsPreT<T>())> {};
} // namespace __bits

