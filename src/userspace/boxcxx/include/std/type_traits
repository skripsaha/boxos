// ════════════════════════════════════════════════════════════════════════
// INVOKE machinery: invoke_result / is_invocable (+nothrow)
// ════════════════════════════════════════════════════════════════════════

template <class T> class reference_wrapper;   // <functional>

namespace __bits {
// [func.require] INVOKE, expressed as a priority-ordered overload set of
// DECLARATIONS with trailing decltype — every ill-formed bullet is a soft
// substitution failure, never a hard error. The runtime std::invoke (in
// <functional>) mirrors the same bullets with bodies.
template <int N> struct InvokePrio : InvokePrio<N - 1> {};
template <> struct InvokePrio<0> {};

// 1.1 — pmf, object (or derived) reference
template <class F, class O, class... A>
auto InvokeSel(InvokePrio<5>, F &&f, O &&o, A &&...a)
    noexcept(noexcept((static_cast<O &&>(o).*f)(static_cast<A &&>(a)...)))
        -> decltype((static_cast<O &&>(o).*f)(static_cast<A &&>(a)...));

// 1.2 — pmf, reference_wrapper
template <class F, class O, class... A>
auto InvokeSel(InvokePrio<4>, F &&f, O &&o, A &&...a)
    noexcept(noexcept((o.get().*f)(static_cast<A &&>(a)...)))
        -> decltype((o.get().*f)(static_cast<A &&>(a)...));

// 1.3 — pmf, pointer-like (dereference)
template <class F, class O, class... A>
auto InvokeSel(InvokePrio<3>, F &&f, O &&o, A &&...a)
    noexcept(noexcept(((*static_cast<O &&>(o)).*f)(static_cast<A &&>(a)...)))
        -> decltype(((*static_cast<O &&>(o)).*f)(static_cast<A &&>(a)...));

// 1.4 — pmd, object (or derived) reference
template <class F, class O>
auto InvokeSel(InvokePrio<2>, F &&f, O &&o)
    noexcept(noexcept(static_cast<O &&>(o).*f))
        -> decltype(static_cast<O &&>(o).*f);

// 1.5 — pmd, reference_wrapper
template <class F, class O>
auto InvokeSel(InvokePrio<1>, F &&f, O &&o)
    noexcept(noexcept(o.get().*f)) -> decltype(o.get().*f);

// 1.6 — pmd, pointer-like / 1.7 — plain callable
template <class F, class O>
auto InvokeSel(InvokePrio<0>, F &&f, O &&o)
    noexcept(noexcept((*static_cast<O &&>(o)).*f))
        -> decltype((*static_cast<O &&>(o)).*f);

template <class F, class... A>
auto InvokeSel(InvokePrio<0>, F &&f, A &&...a)
    noexcept(noexcept(static_cast<F &&>(f)(static_cast<A &&>(a)...)))
        -> decltype(static_cast<F &&>(f)(static_cast<A &&>(a)...));

template <class AlwaysVoid, class F, class... Args>
struct InvokeTraits {
    static constexpr bool kInvocable = false;
    static constexpr bool kNothrow   = false;
};
template <class F, class... Args>
struct InvokeTraits<
    void_t<decltype(InvokeSel(InvokePrio<5>{}, declval<F>(),
                              declval<Args>()...))>,
    F, Args...> {
    using Result = decltype(InvokeSel(InvokePrio<5>{}, declval<F>(),
                                      declval<Args>()...));
    static constexpr bool kInvocable = true;
    static constexpr bool kNothrow   = noexcept(
        InvokeSel(InvokePrio<5>{}, declval<F>(), declval<Args>()...));
};

template <class AlwaysVoid, class F, class... Args>
struct InvokeResultImpl {};
template <class F, class... Args>
struct InvokeResultImpl<
    void_t<typename InvokeTraits<void, F, Args...>::Result>, F, Args...>
{ using type = typename InvokeTraits<void, F, Args...>::Result; };

// Conversion leg of is_invocable_r, with the C++23 cv-void special case.
template <class Ret, class F, class... Args>
struct IsInvocableR {
    template <class R, bool = InvokeTraits<void, F, Args...>::kInvocable,
              class = void>
    struct Conv : false_type {};
    template <class R>
    struct Conv<R, true, enable_if_t<is_void<R>::value>> : true_type {};
    template <class R>
    struct Conv<R, true,
                enable_if_t<!is_void<R>::value &&
                            is_convertible<typename InvokeTraits<
                                               void, F, Args...>::Result,
                                           R>::value>> : true_type {};
    static constexpr bool value = Conv<Ret>::value;
};

// Conversion leg of is_nothrow_invocable_r ([meta.rel]): unlike is_invocable_r,
// nothrow-ness ALSO depends on the INVOKE<R> result->R conversion itself being
// non-throwing, not just the call. Same Conv-on-kInvocable guard as
// IsInvocableR above, so Result is never touched when F isn't invocable at all.
template <class Ret, class F, class... Args>
struct IsNothrowInvocableR {
    template <class R, bool = InvokeTraits<void, F, Args...>::kInvocable,
              class = void>
    struct Conv : false_type {};
    template <class R>
    struct Conv<R, true, enable_if_t<is_void<R>::value>>
        : bool_constant<InvokeTraits<void, F, Args...>::kNothrow> {};
    template <class R>
    struct Conv<R, true,
                enable_if_t<!is_void<R>::value &&
                            is_convertible<typename InvokeTraits<
                                               void, F, Args...>::Result,
                                           R>::value>>
        : bool_constant<InvokeTraits<void, F, Args...>::kNothrow &&
                        is_nothrow_convertible<
                            typename InvokeTraits<void, F, Args...>::Result,
                            R>::value> {};
    static constexpr bool value = Conv<Ret>::value;
};
} // namespace __bits

