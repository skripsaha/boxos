                         void_t<decltype(swap(declval<T>(), declval<U>())),
                                decltype(swap(declval<U>(), declval<T>()))>>
    : true_type {
    static constexpr bool kNothrow =
        noexcept(swap(declval<T>(), declval<U>())) &&
        noexcept(swap(declval<U>(), declval<T>()));
};
