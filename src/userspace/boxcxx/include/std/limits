struct numeric_limits<short> : __bits::IntegerLimits<short> {};
template <>
struct numeric_limits<unsigned short> : __bits::IntegerLimits<unsigned short> {};
template <>
struct numeric_limits<int> : __bits::IntegerLimits<int> {};
template <>
struct numeric_limits<unsigned int> : __bits::IntegerLimits<unsigned int> {};
template <>
struct numeric_limits<long> : __bits::IntegerLimits<long> {};
template <>
struct numeric_limits<unsigned long> : __bits::IntegerLimits<unsigned long> {};
template <>
struct numeric_limits<long long> : __bits::IntegerLimits<long long> {};
