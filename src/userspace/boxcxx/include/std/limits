struct numeric_limits<char> : __bits::IntegerLimits<char> {};
template <>
struct numeric_limits<signed char> : __bits::IntegerLimits<signed char> {};
template <>
struct numeric_limits<unsigned char> : __bits::IntegerLimits<unsigned char> {};
template <>
struct numeric_limits<wchar_t> : __bits::IntegerLimits<wchar_t> {};
