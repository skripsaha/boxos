// boxcxx — <memory_resource>  (C++23 std::pmr)
//
// memory_resource + polymorphic_allocator (with full uses-allocator
// construction, incl. the pair piecewise rule so nested pmr containers
// propagate their resource), the new_delete/null/default resources, the
// monotonic buffer resource, and the (un)synchronized pool resources.
// Global singletons + the default-resource pointer live in
// src/runtime/memory_resource.cpp (constinit, like <system_error>).
#ifndef BOXCXX_MEMORY_RESOURCE
#define BOXCXX_MEMORY_RESOURCE

