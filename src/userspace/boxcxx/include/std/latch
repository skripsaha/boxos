// boxcxx — <latch>
//
// std::latch — a single-use down-counter. Participants count_down() and
// wait() until it reaches zero; it never resets. wait() goes through
// __boxcxx_atomic_wait_cycle — the same substrate as atomic::wait: a bounded
// spin (WAITPKG UMONITOR/UMWAIT on the counter word, else a PAUSE budget)
// and then a real kernel park.
//
// Two wakes, and only one of them is implicit. During the spin the count_down
// store suffices: it lands on the monitored cacheline and the waiter re-checks
// its predicate. A parked waiter is sleeping in the kernel and cannot see any
// store, so the arrival that drives the count to zero must notify explicitly —
// that is the __boxcxx_atomic_notify in count_down, not decoration.
#ifndef BOXCXX_LATCH
#define BOXCXX_LATCH

#include <atomic>
#include <cstddef>
#include <cstdint>

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_latch
#include <__bits/version_sync>

namespace std {

class latch {
public:
    static constexpr ptrdiff_t max() noexcept { return PTRDIFF_MAX; }

    // Non-noexcept to match the synopsis: the narrow contract (0 <= expected
    // <= max()) is left potentially-throwing by [thread.latch], so a hardened
    // build may diagnose a violation.
    constexpr explicit latch(ptrdiff_t expected) : __counter(expected) {}
    ~latch()                        = default;
    latch(const latch &)            = delete;
    latch &operator=(const latch &) = delete;

    // Preconditions ([thread.latch]): n >= 0 and n <= the current count.
    // Only the arrival that reaches zero notifies: that is the single edge
    // any waiter's predicate cares about, so intermediate decrements owe the
    // kernel nothing.
    void count_down(ptrdiff_t n = 1)
    {
        if (__counter.fetch_sub(n, memory_order_release) - n == 0)
            __boxcxx_atomic_notify(&__counter, true);
    }

    [[nodiscard]] bool try_wait() const noexcept
    {
        return __counter.load(memory_order_acquire) == 0;
    }

    void wait() const
    {
        unsigned spin = 0;
        ptrdiff_t cur;
        while ((cur = __counter.load(memory_order_acquire)) != 0)
            __boxcxx_atomic_wait_cycle(&__counter, &cur, sizeof(cur), ~0ull,
                                       &spin);
    }

    void arrive_and_wait(ptrdiff_t n = 1)
    {
        count_down(n);
        wait();
    }

private:
    atomic<ptrdiff_t> __counter;
};

} // namespace std

#endif // BOXCXX_LATCH
