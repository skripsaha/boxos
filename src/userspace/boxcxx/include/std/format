// boxcxx — <format>  (Ф9B-1: the C++23 formatting library core;
//                     Ф42-g: both character types)
//
// std::format / format_to / format_to_n / formatted_size / vformat[_to],
// the std-spec parser ([[fill]align][sign][#][0][width][.precision][L][type]
// with nested {} dynamic width/precision), formatter<T> for the scalar and
// string types, the type-erased argument machinery (basic_format_arg / args /
// context), and the C++23 consteval format-string check (basic_format_string).
//
// Numbers are formatted through <charconv> to_chars — that is exactly why
// <charconv> (Ф9A) landed first. There is no dependency on the kernel: the
// console sink (std::print) and <iostream> arrive in Ф9B-2 / Ф9B-3.
//
// ── one engine, two character types ─────────────────────────────────────
// Ф42-g made this header answer for wchar_t as well, and it did so the way
// the three wide layers before it did (the wide printf of Ф42-c, the stream
// numeric engine of Ф42-d, <chrono>'s renderer): THE TEXT IS PRODUCED IN
// ASCII BY THE ONE ENGINE THAT ALREADY EXISTED. to_chars writes digits,
// Digits128 writes digits, "true"/"false"/"0x" are literals — all of it is
// ASCII, and ASCII is its own code point. CharT enters at exactly three
// boundaries:
//
//   in    the format string. The whole std-format-spec grammar is ASCII, so
//         the parser is generic by construction; the only genuinely CharT
//         position in it is the FILL character, which may be anything.
//   out   the sink. Every ASCII run is widened once, on the way out, in
//         WriteRun — see the note there for why the cast is spelt through
//         unsigned char rather than written plainly.
//   args  the arguments that really are characters or strings. Those the
//         standard hands to a formatter<charT-something, charT>; everything
//         else is a number, and numbers do not have a character type.
//
// What follows from that is the shape of the file: FormatIntCore,
// FormatFloatCore, FormatPointer and Digits128 still speak char and always
// will, EmitField is the seam where a char body and a CharT body meet, and
// there is no second parser, no second float formatter and no second table.
//
// Deliberate scope:
//   * char and wchar_t. char8_t/char16_t/char32_t are not formatting
//     character types in C++23 — [format.formatter.spec] names charT as
//     char or wchar_t and nothing else.
//   * the `L` (localized) flag WORKS as of Ф43-e: it consults the numpunct of
//     the locale the context carries — the one passed to a locale-taking
//     overload, or std::locale() otherwise — for the group separators, the
//     radix character and the two words a bool is spelt with. The string and
//     pointer formatters have no `L` position at all and reject it, as both
//     reference libraries do.
//   * field width is the ESTIMATED WIDTH of [format.string.std]/13 as of
//     Ф43-e-2: extended grapheme clusters by UAX #29, of which the eighteen
//     ranges the standard writes out count two columns. The rules are in
//     <__bits/format_width>, the UCD facts they read in
//     <__bits/unicode_grapheme>. Precision measures the same way, on the
//     escaped ('?') text too, so a truncation lands between clusters and
//     never inside a UTF-8 sequence.
#ifndef BOXCXX_FORMAT
#define BOXCXX_FORMAT

#include <__bits/core_traits>     // __bits::IsAnyOf
#include <__bits/unicode_escape>  // Utf8Decode + the escape category tables
#include <__bits/format_escape>   // EscapeInto / EscapeChar
#include <__bits/format_width>    // EstimateWidth / PrefixForWidth ([format.string.std]/13)
#include <__bits/ranges_core>     // ranges::input_range &c., for [format.range]
#include <charconv>
#include <cstddef>
#include <cstdint>
#include <iterator>  // output_iterator_tag
#include <limits>
#include <locale>    // basic_format_context::locale() ([format.context])
#include <stdexcept>  // runtime_error (base of format_error)
#include <string>
#include <string_view>
#include <concepts>  // same_as / semiregular, for std::formattable
#include <tuple>     // pair/tuple_size_v, for [format.range]'s FmtPairLike
#include <type_traits>
#include <utility>

namespace std {

// ── format_error ([format.error]) ───────────────────────────────────────
// Key function (the destructor) is out-of-line in src/runtime/format.cpp so
// the vtable and typeinfo are emitted exactly once — catch-by-base across
// translation units relies on a single typeinfo, same scheme as the other
// boxcxx exception types.
class format_error : public runtime_error {
public:
    explicit format_error(const string &what_arg) : runtime_error(what_arg) {}
    explicit format_error(const char *what_arg) : runtime_error(what_arg) {}
    ~format_error() override;
};

// Forward declarations needed to break the arg/args/context cycle.
template <class T, class CharT = char> struct formatter;
template <class Context> class basic_format_arg;
template <class Context> class basic_format_args;
template <class Out, class CharT> class basic_format_context;

namespace __format {
template <class CharT> class SinkIterator;

// The two character types [format.formatter.spec] names, and the guard that
// keeps every formatter below from matching a third. Without it a
// formatter<int, char8_t> would be *enabled* — semiregular, with a parse()
// and a format() that compile — and std::formattable would answer true for a
// character type this library has no output path for.
template <class CharT>
concept FmtCharT = is_same_v<CharT, char> || is_same_v<CharT, wchar_t>;
} // namespace __format

using format_context =
    basic_format_context<__format::SinkIterator<char>, char>;
using wformat_context =
    basic_format_context<__format::SinkIterator<wchar_t>, wchar_t>;
using format_args  = basic_format_args<format_context>;
using wformat_args = basic_format_args<wformat_context>;

// ════════════════════════════════════════════════════════════════════════
//  Internal: spec model + low-level helpers (namespace __format)
// ════════════════════════════════════════════════════════════════════════
namespace __format {

enum class ArgKind : unsigned char {
    None,
    Bool,
    Char,
    Int,
    UInt,
    LongLong,
    ULongLong,
    Int128,
    UInt128,
    Float,
    Double,
    LongDouble,
    CString,
    SVString,
    Pointer,
    Custom,
};

enum class Align : unsigned char { Default, Left, Right, Center };
enum class Sign : unsigned char { Minus, Plus, Space };

// Empty tag visited for a valueless argument (std::visit_format_arg). Kept
// local so <format> need not pull in <variant>'s std::monostate.
struct monostate_tag {};

// Parsed standard format specification.
//
// Two fields carry a character and only one of them is CharT. `fill` is
// whatever the format string put there and is copied to the output as-is, so
// it is the argument's own character type. `type` is a presentation letter
// out of a closed ASCII set, so it is narrowed at parse time and every
// formatter below can go on comparing it against 'd'/'s'/'?' without knowing
// which character type it came from. What a non-ASCII character in the type
// position narrows TO is the interesting half — see ParseSpec.
template <class CharT> struct StdSpec {
    CharT  fill          = CharT(' ');
    Align  align         = Align::Default;
    Sign   sign          = Sign::Minus;
    // Whether a sign character was actually written. `sign` alone cannot
    // answer that: an explicit '-' and "no sign at all" both mean
    // Sign::Minus, so the formatters that must reject any sign ([format.
    // string.std]/6 — sign is only valid for the arithmetic presentations)
    // need this flag, not a comparison against Sign::Minus.
    bool   sign_given    = false;
    bool   alt           = false;  // '#'
    bool   zero          = false;  // '0'
    int    width         = -1;     // -1 == absent
    size_t width_id      = 0;
    bool   width_dynamic = false;
    int    precision     = -1;     // -1 == absent
    size_t prec_id       = 0;
    bool   prec_dynamic  = false;
    bool   localized     = false;  // 'L' — consults numpunct
    char   type          = '\0';   // '\0' == default
};

// The grammar predicates. They read a format-string character, so they are
// generic; ToUpperAscii is not, because it reads a digit this file just
// produced and those are char in both worlds.
template <class CharT> constexpr bool IsAlignChar(CharT c) noexcept
{
    return c == CharT('<') || c == CharT('>') || c == CharT('^');
}
template <class CharT> constexpr Align AlignOf(CharT c) noexcept
{
    return c == CharT('<')   ? Align::Left
           : c == CharT('>') ? Align::Right
                             : Align::Center;
}
template <class CharT> constexpr bool IsDigit(CharT c) noexcept
{
    return c >= CharT('0') && c <= CharT('9');
}
constexpr char ToUpperAscii(char c) noexcept
{
    return (c >= 'a' && c <= 'z') ? char(c - 'a' + 'A') : c;
}

// Narrow a format-string character to ASCII. Everything outside ASCII maps to
// DEL, which is in no grammar position this parser recognises: it is not a
// presentation type, not a digit, not an alignment character. That is the
// same device Ф42-d used on the stream extractors — send what cannot be
// spelled in ASCII to a value the grammar already rejects, so no classifier
// downstream needs a case for "wide". Written on the unsigned value because
// wchar_t is signed here and a negative unit must not slip through as ASCII.
template <class CharT> constexpr char NarrowAscii(CharT c) noexcept
{
    return static_cast<make_unsigned_t<CharT>>(c) < 0x80u ? char(c) : '\x7F';
}

inline constexpr int kIntMax = 2147483647;

// Parse a base-10 unsigned number at *p (which must start on a digit),
// advancing p past it. Overflow past INT_MAX throws.
template <class CharT>
constexpr size_t ParseNumber(const CharT *&p, const CharT *e)
{
    size_t v = 0;
    while (p != e && IsDigit(*p)) {
        v = v * 10 + size_t(*p - CharT('0'));
        if (v > size_t(kIntMax)) throw format_error("format: number too large");
        ++p;
    }
    return v;
}

// ── there is no invented ceiling on a field ────────────────────────────
// Ф9B-1 through Ф43-e-1 capped width and precision at 65535 on both the
// literal and the dynamic path, so that a hostile format string could not ask
// for gigabytes. Ф43-e-2 removes it, by decision: the number was this
// library's own, no document mentions it, and a program that legitimately lays
// out a hundred-thousand-column report was told "width exceeds the field
// limit" — a wrong answer given confidently. What bounds a field now is the
// memory the machine has: the sink grows until the allocator refuses and
// throws bad_alloc, the same answer every other oversized request gets. The
// grammar still stops at INT_MAX, in ParseNumber, because a width is an int.
//
// Measured on the references before removing it: libstdc++ rejects the literal
// "{:70000}" and lets the dynamic "{:{}}" through with the same 70000; libc++
// bounds neither path and really does emit a two-gigabyte field.

// width is a positive-integer ([format.string.std]): nonzero-digit
// digit-seq_opt. A leading '0' is not a width at all — in the std-format-spec
// the zero-pad flag has already consumed one '0', and a second one is a
// grammar violation. Precondition: p != e && IsDigit(*p).
template <class CharT>
constexpr int ParseWidth(const CharT *&p, const CharT *e)
{
    if (*p == CharT('0'))
        throw format_error("format: width must not start with a zero digit");
    return int(ParseNumber(p, e));
}

// precision is a nonnegative-integer — unlike width, leading zeros are legal
// here ({:.00} == {:.0}). Precondition: p != e && IsDigit(*p).
template <class CharT>
constexpr int ParsePrecision(const CharT *&p, const CharT *e)
{
    return int(ParseNumber(p, e));
}

// Which types get the integer formatter (not bool / char, which have their own
// presentation defaults). [format.formatter.spec]/2.3 says "each cv-unqualified
// arithmetic type ArithmeticT other than char, wchar_t, char8_t..." — extended
// integer types included, which is why __int128 is here. Do NOT read this list
// as the "standard signed or unsigned integer type" of [format.string.std]/10,
// which is a strictly smaller set and lives in KindIsIntegral. Matched on T
// itself, not remove_cv_t<T>, so formatter<volatile int, char> stays the
// disabled primary.
template <class T>
inline constexpr bool IsStdInt =
    __bits::IsAnyOf<T, signed char, unsigned char, short, unsigned short, int,
                    unsigned int, long, unsigned long, long long,
                    unsigned long long, __int128, unsigned __int128>;

// Map a (decayed) argument type to its erased kind, for a context of the
// given character type. Shared by the argument store and the compile-time
// checker so they always agree.
//
// CharT is what decides three of the branches, and the asymmetry between them
// is [format.arg]'s, not ours: a char argument is storable in a WIDE context
// (it widens, and formatter<char, wchar_t> exists to receive it), while a
// wchar_t argument in a narrow context is not storable at all — it falls to
// Custom, finds no formatter<wchar_t, char>, and is rejected. Strings and
// pointers-to-character have no widening rule at all: only the context's own
// character type is a string here, and const char* in a wide context is a
// pointer to something that is not text as far as this context is concerned.
template <class T, class CharT> constexpr ArgKind MapKind() noexcept
{
    using U = decay_t<T>;  // arrays/functions decay; char[N] → const char*
    // decay_t also strips cv, and dropping `volatile` here silently rescued an
    // argument the library has already decided it will not format:
    // formattable<volatile int, char> is false (the primary formatter stays
    // disabled for cv-qualified arithmetic types, [format.formatter.spec]/2.1),
    // yet format("{}", vi) compiled, because the decayed `int` matched a
    // built-in kind and the FormattableWith guard downstream only covers the
    // custom branch. Both reference libraries reject that call. Routing
    // volatile to Custom sends it through that guard, where the honest
    // diagnostic already lives — and costs nothing for a volatile class type
    // with a real formatter, which was heading to Custom anyway. T can be a
    // reference here: format() deduces Args&& and CheckScan is instantiated
    // with exactly what it deduced.
    if constexpr (is_volatile_v<remove_reference_t<T>>) return ArgKind::Custom;
    else if constexpr (is_same_v<U, bool>) return ArgKind::Bool;
    else if constexpr (is_same_v<U, char> || is_same_v<U, CharT>)
        return ArgKind::Char;
    else if constexpr (is_same_v<U, __int128>) return ArgKind::Int128;
    else if constexpr (is_same_v<U, unsigned __int128>) return ArgKind::UInt128;
    else if constexpr (IsStdInt<U>) {
        if constexpr (is_signed_v<U>)
            return sizeof(U) <= sizeof(int) ? ArgKind::Int : ArgKind::LongLong;
        else
            return sizeof(U) <= sizeof(unsigned) ? ArgKind::UInt
                                                 : ArgKind::ULongLong;
    } else if constexpr (is_same_v<U, float>) return ArgKind::Float;
    else if constexpr (is_same_v<U, double>) return ArgKind::Double;
    else if constexpr (is_same_v<U, long double>) return ArgKind::LongDouble;
    else if constexpr (is_same_v<U, nullptr_t>) return ArgKind::Pointer;
    else if constexpr (is_pointer_v<U>) {
        using P = remove_cv_t<remove_pointer_t<U>>;
        if constexpr (is_same_v<P, CharT>) return ArgKind::CString;
        else if constexpr (is_same_v<P, void>) return ArgKind::Pointer;
        else return ArgKind::Custom;
    } else if constexpr (is_same_v<U, basic_string<CharT>> ||
                         is_same_v<U, basic_string_view<CharT>>)
        return ArgKind::SVString;
    else return ArgKind::Custom;
}

// [format.string.std]/10: a dynamic width or precision option "is valid only if
// the corresponding formatting argument is of standard signed or unsigned
// integer type". __int128 is an EXTENDED integer type — [basic.fundamental]'s
// list of standard integer types is closed and an implementation cannot add to
// it, so is_integral_v<__int128> being true does not make it standard. C++26
// spells the same rule as check_dynamic_spec<int, unsigned int, long long int,
// unsigned long long int>. Both reference libraries reject it; so does boxcxx.
constexpr bool KindIsIntegral(ArgKind k) noexcept
{
    return k == ArgKind::Int || k == ArgKind::UInt || k == ArgKind::LongLong ||
           k == ArgKind::ULongLong;
}

} // namespace __format

// ── basic_format_parse_context ([format.parse.ctx]) ─────────────────────
template <class CharT> class basic_format_parse_context {
public:
    using char_type      = CharT;
    using const_iterator = const CharT *;
    using iterator       = const_iterator;

    constexpr explicit basic_format_parse_context(basic_string_view<CharT> fmt,
                                                  size_t num_args = 0) noexcept
        : begin_(fmt.data()), end_(fmt.data() + fmt.size()), num_args_(num_args)
    {
    }
    basic_format_parse_context(const basic_format_parse_context &) = delete;
    basic_format_parse_context &
    operator=(const basic_format_parse_context &) = delete;

    constexpr const_iterator begin() const noexcept { return begin_; }
    constexpr const_iterator end() const noexcept { return end_; }
    constexpr void advance_to(const_iterator it) noexcept { begin_ = it; }

    constexpr size_t next_arg_id()
    {
        if (indexing_ == Manual)
            throw format_error("format: mixing of automatic and manual "
                               "argument indexing");
        indexing_ = Auto;
        if (next_ >= num_args_)
            throw format_error("format: argument index out of range");
        return next_++;
    }
    constexpr void check_arg_id(size_t id)
    {
        if (indexing_ == Auto)
            throw format_error("format: mixing of automatic and manual "
                               "argument indexing");
        indexing_ = Manual;
        if (id >= num_args_)
            throw format_error("format: argument index out of range");
    }

    // C++23 dynamic-spec validation. At runtime (no type table) these are
    // range checks only; the compile-time checker installs the table so the
    // width/precision argument's type is verified to be integral.
    constexpr void check_dynamic_spec_integral(size_t id)
    {
        if (kinds_) {
            if (id >= num_kinds_)
                throw format_error("format: argument index out of range");
            if (!__format::KindIsIntegral(kinds_[id]))
                throw format_error(
                    "format: width/precision argument is not an integer type");
        }
    }

    // Internal hook used by the consteval checker.
    constexpr void __set_kinds(const __format::ArgKind *k, size_t n) noexcept
    {
        kinds_     = k;
        num_kinds_ = n;
    }

private:
    enum Indexing { Unknown, Auto, Manual };
    const CharT            *begin_;
    const CharT            *end_;
    size_t                  num_args_  = 0;
    size_t                  next_      = 0;
    Indexing                indexing_  = Unknown;
    const __format::ArgKind *kinds_    = nullptr;
    size_t                  num_kinds_ = 0;
};

using format_parse_context  = basic_format_parse_context<char>;
using wformat_parse_context = basic_format_parse_context<wchar_t>;

// ── the spec parser ─────────────────────────────────────────────────────
namespace __format {

// Parse a nested replacement field used for dynamic width/precision: '{'
// already consumed by the caller is NOT the contract — p must point AT '{'.
// Returns the resolved argument id and advances p past the closing '}'.
template <class CharT>
constexpr size_t ParseDynamicArgId(basic_format_parse_context<CharT> &pc,
                                   const CharT *&p, const CharT *e)
{
    ++p;  // past '{'
    size_t id;
    if (p != e && *p == CharT('}')) {
        id = pc.next_arg_id();
    } else if (p != e && IsDigit(*p)) {
        id = ParseNumber(p, e);
        pc.check_arg_id(id);
        if (p == e || *p != CharT('}'))
            throw format_error("format: invalid dynamic field");
    } else {
        throw format_error("format: invalid dynamic field");
    }
    ++p;  // past '}'
    return id;
}

// Parse the full standard spec from pc.begin()..pc.end() into s, resolving
// any dynamic width/precision against pc. Returns the iterator at the '}'
// that closes the replacement field (or wherever parsing stopped — the
// caller verifies a '}' follows).
template <class CharT>
constexpr const CharT *ParseSpec(basic_format_parse_context<CharT> &pc,
                                 StdSpec<CharT> &s)
{
    const CharT *p = pc.begin();
    const CharT *e = pc.end();
    if (p == e || *p == CharT('}')) return p;

    // [fill]align — fill is any character but '{'/'}' and must be followed by
    // an alignment character. This is the one CharT position in the whole
    // grammar: a fill is copied to the output, never interpreted.
    if (p + 1 < e && IsAlignChar(p[1]) && *p != CharT('{') && *p != CharT('}')) {
        s.fill  = *p;
        s.align = AlignOf(p[1]);
        p += 2;
    } else if (p != e && IsAlignChar(*p)) {
        s.align = AlignOf(*p);
        ++p;
    }

    // sign
    if (p != e) {
        if (*p == CharT('+')) { s.sign = Sign::Plus; s.sign_given = true; ++p; }
        else if (*p == CharT('-')) { s.sign = Sign::Minus; s.sign_given = true; ++p; }
        else if (*p == CharT(' ')) { s.sign = Sign::Space; s.sign_given = true; ++p; }
    }
    // '#'
    if (p != e && *p == CharT('#')) { s.alt = true; ++p; }
    // '0' — zero pad (only meaningful for numeric types; flagged here, the
    // formatter ignores it when an explicit alignment was given)
    if (p != e && *p == CharT('0')) { s.zero = true; ++p; }
    // width
    if (p != e && IsDigit(*p)) {
        s.width = ParseWidth(p, e);
    } else if (p != e && *p == CharT('{')) {
        s.width_id      = ParseDynamicArgId(pc, p, e);
        s.width_dynamic = true;
        pc.check_dynamic_spec_integral(s.width_id);
    }
    // precision
    if (p != e && *p == CharT('.')) {
        ++p;
        if (p != e && IsDigit(*p)) {
            s.precision = ParsePrecision(p, e);
        } else if (p != e && *p == CharT('{')) {
            s.prec_id      = ParseDynamicArgId(pc, p, e);
            s.prec_dynamic = true;
            pc.check_dynamic_spec_integral(s.prec_id);
        } else {
            throw format_error("format: missing precision after '.'");
        }
    }
    // 'L'
    if (p != e && *p == CharT('L')) { s.localized = true; ++p; }
    // type — narrowed, so a wide presentation character cannot alias an ASCII
    // one. The mapping sends everything outside ASCII to a character no
    // formatter accepts, which turns "{:ж}" into the same honest "invalid
    // type" diagnostic that "{:ж}" would raise if ж were an ASCII letter with
    // no meaning here.
    if (p != e && *p != CharT('}')) { s.type = NarrowAscii(*p); ++p; }
    return p;
}

} // namespace __format

// ── basic_format_arg ([format.arg]) ─────────────────────────────────────
template <class Context> class basic_format_arg {
public:
    using char_type = typename Context::char_type;

    class handle {
    public:
        void format(basic_format_parse_context<char_type> &pc, Context &fc) const
        {
            fmt_(pc, fc, ptr_);
        }

    private:
        friend class basic_format_arg;
        const void *ptr_ = nullptr;
        void (*fmt_)(basic_format_parse_context<char_type> &, Context &,
                     const void *) = nullptr;
    };

    basic_format_arg() noexcept : kind_(__format::ArgKind::None), v_{} {}

    explicit operator bool() const noexcept
    {
        return kind_ != __format::ArgKind::None;
    }

    __format::ArgKind __kind() const noexcept { return kind_; }

    // Run the matching formatter: parse the spec (leaving pc.begin() at the
    // closing '}') then format the stored value into fc.
    void __format_to(basic_format_parse_context<char_type> &pc,
                     Context &fc) const;

    // Coerce an integer-kind argument to long long (for dynamic width /
    // precision). Throws if the stored value is not an integer type.
    long long __as_integer() const
    {
        switch (kind_) {
        case __format::ArgKind::Int: return v_.i;
        case __format::ArgKind::UInt: return v_.u;
        case __format::ArgKind::LongLong: return v_.ll;
        case __format::ArgKind::ULongLong:
            if (v_.ull > (unsigned long long)__format::kIntMax)
                throw format_error("format: width/precision out of range");
            return (long long)v_.ull;
        // Int128/UInt128 fall to the default: [format.string.std]/10 admits
        // only the STANDARD integer types here, and the extended ones are not
        // among them. See KindIsIntegral, which is the compile-time half of the
        // same rule.
        default:
            throw format_error(
                "format: width/precision argument is not an integer type");
        }
    }

    // Visitation support for std::visit_format_arg.
    template <class Visitor>
    decltype(auto) __visit(Visitor &&vis) const;

    // Build the erased argument for a value of (deduced) type T. A static
    // member so it can touch the private storage without a friend dance.
    template <class T> static basic_format_arg __make(T &v);

private:
    __format::ArgKind kind_;
    union Storage {
        char               nul;
        bool               b;
        char_type          c;
        int                i;
        unsigned           u;
        long long          ll;
        unsigned long long ull;
        // GCC's extended integer types. They cannot ride in `ll`/`ull`: a
        // 128-bit value narrowed to 64 bits would format a different number,
        // silently. long double is already 16 bytes here, so the union does
        // not grow.
        __int128           i128;
        unsigned __int128  u128;
        float              f;
        double             d;
        long double        ld;
        const char_type   *cs;
        basic_string_view<char_type> sv;
        const void        *pv;
        constexpr Storage() noexcept : nul(0) {}
    } v_;
    handle h_{};
};

// ── basic_format_args ([format.args]) ───────────────────────────────────
template <class Context, class... Ts> struct __format_store {
    static constexpr size_t kN = sizeof...(Ts) == 0 ? 1 : sizeof...(Ts);
    basic_format_arg<Context> data[kN];
};

template <class Context> class basic_format_args {
public:
    basic_format_args() noexcept = default;

    template <class... Ts>
    basic_format_args(const __format_store<Context, Ts...> &store) noexcept
        : size_(sizeof...(Ts)), data_(store.data)
    {
    }

    basic_format_arg<Context> get(size_t i) const noexcept
    {
        return i < size_ ? data_[i] : basic_format_arg<Context>{};
    }
    size_t __count() const noexcept { return size_; }

private:
    size_t                           size_ = 0;
    const basic_format_arg<Context> *data_ = nullptr;
};

// ── basic_format_context ([format.context]) ─────────────────────────────
namespace __format {

// Type-erased output sink. format() / format_to / formatted_size /
// format_to_n all funnel through one of these so the engine is generic over
// the CHARACTER type and nothing else — the output iterator, which is the
// other axis the standard leaves open, stays a single type per character
// type. That is why every formatter here can name format_context& concretely
// instead of being a template over Out.
template <class CharT> struct OutputSink {
    virtual void Append(CharT c)                    = 0;
    virtual void Append(const CharT *s, size_t n)   = 0;

protected:
    ~OutputSink() = default;
};

// The single output-iterator type seen by formatters via ctx.out().
template <class CharT> class SinkIterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type        = void;
    using difference_type    = ptrdiff_t;
    using pointer           = void;
    using reference         = void;

    SinkIterator() noexcept = default;
    explicit SinkIterator(OutputSink<CharT> &s) noexcept : sink_(&s) {}

    SinkIterator &operator=(CharT c)
    {
        sink_->Append(c);
        return *this;
    }
    SinkIterator &operator*() noexcept { return *this; }
    SinkIterator &operator++() noexcept { return *this; }
    SinkIterator  operator++(int) noexcept { return *this; }

    OutputSink<CharT> *__sink() const noexcept { return sink_; }

private:
    OutputSink<CharT> *sink_ = nullptr;
};

} // namespace __format

// [format.syn] names basic_format_context as a class template over an
// unspecified Out and defines both format_context and wformat_context from
// it. The Out this library has is the erased sink iterator, so exactly one
// specialization is defined and the primary is left undefined: naming
// basic_format_context<MyIterator, char> is then a compile error rather than
// a type that looks constructible and is not — the same answer <locale> gives
// for use_facet of a facet this image does not carry, moved to where it costs
// nothing to act on.
template <class Out, class CharT> class basic_format_context;

template <class CharT>
class basic_format_context<__format::SinkIterator<CharT>, CharT> {
    using Self = basic_format_context;

public:
    using iterator  = __format::SinkIterator<CharT>;
    using char_type = CharT;
    template <class T> using formatter_type = formatter<T, CharT>;

    iterator out() noexcept { return out_; }
    void     advance_to(iterator it) noexcept { out_ = it; }
    basic_format_arg<Self> arg(size_t id) const noexcept
    {
        return args_.get(id);
    }
    // [format.context]: the locale passed to the formatting function if it
    // took one, and std::locale() — the current GLOBAL locale — otherwise.
    // Held by pointer, not by value: the pointee is the caller's own argument
    // and outlives the call, while a locale by value would put a refcounted
    // member in every context, including the scratch ones a range builds per
    // element.
    std::locale locale() { return loc_ != nullptr ? *loc_ : std::locale(); }

    // Internal accessor: lets a nested context (built around a scratch sink,
    // e.g. range_formatter's width-triggered buffering) share this context's
    // own argument store, so nested dynamic width/precision still resolves
    // against the real argument list.
    basic_format_args<Self> __args() const noexcept { return args_; }

    // ... and the locale with it. A nested context that lost it would make
    // `{:L}` inside a range mean something different from `{:L}` outside one.
    const std::locale *__loc() const noexcept { return loc_; }

    // Internal constructor used by the engine.
    basic_format_context(iterator out, basic_format_args<Self> args,
                         const std::locale *loc = nullptr) noexcept
        : out_(out), args_(args), loc_(loc)
    {
    }

private:
    iterator                out_;
    basic_format_args<Self> args_;
    const std::locale      *loc_ = nullptr;
};

// ════════════════════════════════════════════════════════════════════════
//  Field emission helpers (need basic_format_context complete)
// ════════════════════════════════════════════════════════════════════════
namespace __format {

// Spelling out basic_format_context<SinkIterator<CharT>, CharT> in every
// signature below would bury the one thing they have in common. An alias
// template is transparent to deduction, so CharT still deduces from the
// argument.
template <class CharT>
using Ctx = basic_format_context<SinkIterator<CharT>, CharT>;

// The widening boundary, and the only one. A run whose source characters are
// already CharT goes to the sink whole; a run of ASCII — every digit this
// file produces, "true", "0x", the escaped text — is widened one character at
// a time on the way past.
//
// The cast is spelt through unsigned char on purpose, and that is not a
// precaution — it is reachable. Ф42-f found <ios>'s widen() SIGN-EXTENDING,
// so widen('\xD0') was wchar_t(-48) while the stream writer made U+00D0 out of
// the same byte: two answers to one question, from two places that had never
// before been reachable at once.
//
// ‼ Every run that reaches HERE is ASCII, and mutation testing is what
// established that rather than inspection: making this cast signed changed no
// observable output anywhere in the suite. The narrow bodies that arrive are
// digits from to_chars, "true"/"false", a base prefix, and <chrono>'s streamed
// text — all of them produced by this library, all of them ASCII. The one
// narrow body a CALLER can put a byte above 0x7F into is a %Z abbreviation
// handed to chrono::local_time_format, and that one does NOT come through
// here: <__bits/chrono_format>'s own walk widens it, and Phase219 pins that
// site. So the cast below is written for agreement, not for reachability —
// three places now turn a byte into a wide character, and all three must
// answer alike.
//
// Byte-wise is also a decision and not an oversight: BoxOS is UTF-8 throughout,
// so DECODING such a body would arguably be more useful — and would install a
// second widening rule beside <ios>::widen's, which is the shape of the defect
// this comment exists because of.
template <class CharT, class Src>
inline void WriteRun(__format::SinkIterator<CharT> &out, const Src *s, size_t n)
{
    if constexpr (is_same_v<Src, CharT>) {
        out.__sink()->Append(s, n);
    } else {
        for (size_t i = 0; i < n; ++i)
            out.__sink()->Append(CharT(static_cast<unsigned char>(s[i])));
    }
}
template <class CharT>
inline void WriteFill(__format::SinkIterator<CharT> &out, CharT c, int n)
{
    for (int i = 0; i < n; ++i) out.__sink()->Append(c);
}

// Emit sign_prefix + body padded to `width` according to spec. `numeric`
// enables zero-padding (zeros inserted between sign_prefix and body) and
// selects the default alignment when none was requested.
//
// BodyC is the seam of the whole design: a number's body is ASCII and a
// string argument's body is CharT, and both arrive here. Only the body has
// the freedom — a sign and a base prefix are '+'/'-'/' '/"0x" and could not
// be anything else.
template <class CharT, class BodyC>
inline void EmitField(Ctx<CharT> &ctx, const StdSpec<CharT> &spec, int width,
                      string_view sign_prefix, basic_string_view<BodyC> body,
                      Align dflt, bool numeric)
{
    auto out = ctx.out();
    // The size of a field is its ESTIMATED WIDTH ([format.string.std]/13) —
    // extended grapheme clusters, some of them two columns — and not its
    // length in code units. This is the one seam every formatted body passes
    // through, which is why the measurement belongs here and nowhere else: it
    // is what makes a padded column of CJK, of combining marks or of emoji
    // line up. A number's body is ASCII and takes EstimateWidth's fast path,
    // where the width IS the count and no table is opened.
    //
    // core is a size_t, never an int. For a width-bearing range or tuple field
    // the body IS the whole scratch string, which can exceed INT_MAX: narrowing
    // it wrapped negative, so `width <= core` failed even for width 1 and pad
    // became ~2^31 fill characters. Measured before the fix:
    // format("{:1:65535}", vector<int>(32769)) — a ten-character format string —
    // emitted 4294967297 characters where both reference libraries emit
    // 2147581953. `width` is an int on every path, so the subtraction below
    // cannot overflow.
    const size_t core = sign_prefix.size() + EstimateWidth(body);

    if (width <= 0 || size_t(width) <= core) {
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteRun(out, body.data(), body.size());
        ctx.advance_to(out);
        return;
    }

    const int pad = int(size_t(width) - core);
    if (spec.zero && spec.align == Align::Default && numeric) {
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteFill(out, CharT('0'), pad);
        WriteRun(out, body.data(), body.size());
        ctx.advance_to(out);
        return;
    }

    const Align a    = spec.align == Align::Default ? dflt : spec.align;
    const CharT fill = spec.fill;
    if (a == Align::Left) {
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteRun(out, body.data(), body.size());
        WriteFill(out, fill, pad);
    } else if (a == Align::Right) {
        WriteFill(out, fill, pad);
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteRun(out, body.data(), body.size());
    } else {  // center — extra unit on the right when odd
        const int l = pad / 2, r = pad - l;
        WriteFill(out, fill, l);
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteRun(out, body.data(), body.size());
        WriteFill(out, fill, r);
    }
    ctx.advance_to(out);
}

// Digits of a 128-bit magnitude, most-significant first. <charconv>'s to_chars
// tops out at 64 bits, so the wide path converts here. Bases 2/8/16 are shifts
// and masks. Base 10 reduces the value as four 32-bit limbs, which keeps every
// division 64-bit — the width x86-64 divides in hardware. A literal 128-bit
// divisor is NOT enough on its own: GCC only turns it into a multiply-high
// sequence from -O1 on, and boxcxx's apps carry no -O flag, so the shipped
// build was two libgcc calls (__udivti3 + __umodti3) per digit, up to 78 of
// them per number. Returns the digit count; the caller uppercases if asked.
inline int Digits128(char *out, unsigned __int128 mag, int base)
{
    char tmp[numeric_limits<unsigned __int128>::digits];  // base 2: one per bit
    int  n = 0;
    if (mag == 0) tmp[n++] = '0';
    else if (base == 10) {
        // Schoolbook division by 10^9, the largest power of ten below 2^32.
        // The running remainder stays below the divisor, so each step divides
        // something under 2^32 * 10^9 and its quotient always fits a limb.
        unsigned  limb[sizeof(mag) / sizeof(unsigned)];
        const int high = int(sizeof(limb) / sizeof(limb[0])) - 1;
        for (int i = 0; i <= high; ++i) limb[i] = unsigned(mag >> (i * 32));
        int top = high;
        while (top > 0 && limb[top] == 0) --top;
        for (;;) {
            unsigned long long rem = 0;
            for (int i = top; i >= 0; --i) {
                const unsigned long long cur = (rem << 32) | limb[i];
                limb[i] = unsigned(cur / 1000000000u);
                rem     = cur % 1000000000u;
            }
            // Every chunk is emitted zero-padded to nine digits; only the last
            // one may have leading zeros, stripped once the loop ends.
            for (unsigned chunk = unsigned(rem), k = 0; k < 9; ++k) {
                tmp[n++] = char('0' + chunk % 10u);
                chunk /= 10u;
            }
            while (top > 0 && limb[top] == 0) --top;
            if (limb[top] == 0) break;
        }
        while (n > 1 && tmp[n - 1] == '0') --n;
    }
    else if (base == 16)
        while (mag) {
            const unsigned d = unsigned(mag) & 15u;
            tmp[n++] = d < 10 ? char('0' + d) : char('a' + (d - 10));
            mag >>= 4;
        }
    else if (base == 8)
        while (mag) { tmp[n++] = char('0' + (unsigned(mag) & 7u)); mag >>= 3; }
    else
        while (mag) { tmp[n++] = char('0' + (unsigned(mag) & 1u)); mag >>= 1; }
    for (int i = 0; i < n; ++i) out[i] = tmp[n - 1 - i];
    return n;
}

// Format an integer magnitude. `type` is one of \0/d/b/B/o/x/X. Mag is unsigned
// long long for every standard integer type and unsigned __int128 for the
// extended ones; the narrow path keeps going through to_chars exactly as
// before.
template <class CharT, class Mag>
inline void FormatIntCore(Ctx<CharT> &ctx, const StdSpec<CharT> &spec,
                          int width, bool negative, Mag mag, char type)
{
    int         base   = 10;
    const char *prefix = "";
    bool        upper  = false;
    switch (type) {
    case '\0':
    case 'd': base = 10; break;
    case 'b': base = 2; prefix = spec.alt ? "0b" : ""; break;
    case 'B': base = 2; prefix = spec.alt ? "0B" : ""; break;
    case 'o': base = 8; prefix = (spec.alt && mag != 0) ? "0" : ""; break;
    case 'x': base = 16; prefix = spec.alt ? "0x" : ""; break;
    case 'X': base = 16; prefix = spec.alt ? "0X" : ""; upper = true; break;
    }

    // Base 2 is the widest conversion either path can produce: one character
    // per value bit, and to_chars never needs more than that. Taking the bound
    // off Mag keeps the narrow instantiation from carrying the wide frame.
    char digits[numeric_limits<Mag>::digits];
    int  dl;
    if constexpr (sizeof(Mag) <= sizeof(unsigned long long)) {
        auto r = to_chars(digits, digits + sizeof(digits),
                          (unsigned long long)mag, base);
        dl     = int(r.ptr - digits);
    } else {
        dl = Digits128(digits, mag, base);
    }
    if (upper)
        for (int i = 0; i < dl; ++i) digits[i] = ToUpperAscii(digits[i]);

    // One sign character, then the base prefix; "0b"/"0B"/"0x"/"0X" are the
    // longest, so the bound comes off the literal rather than a hand count.
    char sp[1 + (sizeof("0b") - 1)];
    int  spn = 0;
    if (negative) sp[spn++] = '-';
    else if (spec.sign == Sign::Plus) sp[spn++] = '+';
    else if (spec.sign == Sign::Space) sp[spn++] = ' ';
    for (const char *q = prefix; *q; ++q) sp[spn++] = *q;

    if (spec.localized) {
        // Every base groups, not only decimal — measured, on both references.
        EmitLocalized(ctx, spec, width, string_view(sp, spn), digits, size_t(dl),
                      size_t(dl), /*numeric=*/true);
        return;
    }
    EmitField(ctx, spec, width, string_view(sp, spn), string_view(digits, dl),
              Align::Right, /*numeric=*/true);
}

// ── the `L` option ([format.string.std]/6) ──────────────────────────────
// Parsed and dropped for the whole epic, because there was no numpunct to ask.
// There is one as of Ф43-c, and what the flag changes is the digits: the group
// separators and the radix character come from the facet the locale carries.
//
// Measured on both reference implementations, which agree on every case:
// grouping applies to EVERY base, not only to decimal ("{:Lb}" groups bits);
// the separators COUNT toward the field width; and zero padding is NOT
// grouped, so "{:012L}" of 1234567 is "0001'234'567" — twelve characters, of
// which three are plain zeros.
//
// The body is not materialized. A float body runs to thousands of characters,
// and multiplying such a buffer by sizeof(CharT) is the mistake this library
// paid a page fault for in Ф43-c-1. Only its LENGTH is computed ahead, which
// is all the padding needs.
template <class CharT>
inline void EmitLocalized(Ctx<CharT> &ctx, const StdSpec<CharT> &spec, int width,
                          string_view sign_prefix, const char *body, size_t bodyLen,
                          size_t intLen, bool numeric)
{
    const std::locale      loc = ctx.locale();
    const numpunct<CharT> &np  = use_facet<numpunct<CharT>>(loc);
    const string           grp = np.grouping();
    const CharT            sep = np.thousands_sep();
    const CharT            pt  = np.decimal_point();

    size_t seps = 0, taken = 0;
    if (!grp.empty() && intLen > 0) {
        for (;;) {
            const size_t step = __ios::__grouping::At(grp, seps);
            if (step == 0 || taken + step >= intLen) break;
            taken += step;
            ++seps;
        }
    }
    const size_t firstLen = intLen - taken;

    auto out = ctx.out();

    // ONE walk over the characters the body will consist of, so that what is
    // measured and what is written cannot drift apart. The leftmost group
    // first, then the rest right to left: group k counts from the RIGHT, so
    // walking forward means counting down.
    const auto walk = [&](auto &&emit) {
        size_t i = 0;
        for (size_t n = 0; n < firstLen; ++n)
            emit(CharT(static_cast<unsigned char>(body[i++])));
        for (size_t k = seps; k-- > 0;) {
            emit(sep);
            const size_t step = __ios::__grouping::At(grp, k);
            for (size_t n = 0; n < step; ++n)
                emit(CharT(static_cast<unsigned char>(body[i++])));
        }
        for (; i < bodyLen; ++i)
            emit(body[i] == '.' ? pt
                                : CharT(static_cast<unsigned char>(body[i])));
    };
    const auto writeBody = [&] {
        walk([&](CharT c) { out.__sink()->Append(c); });
    };

    // Every character of the body proper is a digit or a decoration to_chars
    // wrote, so it is ASCII and one column. Only the two characters the FACET
    // supplies can be anything else, and when they are ordinary ASCII — which
    // they are in every locale this library ships — the width is the count and
    // the Unicode tables are never opened. When they are not, the same walk
    // feeds the meter, so a two-column separator widens the field and a
    // COMBINING one joins the digit before it instead of adding a column.
    const auto plainAscii = [](CharT c) {
        const auto u = static_cast<make_unsigned_t<CharT>>(c);
        return u >= 0x20u && u < 0x7Fu;
    };
    size_t bodyWidth = bodyLen + seps;
    if (!plainAscii(sep) || !plainAscii(pt)) {
        WidthMeter meter;
        walk([&](CharT c) {
            const auto u = static_cast<make_unsigned_t<CharT>>(c);
            if constexpr (is_same_v<CharT, char>)
                meter.Add(u < 0x80u ? char32_t(u) : kIllFormed);
            else
                meter.Add(char32_t(u));
        });
        bodyWidth = meter.Finish();
    }
    const size_t core = sign_prefix.size() + bodyWidth;

    if (width <= 0 || size_t(width) <= core) {
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        writeBody();
        ctx.advance_to(out);
        return;
    }

    const int pad = int(size_t(width) - core);
    if (spec.zero && spec.align == Align::Default && numeric) {
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteFill(out, CharT('0'), pad);
        writeBody();
        ctx.advance_to(out);
        return;
    }

    const Align a    = spec.align == Align::Default ? Align::Right : spec.align;
    const CharT fill = spec.fill;
    if (a == Align::Left) {
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        writeBody();
        WriteFill(out, fill, pad);
    } else if (a == Align::Right) {
        WriteFill(out, fill, pad);
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        writeBody();
    } else {  // center — extra unit on the right when odd
        const int l = pad / 2, r = pad - l;
        WriteFill(out, fill, l);
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        writeBody();
        WriteFill(out, fill, r);
    }
    ctx.advance_to(out);
}

// A character argument is one of the three things that really is CharT, so
// this one does not widen: the value came from the caller already spelt in
// the output's own character type.
template <class CharT>
inline void FormatCharCore(Ctx<CharT> &ctx, const StdSpec<CharT> &spec,
                           int width, CharT c)
{
    EmitField(ctx, spec, width, string_view(), basic_string_view<CharT>(&c, 1),
              Align::Left, /*numeric=*/false);
}

// BodyC is free here because the string this formats is sometimes the
// argument's own text (CharT) and sometimes a literal this file owns —
// "true", "false", a rendered date.
//
// [format.string.std]/14: a string's precision names the longest prefix whose
// ESTIMATED WIDTH is at most that value. So the cut lands on a cluster
// boundary, never inside one, and never leaves half of a two-column character
// or half of a UTF-8 sequence behind — which a clamp in code units did, and
// this was one for the whole epic before Ф43-e-2.
template <class CharT, class BodyC>
inline void FormatString(Ctx<CharT> &ctx, const StdSpec<CharT> &spec, int width,
                         int precision, basic_string_view<BodyC> s)
{
    if (precision >= 0) s = s.substr(0, PrefixForWidth(s, size_t(precision)));
    EmitField(ctx, spec, width, string_view(), s, Align::Left,
              /*numeric=*/false);
}

// Expand a stripped general result to P significant digits (defined below).
inline ptrdiff_t FmtGeneralAlt(char *buf, ptrdiff_t len, ptrdiff_t cap, int P);

// Floating-point. `type` ∈ \0/e/E/f/F/g/G/a/A; precision -1 means "absent".
template <class F, class CharT>
void FormatFloatCore(Ctx<CharT> &ctx, const StdSpec<CharT> &spec, int width,
                     int precision, F value, char type)
{
    const bool neg   = __builtin_signbit(value);
    const F    mag   = neg ? -value : value;
    const bool upper = type == 'E' || type == 'F' || type == 'G' || type == 'A';

    // A scratch big enough for the widest finite output: ~309 integer digits
    // for fixed DBL_MAX plus the requested precision plus decoration. `need`
    // is computed in size_t and cap/len are ptrdiff_t so a pathologically
    // large precision (near INT_MAX) cannot overflow into a tiny buffer and
    // silently truncate — it either allocates or throws from resize().
    char      stackbuf[512];
    string    heapbuf;
    char     *buf = stackbuf;
    ptrdiff_t cap = ptrdiff_t(sizeof(stackbuf));
    size_t base = 340;
    if constexpr (is_same_v<F, long double>)
        if (type == 'f' || type == 'F')
            base = size_t(numeric_limits<F>::max_exponent10) + 34;  // 4932+34
    const size_t need = base + (precision > 0 ? size_t(precision) : size_t(0));
    if (need > size_t(cap)) {
        heapbuf.resize(need);  // throws bad_alloc/length_error if absurd
        buf = heapbuf.data();
        cap = ptrdiff_t(need);
    }

    const bool general_like =
        type == 'g' || type == 'G' || (type == '\0' && precision >= 0);

    to_chars_result r{};
    if (type == '\0' && precision < 0) {
        r = to_chars(buf, buf + cap, mag);  // shortest round-trip
    } else if (general_like) {
        int p = precision < 0 ? 6 : precision;
        if (p == 0) p = 1;
        r = to_chars(buf, buf + cap, mag, chars_format::general, p);
    } else if (type == 'f' || type == 'F') {
        r = to_chars(buf, buf + cap, mag, chars_format::fixed,
                     precision < 0 ? 6 : precision);
    } else if (type == 'e' || type == 'E') {
        r = to_chars(buf, buf + cap, mag, chars_format::scientific,
                     precision < 0 ? 6 : precision);
    } else {  // 'a' / 'A'
        if (precision < 0)
            r = to_chars(buf, buf + cap, mag, chars_format::hex);
        else
            r = to_chars(buf, buf + cap, mag, chars_format::hex, precision);
    }

    ptrdiff_t  len    = r.ptr - buf;
    const bool finite = !(len > 0 && (buf[0] == 'i' || buf[0] == 'n'));

    // '#': always ensure a decimal point. Additionally, only the *explicit*
    // 'g'/'G' presentation keeps trailing zeros to the significant-digit
    // count; the default presentation (no type) just adds the point — so
    // {:#.2} of 0 is "0." while {:#.2g} of 0 is "0.0" (matches libstdc++).
    if (spec.alt && finite) {
        if (type == 'g' || type == 'G') {
            len = FmtGeneralAlt(buf, len, cap, precision < 0 ? 6 : precision);
        } else {
            bool      has_dot = false;
            ptrdiff_t marker  = len;  // index of 'e'/'p', else len
            for (ptrdiff_t i = 0; i < len; ++i) {
                if (buf[i] == '.') { has_dot = true; break; }
                if (buf[i] == 'e' || buf[i] == 'p') { marker = i; break; }
            }
            if (!has_dot && len + 1 <= cap) {
                for (ptrdiff_t i = len; i > marker; --i) buf[i] = buf[i - 1];
                buf[marker] = '.';
                ++len;
            }
        }
    }

    if (upper)
        for (ptrdiff_t i = 0; i < len; ++i) buf[i] = ToUpperAscii(buf[i]);

    // The 'a'/'A' presentation delegates to to_chars(hex), which (per the
    // standard) emits no "0x" prefix — unlike printf %a.
    char sp[2];
    int  spn = 0;
    if (neg) sp[spn++] = '-';
    else if (spec.sign == Sign::Plus) sp[spn++] = '+';
    else if (spec.sign == Sign::Space) sp[spn++] = ' ';

    if (spec.localized) {
        // Grouping runs over the integer part only: the digits before the
        // radix point, or before the exponent when there is no point.
        ptrdiff_t intLen = 0;
        while (intLen < len && buf[intLen] != '.' && buf[intLen] != 'e' &&
               buf[intLen] != 'E' && buf[intLen] != 'p' && buf[intLen] != 'P')
            ++intLen;
        EmitLocalized(ctx, spec, width, string_view(sp, spn), buf, size_t(len),
                      size_t(intLen), /*numeric=*/finite);
        return;
    }
    EmitField(ctx, spec, width, string_view(sp, spn), string_view(buf, len),
              Align::Right, /*numeric=*/finite);
}

// Expand a stripped general result back to `P` significant digits (the '#'
// alternate form keeps trailing zeros). Operates in place on [buf,buf+len);
// returns the new length. Assumes a finite, non-negative magnitude token.
inline ptrdiff_t FmtGeneralAlt(char *buf, ptrdiff_t len, ptrdiff_t cap, int P)
{
    if (P <= 0) P = 1;
    // Locate exponent marker and the mantissa span.
    ptrdiff_t epos = len;
    for (ptrdiff_t i = 0; i < len; ++i)
        if (buf[i] == 'e') { epos = i; break; }
    // Count significant digits in [0,epos): all digits, but leading zeros of
    // a pure-fraction (0.00ddd) do not count.
    ptrdiff_t dot = -1;
    for (ptrdiff_t i = 0; i < epos; ++i)
        if (buf[i] == '.') { dot = i; break; }
    ptrdiff_t sig          = 0;
    bool      seen_nonzero = false;
    for (ptrdiff_t i = 0; i < epos; ++i) {
        char ch = buf[i];
        if (ch == '.') continue;
        if (ch != '0') seen_nonzero = true;
        if (seen_nonzero) ++sig;
    }
    if (sig == 0) sig = 1;  // value is exactly 0 → one significant digit
    ptrdiff_t add = ptrdiff_t(P) - sig;
    if (add <= 0) {
        // already P sig digits; just guarantee a decimal point
        if (dot < 0 && epos <= len) {
            if (len + 1 <= cap) {
                for (ptrdiff_t i = len; i > epos; --i) buf[i] = buf[i - 1];
                buf[epos] = '.';
                ++len;
                ++epos;
            }
        }
        return len;
    }
    // Need to insert a '.' (if missing) and `add` zeros right before epos.
    ptrdiff_t insert_at = epos;
    ptrdiff_t extra     = add + (dot < 0 ? 1 : 0);
    if (len + extra > cap) extra = cap - len;  // clamp (shouldn't happen)
    for (ptrdiff_t i = len + extra - 1; i >= insert_at + extra; --i)
        buf[i] = buf[i - extra];
    ptrdiff_t w = insert_at;
    if (dot < 0) buf[w++] = '.';
    for (ptrdiff_t i = 0; i < add && w < insert_at + extra; ++i) buf[w++] = '0';
    return len + extra;
}

