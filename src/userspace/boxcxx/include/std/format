// Primary template — disabled (a program that formats an unsupported type
// fails because the formatter is not constructible).
template <class T, class CharT> struct formatter {
    formatter()                             = delete;
    formatter(const formatter &)            = delete;
    formatter &operator=(const formatter &) = delete;
};

// [format.syn] / [format.formatter.spec]/3 — true for every type this library
// provides a formatter for, so a locking print implementation may take the
// unlocked path. boxcxx's <print> holds no lock, so the trait is declarative
// here; it is part of the synopsis and user code may query it. The `= true`
// specializations sit after formatter<nullptr_t, char>, where every scalar
// formatter is complete. Range, tuple and chrono stay false — their
// subclauses specify otherwise.
template <class T>
constexpr bool enable_nonlocking_formatter_optimization = false;

namespace __format {

// Resolve dynamic width/precision against the format context.
template <class CharT> inline int ResolveDynamic(Ctx<CharT> &ctx, size_t id)
{
    const long long v = ctx.arg(id).__as_integer();
    if (v < 0) throw format_error("format: negative width/precision");
    if (v > kIntMax) throw format_error("format: width/precision out of range");
    return int(v);
}
template <class CharT>
inline int EffectiveWidth(Ctx<CharT> &ctx, const StdSpec<CharT> &s)
{
    return s.width_dynamic ? ResolveDynamic(ctx, s.width_id) : s.width;
}
template <class CharT>
inline int EffectivePrecision(Ctx<CharT> &ctx, const StdSpec<CharT> &s)
{
    return s.prec_dynamic ? ResolveDynamic(ctx, s.prec_id) : s.precision;
}

constexpr bool IsIntType(char t) noexcept
{
    return t == '\0' || t == 'b' || t == 'B' || t == 'c' || t == 'd' ||
           t == 'o' || t == 'x' || t == 'X';
}

} // namespace __format

// Integer types (signed char .. unsigned long long, excluding bool/char).
//
// A partial specialization whose argument list is the primary's, told apart by
// its constraints alone — legal since C++20 and verified on this toolchain
// before the first one was written, because the whole formatter section below
// is shaped by whether it is.
template <class T, class CharT>
    requires __format::IsStdInt<T> && __format::FmtCharT<CharT>
struct formatter<T, CharT> {
    __format::StdSpec<CharT> spec_;

    constexpr typename basic_format_parse_context<CharT>::iterator
    parse(basic_format_parse_context<CharT> &pc)
    {
        const CharT *p = __format::ParseSpec(pc, spec_);
        if (!__format::IsIntType(spec_.type))
            throw format_error("format: invalid type for integer");
        if (spec_.precision >= 0 || spec_.prec_dynamic)
            throw format_error("format: precision not allowed for integer");
        // sign/#/0 with the 'c' presentation are accepted and ignored
        // (matches the character-output path, which drops them).
        pc.advance_to(p);
        return p;
    }

    void format(T value, __format::Ctx<CharT> &ctx) const
    {
        const int width = __format::EffectiveWidth(ctx, spec_);
        if (spec_.type == 'c') {
            // [tab:format.type.int]: the bound is CharT's, not char's. Measured
            // against libc++ before it was written: format(L"{:c}", 200) yields
            // U+00C8 while format("{:c}", 200) throws, and both are right —
            // 200 is a character in one alphabet and not in the other.
            if (cmp_less(value, int(numeric_limits<CharT>::min())) ||
                cmp_greater(value, (long long)numeric_limits<CharT>::max()))
                throw format_error("format: integer not in the character range");
            __format::FormatCharCore(ctx, spec_, width, CharT(value));
            return;
        }
        // The magnitude carries T's own width: narrowing a 128-bit value to 64
        // bits would print a different number without any diagnostic.
        using MagT = conditional_t<(sizeof(T) > sizeof(unsigned long long)),
                                   unsigned __int128, unsigned long long>;
        bool neg   = false;
        MagT mag;
        if constexpr (is_signed_v<T>) {
            if (value < 0) {
                neg = true;
                // Negating is what is load-bearing, not the width it happens
                // in: a widening cast alone keeps the two's-complement pattern
                // (int -42 would read as 2^64-42). It is done in T's own
                // unsigned width because that says |value| locally and needs no
                // argument about the minimum, which has no positive
                // counterpart — but negation commutes with sign-extension
                // modulo the narrow width, so widening first would give the
                // same magnitude for every T and every value.
                using UT = make_unsigned_t<T>;
                mag      = static_cast<MagT>(
                    static_cast<UT>(UT(0) - static_cast<UT>(value)));
            } else {
                mag = (MagT)value;
            }
        } else {
            mag = (MagT)value;
        }
        __format::FormatIntCore(ctx, spec_, width, neg, mag, spec_.type);
    }
};

// bool
template <class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<bool, CharT> {
    __format::StdSpec<CharT> spec_;

    constexpr typename basic_format_parse_context<CharT>::iterator
    parse(basic_format_parse_context<CharT> &pc)
    {
        const CharT *p = __format::ParseSpec(pc, spec_);
        const char   t = spec_.type;
        const bool  string_form = (t == '\0' || t == 's');
        // bool does NOT accept the 'c' presentation (unlike int/char).
        if (!(string_form || t == 'b' || t == 'B' || t == 'd' || t == 'o' ||
              t == 'x' || t == 'X'))
            throw format_error("format: invalid type for bool");
        if (spec_.precision >= 0 || spec_.prec_dynamic)
            throw format_error("format: precision not allowed for bool");
        if (string_form && (spec_.sign_given || spec_.alt || spec_.zero))
            throw format_error("format: invalid spec for bool string form");
        pc.advance_to(p);
        return p;
    }

    void format(bool value, __format::Ctx<CharT> &ctx) const
    {
        const int width = __format::EffectiveWidth(ctx, spec_);
        if (spec_.type == '\0' || spec_.type == 's') {
            if (spec_.localized) {
                // The words a locale can genuinely translate, and the one part
                // of a formatted bool that is not ASCII by construction.
                // The locale is held by value for the call: use_facet returns
                // a reference INTO the table it names, and locale() hands back
                // a temporary.
                const std::locale         loc = ctx.locale();
                const numpunct<CharT>    &np  = use_facet<numpunct<CharT>>(loc);
                const basic_string<CharT> w   = value ? np.truename() : np.falsename();
                __format::FormatString(ctx, spec_, width, -1,
                                       basic_string_view<CharT>(w));
                return;
            }
            // "true"/"false" are spelt once, in ASCII, and widened on the way
            // out. A wide duplicate of the two words would be a second place
            // for them to disagree.
            __format::FormatString(ctx, spec_, width, -1,
                                   value ? string_view("true")
                                         : string_view("false"));
        } else {
            __format::FormatIntCore(ctx, spec_, width, false,
                                    value ? 1ull : 0ull, spec_.type);
        }
    }
};

// Character arguments. Two specializations, one body: [format.formatter.spec]
// enables formatter<charT, charT> for both character types AND
// formatter<char, wchar_t> — a char is spellable in a wide alphabet, which is
// why the pair is asymmetric and why the value type C is a parameter here
// while every use of it goes through the same three presentations.
namespace __format {

template <class C, class CharT> struct CharFormatter {
    StdSpec<CharT> spec_;

    constexpr typename basic_format_parse_context<CharT>::iterator
    parse(basic_format_parse_context<CharT> &pc)
    {
        const CharT *p = ParseSpec(pc, spec_);
        const char   t = spec_.type;
        if (!(t == '\0' || t == 'c' || t == '?' || t == 'b' || t == 'B' ||
              t == 'd' || t == 'o' || t == 'x' || t == 'X'))
            throw format_error("format: invalid type for char");
        if (spec_.precision >= 0 || spec_.prec_dynamic)
            throw format_error("format: precision not allowed for char");
        // [format.string.std]: sign/#/0 are only valid for the integer and
        // floating-point presentation types. The default presentation for a
        // char argument is 'c' ([tab:format.type.char] — "none: same as c"),
        // so '\0' belongs in this guard exactly as much as 'c' does; leaving
        // it out would make {:#} succeed while {:#c} throws.
        const bool char_form = (t == '\0' || t == 'c' || t == '?');
        if (char_form && (spec_.sign_given || spec_.alt || spec_.zero))
            throw format_error("format: invalid spec for char");
        pc.advance_to(p);
        return p;
    }

    constexpr void set_debug_format() noexcept { spec_.type = '?'; }

    void format(C value, Ctx<CharT> &ctx) const
    {
        // The one conversion in this class, and the whole reason C and CharT
        // are separate parameters. It runs through the UNSIGNED value: a char
        // is signed here, so '\xD0' is -48, and a plain widening cast would
        // make wchar_t(-48) out of a byte the rest of the system reads as
        // U+00D0. libc++ answers U+00D0 for format(L"{}", '\xD0') — measured,
        // not assumed — and it is also the only answer consistent with
        // WriteRun, which widens every ASCII run the same way. For C == CharT
        // the round trip is the identity.
        const CharT wide = CharT(static_cast<make_unsigned_t<C>>(value));
        const int   width = EffectiveWidth(ctx, spec_);
        if (spec_.type == '\0' || spec_.type == 'c') {
            FormatCharCore(ctx, spec_, width, wide);
        } else if (spec_.type == '?') {
            basic_string<CharT> escaped;
            EscapeChar(escaped, wide);
            FormatString(ctx, spec_, width, -1,
                         basic_string_view<CharT>(escaped.data(),
                                                  escaped.size()));
        } else {
            // P2909R4: a character formatted with an integer presentation is a
            // CODE UNIT, so it widens through the unsigned version of its own
            // type — format("{:d}", char(-1)) is 255. The same rule read on
            // wchar_t gives 128512 for U+1F600, which is what both reference
            // libraries print.
            FormatIntCore(ctx, spec_, width, false,
                          (unsigned long long)static_cast<make_unsigned_t<C>>(
                              value),
                          spec_.type);
        }
    }
};

} // namespace __format

template <class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<char, CharT> : __format::CharFormatter<char, CharT> {};

template <>
struct formatter<wchar_t, wchar_t>
    : __format::CharFormatter<wchar_t, wchar_t> {};

namespace __format {

// [format.formatter.spec]/2.4 asks for a formatter for "each cv-unqualified
// floating-point type", and since Ф40 that phrase covers eight types on this
// toolchain, not three. Two groups, for one reason: this engine renders
// through to_chars, and to_chars has overloads for exactly float, double and
// long double.
template <class T>
concept CoreFloat =
    is_same_v<T, float> || is_same_v<T, double> || is_same_v<T, long double>;

// The narrow extended types render through the standard type whose format
// contains theirs, which is exact and not an approximation: _Float32 IS
// binary32, _Float64 IS binary64, and _Float16/__bf16 widen into binary64
// without losing a bit. float128_t is deliberately NOT here -- writing 113
// significand bits in decimal needs a converter this library does not have
// yet, and claiming the formatter while narrowing to long double would print
// a number the caller never had. libstdc++ 16.1 refuses the same call for the
// same reason (measured); recorded in CONFORMANCE §2.
template <class T> struct FmtVia {
    using type = void;
};
#if defined(__STDCPP_FLOAT16_T__)
template <> struct FmtVia<_Float16> {
    using type = double;
};
#endif
#if defined(__STDCPP_BFLOAT16_T__)
template <> struct FmtVia<__bf16> {
    using type = double;
};
#endif
#if defined(__STDCPP_FLOAT32_T__)
template <> struct FmtVia<_Float32> {
    using type = float;
};
#endif
#if defined(__STDCPP_FLOAT64_T__)
template <> struct FmtVia<_Float64> {
    using type = double;
};
#endif

} // namespace __format

// floating-point (float / double / long double). is_floating_point_v ignores
// cv by definition, but [format.formatter.spec]/2.4 provides formatters only
// for cv-unqualified floating-point types — hence the second conjunct.
template <class T, class CharT>
    requires __format::CoreFloat<T> && is_same_v<T, remove_cv_t<T>> &&
             __format::FmtCharT<CharT>
struct formatter<T, CharT> {
    __format::StdSpec<CharT> spec_;

    constexpr typename basic_format_parse_context<CharT>::iterator
    parse(basic_format_parse_context<CharT> &pc)
    {
        const CharT *p = __format::ParseSpec(pc, spec_);
        const char   t = spec_.type;
        if (!(t == '\0' || t == 'a' || t == 'A' || t == 'e' || t == 'E' ||
              t == 'f' || t == 'F' || t == 'g' || t == 'G'))
            throw format_error("format: invalid type for floating-point");
        pc.advance_to(p);
        return p;
    }

    void format(T value, __format::Ctx<CharT> &ctx) const
    {
        const int width = __format::EffectiveWidth(ctx, spec_);
        const int prec  = __format::EffectivePrecision(ctx, spec_);
        __format::FormatFloatCore<T>(ctx, spec_, width, prec, value,
                                     spec_.type);
    }
};

// The narrow extended floating-point types: same spec grammar, same output,
// one conversion in front of it.
template <class T, class CharT>
    requires(!is_void_v<typename __format::FmtVia<T>::type>) &&
            is_same_v<T, remove_cv_t<T>> && __format::FmtCharT<CharT>
struct formatter<T, CharT>
    : formatter<typename __format::FmtVia<T>::type, CharT> {
    void format(T value, __format::Ctx<CharT> &ctx) const
    {
        using V = typename __format::FmtVia<T>::type;
        formatter<V, CharT>::format(static_cast<V>(value), ctx);
    }
};

namespace __format {

// Shared parse for the string-like formatters: type must be \0, 's' or '?';
// precision is allowed (truncation); sign/#/0 are not. set_debug_format()
// lives here too, so all four string-like formatters share one definition.
template <class CharT> struct StringSpecParser {
    StdSpec<CharT> spec_;
    constexpr typename basic_format_parse_context<CharT>::iterator
    parse(basic_format_parse_context<CharT> &pc)
    {
        const CharT *p = ParseSpec(pc, spec_);
        if (!(spec_.type == '\0' || spec_.type == 's' || spec_.type == '?'))
            throw format_error("format: invalid type for string");
        // sign/#/0/L are all parsed generically by ParseSpec (for the
        // benefit of the numeric/bool/char formatters) but none of them is
        // ever valid for a string, '?' or not -- [format.string.std] gives
        // strings no L position at all, pre-existing gap now closed
        // alongside the '?' work since one new test (mirroring both
        // reference libraries) exposed it.
        if (spec_.sign_given || spec_.alt || spec_.zero || spec_.localized)
            throw format_error("format: invalid spec for string");
        pc.advance_to(p);
        return p;
    }
    constexpr void set_debug_format() noexcept { spec_.type = '?'; }

    // The body all five string-like formatters share. It was written out five
    // times when there was one character type; at two it would have been ten,
    // and ten copies of a rule about when to escape is nine chances for them
    // to stop agreeing.
    void EmitText(basic_string_view<CharT> sv, Ctx<CharT> &ctx) const
    {
        const int width = EffectiveWidth(ctx, spec_);
        const int prec  = EffectivePrecision(ctx, spec_);
        if (spec_.type == '?') {
            basic_string<CharT> escaped;
            EscapeInto(escaped, sv);
            FormatString(ctx, spec_, width, prec,
                         basic_string_view<CharT>(escaped.data(),
                                                  escaped.size()));
        } else {
            FormatString(ctx, spec_, width, prec, sv);
        }
    }
};

} // namespace __format

// [format.formatter.spec]/2.2 asks for PARTIAL specializations over traits and
// Allocator, not full ones for string/string_view. The difference is not
// academic: with only the full specializations a basic_string<char, MyTraits,
// MyAlloc> matches neither, falls through to the range catch-all in
// <__bits/format_range>, and prints `['a', 'b', 'c']` — width honoured, so the
// output looks deliberate rather than broken — while `{:?}` on it is rejected
// outright with "'?' is only allowed in combination with 's'". Traits only
// govern comparison and search, never the bytes, so both formatters read the
// characters through a plain string_view and the odd-traits string formats
// exactly like a std::string.
// Partial ordering, not the constraint, is what keeps these ahead of the range
// catch-all: `basic_string<char, Traits, Alloc>` can be deduced from an
// arbitrary R while an arbitrary R cannot be deduced from it, so these are more
// specialized outright and no ambiguity arises.
template <class CharT, class Traits, class Alloc>
    requires __format::FmtCharT<CharT>
struct formatter<basic_string<CharT, Traits, Alloc>, CharT>
    : __format::StringSpecParser<CharT> {
    void format(const basic_string<CharT, Traits, Alloc> &v,
                __format::Ctx<CharT> &ctx) const
    {
        this->EmitText(basic_string_view<CharT>(v.data(), v.size()), ctx);
    }
};
template <class CharT, class Traits>
    requires __format::FmtCharT<CharT>
struct formatter<basic_string_view<CharT, Traits>, CharT>
    : __format::StringSpecParser<CharT> {
    void format(basic_string_view<CharT, Traits> v,
                __format::Ctx<CharT> &ctx) const
    {
        this->EmitText(basic_string_view<CharT>(v.data(), v.size()), ctx);
    }
};

// ‼ A string whose character type is NOT the context's is an ERROR, and
// saying so out loud takes a specialization of its own. Without these two, a
// basic_string<char> handed to format(L"…") matches no enabled formatter,
// falls through to <__bits/format_range>'s catch-all — a string IS a range of
// characters, and formattable<char, wchar_t> is true — and prints
// ['h', 'i']. That is not a hypothetical: libc++ 22 does exactly that, and
// format(L"{}", "abc") there yields ['a', 'b', 'c', '\u{0}'] with the NUL
// included. libstdc++ 16.1 rejects the same call, and this is the same defect
// class Ф31e-a already closed on the narrow side, where an odd-traits string
// was being bracketed for the same reason. Rejecting is the answer both
// times: bracketing produces output that looks deliberate.
template <class C, class CharT, class Traits, class Alloc>
    requires __format::FmtCharT<CharT> && (!is_same_v<C, CharT>)
struct formatter<basic_string<C, Traits, Alloc>, CharT> {
    formatter()                             = delete;
    formatter(const formatter &)            = delete;
    formatter &operator=(const formatter &) = delete;
};
template <class C, class CharT, class Traits>
    requires __format::FmtCharT<CharT> && (!is_same_v<C, CharT>)
struct formatter<basic_string_view<C, Traits>, CharT> {
    formatter()                             = delete;
    formatter(const formatter &)            = delete;
    formatter &operator=(const formatter &) = delete;
};

template <class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<const CharT *, CharT> : __format::StringSpecParser<CharT> {
    void format(const CharT *v, __format::Ctx<CharT> &ctx) const
    {
        if (!v) throw format_error("format: null C-string");
        this->EmitText(basic_string_view<CharT>(v), ctx);
    }
};
template <class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<CharT *, CharT> : __format::StringSpecParser<CharT> {
    void format(const CharT *v, __format::Ctx<CharT> &ctx) const
    {
        if (!v) throw format_error("format: null C-string");
        this->EmitText(basic_string_view<CharT>(v), ctx);
    }
};

// [format.formatter.spec]/2.2 requires formatter<charT[N], charT> among the
// enabled string specializations. The engine itself never routes through it —
// an array argument decays to const char* before reaching make_format_args —
// so it exists for direct use and, more importantly, so std::formattable is
// true for char[N] (the range formatters constrain on that concept).
//
// The standard does not say what the "string" of a charT[N] is, and the two
// reference implementations disagree: libstdc++ formats all N characters
// (emitting a trailing NUL for a string literal), libc++ stops at the first
// NUL and has undefined behaviour when there is none. boxcxx stops at the
// first NUL and falls back to the whole array when there is none: that keeps
// a literal's output identical whether it decayed or not, and leaves no
// input undefined.
template <class CharT, size_t N>
    requires __format::FmtCharT<CharT>
struct formatter<CharT[N], CharT> : __format::StringSpecParser<CharT> {
    void format(const CharT (&v)[N], __format::Ctx<CharT> &ctx) const
    {
        size_t n = 0;
        while (n < N && v[n] != CharT('\0')) ++n;
        this->EmitText(basic_string_view<CharT>(v, n), ctx);
    }
};

// pointer
namespace __format {
template <class CharT>
inline void FormatPointer(Ctx<CharT> &ctx, const StdSpec<CharT> &spec,
                          int width, const void *p, bool upper)
{
    char digits[2 * sizeof(void *) + 1];
    auto r  = to_chars(digits, digits + sizeof(digits),
                       (unsigned long long)(uintptr_t)p, 16);
    int  dl = int(r.ptr - digits);
    if (upper)
        for (int i = 0; i < dl; ++i) digits[i] = ToUpperAscii(digits[i]);
    char sp[2] = {'0', upper ? 'X' : 'x'};
    EmitField(ctx, spec, width, string_view(sp, 2), string_view(digits, dl),
              Align::Right, /*numeric=*/true);
}
} // namespace __format

template <class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<const void *, CharT> {
    __format::StdSpec<CharT> spec_;
    constexpr typename basic_format_parse_context<CharT>::iterator
    parse(basic_format_parse_context<CharT> &pc)
    {
        const CharT *p = __format::ParseSpec(pc, spec_);
        if (!(spec_.type == '\0' || spec_.type == 'p' || spec_.type == 'P'))
            throw format_error("format: invalid type for pointer");
        // The pointer std-format-spec gained a '0' position with P2510R3
        // (both reference libraries implement it), but still has no sign, no
        // '#', no precision and no 'L'. EmitField already places the zeros
        // between the "0x" prefix and the digits and already ignores '0' when
        // an explicit align is present, so nothing else is needed here.
        if (spec_.precision >= 0 || spec_.prec_dynamic || spec_.sign_given ||
            spec_.alt || spec_.localized)
            throw format_error("format: invalid spec for pointer");
        pc.advance_to(p);
        return p;
    }
    void format(const void *v, __format::Ctx<CharT> &ctx) const
    {
        __format::FormatPointer(ctx, spec_, __format::EffectiveWidth(ctx, spec_),
                                v, spec_.type == 'P');
    }
};
template <class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<void *, CharT> : formatter<const void *, CharT> {
    void format(void *v, __format::Ctx<CharT> &ctx) const
    {
        formatter<const void *, CharT>::format(v, ctx);
    }
};
template <class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<nullptr_t, CharT> : formatter<const void *, CharT> {
    void format(nullptr_t, __format::Ctx<CharT> &ctx) const
    {
        formatter<const void *, CharT>::format(nullptr, ctx);
    }
};

