//  argument store + make_format_args
// ════════════════════════════════════════════════════════════════════════
namespace __format {

template <class T, class Context>
void FmtThunk(basic_format_parse_context<char> &pc, Context &fc, const void *p)
{
    using U = remove_cvref_t<T>;
    formatter<U, char> f;
    pc.advance_to(f.parse(pc));
    f.format(*static_cast<const U *>(p), fc);
}

} // namespace __format

template <class Context>
template <class T>
basic_format_arg<Context> basic_format_arg<Context>::__make(T &v)
{
    using K          = __format::ArgKind;
    constexpr K kind = __format::MapKind<T>();
    basic_format_arg a;
    a.kind_ = kind;
    if constexpr (kind == K::Bool) a.v_.b = v;
    else if constexpr (kind == K::Char) a.v_.c = v;
    else if constexpr (kind == K::Int) a.v_.i = int(v);
    else if constexpr (kind == K::UInt) a.v_.u = (unsigned)v;
    else if constexpr (kind == K::LongLong) a.v_.ll = (long long)v;
    else if constexpr (kind == K::ULongLong) a.v_.ull = (unsigned long long)v;
    else if constexpr (kind == K::Float) a.v_.f = float(v);
    else if constexpr (kind == K::Double) a.v_.d = double(v);
    else if constexpr (kind == K::LongDouble) a.v_.ld = (long double)v;
    else if constexpr (kind == K::CString) a.v_.cs = v;  // array/ptr decays
    else if constexpr (kind == K::SVString) a.v_.sv = string_view(v);
    else if constexpr (kind == K::Pointer) {
        if constexpr (is_same_v<remove_cvref_t<T>, nullptr_t>)
            a.v_.pv = nullptr;
        else a.v_.pv = static_cast<const void *>(v);
    } else {
        static_assert(
            is_default_constructible_v<formatter<remove_cvref_t<T>, char>>,
            "the type does not have an enabled std::formatter specialization");
        a.h_.ptr_ = __builtin_addressof(v);
        a.h_.fmt_ = &__format::FmtThunk<T, Context>;
    }
    return a;
}

template <class Context = format_context, class... Ts>
__format_store<Context, Ts...> make_format_args(Ts &...vs)
{
    return {{basic_format_arg<Context>::template __make<Ts>(vs)...}};
}

// ════════════════════════════════════════════════════════════════════════
//  the formatting engine + entry points
// ════════════════════════════════════════════════════════════════════════
namespace __format {

[[noreturn]] inline void Fail(const char *m) { throw format_error(m); }

inline void DoVformat(OutputSink &sink, string_view fmt, format_args args)
{
    format_parse_context pc(fmt, args.__count());
    format_context       fc(SinkIterator(sink), args);

    const char *p   = fmt.data();
    const char *e   = p + fmt.size();
    const char *lit = p;
    auto flush = [&](const char *upto) {
        if (upto > lit) sink.Append(lit, size_t(upto - lit));
    };

    while (p != e) {
        const char c = *p;
        if (c == '{') {
            if (p + 1 != e && p[1] == '{') {
                flush(p);
                sink.Append('{');
                p += 2;
                lit = p;
                continue;
            }
            flush(p);
            ++p;  // past '{'
            pc.advance_to(p);
            size_t id;
            if (p != e && IsDigit(*p)) {
                id = ParseNumber(p, e);
                pc.advance_to(p);
                pc.check_arg_id(id);
            } else {
                id = pc.next_arg_id();
            }
            if (p == e) Fail("format: unmatched '{'");
            if (*p == ':') {
                ++p;
                pc.advance_to(p);
            } else if (*p == '}') {
                pc.advance_to(p);
            } else {
                Fail("format: invalid replacement field");
            }
            basic_format_arg<format_context> a = args.get(id);
            a.__format_to(pc, fc);
            p = pc.begin();
            if (p == e || *p != '}') Fail("format: expected '}'");
            ++p;
            lit = p;
        } else if (c == '}') {
            if (p + 1 != e && p[1] == '}') {
                flush(p);
                sink.Append('}');
                p += 2;
                lit = p;
                continue;
            }
            Fail("format: unmatched '}'");
        } else {
            ++p;
        }
    }
    flush(e);
}

struct StringSink final : OutputSink {
    string str;
    void   Append(char c) override { str.push_back(c); }
    void   Append(const char *s, size_t n) override { str.append(s, n); }
};
struct CountingSink final : OutputSink {
    size_t count = 0;
    void   Append(char) override { ++count; }
    void   Append(const char *, size_t n) override { count += n; }
};
template <class Out> struct IteratorSink final : OutputSink {
    Out it;
    explicit IteratorSink(Out o) : it(std::move(o)) {}
    void Append(char c) override { *it = c; ++it; }
    void Append(const char *s, size_t n) override
    {
        for (size_t i = 0; i < n; ++i) { *it = s[i]; ++it; }
    }
};
template <class Out> struct TruncatingSink final : OutputSink {
    Out       it;
    ptrdiff_t left;
    ptrdiff_t total = 0;
    TruncatingSink(Out o, ptrdiff_t n) : it(std::move(o)), left(n) {}
    void Append(char c) override
    {
        if (left > 0) { *it = c; ++it; --left; }
        ++total;
    }
    void Append(const char *s, size_t n) override
    {
        for (size_t i = 0; i < n; ++i) Append(s[i]);
    }
};

} // namespace __format

inline string vformat(string_view fmt, format_args args)
{
    __format::StringSink sink;
    __format::DoVformat(sink, fmt, args);
    return std::move(sink.str);
}

template <class Out> Out vformat_to(Out out, string_view fmt, format_args args)
{
    __format::IteratorSink<Out> sink(std::move(out));
    __format::DoVformat(sink, fmt, args);
    return std::move(sink.it);
}

// ── basic_format_string + compile-time check ([format.fmt.string]) ──────
namespace __format {

template <class T>
constexpr const char *CheckParse(format_parse_context &pc)
{
    using D  = decay_t<T>;  // char[N]/char* validate as const char*
    using FT = conditional_t<is_same_v<D, char *> || is_same_v<D, const char *>,
                             const char *, remove_cvref_t<T>>;
    formatter<FT, char> f;
    return f.parse(pc);
}

// consteval validation mirroring the runtime engine, but parse-only and with
// the argument type known statically per field.
template <class... Args> consteval void CheckScan(string_view fmt)
{
    constexpr size_t N = sizeof...(Args);
    ArgKind          kinds[N == 0 ? 1 : N] = {MapKind<Args>()...};
    using ParseFn                          = const char *(*)(format_parse_context &);
    ParseFn table[N == 0 ? 1 : N] = {&CheckParse<Args>...};

    format_parse_context pc(fmt, N);
    pc.__set_kinds(kinds, N);

    const char *p = fmt.data();
    const char *e = p + fmt.size();
    while (p != e) {
        const char c = *p;
        if (c == '{') {
            if (p + 1 != e && p[1] == '{') { p += 2; continue; }
            ++p;
            pc.advance_to(p);
            size_t id;
            if (p != e && IsDigit(*p)) {
                id = ParseNumber(p, e);
                pc.advance_to(p);
                pc.check_arg_id(id);
            } else {
                id = pc.next_arg_id();
            }
            if (p == e) throw format_error("format: unmatched '{'");
            if (*p == ':') { ++p; pc.advance_to(p); }
            else if (*p == '}') { pc.advance_to(p); }
            else throw format_error("format: invalid replacement field");
            if (id >= N) throw format_error("format: argument index out of range");
            const char *q = table[id](pc);
            pc.advance_to(q);
            p = q;
            if (p == e || *p != '}') throw format_error("format: expected '}'");
            ++p;
        } else if (c == '}') {
            if (p + 1 != e && p[1] == '}') { p += 2; continue; }
            throw format_error("format: unmatched '}'");
        } else {
            ++p;
        }
    }
}

} // namespace __format

template <class CharT, class... Args> class basic_format_string;

template <class... Args> class basic_format_string<char, Args...> {
public:
    template <class T>
        requires is_convertible_v<const T &, string_view>
    consteval basic_format_string(const T &s) : str_(s)
    {
        __format::CheckScan<Args...>(str_);
    }

    constexpr string_view get() const noexcept { return str_; }

private:
    string_view str_;
};

template <class... Args>
using format_string = basic_format_string<char, type_identity_t<Args>...>;

// ── format / format_to / format_to_n / formatted_size ───────────────────
template <class... Args>
string format(format_string<Args...> fmt, Args &&...args)
{
    return vformat(fmt.get(), make_format_args(args...));
}

template <class Out, class... Args>
Out format_to(Out out, format_string<Args...> fmt, Args &&...args)
{
    return vformat_to(std::move(out), fmt.get(), make_format_args(args...));
}

template <class Out> struct format_to_n_result {
    Out       out;
    ptrdiff_t size;
};

template <class Out, class... Args>
format_to_n_result<Out> format_to_n(Out out, ptrdiff_t n,
                                    format_string<Args...> fmt, Args &&...args)
{
    __format::TruncatingSink<Out> sink(std::move(out), n);
    __format::DoVformat(sink, fmt.get(), make_format_args(args...));
    return {std::move(sink.it), sink.total};
}

template <class... Args>
size_t formatted_size(format_string<Args...> fmt, Args &&...args)
{
    __format::CountingSink sink;
    __format::DoVformat(sink, fmt.get(), make_format_args(args...));
    return sink.count;
}

