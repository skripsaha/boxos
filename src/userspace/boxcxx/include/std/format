// ── basic_format_string + compile-time check ([format.fmt.string]) ──────
namespace __format {

template <class T, class CharT>
constexpr const CharT *CheckParse(basic_format_parse_context<CharT> &pc)
{
    using D = decay_t<T>;  // CharT[N]/CharT* validate as const CharT*
    using FT =
        conditional_t<is_same_v<D, CharT *> || is_same_v<D, const CharT *>,
                      const CharT *, remove_cvref_t<T>>;
    formatter<FT, CharT> f;
    return f.parse(pc);
}

// consteval validation mirroring the runtime engine, but parse-only and with
// the argument type known statically per field.
template <class CharT, class... Args>
consteval void CheckScan(basic_string_view<CharT> fmt)
{
    constexpr size_t N = sizeof...(Args);
    ArgKind          kinds[N == 0 ? 1 : N] = {MapKind<Args, CharT>()...};
    using ParseFn = const CharT *(*)(basic_format_parse_context<CharT> &);
    ParseFn table[N == 0 ? 1 : N] = {&CheckParse<Args, CharT>...};

    basic_format_parse_context<CharT> pc(fmt, N);
    pc.__set_kinds(kinds, N);

    const CharT *p = fmt.data();
    const CharT *e = p + fmt.size();
    while (p != e) {
        const CharT c = *p;
        if (c == CharT('{')) {
            if (p + 1 != e && p[1] == CharT('{')) { p += 2; continue; }
            ++p;
            pc.advance_to(p);
            size_t id;
            if (p != e && IsDigit(*p)) {
                id = ParseNumber(p, e);
                pc.advance_to(p);
                pc.check_arg_id(id);
            } else {
                id = pc.next_arg_id();
            }
            if (p == e) throw format_error("format: unmatched '{'");
            if (*p == CharT(':')) { ++p; pc.advance_to(p); }
            else if (*p == CharT('}')) { pc.advance_to(p); }
            else throw format_error("format: invalid replacement field");
            if (id >= N) throw format_error("format: argument index out of range");
            const CharT *q = table[id](pc);
            pc.advance_to(q);
            p = q;
            if (p == e || *p != CharT('}')) throw format_error("format: expected '}'");
            ++p;
        } else if (c == CharT('}')) {
            if (p + 1 != e && p[1] == CharT('}')) { p += 2; continue; }
            throw format_error("format: unmatched '}'");
        } else {
            ++p;
        }
    }
}

} // namespace __format

template <class CharT, class... Args> class basic_format_string;

template <class CharT, class... Args>
    requires __format::FmtCharT<CharT>
class basic_format_string<CharT, Args...> {
public:
    template <class T>
        requires is_convertible_v<const T &, basic_string_view<CharT>>
    consteval basic_format_string(const T &s) : str_(s)
    {
        __format::CheckScan<CharT, Args...>(str_);
    }

    constexpr basic_string_view<CharT> get() const noexcept { return str_; }

private:
    basic_string_view<CharT> str_;
};

template <class... Args>
using format_string = basic_format_string<char, type_identity_t<Args>...>;
template <class... Args>
using wformat_string = basic_format_string<wchar_t, type_identity_t<Args>...>;

// ── format / format_to / format_to_n / formatted_size ───────────────────
// The narrow and wide entry points are OVERLOADS, not one template over the
// character type: what selects between them is the format string's own type,
// which the consteval constructor already fixed at the call site. A caller
// never spells the character type, and never has to.
template <class... Args>
string format(format_string<Args...> fmt, Args &&...args)
{
    return vformat(fmt.get(), make_format_args(args...));
}
template <class... Args>
wstring format(wformat_string<Args...> fmt, Args &&...args)
{
    return vformat(fmt.get(), make_wformat_args(args...));
}

template <class Out, class... Args>
Out format_to(Out out, format_string<Args...> fmt, Args &&...args)
{
    return vformat_to(std::move(out), fmt.get(), make_format_args(args...));
}
template <class Out, class... Args>
Out format_to(Out out, wformat_string<Args...> fmt, Args &&...args)
{
    return vformat_to(std::move(out), fmt.get(), make_wformat_args(args...));
}

template <class Out> struct format_to_n_result {
    Out       out;
    ptrdiff_t size;
};

template <class Out, class... Args>
format_to_n_result<Out> format_to_n(Out out, ptrdiff_t n,
                                    format_string<Args...> fmt, Args &&...args)
{
    __format::TruncatingSink<char, Out> sink(std::move(out), n);
    __format::DoVformat<char>(sink, fmt.get(), make_format_args(args...));
    return {std::move(sink.it), sink.total};
}
template <class Out, class... Args>
format_to_n_result<Out> format_to_n(Out out, ptrdiff_t n,
                                    wformat_string<Args...> fmt, Args &&...args)
{
    __format::TruncatingSink<wchar_t, Out> sink(std::move(out), n);
    __format::DoVformat<wchar_t>(sink, fmt.get(), make_wformat_args(args...));
    return {std::move(sink.it), sink.total};
}

template <class... Args>
size_t formatted_size(format_string<Args...> fmt, Args &&...args)
{
    __format::CountingSink<char> sink;
    __format::DoVformat<char>(sink, fmt.get(), make_format_args(args...));
    return sink.count;
}
template <class... Args>
size_t formatted_size(wformat_string<Args...> fmt, Args &&...args)
{
    __format::CountingSink<wchar_t> sink;
    __format::DoVformat<wchar_t>(sink, fmt.get(), make_wformat_args(args...));
    return sink.count;
}

