// boxcxx — <format>  (Ф9B-1: the C++23 formatting library core)
//
// std::format / format_to / format_to_n / formatted_size / vformat[_to],
// the std-spec parser ([[fill]align][sign][#][0][width][.precision][L][type]
// with nested {} dynamic width/precision), formatter<T> for the scalar and
// string types, the type-erased argument machinery (basic_format_arg / args /
// context), and the C++23 consteval format-string check (basic_format_string).
//
// Numbers are formatted through <charconv> to_chars — that is exactly why
// <charconv> (Ф9A) landed first. There is no dependency on the kernel: the
// console sink (std::print) and <iostream> arrive in Ф9B-2 / Ф9B-3.
//
// Deliberate scope (single char type; documented in CONFORMANCE):
//   * char only — no wchar_t / wformat_context (wide streams are excluded).
//   * the `L` (localized) flag is accepted and ignored — "C" locale only.
//   * the `?` (debug/escaped) presentation is not yet provided; it needs
//     Unicode printability tables that clash with the no-locale posture.
//   * field width is measured in code units (ASCII); no Unicode grapheme /
//     East-Asian-width estimation.
//   * range / tuple formatting (formatter<vector<T>> &c.) is a later phase.
#ifndef BOXCXX_FORMAT
#define BOXCXX_FORMAT

#include <__bits/core_traits>  // __bits::IsAnyOf
#include <charconv>
#include <cstddef>
#include <cstdint>
#include <iterator>  // output_iterator_tag
#include <limits>
#include <stdexcept>  // runtime_error (base of format_error)
#include <string>
#include <string_view>
#include <type_traits>
#include <utility>

namespace std {

// ── format_error ([format.error]) ───────────────────────────────────────
// Key function (the destructor) is out-of-line in src/runtime/format.cpp so
// the vtable and typeinfo are emitted exactly once — catch-by-base across
// translation units relies on a single typeinfo, same scheme as the other
// boxcxx exception types.
class format_error : public runtime_error {
public:
    explicit format_error(const string &what_arg) : runtime_error(what_arg) {}
    explicit format_error(const char *what_arg) : runtime_error(what_arg) {}
    ~format_error() override;
};

// Forward declarations needed to break the arg/args/context cycle.
template <class T, class CharT = char> struct formatter;
template <class Context> class basic_format_arg;
template <class Context> class basic_format_args;
class format_context;
using format_args = basic_format_args<format_context>;

// ════════════════════════════════════════════════════════════════════════
//  Internal: spec model + low-level helpers (namespace __format)
// ════════════════════════════════════════════════════════════════════════
namespace __format {

enum class ArgKind : unsigned char {
    None,
    Bool,
    Char,
    Int,
    UInt,
    LongLong,
    ULongLong,
    Float,
    Double,
    LongDouble,
    CString,
    SVString,
    Pointer,
    Custom,
};

enum class Align : unsigned char { Default, Left, Right, Center };
enum class Sign : unsigned char { Minus, Plus, Space };

// Empty tag visited for a valueless argument (std::visit_format_arg). Kept
// local so <format> need not pull in <variant>'s std::monostate.
struct monostate_tag {};

// Parsed standard format specification.
struct StdSpec {
    char   fill          = ' ';
    Align  align         = Align::Default;
    Sign   sign          = Sign::Minus;
    bool   alt           = false;  // '#'
    bool   zero          = false;  // '0'
    int    width         = -1;     // -1 == absent
    size_t width_id      = 0;
    bool   width_dynamic = false;
    int    precision     = -1;     // -1 == absent
    size_t prec_id       = 0;
    bool   prec_dynamic  = false;
    bool   localized     = false;  // 'L' — accepted, ignored
    char   type          = '\0';   // '\0' == default
};

constexpr bool IsAlignChar(char c) noexcept
{
    return c == '<' || c == '>' || c == '^';
}
constexpr Align AlignOf(char c) noexcept
{
    return c == '<' ? Align::Left : c == '>' ? Align::Right : Align::Center;
}
constexpr bool IsDigit(char c) noexcept { return c >= '0' && c <= '9'; }
constexpr char ToUpperAscii(char c) noexcept
{
    return (c >= 'a' && c <= 'z') ? char(c - 'a' + 'A') : c;
}

inline constexpr int kIntMax = 2147483647;

// Parse a base-10 unsigned number at *p (which must start on a digit),
// advancing p past it. Overflow past INT_MAX throws.
constexpr size_t ParseNumber(const char *&p, const char *e)
{
    size_t v = 0;
    while (p != e && IsDigit(*p)) {
        v = v * 10 + size_t(*p - '0');
        if (v > size_t(kIntMax)) throw format_error("format: number too large");
        ++p;
    }
    return v;
}

// Which standard integer types get the integer formatter (not bool / char,
// which have their own presentation defaults).
template <class T>
inline constexpr bool IsStdInt =
    __bits::IsAnyOf<remove_cv_t<T>, signed char, unsigned char, short,
                    unsigned short, int, unsigned int, long, unsigned long,
                    long long, unsigned long long>;

// Map a (decayed) argument type to its erased kind. Shared by the argument
// store and the compile-time checker so they always agree.
template <class T> constexpr ArgKind MapKind() noexcept
{
    using U = decay_t<T>;  // arrays/functions decay; char[N] → const char*
    if constexpr (is_same_v<U, bool>) return ArgKind::Bool;
    else if constexpr (is_same_v<U, char>) return ArgKind::Char;
    else if constexpr (IsStdInt<U>) {
        if constexpr (is_signed_v<U>)
            return sizeof(U) <= sizeof(int) ? ArgKind::Int : ArgKind::LongLong;
        else
            return sizeof(U) <= sizeof(unsigned) ? ArgKind::UInt
                                                 : ArgKind::ULongLong;
    } else if constexpr (is_same_v<U, float>) return ArgKind::Float;
    else if constexpr (is_same_v<U, double>) return ArgKind::Double;
    else if constexpr (is_same_v<U, long double>) return ArgKind::LongDouble;
    else if constexpr (is_same_v<U, nullptr_t>) return ArgKind::Pointer;
    else if constexpr (is_pointer_v<U>) {
        using P = remove_cv_t<remove_pointer_t<U>>;
        if constexpr (is_same_v<P, char>) return ArgKind::CString;
        else if constexpr (is_same_v<P, void>) return ArgKind::Pointer;
        else return ArgKind::Custom;
    } else if constexpr (is_same_v<U, string> || is_same_v<U, string_view>)
        return ArgKind::SVString;
    else return ArgKind::Custom;
}

constexpr bool KindIsIntegral(ArgKind k) noexcept
{
    return k == ArgKind::Int || k == ArgKind::UInt || k == ArgKind::LongLong ||
           k == ArgKind::ULongLong;
}

} // namespace __format

// ── basic_format_parse_context ([format.parse.ctx]) ─────────────────────
template <class CharT> class basic_format_parse_context {
public:
    using char_type      = CharT;
    using const_iterator = const CharT *;
    using iterator       = const_iterator;

    constexpr explicit basic_format_parse_context(basic_string_view<CharT> fmt,
                                                  size_t num_args = 0) noexcept
        : begin_(fmt.data()), end_(fmt.data() + fmt.size()), num_args_(num_args)
    {
    }
    basic_format_parse_context(const basic_format_parse_context &) = delete;
    basic_format_parse_context &
    operator=(const basic_format_parse_context &) = delete;

    constexpr const_iterator begin() const noexcept { return begin_; }
    constexpr const_iterator end() const noexcept { return end_; }
    constexpr void advance_to(const_iterator it) noexcept { begin_ = it; }

    constexpr size_t next_arg_id()
    {
        if (indexing_ == Manual)
            throw format_error("format: mixing of automatic and manual "
                               "argument indexing");
        indexing_ = Auto;
        if (next_ >= num_args_)
            throw format_error("format: argument index out of range");
        return next_++;
    }
    constexpr void check_arg_id(size_t id)
    {
        if (indexing_ == Auto)
            throw format_error("format: mixing of automatic and manual "
                               "argument indexing");
        indexing_ = Manual;
        if (id >= num_args_)
            throw format_error("format: argument index out of range");
    }

    // C++23 dynamic-spec validation. At runtime (no type table) these are
    // range checks only; the compile-time checker installs the table so the
    // width/precision argument's type is verified to be integral.
    constexpr void check_dynamic_spec_integral(size_t id)
    {
        if (kinds_) {
            if (id >= num_kinds_)
                throw format_error("format: argument index out of range");
            if (!__format::KindIsIntegral(kinds_[id]))
                throw format_error(
                    "format: width/precision argument is not an integer type");
        }
    }

    // Internal hook used by the consteval checker.
    constexpr void __set_kinds(const __format::ArgKind *k, size_t n) noexcept
    {
        kinds_     = k;
        num_kinds_ = n;
    }

private:
    enum Indexing { Unknown, Auto, Manual };
    const CharT            *begin_;
    const CharT            *end_;
    size_t                  num_args_  = 0;
    size_t                  next_      = 0;
    Indexing                indexing_  = Unknown;
    const __format::ArgKind *kinds_    = nullptr;
    size_t                  num_kinds_ = 0;
};

using format_parse_context = basic_format_parse_context<char>;

// ── the spec parser ─────────────────────────────────────────────────────
namespace __format {

// Parse a nested replacement field used for dynamic width/precision: '{'
// already consumed by the caller is NOT the contract — p must point AT '{'.
// Returns the resolved argument id and advances p past the closing '}'.
constexpr size_t ParseDynamicArgId(format_parse_context &pc, const char *&p,
                                   const char *e)
{
    ++p;  // past '{'
    size_t id;
    if (p != e && *p == '}') {
        id = pc.next_arg_id();
    } else if (p != e && IsDigit(*p)) {
        id = ParseNumber(p, e);
        pc.check_arg_id(id);
        if (p == e || *p != '}')
            throw format_error("format: invalid dynamic field");
    } else {
        throw format_error("format: invalid dynamic field");
    }
    ++p;  // past '}'
    return id;
}

// Parse the full standard spec from pc.begin()..pc.end() into s, resolving
// any dynamic width/precision against pc. Returns the iterator at the '}'
// that closes the replacement field (or wherever parsing stopped — the
// caller verifies a '}' follows).
constexpr const char *ParseSpec(format_parse_context &pc, StdSpec &s)
{
    const char *p = pc.begin();
    const char *e = pc.end();
    if (p == e || *p == '}') return p;

    // [fill]align — fill is any char but '{'/'}' and must be followed by an
    // alignment character.
    if (p + 1 < e && IsAlignChar(p[1]) && *p != '{' && *p != '}') {
        s.fill  = *p;
        s.align = AlignOf(p[1]);
        p += 2;
    } else if (p != e && IsAlignChar(*p)) {
        s.align = AlignOf(*p);
        ++p;
    }

    // sign
    if (p != e) {
        if (*p == '+') { s.sign = Sign::Plus; ++p; }
        else if (*p == '-') { s.sign = Sign::Minus; ++p; }
        else if (*p == ' ') { s.sign = Sign::Space; ++p; }
    }
    // '#'
    if (p != e && *p == '#') { s.alt = true; ++p; }
    // '0' — zero pad (only meaningful for numeric types; flagged here, the
    // formatter ignores it when an explicit alignment was given)
    if (p != e && *p == '0') { s.zero = true; ++p; }
    // width
    if (p != e && IsDigit(*p)) {  // leading 0 already eaten as the flag
        s.width = int(ParseNumber(p, e));
    } else if (p != e && *p == '{') {
        s.width_id      = ParseDynamicArgId(pc, p, e);
        s.width_dynamic = true;
        pc.check_dynamic_spec_integral(s.width_id);
    }
    // precision
    if (p != e && *p == '.') {
        ++p;
        if (p != e && IsDigit(*p)) {
            s.precision = int(ParseNumber(p, e));
        } else if (p != e && *p == '{') {
            s.prec_id      = ParseDynamicArgId(pc, p, e);
            s.prec_dynamic = true;
            pc.check_dynamic_spec_integral(s.prec_id);
        } else {
            throw format_error("format: missing precision after '.'");
        }
    }
    // 'L'
    if (p != e && *p == 'L') { s.localized = true; ++p; }
    // type
    if (p != e && *p != '}') { s.type = *p; ++p; }
    return p;
}

} // namespace __format

// ── basic_format_arg ([format.arg]) ─────────────────────────────────────
template <class Context> class basic_format_arg {
public:
    class handle {
    public:
        void format(basic_format_parse_context<char> &pc, Context &fc) const
        {
            fmt_(pc, fc, ptr_);
        }

    private:
        friend class basic_format_arg;
        const void *ptr_ = nullptr;
        void (*fmt_)(basic_format_parse_context<char> &, Context &,
                     const void *) = nullptr;
    };

    basic_format_arg() noexcept : kind_(__format::ArgKind::None), v_{} {}

    explicit operator bool() const noexcept
    {
        return kind_ != __format::ArgKind::None;
    }

    __format::ArgKind __kind() const noexcept { return kind_; }

    // Run the matching formatter: parse the spec (leaving pc.begin() at the
    // closing '}') then format the stored value into fc.
    void __format_to(basic_format_parse_context<char> &pc, Context &fc) const;

    // Coerce an integer-kind argument to long long (for dynamic width /
    // precision). Throws if the stored value is not an integer type.
    long long __as_integer() const
    {
        switch (kind_) {
        case __format::ArgKind::Int: return v_.i;
        case __format::ArgKind::UInt: return v_.u;
        case __format::ArgKind::LongLong: return v_.ll;
        case __format::ArgKind::ULongLong:
            if (v_.ull > (unsigned long long)__format::kIntMax)
                throw format_error("format: width/precision out of range");
            return (long long)v_.ull;
        default:
            throw format_error(
                "format: width/precision argument is not an integer type");
        }
    }

    // Visitation support for std::visit_format_arg.
    template <class Visitor>
    decltype(auto) __visit(Visitor &&vis) const;

    // Build the erased argument for a value of (deduced) type T. A static
    // member so it can touch the private storage without a friend dance.
    template <class T> static basic_format_arg __make(T &v);

private:
    __format::ArgKind kind_;
    union Storage {
        char               nul;
        bool               b;
        char               c;
        int                i;
        unsigned           u;
        long long          ll;
        unsigned long long ull;
        float              f;
        double             d;
        long double        ld;
        const char        *cs;
        string_view        sv;
        const void        *pv;
        constexpr Storage() noexcept : nul(0) {}
    } v_;
    handle h_{};
};

// ── basic_format_args ([format.args]) ───────────────────────────────────
template <class Context, class... Ts> struct __format_store {
    static constexpr size_t kN = sizeof...(Ts) == 0 ? 1 : sizeof...(Ts);
    basic_format_arg<Context> data[kN];
};

template <class Context> class basic_format_args {
public:
    basic_format_args() noexcept = default;

    template <class... Ts>
    basic_format_args(const __format_store<Context, Ts...> &store) noexcept
        : size_(sizeof...(Ts)), data_(store.data)
    {
    }

    basic_format_arg<Context> get(size_t i) const noexcept
    {
        return i < size_ ? data_[i] : basic_format_arg<Context>{};
    }
    size_t __count() const noexcept { return size_; }

private:
    size_t                           size_ = 0;
    const basic_format_arg<Context> *data_ = nullptr;
};

// ── format_context ([format.context]) ───────────────────────────────────
namespace __format {

// Type-erased output sink. format() / format_to / formatted_size /
// format_to_n all funnel through one of these so the engine stays non-generic.
struct OutputSink {
    virtual void Append(char c)                = 0;
    virtual void Append(const char *s, size_t n) = 0;

protected:
    ~OutputSink() = default;
};

// The single output-iterator type seen by formatters via ctx.out().
class SinkIterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type        = void;
    using difference_type    = ptrdiff_t;
    using pointer           = void;
    using reference         = void;

    SinkIterator() noexcept = default;
    explicit SinkIterator(OutputSink &s) noexcept : sink_(&s) {}

    SinkIterator &operator=(char c)
    {
        sink_->Append(c);
        return *this;
    }
    SinkIterator &operator*() noexcept { return *this; }
    SinkIterator &operator++() noexcept { return *this; }
    SinkIterator  operator++(int) noexcept { return *this; }

    OutputSink *__sink() const noexcept { return sink_; }

private:
    OutputSink *sink_ = nullptr;
};

} // namespace __format

class format_context {
public:
    using iterator  = __format::SinkIterator;
    using char_type = char;
    template <class T> using formatter_type = formatter<T, char>;

    iterator out() noexcept { return out_; }
    void     advance_to(iterator it) noexcept { out_ = it; }
    basic_format_arg<format_context> arg(size_t id) const noexcept
    {
        return args_.get(id);
    }

    // Internal constructor used by the engine.
    format_context(iterator out, format_args args) noexcept
        : out_(out), args_(args)
    {
    }

private:
    iterator    out_;
    format_args args_;
};

// ════════════════════════════════════════════════════════════════════════
//  Field emission helpers (need format_context complete)
// ════════════════════════════════════════════════════════════════════════
namespace __format {

inline void WriteRun(format_context::iterator &out, const char *s, size_t n)
{
    out.__sink()->Append(s, n);
}
inline void WriteFill(format_context::iterator &out, char c, int n)
{
    for (int i = 0; i < n; ++i) out.__sink()->Append(c);
}

// Emit sign_prefix + body padded to `width` according to spec. `numeric`
// enables zero-padding (zeros inserted between sign_prefix and body) and
// selects the default alignment when none was requested.
inline void EmitField(format_context &ctx, const StdSpec &spec, int width,
                      string_view sign_prefix, string_view body, Align dflt,
                      bool numeric)
{
    auto      out  = ctx.out();
    const int core = int(sign_prefix.size() + body.size());

    if (width <= core) {
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteRun(out, body.data(), body.size());
        ctx.advance_to(out);
        return;
    }

    const int pad = width - core;
    if (spec.zero && spec.align == Align::Default && numeric) {
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteFill(out, '0', pad);
        WriteRun(out, body.data(), body.size());
        ctx.advance_to(out);
        return;
    }

    const Align a    = spec.align == Align::Default ? dflt : spec.align;
    const char  fill = spec.fill;
    if (a == Align::Left) {
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteRun(out, body.data(), body.size());
        WriteFill(out, fill, pad);
    } else if (a == Align::Right) {
        WriteFill(out, fill, pad);
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteRun(out, body.data(), body.size());
    } else {  // center — extra unit on the right when odd
        const int l = pad / 2, r = pad - l;
        WriteFill(out, fill, l);
        WriteRun(out, sign_prefix.data(), sign_prefix.size());
        WriteRun(out, body.data(), body.size());
        WriteFill(out, fill, r);
    }
    ctx.advance_to(out);
}

// Format an integer magnitude. `type` is one of \0/d/b/B/o/x/X.
inline void FormatIntCore(format_context &ctx, const StdSpec &spec, int width,
                          bool negative, unsigned long long mag, char type)
{
    int         base   = 10;
    const char *prefix = "";
    bool        upper  = false;
    switch (type) {
    case '\0':
    case 'd': base = 10; break;
    case 'b': base = 2; prefix = spec.alt ? "0b" : ""; break;
    case 'B': base = 2; prefix = spec.alt ? "0B" : ""; break;
    case 'o': base = 8; prefix = (spec.alt && mag != 0) ? "0" : ""; break;
    case 'x': base = 16; prefix = spec.alt ? "0x" : ""; break;
    case 'X': base = 16; prefix = spec.alt ? "0X" : ""; upper = true; break;
    }

    char digits[66];
    auto r  = to_chars(digits, digits + sizeof(digits), mag, base);
    int  dl = int(r.ptr - digits);
    if (upper)
        for (int i = 0; i < dl; ++i) digits[i] = ToUpperAscii(digits[i]);

    char sp[4];
    int  spn = 0;
    if (negative) sp[spn++] = '-';
    else if (spec.sign == Sign::Plus) sp[spn++] = '+';
    else if (spec.sign == Sign::Space) sp[spn++] = ' ';
    for (const char *q = prefix; *q; ++q) sp[spn++] = *q;

    EmitField(ctx, spec, width, string_view(sp, spn), string_view(digits, dl),
              Align::Right, /*numeric=*/true);
}

inline void FormatCharCore(format_context &ctx, const StdSpec &spec, int width,
                           char c)
{
    EmitField(ctx, spec, width, string_view(), string_view(&c, 1), Align::Left,
              /*numeric=*/false);
}

inline void FormatString(format_context &ctx, const StdSpec &spec, int width,
                         int precision, string_view s)
{
    if (precision >= 0 && size_t(precision) < s.size())
        s = s.substr(0, size_t(precision));
    EmitField(ctx, spec, width, string_view(), s, Align::Left,
              /*numeric=*/false);
}

// Expand a stripped general result to P significant digits (defined below).
inline ptrdiff_t FmtGeneralAlt(char *buf, ptrdiff_t len, ptrdiff_t cap, int P);

// Floating-point. `type` ∈ \0/e/E/f/F/g/G/a/A; precision -1 means "absent".
template <class F>
void FormatFloatCore(format_context &ctx, const StdSpec &spec, int width,
                     int precision, F value, char type)
{
    const bool neg   = __builtin_signbit(value);
    const F    mag   = neg ? -value : value;
    const bool upper = type == 'E' || type == 'F' || type == 'G' || type == 'A';

    // A scratch big enough for the widest finite output: ~309 integer digits
    // for fixed DBL_MAX plus the requested precision plus decoration. `need`
    // is computed in size_t and cap/len are ptrdiff_t so a pathologically
    // large precision (near INT_MAX) cannot overflow into a tiny buffer and
    // silently truncate — it either allocates or throws from resize().
    char      stackbuf[512];
    string    heapbuf;
    char     *buf = stackbuf;
    ptrdiff_t cap = ptrdiff_t(sizeof(stackbuf));
    size_t base = 340;
    if constexpr (is_same_v<F, long double>)
        if (type == 'f' || type == 'F')
            base = size_t(numeric_limits<F>::max_exponent10) + 34;  // 4932+34
    const size_t need = base + (precision > 0 ? size_t(precision) : size_t(0));
    if (need > size_t(cap)) {
        heapbuf.resize(need);  // throws bad_alloc/length_error if absurd
        buf = heapbuf.data();
        cap = ptrdiff_t(need);
    }

    const bool general_like =
        type == 'g' || type == 'G' || (type == '\0' && precision >= 0);

    to_chars_result r{};
    if (type == '\0' && precision < 0) {
        r = to_chars(buf, buf + cap, mag);  // shortest round-trip
    } else if (general_like) {
        int p = precision < 0 ? 6 : precision;
        if (p == 0) p = 1;
        r = to_chars(buf, buf + cap, mag, chars_format::general, p);
    } else if (type == 'f' || type == 'F') {
        r = to_chars(buf, buf + cap, mag, chars_format::fixed,
                     precision < 0 ? 6 : precision);
    } else if (type == 'e' || type == 'E') {
        r = to_chars(buf, buf + cap, mag, chars_format::scientific,
                     precision < 0 ? 6 : precision);
    } else {  // 'a' / 'A'
        if (precision < 0)
            r = to_chars(buf, buf + cap, mag, chars_format::hex);
        else
            r = to_chars(buf, buf + cap, mag, chars_format::hex, precision);
    }

    ptrdiff_t  len    = r.ptr - buf;
    const bool finite = !(len > 0 && (buf[0] == 'i' || buf[0] == 'n'));

    // '#': always ensure a decimal point. Additionally, only the *explicit*
    // 'g'/'G' presentation keeps trailing zeros to the significant-digit
    // count; the default presentation (no type) just adds the point — so
    // {:#.2} of 0 is "0." while {:#.2g} of 0 is "0.0" (matches libstdc++).
    if (spec.alt && finite) {
        if (type == 'g' || type == 'G') {
            len = FmtGeneralAlt(buf, len, cap, precision < 0 ? 6 : precision);
        } else {
            bool      has_dot = false;
            ptrdiff_t marker  = len;  // index of 'e'/'p', else len
            for (ptrdiff_t i = 0; i < len; ++i) {
                if (buf[i] == '.') { has_dot = true; break; }
                if (buf[i] == 'e' || buf[i] == 'p') { marker = i; break; }
            }
            if (!has_dot && len + 1 <= cap) {
                for (ptrdiff_t i = len; i > marker; --i) buf[i] = buf[i - 1];
                buf[marker] = '.';
                ++len;
            }
        }
    }

    if (upper)
        for (ptrdiff_t i = 0; i < len; ++i) buf[i] = ToUpperAscii(buf[i]);

    // The 'a'/'A' presentation delegates to to_chars(hex), which (per the
    // standard) emits no "0x" prefix — unlike printf %a.
    char sp[2];
    int  spn = 0;
    if (neg) sp[spn++] = '-';
    else if (spec.sign == Sign::Plus) sp[spn++] = '+';
    else if (spec.sign == Sign::Space) sp[spn++] = ' ';

    EmitField(ctx, spec, width, string_view(sp, spn), string_view(buf, len),
              Align::Right, /*numeric=*/finite);
}

// Expand a stripped general result back to `P` significant digits (the '#'
// alternate form keeps trailing zeros). Operates in place on [buf,buf+len);
// returns the new length. Assumes a finite, non-negative magnitude token.
inline ptrdiff_t FmtGeneralAlt(char *buf, ptrdiff_t len, ptrdiff_t cap, int P)
{
    if (P <= 0) P = 1;
    // Locate exponent marker and the mantissa span.
    ptrdiff_t epos = len;
    for (ptrdiff_t i = 0; i < len; ++i)
        if (buf[i] == 'e') { epos = i; break; }
    // Count significant digits in [0,epos): all digits, but leading zeros of
    // a pure-fraction (0.00ddd) do not count.
    ptrdiff_t dot = -1;
    for (ptrdiff_t i = 0; i < epos; ++i)
        if (buf[i] == '.') { dot = i; break; }
    ptrdiff_t sig          = 0;
    bool      seen_nonzero = false;
    for (ptrdiff_t i = 0; i < epos; ++i) {
        char ch = buf[i];
        if (ch == '.') continue;
        if (ch != '0') seen_nonzero = true;
        if (seen_nonzero) ++sig;
    }
    if (sig == 0) sig = 1;  // value is exactly 0 → one significant digit
    ptrdiff_t add = ptrdiff_t(P) - sig;
    if (add <= 0) {
        // already P sig digits; just guarantee a decimal point
        if (dot < 0 && epos <= len) {
            if (len + 1 <= cap) {
                for (ptrdiff_t i = len; i > epos; --i) buf[i] = buf[i - 1];
                buf[epos] = '.';
                ++len;
                ++epos;
            }
        }
        return len;
    }
    // Need to insert a '.' (if missing) and `add` zeros right before epos.
    ptrdiff_t insert_at = epos;
    ptrdiff_t extra     = add + (dot < 0 ? 1 : 0);
    if (len + extra > cap) extra = cap - len;  // clamp (shouldn't happen)
    for (ptrdiff_t i = len + extra - 1; i >= insert_at + extra; --i)
        buf[i] = buf[i - extra];
    ptrdiff_t w = insert_at;
    if (dot < 0) buf[w++] = '.';
    for (ptrdiff_t i = 0; i < add && w < insert_at + extra; ++i) buf[w++] = '0';
    return len + extra;
}

