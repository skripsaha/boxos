// Primary template — disabled (a program that formats an unsupported type
// fails because the formatter is not constructible).
template <class T, class CharT> struct formatter {
    formatter()                             = delete;
    formatter(const formatter &)            = delete;
    formatter &operator=(const formatter &) = delete;
};

namespace __format {

// Resolve dynamic width/precision against the format context.
inline int ResolveDynamic(format_context &ctx, size_t id)
{
    const long long v = ctx.arg(id).__as_integer();
    if (v < 0) throw format_error("format: negative width/precision");
    if (v > kIntMax) throw format_error("format: width/precision out of range");
    return int(v);
}
inline int EffectiveWidth(format_context &ctx, const StdSpec &s)
{
    return s.width_dynamic ? ResolveDynamic(ctx, s.width_id) : s.width;
}
inline int EffectivePrecision(format_context &ctx, const StdSpec &s)
{
    return s.prec_dynamic ? ResolveDynamic(ctx, s.prec_id) : s.precision;
}

constexpr bool IsIntType(char t) noexcept
{
    return t == '\0' || t == 'b' || t == 'B' || t == 'c' || t == 'd' ||
           t == 'o' || t == 'x' || t == 'X';
}

} // namespace __format

// Integer types (signed char .. unsigned long long, excluding bool/char).
template <class T>
    requires __format::IsStdInt<T>
struct formatter<T, char> {
    __format::StdSpec spec_;

    constexpr typename format_parse_context::iterator
    parse(format_parse_context &pc)
    {
        const char *p = __format::ParseSpec(pc, spec_);
        if (!__format::IsIntType(spec_.type))
            throw format_error("format: invalid type for integer");
        if (spec_.precision >= 0 || spec_.prec_dynamic)
            throw format_error("format: precision not allowed for integer");
        // sign/#/0 with the 'c' presentation are accepted and ignored
        // (matches the character-output path, which drops them).
        pc.advance_to(p);
        return p;
    }

    void format(T value, format_context &ctx) const
    {
        const int width = __format::EffectiveWidth(ctx, spec_);
        if (spec_.type == 'c') {
            if (cmp_less(value, int(numeric_limits<char>::min())) ||
                cmp_greater(value, int(numeric_limits<char>::max())))
                throw format_error("format: integer not in char range");
            __format::FormatCharCore(ctx, spec_, width, char(value));
            return;
        }
        bool               neg = false;
        unsigned long long mag;
        if constexpr (is_signed_v<T>) {
            if (value < 0) {
                neg = true;
                // |value| must be taken in T's own (narrower) unsigned width
                // first — negating after widening to u64 loses the wrap for
                // e.g. int -42 (would give 2^64-42, not 42).
                using UT = make_unsigned_t<T>;
                mag      = static_cast<unsigned long long>(
                    static_cast<UT>(UT(0) - static_cast<UT>(value)));
            } else {
                mag = (unsigned long long)value;
            }
        } else {
            mag = (unsigned long long)value;
        }
        __format::FormatIntCore(ctx, spec_, width, neg, mag, spec_.type);
    }
};

// bool
template <> struct formatter<bool, char> {
    __format::StdSpec spec_;

    constexpr typename format_parse_context::iterator
    parse(format_parse_context &pc)
    {
        const char *p = __format::ParseSpec(pc, spec_);
        const char  t = spec_.type;
        const bool  string_form = (t == '\0' || t == 's');
        // bool does NOT accept the 'c' presentation (unlike int/char).
        if (!(string_form || t == 'b' || t == 'B' || t == 'd' || t == 'o' ||
              t == 'x' || t == 'X'))
            throw format_error("format: invalid type for bool");
        if (spec_.precision >= 0 || spec_.prec_dynamic)
            throw format_error("format: precision not allowed for bool");
        if (string_form && (spec_.sign != __format::Sign::Minus || spec_.alt ||
                            spec_.zero))
            throw format_error("format: invalid spec for bool string form");
        pc.advance_to(p);
        return p;
    }

    void format(bool value, format_context &ctx) const
    {
        const int width = __format::EffectiveWidth(ctx, spec_);
        if (spec_.type == '\0' || spec_.type == 's') {
            __format::FormatString(ctx, spec_, width, -1,
                                   value ? string_view("true")
                                         : string_view("false"));
        } else {
            __format::FormatIntCore(ctx, spec_, width, false,
                                    value ? 1ull : 0ull, spec_.type);
        }
    }
};

// char
template <> struct formatter<char, char> {
    __format::StdSpec spec_;

    constexpr typename format_parse_context::iterator
    parse(format_parse_context &pc)
    {
        const char *p = __format::ParseSpec(pc, spec_);
        const char  t = spec_.type;
        if (!(t == '\0' || t == 'c' || t == 'b' || t == 'B' || t == 'd' ||
              t == 'o' || t == 'x' || t == 'X'))
            throw format_error("format: invalid type for char");
        if (spec_.precision >= 0 || spec_.prec_dynamic)
            throw format_error("format: precision not allowed for char");
        // sign/#/0 are ignored for the 'c' presentation (dropped on output).
        pc.advance_to(p);
        return p;
    }

    void format(char value, format_context &ctx) const
    {
        const int width = __format::EffectiveWidth(ctx, spec_);
        if (spec_.type == '\0' || spec_.type == 'c')
            __format::FormatCharCore(ctx, spec_, width, value);
        else
            __format::FormatIntCore(ctx, spec_, width, false,
                                    (unsigned long long)(unsigned char)value,
                                    spec_.type);
    }
};

// floating-point (float / double / long double)
template <class T>
    requires is_floating_point_v<T>
struct formatter<T, char> {
    __format::StdSpec spec_;

    constexpr typename format_parse_context::iterator
    parse(format_parse_context &pc)
    {
        const char *p = __format::ParseSpec(pc, spec_);
        const char  t = spec_.type;
        if (!(t == '\0' || t == 'a' || t == 'A' || t == 'e' || t == 'E' ||
              t == 'f' || t == 'F' || t == 'g' || t == 'G'))
            throw format_error("format: invalid type for floating-point");
        pc.advance_to(p);
        return p;
    }

    void format(T value, format_context &ctx) const
    {
        const int width = __format::EffectiveWidth(ctx, spec_);
        const int prec  = __format::EffectivePrecision(ctx, spec_);
        __format::FormatFloatCore<T>(ctx, spec_, width, prec, value,
                                     spec_.type);
    }
};

namespace __format {

// Shared parse for the string-like formatters: type must be \0 or 's';
// precision is allowed (truncation); sign/#/0 are not.
struct StringSpecParser {
    StdSpec spec_;
    constexpr typename format_parse_context::iterator
    parse(format_parse_context &pc)
    {
        const char *p = ParseSpec(pc, spec_);
        if (!(spec_.type == '\0' || spec_.type == 's'))
            throw format_error("format: invalid type for string");
        if (spec_.sign != Sign::Minus || spec_.alt || spec_.zero)
            throw format_error("format: invalid spec for string");
        pc.advance_to(p);
        return p;
    }
};

} // namespace __format

template <> struct formatter<string_view, char> : __format::StringSpecParser {
    void format(string_view v, format_context &ctx) const
    {
        __format::FormatString(ctx, spec_, __format::EffectiveWidth(ctx, spec_),
                               __format::EffectivePrecision(ctx, spec_), v);
    }
};
template <> struct formatter<string, char> : __format::StringSpecParser {
    void format(const string &v, format_context &ctx) const
    {
        __format::FormatString(ctx, spec_, __format::EffectiveWidth(ctx, spec_),
                               __format::EffectivePrecision(ctx, spec_),
                               string_view(v.data(), v.size()));
    }
};
template <> struct formatter<const char *, char> : __format::StringSpecParser {
    void format(const char *v, format_context &ctx) const
    {
        if (!v) throw format_error("format: null C-string");
        __format::FormatString(ctx, spec_, __format::EffectiveWidth(ctx, spec_),
                               __format::EffectivePrecision(ctx, spec_),
                               string_view(v));
    }
};
template <> struct formatter<char *, char> : __format::StringSpecParser {
    void format(const char *v, format_context &ctx) const
    {
        if (!v) throw format_error("format: null C-string");
        __format::FormatString(ctx, spec_, __format::EffectiveWidth(ctx, spec_),
                               __format::EffectivePrecision(ctx, spec_),
                               string_view(v));
    }
};

// char[N] string literals decay to const char* before reaching make_format_args.

// pointer
namespace __format {
inline void FormatPointer(format_context &ctx, const StdSpec &spec, int width,
                          const void *p, bool upper)
{
    char digits[2 * sizeof(void *) + 1];
    auto r  = to_chars(digits, digits + sizeof(digits),
                       (unsigned long long)(uintptr_t)p, 16);
    int  dl = int(r.ptr - digits);
    if (upper)
        for (int i = 0; i < dl; ++i) digits[i] = ToUpperAscii(digits[i]);
    char sp[2] = {'0', upper ? 'X' : 'x'};
    EmitField(ctx, spec, width, string_view(sp, 2), string_view(digits, dl),
              Align::Right, /*numeric=*/true);
}
} // namespace __format

template <> struct formatter<const void *, char> {
    __format::StdSpec spec_;
    constexpr typename format_parse_context::iterator
    parse(format_parse_context &pc)
    {
        const char *p = __format::ParseSpec(pc, spec_);
        if (!(spec_.type == '\0' || spec_.type == 'p' || spec_.type == 'P'))
            throw format_error("format: invalid type for pointer");
        if (spec_.precision >= 0 || spec_.prec_dynamic ||
            spec_.sign != __format::Sign::Minus || spec_.alt || spec_.zero)
            throw format_error("format: invalid spec for pointer");
        pc.advance_to(p);
        return p;
    }
    void format(const void *v, format_context &ctx) const
    {
        __format::FormatPointer(ctx, spec_, __format::EffectiveWidth(ctx, spec_),
                                v, spec_.type == 'P');
    }
};
template <> struct formatter<void *, char> : formatter<const void *, char> {
    void format(void *v, format_context &ctx) const
    {
        formatter<const void *, char>::format(v, ctx);
    }
};
template <> struct formatter<nullptr_t, char> : formatter<const void *, char> {
    void format(nullptr_t, format_context &ctx) const
    {
        formatter<const void *, char>::format(nullptr, ctx);
    }
};

// ════════════════════════════════════════════════════════════════════════
//  basic_format_arg out-of-line members (need formatters complete)
// ════════════════════════════════════════════════════════════════════════
template <class Context>
void basic_format_arg<Context>::__format_to(
    basic_format_parse_context<char> &pc, Context &fc) const
{
    using K = __format::ArgKind;
    switch (kind_) {
    case K::Bool: {
        formatter<bool, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.b, fc);
        break;
    }
    case K::Char: {
        formatter<char, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.c, fc);
        break;
    }
    case K::Int: {
        formatter<int, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.i, fc);
        break;
    }
    case K::UInt: {
        formatter<unsigned, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.u, fc);
        break;
    }
    case K::LongLong: {
        formatter<long long, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.ll, fc);
        break;
    }
    case K::ULongLong: {
        formatter<unsigned long long, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.ull, fc);
        break;
    }
    case K::Float: {
        formatter<float, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.f, fc);
        break;
    }
    case K::Double: {
        formatter<double, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.d, fc);
        break;
    }
    case K::LongDouble: {
        formatter<long double, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.ld, fc);
        break;
    }
    case K::CString: {
        formatter<const char *, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.cs, fc);
        break;
    }
    case K::SVString: {
        formatter<string_view, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.sv, fc);
        break;
    }
    case K::Pointer: {
        formatter<const void *, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.pv, fc);
        break;
    }
    case K::Custom:
        h_.format(pc, fc);
        break;
    case K::None:
        throw format_error("format: argument not found");
    }
}

template <class Context>
template <class Visitor>
decltype(auto) basic_format_arg<Context>::__visit(Visitor &&vis) const
{
    using K = __format::ArgKind;
    switch (kind_) {
    case K::Bool: return vis(v_.b);
    case K::Char: return vis(v_.c);
    case K::Int: return vis(v_.i);
    case K::UInt: return vis(v_.u);
    case K::LongLong: return vis(v_.ll);
    case K::ULongLong: return vis(v_.ull);
    case K::Float: return vis(v_.f);
    case K::Double: return vis(v_.d);
    case K::LongDouble: return vis(v_.ld);
    case K::CString: return vis(v_.cs);
    case K::SVString: return vis(v_.sv);
    case K::Pointer: return vis(v_.pv);
    case K::Custom: return vis(h_);
    case K::None: break;
    }
    return vis(__format::monostate_tag{});
}

// std::visit_format_arg ([format.arg]) — the valueless case visits an empty
// tag (we keep a local tag instead of pulling in <variant>'s monostate).
template <class Visitor, class Context>
decltype(auto) visit_format_arg(Visitor &&vis, basic_format_arg<Context> arg)
{
    return arg.__visit(static_cast<Visitor &&>(vis));
}

