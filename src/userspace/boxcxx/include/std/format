// ════════════════════════════════════════════════════════════════════════
//  basic_format_arg out-of-line members (need formatters complete)
// ════════════════════════════════════════════════════════════════════════
template <class Context>
void basic_format_arg<Context>::__format_to(
    basic_format_parse_context<char_type> &pc, Context &fc) const
{
    using K = __format::ArgKind;
    // One line per kind, because the only thing that differs between them is
    // which union member is live: the formatter type follows from it, and the
    // three-step parse/advance/format dance is the same for all fourteen. It
    // was written out fourteen times when there was one character type — with
    // two, the copies would have been the place where char and wchar_t
    // quietly stopped doing the same thing.
    const auto run = [&](const auto &value) {
        formatter<remove_cvref_t<decltype(value)>, char_type> f;
        pc.advance_to(f.parse(pc));
        f.format(value, fc);
    };
    switch (kind_) {
    case K::Bool: run(v_.b); break;
    case K::Char: run(v_.c); break;
    case K::Int: run(v_.i); break;
    case K::UInt: run(v_.u); break;
    case K::LongLong: run(v_.ll); break;
    case K::ULongLong: run(v_.ull); break;
    case K::Int128: run(v_.i128); break;
    case K::UInt128: run(v_.u128); break;
    case K::Float: run(v_.f); break;
    case K::Double: run(v_.d); break;
    case K::LongDouble: run(v_.ld); break;
    case K::CString: run(v_.cs); break;
    case K::SVString: run(v_.sv); break;
    case K::Pointer: run(v_.pv); break;
    case K::Custom: h_.format(pc, fc); break;
    case K::None: throw format_error("format: argument not found");
    }
}

template <class Context>
template <class Visitor>
decltype(auto) basic_format_arg<Context>::__visit(Visitor &&vis) const
{
    using K = __format::ArgKind;
    switch (kind_) {
    case K::Bool: return vis(v_.b);
    case K::Char: return vis(v_.c);
    case K::Int: return vis(v_.i);
    case K::UInt: return vis(v_.u);
    case K::LongLong: return vis(v_.ll);
    case K::ULongLong: return vis(v_.ull);
    case K::Int128: return vis(v_.i128);
    case K::UInt128: return vis(v_.u128);
    case K::Float: return vis(v_.f);
    case K::Double: return vis(v_.d);
    case K::LongDouble: return vis(v_.ld);
    case K::CString: return vis(v_.cs);
    case K::SVString: return vis(v_.sv);
    case K::Pointer: return vis(v_.pv);
    case K::Custom: return vis(h_);
    case K::None: break;
    }
    return vis(__format::monostate_tag{});
}

// std::visit_format_arg ([format.arg]) — the valueless case visits an empty
// tag (we keep a local tag instead of pulling in <variant>'s monostate).
template <class Visitor, class Context>
decltype(auto) visit_format_arg(Visitor &&vis, basic_format_arg<Context> arg)
{
    return arg.__visit(static_cast<Visitor &&>(vis));
}

