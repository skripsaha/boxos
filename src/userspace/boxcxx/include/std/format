        }
    }
};

// [format.formatter.spec]/2.2 requires formatter<charT[N], charT> among the
// enabled string specializations. The engine itself never routes through it —
// an array argument decays to const char* before reaching make_format_args —
// so it exists for direct use and, more importantly, so std::formattable is
// true for char[N] (the range formatters constrain on that concept).
//
// The standard does not say what the "string" of a charT[N] is, and the two
// reference implementations disagree: libstdc++ formats all N characters
// (emitting a trailing NUL for a string literal), libc++ stops at the first
// NUL and has undefined behaviour when there is none. boxcxx stops at the
// first NUL and falls back to the whole array when there is none: that keeps
// a literal's output identical whether it decayed or not, and leaves no
// input undefined.
template <size_t N> struct formatter<char[N], char>
    : __format::StringSpecParser {
    void format(const char (&v)[N], format_context &ctx) const
    {
        size_t n = 0;
        while (n < N && v[n] != '\0') ++n;
        const string_view sv(v, n);
        const int         width = __format::EffectiveWidth(ctx, spec_);
        const int         prec  = __format::EffectivePrecision(ctx, spec_);
        if (spec_.type == '?') {
            string escaped;
            __format::EscapeInto(escaped, sv);
            __format::FormatString(ctx, spec_, width, prec,
                                   string_view(escaped.data(), escaped.size()));
        } else {
            __format::FormatString(ctx, spec_, width, prec, sv);
        }
    }
};

// pointer
namespace __format {
inline void FormatPointer(format_context &ctx, const StdSpec &spec, int width,
                          const void *p, bool upper)
{
    char digits[2 * sizeof(void *) + 1];
    auto r  = to_chars(digits, digits + sizeof(digits),
                       (unsigned long long)(uintptr_t)p, 16);
    int  dl = int(r.ptr - digits);
    if (upper)
        for (int i = 0; i < dl; ++i) digits[i] = ToUpperAscii(digits[i]);
    char sp[2] = {'0', upper ? 'X' : 'x'};
    EmitField(ctx, spec, width, string_view(sp, 2), string_view(digits, dl),
              Align::Right, /*numeric=*/true);
}
} // namespace __format

template <> struct formatter<const void *, char> {
    __format::StdSpec spec_;
    constexpr typename format_parse_context::iterator
    parse(format_parse_context &pc)
    {
        const char *p = __format::ParseSpec(pc, spec_);
        if (!(spec_.type == '\0' || spec_.type == 'p' || spec_.type == 'P'))
            throw format_error("format: invalid type for pointer");
        // The pointer std-format-spec gained a '0' position with P2510R3
        // (both reference libraries implement it), but still has no sign, no
        // '#', no precision and no 'L'. EmitField already places the zeros
        // between the "0x" prefix and the digits and already ignores '0' when
        // an explicit align is present, so nothing else is needed here.
        if (spec_.precision >= 0 || spec_.prec_dynamic || spec_.sign_given ||
            spec_.alt || spec_.localized)
            throw format_error("format: invalid spec for pointer");
        pc.advance_to(p);
        return p;
    }
    void format(const void *v, format_context &ctx) const
    {
        __format::FormatPointer(ctx, spec_, __format::EffectiveWidth(ctx, spec_),
                                v, spec_.type == 'P');
    }
};
template <> struct formatter<void *, char> : formatter<const void *, char> {
    void format(void *v, format_context &ctx) const
    {
        formatter<const void *, char>::format(v, ctx);
    }
};
template <> struct formatter<nullptr_t, char> : formatter<const void *, char> {
    void format(nullptr_t, format_context &ctx) const
    {
        formatter<const void *, char>::format(nullptr, ctx);
    }
};

