//  basic_format_arg out-of-line members (need formatters complete)
// ════════════════════════════════════════════════════════════════════════
template <class Context>
void basic_format_arg<Context>::__format_to(
    basic_format_parse_context<char> &pc, Context &fc) const
{
    using K = __format::ArgKind;
    switch (kind_) {
    case K::Bool: {
        formatter<bool, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.b, fc);
        break;
    }
    case K::Char: {
        formatter<char, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.c, fc);
        break;
    }
    case K::Int: {
        formatter<int, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.i, fc);
        break;
    }
    case K::UInt: {
        formatter<unsigned, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.u, fc);
        break;
    }
    case K::LongLong: {
        formatter<long long, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.ll, fc);
        break;
    }
    case K::ULongLong: {
        formatter<unsigned long long, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.ull, fc);
        break;
    }
    case K::Int128: {
        formatter<__int128, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.i128, fc);
        break;
    }
    case K::UInt128: {
        formatter<unsigned __int128, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.u128, fc);
        break;
    }
    case K::Float: {
        formatter<float, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.f, fc);
        break;
    }
    case K::Double: {
        formatter<double, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.d, fc);
        break;
    }
    case K::LongDouble: {
        formatter<long double, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.ld, fc);
        break;
    }
    case K::CString: {
        formatter<const char *, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.cs, fc);
        break;
    }
    case K::SVString: {
        formatter<string_view, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.sv, fc);
        break;
    }
    case K::Pointer: {
        formatter<const void *, char> f;
        pc.advance_to(f.parse(pc));
        f.format(v_.pv, fc);
        break;
    }
    case K::Custom:
        h_.format(pc, fc);
        break;
    case K::None:
        throw format_error("format: argument not found");
    }
}

template <class Context>
template <class Visitor>
decltype(auto) basic_format_arg<Context>::__visit(Visitor &&vis) const
{
    using K = __format::ArgKind;
    switch (kind_) {
    case K::Bool: return vis(v_.b);
    case K::Char: return vis(v_.c);
    case K::Int: return vis(v_.i);
    case K::UInt: return vis(v_.u);
    case K::LongLong: return vis(v_.ll);
    case K::ULongLong: return vis(v_.ull);
    case K::Int128: return vis(v_.i128);
    case K::UInt128: return vis(v_.u128);
    case K::Float: return vis(v_.f);
    case K::Double: return vis(v_.d);
    case K::LongDouble: return vis(v_.ld);
    case K::CString: return vis(v_.cs);
    case K::SVString: return vis(v_.sv);
    case K::Pointer: return vis(v_.pv);
    case K::Custom: return vis(h_);
    case K::None: break;
    }
    return vis(__format::monostate_tag{});
}

// std::visit_format_arg ([format.arg]) — the valueless case visits an empty
// tag (we keep a local tag instead of pulling in <variant>'s monostate).
template <class Visitor, class Context>
decltype(auto) visit_format_arg(Visitor &&vis, basic_format_arg<Context> arg)
{
    return arg.__visit(static_cast<Visitor &&>(vis));
}

