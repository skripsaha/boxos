namespace __format {

// [format.formattable]'s formattable-with, adapted to boxcxx's one
// concrete context per character type (see std::formattable below for why:
// every boxcxx formatter names Ctx<CharT>& rather than being generic over
// the output iterator, so testing against the concrete type is what answers
// "will a real std::format call work" — the question boxcxx actually has).
template <class T, class CharT>
concept FormattableWith =
    FmtCharT<CharT> && semiregular<formatter<remove_const_t<T>, CharT>> &&
    requires(formatter<remove_const_t<T>, CharT> &f,
             const formatter<remove_const_t<T>, CharT> &cf,
             T &&t, Ctx<CharT> &fc, basic_format_parse_context<CharT> &pc) {
        {
            f.parse(pc)
        } -> same_as<typename basic_format_parse_context<CharT>::iterator>;
        cf.format(t, fc);
    };

// P2418R2: which constness of U's formatter parameter to target. Prefer
// const U (also lets a const object of U be formatted); fall back to
// plain U only when const U does not work (e.g. a mutating formatter like
// a caching peek()).
template <class U, class CharT>
using ThunkArgT = conditional_t<FormattableWith<const U, CharT>, const U, U>;

template <class TQ, class Context>
void FmtThunk(basic_format_parse_context<typename Context::char_type> &pc,
              Context &fc, const void *p)
{
    using Td = remove_const_t<TQ>;
    formatter<Td, typename Context::char_type> f;
    pc.advance_to(f.parse(pc));
    TQ &val = *const_cast<TQ *>(static_cast<const Td *>(p));
    f.format(val, fc);
}

} // namespace __format

// [format.formattable] — see __format::FormattableWith above for the two
// justified divergences from the standard's wording: a concrete Context
// instead of a generic one, and format()'s return type is unconstrained
// since every boxcxx formatter returns void and advances the context via
// ctx.advance_to() rather than by returning an iterator.
template <class T, class CharT>
concept formattable =
    __format::FormattableWith<remove_reference_t<T>, CharT>;

template <class Context>
template <class T>
basic_format_arg<Context> basic_format_arg<Context>::__make(T &v)
{
    using K          = __format::ArgKind;
    constexpr K kind = __format::MapKind<T, char_type>();
    basic_format_arg a;
    a.kind_ = kind;
    if constexpr (kind == K::Bool) a.v_.b = v;
    else if constexpr (kind == K::Char) {
        // [format.arg]/5: a char argument in a wide context is stored ALREADY
        // WIDENED, which is why the engine can reach for
        // formatter<char_type, char_type> and never needs to remember that the
        // caller wrote a char. Through the unsigned value, for the reason
        // spelt out in __format::CharFormatter::format.
        a.v_.c = char_type(
            static_cast<make_unsigned_t<remove_cvref_t<T>>>(v));
    }
    else if constexpr (kind == K::Int) a.v_.i = int(v);
    else if constexpr (kind == K::UInt) a.v_.u = (unsigned)v;
    else if constexpr (kind == K::LongLong) a.v_.ll = (long long)v;
    else if constexpr (kind == K::ULongLong) a.v_.ull = (unsigned long long)v;
    else if constexpr (kind == K::Int128) a.v_.i128 = (__int128)v;
    else if constexpr (kind == K::UInt128) a.v_.u128 = (unsigned __int128)v;
    else if constexpr (kind == K::Float) a.v_.f = float(v);
    else if constexpr (kind == K::Double) a.v_.d = double(v);
    else if constexpr (kind == K::LongDouble) a.v_.ld = (long double)v;
    else if constexpr (kind == K::CString) a.v_.cs = v;  // array/ptr decays
    else if constexpr (kind == K::SVString)
        a.v_.sv = basic_string_view<char_type>(v);
    else if constexpr (kind == K::Pointer) {
        if constexpr (is_same_v<remove_cvref_t<T>, nullptr_t>)
            a.v_.pv = nullptr;
        else a.v_.pv = static_cast<const void *>(v);
    } else {
        using U  = remove_cvref_t<T>;
        using TQ = __format::ThunkArgT<U, char_type>;
        // [format.arg]/5 constrains on T itself, NOT on remove_const_t<T>:
        // when the argument is const but its formatter's format() only takes
        // a non-const reference, ThunkArgT picks TQ = U and FmtThunk's
        // const_cast would then hand a genuinely const object to code that
        // mutates it (silent corruption, or a fault if it lives in .rodata).
        // Checking remove_reference_t<T> turns that into a clean diagnostic,
        // which is what both reference libraries emit.
        static_assert(__format::FormattableWith<remove_reference_t<T>, char_type>,
            "the type does not have an enabled std::formatter specialization "
            "for this context's character type (a const argument needs a "
            "formatter whose format() takes const)");
        a.h_.ptr_ = __builtin_addressof(v);
        a.h_.fmt_ = &__format::FmtThunk<TQ, Context>;
    }
    return a;
}

template <class Context = format_context, class... Ts>
__format_store<Context, Ts...> make_format_args(Ts &...vs)
{
    return {{basic_format_arg<Context>::template __make<Ts>(vs)...}};
}

// [format.arg.store] spells the wide entry point separately rather than
// leaving it to the default argument, and so does this.
template <class... Ts>
__format_store<wformat_context, Ts...> make_wformat_args(Ts &...vs)
{
    return {{basic_format_arg<wformat_context>::template __make<Ts>(vs)...}};
}

// ════════════════════════════════════════════════════════════════════════
//  the formatting engine + entry points
// ════════════════════════════════════════════════════════════════════════
namespace __format {

[[noreturn]] inline void Fail(const char *m) { throw format_error(m); }

template <class CharT>
inline void DoVformat(OutputSink<CharT> &sink, basic_string_view<CharT> fmt,
                      basic_format_args<Ctx<CharT>> args,
                      const std::locale *loc = nullptr)
{
    basic_format_parse_context<CharT> pc(fmt, args.__count());
    Ctx<CharT>                        fc(SinkIterator<CharT>(sink), args, loc);

    const CharT *p   = fmt.data();
    const CharT *e   = p + fmt.size();
    const CharT *lit = p;
    auto flush = [&](const CharT *upto) {
        if (upto > lit) sink.Append(lit, size_t(upto - lit));
    };

    while (p != e) {
        const CharT c = *p;
        if (c == CharT('{')) {
            if (p + 1 != e && p[1] == CharT('{')) {
                flush(p);
                sink.Append(CharT('{'));
                p += 2;
                lit = p;
                continue;
            }
            flush(p);
            ++p;  // past '{'
            pc.advance_to(p);
            size_t id;
            if (p != e && IsDigit(*p)) {
                id = ParseNumber(p, e);
                pc.advance_to(p);
                pc.check_arg_id(id);
            } else {
                id = pc.next_arg_id();
            }
            if (p == e) Fail("format: unmatched '{'");
            if (*p == CharT(':')) {
                ++p;
                pc.advance_to(p);
            } else if (*p == CharT('}')) {
                pc.advance_to(p);
            } else {
                Fail("format: invalid replacement field");
            }
            basic_format_arg<Ctx<CharT>> a = args.get(id);
            a.__format_to(pc, fc);
            p = pc.begin();
            if (p == e || *p != CharT('}')) Fail("format: expected '}'");
            ++p;
            lit = p;
        } else if (c == CharT('}')) {
            if (p + 1 != e && p[1] == CharT('}')) {
                flush(p);
                sink.Append(CharT('}'));
                p += 2;
                lit = p;
                continue;
            }
            Fail("format: unmatched '}'");
        } else {
            ++p;
        }
    }
    flush(e);
}

template <class CharT> struct StringSink final : OutputSink<CharT> {
    basic_string<CharT> str;
    void Append(CharT c) override { str.push_back(c); }
    void Append(const CharT *s, size_t n) override { str.append(s, n); }
};
template <class CharT> struct CountingSink final : OutputSink<CharT> {
    size_t count = 0;
    void   Append(CharT) override { ++count; }
    void   Append(const CharT *, size_t n) override { count += n; }
};
template <class CharT, class Out> struct IteratorSink final : OutputSink<CharT> {
    Out it;
    explicit IteratorSink(Out o) : it(std::move(o)) {}
    void Append(CharT c) override { *it = c; ++it; }
    void Append(const CharT *s, size_t n) override
    {
        for (size_t i = 0; i < n; ++i) { *it = s[i]; ++it; }
    }
};
template <class CharT, class Out> struct TruncatingSink final : OutputSink<CharT> {
    Out       it;
    ptrdiff_t left;
    ptrdiff_t total = 0;
    TruncatingSink(Out o, ptrdiff_t n) : it(std::move(o)), left(n) {}
    void Append(CharT c) override
    {
        if (left > 0) { *it = c; ++it; --left; }
        ++total;
    }
    void Append(const CharT *s, size_t n) override
    {
        for (size_t i = 0; i < n; ++i) Append(s[i]);
    }
};

