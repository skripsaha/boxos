// boxcxx — <barrier>
//
// std::barrier — a reusable phase barrier. Each phase `expected` arrivals
// drive the count to zero; the last arrival runs the completion function,
// resets the count, and advances the phase, which releases everyone waiting
// on that phase. wait() spins on __boxcxx_atomic_wait_cycle (WAITPKG
// UMONITOR/UMWAIT on the phase word, else PAUSE budget then yield) — the same
// substrate as atomic::wait; the phase store is the implicit wake.
//
// Flat single-word design rather than libstdc++'s scalability tree: correct
// and cheap for one-thread-per-cabin BoxOS, and strand-upgrade-ready (the
// spin becomes a kernel park, no signature change). arrive_and_drop lowers
// the expected arrivals for every subsequent phase.
#ifndef BOXCXX_BARRIER
#define BOXCXX_BARRIER

#include <atomic>
#include <cstddef>
#include <cstdint>
#include <utility>

namespace std {

namespace __barrier_impl {
struct EmptyCompletion {
    void operator()() noexcept {}
};
} // namespace __barrier_impl

template <typename CompletionFunction = __barrier_impl::EmptyCompletion>
class barrier {
public:
    using arrival_token = unsigned; // a snapshot of the phase at arrival

    static constexpr ptrdiff_t max() noexcept { return PTRDIFF_MAX; }

    explicit barrier(ptrdiff_t expected,
                     CompletionFunction f = CompletionFunction())
        : __expected(expected), __count(expected), __phase(0),
          __completion(std::move(f))
    {
    }

    barrier(const barrier &)            = delete;
    barrier &operator=(const barrier &) = delete;

    [[nodiscard]] arrival_token arrive(ptrdiff_t n = 1)
    {
        arrival_token phase = __phase.load(memory_order_relaxed);
        // fetch_sub returns the prior value; prior - n == 0 ⇒ we drained it.
        if (__count.fetch_sub(n, memory_order_acq_rel) - n == 0)
            Complete(phase);
        return phase;
    }

    void wait(arrival_token &&token) const
    {
        unsigned spin = 0;
        while (__phase.load(memory_order_acquire) == token)
            __boxcxx_atomic_wait_cycle(&__phase, &spin);
    }

    void arrive_and_wait() { wait(arrive()); }

    void arrive_and_drop()
    {
        // One fewer arrival is expected from the next phase onward; then we
        // arrive for the current phase.
        __expected.fetch_sub(1, memory_order_relaxed);
        (void)arrive(1);
    }

private:
    void Complete(arrival_token phase)
    {
        __completion();
        __count.store(__expected.load(memory_order_relaxed),
                      memory_order_relaxed);
        __phase.store(phase + 1, memory_order_release); // releases waiters
    }

    atomic<ptrdiff_t> __expected; // arrivals expected per phase (drop lowers)
    atomic<ptrdiff_t> __count;    // arrivals still outstanding this phase
    atomic<unsigned> __phase;
    [[no_unique_address]] CompletionFunction __completion;
};

} // namespace std

#endif // BOXCXX_BARRIER
