// boxcxx — <barrier>
//
// std::barrier — a reusable phase barrier. Each phase, `expected` arrivals
// drive the outstanding count to zero; the arrival that drains it runs the
// completion function and, in ONE atomic store, both advances the phase and
// reloads the count for the next phase. wait() spins on
// __boxcxx_atomic_wait_cycle (WAITPKG UMONITOR/UMWAIT on the state word, else
// PAUSE budget then yield) — the same substrate as atomic::wait.
//
// The phase and the outstanding count live PACKED in a single
// atomic<uint64_t> (phase in the high 32 bits, count in the low 32). Packing
// makes "advance phase + reload count" a single atomic store, so a thread
// re-entering arrive() for the next phase can never observe an advanced phase
// alongside a stale, not-yet-reset count — the classic flat-barrier reuse
// race. Per-phase `expected` (lowered by arrive_and_drop) is a separate
// atomic.
//
// A cabin holds many strands, so waiters really do block: the spin is a
// prelude, and a waiter that outlasts it parks in the kernel until the
// completing arrival's __boxcxx_atomic_notify wakes it.
#ifndef BOXCXX_BARRIER
#define BOXCXX_BARRIER

#include <atomic>
#include <cstddef>
#include <cstdint>
#include <type_traits>
#include <utility>
#include <__bits/version_sync>

namespace boxcxx {
[[noreturn]] void Panic(const char *msg);
}

namespace std {

namespace __barrier_impl {
struct EmptyCompletion {
    void operator()() noexcept {}
};

// state word: phase in the high 32 bits, outstanding count in the low 32.
inline constexpr uint64_t Pack(uint32_t phase, uint32_t count) noexcept
{
    return (static_cast<uint64_t>(phase) << 32) | count;
}
inline constexpr uint32_t PhaseOf(uint64_t s) noexcept
{
    return static_cast<uint32_t>(s >> 32);
}
inline constexpr uint32_t CountOf(uint64_t s) noexcept
{
    return static_cast<uint32_t>(s);
}
} // namespace __barrier_impl

template <typename CompletionFunction = __barrier_impl::EmptyCompletion>
class barrier {
    static_assert(is_nothrow_invocable_v<CompletionFunction &>,
                  "barrier completion function must be nothrow-invocable "
                  "([thread.barrier.class])");

public:
    using arrival_token = unsigned; // a snapshot of the phase at arrival

    static constexpr ptrdiff_t max() noexcept
    {
        return static_cast<ptrdiff_t>(0xFFFFFFFFu); // 32-bit count field
    }

    constexpr explicit barrier(ptrdiff_t expected,
                               CompletionFunction f = CompletionFunction())
        : __state(__barrier_impl::Pack(0, static_cast<uint32_t>(expected))),
          __expected(static_cast<uint32_t>(expected)),
          __completion(std::move(f))
    {
    }

    barrier(const barrier &)            = delete;
    barrier &operator=(const barrier &) = delete;

    [[nodiscard]] arrival_token arrive(ptrdiff_t n = 1)
    {
        // Preconditions ([thread.barrier.class]): 0 < n <= the expected count
        // for the current phase. A correct program cannot violate either — the
        // per-phase updates sum to the expected count, and no waiter escapes
        // into the window where the completing thread has zeroed the count but
        // not yet advanced the phase, because wait() gates on the phase alone.
        // These diagnose the incorrect program: folded into the state word,
        // `count - un` wrapped to ~4 billion outstanding arrivals and hung
        // every participant with no clue why. The guard catches an extra
        // arrival that lands inside that window; one landing after the advance
        // store sees a fresh count and instead under-provisions the next phase.
        if (n <= 0)
            boxcxx::Panic("barrier::arrive: update must be positive");
        uint32_t un = static_cast<uint32_t>(n);
        uint64_t s  = __state.load(memory_order_acquire);
        for (;;) {
            uint32_t phase = __barrier_impl::PhaseOf(s);
            uint32_t count = __barrier_impl::CountOf(s);
            if (un > count)
                boxcxx::Panic("barrier::arrive: update exceeds this phase's "
                              "outstanding arrivals");
            if (count == un) {
                // We are the completing arrival: claim it by zeroing the count
                // at the current phase, then complete + advance in one store.
                if (__state.compare_exchange_weak(
                        s, __barrier_impl::Pack(phase, 0),
                        memory_order_acq_rel, memory_order_acquire)) {
                    CompletePhase(phase);
                    return phase;
                }
            } else if (__state.compare_exchange_weak(
                           s, __barrier_impl::Pack(phase, count - un),
                           memory_order_acq_rel, memory_order_acquire)) {
                return phase;
            }
            // CAS failure reloaded s; retry.
        }
    }

    void wait(arrival_token &&token) const
    {
        unsigned spin = 0;
        uint64_t s;
        while (__barrier_impl::PhaseOf(s = __state.load(memory_order_acquire))
               == token)
            // Only the phase (high 32 bits) drives this predicate; mask out the
            // count so same-phase arrivals churning it cannot end the park.
            __boxcxx_atomic_wait_cycle(&__state, &s, sizeof(s),
                                       0xFFFFFFFF00000000ull, &spin);
    }

    void arrive_and_wait() { wait(arrive()); }

    void arrive_and_drop()
    {
        // One fewer arrival is expected from the next phase onward; then we
        // arrive for the current phase. __expected is a separate word from
        // __state, yet the completing thread cannot miss this decrement, and
        // NOT because a cabin is single-threaded — it is the RMW chain that
        // closes the window. [thread.barrier.class] makes arrive_and_drop
        // arrive at the current phase, so this thread's arrival is one the
        // drain needs; every successful arrive() CAS is acq_rel on __state, so
        // whoever reads the count down to zero reads a value at or after ours
        // in that word's modification order and synchronizes with us
        // transitively. The fetch_sub is sequenced before our CAS, therefore
        // it happens before the acquire load in CompletePhase.
        __expected.fetch_sub(1, memory_order_release);
        (void)arrive(1);
    }

private:
    void CompletePhase(uint32_t phase)
    {
        __completion();
        uint32_t next = __expected.load(memory_order_acquire);
        // A single store advances the phase AND reloads the count: any
        // next-phase arriver that observes the new phase necessarily observes
        // the reset count (same word), and the store releases the waiters.
        __state.store(__barrier_impl::Pack(phase + 1, next),
                      memory_order_release);
        __boxcxx_atomic_notify(&__state, true);
    }

    atomic<uint64_t> __state;    // (phase << 32) | outstanding count this phase
    atomic<uint32_t> __expected; // arrivals expected per phase (drop lowers)
    [[no_unique_address]] CompletionFunction __completion;
};

} // namespace std

#endif // BOXCXX_BARRIER
