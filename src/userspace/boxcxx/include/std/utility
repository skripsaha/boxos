template <class...> class tuple;   // <tuple>

namespace __bits {
// "T x = {};" valid — i.e. default construction is also implicit.
template <class T>
concept ImplicitlyDefaultConstructibleTest = requires {
    [](const T &) {}({});
};
template <class T>
inline constexpr bool ImplicitlyDefaultConstructible =
    is_default_constructible_v<T> && ImplicitlyDefaultConstructibleTest<T>;
} // namespace __bits

// ── tuple protocol primaries (shared by pair/tuple/array) ───────────────

template <class T> struct tuple_size;
template <class T>
struct tuple_size<const T>
    : integral_constant<size_t, tuple_size<T>::value> {};
template <class T>
inline constexpr size_t tuple_size_v = tuple_size<T>::value;

template <size_t I, class T> struct tuple_element;
template <size_t I, class T>
struct tuple_element<I, const T> {
    using type = add_const_t<typename tuple_element<I, T>::type>;
};
template <size_t I, class T>
using tuple_element_t = typename tuple_element<I, T>::type;

// ── tuple-like / pair-like ([tuple.like]) ────────────────────────────────
// Both are exposition-only in the standard (hyphens make the real spelling
// unwritable), so boxcxx names them under __bits. [tuple.like]/1: T is
// tuple-like if remove_cvref_t<T> is a specialization of array, pair,
// tuple, or ranges::subrange — a CLOSED set, not "anything with a
// tuple_size/get pair" (a user type that merely opts into structured
// bindings must NOT satisfy this).
//
// IsTupleLikeType's primary (false) lives here, the lowest header that
// needs it; pair's own true-case is added right after pair below. <tuple>,
// <array>, and <ranges> each add their own true-case once their type is
// defined — the exact spread-specialization wiring tuple_size/tuple_element
// already use across those same four headers, so a translation unit sees
// "true" for exactly the tuple-like types whose header it actually
// included.
namespace __bits {

template <class T> inline constexpr bool IsTupleLikeType = false;
template <class T> inline constexpr bool IsSubrangeType  = false;

template <class T>
concept TupleLike = IsTupleLikeType<remove_cvref_t<T>>;

template <class T>
concept PairLike = TupleLike<T> && tuple_size_v<remove_cvref_t<T>> == 2;

// [range.utility.helpers]'s different-from, needed to keep tuple's
// tuple-like constructor/assignment from competing with its own copy/move
// family for the exact-same-type case.
template <class T, class U>
concept DifferentFrom = !is_same_v<remove_cvref_t<T>, remove_cvref_t<U>>;

} // namespace __bits

// ── pair ────────────────────────────────────────────────────────────────

template <class T1, class T2>
struct pair {
    using first_type  = T1;
    using second_type = T2;

    T1 first;
    T2 second;

    // Friended so get<I> is visible as a template from inside this class
    // body (needed to parse "get<0>(...)" below) — mirrors tuple's own
    // identical friend block in <tuple>.
    template <size_t I, class U1, class U2>
    friend constexpr tuple_element_t<I, pair<U1, U2>> &
    get(pair<U1, U2> &) noexcept;
    template <size_t I, class U1, class U2>
    friend constexpr const tuple_element_t<I, pair<U1, U2>> &
    get(const pair<U1, U2> &) noexcept;
    template <size_t I, class U1, class U2>
    friend constexpr tuple_element_t<I, pair<U1, U2>> &&
    get(pair<U1, U2> &&) noexcept;
    template <size_t I, class U1, class U2>
    friend constexpr const tuple_element_t<I, pair<U1, U2>> &&
    get(const pair<U1, U2> &&) noexcept;

    // default
    explicit(!__bits::ImplicitlyDefaultConstructible<T1> ||
             !__bits::ImplicitlyDefaultConstructible<T2>)
        constexpr pair() requires(is_default_constructible_v<T1> &&
                                  is_default_constructible_v<T2>)
        : first(), second()
    {
    }

    // (const T1&, const T2&)
    explicit(!is_convertible_v<const T1 &, T1> ||
             !is_convertible_v<const T2 &, T2>)
        constexpr pair(const T1 &x, const T2 &y) requires(
            is_copy_constructible_v<T1> && is_copy_constructible_v<T2>)
        : first(x), second(y)
    {
    }

    // (U1&&, U2&&)
    template <class U1 = T1, class U2 = T2>
        requires(is_constructible_v<T1, U1> && is_constructible_v<T2, U2>)
    explicit(!is_convertible_v<U1, T1> || !is_convertible_v<U2, T2>)
        constexpr pair(U1 &&x, U2 &&y)
        : first(forward<U1>(x)), second(forward<U2>(y))
    {
    }

    // from pair<U1, U2>& / const& / && / const&&
    template <class U1, class U2>
        requires(is_constructible_v<T1, U1 &> && is_constructible_v<T2, U2 &>)
    explicit(!is_convertible_v<U1 &, T1> || !is_convertible_v<U2 &, T2>)
        constexpr pair(pair<U1, U2> &p)
        : first(p.first), second(p.second)
    {
    }

    template <class U1, class U2>
        requires(is_constructible_v<T1, const U1 &> &&
                 is_constructible_v<T2, const U2 &>)
    explicit(!is_convertible_v<const U1 &, T1> ||
             !is_convertible_v<const U2 &, T2>)
        constexpr pair(const pair<U1, U2> &p)
        : first(p.first), second(p.second)
    {
    }

    template <class U1, class U2>
        requires(is_constructible_v<T1, U1> && is_constructible_v<T2, U2>)
    explicit(!is_convertible_v<U1, T1> || !is_convertible_v<U2, T2>)
        constexpr pair(pair<U1, U2> &&p)
        : first(forward<U1>(p.first)), second(forward<U2>(p.second))
    {
    }

    template <class U1, class U2>
        requires(is_constructible_v<T1, const U1> &&
                 is_constructible_v<T2, const U2>)
    explicit(!is_convertible_v<const U1, T1> ||
             !is_convertible_v<const U2, T2>)
        constexpr pair(const pair<U1, U2> &&p)
        : first(forward<const U1>(p.first)), second(forward<const U2>(p.second))
    {
    }

    // from any pair-like source via get<0>/get<1> (P2165R4 [pairs.pair]/14-17).
    // ranges::subrange is excluded: it has its own dedicated conversion to
    // any 2-element-constructible type, and letting both paths compete
    // would make that conversion ambiguous. different-from<P, pair> isn't
    // in [pairs.pair]/15's own Constraints (the exact-same-type case is
    // already resolved by the non-template copy/move constructors winning
    // any tie), but current libstdc++/libc++ both add it defensively for
    // this exact constructor, so boxcxx mirrors that instead of relying
    // solely on the tie-break rule.
    template <class P>
        requires(__bits::DifferentFrom<P, pair> &&
                 __bits::PairLike<P> &&
                 !__bits::IsSubrangeType<remove_cvref_t<P>> &&
                 is_constructible_v<T1, decltype(get<0>(declval<P>()))> &&
                 is_constructible_v<T2, decltype(get<1>(declval<P>()))> &&
                 !reference_constructs_from_temporary_v<
                     T1, decltype(get<0>(declval<P>()))> &&
                 !reference_constructs_from_temporary_v<
                     T2, decltype(get<1>(declval<P>()))>)
    explicit(!is_convertible_v<decltype(get<0>(declval<P>())), T1> ||
             !is_convertible_v<decltype(get<1>(declval<P>())), T2>)
        constexpr pair(P &&p)
        : first(get<0>(forward<P>(p))), second(get<1>(forward<P>(p)))
    {
    }

    // Same shape, but binding first/second here would dangle. Kept viable
    // (not constrained away) so overload resolution still SELECTS it —
    // and then rejects it as a use of a deleted function — instead of
    // silently falling through to a worse-matching constructor. Matches
    // [pairs.pair]/17: "defined as deleted if
    // reference_constructs_from_temporary_v<...> is true".
    template <class P>
        requires(__bits::DifferentFrom<P, pair> &&
                 __bits::PairLike<P> &&
                 !__bits::IsSubrangeType<remove_cvref_t<P>> &&
                 is_constructible_v<T1, decltype(get<0>(declval<P>()))> &&
                 is_constructible_v<T2, decltype(get<1>(declval<P>()))> &&
                 (reference_constructs_from_temporary_v<
                      T1, decltype(get<0>(declval<P>()))> ||
                  reference_constructs_from_temporary_v<
                      T2, decltype(get<1>(declval<P>()))>))
    constexpr pair(P &&p) = delete;

    // piecewise — defined in <tuple>
    template <class... Args1, class... Args2>
    constexpr pair(piecewise_construct_t, tuple<Args1...> first_args,
                   tuple<Args2...> second_args);

    pair(const pair &) = default;
    pair(pair &&)      = default;

    constexpr pair &operator=(const pair &p) requires(
        is_copy_assignable_v<T1> && is_copy_assignable_v<T2>)
    {
        first  = p.first;
        second = p.second;
        return *this;
    }

    constexpr pair &operator=(pair &&p) noexcept(
        is_nothrow_move_assignable_v<T1> &&
        is_nothrow_move_assignable_v<T2>) requires(is_move_assignable_v<T1> &&
                                                   is_move_assignable_v<T2>)
    {
        first  = forward<T1>(p.first);
        second = forward<T2>(p.second);
        return *this;
    }

    template <class U1, class U2>
        requires(is_assignable_v<T1 &, const U1 &> &&
                 is_assignable_v<T2 &, const U2 &>)
    constexpr pair &operator=(const pair<U1, U2> &p)
    {
        first  = p.first;
        second = p.second;
        return *this;
    }

    template <class U1, class U2>
        requires(is_assignable_v<T1 &, U1> && is_assignable_v<T2 &, U2>)
    constexpr pair &operator=(pair<U1, U2> &&p)
    {
        first  = forward<U1>(p.first);
        second = forward<U2>(p.second);
        return *this;
    }

    // P2321 const-qualified assignment ([pairs.pair]): a const pair of
    // REFERENCES still assigns through those references — const on the pair
    // itself doesn't propagate into what a reference member refers to.
    // is_assignable_v<const T1&, ...> is what makes these overloads PRESENT
    // for reference elements (const(int&) collapses to int&, assignable) and
    // ABSENT for plain value elements (const int& is not assignable to) —
    // mirrors <tuple>'s already-shipped const operator= exactly.
    constexpr const pair &operator=(const pair &p) const
        requires(is_copy_assignable_v<const T1> && is_copy_assignable_v<const T2>)
    {
        first  = p.first;
        second = p.second;
        return *this;
    }
    constexpr const pair &operator=(pair &&p) const
        requires(is_assignable_v<const T1 &, T1> && is_assignable_v<const T2 &, T2>)
    {
        first  = forward<T1>(p.first);
        second = forward<T2>(p.second);
        return *this;
    }
    template <class U1, class U2>
        requires(is_assignable_v<const T1 &, const U1 &> &&
                 is_assignable_v<const T2 &, const U2 &>)
    constexpr const pair &operator=(const pair<U1, U2> &p) const
    {
        first  = p.first;
        second = p.second;
        return *this;
    }
    template <class U1, class U2>
        requires(is_assignable_v<const T1 &, U1> && is_assignable_v<const T2 &, U2>)
    constexpr const pair &operator=(pair<U1, U2> &&p) const
    {
        first  = forward<U1>(p.first);
        second = forward<U2>(p.second);
        return *this;
    }

    // assign from any pair-like source via get<0>/get<1> (P2165R4
    // [pairs.pair]/42-47). different-from<P, pair> keeps this from
    // competing with the copy/move/pair<U1,U2> assignments above; subrange
    // is excluded for the same reason as the constructor.
    template <class P>
        requires(__bits::DifferentFrom<P, pair> &&
                 !__bits::IsSubrangeType<remove_cvref_t<P>> &&
                 is_assignable_v<T1 &, decltype(get<0>(declval<P>()))> &&
                 is_assignable_v<T2 &, decltype(get<1>(declval<P>()))>)
    constexpr pair &operator=(P &&p)
    {
        first  = get<0>(forward<P>(p));
        second = get<1>(forward<P>(p));
        return *this;
    }
    template <class P>
        requires(__bits::DifferentFrom<P, pair> &&
                 !__bits::IsSubrangeType<remove_cvref_t<P>> &&
                 is_assignable_v<const T1 &, decltype(get<0>(declval<P>()))> &&
                 is_assignable_v<const T2 &, decltype(get<1>(declval<P>()))>)
    constexpr const pair &operator=(P &&p) const
    {
        first  = get<0>(forward<P>(p));
        second = get<1>(forward<P>(p));
        return *this;
    }

    constexpr void swap(pair &p) noexcept(is_nothrow_swappable_v<T1> &&
                                          is_nothrow_swappable_v<T2>)
    {
        using std::swap;
        swap(first, p.first);
        swap(second, p.second);
    }

    // P2321 const-qualified swap ([pairs.pair]): same rule as the const
    // assignments above — a const pair of REFERENCES still swaps what those
    // references refer to. is_swappable_v<const T1> is what selects: for a
    // reference element const(T&) collapses back to T& (swappable), for a
    // value element const T is not (so the overload is absent, which is what
    // makes `const pair<int,int>` correctly un-swappable).
    constexpr void swap(const pair &p) const
        noexcept(is_nothrow_swappable_v<const T1> &&
                 is_nothrow_swappable_v<const T2>)
        requires(is_swappable_v<const T1> && is_swappable_v<const T2>)
    {
        using std::swap;
        swap(first, p.first);
        swap(second, p.second);
    }
};

template <class T1, class T2>
pair(T1, T2) -> pair<T1, T2>;

template <class T1, class T2>
[[nodiscard]] constexpr bool operator==(const pair<T1, T2> &a,
                                        const pair<T1, T2> &b)
{
    return a.first == b.first && a.second == b.second;
}

template <class T1, class T2>
[[nodiscard]] constexpr common_comparison_category_t<
    __cmp::synth_three_way_result_t<T1>, __cmp::synth_three_way_result_t<T2>>
operator<=>(const pair<T1, T2> &a, const pair<T1, T2> &b)
{
    if (auto c = __cmp::SynthThreeWay{}(a.first, b.first); c != 0) return c;
    return __cmp::SynthThreeWay{}(a.second, b.second);
}

template <class T1, class T2>
constexpr enable_if_t<is_swappable_v<T1> && is_swappable_v<T2>>
swap(pair<T1, T2> &a, pair<T1, T2> &b) noexcept(noexcept(a.swap(b)))
{
    a.swap(b);
}

template <class T1, class T2>
constexpr enable_if_t<is_swappable_v<const T1> && is_swappable_v<const T2>>
swap(const pair<T1, T2> &a, const pair<T1, T2> &b) noexcept(noexcept(a.swap(b)))
{
    a.swap(b);
}

// ── P2321 pair common-reference / common-type ([pairs.spec]) ────────────
// What lets a proxy pair (pair<T&,U&>, as views::zip yields) and its value
// pair (pair<T,U>) meet in one type — indirectly_readable and every
// algorithm built on it ask common_reference_t for exactly this, and without
// these two the fallback conditional-operator rule finds both directions
// convertible and gives up. Both are guarded by a requires-clause on the
// element-wise result being a valid pair, so a mismatched pair of pairs
// falls back to the primary template with no member `type` rather than
// hard-erroring.
template <class T1, class T2, class U1, class U2,
          template <class> class TQual, template <class> class UQual>
    requires requires {
        typename pair<common_reference_t<TQual<T1>, UQual<U1>>,
                      common_reference_t<TQual<T2>, UQual<U2>>>;
    }
struct basic_common_reference<pair<T1, T2>, pair<U1, U2>, TQual, UQual> {
    using type = pair<common_reference_t<TQual<T1>, UQual<U1>>,
                      common_reference_t<TQual<T2>, UQual<U2>>>;
};

template <class T1, class T2, class U1, class U2>
    requires requires {
        typename pair<common_type_t<T1, U1>, common_type_t<T2, U2>>;
    }
