// ── move / forward family ───────────────────────────────────────────────

template <class T>
[[nodiscard]] constexpr T &&forward(remove_reference_t<T> &t) noexcept
{
    return static_cast<T &&>(t);
}

template <class T>
[[nodiscard]] constexpr T &&forward(remove_reference_t<T> &&t) noexcept
{
    static_assert(!is_lvalue_reference_v<T>,
                  "std::forward must not turn an rvalue into an lvalue");
    return static_cast<T &&>(t);
}

template <class T>
[[nodiscard]] constexpr remove_reference_t<T> &&move(T &&t) noexcept
{
    return static_cast<remove_reference_t<T> &&>(t);
}

template <class T>
[[nodiscard]] constexpr conditional_t<
    !is_nothrow_move_constructible_v<T> && is_copy_constructible_v<T>,
    const T &, T &&>
move_if_noexcept(T &x) noexcept
{
    return move(x);
}

template <class T>
constexpr add_const_t<T> &as_const(T &t) noexcept
{
    return t;
}
template <class T> void as_const(const T &&) = delete;

// C++23 [forward]/6 — forward_like
template <class T, class U>
[[nodiscard]] constexpr auto &&forward_like(U &&x) noexcept
{
    constexpr bool kAddConst = is_const_v<remove_reference_t<T>>;
    if constexpr (is_lvalue_reference_v<T &&>) {
        if constexpr (kAddConst)
            return as_const(x);
        else
            return static_cast<U &>(x);
    } else {
        if constexpr (kAddConst)
            return move(as_const(x));
        else
            return move(x);
    }
}

// ── swap (definitions for the declarations in <type_traits>) ───────────

template <class T>
constexpr enable_if_t<is_move_constructible<T>::value &&
                      is_move_assignable<T>::value>
swap(T &a, T &b) noexcept(is_nothrow_move_constructible<T>::value &&
                          is_nothrow_move_assignable<T>::value)
{
    T tmp = move(a);
    a     = move(b);
    b     = move(tmp);
}

// Must match <type_traits>'s declaration token for token, exception
// specification included — see the note there.
template <class T, size_t N>
constexpr enable_if_t<is_swappable<T>::value>
swap(T (&a)[N], T (&b)[N]) noexcept(is_nothrow_swappable<T>::value)
{
    for (size_t i = 0; i < N; ++i) swap(a[i], b[i]);
}

template <class T, class U = T>
constexpr T exchange(T &obj, U &&new_value) noexcept(
    is_nothrow_move_constructible_v<T> && is_nothrow_assignable_v<T &, U>)
{
    T old = move(obj);
    obj   = forward<U>(new_value);
    return old;
}

// ── to_underlying / unreachable ─────────────────────────────────────────

template <class E>
[[nodiscard]] constexpr underlying_type_t<E> to_underlying(E e) noexcept
{
    return static_cast<underlying_type_t<E>>(e);
}

[[noreturn]] inline void unreachable()
{
    __builtin_unreachable();
}

// ── safe integer comparisons ([utility.intcmp]) ─────────────────────────

template <class T, class U>
[[nodiscard]] constexpr bool cmp_equal(T t, U u) noexcept
{
    static_assert(is_integral_v<T> && is_integral_v<U>,
                  "cmp_* require standard integer types");
    if constexpr (is_signed_v<T> == is_signed_v<U>)
        return t == u;
    else if constexpr (is_signed_v<T>)
        return t >= 0 && make_unsigned_t<T>(t) == u;
    else
        return u >= 0 && make_unsigned_t<U>(u) == t;
}

template <class T, class U>
[[nodiscard]] constexpr bool cmp_not_equal(T t, U u) noexcept
{
    return !cmp_equal(t, u);
}

template <class T, class U>
[[nodiscard]] constexpr bool cmp_less(T t, U u) noexcept
{
    static_assert(is_integral_v<T> && is_integral_v<U>,
                  "cmp_* require standard integer types");
    if constexpr (is_signed_v<T> == is_signed_v<U>)
        return t < u;
    else if constexpr (is_signed_v<T>)
        return t < 0 || make_unsigned_t<T>(t) < u;
    else
        return u >= 0 && t < make_unsigned_t<U>(u);
}

template <class T, class U>
[[nodiscard]] constexpr bool cmp_greater(T t, U u) noexcept
{
    return cmp_less(u, t);
}

template <class T, class U>
[[nodiscard]] constexpr bool cmp_less_equal(T t, U u) noexcept
{
    return !cmp_less(u, t);
}

template <class T, class U>
[[nodiscard]] constexpr bool cmp_greater_equal(T t, U u) noexcept
{
    return !cmp_less(t, u);
}

template <class R, class T>
[[nodiscard]] constexpr bool in_range(T t) noexcept
{
    if constexpr (is_signed_v<R>) {
        constexpr R kMax = R(make_unsigned_t<R>(-1) >> 1);
        constexpr R kMin = R(-kMax - 1);
        return cmp_greater_equal(t, kMin) && cmp_less_equal(t, kMax);
    } else {
        return cmp_greater_equal(t, R(0)) && cmp_less_equal(t, R(-1));
    }
}

// ── integer_sequence ────────────────────────────────────────────────────

template <class T, T... Is>
struct integer_sequence {
    using value_type = T;
    static constexpr size_t size() noexcept { return sizeof...(Is); }
};

template <size_t... Is>
using index_sequence = integer_sequence<size_t, Is...>;

// GCC spells the sequence builtin __integer_pack, clang (host tooling,
// native test harnesses, clangd) spells it __make_integer_seq.
#if __has_builtin(__make_integer_seq)
template <class T, T N>
using make_integer_sequence = __make_integer_seq<integer_sequence, T, N>;
#else
template <class T, T N>
using make_integer_sequence = integer_sequence<T, __integer_pack(N)...>;
#endif

template <size_t N>
using make_index_sequence = make_integer_sequence<size_t, N>;

template <class... T>
using index_sequence_for = make_index_sequence<sizeof...(T)>;

