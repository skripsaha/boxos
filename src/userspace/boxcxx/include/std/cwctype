// boxcxx — <cwctype>
//
// [cwctype.syn]. Eighteen functions that answer, for one wide character, the
// questions <cctype> answers for one byte.
//
// ── Why this header has tables and <cctype> does not ────────────────────────
// <cctype> writes its answers out as range tests and says so proudly: the "C"
// locale's execution character set is ASCII, so `isalpha` is a comparison and
// nothing can change it at run time. This header cannot do that, and the reason
// is a decision BoxOS already made. Ф41-b fixed the encoding of the one locale
// as UTF-8 with MB_CUR_MAX 4, and Ф41-e-1 built the codec that turns those
// bytes into code points. A `wchar_t` here is therefore a Unicode scalar value,
// and "is it a letter" is a question about Unicode, not about a byte.
//
// The two headers are not in tension, and it is worth being exact about why.
// 0xD0 is the first byte of 'ж' in UTF-8; `isalpha(0xD0)` is 0, and that is
// correct, because 0xD0 is not a character — it is a fragment of one. L'ж' IS a
// character, and `iswalpha(L'ж')` is 1. Each header is right about the thing it
// classifies.
//
// ── Where the answers come from ─────────────────────────────────────────────
// The Unicode Character Database, via <__bits/unicode_wctype>, which is
// generated by tools/gen_unicode_wctype.py and carries nothing but UCD facts.
// The reasoning for each predicate — which property, and why that one — is in
// that generator's preamble, so it sits beside the code that acts on it.
//
// Two answers were measured against macOS libc in a UTF-8 locale and
// deliberately differ, both recorded in CONFORMANCE:
//
//   iswalpha(U+4E2D 中)   macOS 0, here 1. `Lo` is `Alphabetic` in
//                         DerivedCoreProperties; a CJK ideograph is a letter.
//   iswprint(U+00AD)      macOS 1, here 0. A SOFT HYPHEN is `Cf`, a format
//                         character with no glyph. Excluding it also forces
//                         iswpunct(U+00AD) to 0, because punct must imply
//                         print for the classification to be self-consistent.
//
// Three predicates are NOT Unicode-wide, on purpose, and both reference
// libraries agree: `iswdigit` and `iswxdigit` are the ASCII digits and only
// those, because C fixes them to the "decimal-digit character" of its own 5.2.1
// rather than to a Unicode property. Measured in a UTF-8 locale:
// iswdigit(U+0660 ARABIC-INDIC DIGIT ZERO) is 0. `iswalnum` is alpha-or-digit
// on top of that, so U+0660 is neither alnum nor punct — which is exactly what
// a UTF-8 locale answers.
//
// ── The argument contract ───────────────────────────────────────────────────
// C's: the value shall be representable as a wchar_t or shall equal WEOF.
// `wint_t` is unsigned 32-bit here and WEOF is 0xFFFFFFFF, so WEOF and every
// value past U+10FFFF fall outside the tables and answer 0, and the two
// conversions return their argument unchanged. That is what makes
// `towlower(WEOF) == WEOF`, which a caller folding a `fgetwc` result relies on.
// A negative wchar_t converts to a wint_t far above U+10FFFF and lands in the
// same place. Surrogates need no special case: U+D800..U+DFFF are `Cs`, so the
// tables already answer 0 for every predicate.
//
// NOT constexpr, deliberately: [constexpr.functions]/1 forbids an
// implementation from declaring a standard library function signature constexpr
// where the standard does not, and the standard does not for these. The
// underlying <__bits/unicode_wctype> predicates ARE constexpr — they are not
// standard-library signatures — so a caller who needs a compile-time answer has
// somewhere to go. The same rule kept hash<vector<bool>> non-constexpr in Ф39
// and every <cctype> function non-constexpr in Ф41-a.
#ifndef BOXCXX_CWCTYPE
#define BOXCXX_CWCTYPE

#include <__bits/c_wint>
#include <__bits/unicode_wctype>

namespace std {

// Scalar handles, as [cwctype.syn] requires. Zero is the "no such property"
// value that wctype() and wctrans() return for an unknown name, and both
// dispatchers treat it as "classify nothing" / "map nothing" rather than as an
// error, because C gives them no way to report one.
using wctype_t  = unsigned long;
using wctrans_t = unsigned long;

namespace __wctype_impl {

// Past this, nothing is a Unicode scalar value — WEOF included.
constexpr bool InRange(wint_t wc) noexcept { return wc <= 0x10FFFFu; }

constexpr bool AsciiDigit(wint_t wc) noexcept { return wc >= L'0' && wc <= L'9'; }

enum : unsigned long {
    kNone = 0, kAlnum, kAlpha, kBlank, kCntrl, kDigit, kGraph,
    kLower, kPrint, kPunct, kSpace, kUpper, kXdigit
};
enum : unsigned long { kToLower = 1, kToUpper = 2 };

// Two names are equal when neither has a byte the other does not. Written out
// rather than calling strcmp so <cwctype> stays a header that pulls in nothing
// but its two leaves.
constexpr bool Same(const char *a, const char *b) noexcept
{
    while (*a && *a == *b) { ++a; ++b; }
    return *a == *b;
}

} // namespace __wctype_impl

inline int iswalpha(wint_t wc) noexcept
{
    return __wctype_impl::InRange(wc) && __unicode::IsAlphabetic((char32_t)wc);
}

inline int iswupper(wint_t wc) noexcept
{
    return __wctype_impl::InRange(wc) && __unicode::IsUppercase((char32_t)wc);
}

inline int iswlower(wint_t wc) noexcept
{
    return __wctype_impl::InRange(wc) && __unicode::IsLowercase((char32_t)wc);
}

inline int iswspace(wint_t wc) noexcept
{
    return __wctype_impl::InRange(wc) && __unicode::IsWhiteSpace((char32_t)wc);
}

inline int iswblank(wint_t wc) noexcept
{
    return __wctype_impl::InRange(wc) && __unicode::IsBlank((char32_t)wc);
}

inline int iswcntrl(wint_t wc) noexcept
{
    return __wctype_impl::InRange(wc) && __unicode::IsControl((char32_t)wc);
}

inline int iswprint(wint_t wc) noexcept
{
    return __wctype_impl::InRange(wc) && __unicode::IsPrint((char32_t)wc);
}

inline int iswpunct(wint_t wc) noexcept
{
    return __wctype_impl::InRange(wc) && __unicode::IsPunct((char32_t)wc);
}

// C fixes these two to its own decimal-digit and hexadecimal-digit characters,
// which are ASCII. A Unicode property here would make iswdigit(U+0660) true and
// disagree with every implementation there is, including the two measured.
inline int iswdigit(wint_t wc) noexcept { return __wctype_impl::AsciiDigit(wc); }

inline int iswxdigit(wint_t wc) noexcept
{
    return __wctype_impl::AsciiDigit(wc) || (wc >= L'a' && wc <= L'f') ||
           (wc >= L'A' && wc <= L'F');
}

inline int iswalnum(wint_t wc) noexcept { return iswalpha(wc) || iswdigit(wc); }

// A printing character that is not a space. Derived rather than tabled, so it
// cannot drift from the two predicates it is defined in terms of.
inline int iswgraph(wint_t wc) noexcept { return iswprint(wc) && !iswspace(wc); }

inline wint_t towupper(wint_t wc) noexcept
{
    return __wctype_impl::InRange(wc)
               ? (wint_t)__unicode::ToUpper((char32_t)wc)
               : wc;
}

inline wint_t towlower(wint_t wc) noexcept
{
    return __wctype_impl::InRange(wc)
               ? (wint_t)__unicode::ToLower((char32_t)wc)
               : wc;
}

// The twelve names C names, and nothing else. An unknown property is 0, which
// iswctype then answers 0 for — C's own wording: the returned value is usable
// only if it is nonzero.
inline wctype_t wctype(const char *property) noexcept
{
    using namespace __wctype_impl;
    if (!property) return kNone;
    if (Same(property, "alnum"))  return kAlnum;
    if (Same(property, "alpha"))  return kAlpha;
    if (Same(property, "blank"))  return kBlank;
    if (Same(property, "cntrl"))  return kCntrl;
    if (Same(property, "digit"))  return kDigit;
    if (Same(property, "graph"))  return kGraph;
    if (Same(property, "lower"))  return kLower;
    if (Same(property, "print"))  return kPrint;
    if (Same(property, "punct"))  return kPunct;
    if (Same(property, "space"))  return kSpace;
    if (Same(property, "upper"))  return kUpper;
    if (Same(property, "xdigit")) return kXdigit;
    return kNone;
}

// Dispatches to the very functions above, so iswctype(wc, wctype("alpha")) and
// iswalpha(wc) cannot answer differently.
inline int iswctype(wint_t wc, wctype_t desc) noexcept
{
    using namespace __wctype_impl;
    switch (desc) {
    case kAlnum:  return iswalnum(wc);
    case kAlpha:  return iswalpha(wc);
    case kBlank:  return iswblank(wc);
    case kCntrl:  return iswcntrl(wc);
    case kDigit:  return iswdigit(wc);
    case kGraph:  return iswgraph(wc);
    case kLower:  return iswlower(wc);
    case kPrint:  return iswprint(wc);
    case kPunct:  return iswpunct(wc);
    case kSpace:  return iswspace(wc);
    case kUpper:  return iswupper(wc);
    case kXdigit: return iswxdigit(wc);
    default:      return 0;
    }
}

inline wctrans_t wctrans(const char *property) noexcept
{
    using namespace __wctype_impl;
    if (!property) return kNone;
    if (Same(property, "tolower")) return kToLower;
    if (Same(property, "toupper")) return kToUpper;
    return kNone;
}

inline wint_t towctrans(wint_t wc, wctrans_t desc) noexcept
{
    using namespace __wctype_impl;
    if (desc == kToLower) return towlower(wc);
    if (desc == kToUpper) return towupper(wc);
    return wc;
}

} // namespace std

// [headers]/5 leaves it unspecified whether a <cX> header's names also reach the
// global namespace; boxcxx puts them there for the same reason <cctype> does —
// ported code says iswalpha(c) far more often than std::iswalpha(c) — and as
// using-declarations, so there is exactly one function either way.
using std::iswalnum;
using std::iswalpha;
using std::iswblank;
using std::iswcntrl;
using std::iswctype;
using std::iswdigit;
using std::iswgraph;
using std::iswlower;
using std::iswprint;
using std::iswpunct;
using std::iswspace;
using std::iswupper;
using std::iswxdigit;
using std::towctrans;
using std::towlower;
using std::towupper;
using std::wctrans;
using std::wctrans_t;
using std::wctype;
using std::wctype_t;

#endif // BOXCXX_CWCTYPE
