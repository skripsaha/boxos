// boxcxx — <forward_list>
// Singly-linked list with a before-begin sentinel that is NOT circular:
// end() is a real nullptr, not an addressable node. One pointer per node
// (the entire reason forward_list exists over <list>), at the cost of no
// size(), no back()/push_back, and forward-only iteration. splice_after/
// merge/sort/reverse are the singly-linked analogs of <list>'s primitives,
// but each needs a genuinely different shape from its <list> counterpart —
// see the per-function comments below.
#ifndef BOXCXX_FORWARD_LIST
#define BOXCXX_FORWARD_LIST

#include <__bits/allocator_core>
#include <__bits/iterator_core>
#include <__bits/ranges_core>
#include <compare>
#include <cstddef>
#include <initializer_list>
#include <type_traits>
#include <utility>

namespace std {

namespace __forward_list {

struct NodeBase {
    NodeBase *next = nullptr;
};

template <typename V>
struct Node : NodeBase {
    V value;
};

// O(1): unlink the single node right after `from`, relink it right after `to`.
inline void TransferOneAfter(NodeBase *to, NodeBase *from) noexcept
{
    NodeBase *moved = from->next;
    from->next  = moved->next;
    moved->next = to->next;
    to->next    = moved;
}

// O(distance(afterFirst,last)): unlink the open range (afterFirst, last),
// relink it right after `to`. No-op if afterFirst->next == last (empty
// range). Whole-list splice_after is the special case
// afterFirst=&other.__beforeBegin, last=nullptr.
inline void TransferRangeAfter(NodeBase *to, NodeBase *afterFirst, NodeBase *last) noexcept
{
    // Zero-distance open range (afterFirst == last) is legal, defined input and
    // a no-op — without this guard the walk below runs off the end (nullptr
    // deref / #PF), since `last` sits behind afterFirst->next.
    if (afterFirst == last) return;
    NodeBase *rangeBegin = afterFirst->next;
    if (rangeBegin == last) return;
    NodeBase *rangeEnd = rangeBegin;
    while (rangeEnd->next != last) rangeEnd = rangeEnd->next;
    afterFirst->next = last;
    rangeEnd->next   = to->next;
    to->next         = rangeBegin;
}

} // namespace __forward_list

template <typename T, typename Alloc = allocator<T>>
class forward_list {
    using NodeT     = __forward_list::Node<T>;
    using NodeBase  = __forward_list::NodeBase;
    using NodeAlloc =
        typename allocator_traits<Alloc>::template rebind_alloc<NodeT>;
    using NodeTraits = allocator_traits<NodeAlloc>;

public:
    using value_type      = T;
    using allocator_type  = Alloc;
    using pointer         = typename allocator_traits<Alloc>::pointer;
    using const_pointer   = typename allocator_traits<Alloc>::const_pointer;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;
    using reference       = T &;
    using const_reference = const T &;

    template <bool Const>
    class Iter {
        using Ref = conditional_t<Const, const T &, T &>;
        using Ptr = conditional_t<Const, const T *, T *>;

    public:
        using iterator_category = forward_iterator_tag;
        using value_type        = T;
        using difference_type   = ptrdiff_t;
        using reference         = Ref;
        using pointer            = Ptr;

        Iter() noexcept : __n(nullptr) {}
        explicit Iter(NodeBase *n) noexcept : __n(n) {}
        template <bool C2>
            requires(Const && !C2)
        Iter(const Iter<C2> &other) noexcept : __n(other.__n)
        {
        }

        Ref operator*() const { return static_cast<NodeT *>(__n)->value; }
        Ptr operator->() const
        {
            return __builtin_addressof(static_cast<NodeT *>(__n)->value);
        }
        Iter &operator++()
        {
            __n = __n->next;
            return *this;
        }
        Iter operator++(int)
        {
            Iter tmp = *this;
            __n      = __n->next;
            return tmp;
        }
        bool operator==(const Iter &rhs) const noexcept
        {
            return __n == rhs.__n;
        }

        NodeBase *__n;
    };

    using iterator       = Iter<false>;
    using const_iterator = Iter<true>;

    // ── lifecycle ───────────────────────────────────────────────────────

    forward_list() noexcept = default;
    explicit forward_list(const Alloc &a) noexcept : __alloc(a) {}
    explicit forward_list(size_type count, const Alloc &a = Alloc()) : __alloc(a)
    {
        iterator prev = before_begin();
        for (; count > 0; --count) prev = emplace_after(prev);
    }
    forward_list(size_type count, const T &value, const Alloc &a = Alloc())
        : __alloc(a)
    {
        iterator prev = before_begin();
        for (; count > 0; --count) prev = insert_after(prev, value);
    }
    template <typename It>
        requires(!is_integral_v<It>)
    forward_list(It first, It last, const Alloc &a = Alloc()) : __alloc(a)
    {
        iterator prev = before_begin();
        for (; first != last; ++first) prev = insert_after(prev, *first);
    }
    template <ContainerCompatibleRange<T> R>
    forward_list(from_range_t, R &&rg, const Alloc &a = Alloc()) : __alloc(a)
    {
        iterator prev = before_begin();
        for (auto &&v : rg) prev = insert_after(prev, std::forward<decltype(v)>(v));
    }
    forward_list(initializer_list<T> il, const Alloc &a = Alloc()) : __alloc(a)
    {
        iterator prev = before_begin();
        for (const T &v : il) prev = insert_after(prev, v);
    }
    forward_list(const forward_list &other)
        : __alloc(NodeTraits::select_on_container_copy_construction(
              other.__alloc))
    {
        iterator prev = before_begin();
        for (const T &v : other) prev = insert_after(prev, v);
    }
    // Allocator-extended ctors: bare `const Alloc &`, not type_identity_t<Alloc>.
    // Both are non-template constructors (Alloc is fixed by the class), so
    // type_identity_t would be a behaviorally-identical no-op here — matches
    // this codebase's own vector.h/deque.h convention.
    forward_list(const forward_list &other, const Alloc &a) : __alloc(a)
    {
        iterator prev = before_begin();
        for (const T &v : other) prev = insert_after(prev, v);
    }
    forward_list(forward_list &&other) noexcept : __alloc(std::move(other.__alloc))
    {
        StealFrom(other);
    }
    forward_list(forward_list &&other, const Alloc &a) : __alloc(a)
    {
        if (NodeTraits::is_always_equal::value || __alloc == other.__alloc) {
            StealFrom(other);
        } else {
            iterator prev = before_begin();
            for (T &v : other) prev = insert_after(prev, std::move(v));
        }
    }
    ~forward_list() { clear(); }

    // ── assignment + assign ────────────────────────────────────────────

    forward_list &operator=(const forward_list &other)
    {
        if (this == &other) return *this;
        if constexpr (NodeTraits::propagate_on_container_copy_assignment::value) {
            if (!(__alloc == other.__alloc)) {
                clear();                 // free existing nodes via the OLD allocator
                __alloc = other.__alloc; // now safe to propagate
            } else {
                __alloc = other.__alloc;
                clear();
            }
        } else {
            clear();
        }
        iterator prev = before_begin();
        for (const T &v : other) prev = insert_after(prev, v);
        return *this;
    }
    forward_list &operator=(forward_list &&other)
        noexcept(NodeTraits::is_always_equal::value)
    {
        if (this == &other) return *this;
        constexpr bool pocma =
            NodeTraits::propagate_on_container_move_assignment::value;
        if (pocma || NodeTraits::is_always_equal::value || __alloc == other.__alloc) {
            clear();
            if constexpr (pocma) __alloc = std::move(other.__alloc);
            StealFrom(other);
            return *this;
        }
        // Unequal allocators without propagation: element-wise move into our
        // own storage through our OWN allocator. Stealing other's nodes
        // would later free them through a different allocator — UB.
        clear();
        iterator prev = before_begin();
        for (T &v : other) prev = insert_after(prev, std::move(v));
        return *this;
    }
    forward_list &operator=(initializer_list<T> il)
    {
        assign(il.begin(), il.end());
        return *this;
    }

    void assign(size_type count, const T &value)
    {
        clear();
        iterator prev = before_begin();
        for (; count > 0; --count) prev = insert_after(prev, value);
    }
    template <typename It>
        requires(!is_integral_v<It>)
    void assign(It first, It last)
    {
        clear();
        iterator prev = before_begin();
        for (; first != last; ++first) prev = insert_after(prev, *first);
    }
    void assign(initializer_list<T> il) { assign(il.begin(), il.end()); }

    // Materialize into a fresh forward_list BEFORE touching *this — rg may
    // alias *this. Move-assigning a fully-built temporary in is self-
    // reference-safe and makes self-assign a value-preserving no-op.
    template <ContainerCompatibleRange<T> R>
    void assign_range(R &&rg)
    {
        *this = forward_list(from_range, std::forward<R>(rg), get_allocator());
    }

    allocator_type get_allocator() const noexcept { return Alloc(__alloc); }

    // ── iterators ───────────────────────────────────────────────────────

    iterator before_begin() noexcept { return iterator(&__beforeBegin); }
    const_iterator before_begin() const noexcept
    {
        return const_iterator(const_cast<NodeBase *>(&__beforeBegin));
    }
    const_iterator cbefore_begin() const noexcept { return before_begin(); }

    iterator begin() noexcept { return iterator(__beforeBegin.next); }
    const_iterator begin() const noexcept
    {
        return const_iterator(const_cast<NodeBase *>(__beforeBegin.next));
    }
    const_iterator cbegin() const noexcept { return begin(); }

    iterator end() noexcept { return iterator(nullptr); }
    const_iterator end() const noexcept { return const_iterator(nullptr); }
    const_iterator cend() const noexcept { return end(); }

    // ── capacity ────────────────────────────────────────────────────────
    // No size() — forward_list's own deliberate trade for O(1) whole-list
    // splice_after and one-pointer nodes.

    [[nodiscard]] bool empty() const noexcept { return __beforeBegin.next == nullptr; }
    size_type max_size() const noexcept { return size_type(-1) / sizeof(NodeT); }

    // ── element access ─────────────────────────────────────────────────
    // No back() — forward_list keeps no tail pointer.

    reference front() { return *begin(); }
    const_reference front() const { return *begin(); }

    // ── modifiers: front end ───────────────────────────────────────────

    template <typename... Args>
    reference emplace_front(Args &&...args)
    {
        return *emplace_after(before_begin(), std::forward<Args>(args)...);
    }
    void push_front(const T &v) { emplace_front(v); }
    void push_front(T &&v) { emplace_front(std::move(v)); }
    // insert_range_after(before_begin(), rg) advances its own cursor
    // internally (see insert_range_after below), so the range lands in
    // source order at the front — no reversal, no fixed-position trick.
    template <ContainerCompatibleRange<T> R>
    void prepend_range(R &&rg)
    {
        insert_range_after(before_begin(), std::forward<R>(rg));
    }
    void pop_front() { erase_after(before_begin()); }

    // ── modifiers: after a position ────────────────────────────────────
    // emplace_after is the one true primitive (O(1) pointer splice); every
    // insert_after/insert_range_after overload below is a thin loop over it
    // using an ADVANCING cursor (cur = insert_after(cur, ...) each step).
    // A FIXED cursor would insert every element right after the same node,
    // reversing the source order — the opposite of <list>'s own
    // fixed-position insert(pos,first,last) convention.

    template <typename... Args>
    iterator emplace_after(const_iterator pos, Args &&...args)
    {
        NodeT *n = MakeNode(std::forward<Args>(args)...);
        n->next       = pos.__n->next;
        pos.__n->next = n;
        return iterator(n);
    }
    iterator insert_after(const_iterator pos, const T &v) { return emplace_after(pos, v); }
    iterator insert_after(const_iterator pos, T &&v)
    {
        return emplace_after(pos, std::move(v));
    }
    iterator insert_after(const_iterator pos, size_type count, const T &v)
    {
        iterator cur = iterator(pos.__n);
        for (; count > 0; --count) cur = emplace_after(cur, v);
        return cur;
    }
    template <typename It>
        requires(!is_integral_v<It>)
    iterator insert_after(const_iterator pos, It first, It last)
    {
        iterator cur = iterator(pos.__n);
        for (; first != last; ++first) cur = emplace_after(cur, *first);
        return cur;
    }
    iterator insert_after(const_iterator pos, initializer_list<T> il)
    {
        return insert_after(pos, il.begin(), il.end());
    }
    template <ContainerCompatibleRange<T> R>
    iterator insert_range_after(const_iterator pos, R &&rg)
    {
        iterator cur = iterator(pos.__n);
        for (auto &&v : rg) cur = emplace_after(cur, std::forward<decltype(v)>(v));
        return cur;
    }

    iterator erase_after(const_iterator pos)
    {
        NodeBase *n    = pos.__n;
        NodeBase *dead = n->next;
        n->next        = dead->next;
        DropNode(static_cast<NodeT *>(dead));
        return iterator(n->next);
    }
    iterator erase_after(const_iterator pos, const_iterator last)
    {
        NodeBase *n    = pos.__n;
        NodeBase *stop = last.__n;
        // Zero-distance open range (pos == last) is legal, defined input and a
        // no-op. Must return BEFORE the walk AND before the trailing
        // n->next = stop below — otherwise pos == last self-loops n.
        if (n == stop) return iterator(stop);
        NodeBase *cur  = n->next;
        while (cur != stop) {
            NodeBase *dead = cur;
            cur             = cur->next;
            DropNode(static_cast<NodeT *>(dead));
        }
        n->next = stop;
        return iterator(stop);
    }

    void swap(forward_list &other) noexcept(NodeTraits::is_always_equal::value)
    {
        if constexpr (NodeTraits::propagate_on_container_swap::value) {
            NodeAlloc tmp = __alloc;
            __alloc       = other.__alloc;
            other.__alloc = tmp;
        }
        NodeBase *n              = __beforeBegin.next;
        __beforeBegin.next       = other.__beforeBegin.next;
        other.__beforeBegin.next = n;
    }

    // No O(1) size/back to shortcut with — a single forward walk determines
    // simultaneously whether to truncate or grow.
    void resize(size_type n)
    {
        iterator prev  = before_begin();
        size_type seen = 0;
        while (seen < n && std::next(prev) != end()) {
            prev = std::next(prev);
            ++seen;
        }
        if (seen == n) {
            erase_after(prev, end());
        } else {
            while (seen < n) {
                prev = emplace_after(prev);
                ++seen;
            }
        }
    }
    void resize(size_type n, const T &value)
    {
        iterator prev  = before_begin();
        size_type seen = 0;
        while (seen < n && std::next(prev) != end()) {
            prev = std::next(prev);
            ++seen;
        }
        if (seen == n) {
            erase_after(prev, end());
        } else {
            while (seen < n) {
                prev = insert_after(prev, value);
                ++seen;
            }
        }
    }

    void clear() noexcept
    {
        NodeBase *cur = __beforeBegin.next;
        while (cur) {
            NodeBase *next = cur->next;
            DropNode(static_cast<NodeT *>(cur));
            cur = next;
        }
        __beforeBegin.next = nullptr;
    }

    // ── operations ([forwardlist.ops]) ─────────────────────────────────
    // Whole-list and range splice_after are O(size moved) — forward_list
    // keeps no tail pointer, so even a whole-list move must walk to find
    // the source's last node. Single-element splice_after is O(1).

    void splice_after(const_iterator pos, forward_list &other)
    {
        __forward_list::TransferRangeAfter(pos.__n, &other.__beforeBegin, nullptr);
    }
    void splice_after(const_iterator pos, forward_list &&other) { splice_after(pos, other); }

    // [forward.list.ops]: no effect if pos == i OR pos == ++i. Both guards are
    // essential — with pos == ++i, pos names the element that would be moved,
    // and TransferOneAfter would self-loop it (silent element drop + node leak).
    void splice_after(const_iterator pos, forward_list &, const_iterator i)
    {
        const_iterator j = i;
        ++j;
        if (pos == i || pos == j) return;
        __forward_list::TransferOneAfter(pos.__n, i.__n);
    }
    void splice_after(const_iterator pos, forward_list &&other, const_iterator i)
    {
        splice_after(pos, other, i);
    }

    void splice_after(const_iterator pos, forward_list &, const_iterator first,
                      const_iterator last)
    {
        __forward_list::TransferRangeAfter(pos.__n, first.__n, last.__n);
    }
    void splice_after(const_iterator pos, forward_list &&other, const_iterator first,
                      const_iterator last)
    {
        splice_after(pos, other, first, last);
    }

    size_type remove(const T &value)
    {
        return remove_if([&](const T &x) { return x == value; });
    }
    template <typename Pred>
    size_type remove_if(Pred pred)
    {
        size_type removed = 0;
        iterator prev = before_begin();
        iterator cur  = begin();
        while (cur != end()) {
            if (pred(*cur)) {
                cur = erase_after(prev);
                ++removed;
            } else {
                prev = cur;
                ++cur;
            }
        }
        return removed;
    }

    size_type unique()
    {
        return unique([](const T &a, const T &b) { return a == b; });
    }
    template <typename Pred>
    size_type unique(Pred pred)
    {
        size_type removed = 0;
        if (empty()) return 0;
        iterator cur  = begin();
        iterator next = cur;
        ++next;
        while (next != end()) {
            if (pred(*cur, *next)) {
                next = erase_after(cur);
                ++removed;
            } else {
                cur = next;
                ++next;
            }
        }
        return removed;
    }

    // Trailing-cursor merge: `ap` trails one behind *this's candidate under
    // comparison; other.front() is always the current *other* candidate (no
    // separate source cursor needed — splicing always consumes other's
    // current front). Cannot reuse <list>'s a/b-iterator merge shape: there
    // is no O(1)-addressable end-sentinel to splice the tail-drain against.
    template <typename Comp>
    void merge(forward_list &other, Comp comp)
    {
        if (this == &other) return;
        iterator ap = before_begin();
        while (std::next(ap) != end() && !other.empty()) {
            if (comp(other.front(), *std::next(ap)))
                splice_after(ap, other, other.before_begin());
            ++ap;
        }
        if (!other.empty()) splice_after(ap, other);
    }
    void merge(forward_list &other)
    {
        merge(other, [](const T &a, const T &b) { return a < b; });
    }
    void merge(forward_list &&other) { merge(other); }
    template <typename Comp>
    void merge(forward_list &&other, Comp comp)
    {
        merge(other, comp);
    }

    // Classic 64-bin bottom-up merge, structurally identical to <list>'s own
    // sort with begin()/splice replaced by before_begin()/splice_after.
    template <typename Comp>
    void sort(Comp comp)
    {
        if (empty() || std::next(begin()) == end()) return;
        forward_list carry(get_allocator());
        forward_list bins[64];
        int fill = 0;
        while (!empty()) {
            carry.splice_after(carry.before_begin(), *this, before_begin());
            int i = 0;
            while (i < fill && !bins[i].empty()) {
                bins[i].merge(carry, comp);
                carry.swap(bins[i]);
                ++i;
            }
            carry.swap(bins[i]);
            if (i == fill) ++fill;
        }
        for (int i = 1; i < fill; ++i) bins[i].merge(bins[i - 1], comp);
        // StealFrom, not swap(): *this is empty here and every sorted node was
        // allocated by *this's own allocator, so a head-pointer steal is correct
        // and — unlike swap — never propagates the scratch bins' default-
        // constructed allocator into *this under a POCS allocator.
        StealFrom(bins[fill - 1]);
    }
    void sort()
    {
        sort([](const T &a, const T &b) { return a < b; });
    }

    // Classic 3-pointer iterative singly-linked reversal — <list>'s
    // swap-prev/next trick needs a circular anchor and a prev pointer;
    // forward_list is non-circular and has neither.
    void reverse() noexcept
    {
        NodeBase *prev = nullptr;
        NodeBase *cur  = __beforeBegin.next;
        while (cur) {
            NodeBase *next = cur->next;
            cur->next      = prev;
            prev           = cur;
            cur            = next;
        }
        __beforeBegin.next = prev;
    }

private:
    void StealFrom(forward_list &other) noexcept
    {
        __beforeBegin.next       = other.__beforeBegin.next;
        other.__beforeBegin.next = nullptr;
    }

    template <typename... Args>
    NodeT *MakeNode(Args &&...args)
    {
        NodeT *n = NodeTraits::allocate(__alloc, 1);
        try {
            NodeTraits::construct(__alloc, __builtin_addressof(n->value),
                                  std::forward<Args>(args)...);
        } catch (...) {
            NodeTraits::deallocate(__alloc, n, 1);
            throw;
        }
        return n;
    }
    void DropNode(NodeT *n) noexcept
    {
        NodeTraits::destroy(__alloc, __builtin_addressof(n->value));
        NodeTraits::deallocate(__alloc, n, 1);
    }

    NodeBase __beforeBegin;
    [[no_unique_address]] NodeAlloc __alloc;
};

// operator==/operator<=> cannot use a size()-fast-path — forward_list has
// no size(). Walk both lockstep, then decide from which end-iterator (if
// either) hit first: same shape as std::lexicographical_compare's two-end
// form, not a container-comparison shape.
template <typename T, typename A>
bool operator==(const forward_list<T, A> &a, const forward_list<T, A> &b)
{
    auto ia = a.begin();
    auto ib = b.begin();
    for (; ia != a.end() && ib != b.end(); ++ia, ++ib)
        if (!(*ia == *ib)) return false;
    return ia == a.end() && ib == b.end();
}

template <typename T, typename A>
auto operator<=>(const forward_list<T, A> &a, const forward_list<T, A> &b)
    -> __cmp::synth_three_way_result_t<T>
{
    using Cat = __cmp::synth_three_way_result_t<T>;
    auto ia = a.begin();
    auto ib = b.begin();
    for (; ia != a.end() && ib != b.end(); ++ia, ++ib)
        if (auto c = __cmp::SynthThreeWay{}(*ia, *ib); c != 0) return c;
    if (ia == a.end() && ib == b.end()) return Cat::equivalent;
    return ia == a.end() ? Cat::less : Cat::greater;
}

template <typename T, typename A>
void swap(forward_list<T, A> &a, forward_list<T, A> &b) noexcept(noexcept(a.swap(b)))
{
    a.swap(b);
}

template <typename T, typename A, typename V>
typename forward_list<T, A>::size_type erase(forward_list<T, A> &l, const V &value)
{
    return l.remove_if([&](const T &x) { return x == value; });
}
template <typename T, typename A, typename Pred>
typename forward_list<T, A>::size_type erase_if(forward_list<T, A> &l, Pred pred)
{
    return l.remove_if(pred);
}

// ── deduction guides ([forwardlist.deduct]) ───────────────────────────────
// Same shape/rationale as list's guides — see that file.
template <typename It, typename Alloc = allocator<iter_value_t<It>>>
forward_list(It, It, Alloc = Alloc()) -> forward_list<iter_value_t<It>, Alloc>;

template <ranges::input_range R, typename Alloc = allocator<ranges::range_value_t<R>>>
forward_list(from_range_t, R &&, Alloc = Alloc()) -> forward_list<ranges::range_value_t<R>, Alloc>;

} // namespace std

#endif // BOXCXX_FORWARD_LIST
