// <chrono> — C++20 date and time library ([time]).
//
// boxcxx freestanding implementation. Scope: durations, time_points, the
// system/steady/high_resolution clocks (BoxOS ClockBoard + RDTSC), the full
// civil calendar, hh_mm_ss, and <format> integration. Out of scope (like
// locale): time zones (zoned_time/tzdb), leap-second database, wide streams.
#ifndef BOXCXX_CHRONO
#define BOXCXX_CHRONO

#include <ratio>
#include <__bits/chrono_duration>
#include <__bits/chrono_clock>
#include <__bits/chrono_calendar>
#include <__bits/chrono_format>
#include <__bits/chrono_io>

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_chrono_udls
#include <__bits/version_chrono>

#endif // BOXCXX_CHRONO
