    iterator lower_bound(const K &key) { return __t.LowerBound(key); }
    template <typename K>
        requires __detail::TransparentComparator<Comp>
    const_iterator lower_bound(const K &key) const
    {
        return const_cast<multimap *>(this)->__t.LowerBound(key);
    }
    template <typename K>
        requires __detail::TransparentComparator<Comp>
    iterator upper_bound(const K &key) { return __t.UpperBound(key); }
    template <typename K>
        requires __detail::TransparentComparator<Comp>
    const_iterator upper_bound(const K &key) const
    {
        return const_cast<multimap *>(this)->__t.UpperBound(key);
    }
    template <typename K>
        requires __detail::TransparentComparator<Comp>
    pair<iterator, iterator> equal_range(const K &key)
    {
        return {__t.LowerBound(key), __t.UpperBound(key)};
    }
    template <typename K>
        requires __detail::TransparentComparator<Comp>
    pair<const_iterator, const_iterator> equal_range(const K &key) const
    {
        return {lower_bound(key), upper_bound(key)};
    }

    key_compare key_comp() const { return __t.key_comp(); }
    value_compare value_comp() const { return value_compare(__t.key_comp()); }

private:
    TreeT __t;
};

// ── comparisons / erasure ───────────────────────────────────────────────

namespace __rb {

template <typename M>
bool MapEqual(const M &a, const M &b)
{
    if (a.size() != b.size()) return false;
    auto ia = a.begin();
    auto ib = b.begin();
    for (; ia != a.end(); ++ia, ++ib)
        if (!(*ia == *ib)) return false;
    return true;
}

} // namespace __rb

template <typename K, typename T, typename C, typename A>
bool operator==(const map<K, T, C, A> &a, const map<K, T, C, A> &b)
{
    return __rb::MapEqual(a, b);
}
template <typename K, typename T, typename C, typename A>
bool operator==(const multimap<K, T, C, A> &a, const multimap<K, T, C, A> &b)
{
    return __rb::MapEqual(a, b);
}

template <typename K, typename T, typename C, typename A>
void swap(map<K, T, C, A> &a, map<K, T, C, A> &b) noexcept(noexcept(a.swap(b)))
{
    a.swap(b);
}
template <typename K, typename T, typename C, typename A>
void swap(multimap<K, T, C, A> &a, multimap<K, T, C, A> &b) noexcept(noexcept(a.swap(b)))
{
    a.swap(b);
}

template <typename K, typename T, typename C, typename A, typename Pred>
typename map<K, T, C, A>::size_type erase_if(map<K, T, C, A> &m, Pred pred)
{
    typename map<K, T, C, A>::size_type removed = 0;
    for (auto it = m.begin(); it != m.end();) {
        if (pred(*it)) {
            it = m.erase(it);
            ++removed;
        } else {
            ++it;
        }
    }
    return removed;
}

template <typename K, typename T, typename C, typename A, typename Pred>
typename multimap<K, T, C, A>::size_type
erase_if(multimap<K, T, C, A> &m, Pred pred)
{
    typename multimap<K, T, C, A>::size_type removed = 0;
    for (auto it = m.begin(); it != m.end();) {
        if (pred(*it)) {
            it = m.erase(it);
            ++removed;
        } else {
            ++it;
        }
    }
    return removed;
}

// ── deduction guides ([map.deduct] / [multimap.deduct]) ─────────────────
// Iterator-pair and from_range_t forms only. Key/T are deduced through
// __rb::DeductKey/DeductMapped (constrained via iter_value_t, SFINAE-
// friendly), so a non-iterator first argument falls through cleanly. No
// extra disambiguation needed against map's OTHER ctors: the only other
// 2-arg ctor is (const Comp&, const Alloc&), whose Key/T never appear in
// any parameter type, so its implicit guide can never deduce Key/T from a
// call and is never a competing candidate.
template <typename It, typename Comp = less<__rb::DeductKey<It>>,
          typename Alloc = allocator<pair<const __rb::DeductKey<It>, __rb::DeductMapped<It>>>>
map(It, It, Comp = Comp(), Alloc = Alloc())
    -> map<__rb::DeductKey<It>, __rb::DeductMapped<It>, Comp, Alloc>;

template <ranges::input_range R, NotAllocatorLike Comp = less<__rb::DeductRangeKey<R>>,
          typename Alloc = allocator<pair<const __rb::DeductRangeKey<R>, __rb::DeductRangeMapped<R>>>>
map(from_range_t, R &&, Comp = Comp(), Alloc = Alloc())
    -> map<__rb::DeductRangeKey<R>, __rb::DeductRangeMapped<R>, Comp, Alloc>;

// Allocator-only form (no Comp argument at all) — needs its own guide, not
// just a defaulted Comp, because Comp's slot and Alloc's slot would
// otherwise both be viable, unconstrained deduction targets for the same
// 3rd call argument. AllocatorLike/NotAllocatorLike on the two guides
// partitions that argument's type into exactly one matching guide.
template <ranges::input_range R, AllocatorLike Alloc>
map(from_range_t, R &&, Alloc)
    -> map<__rb::DeductRangeKey<R>, __rb::DeductRangeMapped<R>, less<__rb::DeductRangeKey<R>>, Alloc>;

template <typename It, typename Comp = less<__rb::DeductKey<It>>,
          typename Alloc = allocator<pair<const __rb::DeductKey<It>, __rb::DeductMapped<It>>>>
multimap(It, It, Comp = Comp(), Alloc = Alloc())
    -> multimap<__rb::DeductKey<It>, __rb::DeductMapped<It>, Comp, Alloc>;

template <ranges::input_range R, NotAllocatorLike Comp = less<__rb::DeductRangeKey<R>>,
          typename Alloc = allocator<pair<const __rb::DeductRangeKey<R>, __rb::DeductRangeMapped<R>>>>
multimap(from_range_t, R &&, Comp = Comp(), Alloc = Alloc())
    -> multimap<__rb::DeductRangeKey<R>, __rb::DeductRangeMapped<R>, Comp, Alloc>;

template <ranges::input_range R, AllocatorLike Alloc>
multimap(from_range_t, R &&, Alloc)
    -> multimap<__rb::DeductRangeKey<R>, __rb::DeductRangeMapped<R>, less<__rb::DeductRangeKey<R>>, Alloc>;

} // namespace std

#endif // BOXCXX_MAP
