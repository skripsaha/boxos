// (__bits/rb_tree). node_handle extract/insert(node)/merge shipped Ф28a.
#ifndef BOXCXX_MAP
#define BOXCXX_MAP

#include <__bits/rb_tree>
#include <__bits/node_handle>
#include <__bits/ranges_core>
#include <__bits/throw_helpers>
#include <__bits/version_containers>
#include <compare>
#include <functional>
#include <initializer_list>
#include <tuple>
