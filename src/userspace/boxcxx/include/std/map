    {
        return {lower_bound(key), upper_bound(key)};
    }

    // ── heterogeneous lookup (C++23, transparent Comp only) ─────────────

    template <typename K>
        requires __detail::TransparentComparator<Comp>
    iterator find(const K &key) { return __t.Find(key); }
    template <typename K>
        requires __detail::TransparentComparator<Comp>
    const_iterator find(const K &key) const
