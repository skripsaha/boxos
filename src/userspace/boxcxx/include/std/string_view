// boxcxx — <string_view>
// Full C++23 basic_string_view: constexpr throughout, complete find
// family, starts/ends_with + contains, <=> with the type_identity_t
// conversion trick, ""sv literals, FNV-1a hashing. Ranges glue
// (borrowed_range/view markers) arrives with ranges-core in Ф7B.
#ifndef BOXCXX_STRING_VIEW
#define BOXCXX_STRING_VIEW

#include <__bits/char_traits>
#include <__bits/iterator_core>
#include <__bits/throw_helpers>
#include <compare>
#include <cstddef>
#include <functional>
#include <type_traits>

namespace std {

inline size_t __fnv1a_bytes(const void *data, size_t n) noexcept
{
    size_t h        = 14695981039346656037ull;
    const auto *p   = static_cast<const unsigned char *>(data);
    for (size_t i = 0; i < n; ++i) {
        h ^= p[i];
        h *= 1099511628211ull;
    }
    return h;
}

template <typename C, typename Traits = char_traits<C>>
class basic_string_view {
public:
    using traits_type            = Traits;
    using value_type             = C;
    using pointer                = C *;
    using const_pointer          = const C *;
    using reference              = C &;
    using const_reference        = const C &;
    using const_iterator         = const C *;
    using iterator               = const_iterator;
    using const_reverse_iterator = std::reverse_iterator<const_iterator>;
    using reverse_iterator       = const_reverse_iterator;
    using size_type              = size_t;
    using difference_type        = ptrdiff_t;

    static constexpr size_type npos = size_type(-1);

    constexpr basic_string_view() noexcept : __data(nullptr), __size(0) {}
    constexpr basic_string_view(const basic_string_view &) noexcept = default;
    constexpr basic_string_view &
    operator=(const basic_string_view &) noexcept = default;

    constexpr basic_string_view(const C *s)
        : __data(s), __size(Traits::length(s))
    {
    }
    constexpr basic_string_view(const C *s, size_type n) : __data(s), __size(n)
    {
    }
    constexpr basic_string_view(const C *first, const C *last)
        : __data(first), __size(static_cast<size_type>(last - first))
    {
    }
    basic_string_view(nullptr_t) = delete;

    // ── iterators ───────────────────────────────────────────────────────

    constexpr const_iterator begin() const noexcept { return __data; }
    constexpr const_iterator end() const noexcept { return __data + __size; }
    constexpr const_iterator cbegin() const noexcept { return __data; }
    constexpr const_iterator cend() const noexcept { return __data + __size; }
    constexpr const_reverse_iterator rbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    constexpr const_reverse_iterator rend() const noexcept
    {
        return const_reverse_iterator(begin());
    }

    // ── capacity ────────────────────────────────────────────────────────

    constexpr size_type size() const noexcept { return __size; }
    constexpr size_type length() const noexcept { return __size; }
    constexpr size_type max_size() const noexcept
    {
        return size_type(-1) / sizeof(C);
    }
    [[nodiscard]] constexpr bool empty() const noexcept { return __size == 0; }

    // ── element access ──────────────────────────────────────────────────

    constexpr const_reference operator[](size_type i) const
    {
        return __data[i];
    }
    constexpr const_reference at(size_type i) const
    {
        if (i >= __size) boxcxx::ThrowOutOfRange("string_view::at");
        return __data[i];
    }
    constexpr const_reference front() const { return __data[0]; }
    constexpr const_reference back() const { return __data[__size - 1]; }
    constexpr const_pointer data() const noexcept { return __data; }

    // ── modifiers ───────────────────────────────────────────────────────

    constexpr void remove_prefix(size_type n)
    {
        __data += n;
        __size -= n;
    }
    constexpr void remove_suffix(size_type n) { __size -= n; }
    constexpr void swap(basic_string_view &other) noexcept
    {
        basic_string_view tmp = *this;
        *this                 = other;
        other                 = tmp;
    }

    // ── string operations ───────────────────────────────────────────────

    constexpr size_type copy(C *dst, size_type count, size_type pos = 0) const
    {
        if (pos > __size) boxcxx::ThrowOutOfRange("string_view::copy");
        size_type n = Clamp(count, __size - pos);
        Traits::copy(dst, __data + pos, n);
        return n;
    }

    constexpr basic_string_view substr(size_type pos = 0,
                                       size_type count = npos) const
    {
        if (pos > __size) boxcxx::ThrowOutOfRange("string_view::substr");
        return basic_string_view(__data + pos, Clamp(count, __size - pos));
    }

    constexpr int compare(basic_string_view other) const noexcept
    {
        size_type n = __size < other.__size ? __size : other.__size;
        int r       = n == 0 ? 0 : Traits::compare(__data, other.__data, n);
        if (r != 0) return r;
        return __size < other.__size ? -1 : __size > other.__size ? 1 : 0;
    }
    constexpr int compare(size_type pos, size_type count,
                          basic_string_view other) const
    {
        return substr(pos, count).compare(other);
    }
    constexpr int compare(size_type pos1, size_type count1,
                          basic_string_view other, size_type pos2,
                          size_type count2) const
    {
        return substr(pos1, count1).compare(other.substr(pos2, count2));
    }
    constexpr int compare(const C *s) const
    {
        return compare(basic_string_view(s));
    }
    constexpr int compare(size_type pos, size_type count, const C *s) const
    {
        return substr(pos, count).compare(basic_string_view(s));
    }
    constexpr int compare(size_type pos, size_type count, const C *s,
                          size_type n) const
    {
        return substr(pos, count).compare(basic_string_view(s, n));
    }

    constexpr bool starts_with(basic_string_view p) const noexcept
    {
        return __size >= p.__size &&
               (p.__size == 0 ||
                Traits::compare(__data, p.__data, p.__size) == 0);
    }
    constexpr bool starts_with(C c) const noexcept
    {
        return __size > 0 && Traits::eq(__data[0], c);
    }
    constexpr bool starts_with(const C *s) const
    {
        return starts_with(basic_string_view(s));
    }

    constexpr bool ends_with(basic_string_view p) const noexcept
    {
        return __size >= p.__size &&
               (p.__size == 0 || Traits::compare(__data + (__size - p.__size),
                                                 p.__data, p.__size) == 0);
    }
    constexpr bool ends_with(C c) const noexcept
    {
        return __size > 0 && Traits::eq(__data[__size - 1], c);
    }
    constexpr bool ends_with(const C *s) const
    {
        return ends_with(basic_string_view(s));
    }

    constexpr bool contains(basic_string_view p) const noexcept
    {
        return find(p) != npos;
    }
    constexpr bool contains(C c) const noexcept { return find(c) != npos; }
    constexpr bool contains(const C *s) const { return find(s) != npos; }

    // ── find family ─────────────────────────────────────────────────────

    constexpr size_type find(basic_string_view p,
                             size_type pos = 0) const noexcept
    {
        if (p.__size == 0) return pos <= __size ? pos : npos;
        if (p.__size > __size) return npos;
        for (size_type i = pos; i + p.__size <= __size; ++i) {
            if (Traits::eq(__data[i], p.__data[0]) &&
                Traits::compare(__data + i, p.__data, p.__size) == 0)
                return i;
        }
        return npos;
    }
    constexpr size_type find(C c, size_type pos = 0) const noexcept
    {
        if (pos >= __size) return npos;
        const C *hit = Traits::find(__data + pos, __size - pos, c);
        return hit ? static_cast<size_type>(hit - __data) : npos;
    }
    constexpr size_type find(const C *s, size_type pos, size_type n) const
    {
        return find(basic_string_view(s, n), pos);
    }
    constexpr size_type find(const C *s, size_type pos = 0) const
    {
        return find(basic_string_view(s), pos);
    }

    constexpr size_type rfind(basic_string_view p,
                              size_type pos = npos) const noexcept
    {
        if (p.__size > __size) return npos;
        size_type last = __size - p.__size;
        size_type i    = pos < last ? pos : last;
        for (;; --i) {
            if (p.__size == 0 ||
                Traits::compare(__data + i, p.__data, p.__size) == 0)
                return i;
            if (i == 0) return npos;
        }
    }
    // Single-char overloads loop directly: wrapping a pointer to the
    // local parameter in a view trips a GCC 15 constexpr ICE
    // (coerce_template_parms) through __builtin_memcmp, and a 1-byte
    // memcmp has no runtime advantage anyway.
    constexpr size_type rfind(C c, size_type pos = npos) const noexcept
    {
        if (__size == 0) return npos;
        size_type i = pos < __size ? pos : __size - 1;
        for (;; --i) {
            if (Traits::eq(__data[i], c)) return i;
            if (i == 0) return npos;
        }
    }
    constexpr size_type rfind(const C *s, size_type pos, size_type n) const
    {
        return rfind(basic_string_view(s, n), pos);
    }
    constexpr size_type rfind(const C *s, size_type pos = npos) const
    {
        return rfind(basic_string_view(s), pos);
    }

    constexpr size_type find_first_of(basic_string_view set,
                                      size_type pos = 0) const noexcept
    {
        for (size_type i = pos; i < __size; ++i)
            if (set.find(__data[i]) != npos) return i;
        return npos;
    }
    constexpr size_type find_first_of(C c, size_type pos = 0) const noexcept
    {
        return find(c, pos);
    }
    constexpr size_type find_first_of(const C *s, size_type pos,
                                      size_type n) const
    {
        return find_first_of(basic_string_view(s, n), pos);
    }
    constexpr size_type find_first_of(const C *s, size_type pos = 0) const
    {
        return find_first_of(basic_string_view(s), pos);
    }

    constexpr size_type find_last_of(basic_string_view set,
                                     size_type pos = npos) const noexcept
    {
        if (__size == 0) return npos;
        size_type i = pos < __size ? pos : __size - 1;
        for (;; --i) {
            if (set.find(__data[i]) != npos) return i;
            if (i == 0) return npos;
        }
    }
    constexpr size_type find_last_of(C c, size_type pos = npos) const noexcept
    {
        return rfind(c, pos);
    }
    constexpr size_type find_last_of(const C *s, size_type pos,
                                     size_type n) const
    {
        return find_last_of(basic_string_view(s, n), pos);
    }
    constexpr size_type find_last_of(const C *s, size_type pos = npos) const
    {
        return find_last_of(basic_string_view(s), pos);
    }

    constexpr size_type find_first_not_of(basic_string_view set,
                                          size_type pos = 0) const noexcept
    {
        for (size_type i = pos; i < __size; ++i)
            if (set.find(__data[i]) == npos) return i;
        return npos;
    }
    constexpr size_type find_first_not_of(C c,
                                          size_type pos = 0) const noexcept
    {
        for (size_type i = pos; i < __size; ++i)
            if (!Traits::eq(__data[i], c)) return i;
        return npos;
    }
    constexpr size_type find_first_not_of(const C *s, size_type pos,
                                          size_type n) const
    {
        return find_first_not_of(basic_string_view(s, n), pos);
    }
    constexpr size_type find_first_not_of(const C *s, size_type pos = 0) const
    {
        return find_first_not_of(basic_string_view(s), pos);
    }

    constexpr size_type find_last_not_of(basic_string_view set,
                                         size_type pos = npos) const noexcept
    {
        if (__size == 0) return npos;
        size_type i = pos < __size ? pos : __size - 1;
        for (;; --i) {
            if (set.find(__data[i]) == npos) return i;
            if (i == 0) return npos;
        }
    }
    constexpr size_type find_last_not_of(C c,
                                         size_type pos = npos) const noexcept
    {
        if (__size == 0) return npos;
        size_type i = pos < __size ? pos : __size - 1;
        for (;; --i) {
            if (!Traits::eq(__data[i], c)) return i;
            if (i == 0) return npos;
        }
    }
    constexpr size_type find_last_not_of(const C *s, size_type pos,
                                         size_type n) const
    {
        return find_last_not_of(basic_string_view(s, n), pos);
    }
    constexpr size_type find_last_not_of(const C *s, size_type pos = npos) const
    {
        return find_last_not_of(basic_string_view(s), pos);
    }

private:
    static constexpr size_type Clamp(size_type want, size_type have) noexcept
    {
        return want < have ? want : have;
    }

    const C *__data;
    size_type __size;
};

// ── comparisons (type_identity_t enables implicit conversions) ──────────

template <typename C, typename T>
constexpr bool operator==(basic_string_view<C, T> a,
                          type_identity_t<basic_string_view<C, T>> b) noexcept
{
    return a.size() == b.size() && a.compare(b) == 0;
}

template <typename C, typename T>
constexpr strong_ordering
operator<=>(basic_string_view<C, T> a,
            type_identity_t<basic_string_view<C, T>> b) noexcept
{
    int r = a.compare(b);
    return r < 0    ? strong_ordering::less
           : r > 0  ? strong_ordering::greater
                    : strong_ordering::equal;
}

// ── aliases / literals / hashing ────────────────────────────────────────

using string_view    = basic_string_view<char>;
using wstring_view   = basic_string_view<wchar_t>;
using u8string_view  = basic_string_view<char8_t>;
using u16string_view = basic_string_view<char16_t>;
using u32string_view = basic_string_view<char32_t>;

inline namespace literals {
inline namespace string_view_literals {

// The bare `sv` suffix is reserved for the implementation — which this
// header IS; silence the user-code warning exactly like libstdc++ does.
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wliteral-suffix"

constexpr string_view operator""sv(const char *s, size_t n) noexcept
{
    return string_view(s, n);
}
constexpr wstring_view operator""sv(const wchar_t *s, size_t n) noexcept
{
    return wstring_view(s, n);
}
constexpr u8string_view operator""sv(const char8_t *s, size_t n) noexcept
{
    return u8string_view(s, n);
}
constexpr u16string_view operator""sv(const char16_t *s, size_t n) noexcept
{
    return u16string_view(s, n);
}
constexpr u32string_view operator""sv(const char32_t *s, size_t n) noexcept
{
    return u32string_view(s, n);
}

#pragma GCC diagnostic pop

} // namespace string_view_literals
} // namespace literals

template <typename C>
struct hash;

template <>
struct hash<string_view> {
    size_t operator()(string_view v) const noexcept
    {
        return __fnv1a_bytes(v.data(), v.size());
    }
};
template <>
struct hash<wstring_view> {
    size_t operator()(wstring_view v) const noexcept
    {
        return __fnv1a_bytes(v.data(), v.size() * sizeof(wchar_t));
    }
};
template <>
struct hash<u8string_view> {
    size_t operator()(u8string_view v) const noexcept
    {
        return __fnv1a_bytes(v.data(), v.size());
    }
};
template <>
struct hash<u16string_view> {
    size_t operator()(u16string_view v) const noexcept
    {
        return __fnv1a_bytes(v.data(), v.size() * 2);
    }
};
template <>
struct hash<u32string_view> {
    size_t operator()(u32string_view v) const noexcept
    {
        return __fnv1a_bytes(v.data(), v.size() * 4);
    }
};

} // namespace std

#endif // BOXCXX_STRING_VIEW
