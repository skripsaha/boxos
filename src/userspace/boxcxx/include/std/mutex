// boxcxx — <mutex>
//
// std::mutex family over boxlib's umutex_t (box/sync.h) — a futex, not a
// spin lock. A cabin holds many strands, so contention is real: a
// contender spins only long enough to cover a short critical section,
// then parks in the kernel until an unlock wakes it. An uncontended
// lock/unlock pair enters the kernel zero times; a CONTENDED unlock does
// make a syscall, and unlock is destructor-reachable, so ~lock_guard on a
// contended mutex can block for that wake (it cannot fail the unlock —
// the lock word is free before the wake is attempted).
//
// recursive_mutex ownership identity = __boxcxx_thread_id(): the
// address of a thread_local anchor (src/runtime/mutex.cpp) — unique per
// strand, since each strand's thread_local block is its own.
// Mutexes are cabin-private — sharing one across cabins through a Bay
// is outside the std contract (same stance as every libstdc++ build
// without process-shared pthreads).
//
// unique_lock protocol violations throw std::system_error with the
// std-mandated errc codes. recursive_mutex::unlock by a non-owner is UB
// per the standard — boxcxx panics there as a diagnostic.
//
// timed_mutex / recursive_timed_mutex add try_lock_for/try_lock_until over
// umutex_lock_timeout: the park is bounded by what is left of the caller's
// <chrono> deadline, so an unlock wakes the waiter early and an expiry costs
// no spinning. The caller owns the deadline and hands down a fresh budget
// each round; a sub-millisecond remainder rounds up to 1 ms, because 0 means
// "forever" to the park.
// Only the lightweight <chrono> duration/clock bits are pulled in — not the
// calendar/format machinery — so <mutex> stays a cheap include.
#ifndef BOXCXX_MUTEX
#define BOXCXX_MUTEX

#include "box/sync.h"

#include <__bits/chrono_clock>
#include <__bits/chrono_duration>
#include <atomic>
#include <functional>
#include <system_error>
#include <tuple>
#include <utility>

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_scoped_lock
#include <__bits/version_mutex>

extern "C" void *__boxcxx_thread_id() noexcept;

namespace boxcxx {
[[noreturn]] void Panic(const char *msg);
}

namespace std {

namespace __mutex_impl {

// Remaining time until `abs` as a millisecond budget for a timed kernel park
// (umutex_lock_timeout / __boxcxx_atomic_wait_until), clamped to
// [0, UINT32_MAX]. 0 ⇒ the deadline has already passed; sub-millisecond
// remainders round up to 1 so the caller parks-with-budget rather than
// busy-looping the final fraction — and so it never hands 0 to a park, where
// that value means "wait forever".
template <typename Clock, typename Duration>
inline unsigned RemainingMs(const chrono::time_point<Clock, Duration> &abs) noexcept
{
    auto now = Clock::now();
    if (now >= abs) return 0;
    auto ms = chrono::duration_cast<chrono::milliseconds>(abs - now).count();
    if (ms <= 0) return 1;
    if (ms > 0xFFFFFFFFLL) return 0xFFFFFFFFu;
    return static_cast<unsigned>(ms);
}

} // namespace __mutex_impl

// ── mutex / recursive_mutex ─────────────────────────────────────────────

class mutex {
public:
    constexpr mutex() noexcept : __m{0, 0} {}
    ~mutex() = default;
    mutex(const mutex &) = delete;
    mutex &operator=(const mutex &) = delete;

    void lock() { umutex_lock(&__m); }
    bool try_lock() noexcept { return umutex_trylock(&__m); }
    void unlock() { umutex_unlock(&__m); }

    using native_handle_type = umutex_t *;
    native_handle_type native_handle() noexcept { return &__m; }

private:
    umutex_t __m;
};

class recursive_mutex {
public:
    recursive_mutex() noexcept : __m{0, 0} {}
    ~recursive_mutex() = default;
    recursive_mutex(const recursive_mutex &) = delete;
    recursive_mutex &operator=(const recursive_mutex &) = delete;

    void lock()
    {
        void *self = __boxcxx_thread_id();
        if (__owner.load(memory_order_relaxed) == self) {
            ++__depth;
            return;
        }
        umutex_lock(&__m);
        __owner.store(self, memory_order_relaxed);
        __depth = 1;
    }

    bool try_lock() noexcept
    {
        void *self = __boxcxx_thread_id();
        if (__owner.load(memory_order_relaxed) == self) {
            ++__depth;
            return true;
        }
        if (!umutex_trylock(&__m)) return false;
        __owner.store(self, memory_order_relaxed);
        __depth = 1;
        return true;
    }

    void unlock()
    {
        if (__owner.load(memory_order_relaxed) != __boxcxx_thread_id())
            boxcxx::Panic("recursive_mutex::unlock: not owner");
        if (--__depth == 0) {
            __owner.store(nullptr, memory_order_relaxed);
            umutex_unlock(&__m);
        }
    }

    using native_handle_type = umutex_t *;
    native_handle_type native_handle() noexcept { return &__m; }

private:
    umutex_t __m;
    atomic<void *> __owner{nullptr};
    unsigned __depth = 0;
};

// ── timed_mutex / recursive_timed_mutex ─────────────────────────────────

class timed_mutex {
public:
    timed_mutex() noexcept : __m{0, 0} {}
    ~timed_mutex() = default;
    timed_mutex(const timed_mutex &) = delete;
    timed_mutex &operator=(const timed_mutex &) = delete;

    void lock() { umutex_lock(&__m); }
    bool try_lock() noexcept { return umutex_trylock(&__m); }
    void unlock() { umutex_unlock(&__m); }

    template <typename Rep, typename Period>
    bool try_lock_for(const chrono::duration<Rep, Period> &rel)
    {
        return try_lock_until(chrono::steady_clock::now() + rel);
    }

    template <typename Clock, typename Duration>
    bool try_lock_until(const chrono::time_point<Clock, Duration> &abs)
    {
        // One attempt always happens, even for a deadline already in the past:
        // a free mutex must still be acquired, exactly as before.
        if (umutex_trylock(&__m)) return true;
        for (;;) {
            // Then the park is bounded by what is left of the deadline, so an
            // unlock wakes us early and an expiry costs no spinning.
            unsigned ms = __mutex_impl::RemainingMs(abs);
            if (ms == 0) {
                // We may have been handed the single wake an unlock issued and
                // then run out of budget. Pass it on rather than leave a
                // sibling asleep on a free mutex.
                umutex_wake_waiter(&__m);
                return false;
            }
            if (umutex_lock_timeout(&__m, ms)) return true;
        }
    }

    using native_handle_type = umutex_t *;
    native_handle_type native_handle() noexcept { return &__m; }

private:
    umutex_t __m;
};

class recursive_timed_mutex {
public:
    recursive_timed_mutex() noexcept : __m{0, 0} {}
    ~recursive_timed_mutex() = default;
    recursive_timed_mutex(const recursive_timed_mutex &) = delete;
    recursive_timed_mutex &operator=(const recursive_timed_mutex &) = delete;

    void lock()
    {
        void *self = __boxcxx_thread_id();
        if (__owner.load(memory_order_relaxed) == self) {
            ++__depth;
            return;
        }
        umutex_lock(&__m);
        __owner.store(self, memory_order_relaxed);
        __depth = 1;
    }

    bool try_lock() noexcept
    {
        void *self = __boxcxx_thread_id();
        if (__owner.load(memory_order_relaxed) == self) {
            ++__depth;
            return true;
        }
        if (!umutex_trylock(&__m)) return false;
        __owner.store(self, memory_order_relaxed);
        __depth = 1;
        return true;
    }

    template <typename Rep, typename Period>
    bool try_lock_for(const chrono::duration<Rep, Period> &rel)
    {
        return try_lock_until(chrono::steady_clock::now() + rel);
    }

    template <typename Clock, typename Duration>
    bool try_lock_until(const chrono::time_point<Clock, Duration> &abs)
    {
        void *self = __boxcxx_thread_id();
        if (__owner.load(memory_order_relaxed) == self) {
            ++__depth;
            return true;
        }
        // One attempt always happens, even for an expired deadline (see
        // timed_mutex::try_lock_until).
        if (umutex_trylock(&__m)) {
            __owner.store(self, memory_order_relaxed);
            __depth = 1;
            return true;
        }
        for (;;) {
            unsigned ms = __mutex_impl::RemainingMs(abs);
            if (ms == 0) {
                umutex_wake_waiter(&__m);   // see timed_mutex::try_lock_until
                return false;
            }
            if (umutex_lock_timeout(&__m, ms)) {
                __owner.store(self, memory_order_relaxed);
                __depth = 1;
                return true;
            }
        }
    }

    void unlock()
    {
        if (__owner.load(memory_order_relaxed) != __boxcxx_thread_id())
            boxcxx::Panic("recursive_timed_mutex::unlock: not owner");
        if (--__depth == 0) {
            __owner.store(nullptr, memory_order_relaxed);
            umutex_unlock(&__m);
        }
    }

    using native_handle_type = umutex_t *;
    native_handle_type native_handle() noexcept { return &__m; }

private:
    umutex_t __m;
    atomic<void *> __owner{nullptr};
    unsigned __depth = 0;
};

// ── lock tags ───────────────────────────────────────────────────────────

struct defer_lock_t {
    explicit defer_lock_t() = default;
};
struct try_to_lock_t {
    explicit try_to_lock_t() = default;
};
struct adopt_lock_t {
    explicit adopt_lock_t() = default;
};

inline constexpr defer_lock_t  defer_lock{};
inline constexpr try_to_lock_t try_to_lock{};
inline constexpr adopt_lock_t  adopt_lock{};

// ── lock_guard ──────────────────────────────────────────────────────────

template <typename Mutex>
class lock_guard {
public:
    using mutex_type = Mutex;

    explicit lock_guard(mutex_type &m) : __m(m) { __m.lock(); }
    lock_guard(mutex_type &m, adopt_lock_t) noexcept : __m(m) {}
    ~lock_guard() { __m.unlock(); }

    lock_guard(const lock_guard &) = delete;
    lock_guard &operator=(const lock_guard &) = delete;

private:
    mutex_type &__m;
};

// ── unique_lock ─────────────────────────────────────────────────────────

template <typename Mutex>
class unique_lock {
public:
    using mutex_type = Mutex;

    unique_lock() noexcept : __m(nullptr), __owns(false) {}
    explicit unique_lock(mutex_type &m) : __m(&m), __owns(false)
    {
        __m->lock();
        __owns = true;
    }
    unique_lock(mutex_type &m, defer_lock_t) noexcept
        : __m(&m), __owns(false)
    {
    }
    unique_lock(mutex_type &m, try_to_lock_t)
        : __m(&m), __owns(m.try_lock())
    {
    }
    unique_lock(mutex_type &m, adopt_lock_t) : __m(&m), __owns(true) {}

    ~unique_lock()
    {
        if (__owns) __m->unlock();
    }

    unique_lock(const unique_lock &) = delete;
    unique_lock &operator=(const unique_lock &) = delete;

    unique_lock(unique_lock &&other) noexcept
        : __m(other.__m), __owns(other.__owns)
    {
        other.__m    = nullptr;
        other.__owns = false;
    }
    unique_lock &operator=(unique_lock &&other) noexcept
    {
        if (__owns) __m->unlock();
        __m          = other.__m;
        __owns       = other.__owns;
        other.__m    = nullptr;
        other.__owns = false;
        return *this;
    }

    void lock()
    {
        if (!__m)
            throw system_error(make_error_code(errc::operation_not_permitted),
                               "unique_lock::lock: no mutex");
        if (__owns)
            throw system_error(
                make_error_code(errc::resource_deadlock_would_occur),
                "unique_lock::lock");
        __m->lock();
        __owns = true;
    }

    bool try_lock()
    {
        if (!__m)
            throw system_error(make_error_code(errc::operation_not_permitted),
                               "unique_lock::try_lock: no mutex");
        if (__owns)
            throw system_error(
                make_error_code(errc::resource_deadlock_would_occur),
                "unique_lock::try_lock");
        __owns = __m->try_lock();
        return __owns;
    }

    template <typename Rep, typename Period>
    bool try_lock_for(const chrono::duration<Rep, Period> &rel)
    {
        if (!__m)
            throw system_error(make_error_code(errc::operation_not_permitted),
                               "unique_lock::try_lock_for: no mutex");
        if (__owns)
            throw system_error(
                make_error_code(errc::resource_deadlock_would_occur),
                "unique_lock::try_lock_for");
        __owns = __m->try_lock_for(rel);
        return __owns;
    }

    template <typename Clock, typename Duration>
    bool try_lock_until(const chrono::time_point<Clock, Duration> &abs)
    {
        if (!__m)
            throw system_error(make_error_code(errc::operation_not_permitted),
                               "unique_lock::try_lock_until: no mutex");
        if (__owns)
            throw system_error(
                make_error_code(errc::resource_deadlock_would_occur),
                "unique_lock::try_lock_until");
        __owns = __m->try_lock_until(abs);
        return __owns;
    }

    void unlock()
    {
        if (!__owns)
            throw system_error(make_error_code(errc::operation_not_permitted),
                               "unique_lock::unlock: does not own");
        __m->unlock();
        __owns = false;
    }

    void swap(unique_lock &other) noexcept
    {
        mutex_type *m = __m;
        bool owns     = __owns;
        __m           = other.__m;
        __owns        = other.__owns;
        other.__m     = m;
        other.__owns  = owns;
    }

    mutex_type *release() noexcept
    {
        mutex_type *m = __m;
        __m           = nullptr;
        __owns        = false;
        return m;
    }

    [[nodiscard]] bool owns_lock() const noexcept { return __owns; }
    explicit operator bool() const noexcept { return __owns; }
    mutex_type *mutex() const noexcept { return __m; }

private:
    mutex_type *__m;
    bool __owns;
};

template <typename Mutex>
inline void swap(unique_lock<Mutex> &a, unique_lock<Mutex> &b) noexcept
{
    a.swap(b);
}

// ── lock algorithms ([thread.lock.algorithm]) ───────────────────────────

namespace __mutex_impl {

inline int TryLockFrom(int) noexcept
{
    return -1;
}

template <typename L1, typename... Ls>
int TryLockFrom(int idx, L1 &l1, Ls &...rest)
{
    if (!l1.try_lock()) return idx;
    int failed = TryLockFrom(idx + 1, rest...);
    if (failed != -1) l1.unlock();
    return failed;
}

} // namespace __mutex_impl

// Returns -1 on success, else the 0-based index of the lock that
// failed; every previously acquired lock is released again.
template <typename L1, typename L2, typename... Ls>
int try_lock(L1 &l1, L2 &l2, Ls &...rest)
{
    return __mutex_impl::TryLockFrom(0, l1, l2, rest...);
}

// Deadlock-free multi-lock: block on the first, try the rest; on any
// failure release everything and retry — no hold-and-wait, so two
// callers locking overlapping sets in any order cannot deadlock.
template <typename L1, typename L2, typename... Ls>
void lock(L1 &l1, L2 &l2, Ls &...rest)
{
    for (;;) {
        l1.lock();
        int failed = __mutex_impl::TryLockFrom(1, l2, rest...);
        if (failed == -1) return;
        l1.unlock();
        yield();
    }
}

// ── scoped_lock ─────────────────────────────────────────────────────────

// [thread.lock.scoped] gives scoped_lock a `mutex_type` typedef, but only
// when it holds exactly one mutex — "Only if sizeof...(MutexTypes) == 1", a
// conditional member rather than a partial specialization. Supplying it from
// a base keeps the single lock implementation the file already has, instead
// of duplicating the constructor/destructor pair to get one typedef. Until
// Ф31e-d the typedef was simply missing, so generic code spelling
// `typename Lock::mutex_type` -- the whole reason it is specified -- did not
// compile for scoped_lock, while it did for lock_guard and unique_lock.
namespace __mutex_impl {
template <typename... Mutexes>
struct ScopedMutexType {};
template <typename Mutex>
struct ScopedMutexType<Mutex> {
    using mutex_type = Mutex;
};
} // namespace __mutex_impl

template <typename... Mutexes>
class scoped_lock : public __mutex_impl::ScopedMutexType<Mutexes...> {
public:
    explicit scoped_lock(Mutexes &...ms) : __ms(ms...)
    {
        if constexpr (sizeof...(Mutexes) == 1)
            (ms.lock(), ...);
        else if constexpr (sizeof...(Mutexes) > 1)
            std::lock(ms...);
    }
    explicit scoped_lock(adopt_lock_t, Mutexes &...ms) : __ms(ms...) {}

    ~scoped_lock()
    {
        apply([](Mutexes &...ms) { (ms.unlock(), ...); }, __ms);
    }

    scoped_lock(const scoped_lock &) = delete;
    scoped_lock &operator=(const scoped_lock &) = delete;

private:
    tuple<Mutexes &...> __ms;
};

template <>
class scoped_lock<> {
public:
    explicit scoped_lock() = default;
    explicit scoped_lock(adopt_lock_t) {}
    scoped_lock(const scoped_lock &) = delete;
    scoped_lock &operator=(const scoped_lock &) = delete;
};

// ── call_once ([thread.once]) ───────────────────────────────────────────

struct once_flag {
    constexpr once_flag() noexcept = default;
    once_flag(const once_flag &) = delete;
    once_flag &operator=(const once_flag &) = delete;

private:
    mutex __m;
    atomic<bool> __done{false};

    template <typename Callable, typename... Args>
    friend void call_once(once_flag &flag, Callable &&f, Args &&...args);
};

// An invocation that exits via exception leaves the flag passive — the
// next call_once runs its callable ([thread.once.callonce]).
template <typename Callable, typename... Args>
void call_once(once_flag &flag, Callable &&f, Args &&...args)
{
    if (flag.__done.load(memory_order_acquire)) return;
    lock_guard<mutex> guard(flag.__m);
    if (flag.__done.load(memory_order_relaxed)) return;
    invoke(forward<Callable>(f), forward<Args>(args)...);
    flag.__done.store(true, memory_order_release);
}

} // namespace std

#endif // BOXCXX_MUTEX
