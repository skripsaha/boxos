// boxcxx — <flat_map>
// flat_map / flat_multimap ([flat.map], [flat.multimap]): sorted-container
// adaptors over TWO parallel containers (keys, values), not one -- so where
// flat_set's engine sorts a single range, this one has to keep a pair of
// sequences in lockstep through every sort, merge and dedup, and restore
// BOTH of them together the moment [flat.map.overview]/5.1 (same number of
// keys and values) breaks.
//
// The lockstep problem is solved by one class, Yoke: a random-access cursor
// over (KeyIt, MappedIt) that dereferences to pair<KeyRef,MappedRef> and
// moves/swaps both halves together via iter_move/iter_swap. It plays three
// roles through its own template parameters, plus a phantom Derived tag
// (below) that keeps those roles distinct across specializations:
//   iterator       = Yoke<CKeyIt, MapIt,  const Key&, T&,       Derived>
//   const_iterator = Yoke<CKeyIt, CMapIt, const Key&, const T&, Derived>
//   MutYoke        = Yoke<KeyIt,  MapIt,  Key&,       T&,       Derived>   (engine only)
// The key half is CKeyIt in every public role: [flat.map.defn] spells
// reference as pair<const key_type&, mapped_type&>, so the key is never
// mutable through any public iterator, only the mapped value is. De-risked
// by a standalone probe (27 static_assert, 0 failures) covering
// random_access_iterator on all three roles, sortable/permutable on
// MutYoke, !sortable/!permutable on the public iterator, and the
// [iterator.traits]/3.2 synthesis this class leans on for iterator_category
// and value_type instead of writing either by hand.
//
// As with <flat_set>, the behaviour lives once in __flat::MapImpl and each
// class is a facade that derives from it PRIVATELY and re-exports its
// surface by name; `friend Impl` lets the engine reach back into the facade
// for the hidden-friend comparisons and the static_cast<Derived&> in
// operator=. Multi switches: SortedT (which tag the constructors accept),
// the return type of emplace/insert (pair<iterator,bool> vs iterator),
// lower_bound vs upper_bound as the insertion point, the dedup pass (unique
// side only), and at/operator[]/try_emplace/insert_or_assign, which
// [flat.multimap.defn] does not have at all.
//
// iterator_category is deliberately NOT declared on Yoke: reference is a
// PRVALUE pair, not a real reference, so [iterator.traits]/3.2 synthesizes
// input_iterator_tag for it -- the conformant answer (libstdc++ agrees;
// libc++ overstates it to random_access_iterator_tag). iter_move IS given
// to the public iterator too, not just the engine cursor -- both reference
// libraries leave the default prvalue-returning path in place instead,
// which makes ranges::move(m, out) silently COPY every value. That is a
// deliberate departure from both, recorded in CONFORMANCE.md (Ф31d), not
// repeated here.
#ifndef BOXCXX_FLAT_MAP
#define BOXCXX_FLAT_MAP

#include <__bits/flat_engine>
#include <__bits/ranges_core>
#include <__bits/version_flat_map>
#include <compare>
#include <functional>
#include <initializer_list>
#include <memory>
#include <stdexcept>
#include <utility>
#include <vector>

namespace std {

template <typename Key, typename T, typename Compare = less<Key>,
          typename KeyContainer = vector<Key>, typename MappedContainer = vector<T>>
class flat_map;
template <typename Key, typename T, typename Compare = less<Key>,
          typename KeyContainer = vector<Key>, typename MappedContainer = vector<T>>
class flat_multimap;

namespace __flat {

// [container.adaptors.general]/6's exposition-only iter-key-type / iter-
// mapped-type / range-key-type / range-mapped-type -- the spellings
// flat_map's and flat_multimap's own deduction guides are written in
// ([flat.map.syn]). The asymmetry is the standard's own, not an accident:
// the iterator forms strip const off tuple_element_t<0,...>, the range
// forms strip it off range_value_t<R>::first_type directly, and neither
// mapped-type form strips anything at all.
template <typename It>
using IterKeyType = remove_const_t<tuple_element_t<0, typename iterator_traits<It>::value_type>>;
template <typename It>
using IterMappedType = tuple_element_t<1, typename iterator_traits<It>::value_type>;
template <typename R>
using RangeKeyType = remove_const_t<typename ranges::range_value_t<R>::first_type>;
template <typename R>
using RangeMappedType = typename ranges::range_value_t<R>::second_type;

// ── two-container invariant restore ([flat.map.overview]/6) ─────────────
// flat_map's invariant additionally requires c.keys.size() == c.values.size()
// (5.1), so restoring it after an exception has to watch BOTH containers --
// flat_engine's own single-container RestoreGuard/RestoreIfTouched cannot
// see the exact failure [flat.map.overview]/5.1 exists to name: a key that
// landed while its paired value's insertion then threw.

template <typename KeyContainer, typename MappedContainer>
class RestoreBothGuard {
public:
    RestoreBothGuard(KeyContainer &k, MappedContainer &v) noexcept : keys(&k), values(&v) {}
    ~RestoreBothGuard()
    {
        if (keys) {
            keys->clear();
            values->clear();
        }
    }
    void Done() noexcept { keys = nullptr; }

    RestoreBothGuard(const RestoreBothGuard &)            = delete;
    RestoreBothGuard &operator=(const RestoreBothGuard &) = delete;

private:
    KeyContainer    *keys;
    MappedContainer *values;
};

// FOR INSERTION ONLY. Clears only when either container's size actually
// moved off entry -- the two-container analogue of flat_engine's
// RestoreIfTouched, and for the same reason: a single-element insert touches
// keys and values through two SEPARATE container calls, and the second one
// can throw after the first already committed. Measured against both
// reference libraries (inv.cpp): libc++ leaves keys.size() != values.size()
// in exactly this spot -- not a crash, a silent one-slot shift of every
// value after the insertion point.
//
// Size is a sound discriminator for insertion because vector::insert commits
// the size BEFORE the risky part: it appends through emplace_back and then
// rotates the new element into place (vector:382-389), so a throw during the
// rotate has already moved size to n+1 and is seen here. Either neither
// container grew (nothing was touched, both still agree with entry and the
// keys are still sorted) or one did (the outcome is unknown and both must be
// emptied).
//
// ‼ It is NOT sound for erasure, and erase must use RestoreBothGuard
// instead. vector::erase runs its shift loop FIRST and only then does
// __size -= n (vector:451-454), so a key whose move-assignment throws
// mid-shift leaves the size UNCHANGED with a moved-from husk spliced into
// the middle of a no-longer-sorted range -- invariants 5.2 and 5.3 broken
// while this guard sees "nothing happened" and lets it stand. flat_set
// already draws the same line: RestoreIfTouched for PlaceAt, the
// unconditional RestoreGuard for all three of its erase paths.
template <typename KeyContainer, typename MappedContainer>
class RestoreBothIfTouched {
public:
    RestoreBothIfTouched(KeyContainer &k, MappedContainer &v) noexcept
        : keys(&k), values(&v), entry(k.size())
    {
    }
    ~RestoreBothIfTouched()
    {
        // Every insertion site below places the key FIRST, so the
        // keys->size() disjunct is the one that always fires today; the
        // values->size() disjunct is a guard against a future call site
        // that reorders the two placements, not something the current
        // code path reaches.
        if (keys && (keys->size() != entry || values->size() != entry)) {
            keys->clear();
            values->clear();
        }
    }
    void Done() noexcept { keys = nullptr; }

    RestoreBothIfTouched(const RestoreBothIfTouched &)            = delete;
    RestoreBothIfTouched &operator=(const RestoreBothIfTouched &) = delete;

private:
    KeyContainer                    *keys;
    MappedContainer                 *values;
    typename KeyContainer::size_type entry;
};

// ── Yoke ──────────────────────────────────────────────────────────────
// One harness, two oxen in step: [flat.map.overview]/5.3 requires the value
// at offset off in c.values to stay the one associated with the key at
// offset off in c.keys, so any sort/merge/dedup over the pair sequence has
// to move both halves together or the invariant breaks mid-algorithm.
//
// Tag is a phantom parameter, never touched in the body: the cursor's real
// shape (KeyIt, MappedIt, KeyRef, MappedRef) depends on neither Compare nor
// Multi, so without Tag flat_map<K,T>::iterator and flat_multimap<K,T>::
// iterator -- or the iterators of two maps differing only by comparator --
// would be the SAME type, letting an iterator from one specialization pass
// where another's is expected. MapImpl passes its own Derived, so every
// distinct specialization gets a distinct iterator family.
template <typename KeyIt, typename MappedIt, typename KeyRef, typename MappedRef, typename Tag>
class Yoke {
public:
    using value_type       = pair<iter_value_t<KeyIt>, iter_value_t<MappedIt>>;
    using difference_type  = ptrdiff_t;
    using reference        = pair<KeyRef, MappedRef>;
    // iterator_concept only, on purpose: declaring iterator_category here
    // would skip [iterator.traits]/3.2's synthesis and force the
    // input-vs-random-access answer to be written by hand instead of
    // derived from the fact that reference is a prvalue pair.
    using iterator_concept = random_access_iterator_tag;

    Yoke() = default;
    Yoke(KeyIt k, MappedIt v) : key(k), val(v) {}

    // iterator must convert to const_iterator; const_iterator must not
    // convert back. Both directions fall out of ONE constraint -- whether
    // the source's own component iterators convert to this Yoke's -- rather
    // than a hand-written exclusion: a mutable mapped iterator converts to
    // its own const_iterator, a const one never converts back to mutable.
    template <typename OtherKeyIt, typename OtherMappedIt, typename OtherKeyRef, typename OtherMappedRef>
        requires is_convertible_v<OtherKeyIt, KeyIt> && is_convertible_v<OtherMappedIt, MappedIt>
    Yoke(const Yoke<OtherKeyIt, OtherMappedIt, OtherKeyRef, OtherMappedRef, Tag> &other)
        : key(other.key), val(other.val)
    {
    }

    reference operator*() const { return reference(*key, *val); }
    reference operator[](difference_type n) const { return *(*this + n); }

    // *it is a prvalue pair, so it->second needs the classic arrow-proxy:
    // materialize the pair, hand back a pointer into the temporary. Yoke
    // declares no `pointer` member, so [iterator.traits]/3.2.1 picks this
    // proxy up as the synthesized pointer type -- an implementation-defined
    // choice the standard leaves open either way (libstdc++ does the same
    // for its own flat_map iterator).
    class ArrowProxy {
    public:
        explicit ArrowProxy(reference r) : ref(std::move(r)) {}
        reference *operator->() { return &ref; }

    private:
        reference ref;
    };
    ArrowProxy operator->() const { return ArrowProxy(**this); }

    Yoke &operator++()
    {
        ++key, ++val;
        return *this;
    }
    Yoke operator++(int)
    {
        Yoke t = *this;
        ++*this;
        return t;
    }
    Yoke &operator--()
    {
        --key, --val;
        return *this;
    }
    Yoke operator--(int)
    {
        Yoke t = *this;
        --*this;
        return t;
    }
    Yoke &operator+=(difference_type n)
    {
        key += n, val += n;
        return *this;
    }
    Yoke &operator-=(difference_type n)
    {
        key -= n, val -= n;
        return *this;
    }

    friend Yoke operator+(Yoke c, difference_type n) { return c += n; }
    friend Yoke operator+(difference_type n, Yoke c) { return c += n; }
    friend Yoke operator-(Yoke c, difference_type n) { return c -= n; }
    friend difference_type operator-(const Yoke &a, const Yoke &b) { return a.key - b.key; }
    friend bool operator==(const Yoke &a, const Yoke &b) { return a.key == b.key; }
    friend auto operator<=>(const Yoke &a, const Yoke &b) { return a.key <=> b.key; }

    // Built from the REFERENCE types, not the value types: the public
    // iterator's key half is const Key&, whose rvalue form is const Key&&
    // (nothing to steal), not Key&&. iter_value_t<KeyIt>&& is a hard error
    // the moment ranges::iter_move touches the public iterator.
    using RvalRef = pair<remove_reference_t<KeyRef> &&, remove_reference_t<MappedRef> &&>;
    friend RvalRef iter_move(const Yoke &c) { return RvalRef(std::move(*c.key), std::move(*c.val)); }
    friend void iter_swap(const Yoke &a, const Yoke &b)
    {
        ranges::swap(*a.key, *b.key);
        ranges::swap(*a.val, *b.val);
    }

    KeyIt    key{};
    MappedIt val{};
};

// ── sort/merge support ───────────────────────────────────────────────────
// Comparisons over a Yoke range go by KEY alone; moves go by the whole pair.
// ProjectKey is the projection that gives ranges::sort/lower_bound/unique
// the key half of *it without materializing anything.
struct ProjectKey {
    template <typename P>
    decltype(auto) operator()(P &&p) const
    {
        return (std::forward<P>(p).first);
    }
};

// flat_engine's MergeRuns takes a single comparator with no projection
// parameter, so the merge needs a comparator that already knows to look at
// .first -- one machine shared by the ctor's sort+merge+dedup and every
// range-insert's sort+merge+dedup, rather than a second copy of MergeRuns
// rewritten for pairs.
template <typename Compare>
struct PairKeyLess {
    Compare comp;
    template <typename A, typename B>
    bool operator()(const A &a, const B &b) const
    {
        return comp(a.first, b.first);
    }
};

// ── the engine ────────────────────────────────────────────────────────
// Multi == false is [flat.map], Multi == true is [flat.multimap]. As in
// b-1, every difference between the two clauses is a branch on Multi: which
// ordering tag the constructors accept (SortedT), the return type of
// emplace/insert, lower_bound vs upper_bound as the insertion point, the
// dedup pass (unique side only), and at/operator[]/try_emplace/
// insert_or_assign, which [flat.multimap.defn] does not declare at all.

template <typename Key, typename T, typename Compare, typename KeyContainer, typename MappedContainer,
          bool Multi>
class MapImpl {
    // [flat.map.overview]/8 is the ill-formedness rule the clause states,
    // twice over: once per container.
    static_assert(is_same_v<Key, typename KeyContainer::value_type>,
                  "[flat.map.overview]/8: Key must denote KeyContainer::value_type");
    static_assert(is_same_v<T, typename MappedContainer::value_type>,
                  "[flat.map.overview]/8: T must denote MappedContainer::value_type");

    using Derived = conditional_t<Multi, flat_multimap<Key, T, Compare, KeyContainer, MappedContainer>,
                                         flat_map<Key, T, Compare, KeyContainer, MappedContainer>>;
    using SortedT = conditional_t<Multi, sorted_equivalent_t, sorted_unique_t>;

    using KeyIt  = typename KeyContainer::iterator;
    using CKeyIt = typename KeyContainer::const_iterator;
    using MapIt  = typename MappedContainer::iterator;
    using CMapIt = typename MappedContainer::const_iterator;

public:
    using key_type    = Key;
    using mapped_type = T;
    using value_type  = pair<key_type, mapped_type>;
    using key_compare = Compare;
    using reference       = pair<const key_type &, mapped_type &>;
    using const_reference = pair<const key_type &, const mapped_type &>;
    // Fixed, NOT taken from the containers: unlike flat_set's size_type
    // (which is KeyContainer::size_type), [flat.map.defn] spells these
    // size_t/ptrdiff_t outright.
    using size_type       = size_t;
    using difference_type = ptrdiff_t;
    using iterator               = Yoke<CKeyIt, MapIt, const key_type &, mapped_type &, Derived>;
    using const_iterator         = Yoke<CKeyIt, CMapIt, const key_type &, const mapped_type &, Derived>;
    using reverse_iterator       = std::reverse_iterator<iterator>;
    using const_reverse_iterator = std::reverse_iterator<const_iterator>;
    using key_container_type    = KeyContainer;
    using mapped_container_type = MappedContainer;

    // [flat.map.defn]: a nested class whose constructor is private, so
    // value_comp() below is the only way to obtain one. friend MapImpl
    // grants exactly that one caller access -- a nested class gets no
    // special access to its enclosing class's members, or the reverse,
    // without saying so.
    class value_compare {
        friend class MapImpl;
        key_compare comp;
        value_compare(key_compare c) : comp(c) {}

    public:
        bool operator()(const_reference x, const_reference y) const { return comp(x.first, y.first); }
    };

    // [flat.map.defn]/1: "has no base classes or members other than those
    // specified" -- a plain aggregate, so extract()/replace() can move it
    // whole and erase_if can rebuild one without touching MapImpl at all.
    struct containers {
        key_container_type    keys;
        mapped_container_type values;
    };

    // ── [flat.map.cons] / [flat.multimap.cons] ──────────────────────────
    // The tag-less container forms sort (and, for the unique side, dedup);
    // the tagged forms take the caller's word for it and only move. The
    // allocator forms are "equivalent to the corresponding non-allocator
    // constructor except that c.keys and c.values are constructed with
    // uses-allocator construction", which is MakeUsingAlloc applied to each
    // container independently.

    MapImpl() : MapImpl(key_compare()) {}

    MapImpl(key_container_type key_cont, mapped_container_type mapped_cont,
            const key_compare &comp = key_compare())
        : c{std::move(key_cont), std::move(mapped_cont)}, compare(comp)
    {
        SortAndDedupWhole();
    }
    template <typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(const key_container_type &key_cont, const mapped_container_type &mapped_cont, const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a, key_cont), MakeUsingAlloc<MappedContainer>(a, mapped_cont)},
          compare()
    {
        SortAndDedupWhole();
    }
    template <typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(const key_container_type &key_cont, const mapped_container_type &mapped_cont,
            const key_compare &comp, const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a, key_cont), MakeUsingAlloc<MappedContainer>(a, mapped_cont)},
          compare(comp)
    {
        SortAndDedupWhole();
    }

    MapImpl(SortedT, key_container_type key_cont, mapped_container_type mapped_cont,
            const key_compare &comp = key_compare())
        : c{std::move(key_cont), std::move(mapped_cont)}, compare(comp)
    {
    }
    template <typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(SortedT, const key_container_type &key_cont, const mapped_container_type &mapped_cont,
            const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a, key_cont), MakeUsingAlloc<MappedContainer>(a, mapped_cont)},
          compare()
    {
    }
    template <typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(SortedT, const key_container_type &key_cont, const mapped_container_type &mapped_cont,
            const key_compare &comp, const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a, key_cont), MakeUsingAlloc<MappedContainer>(a, mapped_cont)},
          compare(comp)
    {
    }

    explicit MapImpl(const key_compare &comp) : c(), compare(comp) {}
    template <typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(const key_compare &comp, const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a), MakeUsingAlloc<MappedContainer>(a)}, compare(comp)
    {
    }
    template <typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    explicit MapImpl(const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a), MakeUsingAlloc<MappedContainer>(a)}, compare()
    {
    }

    template <typename It>
        requires __iter_impl::Cpp17InputIterator<It>
    MapImpl(It first, It last, const key_compare &comp = key_compare()) : c(), compare(comp)
    {
        insert(first, last);
    }
    template <typename It, typename Alloc>
        requires __iter_impl::Cpp17InputIterator<It> && uses_allocator_v<key_container_type, Alloc> &&
                 uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(It first, It last, const key_compare &comp, const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a), MakeUsingAlloc<MappedContainer>(a)}, compare(comp)
    {
        insert(first, last);
    }
    template <typename It, typename Alloc>
        requires __iter_impl::Cpp17InputIterator<It> && uses_allocator_v<key_container_type, Alloc> &&
                 uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(It first, It last, const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a), MakeUsingAlloc<MappedContainer>(a)}, compare()
    {
        insert(first, last);
    }

    template <ContainerCompatibleRange<value_type> R>
    MapImpl(from_range_t fr, R &&rg) : MapImpl(fr, std::forward<R>(rg), key_compare())
    {
    }
    template <ContainerCompatibleRange<value_type> R>
    MapImpl(from_range_t, R &&rg, const key_compare &comp) : MapImpl(comp)
    {
        insert_range(std::forward<R>(rg));
    }
    template <ContainerCompatibleRange<value_type> R, typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(from_range_t, R &&rg, const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a), MakeUsingAlloc<MappedContainer>(a)}, compare()
    {
        insert_range(std::forward<R>(rg));
    }
    template <ContainerCompatibleRange<value_type> R, typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(from_range_t, R &&rg, const key_compare &comp, const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a), MakeUsingAlloc<MappedContainer>(a)}, compare(comp)
    {
        insert_range(std::forward<R>(rg));
    }

    template <typename It>
        requires __iter_impl::Cpp17InputIterator<It>
    MapImpl(SortedT s, It first, It last, const key_compare &comp = key_compare()) : c(), compare(comp)
    {
        insert(s, first, last);
    }
    template <typename It, typename Alloc>
        requires __iter_impl::Cpp17InputIterator<It> && uses_allocator_v<key_container_type, Alloc> &&
                 uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(SortedT s, It first, It last, const key_compare &comp, const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a), MakeUsingAlloc<MappedContainer>(a)}, compare(comp)
    {
        insert(s, first, last);
    }
    template <typename It, typename Alloc>
        requires __iter_impl::Cpp17InputIterator<It> && uses_allocator_v<key_container_type, Alloc> &&
                 uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(SortedT s, It first, It last, const Alloc &a)
        : c{MakeUsingAlloc<KeyContainer>(a), MakeUsingAlloc<MappedContainer>(a)}, compare()
    {
        insert(s, first, last);
    }

    MapImpl(initializer_list<value_type> il, const key_compare &comp = key_compare())
        : MapImpl(il.begin(), il.end(), comp)
    {
    }
    template <typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(initializer_list<value_type> il, const key_compare &comp, const Alloc &a)
        : MapImpl(il.begin(), il.end(), comp, a)
    {
    }
    template <typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(initializer_list<value_type> il, const Alloc &a) : MapImpl(il.begin(), il.end(), a)
    {
    }

    MapImpl(SortedT s, initializer_list<value_type> il, const key_compare &comp = key_compare())
        : MapImpl(s, il.begin(), il.end(), comp)
    {
    }
    template <typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(SortedT s, initializer_list<value_type> il, const key_compare &comp, const Alloc &a)
        : MapImpl(s, il.begin(), il.end(), comp, a)
    {
    }
    template <typename Alloc>
        requires uses_allocator_v<key_container_type, Alloc> && uses_allocator_v<mapped_container_type, Alloc>
    MapImpl(SortedT s, initializer_list<value_type> il, const Alloc &a) : MapImpl(s, il.begin(), il.end(), a)
    {
    }

    Derived &operator=(initializer_list<value_type> il)
    {
        RestoreBothGuard<KeyContainer, MappedContainer> restore(c.keys, c.values);
        c.keys.clear();
        c.values.clear();
        insert(il.begin(), il.end());
        restore.Done();
        return static_cast<Derived &>(*this);
    }

    // ── iterators ───────────────────────────────────────────────────────

    iterator       begin() noexcept { return iterator(c.keys.begin(), c.values.begin()); }
    const_iterator begin() const noexcept { return const_iterator(c.keys.begin(), c.values.begin()); }
    iterator       end() noexcept { return iterator(c.keys.end(), c.values.end()); }
    const_iterator end() const noexcept { return const_iterator(c.keys.end(), c.values.end()); }

    reverse_iterator       rbegin() noexcept { return reverse_iterator(end()); }
    const_reverse_iterator rbegin() const noexcept { return const_reverse_iterator(end()); }
    reverse_iterator       rend() noexcept { return reverse_iterator(begin()); }
    const_reverse_iterator rend() const noexcept { return const_reverse_iterator(begin()); }

    const_iterator         cbegin() const noexcept { return begin(); }
    const_iterator         cend() const noexcept { return end(); }
    const_reverse_iterator crbegin() const noexcept { return const_reverse_iterator(cend()); }
    const_reverse_iterator crend() const noexcept { return const_reverse_iterator(cbegin()); }

    // ── [flat.map.capacity] ────────────────────────────────────────────

    [[nodiscard]] bool empty() const noexcept { return c.keys.empty(); }
    size_type          size() const noexcept { return c.keys.size(); }
    size_type          max_size() const noexcept
    {
        return min<size_type>(c.keys.max_size(), c.values.max_size());
    }

    // ── [flat.map.access] ──────────────────────────────────────────────
    // Multi-gated even though flat_multimap's own facade never re-exports
    // these: a shared engine would otherwise hand a working operator[]/at
    // to flat_multimap the moment a future edit adds the using-declaration.

    template <typename... Args>
        requires(!Multi) && is_constructible_v<mapped_type, Args...>
    pair<iterator, bool> try_emplace(const key_type &k, Args &&...args)
    {
        return TryEmplaceImpl(k, std::forward<Args>(args)...);
    }
    template <typename... Args>
        requires(!Multi) && is_constructible_v<mapped_type, Args...>
    pair<iterator, bool> try_emplace(key_type &&k, Args &&...args)
    {
        return TryEmplaceImpl(std::move(k), std::forward<Args>(args)...);
    }

    mapped_type &operator[](const key_type &x) requires(!Multi) { return try_emplace(x).first->second; }
    mapped_type &operator[](key_type &&x) requires(!Multi)
    {
        return try_emplace(std::move(x)).first->second;
    }
    template <typename K>
        requires(!Multi) && Transparent<Compare>
    mapped_type &operator[](K &&x)
    {
        return try_emplace(std::forward<K>(x)).first->second;
    }

    mapped_type &at(const key_type &x) requires(!Multi)
    {
        auto it = lower_bound(x);
        if (it == end() || compare(x, it->first)) throw out_of_range("flat_map::at");
        return it->second;
    }
    const mapped_type &at(const key_type &x) const requires(!Multi)
    {
        auto it = lower_bound(x);
        if (it == end() || compare(x, it->first)) throw out_of_range("flat_map::at");
        return it->second;
    }
    template <typename K>
        requires(!Multi) && Transparent<Compare>
    mapped_type &at(const K &x)
    {
        auto it = lower_bound(x);
        if (it == end() || compare(x, it->first)) throw out_of_range("flat_map::at");
        return it->second;
    }
    template <typename K>
        requires(!Multi) && Transparent<Compare>
    const mapped_type &at(const K &x) const
    {
        auto it = lower_bound(x);
        if (it == end() || compare(x, it->first)) throw out_of_range("flat_map::at");
        return it->second;
