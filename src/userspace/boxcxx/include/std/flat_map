    // ── [flat.map.modifiers] ───────────────────────────────────────────
    // /2: t is initialized UNCONDITIONALLY, even when the key turns out to
    // be a duplicate. Unlike b-1's insert(value_type), there is no eliding
    // this: measured on both oracles, a duplicate emplace(1,'z') costs 0
    // copies/0 moves only because 'z' never touched Val's copy/move ctor in
    // the first place (Val(char) is a converting ctor, not one of those
    // two) -- not because construction was skipped.

    template <typename... Args>
        requires is_constructible_v<value_type, Args...>
    conditional_t<Multi, iterator, pair<iterator, bool>> emplace(Args &&...args)
    {
        value_type t(std::forward<Args>(args)...);
        return PlaceValue(std::move(t));
    }
    template <typename... Args>
        requires is_constructible_v<value_type, Args...>
    iterator emplace_hint(const_iterator position, Args &&...args)
    {
        if constexpr (!Multi) {
            // One legal position per key: the hint carries no information
            // the key does not already carry.
            (void)position;
            return emplace(std::forward<Args>(args)...).first;
        } else {
            value_type       fresh(std::forward<Args>(args)...);
            difference_type  hinted = position - cbegin();
            difference_type  low    = ranges::lower_bound(c.keys, fresh.first, compare) - c.keys.begin();
            difference_type  high   = ranges::upper_bound(c.keys, fresh.first, compare) - c.keys.begin();
            difference_type  at     = hinted < low ? low : (hinted > high ? high : hinted);
            return PlaceAt(c.keys.begin() + at, std::move(fresh));
        }
    }

    conditional_t<Multi, iterator, pair<iterator, bool>> insert(const value_type &x) { return emplace(x); }
    conditional_t<Multi, iterator, pair<iterator, bool>> insert(value_type &&x)
    {
        return emplace(std::move(x));
    }
    iterator insert(const_iterator position, const value_type &x) { return emplace_hint(position, x); }
    iterator insert(const_iterator position, value_type &&x)
    {
        return emplace_hint(position, std::move(x));
    }

    template <typename P>
        requires is_constructible_v<value_type, P>
    conditional_t<Multi, iterator, pair<iterator, bool>> insert(P &&x)
    {
        return emplace(std::forward<P>(x));
    }
    template <typename P>
        requires is_constructible_v<value_type, P>
    iterator insert(const_iterator position, P &&x)
    {
        return emplace_hint(position, std::forward<P>(x));
    }

    // /6: materialize each element once (needed for input iterators and for
    // proxy references), append both halves, sort only the new tail, merge
    // the two sorted runs, then dedup.
    template <typename It>
        requires __iter_impl::Cpp17InputIterator<It>
    void insert(It first, It last)
    {
        RestoreBothGuard<KeyContainer, MappedContainer> restore(c.keys, c.values);
        size_type                                       old_size = c.keys.size();
        for (; first != last; ++first) {
            value_type value = *first;
            c.keys.insert(c.keys.end(), std::move(value.first));
            c.values.insert(c.values.end(), std::move(value.second));
        }
        MergeTailAndDedup(old_size, /*sort_tail=*/true);
        restore.Done();
    }
    // /9: the caller has promised the appended tail is already sorted, so
    // the only way to stay linear is to believe them and skip the sort.
    template <typename It>
        requires __iter_impl::Cpp17InputIterator<It>
    void insert(SortedT, It first, It last)
    {
        RestoreBothGuard<KeyContainer, MappedContainer> restore(c.keys, c.values);
        size_type                                       old_size = c.keys.size();
        for (; first != last; ++first) {
            value_type value = *first;
            c.keys.insert(c.keys.end(), std::move(value.first));
            c.values.insert(c.values.end(), std::move(value.second));
        }
        MergeTailAndDedup(old_size, /*sort_tail=*/false);
        restore.Done();
    }
    // /12: unlike insert(first,last), the range form appends STRAIGHT from
    // e.first/e.second -- no intermediate value_type. The two synopsis
    // pseudocodes are written differently on purpose.
    template <ContainerCompatibleRange<value_type> R>
    void insert_range(R &&rg)
    {
        RestoreBothGuard<KeyContainer, MappedContainer> restore(c.keys, c.values);
        size_type                                       old_size = c.keys.size();
        for (const auto &e : rg) {
            c.keys.insert(c.keys.end(), e.first);
            c.values.insert(c.values.end(), e.second);
        }
        MergeTailAndDedup(old_size, /*sort_tail=*/true);
        restore.Done();
    }

    void insert(initializer_list<value_type> il) { insert(il.begin(), il.end()); }
    void insert(SortedT s, initializer_list<value_type> il) { insert(s, il.begin(), il.end()); }

    // /34: "*this is emptied, even if the function exits via an exception."
    // The local guard's destructor runs on both the normal and the
    // throwing path; the return object is already initialized by then.
    containers extract() &&
    {
        struct EmptyOnExit {
            containers *target;
            ~EmptyOnExit()
            {
                target->keys.clear();
                target->values.clear();
            }
        } emptier{&c};
        return std::move(c);
    }
    // /36-37: sortedness and no-duplicates are PRECONDITIONS, not checks.
    void replace(key_container_type &&key_cont, mapped_container_type &&mapped_cont)
    {
        c.keys   = std::move(key_cont);
        c.values = std::move(mapped_cont);
    }

    template <typename... Args>
        requires(!Multi) && is_constructible_v<mapped_type, Args...>
    iterator try_emplace(const_iterator hint, const key_type &k, Args &&...args)
    {
        (void)hint;
        return TryEmplaceImpl(k, std::forward<Args>(args)...).first;
    }
    template <typename... Args>
        requires(!Multi) && is_constructible_v<mapped_type, Args...>
    iterator try_emplace(const_iterator hint, key_type &&k, Args &&...args)
    {
        (void)hint;
        return TryEmplaceImpl(std::move(k), std::forward<Args>(args)...).first;
    }
    // /21: the key is placed via c.keys.emplace, NOT c.keys.insert -- the
    // exact spot libstdc++ 15.2/16.1 write insert instead, which is why
    // flat_map<string,int,less<>>::try_emplace(string_view) fails to
    // compile there (vector<string>::insert has no conversion from
    // string_view; vector<string>::emplace constructs in place and does).
    // /19.4 applies only to this unhinted overload.
    template <typename K, typename... Args>
        requires(!Multi) && Transparent<Compare> && is_constructible_v<key_type, K> &&
                is_constructible_v<mapped_type, Args...> && (!is_convertible_v<K &&, const_iterator>) &&
                (!is_convertible_v<K &&, iterator>)
    pair<iterator, bool> try_emplace(K &&k, Args &&...args)
    {
        return TryEmplaceImpl(std::forward<K>(k), std::forward<Args>(args)...);
    }
    template <typename K, typename... Args>
        requires(!Multi) && Transparent<Compare> && is_constructible_v<key_type, K> &&
                is_constructible_v<mapped_type, Args...>
    iterator try_emplace(const_iterator hint, K &&k, Args &&...args)
    {
        (void)hint;
        return TryEmplaceImpl(std::forward<K>(k), std::forward<Args>(args)...).first;
    }

    template <typename M>
        requires(!Multi) && is_assignable_v<mapped_type &, M> && is_constructible_v<mapped_type, M>
    pair<iterator, bool> insert_or_assign(const key_type &k, M &&obj)
    {
        return InsertOrAssignImpl(k, std::forward<M>(obj));
    }
    template <typename M>
        requires(!Multi) && is_assignable_v<mapped_type &, M> && is_constructible_v<mapped_type, M>
    pair<iterator, bool> insert_or_assign(key_type &&k, M &&obj)
    {
        return InsertOrAssignImpl(std::move(k), std::forward<M>(obj));
    }
    template <typename M>
        requires(!Multi) && is_assignable_v<mapped_type &, M> && is_constructible_v<mapped_type, M>
    iterator insert_or_assign(const_iterator hint, const key_type &k, M &&obj)
    {
        (void)hint;
        return InsertOrAssignImpl(k, std::forward<M>(obj)).first;
    }
    template <typename M>
        requires(!Multi) && is_assignable_v<mapped_type &, M> && is_constructible_v<mapped_type, M>
    iterator insert_or_assign(const_iterator hint, key_type &&k, M &&obj)
    {
        (void)hint;
        return InsertOrAssignImpl(std::move(k), std::forward<M>(obj)).first;
    }
    template <typename K, typename M>
        requires(!Multi) && Transparent<Compare> && is_constructible_v<key_type, K> &&
                is_assignable_v<mapped_type &, M> && is_constructible_v<mapped_type, M>
    pair<iterator, bool> insert_or_assign(K &&k, M &&obj)
    {
        return InsertOrAssignImpl(std::forward<K>(k), std::forward<M>(obj));
    }
    template <typename K, typename M>
        requires(!Multi) && Transparent<Compare> && is_constructible_v<key_type, K> &&
                is_assignable_v<mapped_type &, M> && is_constructible_v<mapped_type, M>
    iterator insert_or_assign(const_iterator hint, K &&k, M &&obj)
    {
        (void)hint;
        return InsertOrAssignImpl(std::forward<K>(k), std::forward<M>(obj)).first;
    }

    // Two declarations, not one: unlike b-1 (where iterator IS
    // const_iterator), the two types genuinely differ here.
    iterator erase(iterator position) { return EraseAt(position.key); }
    iterator erase(const_iterator position) { return EraseAt(position.key); }
    iterator erase(const_iterator first, const_iterator last)
    {
        difference_type from = first.key - c.keys.cbegin();
        difference_type to   = last.key - c.keys.cbegin();
        RestoreBothGuard<KeyContainer, MappedContainer> restore(c.keys, c.values);
        KeyIt after_key = c.keys.erase(c.keys.begin() + from, c.keys.begin() + to);
        c.values.erase(c.values.begin() + from, c.values.begin() + to);
        restore.Done();
        return MakeIterator(after_key);
    }
    size_type erase(const key_type &x) { return EraseEquivalent(x); }
    // [associative.reqmts]'s two iterator-convertibility exclusions: with
    // iterator/const_iterator being genuine wrapper types (not bare
    // pointers, unlike b-1), this mainly guards against a K that itself
    // converts to one of them.
    template <typename K>
        requires Transparent<Compare> && (!is_convertible_v<K &&, iterator>) &&
                 (!is_convertible_v<K &&, const_iterator>)
    size_type erase(K &&x)
    {
        return EraseEquivalent(x);
    }

    void swap(Derived &other) noexcept
    {
        ranges::swap(compare, other.compare);
        ranges::swap(c.keys, other.c.keys);
        ranges::swap(c.values, other.c.values);
    }
    void clear() noexcept
    {
        c.keys.clear();
        c.values.clear();
    }

    // ── observers ───────────────────────────────────────────────────────

    key_compare   key_comp() const { return compare; }
    value_compare value_comp() const { return value_compare(compare); }

    const key_container_type    &keys() const noexcept { return c.keys; }
    const mapped_container_type &values() const noexcept { return c.values; }

    // ── map operations ──────────────────────────────────────────────────

    iterator lower_bound(const key_type &x) { return MakeIterator(ranges::lower_bound(c.keys, x, compare)); }
    const_iterator lower_bound(const key_type &x) const
    {
        return MakeConstIterator(ranges::lower_bound(c.keys, x, compare));
    }
    template <typename K>
        requires Transparent<Compare>
    iterator lower_bound(const K &x)
    {
        return MakeIterator(ranges::lower_bound(c.keys, x, compare));
    }
    template <typename K>
        requires Transparent<Compare>
    const_iterator lower_bound(const K &x) const
    {
        return MakeConstIterator(ranges::lower_bound(c.keys, x, compare));
    }

    iterator upper_bound(const key_type &x) { return MakeIterator(ranges::upper_bound(c.keys, x, compare)); }
    const_iterator upper_bound(const key_type &x) const
    {
        return MakeConstIterator(ranges::upper_bound(c.keys, x, compare));
    }
    template <typename K>
        requires Transparent<Compare>
    iterator upper_bound(const K &x)
    {
        return MakeIterator(ranges::upper_bound(c.keys, x, compare));
    }
    template <typename K>
        requires Transparent<Compare>
    const_iterator upper_bound(const K &x) const
    {
        return MakeConstIterator(ranges::upper_bound(c.keys, x, compare));
    }

    iterator find(const key_type &x)
    {
        auto it = lower_bound(x);
        return (it != end() && !compare(x, it->first)) ? it : end();
    }
    const_iterator find(const key_type &x) const
    {
        auto it = lower_bound(x);
        return (it != end() && !compare(x, it->first)) ? it : end();
    }
    template <typename K>
        requires Transparent<Compare>
    iterator find(const K &x)
    {
        auto it = lower_bound(x);
        return (it != end() && !compare(x, it->first)) ? it : end();
    }
    template <typename K>
        requires Transparent<Compare>
    const_iterator find(const K &x) const
    {
        auto it = lower_bound(x);
        return (it != end() && !compare(x, it->first)) ? it : end();
    }

    size_type count(const key_type &x) const { return CountEquivalent(x); }
    template <typename K>
        requires Transparent<Compare>
    size_type count(const K &x) const
    {
        return CountEquivalent(x);
    }

    bool contains(const key_type &x) const { return find(x) != cend(); }
    template <typename K>
        requires Transparent<Compare>
    bool contains(const K &x) const
    {
        return find(x) != cend();
    }

    pair<iterator, iterator> equal_range(const key_type &x) { return RangeOf(x); }
    pair<const_iterator, const_iterator> equal_range(const key_type &x) const { return RangeOf(x); }
    template <typename K>
        requires Transparent<Compare>
    pair<iterator, iterator> equal_range(const K &x)
    {
        return RangeOf(x);
    }
    template <typename K>
        requires Transparent<Compare>
    pair<const_iterator, const_iterator> equal_range(const K &x) const
    {
        return RangeOf(x);
    }

    // ── comparisons ─────────────────────────────────────────────────────
    // Both walk the PAIR sequence (begin()/end()), not c.keys/c.values
    // separately: <=> cannot be split into "keys, then values" (the
    // ordering is lexicographic over pairs), so a pairwise walk is needed
    // regardless, and using it for == too is one machine instead of two --
    // matching libc++'s measured 2/2 comparator-call count.

    friend bool operator==(const Derived &x, const Derived &y)
    {
        return x.size() == y.size() && std::equal(x.begin(), x.end(), y.begin());
    }
    // Return type DEDUCED, not spelled synth-three-way-result<value_type>:
    // [flat.map] constrains Compare, not Key, so a key ordered solely by an
    // external comparator is legal, and an eagerly instantiated
    // synth-three-way-result would make the whole CLASS ill-formed for such
    // a key rather than just dropping <=> from overload resolution.
    friend auto operator<=>(const Derived &x, const Derived &y)
        requires requires(const value_type &a, const value_type &b) { __cmp::SynthThreeWay{}(a, b); }
    {
        return std::lexicographical_compare_three_way(x.begin(), x.end(), y.begin(), y.end(),
                                                       __cmp::SynthThreeWay{});
    }
    friend void swap(Derived &x, Derived &y) noexcept { x.swap(y); }

private:
    using MutYoke = Yoke<KeyIt, MapIt, key_type &, mapped_type &, Derived>;

    containers c;
    [[no_unique_address]] key_compare compare;

    iterator MakeIterator(KeyIt key_it)
    {
        return iterator(key_it, c.values.begin() + (key_it - c.keys.begin()));
    }
    const_iterator MakeConstIterator(CKeyIt key_it) const
    {
        return const_iterator(key_it, c.values.begin() + (key_it - c.keys.begin()));
    }

    // Every single-element insertion funnels through here: the key and its
    // value are placed at the SAME offset in their two containers, guarded
    // together, so a value insertion that throws after the key already
    // landed is caught by RestoreBothIfTouched instead of leaving
    // keys.size() != values.size() the way libc++ measurably does.
    conditional_t<Multi, iterator, pair<iterator, bool>> PlaceAt(KeyIt key_it, value_type &&t)
    {
        difference_type offset = key_it - c.keys.begin();
        RestoreBothIfTouched<KeyContainer, MappedContainer> restore(c.keys, c.values);
        KeyIt placed_key = c.keys.insert(key_it, std::move(t.first));
        c.values.insert(c.values.begin() + offset, std::move(t.second));
        restore.Done();
        if constexpr (Multi)
            return MakeIterator(placed_key);
        else
            return {MakeIterator(placed_key), true};
    }

    // /2 and /16 both write ranges::upper_bound even for the unique map;
    // when the key is absent, lower_bound == upper_bound, so ONE
    // lower_bound answers both "already present?" and "where does it go?".
    conditional_t<Multi, iterator, pair<iterator, bool>> PlaceValue(value_type &&t)
    {
        if constexpr (Multi) {
            KeyIt key_it = ranges::upper_bound(c.keys, t.first, compare);
            return PlaceAt(key_it, std::move(t));
        } else {
            KeyIt key_it = ranges::lower_bound(c.keys, t.first, compare);
            if (key_it != c.keys.end() && !compare(t.first, *key_it)) return {MakeIterator(key_it), false};
            return PlaceAt(key_it, std::move(t));
        }
    }

    // try_emplace/insert_or_assign share this shape: search once, and only
    // if the key is absent does anything get built at all -- /16 and /21's
    // "*this and args... are unchanged" on a duplicate.
    template <typename K, typename... Args>
    pair<iterator, bool> TryEmplaceImpl(K &&k, Args &&...args)
    {
        KeyIt key_it = ranges::lower_bound(c.keys, k, compare);
        if (key_it != c.keys.end() && !compare(k, *key_it)) return {MakeIterator(key_it), false};
        difference_type offset = key_it - c.keys.begin();
        RestoreBothIfTouched<KeyContainer, MappedContainer> restore(c.keys, c.values);
        KeyIt placed_key = c.keys.emplace(key_it, std::forward<K>(k));
        c.values.emplace(c.values.begin() + offset, std::forward<Args>(args)...);
        restore.Done();
        return {MakeIterator(placed_key), true};
    }

    template <typename K, typename M>
    pair<iterator, bool> InsertOrAssignImpl(K &&k, M &&obj)
    {
        KeyIt key_it = ranges::lower_bound(c.keys, k, compare);
        if (key_it != c.keys.end() && !compare(k, *key_it)) {
            *(c.values.begin() + (key_it - c.keys.begin())) = std::forward<M>(obj);
            return {MakeIterator(key_it), false};
        }
        difference_type offset = key_it - c.keys.begin();
        RestoreBothIfTouched<KeyContainer, MappedContainer> restore(c.keys, c.values);
        KeyIt placed_key = c.keys.emplace(key_it, std::forward<K>(k));
        c.values.emplace(c.values.begin() + offset, std::forward<M>(obj));
        restore.Done();
        return {MakeIterator(placed_key), true};
    }

    iterator EraseAt(CKeyIt key_pos)
    {
        difference_type offset = key_pos - c.keys.cbegin();
        // Unconditional, not size-based: see RestoreBothIfTouched's own note
        // -- vector::erase shrinks __size only AFTER its shift loop, so a
        // throwing move-assignment mid-shift is invisible to a size probe.
        RestoreBothGuard<KeyContainer, MappedContainer> restore(c.keys, c.values);
        KeyIt after_key = c.keys.erase(c.keys.begin() + offset);
        c.values.erase(c.values.begin() + offset);
        restore.Done();
        return MakeIterator(after_key);
    }

    template <typename K>
    size_type EraseEquivalent(const K &x)
    {
        if constexpr (!Multi) {
            KeyIt key_it = ranges::lower_bound(c.keys, x, compare);
            if (key_it == c.keys.end() || compare(x, *key_it)) return 0;
            EraseAt(key_it);
            return 1;
        } else {
            auto      found = ranges::equal_range(c.keys, x, compare);
            size_type n      = static_cast<size_type>(found.end() - found.begin());
            if (n) {
                difference_type from = found.begin() - c.keys.begin();
                difference_type to   = found.end() - c.keys.begin();
                RestoreBothGuard<KeyContainer, MappedContainer> restore(c.keys, c.values);
                c.keys.erase(found.begin(), found.end());
                c.values.erase(c.values.begin() + from, c.values.begin() + to);
                restore.Done();
            }
            return n;
        }
    }

    template <typename K>
    size_type CountEquivalent(const K &x) const
    {
        if constexpr (!Multi) {
            return contains(x) ? size_type(1) : size_type(0);
        } else {
            auto found = ranges::equal_range(c.keys, x, compare);
            return static_cast<size_type>(found.end() - found.begin());
        }
    }

    template <typename K>
    pair<const_iterator, const_iterator> RangeOf(const K &x) const
    {
        auto found = ranges::equal_range(c.keys, x, compare);
        return {MakeConstIterator(found.begin()), MakeConstIterator(found.end())};
    }
    template <typename K>
    pair<iterator, iterator> RangeOf(const K &x)
    {
        auto found = ranges::equal_range(c.keys, x, compare);
        return {MakeIterator(found.begin()), MakeIterator(found.end())};
    }

    // /1: sort [begin(),end()) w.r.t. value_comp(), then (unique side only)
    // dedup. The is_sorted probe is the complexity contract, not an
    // optimization -- /2 promises Linear when the input already is sorted.
    void SortAndDedupWhole()
    {
        if (!ranges::is_sorted(c.keys, compare))
            ranges::sort(MutYoke(c.keys.begin(), c.values.begin()), MutYoke(c.keys.end(), c.values.end()),
                         compare, ProjectKey{});
        if constexpr (!Multi) DedupWhole();
    }

    // /6-/14's shared tail-end: sort the newly appended tail (unless the
    // caller tagged it sorted_unique/sorted_equivalent), merge it with the
    // pre-existing run, then dedup. old_size is a COUNT, not an iterator:
    // the append that precedes this call can reallocate.
    void MergeTailAndDedup(size_type old_size, bool sort_tail)
    {
        difference_type split      = static_cast<difference_type>(old_size);
        KeyIt            key_middle = c.keys.begin() + split;
        // Nothing was appended: the pre-existing range was already sorted
        // and deduped by every earlier call, so an empty tail cannot have
        // introduced a duplicate. Skip the merge AND the dedup scan rather
        // than paying a full pass over the untouched range for nothing.
        if (key_middle == c.keys.end()) return;
        MapIt value_middle = c.values.begin() + split;
        if (sort_tail && !ranges::is_sorted(key_middle, c.keys.end(), compare))
            ranges::sort(MutYoke(key_middle, value_middle), MutYoke(c.keys.end(), c.values.end()),
                         compare, ProjectKey{});
        PairKeyLess<Compare> pair_less{compare};
        MergeRuns(MutYoke(c.keys.begin(), c.values.begin()), MutYoke(key_middle, value_middle),
                  MutYoke(c.keys.end(), c.values.end()), pair_less);
        if constexpr (!Multi) DedupWhole();
    }

    // Erase all but the first of each run of equivalent keys, moving both
    // containers together so offset off stays paired correctly through the
    // compaction.
    void DedupWhole()
    {
        MutYoke first(c.keys.begin(), c.values.begin());
        MutYoke last(c.keys.end(), c.values.end());
        auto    equivalent_keys = [this](const key_type &a, const key_type &b) {
            return !compare(a, b) && !compare(b, a);
        };
        auto            tail = ranges::unique(first, last, equivalent_keys, ProjectKey{});
        difference_type dist = tail.begin() - first;
        c.keys.erase(c.keys.begin() + dist, c.keys.end());
        c.values.erase(c.values.begin() + dist, c.values.end());
    }
};

