// boxcxx — <unordered_set>
// unordered_set / unordered_multiset over the chaining hash engine.
// node_handle extract/insert(node)/merge shipped Ф28b.
#ifndef BOXCXX_UNORDERED_SET
#define BOXCXX_UNORDERED_SET

#include <__bits/hash_table>
#include <__bits/node_handle>
#include <__bits/ranges_core>
#include <functional>
#include <initializer_list>
#include <utility>

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_allocator_traits_is_always_equal
#define BOXCXX_OWNS_associative_heterogeneous_erasure
#define BOXCXX_OWNS_associative_heterogeneous_insertion
#define BOXCXX_OWNS_containers_ranges
#define BOXCXX_OWNS_erase_if
#define BOXCXX_OWNS_generic_unordered_lookup
#define BOXCXX_OWNS_node_extract
#include <__bits/version_containers>
#define BOXCXX_OWNS_nonmember_container_access
#include <__bits/version_iterator>

namespace std {

namespace __ht {

struct SelectSelf {
    template <typename V>
    const V &operator()(const V &v) const noexcept
    {
        return v;
    }
};

} // namespace __ht

// unordered_multiset named by unordered_set::merge (defined later here).
template <typename Key, typename Hash, typename KeyEq, typename Alloc>
class unordered_multiset;

template <typename Key, typename Hash = hash<Key>,
          typename KeyEq = equal_to<Key>, typename Alloc = allocator<Key>>
class unordered_set {
    using TableT = __ht::Table<Key, Key, __ht::SelectSelf, Hash, KeyEq, Alloc>;

public:
    using key_type       = Key;
    using value_type     = Key;
    using size_type      = size_t;
    using hasher          = Hash;
    using key_equal       = KeyEq;
    using allocator_type  = Alloc;
    using difference_type = ptrdiff_t;
    // set elements are immutable through iterators.
    using iterator       = typename TableT::const_iterator;
    using const_iterator = typename TableT::const_iterator;
    using local_iterator       = typename TableT::const_local_iterator;
    using const_local_iterator = typename TableT::const_local_iterator;
    using node_type = __node::NodeHandle<Key, Key, typename TableT::NodeType,
                                         typename TableT::NodeAllocType>;
    using insert_return_type = __node::NodeInsertReturn<iterator, node_type>;

    unordered_set() = default;
    explicit unordered_set(size_type buckets, const Hash &h = Hash(),
                           const KeyEq &eq = KeyEq(),
                           const Alloc &a  = Alloc())
        : __t(buckets, h, eq, a)
    {
    }
    template <typename It>
    unordered_set(It first, It last, size_type buckets = 0,
                  const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                  const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert(first, last);
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_set(from_range_t, R &&rg, size_type buckets = 0,
                  const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                  const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert_range(std::forward<R>(rg));
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_set(from_range_t, R &&rg, size_type buckets, const Alloc &a)
        : __t(buckets, Hash(), KeyEq(), a)
    {
        insert_range(std::forward<R>(rg));
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_set(from_range_t, R &&rg, size_type buckets, const Hash &h,
                  const Alloc &a)
        : __t(buckets, h, KeyEq(), a)
    {
        insert_range(std::forward<R>(rg));
    }
    unordered_set(initializer_list<Key> il, size_type buckets = 0,
                  const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                  const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert(il.begin(), il.end());
    }
    unordered_set(const unordered_set &) = default;
    unordered_set(unordered_set &&) noexcept = default;
    unordered_set(const unordered_set &other, const Alloc &a)
        : __t(other.__t, a)
    {
    }
    unordered_set(unordered_set &&other, const Alloc &a)
        : __t(std::move(other.__t), a)
    {
    }
    // Allocator-extended constructors ([unord.set.overview]): bucket-count +
    // allocator, bucket-count + hasher + allocator, allocator-only (the pmr
    // `unordered_set s(&resource)` idiom), and the iterator / initializer_list
    // forms with a trailing allocator. All delegate to the Table(buckets,
    // hasher, key_equal, allocator) engine ctor -- engine untouched.
    unordered_set(size_type buckets, const Alloc &a)
        : __t(buckets, Hash(), KeyEq(), a)
    {
    }
    unordered_set(size_type buckets, const Hash &h, const Alloc &a)
        : __t(buckets, h, KeyEq(), a)
    {
    }
    explicit unordered_set(const Alloc &a) : __t(0, Hash(), KeyEq(), a) {}
    template <typename It>
    unordered_set(It first, It last, size_type buckets, const Alloc &a)
        : __t(buckets, Hash(), KeyEq(), a)
    {
        insert(first, last);
    }
    template <typename It>
    unordered_set(It first, It last, size_type buckets, const Hash &h,
                  const Alloc &a)
        : __t(buckets, h, KeyEq(), a)
    {
        insert(first, last);
    }
    unordered_set(initializer_list<Key> il, size_type buckets, const Alloc &a)
        : __t(buckets, Hash(), KeyEq(), a)
    {
        insert(il.begin(), il.end());
    }
    unordered_set(initializer_list<Key> il, size_type buckets, const Hash &h,
                  const Alloc &a)
        : __t(buckets, h, KeyEq(), a)
    {
        insert(il.begin(), il.end());
    }
    // LWG 2713 (Status: Ready) -- the same three sources with an allocator but
    // no bucket count, which the ordered containers have had all along and
    // [unord.set.syn] already writes deduction guides for. The init-list form
    // is the load-bearing one: without it `unordered_set<K> s(il, a)` compiles
    // anyway, building a whole temporary through the (init-list, buckets=0,
    // ...) ctor with a DEFAULT-constructed allocator and then copying it into
    // the alloc-extended copy ctor. See unordered_map for the full note.
    template <typename It>
    unordered_set(It first, It last, const Alloc &a)
        : __t(0, Hash(), KeyEq(), a)
    {
        insert(first, last);
    }
    unordered_set(initializer_list<Key> il, const Alloc &a)
        : __t(0, Hash(), KeyEq(), a)
    {
        insert(il.begin(), il.end());
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_set(from_range_t, R &&rg, const Alloc &a)
        : __t(0, Hash(), KeyEq(), a)
    {
        insert_range(std::forward<R>(rg));
    }
    unordered_set &operator=(const unordered_set &) = default;
    unordered_set &operator=(unordered_set &&) = default;
    unordered_set &operator=(initializer_list<Key> il)
    {
        clear();
        insert(il.begin(), il.end());
        return *this;
    }

    allocator_type get_allocator() const noexcept
    {
        return __t.get_allocator();
    }

    iterator begin() const noexcept
    {
        return const_cast<unordered_set *>(this)->__t.begin();
    }
    iterator end() const noexcept
    {
        return const_cast<unordered_set *>(this)->__t.end();
    }
    // [unord.req.general] requires these of every unordered container, and
    // unordered_set was the only one in the library without them -- the
    // name resolved to the BUCKET-local cbegin(size_type) instead, so
    // c.cbegin() failed with "too few arguments" rather than working.
    const_iterator cbegin() const noexcept { return begin(); }
    const_iterator cend() const noexcept { return end(); }

    [[nodiscard]] bool empty() const noexcept { return __t.empty(); }
    size_type size() const noexcept { return __t.size(); }
    size_type max_size() const noexcept { return __t.max_size(); }

    pair<iterator, bool> insert(const Key &v)
    {
        auto [it, ok] = __t.EmplaceUnique(v);
        return {iterator(it.__n, it.__t), ok};
    }
    pair<iterator, bool> insert(Key &&v)
    {
        auto [it, ok] = __t.EmplaceUnique(std::move(v));
        return {iterator(it.__n, it.__t), ok};
    }
    // [unord.set.overview] lists both hint forms and neither existed here --
    // the only container in the library that was missing them outright, so
    // insert(pos, v) did not compile at all. The hint is advisory for a
    // hash table (the bucket is decided by the hash, not by position), so
    // they forward and drop the flag.
    iterator insert(const_iterator, const Key &v) { return insert(v).first; }
    iterator insert(const_iterator, Key &&v)
    {
        return insert(std::move(v)).first;
    }

    // ── heterogeneous insertion (P2363R5, C++26) ────────────────────────
    // Needs a transparent Hash AND KeyEq, the same pair heterogeneous
    // lookup needs: the hash of the lookup type has to agree with the hash
    // of the key type, which is a promise only the hasher can make.
    template <typename K>
        requires(__detail::TransparentHashEq<Hash, KeyEq> &&
                 !is_convertible_v<K &&, iterator> &&
                 !is_convertible_v<K &&, const_iterator>)
    pair<iterator, bool> insert(K &&x)
    {
        iterator hit = find(x);
        if (hit != end()) return {hit, false};
        auto [it, ok] = __t.EmplaceUnique(std::forward<K>(x));
        return {iterator(it.__n, it.__t), ok};
    }
    template <typename K>
        requires(__detail::TransparentHashEq<Hash, KeyEq> &&
                 !is_convertible_v<K &&, iterator> &&
                 !is_convertible_v<K &&, const_iterator>)
    iterator insert(const_iterator, K &&x)
    {
        return insert(std::forward<K>(x)).first;
    }
    template <typename It>
    void insert(It first, It last)
    {
        for (; first != last; ++first) __t.EmplaceUnique(*first);
    }
    void insert(initializer_list<Key> il) { insert(il.begin(), il.end()); }
    template <ContainerCompatibleRange<value_type> R>
    void insert_range(R &&rg)
    {
        for (auto &&v : rg) __t.EmplaceUnique(std::forward<decltype(v)>(v));
    }
    template <typename... Args>
    pair<iterator, bool> emplace(Args &&...args)
    {
        auto [it, ok] = __t.EmplaceUnique(std::forward<Args>(args)...);
        return {iterator(it.__n, it.__t), ok};
    }

    iterator erase(const_iterator where)
    {
        auto nx = __t.Erase(where);
        return iterator(nx.__n, nx.__t);
    }
    iterator erase(const_iterator first, const_iterator last)
    {
        while (first != last) first = __t.Erase(first);
        return iterator(first.__n, first.__t);
    }
    size_type erase(const Key &key) { return __t.EraseKey(key); }
    template <typename K>
        requires(__detail::TransparentHashEq<Hash, KeyEq> &&
                 !is_convertible_v<K &&, iterator> &&
                 !is_convertible_v<K &&, const_iterator>)
    size_type erase(K &&x)
    {
        return __t.EraseKey(std::forward<K>(x));
    }
    void clear() noexcept { __t.clear(); }
    void swap(unordered_set &other) noexcept(noexcept(__t.swap(other.__t))) { __t.swap(other.__t); }

    // ── node handle / merge (Ф28b) ──────────────────────────────────────

    node_type extract(const_iterator pos)
    {
        return node_type(__t.ExtractNode(pos), __t.GetNodeAlloc());
    }
    node_type extract(const Key &key)
    {
        iterator it = find(key);
        if (it == end()) return node_type();
        return extract(it);
    }
    template <typename K>
        requires(__detail::TransparentHashEq<Hash, KeyEq> &&
                 !is_convertible_v<K &&, iterator> &&
                 !is_convertible_v<K &&, const_iterator>)
    node_type extract(K &&x)
    {
        iterator it = find(x);
        if (it == end()) return node_type();
        return extract(it);
    }
    insert_return_type insert(node_type &&nh)
    {
        if (nh.empty()) return {end(), false, node_type()};
        auto [it, ok] = __t.ReinsertUnique(nh.__Ptr());
        if (ok) nh.__Disown();
        return {iterator(it.__n, it.__t), ok, std::move(nh)};
    }
    iterator insert(const_iterator, node_type &&nh)
    {
        if (nh.empty()) return end();
        auto [it, ok] = __t.ReinsertUnique(nh.__Ptr());
        if (ok) nh.__Disown();
        return iterator(it.__n, it.__t);
    }
    template <typename H2, typename E2>
    void merge(unordered_set<Key, H2, E2, Alloc> &source)
    {
        __t.MergeUnique(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_set<Key, H2, E2, Alloc> &&source)
    {
        __t.MergeUnique(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_multiset<Key, H2, E2, Alloc> &source)
    {
        __t.MergeUnique(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_multiset<Key, H2, E2, Alloc> &&source)
    {
        __t.MergeUnique(source.__Table());
    }
    TableT &__Table() noexcept { return __t; }

    iterator find(const Key &key) const
    {
        auto it = const_cast<unordered_set *>(this)->__t.Find(key);
        return iterator(it.__n, it.__t);
    }
    size_type count(const Key &key) const
    {
        return const_cast<unordered_set *>(this)->__t.Count(key);
    }
    bool contains(const Key &key) const { return find(key) != end(); }
    pair<iterator, iterator> equal_range(const Key &key) const
    {
        auto [lo, hi] = const_cast<unordered_set *>(this)->__t.EqualRange(key);
        return {iterator(lo.__n, lo.__t), iterator(hi.__n, hi.__t)};
    }

    // ── heterogeneous lookup (C++23, transparent Hash+KeyEq only) ───────

    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    iterator find(const K &key) const
    {
        auto it = const_cast<unordered_set *>(this)->__t.Find(key);
        return iterator(it.__n, it.__t);
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    size_type count(const K &key) const
    {
        return const_cast<unordered_set *>(this)->__t.Count(key);
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    bool contains(const K &key) const { return find(key) != end(); }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    pair<iterator, iterator> equal_range(const K &key) const
    {
        auto [lo, hi] = const_cast<unordered_set *>(this)->__t.EqualRange(key);
        return {iterator(lo.__n, lo.__t), iterator(hi.__n, hi.__t)};
    }

    size_type bucket_count() const noexcept { return __t.bucket_count(); }
    size_type bucket_size(size_type i) const noexcept
    {
        return __t.bucket_size(i);
    }
    size_type bucket(const Key &key) const { return __t.bucket(key); }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    size_type bucket(const K &key) const { return __t.bucket(key); }
    local_iterator       begin(size_type n) { return __t.cbegin(n); }
    local_iterator       end(size_type n) { return __t.cend(n); }
    const_local_iterator begin(size_type n) const { return __t.cbegin(n); }
    const_local_iterator end(size_type n) const { return __t.cend(n); }
    const_local_iterator cbegin(size_type n) const { return __t.cbegin(n); }
    const_local_iterator cend(size_type n) const { return __t.cend(n); }
    float load_factor() const noexcept { return __t.load_factor(); }
    float max_load_factor() const noexcept { return __t.max_load_factor(); }
    void max_load_factor(float lf) noexcept { __t.max_load_factor(lf); }
    void rehash(size_type n) { __t.Rehash(n ? n : 8); }
    void reserve(size_type n) { __t.Reserve(n); }
    hasher hash_function() const { return __t.hash_function(); }
    key_equal key_eq() const { return __t.key_eq(); }

private:
    TableT __t;
};

template <typename Key, typename Hash = hash<Key>,
          typename KeyEq = equal_to<Key>, typename Alloc = allocator<Key>>
class unordered_multiset {
    using TableT = __ht::Table<Key, Key, __ht::SelectSelf, Hash, KeyEq, Alloc>;

public:
    using key_type        = Key;
    using value_type      = Key;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;
    using hasher          = Hash;
    using key_equal       = KeyEq;
    using allocator_type  = Alloc;
    using iterator        = typename TableT::const_iterator;
    using const_iterator  = typename TableT::const_iterator;
    using local_iterator       = typename TableT::const_local_iterator;
    using const_local_iterator = typename TableT::const_local_iterator;
    using node_type = __node::NodeHandle<Key, Key, typename TableT::NodeType,
                                         typename TableT::NodeAllocType>;

    unordered_multiset() = default;
    explicit unordered_multiset(size_type buckets, const Hash &h = Hash(),
                                const KeyEq &eq = KeyEq(),
                                const Alloc &a  = Alloc())
        : __t(buckets, h, eq, a)
    {
    }
    template <typename It>
    unordered_multiset(It first, It last, size_type buckets = 0,
                       const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                       const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert(first, last);
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_multiset(from_range_t, R &&rg, size_type buckets = 0,
                       const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                       const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert_range(std::forward<R>(rg));
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_multiset(from_range_t, R &&rg, size_type buckets, const Alloc &a)
        : __t(buckets, Hash(), KeyEq(), a)
    {
        insert_range(std::forward<R>(rg));
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_multiset(from_range_t, R &&rg, size_type buckets,
                       const Hash &h, const Alloc &a)
        : __t(buckets, h, KeyEq(), a)
    {
        insert_range(std::forward<R>(rg));
    }
    unordered_multiset(initializer_list<Key> il, size_type buckets = 0,
                       const Hash &h = Hash(), const KeyEq &eq = KeyEq(),
                       const Alloc &a = Alloc())
        : __t(buckets, h, eq, a)
    {
        insert(il.begin(), il.end());
    }
    unordered_multiset(const unordered_multiset &) = default;
    unordered_multiset(unordered_multiset &&) noexcept = default;
    unordered_multiset(const unordered_multiset &other, const Alloc &a)
        : __t(other.__t, a)
    {
    }
    unordered_multiset(unordered_multiset &&other, const Alloc &a)
        : __t(std::move(other.__t), a)
    {
    }
    // Allocator-extended constructors ([unord.multiset.overview]) -- see
    // unordered_set above.
    unordered_multiset(size_type buckets, const Alloc &a)
        : __t(buckets, Hash(), KeyEq(), a)
    {
    }
    unordered_multiset(size_type buckets, const Hash &h, const Alloc &a)
        : __t(buckets, h, KeyEq(), a)
    {
    }
    explicit unordered_multiset(const Alloc &a) : __t(0, Hash(), KeyEq(), a) {}
    template <typename It>
    unordered_multiset(It first, It last, size_type buckets, const Alloc &a)
        : __t(buckets, Hash(), KeyEq(), a)
    {
        insert(first, last);
    }
    template <typename It>
    unordered_multiset(It first, It last, size_type buckets, const Hash &h,
                       const Alloc &a)
        : __t(buckets, h, KeyEq(), a)
    {
        insert(first, last);
    }
    unordered_multiset(initializer_list<Key> il, size_type buckets,
                       const Alloc &a)
        : __t(buckets, Hash(), KeyEq(), a)
    {
        insert(il.begin(), il.end());
    }
    unordered_multiset(initializer_list<Key> il, size_type buckets,
                       const Hash &h, const Alloc &a)
        : __t(buckets, h, KeyEq(), a)
    {
        insert(il.begin(), il.end());
    }
    // LWG 2713 -- see unordered_set above for why the init-list form is a
    // silently-wrong path rather than a missing one.
    template <typename It>
    unordered_multiset(It first, It last, const Alloc &a)
        : __t(0, Hash(), KeyEq(), a)
    {
        insert(first, last);
    }
    unordered_multiset(initializer_list<Key> il, const Alloc &a)
        : __t(0, Hash(), KeyEq(), a)
    {
        insert(il.begin(), il.end());
    }
    template <ContainerCompatibleRange<value_type> R>
    unordered_multiset(from_range_t, R &&rg, const Alloc &a)
        : __t(0, Hash(), KeyEq(), a)
    {
        insert_range(std::forward<R>(rg));
    }
    unordered_multiset &operator=(const unordered_multiset &) = default;
    unordered_multiset &operator=(unordered_multiset &&) = default;
    unordered_multiset &operator=(initializer_list<Key> il)
    {
        clear();
        insert(il.begin(), il.end());
        return *this;
    }

    allocator_type get_allocator() const noexcept
    {
        return __t.get_allocator();
    }

    iterator begin() const noexcept
    {
        return const_cast<unordered_multiset *>(this)->__t.begin();
    }
    iterator end() const noexcept
    {
        return const_cast<unordered_multiset *>(this)->__t.end();
    }
    const_iterator cbegin() const noexcept { return begin(); }
    const_iterator cend() const noexcept { return end(); }

    [[nodiscard]] bool empty() const noexcept { return __t.empty(); }
    size_type size() const noexcept { return __t.size(); }
    size_type max_size() const noexcept { return __t.max_size(); }

    iterator insert(const Key &v)
    {
        auto it = __t.EmplaceMulti(v);
        return iterator(it.__n, it.__t);
    }
    iterator insert(Key &&v)
    {
        auto it = __t.EmplaceMulti(std::move(v));
        return iterator(it.__n, it.__t);
    }
    iterator insert(const_iterator, const Key &v)
    {
        auto it = __t.EmplaceMulti(v); // hint accepted, not exploited
        return iterator(it.__n, it.__t);
    }
    iterator insert(const_iterator, Key &&v)
    {
        auto it = __t.EmplaceMulti(std::move(v));
        return iterator(it.__n, it.__t);
    }
    template <typename It>
    void insert(It first, It last)
    {
        for (; first != last; ++first) __t.EmplaceMulti(*first);
    }
    void insert(initializer_list<Key> il) { insert(il.begin(), il.end()); }
    template <ContainerCompatibleRange<value_type> R>
    void insert_range(R &&rg)
    {
        for (auto &&v : rg) __t.EmplaceMulti(std::forward<decltype(v)>(v));
    }
    template <typename... Args>
    iterator emplace(Args &&...args)
    {
        auto it = __t.EmplaceMulti(std::forward<Args>(args)...);
        return iterator(it.__n, it.__t);
    }
    template <typename... Args>
    iterator emplace_hint(const_iterator, Args &&...args)
    {
        auto it = __t.EmplaceMulti(std::forward<Args>(args)...);
        return iterator(it.__n, it.__t);
    }

    iterator erase(const_iterator where)
    {
        auto nx = __t.Erase(where);
        return iterator(nx.__n, nx.__t);
    }
    iterator erase(const_iterator first, const_iterator last)
    {
        while (first != last) first = __t.Erase(first);
        return iterator(first.__n, first.__t);
    }
    size_type erase(const Key &key) { return __t.EraseKey(key); }
    template <typename K>
        requires(__detail::TransparentHashEq<Hash, KeyEq> &&
                 !is_convertible_v<K &&, iterator> &&
                 !is_convertible_v<K &&, const_iterator>)
    size_type erase(K &&x)
    {
        return __t.EraseKey(std::forward<K>(x));
    }
    void clear() noexcept { __t.clear(); }
    void swap(unordered_multiset &other) noexcept(noexcept(__t.swap(other.__t))) { __t.swap(other.__t); }

    // ── node handle / merge (Ф28b) ──────────────────────────────────────

    node_type extract(const_iterator pos)
    {
        return node_type(__t.ExtractNode(pos), __t.GetNodeAlloc());
    }
    node_type extract(const Key &key)
    {
        iterator it = find(key);
        if (it == end()) return node_type();
        return extract(it);
    }
    template <typename K>
        requires(__detail::TransparentHashEq<Hash, KeyEq> &&
                 !is_convertible_v<K &&, iterator> &&
                 !is_convertible_v<K &&, const_iterator>)
    node_type extract(K &&x)
    {
        iterator it = find(x);
        if (it == end()) return node_type();
        return extract(it);
    }
    iterator insert(node_type &&nh)
    {
        if (nh.empty()) return end();
        auto it = __t.ReinsertMulti(nh.__Ptr());
        nh.__Disown();
        return iterator(it.__n, it.__t);
    }
    iterator insert(const_iterator, node_type &&nh)
    {
        return insert(std::move(nh));
    }
    template <typename H2, typename E2>
    void merge(unordered_set<Key, H2, E2, Alloc> &source)
    {
        __t.MergeMulti(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_set<Key, H2, E2, Alloc> &&source)
    {
        __t.MergeMulti(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_multiset<Key, H2, E2, Alloc> &source)
    {
        __t.MergeMulti(source.__Table());
    }
    template <typename H2, typename E2>
    void merge(unordered_multiset<Key, H2, E2, Alloc> &&source)
    {
        __t.MergeMulti(source.__Table());
    }
    TableT &__Table() noexcept { return __t; }

    iterator find(const Key &key) const
    {
        auto it = const_cast<unordered_multiset *>(this)->__t.Find(key);
        return iterator(it.__n, it.__t);
    }
    size_type count(const Key &key) const
    {
        return const_cast<unordered_multiset *>(this)->__t.Count(key);
    }
    bool contains(const Key &key) const { return find(key) != end(); }
    pair<iterator, iterator> equal_range(const Key &key) const
    {
        auto [lo, hi] = const_cast<unordered_multiset *>(this)->__t.EqualRange(
            key);
        return {iterator(lo.__n, lo.__t), iterator(hi.__n, hi.__t)};
    }

    // ── heterogeneous lookup (C++23, transparent Hash+KeyEq only) ───────

    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    iterator find(const K &key) const
    {
        auto it = const_cast<unordered_multiset *>(this)->__t.Find(key);
        return iterator(it.__n, it.__t);
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    size_type count(const K &key) const
    {
        return const_cast<unordered_multiset *>(this)->__t.Count(key);
    }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    bool contains(const K &key) const { return find(key) != end(); }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    pair<iterator, iterator> equal_range(const K &key) const
    {
        auto [lo, hi] =
            const_cast<unordered_multiset *>(this)->__t.EqualRange(key);
        return {iterator(lo.__n, lo.__t), iterator(hi.__n, hi.__t)};
    }

    size_type bucket_count() const noexcept { return __t.bucket_count(); }
    size_type bucket_size(size_type i) const noexcept
    {
        return __t.bucket_size(i);
    }
    size_type bucket(const Key &key) const { return __t.bucket(key); }
    template <typename K>
        requires __detail::TransparentHashEq<Hash, KeyEq>
    size_type bucket(const K &key) const { return __t.bucket(key); }
    local_iterator       begin(size_type n) { return __t.cbegin(n); }
    local_iterator       end(size_type n) { return __t.cend(n); }
    const_local_iterator begin(size_type n) const { return __t.cbegin(n); }
    const_local_iterator end(size_type n) const { return __t.cend(n); }
    const_local_iterator cbegin(size_type n) const { return __t.cbegin(n); }
    const_local_iterator cend(size_type n) const { return __t.cend(n); }
    float load_factor() const noexcept { return __t.load_factor(); }
    float max_load_factor() const noexcept { return __t.max_load_factor(); }
    void max_load_factor(float lf) noexcept { __t.max_load_factor(lf); }
    void rehash(size_type n) { __t.Rehash(n ? n : 8); }
    void reserve(size_type n) { __t.Reserve(n); }
    hasher hash_function() const { return __t.hash_function(); }
    key_equal key_eq() const { return __t.key_eq(); }

private:
    TableT __t;
};

template <typename K, typename H, typename E, typename A>
bool operator==(const unordered_set<K, H, E, A> &a,
                const unordered_set<K, H, E, A> &b)
{
    if (a.size() != b.size()) return false;
    for (const auto &k : a)
        if (!b.contains(k)) return false;
    return true;
}

template <typename K, typename H, typename E, typename A>
void swap(unordered_set<K, H, E, A> &a, unordered_set<K, H, E, A> &b) noexcept(noexcept(a.swap(b)))
{
    a.swap(b);
}

template <typename K, typename H, typename E, typename A, typename Pred>
typename unordered_set<K, H, E, A>::size_type
erase_if(unordered_set<K, H, E, A> &s, Pred pred)
{
    typename unordered_set<K, H, E, A>::size_type removed = 0;
    for (auto it = s.begin(); it != s.end();) {
        if (pred(*it)) {
            it = s.erase(it);
            ++removed;
        } else {
            ++it;
        }
    }
    return removed;
}

// Equal iff same size and, for every distinct value, its equal-range in `a`
// is a permutation of its equal-range in `b` — for a multiset that is just
// "same multiplicity", but phrased via RangeIsPermutation to share the
// exact conforming [unord.req] wording/shape with the multimap overload.
template <typename K, typename H, typename E, typename A>
bool operator==(const unordered_multiset<K, H, E, A> &a,
                const unordered_multiset<K, H, E, A> &b)
{
    if (a.size() != b.size()) return false;
    for (auto it = a.begin(); it != a.end();) {
        auto ra = a.equal_range(*it);
        auto rb = b.equal_range(*it);
        size_t na = 0;
        for (auto x = ra.first; x != ra.second; ++x) ++na;
        size_t nb = 0;
        for (auto x = rb.first; x != rb.second; ++x) ++nb;
        if (na != nb) return false;
        if (!__ht::RangeIsPermutation(ra.first, ra.second, rb.first, rb.second))
            return false;
        it = ra.second;
    }
    return true;
}

template <typename K, typename H, typename E, typename A>
void swap(unordered_multiset<K, H, E, A> &a,
          unordered_multiset<K, H, E, A> &b) noexcept(noexcept(a.swap(b)))
{
    a.swap(b);
}

template <typename K, typename H, typename E, typename A, typename Pred>
typename unordered_multiset<K, H, E, A>::size_type
erase_if(unordered_multiset<K, H, E, A> &s, Pred pred)
{
    typename unordered_multiset<K, H, E, A>::size_type removed = 0;
    for (auto it = s.begin(); it != s.end();) {
        if (pred(*it)) {
            it = s.erase(it);
            ++removed;
        } else {
            ++it;
        }
    }
    return removed;
}

