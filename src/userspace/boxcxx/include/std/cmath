inline float  scalbln(float x, long n)      { return float(scalbln(double(x), n)); }
inline float  nextafter(float x, float y)   { return float(nextafter(double(x), double(y))); }
inline float  remquo(float x, float y, int *q){ return float(remquo(double(x), double(y), q)); }
