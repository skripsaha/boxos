// ── correctly-rounded inverse trig (software double-double, 80-bit) ──────────
// asin/acos in dd on the CR atan kernel. |x| ≤ √½ uses asin(x)=atan(x/√(1−x²))
// directly; nearer ±1 (where that quotient blows up) it range-reduces through
// asin(√((1−|x|)/2)). NO x87 fpatan ⇒ genuine 80-bit.
inline constexpr long double KSQRT1_2_L = 0.70710678118654752440084436210485L;  // √½
// asin of a dd argument on [0,√½] as dd: asin(a)=atan(a/√(1−a²)); the quotient
// stays in [0,1] so it feeds atan_reduced_dd directly.
inline LdDd asin_small_dd(LdDd a){
    LdDd a2 = dd_mul_ld(a, a);
    LdDd w  = sqrt_dd(dd_add_ld(LdDd{1.0L, 0.0L}, LdDd{-a2.hi, -a2.lo}));   // √(1−a²)
    return atan_reduced_dd(dd_div_ld(a, w));                                // atan(a/√(1−a²))
}
inline long double asin(long double x){
    if (isnan(x)) return x;
    long double a = fabs(x);
    if (a > 1.0L)     return raise_domain_l();           // domain
    if (a < 0x1p-32L) return x;                          // asin(x)=x (odd; ±0)
    LdDd res;
    if (a <= KSQRT1_2_L)
        res = asin_small_dd(LdDd{a, 0.0L});
    else {                                               // π/2 − 2·asin(√((1−a)/2))
        long double sh, sl; two_sum_l(1.0L, -a, sh, sl); // 1−a (exact dd)
        LdDd as = asin_small_dd(sqrt_dd(LdDd{sh * 0.5L, sl * 0.5L}));
        LdDd hp{ld_from_bits_l(kHalfPiHiM, kHalfPiHiS), ld_from_bits_l(kHalfPiLoM, kHalfPiLoS)};
        res = dd_add_ld(hp, LdDd{-(as.hi + as.hi), -(as.lo + as.lo)});
    }
    long double v = res.hi + res.lo;
    return signbit(x) ? -v : v;
}
inline long double acos(long double x){
    if (isnan(x)) return x;
    long double a = fabs(x);
    if (a > 1.0L) return raise_domain_l();               // domain
    LdDd hp{ld_from_bits_l(kHalfPiHiM, kHalfPiHiS), ld_from_bits_l(kHalfPiLoM, kHalfPiLoS)};
    LdDd res;
    if (a <= KSQRT1_2_L){                                // π/2 ∓ asin(|x|)
        LdDd as = asin_small_dd(LdDd{a, 0.0L});
        res = signbit(x) ? dd_add_ld(hp, as) : dd_add_ld(hp, LdDd{-as.hi, -as.lo});
    } else {                                             // 2·asin(√((1−|x|)/2)) [x>0]; π − that [x<0]
        long double sh, sl; two_sum_l(1.0L, -a, sh, sl); // 1−|x| (exact dd)
        LdDd as = asin_small_dd(sqrt_dd(LdDd{sh * 0.5L, sl * 0.5L}));
        LdDd twoas{as.hi + as.hi, as.lo + as.lo};
        if (signbit(x)){                                 // x<0: π − 2·asin(t)
            LdDd pi{hp.hi + hp.hi, hp.lo + hp.lo};
            res = dd_add_ld(pi, LdDd{-twoas.hi, -twoas.lo});
        } else res = twoas;
    }
    return res.hi + res.lo;
}
// Correctly round the exact real a+b+c (three long doubles, a leading) to the
// 64-bit mantissa in ONE rounding. The small-x expm1 series needs a third word:
// xᵏ/k! can land on the EXACT half-ULP of x (e.g. x=2⁻⁶³ ⇒ x²/2 = ½·ULP), where
// the ~127-bit dd ties to even but the tail (x³/6, …) actually breaks the tie.
// Scales so ULP(a)=1 and rounds the integer grid with half-even + tail sign-break.
inline long double round_triple_l(long double a, long double b, long double c){
    long double s, e;
    two_sum_l(b, c, s, e); b = s; c = e;                 // renormalize {a,b,c}
    two_sum_l(a, b, s, e); a = s; b = e;
    two_sum_l(b, c, s, e); b = s; c = e;
    if (a == 0.0L) return a;
    int sh = 63 - ilogb(a);
    long double P  = scalbn(a, sh);                      // integer in [2⁶³, 2⁶⁴)
    long double Q  = scalbn(b, sh);                      // |Q| ≤ ½
    long double Rr = scalbn(c, sh);                      // tiny tail (tie-breaker)
    long double K = P;
    if      (Q >  0.5L) K = P + 1.0L;
    else if (Q < -0.5L) K = P - 1.0L;
    else if (Q ==  0.5L){ long double h = P * 0.5L; if (Rr > 0.0L || (Rr == 0.0L && h != rint(h))) K = P + 1.0L; }
    else if (Q == -0.5L){ long double h = P * 0.5L; if (Rr < 0.0L || (Rr == 0.0L && h != rint(h))) K = P - 1.0L; }
    return scalbn(K, -sh);
}
// ── correctly-rounded e^x−1 (software double-double, genuine 80-bit) ─────────
// The x87 f2xm1 transcendental is neither correctly rounded nor faithful on
// QEMU-TCG. Two regimes, each correctly rounded once to the 64-bit mantissa:
//   |x| < ½ — d = Σ_{k≥2} xᵏ/k! in dd (= e^x−1−x, no leading term ⇒ no
//     catastrophic cancellation). x + d rounds through round_triple_l so the
//     exact half-ULP tie family (x≈2⁻⁶³) rounds by the series tail, not to even.
//   |x| ≥ ½ — e^x−1 = 2ⁿ·2^f − 1 (2^f∈[√½,√2] via the proven dd exp series).
//     For nᵢ ≤ 120 the −1 is captured exactly in dd; past that the −1 sinks below
//     the ~127-bit floor so CR(e^x)=CR(e^x−1) and scalbn does the IEEE overflow.
inline long double expm1(long double x){
    if (isnan(x)) return x;
    if (isinf(x)) return signbit(x) ? -1.0L : kInfL;     // e^{-inf}-1=-1, e^{+inf}-1=+inf
    if (x == 0.0L) return x;                              // expm1(±0)=±0 (keep zero sign)
    if (fabs(x) < 0.5L){                                  // direct dd series (d = e^x−1−x)
        LdDd d{0.0L, 0.0L}, term{x, 0.0L};               // term₁ = x; d accumulates k≥2
        for (int k = 2; k <= 34; ++k){                   // Σ_{k=2}^{34} xᵏ/k!
            term = dd_mul_ld(term, LdDd{x, 0.0L});       // term *= x
            term = dd_div_ld(term, LdDd{(long double)k, 0.0L});  // term /= k
            d    = dd_add_ld(d, term);
        }
        return round_triple_l(x, d.hi, d.lo);            // x + d, correctly rounded
    }
    LdDd X = dd_mul_ld(LdDd{x, 0.0L}, LdDd{KLOG2E_DD_HI_L, KLOG2E_DD_LO_L}); // x·log2 e (dd)
    long double n = rint(X.hi);
    long double fh, fl; two_sum_l(X.hi - n, X.lo, fh, fl);   // f = (X−n) (dd, |f| ≤ 0.5)
    LdDd t = dd_mul_ld(LdDd{fh, fl}, LdDd{KLN2DD_HI_L, KLN2DD_LO_L});   // t = f·ln2
    LdDd e = exp_series_dd(t);                           // 2^f as dd (∈[√½,√2], ~127 bits)
    int ni = (int)n;
    if (ni > 120)                                        // −1 below dd floor: CR(e^x)=CR(e^x−1)
        return scalbn(e.hi + e.lo, ni);                  // natural IEEE overflow to +Inf past LDBL_MAX
    LdDd E{scalbn(e.hi, ni), scalbn(e.lo, ni)};          // e^x = 2ⁿ·2^f as dd (exact, no overflow)
    LdDd r = dd_add_ld(E, LdDd{-1.0L, 0.0L});            // e^x − 1 in dd, −1 captured exactly
    return r.hi + r.lo;                                  // correctly round to 64-bit
}
// ── correctly-rounded hyperbolic functions (software double-double, 80-bit) ──
// Factor out the dominant exponent: e^a = 2^na·Ma, e^{−a} = 2^nb·Mb (Ma,Mb the
// bounded dd mantissas from exp_reduce_dd, na ≥ nb for a ≥ 0), then
//   cosh(a) = 2^(na−1)·(Ma + 2^(nb−na)·Mb),  sinh(a) = 2^(na−1)·(Ma − 2^(nb−na)·Mb).
// The bracket B ∈ ~[0.7,1.5] is a dd; RN64(B)·2^(na−1) = RN(result) because
// rounding commutes with scaling by a power of two for normal results. The two
// leading mantissas differ by < a factor of 2, so Ma−Mb cancels exactly
// (Sterbenz) — sinh needs no separate small-x path down to the 2⁻³² floor where
// sinh(x)=x. NO x87 fsinh/f2xm1 — only faithful arithmetic ⇒ genuine 80-bit.
inline long double cosh(long double x){
    if (isnan(x)) return x;
    long double a = fabs(x);
    if (a > 11400.0L) return isinf(x) ? kInfL : raise_overflow_l(1.0L);  // overflow
    int na, nb;
    LdDd Ma = exp_reduce_dd(a, na);                       // e^a  = 2^na·Ma
    LdDd Mb = exp_reduce_dd(-a, nb);                      // e^-a = 2^nb·Mb  (na ≥ nb)
    int d = nb - na;                                      // ≤ 0
    LdDd sm = (d <= -130) ? LdDd{0.0L, 0.0L}
                          : LdDd{scalbn(Mb.hi, d), scalbn(Mb.lo, d)};
    LdDd B = dd_add_ld(Ma, sm);                           // Ma + 2^d·Mb ∈ ~[1,1.5]
    return scalbn(B.hi + B.lo, na - 1);                   // CR; scalbn overflows → +Inf
}
inline long double sinh(long double x){
