// ════════════════════════════════════════════════════════════════════════
//  erf / erfc / tgamma / lgamma at genuine 80-bit (Ф27d2).
//  The main paths are transcendental-free: exp/log are built here in software
//  double-double (poly + fscale + bit-ops), so QEMU/Bochs/real-HW all compute
//  them at true 80-bit. Only gamma/lgamma reflection (x<0.5, via sinpi_l→fsin,
//  and lgamma's log) rides the x87 transcendental microcode — genuine 80-bit on
//  Bochs/real-HW, host-double on QEMU. Errno-free like every other path here.
// ════════════════════════════════════════════════════════════════════════

// Dekker double-double primitives two_sum_l/split_l/two_prod_l are defined
// with the correctly-rounded exp2/exp core above and reused here.

// erf/erfc are tableless: a dd Maclaurin series for |x|<2 and a dd continued
// fraction for |x|≥2, on the CR exp core — no fitted coefficients, so accuracy
// is bounded only by the ~127-bit dd, not by 64-bit tables ⇒ correctly rounded.
inline constexpr long double KTWO_O_SQRTPI_HI = 0x1.20dd750429b6d11ap+0L;   // 2/√π
inline constexpr long double KTWO_O_SQRTPI_LO = 0xe.3a914fed7fd8688p-68L;
inline constexpr long double KINV_SQRTPI_HI   = 0x9.06eba8214db688dp-4L;     // 1/√π
inline constexpr long double KINV_SQRTPI_LO   = 0x7.1d48a7f6bfec344p-68L;
// erf(a), a∈[0,2), as dd: (2/√π)·Σ_{k≥0} (−1)^k a^{2k+1}/(k!(2k+1)). Ratio
// T_k = T_{k-1}·(−a²)·(2k−1)/(k(2k+1)) kept in dd; ≤~2-bit cancellation on [0,2).
inline LdDd erf_series_dd(long double a){
    LdDd a2 = dd_mul_ld(LdDd{a, 0.0L}, LdDd{a, 0.0L});
    LdDd na2{-a2.hi, -a2.lo};
    LdDd T{a, 0.0L}, S{a, 0.0L};
    for (int k = 1; k < 90; ++k){
        LdDd ratio = dd_mul_ld(na2, dd_div_ld(LdDd{(long double)(2 * k - 1), 0.0L},
                                              LdDd{(long double)k * (long double)(2 * k + 1), 0.0L}));
        T = dd_mul_ld(T, ratio);
        S = dd_add_ld(S, T);
        if (fabs(T.hi) < fabs(S.hi) * 0x1p-74L) break;
    }
    return dd_mul_ld(LdDd{KTWO_O_SQRTPI_HI, KTWO_O_SQRTPI_LO}, S);
}
// e^{−a²} as dd, exponent-managed: e^{−a²} = 2^ne · M (M ∈ [√½,√2) dd).
inline LdDd exp_neg_sq_dd(long double a, int &ne){
    long double x2h, x2l; two_prod_l(a, a, x2h, x2l);
    LdDd X = dd_mul_ld(LdDd{-x2h, -x2l}, LdDd{KLOG2E_DD_HI_L, KLOG2E_DD_LO_L});
    long double n = rint(X.hi);
    long double fh, fl; two_sum_l(X.hi - n, X.lo, fh, fl);
    ne = (int)n;
    return exp_series_dd(dd_mul_ld(LdDd{fh, fl}, LdDd{KLN2DD_HI_L, KLN2DD_LO_L}));
}
// erfc(a), a≥2, as dd: (1/√π)·e^{−a²}·CF, CF = 1/(a + ½/(a + 1/(a + 3/2/(a+…)))),
// bₖ=k/2. Backward recurrence, depth grows for small a. Returns 2^ne·qdd (qdd~O(1)).
inline LdDd erfc_cf_dd(long double a, int &ne){
    LdDd M = exp_neg_sq_dd(a, ne);
    int D = 44 + (int)(360.0L / a);
    LdDd c{0.0L, 0.0L};
    for (int k = D; k >= 1; --k)
        c = dd_div_ld(LdDd{0.5L * (long double)k, 0.0L}, dd_add_ld(LdDd{a, 0.0L}, c));
    LdDd cf = dd_div_ld(LdDd{1.0L, 0.0L}, dd_add_ld(LdDd{a, 0.0L}, c));
    return dd_mul_ld(dd_mul_ld(LdDd{KINV_SQRTPI_HI, KINV_SQRTPI_LO}, M), cf);
}
inline long double erf(long double x){
    if (isnan(x)) return x;
    if (isinf(x)) return copysign(1.0L, x);
    long double a = fabs(x), r;
    if (a < 1.5L){ LdDd e = erf_series_dd(a); r = e.hi + e.lo; }
    else if (a < 6.9L){                                  // erf = 1 − erfc (dd)
        int ne; LdDd q = erfc_cf_dd(a, ne);
        LdDd erfc_dd{scalbn(q.hi, ne), scalbn(q.lo, ne)};
        LdDd e = dd_add_ld(LdDd{1.0L, 0.0L}, LdDd{-erfc_dd.hi, -erfc_dd.lo});
        r = e.hi + e.lo;
    } else r = 1.0L;                                     // erfc(a) < ½ ULP(1) beyond
    return copysign(r, x);
}
inline long double erfc(long double x){
    if (isnan(x)) return x;
    if (isinf(x)) return signbit(x) ? 2.0L : 0.0L;
    long double a = fabs(x);
    if (a < 1.5L){                                       // erfc = 1 ∓ erf (dd)
        LdDd e = erf_series_dd(a);
        LdDd r = dd_add_ld(LdDd{1.0L, 0.0L}, signbit(x) ? e : LdDd{-e.hi, -e.lo});
        return r.hi + r.lo;
    }
    if (a >= 107.0L) return signbit(x) ? 2.0L : 0.0L;    // e^{−a²} underflows 80-bit
    int ne; LdDd q = erfc_cf_dd(a, ne);
    if (!signbit(x)){
        if (ne <= -16382) return round_dd_to_subnormal_l(q.hi, q.lo, ne);
        long double v = scalbn(q.hi + q.lo, ne);
        return v < 0.0L ? 0.0L : v;
    }
    LdDd r = dd_add_ld(LdDd{2.0L, 0.0L}, LdDd{-scalbn(q.hi, ne), -scalbn(q.lo, ne)}); // 2−erfc
    return r.hi + r.lo;
}

