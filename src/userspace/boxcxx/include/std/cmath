// ── hypot, three-argument ([c.math.hypot3], C++17) ────────────────────────
// sqrt(x²+y²+z²) without squaring first, which would overflow for arguments
// past ~1e154. Scaling is by a POWER OF TWO taken from the largest magnitude,
// so it is exact both ways and costs no accuracy — after it the largest term
// is in [1,2), the sum of three squares cannot overflow, and subnormal inputs
// have been lifted out of the range where squaring flushes them to zero.
// The infinity rule is the one the two-argument form already follows: an
// infinite argument gives +Inf even when another argument is NaN, because the
// result is determined regardless of what the NaN stands for.
inline double hypot(double x, double y, double z) {
    if (isinf(x) || isinf(y) || isinf(z)) return kInf;
    if (isnan(x) || isnan(y) || isnan(z)) return kQNaN;
    double ax = fabs(x), ay = fabs(y), az = fabs(z);
    double m = ax > ay ? ax : ay;
    if (az > m) m = az;
    if (m == 0.0) return 0.0;
    const int e = ilogb(m);
    ax = scalbn(ax, -e); ay = scalbn(ay, -e); az = scalbn(az, -e);
    return scalbn(sqrt(ax * ax + ay * ay + az * az), e);   // ≤2 ULP
}
// float: each square is exact in double (2×24 ≤ 53) and only the two sums and
// the sqrt round, so the narrowed result is correctly rounded away from ties.
inline float hypot(float x, float y, float z) {
    if (isinf(x) || isinf(y) || isinf(z)) return kInfF;
    if (isnan(x) || isnan(y) || isnan(z)) return kQNaNF;
    double dx = x, dy = y, dz = z;
    return float(sqrt(dx * dx + dy * dy + dz * dz));
}

// ── lerp ([c.math.lerp], C++20 / P0811R3) ─────────────────────────────────
// Not `a + t*(b-a)`, which overshoots past the endpoint near t=1, and not
// `(1-t)*a + t*b`, which is not monotonic. P0811R3's shape is the one that
// keeps all four guarantees at once — exact at t==0 and t==1, bounded inside
// [0,1], monotonic, and consistent — so it is reproduced here verbatim rather
// than re-derived.
//   * the straddling-zero branch is where (1-t)*a is safe and cannot overflow;
//   * `t == 1` is returned exactly, before any arithmetic can perturb it;
//   * the final clamp against b is what restores monotonicity near t == 1.
// A NaN t is NOT propagated: it falls through to the clamp and yields b. That
// is what [c.math.lerp]/2 permits — it says only when the result must *not* be
// NaN — and it is what both reference libraries do, measured, so the choice is
// theirs as much as ours.
template <typename T>
constexpr T __lerp_core(T a, T b, T t) noexcept
{
    if ((a <= T(0) && b >= T(0)) || (a >= T(0) && b <= T(0)))
        return t * b + (T(1) - t) * a;
    if (t == T(1)) return b;
    const T x = a + t * (b - a);
    if ((t > T(1)) == (b > a)) return b < x ? x : b;
    return x < b ? x : b;
}
constexpr float lerp(float a, float b, float t) noexcept
{
    return __lerp_core(a, b, t);
}
constexpr double lerp(double a, double b, double t) noexcept
{
    return __lerp_core(a, b, t);
}
constexpr long double lerp(long double a, long double b, long double t) noexcept
{
    return __lerp_core(a, b, t);
}

// ── completeness: long double overloads + C-named (f,l) + comparisons ──────
// erf/erfc/tgamma/lgamma long double are genuine 80-bit, defined at the end of
// this namespace (Ф27d2); asin/acos, the hyperbolics + inverse hyperbolics,
// expm1/cbrt/pow/hypot/fma are the composed 80-bit primaries (Ф27d1b). No
// classical <cmath> function stays narrowed to double.
// ════════════════════════════════════════════════════════════════════════
//  long double = 80-bit x87: genuine hardware implementations (Ф27d1a).
//  Layout: mantissa = bits[63:0] (bit 63 = explicit integer bit), exponent =
//  bits[78:64] (15-bit, bias 16383), sign = bit 79, bits[127:80] = padding
//  (masked). Errno-free like the double paths: return kQNaNL/kInfL/signed-zero
//  directly, never set errno, never raise. float/double overloads unchanged.
// ════════════════════════════════════════════════════════════════════════
inline unsigned __int128 ldbits(long double x){ return __builtin_bit_cast(unsigned __int128, x); }
inline unsigned ld_exp(long double x){ return (unsigned)(uint16_t)(ldbits(x) >> 64) & 0x7FFFu; }
inline u64      ld_man(long double x){ return (u64)ldbits(x); }

inline bool signbit(long double x){ return ((ldbits(x) >> 79) & 1) != 0; }
inline bool isnan(long double x){ return ld_exp(x) == 0x7FFF && (ld_man(x) & 0x7FFFFFFFFFFFFFFFull) != 0; }
inline bool isinf(long double x){ return ld_exp(x) == 0x7FFF && ld_man(x) == 0x8000000000000000ull; }
inline bool isfinite(long double x){ return ld_exp(x) != 0x7FFF; }
inline bool isnormal(long double x){ unsigned e = ld_exp(x); return e != 0 && e != 0x7FFF; }
inline int  fpclassify(long double x){
    unsigned e = ld_exp(x); u64 m = ld_man(x);
    if (e == 0x7FFF) return (m & 0x7FFFFFFFFFFFFFFFull) ? FP_NAN_ : FP_INFINITE_;
    if (e == 0)      return (m == 0) ? FP_ZERO_ : FP_SUBNORMAL_;
    return FP_NORMAL_;
}

constexpr long double kInfL   = __builtin_infl();
constexpr long double kQNaNL  = __builtin_nanl("");

// The long double half of the four helpers above. Separate because the
// arithmetic must happen in x87 — that is where long double reports, and a
// double-precision division would raise the flag in the WRONG unit.
inline long double raise_domain_l()
{
    volatile long double zero = 0.0L;
    return zero / zero;
}
inline long double raise_pole_l(long double sign)
{
    volatile long double s = sign, zero = 0.0L;
    return s / zero;
}
inline long double raise_overflow_l(long double sign)
{
    volatile long double big = 0x1p16383L;
    return sign * (big * big);
}
inline long double raise_underflow_l(long double sign)
{
    volatile long double tiny = 0x1p-16382L;
    return sign * (tiny * tiny);
}
constexpr long double kTwoPiL = 6.283185307179586476925286766559005768L;
constexpr long double kLn2L   = 0.693147180559945309417232121458176568L;

// x87 control word: bits[11:10] = rounding control (00 nearest, 01 down, 10 up, 11 trunc).
inline uint16_t x87_getcw(){ uint16_t cw; __asm__ volatile("fnstcw %0" : "=m"(cw)); return cw; }
inline void     x87_setcw(uint16_t cw){ __asm__ volatile("fldcw %0" :: "m"(cw)); }

// ── direct x87 ops (each sequence is stack-balanced: every push is popped) ──
inline long double fabs(long double x){ long double r; __asm__("fabs" : "=t"(r) : "0"(x)); return r; }
inline long double sqrt(long double x){ long double r; __asm__("fsqrt" : "=t"(r) : "0"(x)); return r; }
inline long double copysign(long double x, long double y){
    unsigned __int128 s = (unsigned __int128)1 << 79;
    return __builtin_bit_cast(long double, (ldbits(x) & ~s) | (ldbits(y) & s));
}

// frndint under an explicit rounding control; control word saved/restored.
inline long double x87_round_mode(long double x, uint16_t rc){
    uint16_t cw = x87_getcw();
    uint16_t nw = (uint16_t)((cw & ~0x0C00u) | ((unsigned)rc << 10));
    long double r;
    __asm__ volatile("fldcw %[nw]\n\t"
                     "frndint\n\t"
                     "fldcw %[cw]"
                     : "=t"(r) : "0"(x), [nw]"m"(nw), [cw]"m"(cw));
    return r;
}
inline long double trunc(long double x){ return isfinite(x) ? x87_round_mode(x, 3) : x; }
inline long double floor(long double x){ return isfinite(x) ? x87_round_mode(x, 1) : x; }
inline long double ceil (long double x){ return isfinite(x) ? x87_round_mode(x, 2) : x; }
inline long double rint (long double x){ if (!isfinite(x)) return x; long double r; __asm__("frndint" : "=t"(r) : "0"(x)); return r; }
inline long double nearbyint(long double x){ return rint(x); }   // no fetestexcept in boxcxx: identical to rint
inline long double round(long double x){                         // round half away from zero
    if (!isfinite(x)) return x;
    long double t = trunc(x), d = x - t;
    if (d >=  0.5L) return t + 1.0L;
    if (d <= -0.5L) return t - 1.0L;
    return t;
}

inline long double scalbn(long double x, int n){
    if (!isfinite(x) || x == 0.0L) return x;
    long double ln = (long double)n, r;
    __asm__("fscale\n\tfstp %%st(1)" : "=t"(r) : "0"(x), "u"(ln));
    return r;
}
inline long double ldexp(long double x, int n){ return scalbn(x, n); }
inline long double scalbln(long double x, long n){
    int ni = (n > 100000) ? 100000 : (n < -100000 ? -100000 : (int)n);
    return scalbn(x, ni);
}

inline long double logb(long double x){
    if (x == 0.0L) return raise_pole_l(-1.0L);           // F.10.3.11 pole error
    if (isinf(x))  return kInfL;
    if (isnan(x))  return x;
    long double e; __asm__("fxtract\n\tfstp %%st(0)" : "=t"(e) : "0"(x) : "st(1)");
    return e;                                             // fxtract: st0=significand, st1=exponent
}
inline int ilogb(long double x){
    unsigned e = ld_exp(x); u64 m = ld_man(x);
    if (e == 0){
        if (m == 0) return FP_ILOGB0;
        int n = 0; while (!(m & 0x8000000000000000ull)) { m <<= 1; ++n; }
        return -16382 - n;                               // subnormal
    }
    if (e == 0x7FFF) return (m & 0x7FFFFFFFFFFFFFFFull) ? FP_ILOGBNAN : 2147483647;   // NaN : Inf
    return (int)e - 16383;
}
inline long double frexp(long double x, int *e){
    if (!isfinite(x) || x == 0.0L) { *e = 0; return x; }
    long double sig, expo;
    __asm__("fxtract" : "=t"(sig), "=u"(expo) : "0"(x));
    *e = (int)expo + 1;
    return sig * 0.5L;                                    // sig∈[1,2) → m∈[0.5,1)
}

// ── correctly-rounded 2^x / e^x (software double-double, genuine 80-bit) ────
// The x87 f2xm1 transcendental is neither correctly rounded nor faithful on
// QEMU-TCG (it degrades to host-double there). This path uses ONLY faithful
// 80-bit fadd/fmul/fsub/fdiv/fscale/frndint, carries ~127 bits in a
// double-double, and correctly rounds to the 64-bit mantissa (0 ULP vs the
// true value, verified against MPFR). two_sum_l/split_l/two_prod_l are the
// Dekker primitives, reused by the Ф27d2 erf/gamma paths further below.
struct LdDd { long double hi, lo; };

inline void two_sum_l(long double a, long double b, long double &s, long double &e){
    s = a + b;
    long double bb = s - a;
    e = (a - (s - bb)) + (b - bb);
}
inline void split_l(long double a, long double &hi, long double &lo){
    const long double SPLIT = 4294967297.0L;         // 2^32 + 1 splits a 64-bit mantissa
    long double c = SPLIT * a;
    hi = c - (c - a);
    lo = a - hi;
}
inline void two_prod_l(long double a, long double b, long double &p, long double &e){
    p = a * b;
    long double ah, al, bh, bl;
    split_l(a, ah, al);
    split_l(b, bh, bl);
    e = ((ah * bh - p) + ah * bl + al * bh) + al * bl;
