// lnΓ(1+t) for |t| ≤ ~1/32 as dd Taylor t·Σ LG1P[j]·tʲ (LG1P[0]=−γ, LG1P[k-1]=(−1)^k ζ(k)/k):
// fixes the lnΓ(z)−Σln zᵢ cancellation for x within ~2⁻⁵⁸ of 1 or 2 (where lnΓ→0).
inline LdDd lgamma1p_dd(long double t){
    LdDd T{t, 0.0L}, s{LG1P_HI[LG1P_N - 1], LG1P_LO[LG1P_N - 1]};
    for (int i = LG1P_N - 2; i >= 0; --i)
        s = dd_add_ld(dd_mul_ld(s, T), LdDd{LG1P_HI[i], LG1P_LO[i]});
    return dd_mul_ld(T, s);
}
// sin(π·x) as dd: r = x−round(x) ∈ [−½,½]; sin(π·r) dd Taylor; sign by parity.
inline LdDd sinpi_dd(long double x){
    long double k = rint(x), r = x - k;
    LdDd t = dd_mul_ld(LdDd{KPI_G_HI, KPI_G_LO}, LdDd{r, 0.0L});
    LdDd t2 = dd_mul_ld(t, t), term = t, s = t;
    for (int n = 1; n < 22; ++n){
        LdDd c = dd_div_ld(LdDd{-1.0L, 0.0L}, LdDd{(long double)(2*n) * (long double)(2*n+1), 0.0L});
        term = dd_mul_ld(term, dd_mul_ld(t2, c));
        s = dd_add_ld(s, term);
        if (fabs(term.hi) < fabs(s.hi) * 0x1p-74L) break;
    }
    return (fmod(k, 2.0L) != 0.0L) ? LdDd{-s.hi, -s.lo} : s;
}
inline LdDd stirling_series_dd(LdDd z){                  // Σ STIRL[k]/z^{2k+1} (dd)
    LdDd iv = dd_div_ld(LdDd{1.0L, 0.0L}, z), iv2 = dd_mul_ld(iv, iv);
    LdDd s{STIRL_DD_HI[STIRL_DD_N - 1], STIRL_DD_LO[STIRL_DD_N - 1]};
    for (int i = STIRL_DD_N - 2; i >= 0; --i)
        s = dd_add_ld(dd_mul_ld(s, iv2), LdDd{STIRL_DD_HI[i], STIRL_DD_LO[i]});
    return dd_mul_ld(iv, s);
}
inline LdDd stirling_lngamma_dd(LdDd z){                  // lnΓ(z), z ≥ 11
    LdDd L = log_dd_core_dd(z);
    LdDd r = dd_mul_ld(dd_add_ld(z, LdDd{-0.5L, 0.0L}), L);   // (z−½)·ln z
    r = dd_add_ld(r, LdDd{-z.hi, -z.lo});                     // − z
    r = dd_add_ld(r, LdDd{KHALFLOG2PI_HI, KHALFLOG2PI_LO});   // + ½ln2π
    return dd_add_ld(r, stirling_series_dd(z));
}
inline LdDd exp2_dd_full(long double Xhi, long double Xlo){   // 2^X as dd (over/underflow → dd inf/0)
    long double n = rint(Xhi);
    long double fh, fl; two_sum_l(Xhi - n, Xlo, fh, fl);
    LdDd e = exp_series_dd(dd_mul_ld(LdDd{fh, fl}, LdDd{KLN2DD_HI_L, KLN2DD_LO_L}));
    int ni = (int)n;
    return LdDd{scalbn(e.hi, ni), scalbn(e.lo, ni)};
}
inline LdDd tgamma_dd(LdDd y){                           // Γ(y) as dd, y ≥ ½ (dd carries near-int lo)
    LdDd z = y, den{1.0L, 0.0L};
    while (z.hi < 11.0L){ den = dd_mul_ld(den, z); z = dd_add_ld(z, LdDd{1.0L, 0.0L}); }
    LdDd P = dd_mul_ld(stirling_lngamma_dd(z), LdDd{KLOG2E_G_HI, KLOG2E_G_LO});
    return dd_div_ld(exp2_dd_full(P.hi, P.lo), den);         // Γ(z)/Πzᵢ
}
inline LdDd lgamma_dd(LdDd x){                           // lnΓ(x) as dd, x ≥ ½ (dd carries near-int lo)
    LdDd z = x, sum{0.0L, 0.0L};
    while (z.hi < 11.0L){ sum = dd_add_ld(sum, log_dd_core_dd(z)); z = dd_add_ld(z, LdDd{1.0L, 0.0L}); }
    return dd_add_ld(stirling_lngamma_dd(z), LdDd{-sum.hi, -sum.lo});   // lnΓ(z) − Σ ln zᵢ
}
inline long double tgamma(long double x){
    if (isnan(x)) return x;
    if (isinf(x)) return signbit(x) ? raise_domain_l() : kInfL;
    if (x == 0.0L) return raise_pole_l(copysign(1.0L, x));
    if (x < 0.0L && x == floor(x)) return raise_domain_l();  // negative integers
    if (x >= 11.0L){                                     // no recurrence: Γ=exp(lnΓ), exp2_dd_core
        LdDd P = dd_mul_ld(stirling_lngamma_dd(LdDd{x, 0.0L}), LdDd{KLOG2E_G_HI, KLOG2E_G_LO});
        return exp2_dd_core(P.hi, P.lo);                 // clean overflow to +Inf past x≈1755
    }
    if (x >= 0.5L){ LdDd g = tgamma_dd(LdDd{x, 0.0L}); return g.hi + g.lo; }
    LdDd y; two_sum_l(1.0L, -x, y.hi, y.lo);             // 1−x as dd (keeps near-int lo bits)
    LdDd denom = dd_mul_ld(sinpi_dd(x), tgamma_dd(y));   // reflection: π/(sin(πx)·Γ(1−x))
    LdDd g = dd_div_ld(LdDd{KPI_G_HI, KPI_G_LO}, denom);
    return g.hi + g.lo;
}
inline long double lgamma(long double x){
    if (isnan(x)) return x;
    if (isinf(x)) return kInfL;
    if (x == 0.0L) return raise_pole_l(1.0L);            // pole error
    if (x < 0.0L && x == floor(x)) return raise_pole_l(1.0L);   // poles
    if (x == 1.0L || x == 2.0L) return 0.0L;             // lnΓ(1)=lnΓ(2)=0 exactly
    if (fabs(x - 1.0L) <= 0x1p-5L){ LdDd r = lgamma1p_dd(x - 1.0L); return r.hi + r.lo; } // near 1
    if (fabs(x - 2.0L) <= 0x1p-5L){                      // near 2: lnΓ(2+t)=ln(1+t)+lnΓ(1+t)
        long double t = x - 2.0L; LdDd w; two_sum_l(1.0L, t, w.hi, w.lo);
        LdDd r = dd_add_ld(log_dd_core_dd(w), lgamma1p_dd(t)); return r.hi + r.lo;
    }
    if (x >= 0.5L){ LdDd r = lgamma_dd(LdDd{x, 0.0L}); return r.hi + r.lo; }
    LdDd y; two_sum_l(1.0L, -x, y.hi, y.lo);             // 1−x as dd
    LdDd sp = sinpi_dd(x);                               // reflection: lnπ − ln|sin πx| − lnΓ(1−x)
    LdDd absp = sp.hi < 0.0L ? LdDd{-sp.hi, -sp.lo} : sp;
    LdDd lnpi = log_dd_core_dd(LdDd{KPI_G_HI, KPI_G_LO});
    LdDd lnsp = log_dd_core_dd(absp);
    LdDd lg1 = lgamma_dd(y);
    LdDd r = dd_add_ld(dd_add_ld(lnpi, LdDd{-lnsp.hi, -lnsp.lo}), LdDd{-lg1.hi, -lg1.lo});
    return r.hi + r.lo;
}

