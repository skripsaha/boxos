// modf writes the integral part through a pointer to the SAME type, which is
// why it cannot be one of the macros above: the value has to come back through
// a local of the computation type and be narrowed on the way out.
template <class T>
    requires __math::NarrowExt<T>
inline T modf(T x, T *ip)
{
    using V = typename __math::Via<T>::type;
    V whole{};
    const V frac = modf(static_cast<V>(x), &whole);
    *ip = static_cast<T>(whole);
    return static_cast<T>(frac);
}

