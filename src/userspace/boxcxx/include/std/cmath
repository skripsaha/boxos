// boxcxx — <cmath> : full classical surface + C++17 special math.
// Header-only (namespace std); sqrt via inline sqrtsd/ss (no errno path,
// works without -fno-math-errno). C++17 special fns in <__bits/cmath_special>.
#ifndef BOXCXX_CMATH
#define BOXCXX_CMATH
#include <cstdint>
#include <__bits/math_fenv_defs>
#include <__bits/cmath_coeffs>
#include <type_traits>   // conditional_t / is_same_v / is_arithmetic_v — [cmath.syn]/2's promoting overloads at the foot of this file
// Everything here is transplanted verbatim into src/runtime/cmath*.cpp.

namespace std {

using u32 = uint32_t;
using u64 = uint64_t;
using i32 = int32_t;
using i64 = int64_t;

// ── bit casts ────────────────────────────────────────────────────────────
inline u64    dbits(double x)  { return __builtin_bit_cast(u64, x); }
inline double dfrom(u64 b)     { return __builtin_bit_cast(double, b); }
inline u32    fbits(float x)   { return __builtin_bit_cast(u32, x); }
inline float  ffrom(u32 b)     { return __builtin_bit_cast(float, b); }

// ── constants (compile-time builtins, no libm) ─────────────────────────────
constexpr double kInf   = __builtin_huge_val();
constexpr double kQNaN  = __builtin_nan("");
constexpr float  kInfF  = __builtin_huge_valf();
constexpr float  kQNaNF = __builtin_nanf("");

// ── error reporting: PERFORMED, not asserted ─────────────────────────────
// math_errhandling here is MATH_ERREXCEPT — errors are reported by raising the
// IEEE-754 flags. Ф41-c measured what that was actually worth and the answer
// was: nothing, outside sqrt. Every function below returned kInf or kQNaN on
// its error paths, and returning a CONSTANT raises no flag, because only
// operations raise. <cfenv> is what made the gap visible; these four helpers
// are what closes it.
//
// Each one produces the value the standard asks for by doing the arithmetic
// that produces it, so the hardware raises the flag as a side effect of being
// right. That also means they keep working if a trap is ever unmasked — a
// written status bit would not.
//
// The `volatile` is belt and braces, and the measurement says so: GCC compiles
// with -ftrapping-math by default, so it will NOT fold an operation whose only
// observable effect is the flag it raises — a mutation dropping the volatile
// raised FE_OVERFLOW at -O0 and at -O2 alike (measured on the host, both
// compilers). What the volatile buys is a guarantee that survives someone
// adding -ffast-math or -fno-trapping-math to a build, which would otherwise
// silently turn every error path below back into a constant.
//
// Only ERROR branches call these. The computation kernels are untouched, which
// matters because several of them are the correctly-rounded chains of Ф27e.
inline double raise_domain()               // NaN + FE_INVALID
{
    volatile double zero = 0.0;
    return zero / zero;
}
inline double raise_pole(double sign)      // ±inf + FE_DIVBYZERO
{
    volatile double s = sign, zero = 0.0;
    return s / zero;
}
// M15 was a mutation that dropped the volatile from raise_overflow and was NOT
// observable — see the note above. Recorded because an unobservable mutation is
// evidence about the test AND about the compiler, and the second one is why
// this comment no longer claims what it used to.
inline double raise_overflow(double sign)  // ±inf + FE_OVERFLOW (and INEXACT)
{
    volatile double big = 0x1p1023;
    return sign * (big * big);
}
inline double raise_underflow(double sign) // ±0 + FE_UNDERFLOW (and INEXACT)
{
    volatile double tiny = 0x1p-1022;
    return sign * (tiny * tiny);
}

constexpr double kPi      = 3.14159265358979311599796346854;
constexpr double kPiOver2 = 1.57079632679489655799898173427;
constexpr double kPiOver4 = 0.785398163397448278999490867136;
constexpr double kTwoOverPi = 0.636619772367581382432888403856;
constexpr double kLn2     = 0.693147180559945309417232121458;
constexpr double kLn2Hi   = 6.93147180369123816490e-01; // high 32 mantissa bits
