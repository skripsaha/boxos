// dd sin(r)/cos(r) on |r|≤π/4 via Taylor (odd/even); 24 terms → below 2^−128.
inline LdDd sin_series_dd(LdDd r){
    LdDd s = r, x = r, r2 = dd_mul_ld(r, r);
    for (int k = 1; k < 24; ++k){
        x = dd_mul_ld(x, r2);
        x = dd_div_ld(x, LdDd{(long double)((2*k)*(2*k+1)), 0.0L});
        x = LdDd{-x.hi, -x.lo};
        s = dd_add_ld(s, x);
    }
    return s;
}
inline LdDd cos_series_dd(LdDd r){
    LdDd s{1.0L, 0.0L}, x{1.0L, 0.0L}, r2 = dd_mul_ld(r, r);
    for (int k = 1; k < 24; ++k){
        x = dd_mul_ld(x, r2);
        x = dd_div_ld(x, LdDd{(long double)((2*k-1)*(2*k)), 0.0L});
        x = LdDd{-x.hi, -x.lo};
        s = dd_add_ld(s, x);
    }
    return s;
}
// Add the 128-bit `prod` into the 256-bit accumulator S at bit offset `shift`
// (bits below 0 or ≥256 discarded). Carries ripple upward (exact, integer).
inline void sin_add_shifted_128(unsigned long long S[4], unsigned __int128 prod, int shift){
    if (shift <= -128 || shift >= 256) return;
    if (shift < 0){ prod >>= (unsigned)(-shift); shift = 0; }
    unsigned long long p0 = (unsigned long long)prod, p1 = (unsigned long long)(prod >> 64);
    int word = shift >> 6, off = shift & 63;
    unsigned long long w[3]; int cnt;
    if (off == 0){ w[0] = p0; w[1] = p1; cnt = 2; }
    else { w[0] = p0 << off; w[1] = (p1 << off) | (p0 >> (64 - off)); w[2] = p1 >> (64 - off); cnt = 3; }
    for (int t = 0; t < cnt; ++t){
        unsigned long long v = w[t]; int wi = word + t;
        while (v && wi < 4){
            unsigned __int128 sum = (unsigned __int128)S[wi] + v;
            S[wi] = (unsigned long long)sum;
            v = (unsigned long long)(sum >> 64);
            ++wi;
        }
    }
}
// Exact integer Payne-Hanek: ax finite, π/4≤|ax|. Returns quadrant q=N mod 4;
// sets r (dd) = ax − N·(π/2), |r|≤π/4. Multiplies the 64-bit mantissa by the
// windowed 2/π table into a 256-bit fixed-point accumulator (scaled 2^192):
// top 2 integer bits give N, the 128-bit fraction gives r (× π/2 in dd).
inline int sin_reduce_ph(long double ax, LdDd &r){
    unsigned __int128 b = ldbits(ax);
    int E = (int)((b >> 64) & 0x7FFFu);
    unsigned long long m = (unsigned long long)b;         // 64-bit mantissa, bit63 set
    int p = E - 16446;
    int jc = p / 64;                                       // C truncating division
    int jlo = jc - 3; if (jlo < 0) jlo = 0;
    int jhi = jc + 8; if (jhi > 265) jhi = 265;
    unsigned long long S[4] = {0, 0, 0, 0};               // 256-bit, S[0]=LSB
    for (int j = jlo; j <= jhi; ++j){
        unsigned __int128 prod = (unsigned __int128)m * KTWO_O_PI_BITS[j];
        sin_add_shifted_128(S, prod, p + 192 - 64 * (j + 1));
    }
    unsigned intpart = (unsigned)(S[3] & 3ull);
    unsigned __int128 hi128 = ((unsigned __int128)S[2] << 64) | S[1];   // top 128 frac bits
    __int128 sf = (__int128)hi128;                        // signed: f = sf·2^-128 ∈ [−½,½)
    int N = (int)intpart + (sf < 0 ? 1 : 0);
    long long shhi = (long long)(sf >> 64);
    unsigned long long shlo = (unsigned long long)sf;
    long double fh = scalbn((long double)shhi, -64);
    long double fl = scalbn((long double)shlo, -128);
    LdDd f = dd_add_ld(LdDd{fh, 0.0L}, LdDd{fl, 0.0L});
    r = dd_mul_ld(f, LdDd{KPIO2_HI_L, KPIO2_LO_L});       // r = f·(π/2)
    return N & 3;
}
// Cody-Waite: π/4≤ax<2^20. N=rint(ax·2/π); r=ax−N·(π/2) accumulated in dd via
// the 6-chunk π/2 (each N·chunk exact). Returns quadrant q=N mod 4.
inline int sin_reduce_cw(long double ax, LdDd &r){
    long double Nf = rint(ax * KTWO_O_PI_L);
    int N = (int)Nf;
    LdDd acc{ax, 0.0L};
    for (int i = 0; i < 6; ++i){
        long double prod = Nf * KCW_PIO2[i];              // exact (|N|<2^20, chunk 32-bit)
        acc = dd_add_ld(acc, LdDd{-prod, 0.0L});
    }
    r = acc;
    return N & 3;
}
inline long double sin(long double x){
    if (isnan(x)) return x;
    if (isinf(x)) return kQNaNL;
    if (x == 0.0L) return x;                              // sin(±0)=±0 (sign-preserving)
    bool neg = signbit(x);
    long double ax = fabs(x);
    if (ax <= 0x1p-32L) return x;                         // |x| tiny: sin(x)=x (CR), preserves sign/subnormal
    LdDd r; int q;
    if (ax <= KPIO4_L){ r = LdDd{ax, 0.0L}; q = 0; }
    else if (ax < 0x1p20L) q = sin_reduce_cw(ax, r);
    else                   q = sin_reduce_ph(ax, r);
    LdDd s;
    switch (q){
        case 0:  s = sin_series_dd(r); break;
        case 1:  s = cos_series_dd(r); break;
        case 2:  s = sin_series_dd(r); s = LdDd{-s.hi, -s.lo}; break;
        default: s = cos_series_dd(r); s = LdDd{-s.hi, -s.lo}; break;
    }
    long double v = s.hi + s.lo;                          // correctly round to 64-bit
    return neg ? -v : v;
}
