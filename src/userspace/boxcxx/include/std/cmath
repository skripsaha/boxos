    LdDd half_pi{ld_from_bits_l(kHalfPiHiM, kHalfPiHiS), ld_from_bits_l(kHalfPiLoM, kHalfPiLoS)};
    if (isinf(x)) return signbit(x) ? -(half_pi.hi + half_pi.lo) : (half_pi.hi + half_pi.lo);
    if (x == 0.0L) return x;
