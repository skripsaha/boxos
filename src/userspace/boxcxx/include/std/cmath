// ════════════════════════════════════════════════════════════════════════
//  cbrt : bit-hack seed + Halley step (fdlibm s_cbrt). ≤1 ULP.
// ════════════════════════════════════════════════════════════════════════
inline double cbrt(double x) {
    const u32 B1 = 715094163u, B2 = 696219795u;
    const double C = 5.42857142857142815906e-01, D = -7.05306122448979611050e-01,
                 E = 1.41428571428571436819e+00, F = 1.60714285714285720630e+00,
                 G = 3.57142857142857150787e-01;
    u64 b = dbits(x); u64 sign = b & 0x8000000000000000ULL;
    u32 hx = (u32)((b & 0x7fffffffffffffffULL) >> 32);
    if (hx >= 0x7ff00000) return x + x;               // inf / nan
    if ((b & 0x7fffffffffffffffULL) == 0) return x;   // ±0
    double ax = dfrom(b & 0x7fffffffffffffffULL);
    double t;
    if (hx < 0x00100000) {                            // subnormal
        t = dfrom((u64)0x43500000u << 32); t *= ax;
        u32 th = (u32)(dbits(t) >> 32);
        t = dfrom((u64)(th / 3 + B2) << 32);
    } else {
        t = dfrom((u64)(hx / 3 + B1) << 32);
    }
    double r = t * t / ax, s = C + r * t;
    t *= G + F / (s + E + D / s);
    t = dfrom(((dbits(t) >> 32) + 1) << 32);           // chop to 20 bits + round
    s = t * t; r = ax / s; double w = t + t; r = (r - t) / (w + r); t = t + t * r;
    return dfrom(dbits(t) | sign);
}
inline float cbrt(float x) { return float(cbrt(double(x))); }

// ════════════════════════════════════════════════════════════════════════
//  erf / erfc : Taylor series (|x|<0.84) + Lentz continued fraction.
// ════════════════════════════════════════════════════════════════════════
inline double erf_poly(double s) {
    double r = ERF_C[ERF_C_N - 1];
    for (int i = ERF_C_N - 2; i >= 0; --i) r = r * s + ERF_C[i];
    return r;                                          // erf(x)/x, s=x²
}
// erfc on [0.5,27] via scaled w(x)=x·e^{x²}·erfc(x) (smooth; two Chebyshev pieces,
// Clenshaw) × e^{-x²} (dd). No cancellation → ≤6 ULP. e^{-x²}<2^-... for x≥27 → 0.
inline double erfc_scaled(double x) {
    double t, w, t2, b0 = 0.0, b1 = 0.0;
    if (x < 6.0) {
        t = (2.0 * x - 6.5) / 5.5;                      // [0.5,6] → [-1,1]
        t2 = 2.0 * t;
        for (int k = ERFC_W1_N - 1; k >= 1; --k) { double b = t2 * b0 - b1 + ERFC_W1[k]; b1 = b0; b0 = b; }
        w = t * b0 - b1 + ERFC_W1[0];
    } else {
        t = (2.0 * x - 33.0) / 21.0;                    // [6,27] → [-1,1]
        t2 = 2.0 * t;
        for (int k = ERFC_W2_N - 1; k >= 1; --k) { double b = t2 * b0 - b1 + ERFC_W2[k]; b1 = b0; b0 = b; }
        w = t * b0 - b1 + ERFC_W2[0];
    }
    double x2h, x2l; two_prod(x, x, x2h, x2l);
    return exp_dd(-x2h, -x2l) * w / x;
}
inline double erf(double x) {
    if (isnan(x)) return x;
    if (isinf(x)) return copysign(1.0, x);
    double a = fabs(x), r;
    if (a < 0.5) r = a * erf_poly(a * a);
    else if (a < 27.0) r = 1.0 - erfc_scaled(a);
    else r = 1.0;
    return copysign(r, x);
}
inline double erfc(double x) {
    if (isnan(x)) return x;
    if (isinf(x)) return signbit(x) ? 2.0 : 0.0;
    if (x >= 0.0) {
        if (x < 0.5)  return 1.0 - x * erf_poly(x * x);
        if (x < 27.0) return erfc_scaled(x);
        return 0.0;                                    // underflow
    }
    double a = -x;
    if (a < 0.5)  return 1.0 + a * erf_poly(a * a);
    if (a < 27.0) return 2.0 - erfc_scaled(a);
    return 2.0;
}
inline float erf(float x)  { return float(erf(double(x))); }
inline float erfc(float x) { return float(erfc(double(x))); }

// ════════════════════════════════════════════════════════════════════════
//  tgamma / lgamma : Lanczos approximation (g=7, n=9; Godfrey coefficients).
// ════════════════════════════════════════════════════════════════════════
// sin(π·x) accurate near integers: reduce to r=x−round(x) ∈ [−0.5,0.5].
inline double sinpi(double x) {
    double k = rint(x), r = x - k;                     // r exact for |x|<2^52
    double s = sin(kPi * r);
    return (fmod(k, 2.0) != 0.0) ? -s : s;             // sign flip on odd k
}
// Stirling series Σ B₂ₖ/((2k)(2k−1)x^(2k−1)); accurate for x ≥ 8 (no cancellation).
inline double stirling_series(double x) {
    double iv = 1.0 / x, iv2 = iv * iv;
    return iv * (1.0/12 + iv2 * (-1.0/360 + iv2 * (1.0/1260 + iv2 * (-1.0/1680
              + iv2 * (1.0/1188 + iv2 * (-691.0/360360 + iv2 * (1.0/156
              + iv2 * (-3617.0/122400))))))));
}
// lnΓ(x) for x≥8 as double-double (hi,lo) via Stirling.
inline void stirling_lngamma_dd(double x, double &hi, double &lo) {
    const double kHalfLog2Pi = 0.918938533204672742;
    double Lhi, Llo; log_dd(x, Lhi, Llo);
    double ehi, elo; two_prod(x - 0.5, Lhi, ehi, elo); elo += (x - 0.5) * Llo;
    double s1, s2; two_sum(ehi, -x, s1, s2);
    double t1, t2; two_sum(s1, kHalfLog2Pi, t1, t2);
    hi = t1; lo = t2 + s2 + elo + stirling_series(x);
}
// Γ via Stirling (x≥7) + upward recurrence for 0.5≤x<7 (no Lanczos cancellation).
inline double tgamma(double x) {
    if (isnan(x)) return x;
    if (isinf(x)) return signbit(x) ? raise_domain() : kInf;
    if (x == 0.0) return raise_pole(copysign(1.0, x)); // F.10.5.4: ±inf, DIVBYZERO
    if (x < 0.0 && x == floor(x)) return raise_domain();  // negative integers
    if (x < 0.5) return kPi / (sinpi(x) * tgamma(1.0 - x));   // reflection
    double denom = 1.0, z = x;
    while (z < 7.0) { denom *= z; z += 1.0; }          // Γ(x)=Γ(z)/∏, z≥7
    double h, l; stirling_lngamma_dd(z, h, l);
    return exp_dd(h, l) / denom;
}
inline double lgamma(double x) {
    if (isnan(x)) return x;
    if (isinf(x)) return kInf;
    if (x == 0.0) return raise_pole(1.0);              // pole error
    if (x < 0.0 && x == floor(x)) return raise_pole(1.0);  // poles
    if (x < 0.5) return log(kPi / fabs(sinpi(x))) - lgamma(1.0 - x);
    double logd = 0.0, z = x;
    while (z < 7.0) { logd += log(z); z += 1.0; }      // lnΓ(x)=lnΓ(z)−Σln
    double h, l; stirling_lngamma_dd(z, h, l);
    return (h + l) - logd;
}
inline float tgamma(float x) { return float(tgamma(double(x))); }
inline float lgamma(float x) { return float(lgamma(double(x))); }

// ════════════════════════════════════════════════════════════════════════
//  FP manipulation, rounding-to-integer, fdim/fmax/fmin, software fma.
// ════════════════════════════════════════════════════════════════════════
inline double frexp(double x, int *e) {
    u64 b = dbits(x); int ex = (int)((b >> 52) & 0x7ff);
    if (ex == 0x7ff || x == 0.0) { *e = 0; return x; }
    int add = 0;
    if (ex == 0) { x *= 0x1p54; b = dbits(x); ex = (int)((b >> 52) & 0x7ff); add = -54; }
    *e = ex - 1022 + add;
    return dfrom((b & 0x800fffffffffffffULL) | ((u64)1022 << 52));
}
inline double modf(double x, double *ip) {
    if (isinf(x)) { *ip = x; return copysign(0.0, x); }
    double i = trunc(x); *ip = i;
    return isnan(x) ? x : copysign(x - i, x);
}
inline int ilogb(double x) {
    u64 b = dbits(x) & 0x7fffffffffffffffULL;
    if (b == 0) return (-2147483647 - 1);                          // FP_ILOGB0
    int e = (int)(b >> 52);
    if (e == 0x7ff) return (b == 0x7ff0000000000000ULL) ? 2147483647 : (-2147483647 - 1);
    if (e == 0) { int n = 0; u64 m = b; while (!(m & 0x0010000000000000ULL)) { m <<= 1; ++n; } return -1022 - n; }
    return e - 1023;
}
inline double logb(double x) {
    if (x == 0.0) return raise_pole(-1.0);            // F.10.3.11 pole error
    if (isinf(x)) return kInf;
    if (isnan(x)) return x;
    return (double)ilogb(x);
}
inline double scalbln(double x, long n) {
    if (n > 100000) n = 100000; else if (n < -100000) n = -100000;
    return scalbn(x, (int)n);
}
inline double nextafter(double x, double y) {
    if (isnan(x) || isnan(y)) return x + y;
    u64 ux = dbits(x), uy = dbits(y);
    if (ux == uy) return y;
    u64 ax = ux & 0x7fffffffffffffffULL, ay = uy & 0x7fffffffffffffffULL;
    if (ax == 0) { if (ay == 0) return y; ux = (uy & 0x8000000000000000ULL) | 1; }
    else if (ax > ay || ((ux ^ uy) & 0x8000000000000000ULL)) ux--;
    else ux++;
    return dfrom(ux);
}
inline double nexttoward(double x, double y) { return nextafter(x, y); }   // long double = double
inline double remquo(double x, double y, int *quo) {
    if (isnan(x) || isnan(y)) { *quo = 0; return kQNaN; }
    if (isinf(x) || y == 0.0) { *quo = 0; return raise_domain(); }
    if (isinf(y)) { *quo = 0; return x; }
    double r = remainder(x, y);
    double n = rint((x - r) / y);                                    // integer quotient (snap)
    int iq = (int)fmod(fabs(n), 8.0);                                // low 3 bits suffice
    *quo = (signbit(x) ^ signbit(y)) ? -iq : iq;
    return r;
}
inline long      lround(double x)  { return (long)round(x); }
inline long long llround(double x) { return (long long)round(x); }
inline long      lrint(double x)   { return (long)rint(x); }
inline long long llrint(double x)  { return (long long)rint(x); }
inline double fdim(double x, double y) {
    if (isnan(x) || isnan(y)) return kQNaN;
    return (x > y) ? x - y : 0.0;
}
inline double fmax(double x, double y) {
    if (isnan(x)) return y;
    if (isnan(y)) return x;
    if (x == y) return signbit(x) ? y : x;                           // fmax(+0,−0)=+0
    return x < y ? y : x;
}
inline double fmin(double x, double y) {
    if (isnan(x)) return y;
    if (isnan(y)) return x;
    if (x == y) return signbit(x) ? x : y;                           // fmin(+0,−0)=−0
    return x < y ? x : y;
}
// fma : exact a·b via Dekker two_prod, then double-double sum with c (≤1 ULP, no -mfma).
inline double fma(double a, double b, double c) {
    if (!isfinite(a) || !isfinite(b) || !isfinite(c) || a == 0.0 || b == 0.0)
        return a * b + c;                                            // inf/nan/zero edge cases
    double p, e; two_prod(a, b, p, e);                              // a·b = p+e exact
    double s, t; two_sum(p, c, s, t);                              // p+c = s+t exact
    return s + (t + e);
}
