    if (isinf(x)) return copysign(1.0L, x);               // tanh(±inf)=±1
    long double a = fabs(x);
    if (a < 0x1p-32L) return x;                           // tanh(x)=x (odd; keeps ±0 sign)
    if (a >= 24.0L) return copysign(1.0L, x);             // 1−tanh < ½ulp(1) → ±1
    int n;
    LdDd M = exp_reduce_dd(2.0L * a, n);                  // e^{2a} = 2^n·M
    LdDd E{scalbn(M.hi, n), scalbn(M.lo, n)};             // e^{2a} (dd; 2a<48 ⇒ no overflow)
    LdDd w = dd_add_ld(E, LdDd{-1.0L, 0.0L});             // expm1(2a) = e^{2a}−1
    LdDd r = dd_div_ld(w, dd_add_ld(w, LdDd{2.0L, 0.0L}));// tanh = w/(w+2)
    return copysign(r.hi + r.lo, x);
}
// ── correctly-rounded inverse hyperbolic (software double-double, 80-bit) ────
// asinh(x)=ln(x+√(x²+1)), acosh(x)=ln(x+√(x²−1)), atanh(x)=½ln((1+x)/(1−x)), each
// evaluated in dd on the CR log core (log_dd_core_dd) then rounded once. For
// |x| ≤ 2⁸¹⁹⁰ the argument keeps a genuine √(x²±1); past that x² would overflow,
// so asinh/acosh fall back to the CR asymptote ln(2|x|)=ln2+ln|x| (the dropped
// 1/(4x²) is far below ½ ULP). NO x87 transcendentals ⇒ genuine 80-bit.
inline long double asinh(long double x){
    if (!isfinite(x)) return x;                          // ±Inf→±Inf, NaN→NaN
    long double a = fabs(x);
    if (a < 0x1p-32L) return x;                          // asinh(x)=x (odd; keeps ±0)
    LdDd r;
    if (a > 0x1p8190L)                                   // huge: ln(2a)=ln2+ln(a)
        r = dd_add_ld(LdDd{KLN2DD_HI_L, KLN2DD_LO_L}, log_dd_core_l(a));
    else {
        LdDd a2 = dd_mul_ld(LdDd{a, 0.0L}, LdDd{a, 0.0L});
        r = log_dd_core_dd(dd_add_ld(LdDd{a, 0.0L}, sqrt_dd(dd_add_ld(a2, LdDd{1.0L, 0.0L}))));
    }
    return copysign(r.hi + r.lo, x);
}
inline long double acosh(long double x){
    if (isnan(x)) return x;
    if (x < 1.0L)  return raise_domain_l();              // domain (covers x<−1)
    if (x == 1.0L) return 0.0L;                          // acosh(1)=+0
    if (isinf(x))  return kInfL;                         // acosh(+Inf)=+Inf
    LdDd r;
    if (x > 0x1p8190L)                                   // huge: ln(2x)=ln2+ln(x)
        r = dd_add_ld(LdDd{KLN2DD_HI_L, KLN2DD_LO_L}, log_dd_core_l(x));
    else {
        LdDd x2 = dd_mul_ld(LdDd{x, 0.0L}, LdDd{x, 0.0L});
        r = log_dd_core_dd(dd_add_ld(LdDd{x, 0.0L}, sqrt_dd(dd_add_ld(x2, LdDd{-1.0L, 0.0L}))));
    }
    return r.hi + r.lo;
}
inline long double atanh(long double x){
    if (isnan(x)) return x;
    long double a = fabs(x);
    if (a > 1.0L)  return raise_domain_l();              // domain
    if (a == 1.0L) return raise_pole_l(copysign(1.0L, x));   // ±1 is the pole
    if (a < 0x1p-32L) return x;                          // atanh(x)=x (odd; keeps ±0)
    LdDd num; two_sum_l(1.0L,  a, num.hi, num.lo);       // 1+a (exact dd)
    LdDd den; two_sum_l(1.0L, -a, den.hi, den.lo);       // 1−a (exact dd)
    LdDd r = log_dd_core_dd(dd_div_ld(num, den));        // ln((1+a)/(1−a))
    return copysign(0.5L * (r.hi + r.lo), x);            // ½·ln (0.5 exact ⇒ CR preserved)
}
inline long double hypot(long double x, long double y){
    if (isinf(x) || isinf(y)) return kInfL;              // +Inf even if the other is NaN
    if (isnan(x) || isnan(y)) return kQNaNL;
    long double ax = fabs(x), ay = fabs(y), m = fmax(ax, ay);
    if (m == 0.0L) return 0.0L;
    long double rx = ax / m, ry = ay / m;
    return m * sqrt(rx * rx + ry * ry);                  // genuine 80-bit (fsqrt + arithmetic)
}
// Three-argument form ([c.math.hypot3]); power-of-two scaling like the double
// path, so the reduction is exact and only the squares and the fsqrt round.
inline long double hypot(long double x, long double y, long double z){
    if (isinf(x) || isinf(y) || isinf(z)) return kInfL;  // +Inf even if another is NaN
    if (isnan(x) || isnan(y) || isnan(z)) return kQNaNL;
    long double ax = fabs(x), ay = fabs(y), az = fabs(z);
    long double m = fmax(fmax(ax, ay), az);
    if (m == 0.0L) return 0.0L;
    const int e = ilogb(m);
    ax = scalbn(ax, -e); ay = scalbn(ay, -e); az = scalbn(az, -e);
    return scalbn(sqrt(ax * ax + ay * ay + az * az), e); // genuine 80-bit
}
// ── correctly-rounded cbrt (software double-double, 80-bit) ──────────────────
// Reduce a=|x|=m·2^(3k+j) (j∈{0,1,2}, m·2^j ∈ [1,8)); cbrt(a)=2^k·cbrt(m·2^j),
// the bracket ∈ [1,2) so one dd Halley step reaches ~127 bits with no y⁴
// overflow, then RN64·2^k (exact) = RN(cbrt). Perfect cubes stay exact.
inline long double cbrt(long double x){
    if (x == 0.0L || isinf(x) || isnan(x)) return x;     // ±0, ±Inf, NaN
    long double s = copysign(1.0L, x), a = fabs(x);
    int e = ilogb(a), k = e / 3, j = e - 3 * k;
    if (j < 0){ j += 3; --k; }                           // force j∈{0,1,2}
    (void)j;
    long double mm = scalbn(a, -3 * k);                  // mm ∈ [1,8), cbrt(mm)∈[1,2)
    long double y = exp2(log2(mm) * (1.0L / 3.0L));      // ~64-bit seed (CR exp2/log2)
    LdDd Y{y, 0.0L};
    LdDd y3 = dd_mul_ld(dd_mul_ld(Y, Y), Y);             // y³
    LdDd M{mm, 0.0L};
    LdDd num = dd_mul_ld(Y, dd_add_ld(y3, dd_add_ld(M, M)));   // y·(y³+2·mm)
    LdDd den = dd_add_ld(dd_add_ld(y3, y3), M);               // 2y³+mm
    LdDd r = dd_div_ld(num, den);                        // Halley → ~127 bits
    return s * scalbn(r.hi + r.lo, k);                   // ·2^k exact, with sign
}
inline bool ld_is_integer(long double x){ return isfinite(x) && trunc(x) == x; }
inline bool ld_is_odd_integer(long double x){
    return ld_is_integer(x) && fmod(fabs(x), 2.0L) == 1.0L;
}
// b^n for integer n via dd binary exponentiation (each product ~127 bits) —
// far more accurate than 2^(n·log2 b) for exact integer powers (the transcendental
// path loses ~1 ULP on x², x³, …). ok=false on over/underflow (a subnormal or
// non-finite result), so the caller falls back to the dd exp2 path which rounds
// those regimes correctly. b > 0 finite.
inline long double pow_int_dd(long double b, long n, bool &ok){
    unsigned long m = n < 0 ? (unsigned long)(-(long long)n) : (unsigned long)n;   // |n|
    LdDd r{1.0L, 0.0L}, base{b, 0.0L};
    while (m){
        if (m & 1) r = dd_mul_ld(r, base);
        m >>= 1;
        if (m) base = dd_mul_ld(base, base);
    }
    if (n < 0) r = dd_div_ld(LdDd{1.0L, 0.0L}, r);        // b^n = 1/b^|n| (dd)
    long double v = r.hi + r.lo;
    ok = isfinite(v) && v != 0.0L && (int)ld_exp(v) > 1;  // finite normal ⇒ single-rounded CR
    return v;
}
inline long double pow(long double x, long double y){
    if (y == 0.0L) return 1.0L;                          // 1: pow(x,±0)=1 incl x=NaN
    if (x == 1.0L) return 1.0L;                          // 2: pow(1,y)=1 incl y=NaN/Inf
    if (isnan(x) || isnan(y)) return kQNaNL;             // 3
    if (isinf(y)){                                       // 4
        long double ax = fabs(x);
        if (ax == 1.0L) return 1.0L;
        if (signbit(y)) return (ax < 1.0L) ? kInfL : 0.0L;
        return (ax > 1.0L) ? kInfL : 0.0L;
    }
    if (isinf(x)){                                       // 5
        if (!signbit(x)) return (y > 0.0L) ? kInfL : 0.0L;
        bool odd = ld_is_odd_integer(y);
        if (y > 0.0L) return odd ? -kInfL : kInfL;
        return odd ? -0.0L : 0.0L;
    }
    if (x == 0.0L){                                      // 6
        bool odd = ld_is_odd_integer(y), negz = signbit(x);
        if (y > 0.0L) return (odd && negz) ? -0.0L : 0.0L;
        return (odd && negz) ? -kInfL : kInfL;
    }
    if (signbit(x)){                                     // 7: x < 0, finite, nonzero
        if (!ld_is_integer(y)) return raise_domain_l();
        long double r; bool ok = false;
        if (fabs(y) < 0x1p63L) r = pow_int_dd(-x, (long)y, ok);   // |x|^n via dd
        if (!ok){                                         // over/underflow → dd exp2
            LdDd L = dd_mul_ld(log_dd_core_l(-x), LdDd{KLOG2E_DD_HI_L, KLOG2E_DD_LO_L});
            LdDd P = dd_mul_ld(LdDd{y, 0.0L}, L);
            r = exp2_dd_core(P.hi, P.lo);
        }
        return ld_is_odd_integer(y) ? -r : r;
    }
    // 8: x > 0 finite. Integer y → dd binary exponentiation (exact powers stay
    // exact); otherwise 2^(y·log2 x) fully in dd, correctly rounded. Both handle
    // over/underflow of the exponent → +Inf/+0.
    if (ld_is_integer(y) && fabs(y) < 0x1p63L){
        long double r; bool ok; r = pow_int_dd(x, (long)y, ok);
        if (ok) return r;
    }
    LdDd L = dd_mul_ld(log_dd_core_l(x), LdDd{KLOG2E_DD_HI_L, KLOG2E_DD_LO_L});       // log2(x) dd
    LdDd P = dd_mul_ld(LdDd{y, 0.0L}, L);                // y·log2(x) dd
    return exp2_dd_core(P.hi, P.lo);
}
// fma : exact fused a·b+c via Veltkamp/Dekker at 64-bit-mantissa width (no -mfma).
inline long double fma(long double a, long double b, long double c){
    if (!isfinite(a) || !isfinite(b) || !isfinite(c) || a == 0.0L || b == 0.0L)
        return a * b + c;                               // inf/nan/zero: no split needed
    const long double SPLIT = 4294967297.0L;            // 2^32 + 1 (splits a 64-bit mantissa)
    long double ca = SPLIT * a, ah = ca - (ca - a), al = a - ah;
    long double cb = SPLIT * b, bh = cb - (cb - b), bl = b - bh;
    long double p = a * b;
    long double e = ((ah * bh - p) + ah * bl + al * bh) + al * bl;   // a·b = p + e exact
    long double s = p + c, t;
    if (fabs(p) >= fabs(c)) t = (p - s) + c;            // p + c = s + t exact (fast2sum)
    else                    t = (c - s) + p;
    return s + (t + e);
}

