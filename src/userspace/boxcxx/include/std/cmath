// frndint under an explicit rounding control; control word saved/restored.
inline long double x87_round_mode(long double x, uint16_t rc){
    uint16_t cw = x87_getcw();
    uint16_t nw = (uint16_t)((cw & ~0x0C00u) | ((unsigned)rc << 10));
    long double r;
    __asm__ volatile("fldcw %[nw]\n\t"
                     "frndint\n\t"
                     "fldcw %[cw]"
                     : "=t"(r) : "0"(x), [nw]"m"(nw), [cw]"m"(cw));
    return r;
