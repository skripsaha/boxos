// x87 control word: bits[11:10] = rounding control (00 nearest, 01 down, 10 up, 11 trunc).
inline uint16_t x87_getcw(){ uint16_t cw; __asm__ volatile("fnstcw %0" : "=m"(cw)); return cw; }
