inline LdDd dd_add_ld(LdDd a, LdDd b){               // renormalized dd + dd
    long double s, e; two_sum_l(a.hi, b.hi, s, e);
    e = e + (a.lo + b.lo);
    LdDd r; two_sum_l(s, e, r.hi, r.lo); return r;
}
inline LdDd dd_mul_ld(LdDd a, LdDd b){               // renormalized dd · dd
    long double p, e; two_prod_l(a.hi, b.hi, p, e);
    e = e + (a.hi * b.lo + a.lo * b.hi);
    LdDd r; two_sum_l(p, e, r.hi, r.lo); return r;
