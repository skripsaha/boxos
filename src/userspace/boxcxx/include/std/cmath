// lerp's own promotion, constexpr like the concrete overloads it forwards to.
template <class T, class U, class V>
    requires __math::Needs3<T, U, V>
constexpr auto lerp(T a, U b, V t)
{
    using P = __math::P3<T, U, V>;
    return lerp(static_cast<P>(a), static_cast<P>(b), static_cast<P>(t));
}

