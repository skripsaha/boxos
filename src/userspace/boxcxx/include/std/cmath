inline _Float128 remquo(_Float128 x, _Float128 y, int *q)
{
    // [c.math]: q receives at least the low three bits of the integral
    // quotient, with the sign of x/y.
    const _Float128 r = __quad::Remainder(x, y);
    const _Float128 n = __quad::Rint((x - r) / y);
    const long long k = (long long)__quad::Fabs(n);
    *q = (int)(k & 7);
    if (__quad::SignBit(x) != __quad::SignBit(y)) *q = -*q;
    return r;
}

// The transcendentals at float128_t are DELETED rather than absent. Both
// spellings make the call fail; a deleted overload makes it fail at the call
// site, with a diagnostic that names the function the program asked for,
// instead of somewhere inside a promotion template three levels down. It also
// states the deviation in the code rather than only in a document: these
// functions need polynomial kernels carrying 113 bits, which is a phase of its
// own, and computing them in 64 bits and returning a 113-bit type would be a
// lie that compiles.
