inline LdDd dd_div_ld(LdDd a, LdDd b){               // renormalized dd / dd (3-term)
    long double q1 = a.hi / b.hi;
    LdDd p1 = dd_mul_ld(b, LdDd{q1, 0.0L});
    LdDd r  = dd_add_ld(a, LdDd{-p1.hi, -p1.lo});
    long double q2 = r.hi / b.hi;
    LdDd p2 = dd_mul_ld(b, LdDd{q2, 0.0L});
    LdDd r2 = dd_add_ld(r, LdDd{-p2.hi, -p2.lo});
    long double q3 = r2.hi / b.hi;
    long double s, e; two_sum_l(q1, q2, s, e);
    LdDd out; two_sum_l(s, e + q3, out.hi, out.lo); return out;
}
// e^t for |t.hi| ≤ ln2/2 ≈ 0.347 via dd Taylor Σ tᵏ/k! — reaches ~2^-128.
// √x for a positive dd argument x, returned as dd (~127 bits): one Heron step
// r ← r₀ + (x − r₀²)/(2r₀) from the fsqrt seed r₀ doubles its ~64-bit accuracy.
inline LdDd sqrt_dd(LdDd x){
    if (x.hi <= 0.0L) return LdDd{0.0L, 0.0L};
    long double r0 = sqrt(x.hi);                          // correctly-rounded 64-bit seed
    LdDd r0sq = dd_mul_ld(LdDd{r0, 0.0L}, LdDd{r0, 0.0L});
    LdDd corr = dd_div_ld(dd_add_ld(x, LdDd{-r0sq.hi, -r0sq.lo}), LdDd{r0 + r0, 0.0L});
    return dd_add_ld(LdDd{r0, 0.0L}, corr);
}
inline LdDd exp_series_dd(LdDd t){
    LdDd sum{1.0L, 0.0L}, term{1.0L, 0.0L};
    for (int k = 1; k <= 30; ++k){
        term = dd_mul_ld(term, t);
        term = dd_div_ld(term, LdDd{(long double)k, 0.0L});
        sum  = dd_add_ld(sum, term);
    }
    return sum;
}
// Round the dd 2^f, scaled by 2ⁿ, to a subnormal / smallest-normal result
// (result exponent ≤ −16382, ULP = δ = 2^−16445) in ONE rounding — the RN64
// significand then scalbn would double-round (only 1 dropped bit at the
// −16383 exponent, below the 2-bit floor the odd-rounding theorem needs).
inline long double round_dd_to_subnormal_l(long double eh, long double el, int n){
    int m = n + 16445;
    long double P = scalbn(eh, m), Q = scalbn(el, m);    // exact: P+Q = 2^f · 2^(n+16445)
    long double s, e; two_sum_l(P, Q, s, e);             // P+Q = s + e (e exact)
    long double si = rint(s);                            // nearest integer to s
    long double r = s - si;                              // in [−0.5, 0.5], exact
    long double frac = r + e;                            // fraction deciding the round
    long double K = si;
    if      (frac >  0.5L) K = si + 1.0L;
    else if (frac < -0.5L) K = si - 1.0L;
    else if (frac ==  0.5L){ long double h = si * 0.5L; if (h != rint(h)) K = si + 1.0L; }  // tie→even
    else if (frac == -0.5L){ long double h = si * 0.5L; if (h != rint(h)) K = si - 1.0L; }
    return scalbn(K, -16445);
}
// 2^(Xhi+Xlo) for a double-double exponent argument (Xlo=0 for the plain 2^x,
// nonzero for e^x = 2^(x·log2 e)). Correctly rounded to 80-bit.
inline long double exp2_dd_core(long double Xhi, long double Xlo){
    if (Xhi >=  16384.0L) return raise_overflow_l(1.0L); // range error
    if (Xhi <= -16446.0L) return 0.0L;                   // below smallest subnormal → +0
    long double n = rint(Xhi);
    long double fh, fl; two_sum_l(Xhi - n, Xlo, fh, fl); // f = (Xhi−n)+Xlo, |f| ≤ 0.5 (dd)
    LdDd t = dd_mul_ld(LdDd{fh, fl}, LdDd{KLN2DD_HI_L, KLN2DD_LO_L});   // t = f·ln2
    LdDd e = exp_series_dd(t);                           // 2^f as dd (~127 bits)
    int ni = (int)n;
    if (ni <= -16382) return round_dd_to_subnormal_l(e.hi, e.lo, ni);  // subnormal path
    return scalbn(e.hi + e.lo, ni);                      // normal: RN64(2^f) · 2ⁿ (exact scalbn)
}

inline long double exp2(long double x){
    if (isnan(x)) return x;
    if (isinf(x)) return signbit(x) ? 0.0L : kInfL;
    return exp2_dd_core(x, 0.0L);
}
inline long double exp(long double x){
    if (isnan(x)) return x;
    if (isinf(x)) return signbit(x) ? 0.0L : kInfL;
    if (x >  12000.0L) return raise_overflow_l(1.0L);    // range error
    if (x < -12000.0L) return 0.0L;                      // e^x underflows to +0 below here
    LdDd X = dd_mul_ld(LdDd{x, 0.0L}, LdDd{KLOG2E_DD_HI_L, KLOG2E_DD_LO_L});  // x·log2 e (dd)
    return exp2_dd_core(X.hi, X.lo);                     // e^x = 2^(x·log2 e)
