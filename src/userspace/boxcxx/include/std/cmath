// fpclassify categories (match <cmath> values we will define in the header)
enum { FP_NAN_ = 0, FP_INFINITE_ = 1, FP_ZERO_ = 2, FP_SUBNORMAL_ = 3, FP_NORMAL_ = 4 };

// ── classification (double) ────────────────────────────────────────────────
inline bool isnan(double x)  { return (dbits(x) & 0x7fffffffffffffffULL) >  0x7ff0000000000000ULL; }
inline bool isinf(double x)  { return (dbits(x) & 0x7fffffffffffffffULL) == 0x7ff0000000000000ULL; }
inline bool isfinite(double x){return (dbits(x) & 0x7ff0000000000000ULL) != 0x7ff0000000000000ULL; }
inline bool signbit(double x){ return (dbits(x) >> 63) != 0; }
inline bool isnormal(double x){ u64 e = (dbits(x) >> 52) & 0x7ff; return e != 0 && e != 0x7ff; }
inline int  fpclassify(double x) {
    u64 b = dbits(x), e = (b >> 52) & 0x7ff, m = b & 0xfffffffffffffULL;
    if (e == 0)     return m ? FP_SUBNORMAL_ : FP_ZERO_;
    if (e == 0x7ff) return m ? FP_NAN_ : FP_INFINITE_;
    return FP_NORMAL_;
}
// classification (float)
inline bool isnan(float x)  { return (fbits(x) & 0x7fffffffU) >  0x7f800000U; }
inline bool isinf(float x)  { return (fbits(x) & 0x7fffffffU) == 0x7f800000U; }
inline bool isfinite(float x){return (fbits(x) & 0x7f800000U) != 0x7f800000U; }
inline bool signbit(float x){ return (fbits(x) >> 31) != 0; }
inline bool isnormal(float x){ u32 e = (fbits(x) >> 23) & 0xff; return e != 0 && e != 0xff; }
inline int  fpclassify(float x) {
    u32 b = fbits(x), e = (b >> 23) & 0xff, m = b & 0x7fffffU;
    if (e == 0)    return m ? FP_SUBNORMAL_ : FP_ZERO_;
    if (e == 0xff) return m ? FP_NAN_ : FP_INFINITE_;
    return FP_NORMAL_;
}

// ── fabs / copysign (intrinsics → andpd / and-or; no libm) ─────────────────
inline double fabs(double x)            { return __builtin_fabs(x); }
inline float  fabs(float x)             { return __builtin_fabsf(x); }
inline double copysign(double x,double y){ return __builtin_copysign(x, y); }
inline float  copysign(float x,float y) { return __builtin_copysignf(x, y); }

// ── sqrt (hardware sqrtsd/sqrtss; requires -fno-math-errno to inline) ──────
inline double sqrt(double x) { double r; __asm__("sqrtsd %1,%0":"=x"(r):"x"(x)); return r; }
inline float  sqrt(float x)  { float r; __asm__("sqrtss %1,%0":"=x"(r):"x"(x)); return r; }

// ── trunc / floor / ceil / round (SSE2 bit-twiddling, no SSE4.1 roundsd) ───
inline double trunc(double x) {
    u64 b = dbits(x);
    int e = int((b >> 52) & 0x7ff) - 1023;        // unbiased exponent
    if (e < 0)  return dfrom(b & 0x8000000000000000ULL);          // |x|<1 → ±0
    if (e >= 52) return x;                                         // integral / inf / nan
    u64 mask = (1ULL << (52 - e)) - 1;
    return dfrom(b & ~mask);
}
inline double floor(double x) {
    double t = trunc(x);
    return (t > x) ? t - 1.0 : t;                  // NaN: comparisons false → t
}
inline double ceil(double x) {
    double t = trunc(x);
    return (t < x) ? t + 1.0 : t;
}
inline double round(double x) {                    // round-half-away-from-zero
    double t = trunc(x);
    double d = x - t;                               // fractional part, |d|<1 (NaN→NaN)
    if (d >= 0.5)  return t + 1.0;
    if (d <= -0.5) return t - 1.0;
    return t;                                        // inf: d=NaN → both false → t=inf
}
// float variants via exact double round-trip (double holds all float integers)
inline float trunc(float x) { return float(trunc(double(x))); }
inline float floor(float x) { return float(floor(double(x))); }
inline float ceil(float x)  { return float(ceil(double(x))); }
inline float round(float x) { return float(round(double(x))); }

// ── nearbyint / rint : round to current mode (default RN-even) ─────────────
// (x ± 2^52) ∓ 2^52 rounds per the active MXCSR mode and is exact for |x|<2^52.
inline double rint(double x) {
    u64 b = dbits(x);
    if ((b & 0x7ff0000000000000ULL) >= (0x433ULL << 52)) return x; // |x|>=2^52 / nan / inf
    static const double kTwo52 = 4503599627370496.0;
    double a = fabs(x);
    double r = (a + kTwo52) - kTwo52;
    return copysign(r, x);
}
inline double nearbyint(double x) { return rint(x); }  // value identical; target suppresses inexact
inline float  rint(float x)       { return float(rint(double(x))); }
inline float  nearbyint(float x)  { return float(rint(double(x))); }

// ── fmod : exact, shift-and-subtract (each step exact by Sterbenz) ─────────
inline double fmod(double x, double y) {
    if (isnan(x) || isnan(y)) return kQNaN;              // propagation, not error
    if (isinf(x) || y == 0.0) return raise_domain();     // F.10.7.1 domain error
    if (isinf(y)) return x;
    double r = fabs(x), dy = fabs(y);
    if (r < dy) return x;
    double d = dy;
    while (d + d <= r) d += d;                      // largest dy*2^k ≤ r
    for (;;) {
        if (r >= d) r -= d;                         // exact: d/2 < r ≤ ... → Sterbenz
        if (d == dy) break;
        d *= 0.5;                                   // exact
    }
    return copysign(r, x);
}
inline float fmod(float x, float y) { return float(fmod(double(x), double(y))); }

// ── remainder : round-to-nearest-even quotient ─────────────────────────────
inline double remainder(double x, double y) {
    if (isnan(x) || isnan(y)) return kQNaN;
    if (isinf(x) || y == 0.0) return raise_domain();     // F.10.7.2 domain error
    if (isinf(y)) return x;
    double ax = fabs(x), ay = fabs(y);
    double r = fmod(ax, ay);                        // r in [0, ay)
    double q2 = r + r;
    if (q2 > ay) r -= ay;
    else if (q2 == ay) {
        double k = (ax - r) / ay;                   // exact integer quotient
        if (fmod(k, 2.0) != 0.0) r -= ay;           // tie → even quotient
    }
    return signbit(x) ? -r : r;
}
inline float remainder(float x, float y) { return float(remainder(double(x), double(y))); }

// ── two-product / two-sum (Dekker, FMA-free) — used by hypot/fma ───────────
inline void two_sum(double a, double b, double &s, double &e) {
    s = a + b;
    double bb = s - a;
    e = (a - (s - bb)) + (b - bb);
}
inline void split(double a, double &hi, double &lo) {
    const double c = 134217729.0 * a;              // 2^27+1
    hi = c - (c - a);
    lo = a - hi;
}
inline void two_prod(double a, double b, double &p, double &e) {
    p = a * b;
    double ah, al, bh, bl;
    split(a, ah, al);
    split(b, bh, bl);
    e = ((ah * bh - p) + ah * bl + al * bh) + al * bl;
}

// ── hypot : scaled + compensated dot product + corrected sqrt (≤1 ULP) ─────
inline double hypot(double x, double y) {
    if (isinf(x) || isinf(y)) return kInf;          // even if the other is NaN
    if (isnan(x) || isnan(y)) return kQNaN;
    double ax = fabs(x), ay = fabs(y);
    if (ax < ay) { double t = ax; ax = ay; ay = t; }
    if (ay == 0.0) return ax;
    // scale by power of two to keep ax in a safe range (exact)
    int ex = int((dbits(ax) >> 52) & 0x7ff);
    int scale = 0;
    if (ex >= 0x5ff) scale = -600;                  // big → scale down
    else if (ex <= 0x1ff) scale = 600;              // small/subnormal → scale up
    double s = (scale != 0) ? dfrom(u64(1023 + scale) << 52) : 1.0;
    double si = (scale != 0) ? dfrom(u64(1023 - scale) << 52) : 1.0;
    ax *= s; ay *= s;
    // compensated ax^2 + ay^2
    double p1, e1, p2, e2;
    two_prod(ax, ax, p1, e1);
    two_prod(ay, ay, p2, e2);
    double sum, c;
    two_sum(p1, p2, sum, c);
    double err = c + e1 + e2;
    double h = sqrt(sum);
    // one Newton correction: h += (sum - h^2 + err)/(2h)
    double hh, he;
    two_prod(h, h, hh, he);
    double res = h + (err + (sum - hh) - he) / (h + h);
    return res * si;
}
inline float hypot(float x, float y) {
    if (isinf(x) || isinf(y)) return kInfF;
    if (isnan(x) || isnan(y)) return kQNaNF;
    // double has >2*24 bits → x^2+y^2 exact, sqrt correctly rounded → ≤0.5 ULP
    double dx = x, dy = y;
    return float(sqrt(dx * dx + dy * dy));
}

// ── scalbn / ldexp : x * 2^n (musl staged-multiplier scheme, no libm) ──────
inline double scalbn(double x, int n) {
    if (n > 1023) { x *= 0x1p1023; n -= 1023;
        if (n > 1023) { x *= 0x1p1023; n -= 1023; if (n > 1023) n = 1023; } }
    else if (n < -1022) { x *= 0x1p-1022 * 0x1p53; n += 1022 - 53;
        if (n < -1022) { x *= 0x1p-1022 * 0x1p53; n += 1022 - 53; if (n < -1022) n = -1022; } }
    return x * dfrom((u64)(0x3ff + n) << 52);
}
inline double ldexp(double x, int n) { return scalbn(x, n); }
inline float  scalbn(float x, int n) { return float(scalbn(double(x), n)); }
inline float  ldexp(float x, int n)  { return float(scalbn(double(x), n)); }

// ── e^r − 1 = Σ_{n≥1} rⁿ/n!  (reciprocal factorials; accurate for |r|<~0.7) ─
inline double expm1_series(double r) {
    return r * (1.0 + r * (0.5 + r * (1.0/6 + r * (1.0/24 + r * (1.0/120
         + r * (1.0/720 + r * (1.0/5040 + r * (1.0/40320 + r * (1.0/362880
         + r * (1.0/3628800 + r * (1.0/39916800 + r * (1.0/479001600
         + r * (1.0/6227020800.0 + r * (1.0/87178291200.0 + r * (1.0/1307674368000.0
         + r * (1.0/20922789888000.0))))))))))))))));
}

// ── exp : x = k·ln2 + r, e^x = 2^k·(1 + (e^r−1)); corr separated ───────────
inline double exp(double x) {
    if (isnan(x)) return x;
    if (x > 709.782712893384) return raise_overflow(1.0);   // range error
    if (x < -745.1332191019412) return raise_underflow(1.0); // range error
    int k = (int)rint(x * kLog2e);
    double r = (x - k * kLn2Hi) - k * kLn2Lo;        // |r| ≤ ln2/2
    return scalbn(1.0 + expm1_series(r), k);
}
inline float exp(float x) { return float(exp(double(x))); }

// ── expm1 : e^x − 1 (direct series near 0 avoids 1+x cancellation) ─────────
inline double expm1(double x) {
    if (isnan(x)) return x;
    if (x > 709.782712893384) return raise_overflow(1.0);   // range error
    if (x < -37.0) return -1.0;                      // e^x ≈ 0, exact enough
    if (fabs(x) < 0.6) return expm1_series(x);       // direct, no cancellation
    return exp(x) - 1.0;
}
inline float expm1(float x) { return float(expm1(double(x))); }

// ── exp2 : 2^x = 2^k · e^(r·ln2), r ∈ [−0.5,0.5] ───────────────────────────
inline double exp2(double x) {
    if (isnan(x)) return x;
    if (x >= 1024.0) return raise_overflow(1.0);
    if (x <= -1075.0) return raise_underflow(1.0);
    int k = (int)rint(x);
    double r = (x - k) * kLn2;                        // |r·ln2| ≤ ln2/2
    return scalbn(1.0 + expm1_series(r), k);
}
inline float exp2(float x) { return float(exp2(double(x))); }

// ── log : x = 2^k·m, m∈[√½,√2]; log(m)=2f + 2f·s·T(s), f=(m−1)/(m+1), s=f² ─
// T(s) = 1/3 + s/5 + s²/7 + …  — pure odd reciprocals.
inline double atanh_tail(double s) {            // (atanh(f)/f − 1)/s, |s|≤0.03
    return 1.0/3 + s * (1.0/5 + s * (1.0/7 + s * (1.0/9 + s * (1.0/11
         + s * (1.0/13 + s * (1.0/15 + s * (1.0/17 + s * (1.0/19
         + s * (1.0/21 + s * (1.0/23))))))))));
}
inline double log(double x) {
    if (isnan(x)) return x;
    if (x < 0.0) return raise_domain();       // outside the domain
    if (x == 0.0) return raise_pole(-1.0);    // the pole: -inf, FE_DIVBYZERO
    if (isinf(x)) return kInf;
    u64 b = dbits(x);
    int e = (int)((b >> 52) & 0x7ff);
    int k = 0;
    if (e == 0) { x *= 0x1p54; b = dbits(x); e = (int)((b >> 52) & 0x7ff); k -= 54; }
    k += e - 1023;
    double m = dfrom((b & 0x800fffffffffffffULL) | ((u64)1023 << 52));   // m∈[1,2)
    if (m > 1.4142135623730951) { m *= 0.5; k++; }
    double f = (m - 1.0) / (m + 1.0);
    double s = f * f;
    double logm = 2.0 * f + (2.0 * f) * (s * atanh_tail(s));
    return k * kLn2Hi + (logm + k * kLn2Lo);
}
inline float log(float x) { return float(log(double(x))); }

// ── log2 / log10 : reuse the m-reduction of log ────────────────────────────
inline double log2(double x) {
    if (isnan(x)) return x;
    if (x < 0.0) return raise_domain();
    if (x == 0.0) return raise_pole(-1.0);
    if (isinf(x)) return kInf;
    u64 b = dbits(x);
    int e = (int)((b >> 52) & 0x7ff);
    int k = 0;
    if (e == 0) { x *= 0x1p54; b = dbits(x); e = (int)((b >> 52) & 0x7ff); k -= 54; }
    k += e - 1023;
    double m = dfrom((b & 0x800fffffffffffffULL) | ((u64)1023 << 52));
    if (m > 1.4142135623730951) { m *= 0.5; k++; }
    double f = (m - 1.0) / (m + 1.0);
    double s = f * f;
    double logm = 2.0 * f + (2.0 * f) * (s * atanh_tail(s));
    return (double)k + logm * kLog2e;
}
inline float log2(float x) { return float(log2(double(x))); }

inline double log10(double x) {
    if (isnan(x)) return x;
    if (x < 0.0) return raise_domain();
    if (x == 0.0) return raise_pole(-1.0);
    if (isinf(x)) return kInf;
    u64 b = dbits(x);
    int e = (int)((b >> 52) & 0x7ff);
    int k = 0;
    if (e == 0) { x *= 0x1p54; b = dbits(x); e = (int)((b >> 52) & 0x7ff); k -= 54; }
    k += e - 1023;
    double m = dfrom((b & 0x800fffffffffffffULL) | ((u64)1023 << 52));
    if (m > 1.4142135623730951) { m *= 0.5; k++; }
    double f = (m - 1.0) / (m + 1.0);
    double s = f * f;
    double logm = 2.0 * f + (2.0 * f) * (s * atanh_tail(s));
    const double kLog10_2 = 0.30102999566398119521;
    return (double)k * kLog10_2 + logm * kLog10e;
}
inline float log10(float x) { return float(log10(double(x))); }

// ── log1p : log(1+x); f = x/(2+x) avoids 1+x cancellation for small x ──────
inline double log1p(double x) {
    if (isnan(x)) return x;
    if (x < -1.0) return raise_domain();
    if (x == -1.0) return raise_pole(-1.0);
    if (isinf(x)) return kInf;
    if (fabs(x) < 0.29) {
        double f = x / (2.0 + x);
        double s = f * f;
        return 2.0 * f + (2.0 * f) * (s * atanh_tail(s));
    }
    return log(1.0 + x);
}
inline float log1p(float x) { return float(log1p(double(x))); }

