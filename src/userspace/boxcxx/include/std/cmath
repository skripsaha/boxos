// lerp at float128_t is exact arithmetic, so it comes along; it is also the
// one function here that must stay constexpr.
constexpr _Float128 lerp(_Float128 a, _Float128 b, _Float128 t)
{
    if ((a <= (_Float128)0 && b >= (_Float128)0) || (a >= (_Float128)0 && b <= (_Float128)0))
        return t * b + ((_Float128)1 - t) * a;
    if (t == (_Float128)1) return b;
    const _Float128 x = a + t * (b - a);
    if ((t > (_Float128)1) == (b > a)) return b < x ? x : b;
    return x < b ? x : b;
}
