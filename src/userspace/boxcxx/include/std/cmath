// ════════════════════════════════════════════════════════════════════════
//  long double = 80-bit x87: genuine hardware implementations (Ф27d1a).
//  Layout: mantissa = bits[63:0] (bit 63 = explicit integer bit), exponent =
//  bits[78:64] (15-bit, bias 16383), sign = bit 79, bits[127:80] = padding
//  (masked). Errno-free like the double paths: return kQNaNL/kInfL/signed-zero
//  directly, never set errno, never raise. float/double overloads unchanged.
// ════════════════════════════════════════════════════════════════════════
inline unsigned __int128 ldbits(long double x){ return __builtin_bit_cast(unsigned __int128, x); }
inline unsigned ld_exp(long double x){ return (unsigned)(uint16_t)(ldbits(x) >> 64) & 0x7FFFu; }
inline u64      ld_man(long double x){ return (u64)ldbits(x); }

inline bool signbit(long double x){ return ((ldbits(x) >> 79) & 1) != 0; }
inline bool isnan(long double x){ return ld_exp(x) == 0x7FFF && (ld_man(x) & 0x7FFFFFFFFFFFFFFFull) != 0; }
inline bool isinf(long double x){ return ld_exp(x) == 0x7FFF && ld_man(x) == 0x8000000000000000ull; }
inline bool isfinite(long double x){ return ld_exp(x) != 0x7FFF; }
inline bool isnormal(long double x){ unsigned e = ld_exp(x); return e != 0 && e != 0x7FFF; }
inline int  fpclassify(long double x){
    unsigned e = ld_exp(x); u64 m = ld_man(x);
    if (e == 0x7FFF) return (m & 0x7FFFFFFFFFFFFFFFull) ? FP_NAN_ : FP_INFINITE_;
    if (e == 0)      return (m == 0) ? FP_ZERO_ : FP_SUBNORMAL_;
    return FP_NORMAL_;
}

