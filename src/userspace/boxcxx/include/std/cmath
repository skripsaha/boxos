// Payne-Hanek core (fdlibm __kernel_rem_pio2, prec=2). x[]: nx 24-bit chunks
// of |input| mantissa; e0: binary exponent of x[0]; y[] ← reduced (hi,lo).
inline int kernel_rem_pio2(double *x, double *y, int e0, int nx) {
    const double two24 = 16777216.0, twon24 = 5.9604644775390625e-08;
    int jz, jx, jv, jp, jk, carry, n, iq[20], i, j, k, m, q0, ih;
    double z, fw, f[20], fq[20], q[20];
    jk = 4; jp = jk;
    jx = nx - 1;
    jv = (e0 - 3) / 24; if (jv < 0) jv = 0;
    q0 = e0 - 24 * (jv + 1);
    j = jv - jx; m = jx + jk;
    for (i = 0; i <= m; i++, j++) f[i] = (j < 0) ? 0.0 : (double)kIpio2[j];
    for (i = 0; i <= jk; i++) { for (j = 0, fw = 0.0; j <= jx; j++) fw += x[j] * f[jx + i - j]; q[i] = fw; }
    jz = jk;
recompute:
    for (i = 0, j = jz, z = q[jz]; j > 0; i++, j--) {
        fw = (double)(i32)(twon24 * z);
        iq[i] = (i32)(z - two24 * fw);
        z = q[j - 1] + fw;
    }
    z = scalbn(z, q0);
    z -= 8.0 * floor(z * 0.125);
    n = (i32)z; z -= (double)n;
    ih = 0;
    if (q0 > 0) { i = (iq[jz - 1] >> (24 - q0)); n += i; iq[jz - 1] -= i << (24 - q0); ih = iq[jz - 1] >> (23 - q0); }
    else if (q0 == 0) ih = iq[jz - 1] >> 23;
    else if (z >= 0.5) ih = 2;
    if (ih > 0) {
        n += 1; carry = 0;
        for (i = 0; i < jz; i++) { j = iq[i]; if (carry == 0) { if (j != 0) { carry = 1; iq[i] = 0x1000000 - j; } } else iq[i] = 0xffffff - j; }
        if (q0 > 0) { switch (q0) { case 1: iq[jz - 1] &= 0x7fffff; break; case 2: iq[jz - 1] &= 0x3fffff; break; } }
        if (ih == 2) { z = 1.0 - z; if (carry != 0) z -= scalbn(1.0, q0); }
    }
    if (z == 0.0) {
        j = 0; for (i = jz - 1; i >= jk; i--) j |= iq[i];
        if (j == 0) {
            for (k = 1; iq[jk - k] == 0; k++) {}
            for (i = jz + 1; i <= jz + k; i++) {
                f[jx + i] = (double)kIpio2[jv + i];
                for (j = 0, fw = 0.0; j <= jx; j++) fw += x[j] * f[jx + i - j];
                q[i] = fw;
            }
            jz += k; goto recompute;
        }
    }
    if (z == 0.0) { jz--; q0 -= 24; while (iq[jz] == 0) { jz--; q0 -= 24; } }
    else {
        z = scalbn(z, -q0);
        if (z >= two24) { fw = (double)(i32)(twon24 * z); iq[jz] = (i32)(z - two24 * fw); jz++; q0 += 24; iq[jz] = (i32)fw; }
        else iq[jz] = (i32)z;
    }
    fw = scalbn(1.0, q0);
    for (i = jz; i >= 0; i--) { q[i] = fw * (double)iq[i]; fw *= twon24; }
    for (i = jz; i >= 0; i--) { for (fw = 0.0, k = 0; k <= jp && k <= jz - i; k++) fw += kPIo2[k] * q[i + k]; fq[jz - i] = fw; }
    fw = 0.0; for (i = jz; i >= 0; i--) fw += fq[i];
    y[0] = (ih == 0) ? fw : -fw;
    fw = fq[0] - fw; for (i = 1; i <= jz; i++) fw += fq[i];
    y[1] = (ih == 0) ? fw : -fw;
    return n & 7;
}

// Reduce x mod π/2 → r∈[-π/4,π/4]; returns quadrant count n (low 2 bits used).
inline int rem_pio2(double x, double &r, double &rt) {
    double ax = fabs(x);
    if (ax <= 0.7853981633974483) { r = x; rt = 0.0; return 0; }   // |x|≤π/4
    if (ax < 1647099.0) {                                          // medium: Cody-Waite
        double fn = rint(x * kInvPio2);                            // signed
        double a  = x - fn * kPio2_1;                              // exact (|fn|<2^20)
        double p2 = fn * kPio2_2,  r1 = a  - p2, t1 = (a  - r1) - p2;
        double p3 = fn * kPio2_3,  r2 = r1 - p3, t2 = (r1 - r2) - p3;
        double p4 = fn * kPio2_3t, r3 = r2 - p4, t3 = (r2 - r3) - p4;
        r  = r3;
        rt = t1 + t2 + t3;                                         // ~128-bit π/2 tail
        return (int)fn & 3;                                        // quadrant (ok for fn<0)
    }
    if (!isfinite(x)) { r = kQNaN; rt = 0.0; return 0; }
    // large: Payne-Hanek
    u64 b = dbits(ax);
    int e0 = (int)((b >> 52) & 0x7ff) - 1046;     // exponent of leading 24-bit chunk
    double z = scalbn(ax, -e0);
    double tx[3], ty[2];
    for (int i = 0; i < 2; i++) { tx[i] = (double)(i32)z; z = (z - tx[i]) * 16777216.0; }
    tx[2] = z;
    int nx = 3; while (nx > 1 && tx[nx - 1] == 0.0) nx--;
    int n = kernel_rem_pio2(tx, ty, e0, nx);
    r = ty[0]; rt = ty[1];
    if (signbit(x)) { r = -r; rt = -rt; return (4 - (n & 3)) & 3; }
    return n & 3;
}

// kernels on |x|≤π/4 with reduction tail y (fdlibm tail structure, Taylor
// reciprocal-factorial coefficients). iy!=0 ⇒ argument carries a low part y.
inline double sin_kernel(double x, double y, int iy) {
    double z = x * x;
    double S1 = -1.0/6;
    double r = 1.0/120 + z*(-1.0/5040 + z*(1.0/362880 + z*(-1.0/39916800
             + z*(1.0/6227020800.0 + z*(-1.0/1307674368000.0 + z*(1.0/355687428096000.0
             + z*(-1.0/121645100408832000.0)))))));
    double v = z * x;
    if (iy == 0) return x + v * (S1 + z * r);
    return x - ((z * (0.5 * y - v * r) - y) - v * S1);
}
inline double cos_kernel(double x, double y) {
    double z = x * x;
    double r = z * (1.0/24 + z*(-1.0/720 + z*(1.0/40320 + z*(-1.0/3628800
             + z*(1.0/479001600 + z*(-1.0/87178291200.0 + z*(1.0/20922789888000.0
             + z*(-1.0/6402373705728000.0))))))));
    double hz = 0.5 * z, w = 1.0 - hz;
    return w + (((1.0 - w) - hz) + (z * r - x * y));
}
inline double sin(double x) {
    if (!isfinite(x)) return isnan(x) ? x : kQNaN;
    if (x == 0.0) return x;                          // sin(±0)=±0 (sign-preserving)
    double r, rt; int n = rem_pio2(x, r, rt);
    int iy = (rt != 0.0);
    switch (n & 3) {
        case 0:  return  sin_kernel(r, rt, iy);
        case 1:  return  cos_kernel(r, rt);
        case 2:  return -sin_kernel(r, rt, iy);
        default: return -cos_kernel(r, rt);
    }
}
inline double cos(double x) {
    if (!isfinite(x)) return isnan(x) ? x : kQNaN;
    double r, rt; int n = rem_pio2(x, r, rt);
    int iy = (rt != 0.0);
    switch (n & 3) {
        case 0:  return  cos_kernel(r, rt);
        case 1:  return -sin_kernel(r, rt, iy);
        case 2:  return -cos_kernel(r, rt);
        default: return  sin_kernel(r, rt, iy);
    }
}
inline double tan(double x) {
    if (!isfinite(x)) return isnan(x) ? x : kQNaN;
    if (x == 0.0) return x;                          // tan(±0)=±0 (sign-preserving)
    double r, rt; int n = rem_pio2(x, r, rt);
    int iy = (rt != 0.0);
    double sn = sin_kernel(r, rt, iy), cs = cos_kernel(r, rt);
    return (n & 1) ? -cs / sn : sn / cs;
}
inline float sin(float x) { return float(sin(double(x))); }
inline float cos(float x) { return float(cos(double(x))); }
inline float tan(float x) { return float(tan(double(x))); }

// ════════════════════════════════════════════════════════════════════════
//  Inverse trigonometric.
// ════════════════════════════════════════════════════════════════════════
constexpr double kPiHi   = 3.14159265358979311600;
constexpr double kPiLo   = 1.22464679914735320717e-16;
constexpr double kPiO2Hi = 1.57079632679489655800;
constexpr double kPiO2Lo = 6.12323399573676603587e-17;
constexpr double kPiO4Hi = 0.78539816339744827900;
constexpr double kPiO4Lo = 3.06161699786838301793e-17;

inline double atan_poly(double s) {
    double r = ATAN_C[ATAN_C_N - 1];
    for (int i = ATAN_C_N - 2; i >= 0; --i) r = r * s + ATAN_C[i];
    return r;
}
inline double asin_poly(double s) {
    double r = ASIN_C[ASIN_C_N - 1];
    for (int i = ASIN_C_N - 2; i >= 0; --i) r = r * s + ASIN_C[i];
    return r;
}
inline double atan(double x) {
    if (isnan(x)) return x;
    double ax = fabs(x);
    if (ax >= 0x1p66) return copysign(kPiO2Hi, x);
    int base; double t;
    if (ax <= 0.4142135623730950) { base = 0; t = ax; }
    else if (ax <= 2.4142135623730951) { base = 1; t = (ax - 1.0) / (ax + 1.0); }
    else { base = 2; t = -1.0 / ax; }
    double s = t * t;
    double poly = t + t * s * atan_poly(s);          // atan(t), |t|≤tan(π/8)
    double res;
    if (base == 0)      res = poly;
    else if (base == 1) res = (kPiO4Hi + poly) + kPiO4Lo;
    else                res = (kPiO2Hi + poly) + kPiO2Lo;
    return copysign(res, x);
}
inline double asin(double x) {
    if (isnan(x)) return x;
    double ax = fabs(x);
    if (ax > 1.0) return raise_domain();
    if (ax == 1.0) return copysign(kPiO2Hi, x) + copysign(kPiO2Lo, x);
    if (ax <= 0.5) { double s = ax * ax; return copysign(ax + ax * s * asin_poly(s), x); }
    double t = (1.0 - ax) * 0.5, s = sqrt(t);         // asin(ax)=π/2−2·asin(√t)
    double p = s + s * t * asin_poly(t);
    double r = kPiO2Hi - (2.0 * p - kPiO2Lo);
    return copysign(r, x);
}
inline double acos(double x) {
    if (isnan(x)) return x;
    double ax = fabs(x);
    if (ax > 1.0) return raise_domain();
    if (x == 1.0) return 0.0;
    if (x == -1.0) return kPiHi + kPiLo;
    if (ax <= 0.5) { double s = x * x; double r = x + x * s * asin_poly(s); return (kPiO2Hi - r) + kPiO2Lo; }
    if (x > 0.5) { double t = (1.0 - x) * 0.5, s = sqrt(t); return 2.0 * (s + s * t * asin_poly(t)); }
    double t = (1.0 + x) * 0.5, s = sqrt(t);          // acos(x)=π−2·asin(√((1+x)/2))
    double p = s + s * t * asin_poly(t);
    return kPiHi - (2.0 * p - kPiLo);
}
inline double atan2(double y, double x) {
    if (isnan(x) || isnan(y)) return kQNaN;
    if (isinf(x) && isinf(y)) {
        double b = signbit(x) ? (3.0 * kPiO4Hi) : kPiO4Hi;   // ±3π/4 or ±π/4
        return copysign(b, y);
    }
    if (isinf(x)) return signbit(x) ? copysign(kPiHi, y) : copysign(0.0, y);
    if (isinf(y)) return copysign(kPiO2Hi, y);
    if (x == 0.0) { return (y == 0.0) ? (signbit(x) ? copysign(kPiHi, y) : copysign(0.0, y))
                                      : copysign(kPiO2Hi, y); }
    if (y == 0.0) return signbit(x) ? copysign(kPiHi, y) : copysign(0.0, y);
    double t = atan(fabs(y) / fabs(x));
    if (signbit(x)) t = kPiHi - t + kPiLo;            // reflect into left half-plane
    return copysign(t, y);
}
inline float asin(float x)  { return float(asin(double(x))); }
inline float acos(float x)  { return float(acos(double(x))); }
inline float atan(float x)  { return float(atan(double(x))); }
inline float atan2(float y, float x) { return float(atan2(double(y), double(x))); }

// ════════════════════════════════════════════════════════════════════════
//  Double-double ln / exp primitives (shared by pow, tgamma).
// ════════════════════════════════════════════════════════════════════════
// ln(ax) as (hi,lo) ≈ ln(ax) to ~100 bits (ax > 0, finite, normal-or-sub).
inline void log_dd(double ax, double &hi, double &lo) {
    u64 b = dbits(ax);
    int e = (int)((b >> 52) & 0x7ff), k = 0;
    if (e == 0) { ax *= 0x1p54; b = dbits(ax); e = (int)((b >> 52) & 0x7ff); k -= 54; }
    k += e - 1023;
    double m = dfrom((b & 0x800fffffffffffffULL) | ((u64)1023 << 52));
    if (m > 1.4142135623730951) { m *= 0.5; k++; }
    double num = m - 1.0;                                   // exact (Sterbenz, m∈[½,2])
    double den_hi, den_lo; two_sum(m, 1.0, den_hi, den_lo); // den = m+1 EXACT (dd)
    double fhi = num / den_hi;
    double ph, pe; two_prod(fhi, den_hi, ph, pe);
    double flo = (num - ph - pe - fhi * den_lo) / den_hi;   // f = fhi + flo (dd)
    // ln(m) = 2f·(1 + corr), corr = atanh(f)/f − 1 = s/3 + s²/5 + …, s=f².
    // Full double-double chain (1/3 as dd-constant). NOTE: relies on round-to-
    // nearest without FMA fusion — target has no -mfma, so Dekker stays exact.
    double shi, sle; two_prod(fhi, fhi, shi, sle);
    double slo = sle + 2.0 * fhi * flo;                     // s = f² (dd)
    double R = 1.0/5 + shi*(1.0/7 + shi*(1.0/9 + shi*(1.0/11 + shi*(1.0/13
             + shi*(1.0/15 + shi*(1.0/17 + shi*(1.0/19 + shi*(1.0/21))))))));
    const double C3HI = 0.33333333333333331483, C3LO = 1.85037170770859410e-17;
    double sR_h, sR_l; two_prod(shi, R, sR_h, sR_l); sR_l += slo * R;
    double Qhi, Qlo; two_sum(C3HI, sR_h, Qhi, Qlo); Qlo += C3LO + sR_l;          // Q=1/3+s·R
    double cr_h, cr_l; two_prod(shi, Qhi, cr_h, cr_l); cr_l += slo * Qhi + shi * Qlo; // corr=s·Q
    double tfhi = 2.0 * fhi, tflo = 2.0 * flo;
    double tc_h, tc_l; two_prod(tfhi, cr_h, tc_h, tc_l); tc_l += tfhi * cr_l + tflo * cr_h; // 2f·corr
    double lmhi, lmlo; two_sum(tfhi, tc_h, lmhi, lmlo); lmlo += tflo + tc_l;     // ln(m) (dd)
    double khi, klo; two_prod((double)k, KLN2_HI, khi, klo); klo += (double)k * KLN2_LO;
    two_sum(khi, lmhi, hi, lo); lo += klo + lmlo;
}
// e^(hi+lo); the low part is folded into the small reduced argument.
inline double exp_dd(double hi, double lo) {
    if (hi > 709.782712893384) return kInf;
    if (hi < -745.1332191019412) return 0.0;
    int k = (int)rint(hi * kLog2e);
    double r = ((hi - k * kLn2Hi) - k * kLn2Lo) + lo;
    return scalbn(1.0 + expm1_series(r), k);
}

// ════════════════════════════════════════════════════════════════════════
//  pow : |x|^y = e^(y·ln|x|) in double-double.
// ════════════════════════════════════════════════════════════════════════
inline double pow(double x, double y) {
    if (y == 0.0) return 1.0;                          // pow(x,±0)=1 incl NaN
    if (x == 1.0) return 1.0;                          // pow(1,y)=1 incl NaN
    if (isnan(x) || isnan(y)) return kQNaN;
    double ax = fabs(x);
    bool yint = false, yodd = false;
    if (!isinf(y)) { double ya = fabs(y), yt = trunc(ya); if (yt == ya) { yint = true; yodd = (fmod(yt, 2.0) == 1.0); } }
    if (isinf(x)) {
        if (signbit(x)) { if (y < 0) return yodd ? -0.0 : 0.0; return yodd ? -kInf : kInf; }
        return (y < 0) ? 0.0 : kInf;
    }
    if (isinf(y)) {
        if (ax == 1.0) return 1.0;
        if (y > 0) return (ax > 1.0) ? kInf : 0.0;
        return (ax > 1.0) ? 0.0 : kInf;
    }
    if (x == 0.0) {
        if (y < 0) return raise_pole(yodd ? copysign(1.0, x) : 1.0);   // pole
        return yodd ? x : 0.0;
    }
    if (signbit(x) && !yint) return raise_domain();   // negative base, non-integer y
    double lhi, llo; log_dd(ax, lhi, llo);             // ln|x| in dd
    double phi, plo; two_prod(y, lhi, phi, plo); plo += y * llo;   // y·ln|x| in dd
    double res = exp_dd(phi, plo);
    return (signbit(x) && yodd) ? -res : res;
}
