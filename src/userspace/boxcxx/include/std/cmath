// ════════════════════════════════════════════════════════════════════════
//  [cmath.syn]/2 — the "sufficient additional overloads"
// ════════════════════════════════════════════════════════════════════════
// Without these, a call whose arguments are ALL integers has three equally
// bad candidates and is ambiguous: std::sqrt(4), std::pow(2, 3),
// std::atan2(1, 1) and std::fma(1, 2, 3) did not compile at all — the most
// idiomatic spelling of each. Mixing float with double happened to work
// (float -> double is a promotion, which outranks the conversion the float
// overload would need), but mixing float with long double did not, because
// nothing promotes to long double.
//
// The rule itself, verbatim: if any argument is long double, everything
// becomes long double; otherwise if any is double OR an integer type,
// everything becomes double; otherwise float. Mapping integers to double
// first makes the second clause fall out of an ordinary three-way widest-wins.
//
// These are function TEMPLATES, and the concrete overloads above are not, so
// an exact call still picks the real function: a non-template wins a tie.
// The `Needs` guards below make that structural rather than incidental.
namespace __math {

// [cmath.syn]/3 wants "the greatest floating-point conversion rank and
// greatest subrank among the types of all such arguments", and with the
// extended types present that is no longer a three-way widest-wins: the ranks
// are a PARTIAL order. FpLevel is the rank -- equal numbers mean equal rank --
// and the tie between an equal-ranked pair goes to the standard type, which is
// what "greatest subrank" says. float16_t and bfloat16_t share a level and
// neither is standard, and that is not an oversight: neither one's value set
// contains the other's, so their ranks are genuinely unordered and a call
// mixing them has no common type at all. [cmath.syn]/3 says so outright -- the
// program is ill-formed -- and Wider returning void is how that is spelled
// here, with Needs2/Needs3 turning it into "no matching function" rather than
// an error from inside a template body.
template <class T>
inline constexpr int FpLevel = is_same_v<T, long double> ? 4
                               : is_same_v<T, double>      ? 3
                               : is_same_v<T, float>       ? 2
#if defined(__STDCPP_FLOAT16_T__)
                               : is_same_v<T, _Float16>    ? 1
#endif
#if defined(__STDCPP_BFLOAT16_T__)
                               : is_same_v<T, __bf16>      ? 1
#endif
#if defined(__STDCPP_FLOAT32_T__)
                               : is_same_v<T, _Float32>    ? 2
#endif
#if defined(__STDCPP_FLOAT64_T__)
                               : is_same_v<T, _Float64>    ? 3
#endif
#if defined(__STDCPP_FLOAT128_T__)
                               : is_same_v<T, _Float128>   ? 5
#endif
                                                           : -1;

template <class T>
inline constexpr bool FpStandard =
    is_same_v<T, float> || is_same_v<T, double> || is_same_v<T, long double>;

template <class T, class U>
struct Wider {
    using type = conditional_t<
        (FpLevel<T> > FpLevel<U>), T,
        conditional_t<(FpLevel<U> > FpLevel<T>), U,
                      conditional_t<is_same_v<T, U>, T,
                                    conditional_t<FpStandard<T>, T,
                                                  conditional_t<FpStandard<U>, U, void>>>>>;
};

// An integer argument is "considered to have the same rank as double", which
// this expresses by making it one.
template <class T>
using P1 = conditional_t<is_floating_point_v<T>, T, double>;
template <class T, class U>
using P2 = typename Wider<P1<T>, P1<U>>::type;
// If a pair already has no common type, adding a third cannot give it one --
// and P1<void> would quietly answer "double" if this let it through.
template <class T, class U, class V>
using P3 = conditional_t<is_void_v<P2<T, U>>, void, P2<P2<T, U>, V>>;

// "Not already the target type." This guard is load-bearing twice over.
// It stops the template competing with a concrete overload that is already an
// exact match, so diagnostics name the real function — and, more seriously,
// it stops infinite recursion: isgreater and its five siblings exist ONLY at
// double, so an unguarded template asked for long double would promote to
// long double, find no concrete overload, select itself, and never stop.
template <class T>
concept Needs1 = is_arithmetic_v<T> && !is_same_v<T, P1<T>>;
template <class T, class U>
concept Needs2 = is_arithmetic_v<T> && is_arithmetic_v<U> && !is_void_v<P2<T, U>> &&
                 !(is_same_v<T, P2<T, U>> && is_same_v<U, P2<T, U>>);
template <class T, class U, class V>
concept Needs3 = is_arithmetic_v<T> && is_arithmetic_v<U> &&
                 is_arithmetic_v<V> && !is_void_v<P3<T, U, V>> &&
                 !(is_same_v<T, P3<T, U, V>> && is_same_v<U, P3<T, U, V>> &&
                   is_same_v<V, P3<T, U, V>>);

} // namespace __math

// The return type is deduced, never named: that is what lets one macro serve
// sqrt (returns the promoted type), ilogb (int), lround (long) and isnan
// (bool) without this file having to restate any of them.
#define BOXCXX_MATH_PROMOTE1(NAME)                                            \
    template <class T>                                                        \
        requires __math::Needs1<T>                                            \
    inline auto NAME(T x)                                                     \
    {                                                                         \
        return NAME(static_cast<__math::P1<T>>(x));                           \
    }
#define BOXCXX_MATH_PROMOTE2(NAME)                                            \
    template <class T, class U>                                               \
        requires __math::Needs2<T, U>                                         \
    inline auto NAME(T x, U y)                                                \
    {                                                                         \
        using P = __math::P2<T, U>;                                           \
        return NAME(static_cast<P>(x), static_cast<P>(y));                    \
    }
#define BOXCXX_MATH_PROMOTE3(NAME)                                            \
    template <class T, class U, class V>                                      \
        requires __math::Needs3<T, U, V>                                      \
    inline auto NAME(T x, U y, V z)                                           \
    {                                                                         \
        using P = __math::P3<T, U, V>;                                        \
        return NAME(static_cast<P>(x), static_cast<P>(y),                     \
                    static_cast<P>(z));                                       \
    }

