// ════════════════════════════════════════════════════════════════════════
//  cbrt : bit-hack seed + Halley step (fdlibm s_cbrt). ≤1 ULP.
// ════════════════════════════════════════════════════════════════════════
inline double cbrt(double x) {
    const u32 B1 = 715094163u, B2 = 696219795u;
    const double C = 5.42857142857142815906e-01, D = -7.05306122448979611050e-01,
                 E = 1.41428571428571436819e+00, F = 1.60714285714285720630e+00,
                 G = 3.57142857142857150787e-01;
    u64 b = dbits(x); u64 sign = b & 0x8000000000000000ULL;
    u32 hx = (u32)((b & 0x7fffffffffffffffULL) >> 32);
    if (hx >= 0x7ff00000) return x + x;               // inf / nan
    if ((b & 0x7fffffffffffffffULL) == 0) return x;   // ±0
    double ax = dfrom(b & 0x7fffffffffffffffULL);
    double t;
    if (hx < 0x00100000) {                            // subnormal
        t = dfrom((u64)0x43500000u << 32); t *= ax;
        u32 th = (u32)(dbits(t) >> 32);
        t = dfrom((u64)(th / 3 + B2) << 32);
    } else {
        t = dfrom((u64)(hx / 3 + B1) << 32);
    }
    double r = t * t / ax, s = C + r * t;
    t *= G + F / (s + E + D / s);
    t = dfrom(((dbits(t) >> 32) + 1) << 32);           // chop to 20 bits + round
    s = t * t; r = ax / s; double w = t + t; r = (r - t) / (w + r); t = t + t * r;
    return dfrom(dbits(t) | sign);
}
inline float cbrt(float x) { return float(cbrt(double(x))); }

// ════════════════════════════════════════════════════════════════════════
//  erf / erfc : Taylor series (|x|<0.84) + Lentz continued fraction.
// ════════════════════════════════════════════════════════════════════════
inline double erf_poly(double s) {
    double r = ERF_C[ERF_C_N - 1];
    for (int i = ERF_C_N - 2; i >= 0; --i) r = r * s + ERF_C[i];
    return r;                                          // erf(x)/x, s=x²
}
// erfc on [0.5,27] via scaled w(x)=x·e^{x²}·erfc(x) (smooth; two Chebyshev pieces,
// Clenshaw) × e^{-x²} (dd). No cancellation → ≤6 ULP. e^{-x²}<2^-... for x≥27 → 0.
inline double erfc_scaled(double x) {
    double t, w, t2, b0 = 0.0, b1 = 0.0;
    if (x < 6.0) {
        t = (2.0 * x - 6.5) / 5.5;                      // [0.5,6] → [-1,1]
        t2 = 2.0 * t;
        for (int k = ERFC_W1_N - 1; k >= 1; --k) { double b = t2 * b0 - b1 + ERFC_W1[k]; b1 = b0; b0 = b; }
        w = t * b0 - b1 + ERFC_W1[0];
    } else {
        t = (2.0 * x - 33.0) / 21.0;                    // [6,27] → [-1,1]
        t2 = 2.0 * t;
        for (int k = ERFC_W2_N - 1; k >= 1; --k) { double b = t2 * b0 - b1 + ERFC_W2[k]; b1 = b0; b0 = b; }
        w = t * b0 - b1 + ERFC_W2[0];
    }
    double x2h, x2l; two_prod(x, x, x2h, x2l);
    return exp_dd(-x2h, -x2l) * w / x;
}
inline double erf(double x) {
    if (isnan(x)) return x;
    if (isinf(x)) return copysign(1.0, x);
    double a = fabs(x), r;
    if (a < 0.5) r = a * erf_poly(a * a);
    else if (a < 27.0) r = 1.0 - erfc_scaled(a);
    else r = 1.0;
    return copysign(r, x);
}
inline double erfc(double x) {
    if (isnan(x)) return x;
    if (isinf(x)) return signbit(x) ? 2.0 : 0.0;
    if (x >= 0.0) {
        if (x < 0.5)  return 1.0 - x * erf_poly(x * x);
        if (x < 27.0) return erfc_scaled(x);
        return 0.0;                                    // underflow
    }
    double a = -x;
    if (a < 0.5)  return 1.0 + a * erf_poly(a * a);
    if (a < 27.0) return 2.0 - erfc_scaled(a);
    return 2.0;
