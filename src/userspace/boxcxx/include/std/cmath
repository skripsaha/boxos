// ── correctly-rounded atan2(y,x) (software double-double, 80-bit) ────────────
// Quadrant from the sign bits; magnitude atan(|y|/|x|) ∈ [0,π/2] in dd, x<0
// reflects to π−·, sign of y applied last. Axis / ±0 / ±Inf per IEEE Annex F.
// NO x87 fpatan — the LAST x87 transcendental removed from cmath ⇒ all of cmath
// is now genuine software 80-bit.
inline long double atan2(long double y, long double x){
    if (isnan(x) || isnan(y)) return kQNaNL;
    LdDd hp{ld_from_bits_l(kHalfPiHiM, kHalfPiHiS), ld_from_bits_l(kHalfPiLoM, kHalfPiLoS)};
    LdDd piL{hp.hi + hp.hi, hp.lo + hp.lo};              // π (dd)
    long double halfpi = hp.hi + hp.lo, pi = piL.hi + piL.lo;
    bool sy = signbit(y), sx = signbit(x);
    if (isinf(x) && isinf(y)){                           // ±π/4 (x>0) or ±3π/4 (x<0)
        LdDd quarter{hp.hi * 0.5L, hp.lo * 0.5L};        // π/4 = π/2·½ (exact)
        LdDd v = sx ? dd_add_ld(hp, quarter) : quarter;  // 3π/4 ; π/4
        long double q = v.hi + v.lo; return sy ? -q : q;
    }
    if (isinf(y)) return sy ? -halfpi : halfpi;          // |y|=inf, x finite → ±π/2
    if (isinf(x)){ long double r = sx ? pi : 0.0L; return sy ? -r : r; } // x=±inf → ±π/±0
    if (y == 0.0L){ long double r = sx ? pi : 0.0L; return sy ? -r : r; } // y=±0 → ±0/±π
    if (x == 0.0L) return sy ? -halfpi : halfpi;         // x=±0, y≠0 → ±π/2
