    int ey = ilogb(fabs(y)), ex = ilogb(fabs(x));
    if (ey - ex > 130) v = halfpi;                       // |y|≫|x| → π/2 (below ½ULP)
    else {
        LdDd t = atan_dd(dd_div_ld(LdDd{fabs(y), 0.0L}, LdDd{fabs(x), 0.0L}));  // atan(|y|/|x|)
        LdDd res = sx ? dd_add_ld(piL, LdDd{-t.hi, -t.lo}) : t;                 // x<0: π−t
        v = res.hi + res.lo;
    }
    return sy ? -v : v;
}

