    LdDd t = atan_reduced_dd(dd_div_ld(LdDd{1.0L, 0.0L}, a));     // atan(1/a), 1/a∈(0,1)
    LdDd hp{ld_from_bits_l(kHalfPiHiM, kHalfPiHiS), ld_from_bits_l(kHalfPiLoM, kHalfPiLoS)};
    return dd_add_ld(hp, LdDd{-t.hi, -t.lo});                     // π/2 − atan(1/a)
