    else                   q = sin_reduce_ph(ax, r);
    LdDd s;
    switch (q){                                          // cos(q·π/2 + r)
        case 0:  s = cos_series_dd(r); break;                                  // cos(r)
        case 1:  s = sin_series_dd(r); s = LdDd{-s.hi, -s.lo}; break;          // −sin(r)
        case 2:  s = cos_series_dd(r); s = LdDd{-s.hi, -s.lo}; break;          // −cos(r)
