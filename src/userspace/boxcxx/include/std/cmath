// e^x = 2ⁿ·M with M (dd) = 2^f ∈ [√½,√2] and n = round(x·log2 e). Returns the
// bounded mantissa M and n separately so callers (cosh/sinh/tanh) can factor out
// the dominant exponent before combining e^x with e^{−x} — avoids intermediate
// overflow and lets the ±e^{−x} term sink below the ~127-bit dd floor cleanly.
inline LdDd exp_reduce_dd(long double x, int &n){
    LdDd X = dd_mul_ld(LdDd{x, 0.0L}, LdDd{KLOG2E_DD_HI_L, KLOG2E_DD_LO_L});
    long double nn = rint(X.hi);
    long double fh, fl; two_sum_l(X.hi - nn, X.lo, fh, fl);   // f = (X−n) (dd, |f| ≤ 0.5)
    LdDd t = dd_mul_ld(LdDd{fh, fl}, LdDd{KLN2DD_HI_L, KLN2DD_LO_L});   // t = f·ln2
    n = (int)nn;
    return exp_series_dd(t);                                  // 2^f (dd, ~127 bits)
}

// ── correctly-rounded natural-log core (software double-double, 80-bit) ─────
// x = m·2^k, m∈[√½,√2); ln(x) = k·ln2 + ln(m), ln(m) = 2·atanh(f),
// f = (m−1)/(m+1) (|f| ≤ 0.1716) via the odd series 2f·Σ_{j≥0} s^j/(2j+1),
// s = f². Carried in a renormalized dd (~127 bits) with fscale/fadd/fmul/fsub/
// fdiv only — NO x87 fyl2x — so QEMU-TCG/Bochs/real-HW all compute at true
// 80-bit. log/log2/log10 SHARE this one reduction and correctly round hi+lo to
// the 64-bit mantissa (0 ULP vs MPFR over the verified sweep). Caller guarantees
// x > 0 finite and x ≠ 1 (so ln(x) ≠ 0 and the dd never degenerates).
inline LdDd log_dd_core_l(long double x){
    int bias = 0;
    long double xx = x;
    if (ld_exp(x) == 0){ xx = x * 0x1p64L; bias = -64; }   // normalize subnormal
    unsigned __int128 b = ldbits(xx);
    int k = (int)((b >> 64) & 0x7FFFu) - 16383 + bias;
    unsigned __int128 mbits = (b & ((((unsigned __int128)1) << 64) - 1))
                            | (((unsigned __int128)16383) << 64);   // m ∈ [1,2)
    long double m = __builtin_bit_cast(long double, mbits);
    if (m > 1.414213562373095048801689L){ m *= 0.5L; k++; }         // fold into [√½,√2)
    long double num = m - 1.0L;                          // exact (Sterbenz)
    LdDd den; two_sum_l(m, 1.0L, den.hi, den.lo);        // m+1 (dd)
    LdDd f = dd_div_ld(LdDd{num, 0.0L}, den);            // f = (m−1)/(m+1)
    LdDd s = dd_mul_ld(f, f);                            // s = f²
    LdDd P = dd_div_ld(LdDd{1.0L, 0.0L}, LdDd{55.0L, 0.0L});  // c_27 = 1/55
    for (int j = 26; j >= 0; --j){                       // Horner Σ s^j/(2j+1) in dd
        P = dd_mul_ld(P, s);
        P = dd_add_ld(P, dd_div_ld(LdDd{1.0L, 0.0L}, LdDd{(long double)(2*j+1), 0.0L}));
    }
    LdDd twof{f.hi + f.hi, f.lo + f.lo};                 // 2f (exact ×2)
    LdDd lm = dd_mul_ld(twof, P);                        // ln(m) = 2f·P
    LdDd kl = dd_mul_ld(LdDd{(long double)k, 0.0L}, LdDd{KLN2DD_HI_L, KLN2DD_LO_L}); // k·ln2
    return dd_add_ld(kl, lm);                            // ln(x) = k·ln2 + ln(m)
}
// ln(x) as dd for a positive dd argument x whose leading word x.hi is a normal
// (the inverse-hyperbolic callers always feed x.hi ≥ 1). Generalises
// log_dd_core_l to carry x.lo through the m = x·2⁻ᵏ reduction.
inline LdDd log_dd_core_dd(LdDd x){
    int k = (int)ld_exp(x.hi) - 16383;
    LdDd m{scalbn(x.hi, -k), scalbn(x.lo, -k)};          // m = x·2⁻ᵏ ∈ [1,2)+tiny (exact)
    if (m.hi > 1.414213562373095048801689L){ m.hi *= 0.5L; m.lo *= 0.5L; k++; }  // fold [√½,√2)
    LdDd f = dd_div_ld(dd_add_ld(m, LdDd{-1.0L, 0.0L}), dd_add_ld(m, LdDd{1.0L, 0.0L}));
    LdDd s = dd_mul_ld(f, f);
    LdDd P = dd_div_ld(LdDd{1.0L, 0.0L}, LdDd{55.0L, 0.0L});          // c₂₇ = 1/55
    for (int j = 26; j >= 0; --j){
        P = dd_mul_ld(P, s);
        P = dd_add_ld(P, dd_div_ld(LdDd{1.0L, 0.0L}, LdDd{(long double)(2*j+1), 0.0L}));
    }
    LdDd lm = dd_mul_ld(LdDd{f.hi + f.hi, f.lo + f.lo}, P);           // ln(m) = 2f·P
    LdDd kl = dd_mul_ld(LdDd{(long double)k, 0.0L}, LdDd{KLN2DD_HI_L, KLN2DD_LO_L});
    return dd_add_ld(kl, lm);                            // k·ln2 + ln(m)
}
inline long double log(long double x){
    if (isnan(x))  return x;
    if (x < 0.0L)  return raise_domain_l();              // domain error
    if (x == 0.0L) return raise_pole_l(-1.0L);           // pole: FE_DIVBYZERO
    if (isinf(x))  return kInfL;                         // +Inf (x<0 already ruled out)
    if (x == 1.0L) return 0.0L;                          // ln(1) = +0 exactly
    LdDd r = log_dd_core_l(x);
    return r.hi + r.lo;                                  // correctly round to 64-bit
}
inline long double log2(long double x){
    if (isnan(x))  return x;
