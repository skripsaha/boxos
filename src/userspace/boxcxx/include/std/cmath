    if (exp == 0 && frac == 0){                           // ±0 → smallest subnormal toward y
        unsigned __int128 res = ((unsigned __int128)(signbit(y) ? 0x8000u : 0u) << 64) | 1u;
        return __builtin_bit_cast(long double, res);
    }
    bool up = xneg ? (y < x) : (y > x);                   // move away from zero?
    if (up){                                              // carry across the explicit integer bit
        if (frac == 0x7FFFFFFFFFFFFFFFull){ frac = 0; ++exp; } else ++frac;
    } else {
        if (frac == 0){ frac = 0x7FFFFFFFFFFFFFFFull; --exp; } else --frac;
    }
    u64 nm = ((exp != 0) ? ((u64)1 << 63) : 0ull) | frac;
    unsigned nse = (xneg ? 0x8000u : 0u) | (exp & 0x7FFFu);
    unsigned __int128 res = ((unsigned __int128)nse << 64) | nm;
    return __builtin_bit_cast(long double, res);
}
inline long double nexttoward(long double x, long double y){ return nextafter(x, y); }

inline long double modf(long double x, long double *ip){
    if (isinf(x)) { *ip = x; return copysign(0.0L, x); }
    long double i = trunc(x); *ip = i;
    return isnan(x) ? x : copysign(x - i, x);
}

