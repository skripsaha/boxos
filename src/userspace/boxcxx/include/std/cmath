// than at the top purely for reading order: nothing above this line needs
// them, and everything below does.
#include <__bits/cmath_quad>

namespace std {

// ════════════════════════════════════════════════════════════════════════
//  [cmath.syn]/2 at the EXTENDED floating-point types (Ф40)
// ════════════════════════════════════════════════════════════════════════
// "For each function with at least one parameter of type floating-point-type,
// the implementation provides an overload for each cv-unqualified
// floating-point type" -- and on this toolchain there are eight such types,
// not three: __STDCPP_FLOAT16_T__ and its four siblings are all predefined,
// which makes _Float16, _Float32, _Float64, _Float128 and __bf16 standard
// floating-point types by [basic.extended.fp]. Until Ф40 this clause was five
// types short and nobody had noticed, because nothing in the tree had ever
// written one of them down.
//
// Four of the five are answered by computing in the standard type whose format
// contains theirs and converting back. That is not a shortcut, it is the whole
// of the arithmetic: _Float32 IS binary32 and _Float64 IS binary64, so those
// two are exact by construction; _Float16 (11 significand bits) and __bf16 (8)
// go through double, whose 53 bits are more than the 2p+2 that makes the
// double rounding provably harmless. The fifth, float128_t, has no wider type
// to hide in and gets real kernels -- see <__bits/cmath_quad>, including which
// functions it does NOT get and why.
namespace __math {

// The type an extended floating-point type computes through.
template <class T> struct Via {
    using type = void;
};
#if defined(__STDCPP_FLOAT16_T__)
template <> struct Via<_Float16> {
    using type = double;
};
#endif
#if defined(__STDCPP_BFLOAT16_T__)
template <> struct Via<__bf16> {
    using type = double;
};
#endif
#if defined(__STDCPP_FLOAT32_T__)
template <> struct Via<_Float32> {
    using type = float;
};
#endif
#if defined(__STDCPP_FLOAT64_T__)
template <> struct Via<_Float64> {
    using type = double;
};
#endif

template <class T>
concept NarrowExt = !is_void_v<typename Via<T>::type>;

// Converts a result back to T when the underlying function returned a value,
// and leaves an int, long or bool result exactly as it is. One helper is what
// lets a single macro serve sqrt, ilogb, lround and isnan alike.
template <class T, class R>
constexpr auto Back(R r)
{
    if constexpr (is_same_v<R, typename Via<T>::type>) return static_cast<T>(r);
    else return r;
}

} // namespace __math

