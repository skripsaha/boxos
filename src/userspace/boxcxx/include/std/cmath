inline double acosh(double x) {
    if (isnan(x)) return x;
    if (x < 1.0) return kQNaN;
    if (x == 1.0) return 0.0;
    if (isinf(x)) return x;
    if (x > 0x1p28) return log(x) + kLn2;              // ≈ln(2x)
    if (x > 2.0) return log(2.0 * x - 1.0 / (x + sqrt(x * x - 1.0)));
    double t = x - 1.0;
    return log1p(t + sqrt(2.0 * t + t * t));
}
inline double atanh(double x) {
    if (isnan(x)) return x;
    double a = fabs(x), s = copysign(1.0, x);
    if (a > 1.0) return kQNaN;
    if (a == 1.0) return copysign(kInf, x);
    if (a < 1e-8) return x;
    return s * 0.5 * log1p(2.0 * a / (1.0 - a));
}
