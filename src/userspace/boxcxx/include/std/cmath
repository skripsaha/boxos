    long double a = fabs(x);
    if (a < 0x1p-32L) return x;                           // sinh(x)=x (odd; keeps ±0 sign)
    if (a > 11400.0L) return copysign(kInfL, x);          // overflow → ±inf
    int na, nb;
    LdDd Ma = exp_reduce_dd(a, na);                       // e^a  = 2^na·Ma
    LdDd Mb = exp_reduce_dd(-a, nb);                      // e^-a = 2^nb·Mb  (na ≥ nb)
    int d = nb - na;
    LdDd sm = (d <= -130) ? LdDd{0.0L, 0.0L}
                          : LdDd{scalbn(Mb.hi, d), scalbn(Mb.lo, d)};
    LdDd B = dd_add_ld(Ma, LdDd{-sm.hi, -sm.lo});         // Ma − 2^d·Mb (leading cancel exact)
    return copysign(scalbn(B.hi + B.lo, na - 1), x);
