// ════════════════════════════════════════════════════════════════════════
//  Hyperbolic + inverse hyperbolic (composed from exp/log1p/expm1).
// ════════════════════════════════════════════════════════════════════════
inline double sinh(double x) {
    if (!isfinite(x)) return x;                       // ±inf, nan
    double a = fabs(x), h = signbit(x) ? -0.5 : 0.5;
    if (a < 22.0) { double t = expm1(a); return h * (t + t / (t + 1.0)); }
    if (a < 709.782712893384) return h * exp(a);
    return h * 2.0 * (0.5 * exp(0.5 * a)) * exp(0.5 * a);   // avoid overflow mid-way
}
inline double cosh(double x) {
    double a = fabs(x);
    if (a < 22.0) { double t = expm1(a); return 1.0 + t * t / (2.0 * (1.0 + t)); }
    if (a < 709.782712893384) return 0.5 * exp(a);
