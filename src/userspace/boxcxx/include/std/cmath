inline LdDd atan_reduced_dd(LdDd a){                      // atan(a), a∈[0,1] as dd
    int idx = (int)rint(a.hi * 16.0L);
    if (idx < 0) idx = 0; else if (idx > 16) idx = 16;
    long double c = (long double)idx * 0.0625L;
    LdDd num = dd_add_ld(a, LdDd{-c, 0.0L});
    LdDd den = dd_add_ld(LdDd{1.0L, 0.0L}, dd_mul_ld(LdDd{c, 0.0L}, a));
    LdDd r   = dd_div_ld(num, den);
    LdDd ar  = atan_series_dd(r);
    LdDd ac{ld_from_bits_l(kAtanHiM[idx], kAtanHiS[idx]), ld_from_bits_l(kAtanLoM[idx], kAtanLoS[idx])};
