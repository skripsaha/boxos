inline LdDd atan_series_dd(LdDd r){                       // r·Σ_j (−1)^j r^{2j}/(2j+1)
    LdDd s = dd_mul_ld(r, r);
    LdDd P = dd_div_ld(LdDd{1.0L, 0.0L}, LdDd{31.0L, 0.0L}); P.hi = -P.hi; P.lo = -P.lo;
