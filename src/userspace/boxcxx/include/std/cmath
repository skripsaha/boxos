// ── correctly-rounded log1p(x) = ln(1+x) (software double-double, 80-bit) ────
// 1+x is carried EXACTLY as a dd W=two_sum(1,x) (no low bits of x lost — the trap
// of forming 1+x in bare long double). W = m·2^k, m∈[√½,√2); ln1p = k·ln2 + 2·
// atanh(f), f=(m−1)/(m+1) via the same odd series as ln. A subnormal / smallest-
// normal result would drop f's low bit, so that regime is recomputed with f
// scaled by 2^64 and single-rounded onto the subnormal grid. All faithful ops —
// NO x87 fyl2xp1 — 0 ULP vs MPFR over the verified sweep. x<−1→NaN, x==−1→−Inf,
// x==±0→±0.
inline long double log1p(long double x){
    if (isnan(x))    return x;
    if (x < -1.0L)   return raise_domain_l();            // domain error (incl −Inf)
    if (x == -1.0L)  return raise_pole_l(-1.0L);         // pole
    if (x == 0.0L)   return x;                           // ±0 preserved
    if (isinf(x))    return kInfL;                       // +Inf
    long double wh, wl; two_sum_l(1.0L, x, wh, wl);      // W = 1+x (exact dd)
    int adj = 0;
    if (ld_exp(wh) == 0){ wh = scalbn(wh, 64); wl = scalbn(wl, 64); adj = -64; } // W subnormal (x≈−1)
    int e = (int)ld_exp(wh) - 16383;                     // exponent of (scaled) wh
    long double mh = scalbn(wh, -e), ml = scalbn(wl, -e);   // m = W·2^-e ∈ [1,2) (exact)
    int k = e + adj;                                     // true exponent of W
    if (mh > 1.414213562373095048801689L){ mh *= 0.5L; ml *= 0.5L; k++; }  // fold to [√½,√2)
    LdDd num = dd_add_ld(LdDd{mh, ml}, LdDd{-1.0L, 0.0L});   // m − 1 (dd)
    LdDd den = dd_add_ld(LdDd{mh, ml}, LdDd{ 1.0L, 0.0L});   // m + 1 (dd)
    LdDd f = dd_div_ld(num, den);                        // f = (m−1)/(m+1)
    LdDd s = dd_mul_ld(f, f);                            // s = f²
    LdDd P = dd_div_ld(LdDd{1.0L, 0.0L}, LdDd{55.0L, 0.0L});  // c_27 = 1/55
    for (int j = 26; j >= 0; --j){                       // Horner Σ s^j/(2j+1) in dd
        P = dd_mul_ld(P, s);
        P = dd_add_ld(P, dd_div_ld(LdDd{1.0L, 0.0L}, LdDd{(long double)(2*j+1), 0.0L}));
    }
    LdDd twof{f.hi + f.hi, f.lo + f.lo};                 // 2f (exact ×2)
    LdDd lm = dd_mul_ld(twof, P);                        // ln(m) = 2f·P
    LdDd kl = dd_mul_ld(LdDd{(long double)k, 0.0L}, LdDd{KLN2DD_HI_L, KLN2DD_LO_L}); // k·ln2
    LdDd r  = dd_add_ld(kl, lm);                         // ln(1+x) = k·ln2 + ln(m)
    long double v0 = r.hi + r.lo;
    if (ld_exp(v0) <= 1){                                // subnormal / smallest-normal result
        long double xs = scalbn(x, 64);                  // x·2^64 (normal; k=0 in this regime)
        long double dh, dl; two_sum_l(2.0L, x, dh, dl);  // 2+x (dd)
        LdDd fs = dd_div_ld(LdDd{xs, 0.0L}, LdDd{dh, dl});   // f·2^64 (normal)
        LdDd f2 = dd_mul_ld(fs, fs);
        LdDd ss{scalbn(f2.hi, -128), scalbn(f2.lo, -128)};  // s = f² (underflows → 0)
        LdDd Ps = dd_div_ld(LdDd{1.0L, 0.0L}, LdDd{55.0L, 0.0L});
        for (int j = 26; j >= 0; --j){
            Ps = dd_mul_ld(Ps, ss);
            Ps = dd_add_ld(Ps, dd_div_ld(LdDd{1.0L, 0.0L}, LdDd{(long double)(2*j+1), 0.0L}));
        }
        LdDd twofs{fs.hi + fs.hi, fs.lo + fs.lo};        // 2f·2^64
        LdDd Rs = dd_mul_ld(twofs, Ps);                  // result·2^64 (normal dd)
        return round_dd_to_subnormal_l(Rs.hi, Rs.lo, -64);
    }
    return v0;                                           // correctly round to 64-bit
}

inline long double ld_from_bits_l(unsigned long long m, unsigned short se){
