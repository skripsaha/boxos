// <random> — uniform random bit generators and distributions ([rand]).
//
// boxcxx freestanding implementation: engines (LCG, Mersenne Twister,
// subtract-with-carry) + adaptors + predefined, seed_seq, generate_canonical,
// random_device (RDRAND via cpu_caps, TSC-mixed fallback), and the full set of
// distributions. Stream insert/extract operators are omitted (no <iostream>).
#ifndef BOXCXX_RANDOM
#define BOXCXX_RANDOM

#include <__bits/random_engine>
#include <__bits/random_dist>

// [version.syn] names this header as the owner of the macro below.
#define BOXCXX_OWNS_philox_engine
#include <__bits/version_random>

// [version.syn] names this header as an owner of the freestanding marker(s)
// below; nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_freestanding_random
#include <__bits/version_freestanding>

#endif // BOXCXX_RANDOM
