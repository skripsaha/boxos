// boxcxx — <cstddef>
#ifndef BOXCXX_CSTDDEF
#define BOXCXX_CSTDDEF

#include <__bits/core_traits>

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_byte
#include <__bits/version_cstddef>

typedef __SIZE_TYPE__    size_t;
typedef __PTRDIFF_TYPE__ ptrdiff_t;

#ifndef NULL
#define NULL nullptr
#endif

#define offsetof(type, member) __builtin_offsetof(type, member)

namespace std {

using size_t    = ::size_t;
using ptrdiff_t = ::ptrdiff_t;
using nullptr_t = decltype(nullptr);

// x86-64 SysV: the strictest fundamental alignment is 16 (long double).
struct max_align_t {
    alignas(alignof(long long))   long long   __ll;
    alignas(alignof(long double)) long double __ld;
};

enum class byte : unsigned char {};

template <class I, class = enable_if_t<is_integral_v<I>>>
[[nodiscard]] constexpr I to_integer(byte b) noexcept
{
    return static_cast<I>(b);
}

template <class I, class = enable_if_t<is_integral_v<I>>>
constexpr byte operator<<(byte b, I shift) noexcept
{
    return static_cast<byte>(
        static_cast<unsigned char>(static_cast<unsigned int>(b) << shift));
}

template <class I, class = enable_if_t<is_integral_v<I>>>
constexpr byte operator>>(byte b, I shift) noexcept
{
    return static_cast<byte>(
        static_cast<unsigned char>(static_cast<unsigned int>(b) >> shift));
}

template <class I, class = enable_if_t<is_integral_v<I>>>
constexpr byte &operator<<=(byte &b, I shift) noexcept
{
    return b = b << shift;
}

template <class I, class = enable_if_t<is_integral_v<I>>>
constexpr byte &operator>>=(byte &b, I shift) noexcept
{
    return b = b >> shift;
}

constexpr byte operator|(byte l, byte r) noexcept
{
    return static_cast<byte>(static_cast<unsigned char>(
        static_cast<unsigned int>(l) | static_cast<unsigned int>(r)));
}

constexpr byte operator&(byte l, byte r) noexcept
{
    return static_cast<byte>(static_cast<unsigned char>(
        static_cast<unsigned int>(l) & static_cast<unsigned int>(r)));
}

constexpr byte operator^(byte l, byte r) noexcept
{
    return static_cast<byte>(static_cast<unsigned char>(
        static_cast<unsigned int>(l) ^ static_cast<unsigned int>(r)));
}

constexpr byte operator~(byte b) noexcept
{
    return static_cast<byte>(
        static_cast<unsigned char>(~static_cast<unsigned int>(b)));
}

constexpr byte &operator|=(byte &l, byte r) noexcept { return l = l | r; }
constexpr byte &operator&=(byte &l, byte r) noexcept { return l = l & r; }
constexpr byte &operator^=(byte &l, byte r) noexcept { return l = l ^ r; }

} // namespace std

#endif // BOXCXX_CSTDDEF
