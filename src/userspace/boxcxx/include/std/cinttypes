// boxcxx — <cinttypes>
//
// [cinttypes.syn]. The header that is almost entirely macros, and whose macros
// are the reason it cannot be a wrapper: GCC's freestanding set stops at
// <stdint.h> and never ships <inttypes.h>, so before Ф41 there was not a single
// PRI* or SCN* spelling anywhere in the BoxOS tree — the format strings that
// print a uint64_t were written by hand, per call site, in the one modifier the
// author happened to know was right.
//
// A PRI macro is a promise about the ABI: PRId64 expands to "ld" only because
// int64_t IS long on x86-64 SysV. Everywhere else that promise is made by a
// vendor header generated for the target. Here it is made by this file, so it
// is made **checkably**: the static_asserts below fail the build if any of the
// five assumptions stops holding, rather than letting printf read the wrong
// number of bytes off the varargs list and print a plausible lie. That is the
// whole reason the modifiers are not simply typed in.
//
// The abs/div overloads taking intmax_t that [cinttypes.syn] shows are
// deliberately absent, and their absence is required rather than a shortcut:
// the synopsis note limits them to the case where intmax_t designates an
// *extended* integer type. On this target intmax_t is long, <cstdlib> already
// declares abs(long) and div(long, long), and declaring them again here would
// be a redefinition, not an overload.
#ifndef BOXCXX_CINTTYPES
#define BOXCXX_CINTTYPES

// [cinttypes.syn]/2 — the header includes <cstdint>, and that is normative:
// a program may include <cinttypes> alone and use int64_t.
#include <cstdint>
// ...and <cstdlib>, for the parser strtoimax/strtoumax forward to. Naming it
// here rather than mid-file keeps every dependency of this header in one place.
#include <cstdlib>

namespace __boxcxx_inttypes {
// A two-line same-type trait, local on purpose: <type_traits> would be a heavy
// dependency for a header whose job is text substitution, and the assertions
// below are the only user.
template <class, class> struct Same { static constexpr bool value = false; };
template <class T> struct Same<T, T> { static constexpr bool value = true; };
} // namespace __boxcxx_inttypes

// The five promises every macro in this file rests on. int8_t is signed char
// rather than char because printf's "hh" reads an int-promoted signed char, and
// char's signedness is a separate question that must not leak in here.
static_assert(__boxcxx_inttypes::Same<::std::int8_t, signed char>::value,
              "<cinttypes>: PRI*8 assumes int8_t is signed char");
static_assert(__boxcxx_inttypes::Same<::std::int16_t, short>::value,
              "<cinttypes>: PRI*16 assumes int16_t is short");
static_assert(__boxcxx_inttypes::Same<::std::int32_t, int>::value,
              "<cinttypes>: PRI*32 assumes int32_t is int");
static_assert(__boxcxx_inttypes::Same<::std::int64_t, long>::value,
              "<cinttypes>: PRI*64 assumes int64_t is long");
static_assert(__boxcxx_inttypes::Same<::std::intmax_t, long>::value &&
                  __boxcxx_inttypes::Same<::std::intptr_t, long>::value,
              "<cinttypes>: PRI*MAX/PRI*PTR assume intmax_t and intptr_t are long");

