namespace std {

// [cinttypes.syn] — a distinct structure type, not a typedef for ldiv_t. They
// have the same shape on this target and are still different types, which is
// what C says and what a program overloading on the result would observe.
struct imaxdiv_t {
    intmax_t quot;
    intmax_t rem;
};

// P0533R9 made the C-library arithmetic constexpr in C++23; imaxabs and imaxdiv
// are in that set, so constexpr here satisfies [constexpr.functions] rather
// than stretching it.
inline constexpr intmax_t imaxabs(intmax_t j) { return j < 0 ? -j : j; }

inline constexpr imaxdiv_t imaxdiv(intmax_t numer, intmax_t denom)
{
    return imaxdiv_t{numer / denom, numer % denom};
}

} // namespace std

// ── conversions [cinttypes.syn] ─────────────────────────────────────────
// These forward to <cstdlib>'s parser rather than repeating it, and the
// forward is *provably* exact rather than merely plausible: the static_assert
// above pins intmax_t to long, which is the type strtol already returns. If
// that assumption ever stops holding the build stops with it, instead of this
// header silently narrowing a wider intmax_t through a long.
//
// wcstoimax/wcstoumax are the wide half of this synopsis and are absent with
// the rest of it: <cwchar> is deferred to the wide phase, so asking for them
// today is a compile error naming what is missing rather than a link failure
// at the end of the build. CONFORMANCE §2 records it.
namespace std {

inline intmax_t strtoimax(const char *nptr, char **endptr, int base) noexcept
{
    return ::std::strtol(nptr, endptr, base);
}

inline uintmax_t strtoumax(const char *nptr, char **endptr, int base) noexcept
{
    return ::std::strtoul(nptr, endptr, base);
}

} // namespace std

using std::imaxabs;
using std::imaxdiv;
