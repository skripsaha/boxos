template <class T = void>
struct plus {
    [[nodiscard]] constexpr T operator()(const T &a, const T &b) const
    { return a + b; }
};
template <>
struct plus<void> {
    template <class A, class B>
    [[nodiscard]] constexpr auto operator()(A &&a, B &&b) const
        noexcept(noexcept(forward<A>(a) + forward<B>(b)))
            -> decltype(forward<A>(a) + forward<B>(b))
    { return forward<A>(a) + forward<B>(b); }
    using is_transparent = void;
};

