// ── invoke / invoke_r ([func.invoke]) ───────────────────────────────────

namespace __bits {

template <class T> struct IsRefWrapper : false_type {};
template <class T> struct IsRefWrapper<reference_wrapper<T>> : true_type {};

template <class F, class... Args>
constexpr decltype(auto) InvokeRt(F &&f, Args &&...args) noexcept(
    is_nothrow_invocable_v<F, Args...>)
{
    using Fn = remove_cvref_t<F>;
    if constexpr (is_member_function_pointer_v<Fn>) {
        return [&]<class O, class... Rest>(
                   O &&o, Rest &&...rest) constexpr -> decltype(auto) {
            using OBare = remove_cvref_t<O>;
            if constexpr (IsRefWrapper<OBare>::value)
                return (o.get().*f)(forward<Rest>(rest)...);
            else if constexpr (requires {
                                   (static_cast<O &&>(o).*
                                    f)(forward<Rest>(rest)...);
                               })
                return (static_cast<O &&>(o).*f)(forward<Rest>(rest)...);
            else
                return ((*static_cast<O &&>(o)).*f)(forward<Rest>(rest)...);
        }(forward<Args>(args)...);
    } else if constexpr (is_member_object_pointer_v<Fn>) {
        static_assert(sizeof...(Args) == 1,
                      "data-member pointer takes exactly one operand");
        return [&]<class O>(O &&o) constexpr -> decltype(auto) {
            using OBare = remove_cvref_t<O>;
            if constexpr (IsRefWrapper<OBare>::value)
                return o.get().*f;
            else if constexpr (requires { static_cast<O &&>(o).*f; })
                return static_cast<O &&>(o).*f;
            else
                return (*static_cast<O &&>(o)).*f;
        }(forward<Args>(args)...);
    } else {
        return forward<F>(f)(forward<Args>(args)...);
    }
}

} // namespace __bits

template <class F, class... Args>
    requires is_invocable_v<F, Args...>
constexpr invoke_result_t<F, Args...>
invoke(F &&f, Args &&...args) noexcept(is_nothrow_invocable_v<F, Args...>)
{
    return __bits::InvokeRt(forward<F>(f), forward<Args>(args)...);
}

template <class R, class F, class... Args>
    requires is_invocable_r_v<R, F, Args...>
constexpr R invoke_r(F &&f, Args &&...args) noexcept(
    is_nothrow_invocable_r_v<R, F, Args...>)
{
    if constexpr (is_void_v<R>)
        __bits::InvokeRt(forward<F>(f), forward<Args>(args)...);
    else
        return __bits::InvokeRt(forward<F>(f), forward<Args>(args)...);
}

// ── reference_wrapper ───────────────────────────────────────────────────

template <class T>
class reference_wrapper {
    T *_target;

    static constexpr T *Bind(T &t) noexcept { return __builtin_addressof(t); }
    static void Bind(T &&) = delete;

public:
    using type = T;

    template <class U>
        requires(!is_same_v<remove_cvref_t<U>, reference_wrapper> &&
                 requires { Bind(declval<U>()); })
    constexpr reference_wrapper(U &&u) noexcept(
        noexcept(Bind(declval<U>())))
        : _target(Bind(forward<U>(u)))
    {
    }

    reference_wrapper(const reference_wrapper &) = default;
    reference_wrapper &operator=(const reference_wrapper &) = default;

    constexpr operator T &() const noexcept { return *_target; }
    [[nodiscard]] constexpr T &get() const noexcept { return *_target; }

    template <class... Args>
        requires is_invocable_v<T &, Args...>
    constexpr invoke_result_t<T &, Args...> operator()(Args &&...args) const
        noexcept(is_nothrow_invocable_v<T &, Args...>)
    {
        return __bits::InvokeRt(get(), forward<Args>(args)...);
    }
};

template <class T>
reference_wrapper(T &) -> reference_wrapper<T>;

template <class T>
[[nodiscard]] constexpr reference_wrapper<T> ref(T &t) noexcept
{
    return reference_wrapper<T>(t);
}
template <class T>
[[nodiscard]] constexpr reference_wrapper<T>
ref(reference_wrapper<T> t) noexcept
{
    return t;
}
template <class T> void ref(const T &&) = delete;

template <class T>
[[nodiscard]] constexpr reference_wrapper<const T> cref(const T &t) noexcept
{
    return reference_wrapper<const T>(t);
}
template <class T>
[[nodiscard]] constexpr reference_wrapper<const T>
cref(reference_wrapper<T> t) noexcept
{
    return reference_wrapper<const T>(t.get());
}
template <class T> void cref(const T &&) = delete;

} // namespace std

