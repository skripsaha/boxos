// ── ranges::less ([range.cmp]) ──────────────────────────────────────────
// The constrained comparison object that is the default predicate for the
// ranges algorithms and for the sortable/mergeable concepts (<iterator>).
// Unlike std::less it requires totally_ordered_with of the two operands and
// routes raw-pointer operands through std::less<common_type> — a bare
// operator< across unrelated pointers is unspecified, std::less<T*> is the
// standard's total-order hook.
namespace ranges {

struct less {
    template <class T, class U>
        requires totally_ordered_with<T, U>
    constexpr bool operator()(T &&a, U &&b) const
    {
        if constexpr (is_pointer_v<remove_reference_t<T>> &&
                      is_pointer_v<remove_reference_t<U>>)
            return std::less<common_type_t<remove_reference_t<T>,
                                           remove_reference_t<U>>>{}(
                std::forward<T>(a), std::forward<U>(b));
        else
            return std::forward<T>(a) < std::forward<U>(b);
    }
    using is_transparent = void;
};

// ── ranges::equal_to ([range.cmp]) ──────────────────────────────────────
// Default comparison for the ranges find/count/mismatch/equal/search/… family
// (Ф29b). Mirrors ranges::less minus the pointer-total-order branch —
// pointer equality needs no special case.
struct equal_to {
    template <class T, class U>
        requires equality_comparable_with<T, U>
    constexpr bool operator()(T &&t, U &&u) const
    {
        return std::forward<T>(t) == std::forward<U>(u);
    }
    using is_transparent = void;
};

// The remaining [range.cmp] objects. greater/less_equal/greater_equal are
// expressed through ranges::less so they inherit its pointer-total-order
// routing; not_equal_to negates ranges::equal_to. (Ф29b-2 — the natural
// comparators to hand the sorting / set / heap algorithms.)
struct not_equal_to {
    template <class T, class U>
        requires equality_comparable_with<T, U>
    constexpr bool operator()(T &&t, U &&u) const
    {
        return !equal_to{}(std::forward<T>(t), std::forward<U>(u));
    }
    using is_transparent = void;
};

struct greater {
    template <class T, class U>
        requires totally_ordered_with<T, U>
    constexpr bool operator()(T &&t, U &&u) const
    {
        return less{}(std::forward<U>(u), std::forward<T>(t));
    }
    using is_transparent = void;
};

struct less_equal {
    template <class T, class U>
        requires totally_ordered_with<T, U>
    constexpr bool operator()(T &&t, U &&u) const
    {
        return !less{}(std::forward<U>(u), std::forward<T>(t));
    }
    using is_transparent = void;
};

struct greater_equal {
    template <class T, class U>
        requires totally_ordered_with<T, U>
    constexpr bool operator()(T &&t, U &&u) const
    {
        return !less{}(std::forward<T>(t), std::forward<U>(u));
    }
    using is_transparent = void;
};

} // namespace ranges

// Gating concepts for heterogeneous lookup ([container.requirements] the
// Compare/Hash+KeyEqual "is_transparent" opt-in). Associative containers use
// these to constrain their template<class K> find/count/.../extract/erase
// overloads so a non-transparent comparator never enables them.
namespace __detail {

template <class C>
concept TransparentComparator = requires { typename C::is_transparent; };

template <class H, class E>
concept TransparentHashEq =
    requires { typename H::is_transparent; typename E::is_transparent; };

} // namespace __detail

// hash primary template — string specializations live in
// <string>/<string_view>; the scalar set is below.
template <class T> struct hash;

namespace __hash_impl {

// Mix sourced from splitmix64 — integral identity hashing clusters
// badly with power-of-two bucket counts.
constexpr size_t Mix(size_t x) noexcept
{
    x ^= x >> 30;
    x *= 0xbf58476d1ce4e5b9ull;
    x ^= x >> 27;
    x *= 0x94d049bb133111ebull;
    x ^= x >> 31;
    return x;
}

template <class T>
struct ScalarHash {
    size_t operator()(T v) const noexcept
    {
        return Mix(static_cast<size_t>(v));
    }
};

} // namespace __hash_impl

template <> struct hash<bool> : __hash_impl::ScalarHash<bool> {};
template <> struct hash<char> : __hash_impl::ScalarHash<char> {};
template <> struct hash<signed char> : __hash_impl::ScalarHash<signed char> {};
template <> struct hash<unsigned char>
    : __hash_impl::ScalarHash<unsigned char> {};
template <> struct hash<char8_t> : __hash_impl::ScalarHash<char8_t> {};
template <> struct hash<char16_t> : __hash_impl::ScalarHash<char16_t> {};
template <> struct hash<char32_t> : __hash_impl::ScalarHash<char32_t> {};
template <> struct hash<wchar_t> : __hash_impl::ScalarHash<wchar_t> {};
template <> struct hash<short> : __hash_impl::ScalarHash<short> {};
template <> struct hash<unsigned short>
    : __hash_impl::ScalarHash<unsigned short> {};
template <> struct hash<int> : __hash_impl::ScalarHash<int> {};
template <> struct hash<unsigned int> : __hash_impl::ScalarHash<unsigned int> {};
template <> struct hash<long> : __hash_impl::ScalarHash<long> {};
template <> struct hash<unsigned long>
    : __hash_impl::ScalarHash<unsigned long> {};
template <> struct hash<long long> : __hash_impl::ScalarHash<long long> {};
template <> struct hash<unsigned long long>
    : __hash_impl::ScalarHash<unsigned long long> {};

template <class T>
struct hash<T *> {
    size_t operator()(T *p) const noexcept
    {
        return __hash_impl::Mix(reinterpret_cast<size_t>(p));
    }
};
template <>
struct hash<decltype(nullptr)> {
    size_t operator()(decltype(nullptr)) const noexcept { return 0; }
};

template <>
struct hash<float> {
    size_t operator()(float v) const noexcept
    {
        if (v == 0.0f) v = 0.0f; // canonicalise -0.0
        unsigned int bits;
        __builtin_memcpy(&bits, &v, sizeof(bits));
        return __hash_impl::Mix(bits);
    }
};
template <>
struct hash<double> {
    size_t operator()(double v) const noexcept
    {
        if (v == 0.0) v = 0.0;
        size_t bits;
        __builtin_memcpy(&bits, &v, sizeof(bits));
        return __hash_impl::Mix(bits);
    }
};

