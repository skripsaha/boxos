// boxcxx — <stack>
// LIFO container adaptor: a thin wrapper over a Container (default
// deque<T>) exposing push/pop/top through the wrapped container's own
// back-end operations ([stack.syn]/[stack.defn]).
#ifndef BOXCXX_STACK
#define BOXCXX_STACK

#include <__bits/allocator_core>
#include <__bits/ranges_core>
#include <compare>
#include <cstddef>
#include <deque>
#include <type_traits>
#include <utility>

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_adaptor_iterator_pair_constructor
#define BOXCXX_OWNS_containers_ranges
#include <__bits/version_containers>

namespace std {

template <typename T, typename Container = deque<T>>
class stack {
public:
    using value_type      = typename Container::value_type;
    using reference       = typename Container::reference;
    using const_reference = typename Container::const_reference;
    using size_type       = typename Container::size_type;
    using container_type  = Container;

protected:
    Container c;

public:
    // ── lifecycle ───────────────────────────────────────────────────────

    constexpr stack() : stack(Container()) {}
    constexpr explicit stack(const Container &cont) : c(cont) {}
    constexpr explicit stack(Container &&cont) : c(std::move(cont)) {}
    template <typename InputIterator>
    constexpr stack(InputIterator first, InputIterator last) : c(first, last) {}
    template <ContainerCompatibleRange<T> R>
    constexpr stack(from_range_t, R &&rg) : c(from_range, std::forward<R>(rg)) {}

    template <typename Alloc>
        requires uses_allocator_v<Container, Alloc>
    constexpr explicit stack(const Alloc &a) : c(a) {}
    template <typename Alloc>
        requires uses_allocator_v<Container, Alloc>
    constexpr stack(const Container &cont, const Alloc &a) : c(cont, a) {}
    template <typename Alloc>
        requires uses_allocator_v<Container, Alloc>
    constexpr stack(Container &&cont, const Alloc &a) : c(std::move(cont), a) {}
    template <typename Alloc>
        requires uses_allocator_v<Container, Alloc>
    constexpr stack(const stack &other, const Alloc &a) : c(other.c, a) {}
    template <typename Alloc>
        requires uses_allocator_v<Container, Alloc>
    constexpr stack(stack &&other, const Alloc &a) : c(std::move(other.c), a) {}
    template <typename InputIterator, typename Alloc>
        requires uses_allocator_v<Container, Alloc>
    constexpr stack(InputIterator first, InputIterator last, const Alloc &a) : c(first, last, a) {}
    template <ContainerCompatibleRange<T> R, typename Alloc>
        requires uses_allocator_v<Container, Alloc>
    constexpr stack(from_range_t, R &&rg, const Alloc &a) : c(from_range, std::forward<R>(rg), a) {}

    // Copy/move ctor, destructor, copy/move assignment are all implicit --
    // Container c is the sole member, its own special members already do
    // the right thing.

    // ── observers / modifiers ───────────────────────────────────────────

    [[nodiscard]] constexpr bool empty() const { return c.empty(); }
    constexpr size_type size() const { return c.size(); }
    constexpr reference top() { return c.back(); }
    constexpr const_reference top() const { return c.back(); }

    constexpr void push(const value_type &x) { c.push_back(x); }
    constexpr void push(value_type &&x) { c.push_back(std::move(x)); }
    template <ContainerCompatibleRange<T> R>
    constexpr void push_range(R &&rg)
    {
        if constexpr (requires(Container &cc) { cc.append_range(std::forward<R>(rg)); })
            c.append_range(std::forward<R>(rg));
        else
            for (auto &&v : rg) c.push_back(std::forward<decltype(v)>(v));
    }
    template <typename... Args>
    constexpr decltype(auto) emplace(Args &&...args)
    {
        return c.emplace_back(std::forward<Args>(args)...);
    }
    constexpr void pop() { c.pop_back(); }
    constexpr void swap(stack &other) noexcept(is_nothrow_swappable_v<Container>)
    {
        using std::swap;
        swap(c, other.c);
    }

    // ── comparisons ([stack.ops]) — c is protected, so an out-of-class free
    //    operator cannot name x.c/y.c without friendship. Declared (not
    //    defined) here with FRESH template params (T1, Container1, not this
    //    class's own T/Container) and defined once, out-of-class, right
    //    below: a friend TEMPLATE that is both declared and DEFINED inside
    //    a class template is one namespace-scope entity per the standard,
    //    so defining it inline here would redefine that same entity every
    //    time stack<T,Container> is instantiated with a different Container
    //    in one translation unit (GCC rejects this as a redefinition,
    //    caught while building phase107's allocator tests, which
    //    instantiate stack<int,deque<int>> AND stack<int,deque<int,Alloc>>
    //    side by side) — declare-in-class/define-out-of-class avoids it,
    //    matching deque's/vector's own free-operator placement. ──────────

    template <typename T1, typename Container1>
    friend bool operator==(const stack<T1, Container1> &x, const stack<T1, Container1> &y);
    template <typename T1, typename Container1>
    friend bool operator!=(const stack<T1, Container1> &x, const stack<T1, Container1> &y);
    template <typename T1, typename Container1>
    friend bool operator<(const stack<T1, Container1> &x, const stack<T1, Container1> &y);
    template <typename T1, typename Container1>
    friend bool operator>(const stack<T1, Container1> &x, const stack<T1, Container1> &y);
    template <typename T1, typename Container1>
    friend bool operator<=(const stack<T1, Container1> &x, const stack<T1, Container1> &y);
    template <typename T1, typename Container1>
    friend bool operator>=(const stack<T1, Container1> &x, const stack<T1, Container1> &y);
    template <typename T1, three_way_comparable Container1>
    friend compare_three_way_result_t<Container1> operator<=>(const stack<T1, Container1> &x,
                                                               const stack<T1, Container1> &y);
};

template <typename T, typename Container>
bool operator==(const stack<T, Container> &x, const stack<T, Container> &y)
{
    return x.c == y.c;
}
template <typename T, typename Container>
bool operator!=(const stack<T, Container> &x, const stack<T, Container> &y)
{
    return !(x.c == y.c);
}
template <typename T, typename Container>
bool operator<(const stack<T, Container> &x, const stack<T, Container> &y)
{
    return x.c < y.c;
}
template <typename T, typename Container>
bool operator>(const stack<T, Container> &x, const stack<T, Container> &y)
{
    return y.c < x.c;
}
template <typename T, typename Container>
bool operator<=(const stack<T, Container> &x, const stack<T, Container> &y)
{
    return !(y.c < x.c);
}
template <typename T, typename Container>
bool operator>=(const stack<T, Container> &x, const stack<T, Container> &y)
{
    return !(x.c < y.c);
}
template <typename T, three_way_comparable Container>
compare_three_way_result_t<Container> operator<=>(const stack<T, Container> &x, const stack<T, Container> &y)
{
    return x.c <=> y.c;
}

template <typename T, typename Container, typename Alloc>
struct uses_allocator<stack<T, Container>, Alloc> : uses_allocator<Container, Alloc>::type {};

// ── deduction guides ([stack.deduct]) ────────────────────────────────────

template <NotAllocatorLike Container>
stack(Container) -> stack<typename Container::value_type, Container>;

template <typename InputIterator>
stack(InputIterator, InputIterator) -> stack<iter_value_t<InputIterator>>;

template <ranges::input_range R>
stack(from_range_t, R &&) -> stack<ranges::range_value_t<R>>;

template <NotAllocatorLike Container, AllocatorLike Allocator>
    requires uses_allocator_v<Container, Allocator>
stack(Container, Allocator) -> stack<typename Container::value_type, Container>;

template <typename InputIterator, AllocatorLike Allocator>
stack(InputIterator, InputIterator, Allocator)
    -> stack<iter_value_t<InputIterator>, deque<iter_value_t<InputIterator>, Allocator>>;

template <ranges::input_range R, AllocatorLike Allocator>
stack(from_range_t, R &&, Allocator)
    -> stack<ranges::range_value_t<R>, deque<ranges::range_value_t<R>, Allocator>>;

template <typename T, typename Container>
void swap(stack<T, Container> &x, stack<T, Container> &y) noexcept(noexcept(x.swap(y)))
{
    x.swap(y);
}

} // namespace std

#endif // BOXCXX_STACK
