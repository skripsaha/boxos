// __bits/chrono_zone — [time.zone]: time zones, zoned_time, leap seconds.
// Included by <chrono>.
//
// This leaf is deliberately THIN. Every question that needs the baked IANA
// table goes through the four functions in `__detail` below, which are defined
// in src/runtime/tzdb.cpp — the only translation unit in the library that
// includes <__bits/tzdb_table>. That is what keeps the promise the table was
// designed around: 116 KB of zone data lands in the image only for a program
// that actually asks a zone something. A program that includes <chrono> for
// durations pays nothing, because nothing it references pulls that object out
// of the archive.
//
// The reader those functions call is <__bits/tzdb_read>, which speaks seconds
// and `const char*` and no std types at all, so it can be — and is — compiled
// on a development host and measured against libstdc++ and against zdump over
// nine hundred thousand instants. What lives HERE is the shape the standard
// asks for: the strings, the vectors, the exceptions and zoned_time.
#ifndef BOXCXX_BITS_CHRONO_ZONE
#define BOXCXX_BITS_CHRONO_ZONE

#include <__bits/chrono_calendar>
#include <__bits/chrono_clock>
#include <__bits/chrono_duration>
#include <compare>
#include <stdexcept>
#include <string>
#include <string_view>
#include <type_traits>
#include <vector>

namespace std {
namespace chrono {

