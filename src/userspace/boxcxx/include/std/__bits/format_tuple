// boxcxx — <__bits/format_tuple>  ([format.tuple])
//
// formatter<pair<T1,T2>,char> and formatter<tuple<Ts...>,char>. Included
// from the bottom of <format>, after <__bits/format_range>: it reuses
// format_range's HasSetDebugFormat probe and needs format_context,
// EmitField and StringSink already complete, same as format_range itself.
//
// The standard's synopsis writes one exposition-only "pair-or-tuple<Ts...>"
// template for both pair and tuple; there is no such template in real C++
// (pair is not variadic), so this file is two real partial specializations
// sharing one implementation, __format::TupleFormatterBase.
//
// [format.tuple]'s grammar has no range-underlying-spec and no precision --
// tuple-type is a single optional token, 'm' or 'n', never both. That is
// why 'n' here just clears opening-bracket_/closing-bracket_ directly, with
// no separate suppression flag: [format.range]'s own 'n' had a write-time-
// suppression-vs-parse-time-clear bug precisely because it kept such a
// flag, and this design has no flag for that bug to hide behind.
//
// No CharT template parameter: like every scalar/string formatter in this
// file (and unlike range_formatter, which the standard exposes as a public
// utility for OTHER programs' formatters to reuse with any charT), this
// specialization is never named by user code with a charT other than char
// -- boxcxx has no wchar_t formatting anywhere, so a CharT parameter here
// would be decorative only.
#ifndef BOXCXX_BITS_FORMAT_TUPLE
#define BOXCXX_BITS_FORMAT_TUPLE

#include <format>
#include <tuple>
#include <utility>

namespace std {
namespace __format {

// Self is the exact pair<T1,T2> or tuple<Ts...> instantiation (needed only
// to name format()'s parameter type per [format.tuple]/9); Ts... is that
// same type's element pack.
template <class Self, class... Ts>
class TupleFormatterBase {
public:
    constexpr void set_separator(string_view sep) noexcept { sep_ = sep; }
    constexpr void set_brackets(string_view open, string_view close) noexcept
    {
        open_  = open;
        close_ = close;
    }

    // Grammar (/2): [tuple-fill-and-align][width][m|n] -- nothing else.
    constexpr format_parse_context::iterator parse(format_parse_context &pc)
    {
        const char *p = pc.begin();
        const char *e = pc.end();
        auto finished = [&] { return p == e || *p == '}'; };
        auto commit   = [&] {
            pc.advance_to(p);
            ParseElems(index_sequence_for<Ts...>{});
            return p;
        };

        // Empty spec first, before any p+1 arithmetic: pc may legitimately
        // be built over a default-constructed string_view (data()==
        // nullptr) -- exactly how /7 parses "an empty format-spec" for
        // each element below, and how a nested tuple or a tuple-valued
        // range element reaches this parse() for real.
        if (finished()) return commit();

        // tuple-fill-and-align: the fill detector also excludes ':' --
        // there is no production starting with ':' anywhere in
        // tuple-format-spec, so a stray one (e.g. from "{0::>5}", which is
        // literally what the engine hands us once it strips the field's
        // OWN introducing colon) must fall through to "invalid" below
        // rather than being swallowed as a fill character.
        if (p + 1 < e && IsAlignChar(p[1]) && *p != '{' && *p != '}' &&
            *p != ':') {
            spec_.fill  = *p;
            spec_.align = AlignOf(p[1]);
            p += 2;
        } else if (p != e && IsAlignChar(*p)) {
            spec_.align = AlignOf(*p);
            ++p;
        }
        if (finished()) return commit();

        // width -- a leading '0' has no production here either, which
        // ParseWidth already enforces along with the field limit.
        if (IsDigit(*p)) {
            spec_.width = ParseWidth(p, e);
        } else if (*p == '{') {
            spec_.width_id      = ParseDynamicArgId(pc, p, e);
            spec_.width_dynamic = true;
            pc.check_dynamic_spec_integral(spec_.width_id);
        }
        if (finished()) return commit();

        // tuple-type: m | n, exactly one, never both. Table 116's Effects
        // land directly on separator_/opening-bracket_/closing-bracket_,
        // so a member is only ever touched when its row requires it --
        // /7's "if and only if required by the tuple-type, if present".
        if (*p == 'm') {
            if constexpr (sizeof...(Ts) == 2) {
                set_separator(": ");
                set_brackets(string_view(), string_view());
                ++p;
            } else {
                throw format_error(
                    "format: 'm' requires a pair or a two-element tuple");
            }
        } else if (*p == 'n') {
            set_brackets(string_view(), string_view());
            ++p;
        }

        if (!finished())
            throw format_error("format: invalid tuple-format-spec");
        return commit();
    }

    // /9: elems is const Self& when every element is const-formattable,
    // otherwise Self& -- the same P2418 selection applied per element
    // instead of to a single format argument.
    using ElemsRef = conditional_t<(formattable<const Ts, char> && ...),
                                   const Self &, Self &>;

    void format(ElemsRef elems, format_context &ctx) const
    {
        if (spec_.width < 0 && !spec_.width_dynamic) {
            FormatBody(elems, ctx);
            return;
        }
        const int      width = EffectiveWidth(ctx, spec_);
        StringSink     scratch;
        format_context nested(SinkIterator(scratch), ctx.__args());
        FormatBody(elems, nested);
        EmitField(ctx, spec_, width, string_view(),
                 string_view(scratch.str.data(), scratch.str.size()),
                 Align::Left, /*numeric=*/false);
    }

private:
    template <size_t... Is>
    constexpr void ParseElems(index_sequence<Is...>)
    {
        (ParseOneElem<Is>(), ...);
    }

    // /7: each element parses an EMPTY format-spec, unconditionally, then
    // arms its debug marker if it has one -- regardless of what tuple-type
    // (if any) this level of the tuple saw. set_debug_format() runs after
    // parse(), never before -- the only order every formatter here can
    // even tell apart.
    //
    // The empty spec is a FRESH context, not the live one. /7 says only
    // "calls e.parse(ctx) to parse an empty format-spec" and the two
    // reference libraries read that differently: libstdc++ hands over a
    // fresh empty context, libc++ the live one (so next_arg_id() there sees
    // the outer field's argument numbering, and end()-begin() is not even
    // zero). Both cannot be right; boxcxx matches libstdc++, which is the
    // reading where an element formatter cannot reach past the empty spec
    // it was told it is parsing. The difference is only observable through
    // an element formatter that calls next_arg_id() from parse(), which no
    // formatter here does -- an empty spec never contains a '{'.
    template <size_t I>
    constexpr void ParseOneElem()
    {
        format_parse_context pc(string_view(), 0);
        auto                &f  = get<I>(underlying_);
        auto                 it = f.parse(pc);
        if (it != pc.end())
            throw format_error(
                "format: tuple element default format-spec invalid");
        if constexpr (HasSetDebugFormat<remove_cvref_t<decltype(f)>>)
            f.set_debug_format();
    }

    void FormatBody(ElemsRef elems, format_context &ctx) const
    {
        auto out     = ctx.out();
        auto writeSv = [&](string_view s) {
            if (!s.empty()) WriteRun(out, s.data(), s.size());
        };
        writeSv(open_);
        ctx.advance_to(out);
        FormatElems(elems, ctx, index_sequence_for<Ts...>{});
        out = ctx.out();
        writeSv(close_);
        ctx.advance_to(out);
    }

    template <size_t... Is>
    void FormatElems(ElemsRef elems, format_context &ctx,
                     index_sequence<Is...>) const
    {
        (WriteElem<Is>(elems, ctx), ...);
    }

    // /10: "if I != 0, separator_" -- a compile-time check, so the
    // separator can never be written before the first element.
    template <size_t I>
    void WriteElem(ElemsRef elems, format_context &ctx) const
    {
        if constexpr (I != 0) {
            auto out = ctx.out();
            if (!sep_.empty()) WriteRun(out, sep_.data(), sep_.size());
            ctx.advance_to(out);
        }
        get<I>(underlying_).format(get<I>(elems), ctx);
    }

    StdSpec                                       spec_;
    string_view                                   sep_   = ", ";
    string_view                                   open_  = "(";
    string_view                                   close_ = ")";
    tuple<formatter<remove_cvref_t<Ts>, char>...> underlying_;
};

} // namespace __format

template <class T1, class T2>
    requires formattable<T1, char> && formattable<T2, char>
struct formatter<pair<T1, T2>, char>
    : __format::TupleFormatterBase<pair<T1, T2>, T1, T2> {
};

template <class... Ts>
    requires(formattable<Ts, char> && ...)
struct formatter<tuple<Ts...>, char>
    : __format::TupleFormatterBase<tuple<Ts...>, Ts...> {
};

// [format.tuple] — the other subclause that "specifies otherwise" for
// enable_nonlocking_formatter_optimization: a tuple is as nonlocking as its
// least nonlocking element, not flatly true and not flatly false. Two
// specializations for the same reason the formatters are two — the synopsis
// writes one over the exposition-only pair-or-tuple, and pair is not variadic.
// libc++ answers false for pair<int,int>, which this contradicts on purpose.
template <class T1, class T2>
inline constexpr bool enable_nonlocking_formatter_optimization<pair<T1, T2>> =
    enable_nonlocking_formatter_optimization<remove_cvref_t<T1>> &&
    enable_nonlocking_formatter_optimization<remove_cvref_t<T2>>;

template <class... Ts>
inline constexpr bool enable_nonlocking_formatter_optimization<tuple<Ts...>> =
    (enable_nonlocking_formatter_optimization<remove_cvref_t<Ts>> && ...);

} // namespace std

#endif // BOXCXX_BITS_FORMAT_TUPLE
