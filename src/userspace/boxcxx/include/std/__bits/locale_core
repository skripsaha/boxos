};

inline locale::id codecvt<char32_t, char8_t, mbstate_t>::id{__cvt::kIdCodecvtChar32};

// ── codecvt_byname [locale.codecvt.byname] ──────────────────────────────
// A _byname facet is the facet of a NAMED locale, and there is one name here.
// So this validates the name and is otherwise its base: codecvt_byname("C") is
// UTF-8 because that is what "C" means on this system, and
// codecvt_byname("ru_RU.KOI8-R") throws rather than quietly producing UTF-8.
//
// It shares its base's locale::id, which is what makes it useful: install one
// and use_facet<codecvt<wchar_t, char, mbstate_t>> finds it, exactly as
// [locale.facet]/4 describes.
template <class InternT, class ExternT, class StateT>
class codecvt_byname : public codecvt<InternT, ExternT, StateT> {
public:
    explicit codecvt_byname(const char *name, size_t refs = 0)
        : codecvt<InternT, ExternT, StateT>(refs)
    {
        if (!__loc::IsClassicName(name)) __loc::ThrowUnknownLocale(name);
    }
    explicit codecvt_byname(const string &name, size_t refs = 0)
        : codecvt_byname(name.c_str(), refs)
    {
    }

protected:
    ~codecvt_byname() = default;
};

// ── where a facet the image carries lives ───────────────────────────────
// Deriving is what reaches the protected destructor, and `final` is what stops
// anyone reaching further. refs is 1: the image owns these, no locale does.
template <class Facet>
class __FacetHome final : public Facet {
public:
    constexpr __FacetHome() noexcept : Facet(1) {}
};

// ── has_facet / use_facet [locale.convenience] ──────────────────────────
// Both are genuine table lookups now. Until Ф43, use_facet<F> for a facet this
// image did not carry was a COMPILE error — the set was fixed at link time, so
// the question could be answered then. It cannot be any more: a program can
// install a facet at run time, so the answer is bad_cast, which is what
// [locale.convenience] says it should have been all along.
template <class Facet>
bool has_facet(const locale &loc) noexcept
{
    return loc.__at(Facet::id.__index()) != nullptr;
}

template <class Facet>
const Facet &use_facet(const locale &loc)
{
    const locale::facet *f = loc.__at(Facet::id.__index());
    if (f == nullptr) __loc::ThrowBadCast();
    return static_cast<const Facet &>(*f);
}

// ── installing a facet [locale.cons] ────────────────────────────────────
template <class Facet>
locale::locale(const locale &other, Facet *f) : __table(other.__table)
{
    if (f == nullptr) {         // [locale.cons]: a null facet leaves the
        __table->__acquire();   // locale as a copy of other
        return;
    }
    __table = __Table::__with_facet(other.__table, Facet::id.__index(), f);
}

template <class Facet>
locale locale::combine(const locale &other) const
{
    const facet *f = other.__at(Facet::id.__index());
    if (f == nullptr) __loc::ThrowNoSuchFacet();
    // The facet is refcounted individually, so the result keeps it alive
    // whatever happens to `other` — which is the whole reason the count lives
    // in the facet rather than in the table.
    return locale(__Table::__with_facet(__table, Facet::id.__index(), f));
}

