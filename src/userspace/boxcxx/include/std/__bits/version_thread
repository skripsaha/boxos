// boxcxx — <__bits/version_thread>
//
// The feature-test macro [version.syn] owned jointly by <stop_token> and
// <thread>: jthread plus the whole stop_token/stop_source/stop_callback
// surface and condition_variable_any's stop_token overloads. Both headers
// include this leaf.
//
// It also carries __cpp_lib_formatters, which [version.syn] gives jointly to
// <stacktrace> and <thread>: P2693R1 is formatter<thread::id, charT> AND
// formatter<stacktrace_entry>/formatter<basic_stacktrace<A>>, two unrelated
// formatters under one macro. It stayed on <version>'s "deliberately not
// defined" list until Ф42-g for a reason that named exactly one missing piece
// -- the WIDE half of the thread one -- and that piece now exists.
//
// Every block below is gated on BOXCXX_OWNS_<stem>, and this file has NO
// include guard: it is meant to be included once per owning header, each time
// defining only what that header declared it owns. [support.limits.general]
// says a macro is defined by <version> AND by the header that provides the
// feature; it does not say every header that happens to include this leaf.
// A header that answers for a feature it does not provide is answering a
// question it was not asked, so it no longer does. <version> defines
// BOXCXX_OWNS_ALL and takes the lot. Checked by tools/cxx_ftm_audit.sh.

#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_jthread)) && \
    !defined(__cpp_lib_jthread)
#  define __cpp_lib_jthread 201911L
#endif
#undef BOXCXX_OWNS_jthread
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_formatters)) && \
    !defined(__cpp_lib_formatters)
#  define __cpp_lib_formatters 202302L
#endif
#undef BOXCXX_OWNS_formatters
