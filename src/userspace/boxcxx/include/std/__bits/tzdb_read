// boxcxx — <__bits/tzdb_read>
//
// The reader for the generated table in <__bits/tzdb_table>. Hand-written, and
// deliberately free of every std type: it speaks seconds as `long long` and
// names as `const char*`, so the same file compiles on the host against no
// library at all. That is not a style choice — it is what lets the host stand
// compile THIS code and compare it against libstdc++ and zoneinfo in a second,
// instead of against a boot log in seven minutes.
//
// <__bits/chrono_zone> is what turns these integers into `sys_info`,
// `local_info`, `time_zone` and `zoned_time`.
//
// ── The bytes ───────────────────────────────────────────────────────────────
// Everything is little-endian; the table is generated by tools/gen_tzdb.py,
// whose preamble records why it is shaped this way and what it refuses to
// write. Offsets in the header are from the start of the table.
//
//   header, 44 bytes
//     char     magic[8]      "BOXTZDB1"
//     u32      version_off   into the string pool
//     u32      n_names       every Zone AND every Link
//     u32      n_bodies      distinct transition sets; Links share one
//     u32      n_leaps
//     u32      off_names, off_bodytab, off_leaps, off_saves, off_pool
//   name index, sorted by name, n_names x 8 bytes
//     u32 name_off  u16 body  u16 link_target   (0xFFFF when not a Link)
//   body offset table, n_bodies x u32
//   leap seconds, n_leaps x 16 bytes: i64 when, i32 value, i32 pad
//   save table, 16 x i32           the 13 distinct DST amounts, indexed
//   bodies:
//     u16 n_types  u16 n_trans  u32 posix_off
//     types: n_types x { i32 utoff, u16 abbrev_off, u8 isdst, u8 pad }
//     u32 varint_bytes
//     transition times: n_trans zigzag varints, each a delta from the last
//     transition codes: n_trans bytes, low nibble type, high nibble save index
//   string pool, NUL-terminated, offset 0 is the empty string
//
// Transitions are varints, so they are walked, not binary-searched. That is a
// measured choice and not a compromise: no zone has more than 310 transitions
// and the average is 49, so the walk is a few dozen additions inside one cache
// line's worth of stride — cheaper than the misses a random-access table of
// 133 KB of 8-byte timestamps would buy, and 67 KB smaller.
//
// ── Past the last transition ────────────────────────────────────────────────
// Every body ends with a POSIX TZ footer (all 341 in 2026c have one), and it —
// not the transition list — is what answers for the future. `zic -b slim`
// leaves the recurring transitions out precisely because the footer regenerates
// them, and unlike a table that stops at 2037 it keeps doing so.
#ifndef BOXCXX_BITS_TZDB_READ
#define BOXCXX_BITS_TZDB_READ

#include <__bits/civil_days>
#include <__bits/tzdb_table>

namespace std::__boxcxx::tzdata {

inline constexpr int       kNoLink     = -1;
inline constexpr long long kBeginning  = -4611686018427387904LL;  // -2^62
inline constexpr long long kForever    =  4611686018427387904LL;  //  2^62
inline constexpr unsigned  kAbbrevMax  = 16;   // measured longest in 2026c: 5

struct Info {
    long long begin;      // [begin, end), in sys seconds
    long long end;
    int       offset;     // seconds east of UTC
    int       save;       // the DST amount inside `offset`, 0 when standard
    char      abbrev[kAbbrevMax];
};

enum class LocalResult { unique, nonexistent, ambiguous };

// ── raw little-endian reads ─────────────────────────────────────────────────

constexpr unsigned U16(const unsigned char *p) noexcept
{
    return unsigned(p[0]) | (unsigned(p[1]) << 8);
}

constexpr unsigned U32(const unsigned char *p) noexcept
{
    return unsigned(p[0]) | (unsigned(p[1]) << 8) | (unsigned(p[2]) << 16)
         | (unsigned(p[3]) << 24);
}

constexpr int I32(const unsigned char *p) noexcept
{
    return static_cast<int>(U32(p));
}

constexpr long long I64(const unsigned char *p) noexcept
{
    unsigned long long v = 0;
    for (int i = 7; i >= 0; --i) v = (v << 8) | p[i];
    return static_cast<long long>(v);
}

// ── the table, as a value ───────────────────────────────────────────────────
//
// A `Table` is a base pointer and the header read from it. Nothing below this
// point mentions kTable, and that is precisely what the TagFS door needs: the
// table baked into the image is one Table, a table laid behind the door is
// another, and both must be readable AT ONCE, because
// [time.zone.db.remote]/3 requires every time_zone handed out before a
// reload_tzdb() to keep answering correctly after it.

struct Head {
    unsigned version_off, n_names, n_bodies, n_leaps;
    unsigned off_names, off_bodytab, off_leaps, off_saves, off_pool;
};

constexpr Head ReadHead(const unsigned char *b) noexcept
{
    Head h{};
    h.version_off = U32(b + 8);
    h.n_names     = U32(b + 12);
    h.n_bodies    = U32(b + 16);
    h.n_leaps     = U32(b + 20);
    h.off_names   = U32(b + 24);
    h.off_bodytab = U32(b + 28);
    h.off_leaps   = U32(b + 32);
    h.off_saves   = U32(b + 36);
    h.off_pool    = U32(b + 40);
    return h;
}

struct Table {
    const unsigned char *base;
    Head                 head;
};

constexpr Table Bind(const unsigned char *base) noexcept
{
    return Table{base, ReadHead(base)};
}

// The table compiled into the image. Still constexpr, so a question asked of
// it at compile time still folds to an answer at compile time.
inline constexpr Table kBaked = Bind(kTable);

constexpr const char *Pooled(const Table &t, unsigned off) noexcept
{
    return reinterpret_cast<const char *>(t.base + t.head.off_pool + off);
}

constexpr const char *Version(const Table &t) noexcept
{
    return Pooled(t, t.head.version_off);
}

constexpr int NameCount(const Table &t) noexcept
{
    return static_cast<int>(t.head.n_names);
}

constexpr int LeapCount(const Table &t) noexcept
{
    return static_cast<int>(t.head.n_leaps);
}

constexpr const unsigned char *NameEntry(const Table &t, int i) noexcept
{
    return t.base + t.head.off_names + unsigned(i) * 8;
}

constexpr const char *NameAt(const Table &t, int i) noexcept
{
    return Pooled(t, U32(NameEntry(t, i)));
}

constexpr int BodyOf(const Table &t, int i) noexcept
{
    return int(U16(NameEntry(t, i) + 4));
}

constexpr int LinkTarget(const Table &t, int i) noexcept
{
    const unsigned x = U16(NameEntry(t, i) + 6);
    return x == 0xFFFFu ? kNoLink : int(x);
}

constexpr void LeapAt(const Table &t, int i, long long &when, int &value) noexcept
{
    const unsigned char *p = t.base + t.head.off_leaps + unsigned(i) * 16;
    when  = I64(p);
    value = I32(p + 8);
}

// ── names ───────────────────────────────────────────────────────────────────

constexpr int Compare(const char *a, const char *b, unsigned bn) noexcept
{
    for (unsigned i = 0; i < bn; ++i) {
        const unsigned char x = static_cast<unsigned char>(a[i]);
        const unsigned char y = static_cast<unsigned char>(b[i]);
        if (x != y) return x < y ? -1 : 1;
        if (x == 0) return 0;                 // both ended
    }
    return a[bn] == '\0' ? 0 : 1;             // a is longer
}

// Binary search over the sorted name index. Returns the name index or kNoLink.
constexpr int Find(const Table &t, const char *name, unsigned len) noexcept
{
    int lo = 0, hi = NameCount(t);
    while (lo < hi) {
        const int mid = lo + (hi - lo) / 2;
        const int c = Compare(NameAt(t, mid), name, len);
        if (c == 0) return mid;
        if (c < 0) lo = mid + 1; else hi = mid;
    }
    return kNoLink;
}

// ── bodies ──────────────────────────────────────────────────────────────────

struct Body {
    unsigned n_types, n_trans;
    const unsigned char *types;
    const unsigned char *times;   // varint run
    const unsigned char *codes;
    const char *posix;
};

constexpr Body BodyAt(const Table &t, int j) noexcept
{
    const unsigned at = U32(t.base + t.head.off_bodytab + unsigned(j) * 4);
    const unsigned char *p = t.base + at;
    Body b{};
    b.n_types = U16(p);
    b.n_trans = U16(p + 2);
    b.posix   = Pooled(t, U32(p + 4));
    b.types   = p + 8;
    const unsigned char *q = b.types + b.n_types * 8;
    const unsigned varint_bytes = U32(q);
    b.times = q + 4;
    b.codes = b.times + varint_bytes;
    return b;
}

struct Type { int utoff; unsigned abbrev_off; bool isdst; };

constexpr Type TypeAt(const Body &b, unsigned i) noexcept
{
    const unsigned char *p = b.types + i * 8;
    return Type{I32(p), U16(p + 4), p[6] != 0};
}

constexpr int SaveAt(const Table &t, unsigned idx) noexcept
{
    return I32(t.base + t.head.off_saves + idx * 4);
}

constexpr void CopyAbbrev(char (&dst)[kAbbrevMax], const char *src) noexcept
{
    unsigned i = 0;
    for (; src[i] && i + 1 < kAbbrevMax; ++i) dst[i] = src[i];
    dst[i] = '\0';
}

// The local-time type in force before the first transition: TZif says the
// first type that is not DST, and type 0 when a zone has none.
constexpr unsigned FirstType(const Body &b) noexcept
{
    for (unsigned i = 0; i < b.n_types; ++i)
        if (!TypeAt(b, i).isdst) return i;
    return 0;
}

// Walk the varint run to the last transition at or before `t`.
// Returns the number of transitions consumed (0 == before the first).
struct Walk { unsigned count; long long at; long long next; unsigned code; };

constexpr Walk WalkTo(const Body &b, long long t) noexcept
{
    Walk w{0, kBeginning, kForever, 0};
    const unsigned char *p = b.times;
    long long cur = 0;
    for (unsigned i = 0; i < b.n_trans; ++i) {
        unsigned long long v = 0;
        unsigned shift = 0;
        for (;;) {
            const unsigned char byte = *p++;
            v |= (unsigned long long)(byte & 0x7F) << shift;
            shift += 7;
            if (byte < 0x80) break;
        }
        const long long d = static_cast<long long>((v >> 1) ^ (~(v & 1) + 1));
        cur += d;
        if (cur <= t) {
            w.count = i + 1;
            w.at    = cur;
            w.code  = b.codes[i];
        } else {
            w.next = cur;
            break;
        }
    }
    return w;
}

// ── the POSIX footer ────────────────────────────────────────────────────────
//
// std-name offset [dst-name [offset]] [,start[/time],end[/time]]
// Offsets are POSIX-signed (west of Greenwich is positive), so they are negated
// on the way in. Times are NOT bounded to a day: 2026c carries -1, 22, 24, 26
// and 50 as transition hours, and a parser that clamped to 0..23 would be
// wrong on real data rather than on a hypothetical.

struct Rule {
    enum Kind { kMonthWeekDay, kJulianNoLeap, kJulianWithLeap } kind;
    int m, w, d;        // Mm.w.d
    int n;              // Jn or n
    long long time;     // seconds after local midnight, default 02:00:00
};

struct Footer {
    bool ok;
    bool has_dst;
    char std_abbrev[kAbbrevMax];
    char dst_abbrev[kAbbrevMax];
    int  std_off;       // seconds east of UTC
    int  dst_off;
    Rule start, end;
};

constexpr bool IsDigit(char c) noexcept { return c >= '0' && c <= '9'; }

// Consume a digit run into `out`, refusing to let it grow past `cap`.
//
// The cap is not tidiness. Past the TagFS door these parsers are handed
// whatever bytes are in the pool, and `v = v * 10 + d` over a forty-digit run
// is signed overflow — undefined behaviour in the library, reached through a
// file anybody can write. The digits are consumed either way, so the parse
// position stays correct on a string that was never a footer; only the value
// stops climbing. Every cap below sits orders of magnitude above the largest
// value real tzdata carries, so no table IANA has ever shipped notices.
constexpr const char *Digits(const char *p, long long &out,
                             long long cap) noexcept
{
    long long v = 0;
    while (IsDigit(*p)) {
        if (v <= cap) v = v * 10 + (*p - '0');
        ++p;
    }
    out = v > cap ? cap : v;
    return p;
}

// 2026c's largest footer hour is 50; a million is refusal, not rounding.
inline constexpr long long kDigitCap = 1000000;

constexpr const char *ParseAbbrev(const char *p, char (&out)[kAbbrevMax]) noexcept
{
    unsigned i = 0;
    if (*p == '<') {
        ++p;
        while (*p && *p != '>' && i + 1 < kAbbrevMax) out[i++] = *p++;
        if (*p == '>') ++p;
    } else {
        while (((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z'))
               && i + 1 < kAbbrevMax)
            out[i++] = *p++;
    }
    out[i] = '\0';
    return p;
}

// [+-]hh[:mm[:ss]] — hh is not bounded to 24.
constexpr const char *ParseOffset(const char *p, long long &secs) noexcept
{
    int sign = 1;
    if (*p == '+') ++p;
    else if (*p == '-') { sign = -1; ++p; }
    long long h = 0, m = 0, s = 0;
    p = Digits(p, h, kDigitCap);
    if (*p == ':') { ++p; p = Digits(p, m, kDigitCap); }
    if (*p == ':') { ++p; p = Digits(p, s, kDigitCap); }
    secs = sign * (h * 3600 + m * 60 + s);
    return p;
}

constexpr const char *ParseRule(const char *p, Rule &r) noexcept
{
    r = Rule{Rule::kMonthWeekDay, 0, 0, 0, 0, 2 * 3600};
    long long v = 0;
    // A month, a week and a weekday are 1..12, 1..5 and 0..6; a thousand is
    // already nonsense, and it keeps RuleDay's month walk short.
    if (*p == 'M') {
        ++p;
        r.kind = Rule::kMonthWeekDay;
        p = Digits(p, v, 1000); r.m = static_cast<int>(v);
        if (*p == '.') ++p;
        p = Digits(p, v, 1000); r.w = static_cast<int>(v);
        if (*p == '.') ++p;
        p = Digits(p, v, 1000); r.d = static_cast<int>(v);
    } else if (*p == 'J') {
        ++p;
        r.kind = Rule::kJulianNoLeap;
        p = Digits(p, v, kDigitCap); r.n = static_cast<int>(v);
    } else {
        r.kind = Rule::kJulianWithLeap;
        p = Digits(p, v, kDigitCap); r.n = static_cast<int>(v);
    }
    if (*p == '/') {
        ++p;
        long long t = 0;
        p = ParseOffset(p, t);
        r.time = t;
    }
    return p;
}

constexpr Footer ParseFooter(const char *p) noexcept
{
    Footer f{};
    f.ok = false;
    if (!p || !*p) return f;
    p = ParseAbbrev(p, f.std_abbrev);
    if (f.std_abbrev[0] == '\0') return f;
    long long o = 0;
    p = ParseOffset(p, o);
    f.std_off = static_cast<int>(-o);          // POSIX counts west as positive
    f.dst_off = f.std_off;
    if (*p && *p != ',') {
        p = ParseAbbrev(p, f.dst_abbrev);
        f.has_dst = f.dst_abbrev[0] != '\0';
        if (*p && *p != ',') {
            p = ParseOffset(p, o);
            f.dst_off = static_cast<int>(-o);
        } else {
            f.dst_off = f.std_off + 3600;      // POSIX: one hour if unstated
        }
    }
    if (*p == ',') {
        ++p;
        p = ParseRule(p, f.start);
        if (*p == ',') ++p;
        p = ParseRule(p, f.end);
    } else if (f.has_dst) {
        return f;                              // DST named with no rule: unusable
    }
    f.ok = true;
    return f;
}

// The local-midnight day number the rule names, in year `y`.
constexpr long long RuleDay(const Rule &r, long long y) noexcept
{
    using namespace civil;
    if (r.kind == Rule::kMonthWeekDay) {
        const long long first = days_from_civil(y, unsigned(r.m), 1);
        const unsigned  wd    = weekday_from_days(first);
        long long day = first + ((unsigned(r.d) + 7u - wd) % 7u);
        day += (long long)(r.w - 1) * 7;
        // w == 5 means "the last such weekday in the month"
        long long ylast = y; unsigned mlast = unsigned(r.m) + 1;
        if (mlast > 12) { mlast = 1; ++ylast; }
        const long long next_month = days_from_civil(ylast, mlast, 1);
        while (day >= next_month) day -= 7;
        return day;
    }
    if (r.kind == Rule::kJulianNoLeap) {
        // 1..365, and February 29 is never counted
        long long day = days_from_civil(y, 1, 1) + (r.n - 1);
        if (r.n >= 60 && is_leap(y)) day += 1;
        return day;
    }
    return days_from_civil(y, 1, 1) + r.n;     // 0..365, leap day counted
}

// The instant the rule fires in year `y`, in sys seconds.
constexpr long long RuleInstant(const Rule &r, long long y, int off) noexcept
{
    return RuleDay(r, y) * 86400LL + r.time - off;
}

// Fill `out` from the footer for the instant `t`. `floor` is the last baked
// transition (or kBeginning), which the footer's interval may not start before.
constexpr bool InfoFromFooter(const Footer &f, long long t, long long floor_at,
                              long long &out_begin, long long &out_end,
                              int &out_off, int &out_save,
                              char (&out_abbrev)[kAbbrevMax]) noexcept
{
    if (!f.ok) return false;
    if (!f.has_dst) {
        out_begin = floor_at;
        out_end   = kForever;
        out_off   = f.std_off;
        out_save  = 0;
        CopyAbbrev(out_abbrev, f.std_abbrev);
        return true;
    }

    long long y = 0; unsigned mm = 0, dd = 0;
    civil::civil_from_days(civil::floor_div(t, 86400), y, mm, dd);

    // Merge the two rules into the alternating sequence of instants they
    // actually describe, over enough years to bracket t, and take the last
    // event at or before it.
    //
    // There is no northern/southern case here, and that is the point. The
    // first version of this function had one — "if the end comes before the
    // start, the summer wraps the year" — and it checked that t was past the
    // start without checking it was before the end, so Auckland in April 2023
    // was handed an interval it did not lie in and Santiago was handed an
    // empty one. A hemisphere is not a special case; it is the same two rules
    // landing in a different order, which a sort expresses and a branch does
    // not.
    struct Event { long long at; bool dst; };
    Event ev[6];
    int n = 0;
    for (long long yy = y - 1; yy <= y + 1; ++yy) {
        const long long s = RuleInstant(f.start, yy, f.std_off);
        const long long e = RuleInstant(f.end,   yy, f.dst_off);
        if (s <= e) { ev[n++] = {s, true}; ev[n++] = {e, false}; }
        else        { ev[n++] = {e, false}; ev[n++] = {s, true}; }
    }
    for (int i = 1; i < n; ++i)               // six elements, already nearly sorted
        for (int j = i; j > 0 && ev[j - 1].at > ev[j].at; --j) {
            const Event tmp = ev[j - 1]; ev[j - 1] = ev[j]; ev[j] = tmp;
        }

    int k = -1;
    for (int i = 0; i < n; ++i)
        if (ev[i].at <= t) k = i;
    if (k < 0 || k + 1 >= n) return false;    // t is not bracketed: caller decides

    const bool dst = ev[k].dst;
    out_begin = ev[k].at < floor_at ? floor_at : ev[k].at;
    out_end   = ev[k + 1].at;
    out_off   = dst ? f.dst_off : f.std_off;
    out_save  = dst ? f.dst_off - f.std_off : 0;
    CopyAbbrev(out_abbrev, dst ? f.dst_abbrev : f.std_abbrev);
    return true;
}

// ── leap seconds ────────────────────────────────────────────────────────────
//
// The table stores, for each insertion, the sys instant AFTER it and the ±1 it
// carried — the shape `leap-seconds.list` publishes and the one
// [time.zone.leap] asks for. Both questions the clocks need are answered from
// it here, in the leaf the host can measure, rather than in a header the guest
// alone ever runs.

// The sum of leap seconds inserted at or before this sys instant.
inline long long LeapElapsedAtSys(const Table &tab, long long t) noexcept
{
    long long elapsed = 0;
    for (int i = 0, n = LeapCount(tab); i < n; ++i) {
        long long when = 0;
        int value = 0;
        LeapAt(tab, i, when, value);
        if (when > t) break;
        elapsed += value;
    }
    return elapsed;
}

// [time.clock.utc.nonmembers]: `elapsed` counts the insertions at or before
// this UTC reading, and the one being inserted counts while it is happening.
// A UTC reading is inside a positive insertion when it has passed the instant
// the insertion starts and not yet reached the sys instant it ends at.
inline void LeapAtUtc(const Table &tab, long long u, bool &is_leap,
                      long long &elapsed) noexcept
{
    elapsed = 0;
    is_leap = false;
    for (int i = 0, n = LeapCount(tab); i < n; ++i) {
        long long when = 0;
        int value = 0;
        LeapAt(tab, i, when, value);
        const long long starts = when + elapsed;      // in UTC counts
        if (u >= starts + value) {
            elapsed += value;                          // wholly behind us
        } else if (value > 0 && u >= starts) {
            elapsed += value;                          // we are inside it
            is_leap = true;
            return;
        } else {
            return;
        }
    }
}

// ── the two questions a zone is asked ───────────────────────────────────────

inline bool InfoAtSys(const Table &tab, int body_idx, long long t,
                      Info &out) noexcept
{
    const Body b = BodyAt(tab, body_idx);
    const Walk w = WalkTo(b, t);

    if (w.count == b.n_trans) {
        // At or past the last transition: the footer owns this instant.
        const Footer f = ParseFooter(b.posix);
        const long long floor_at = b.n_trans ? w.at : kBeginning;
        if (InfoFromFooter(f, t, floor_at, out.begin, out.end, out.offset,
                           out.save, out.abbrev))
            return true;
        // A zone whose footer we could not read still has its last type.
        if (b.n_trans == 0) {
            const Type ty = TypeAt(b, FirstType(b));
            out.begin = kBeginning; out.end = kForever;
            out.offset = ty.utoff; out.save = 0;
            CopyAbbrev(out.abbrev, Pooled(tab, ty.abbrev_off));
            return true;
        }
    }

    if (w.count == 0) {
        const Type ty = TypeAt(b, FirstType(b));
        out.begin  = kBeginning;
        out.end    = b.n_trans ? w.next : kForever;
        out.offset = ty.utoff;
        out.save   = 0;
        CopyAbbrev(out.abbrev, Pooled(tab, ty.abbrev_off));
        return true;
    }

    const Type ty = TypeAt(b, w.code & 0x0F);
    out.begin  = w.at;
    out.end    = w.next;
    out.offset = ty.utoff;
    out.save   = SaveAt(tab, w.code >> 4);
    CopyAbbrev(out.abbrev, Pooled(tab, ty.abbrev_off));
    return true;
}

// [time.zone.members]/4: a local time is unique, nonexistent (a forward jump
// skipped it) or ambiguous (a backward jump replayed it).
//
// An interval [begin, end) with offset o shows the wall clock the readings
// [begin + o, end + o). So the question "which intervals show this reading" is
// answered by WALKING the intervals that could possibly show it and testing
// that range — not by guessing which one to look at.
//
// ‼ The version before this one converted lt three ways — a day back, at, and
// a day on — and asked whether each landed in the interval it had just been
// converted with. It gives the same answer as this one on every reading of
// tzdata 2026c, which was measured rather than assumed: 800 872 readings, all
// agreeing. It is replaced anyway, and the reason is worth stating, because it
// is NOT that it was found wrong. Its correctness rested on a property of the
// data that nothing states and nothing checks — that no interval is shorter
// than the probe spacing. That property holds today (all 16 319 intervals in
// the database run a day or longer, measured) and holds nowhere in writing.
// This version does not depend on it: it walks the intervals and tests the
// wall-clock range each one actually shows, so a future release that shortens
// one cannot quietly turn a correct answer into a wrong one.
inline LocalResult InfoAtLocal(const Table &tab, int body_idx, long long lt,
                               Info &first, Info &second) noexcept
{
    // The widest jump the database contains is a whole day (Pacific/Apia
    // skipped 2011-12-30 outright), so starting two days back reaches every
    // interval that could show this reading.
    constexpr long long kWindow = 2 * 86400;

    Info hits[2]{};
    int  found = 0;
    Info before{}, after{};
    bool have_before = false, have_after = false;

    Info cur{};
    if (!InfoAtSys(tab, body_idx, lt - kWindow, cur)) {
        // A zone that cannot answer two days early can still answer now.
        if (InfoAtSys(tab, body_idx, lt, first)) return LocalResult::unique;
        first = Info{};
        return LocalResult::unique;
    }

    // The loop ends on `cur.end > lt + kWindow`; this bound is only a runaway
    // backstop, so it is set well above the four or five steps the walk needs
    // at today's interval lengths rather than at them.
    for (int guard = 0; guard < 64; ++guard) {
        const long long local_begin = cur.begin == kBeginning
                                    ? kBeginning : cur.begin + cur.offset;
        const long long local_end = cur.end == kForever
                                  ? kForever : cur.end + cur.offset;
        if (lt >= local_begin && lt < local_end) {
            if (found < 2) hits[found++] = cur;
        } else if (lt >= local_end) {
            before = cur;                    // the last one that ends below lt
            have_before = true;
        } else if (!have_after) {
            after = cur;                     // the first one that starts above
            have_after = true;
        }
        if (cur.end == kForever || cur.end > lt + kWindow) break;
        Info next{};
        if (!InfoAtSys(tab, body_idx, cur.end, next)) break;
        if (next.begin <= cur.begin) break;  // no forward progress: stop
        cur = next;
    }

    if (found == 1) { first = hits[0]; return LocalResult::unique; }
    if (found >= 2) {
        // [time.zone.info]: the earlier interpretation comes first, and it is
        // the one whose interval begins earlier.
        const bool swap = hits[1].begin < hits[0].begin;
        first  = swap ? hits[1] : hits[0];
        second = swap ? hits[0] : hits[1];
        return LocalResult::ambiguous;
    }

    // Nonexistent: the standard wants the intervals on either side of the gap.
    if (have_before) first = before;
    if (have_after) second = after;
    return LocalResult::nonexistent;
}

// ── the door: a table that did not come from the image ──────────────────────
//
// The baked table is written by tools/gen_tzdb.py, which refuses to emit one
// that breaks its own invariants, so nothing above ever checks it. A table
// laid in TagFS is a different kind of thing: it can be truncated, half
// written, written by an older generator, or not a table at all — and every
// accessor above follows offsets out of it without looking. So the door checks
// once, up front, and everything past the check runs the SAME code the image's
// own table runs. There is no second, careful reader; there is one reader and
// one gate.
//
// What is checked is exactly what the readers assume, no more:
//   * the magic, and that every section lies wholly inside the blob;
//   * that every offset a reader follows lands in the section it names;
//   * that the string pool ends in a NUL, which is what bounds every name,
//     abbreviation and POSIX footer — none of them carries a length;
//   * that each body's varint run decodes to exactly the number of
//     transitions the body claims, consuming exactly the bytes it reserved;
//   * that the name index is SORTED. Find() is a binary search, and an
//     unsorted index does not fault — it answers wrongly, silently, which is
//     the worse failure and the one no amount of bounds checking would catch.
//   * that a Link points at a Zone and not at another Link, because
//     locate_zone resolves exactly one hop.
//
// ‼ This function is not reviewed, it is ATTACKED — run
// `tools/tzdb_door_check.sh` after any edit here or to the generators. It
// compiles this file on the build host under ASan and UBSan and corrupts the
// real table 300 000 ways; the first run found three unbounded accumulations
// below (the POSIX-footer digit runs and the varint shift), none of them
// reachable from a table IANA ships and all of them reachable from a file
// anybody can write.

constexpr bool StrInPool(const Head &h, unsigned long long size,
                         unsigned off) noexcept
{
    return static_cast<unsigned long long>(h.off_pool) + off < size;
}

// Decode `n` varints from [p, p + span) exactly as WalkTo will, and demand
// three things of them: that they end precisely on the span, that no single
// varint runs past ten bytes, and that the running sum is a strictly
// increasing sequence of plausible instants.
//
// The ten-byte limit is not a size preference. WalkTo shifts by `shift += 7`
// with no ceiling, so an eleventh continuation byte shifts a 64-bit value by
// 70 — undefined behaviour, in the guest, driven by a file. Ten bytes is
// exactly what a 64-bit value needs and one more is not a large number, it is
// a broken one.
//
// Strictly increasing is what the generator writes and what WalkTo assumes
// when it stops at the first transition past t. A run that goes backwards
// would not fault; it would answer with the wrong interval, silently.
constexpr bool VarintRunOk(const unsigned char *p, unsigned long long span,
                           unsigned n) noexcept
{
    unsigned long long used = 0;
    long long cur = 0;
    for (unsigned i = 0; i < n; ++i) {
        unsigned long long v = 0;
        unsigned shift = 0;
        for (;;) {
            if (used >= span) return false;
            if (shift > 63) return false;          // an 11th byte would be UB
            const unsigned char byte = p[used++];
            v |= static_cast<unsigned long long>(byte & 0x7F) << shift;
            shift += 7;
            if (byte < 0x80) break;
        }
        const long long d = static_cast<long long>((v >> 1) ^ (~(v & 1) + 1));
        // Both operands are inside +-2^62, so the sum cannot overflow.
        if (d < -kForever || d > kForever) return false;
        const long long next = cur + d;
        if (i > 0 && next <= cur) return false;    // never backwards, never twice
        if (next < -kForever || next > kForever) return false;
        cur = next;
    }
    return used == span;
}

constexpr bool Validate(const unsigned char *b, unsigned long long size) noexcept
{
    if (!b || size < 44) return false;

    const char magic[8] = {'B', 'O', 'X', 'T', 'Z', 'D', 'B', '1'};
    for (int i = 0; i < 8; ++i)
        if (b[i] != static_cast<unsigned char>(magic[i])) return false;

    const Head h = ReadHead(b);
    const unsigned long long n_names  = h.n_names;
    const unsigned long long n_bodies = h.n_bodies;
    const unsigned long long n_leaps  = h.n_leaps;

    // Every section, whole, inside the blob. Widened to 64 bits first: a
    // count near 2^32 would otherwise wrap the sum back into range and pass.
    if (n_names == 0 || n_bodies == 0) return false;
    if (h.off_names + n_names * 8 > size) return false;
    if (h.off_bodytab + n_bodies * 4 > size) return false;
    if (h.off_leaps + n_leaps * 16 > size) return false;
    if (static_cast<unsigned long long>(h.off_saves) + 16 * 4 > size) return false;
    if (h.off_pool >= size) return false;

    // The pool's terminator. Every string in the table is a pointer into the
    // pool with no length beside it, so this single byte is what stops every
    // walk over every one of them.
    if (b[size - 1] != 0) return false;
    if (!StrInPool(h, size, h.version_off)) return false;

    // ── the name index ──────────────────────────────────────────────────
    const unsigned char *names = b + h.off_names;
    for (unsigned long long i = 0; i < n_names; ++i) {
        const unsigned char *e = names + i * 8;
        if (!StrInPool(h, size, U32(e))) return false;
        if (static_cast<unsigned long long>(U16(e + 4)) >= n_bodies) return false;
        const unsigned link = U16(e + 6);
        if (link != 0xFFFFu) {
            if (link >= n_names) return false;
            if (link == i) return false;                       // a link to itself
            if (U16(names + static_cast<unsigned long long>(link) * 8 + 6) != 0xFFFFu)
                return false;                                  // a link to a link
        }
    }

    // Sorted, strictly. Compare() takes the second operand's length because
    // Find() searches with a string_view; here both sides are pooled and
    // NUL-terminated, so the length of the right-hand one is what bounds it.
    for (unsigned long long i = 1; i < n_names; ++i) {
        const char *prev = reinterpret_cast<const char *>(
            b + h.off_pool + U32(names + (i - 1) * 8));
        const char *cur = reinterpret_cast<const char *>(
            b + h.off_pool + U32(names + i * 8));
        unsigned len = 0;
        while (cur[len] != '\0') ++len;
        if (Compare(prev, cur, len) >= 0) return false;
    }

    // ── the bodies ──────────────────────────────────────────────────────
    for (unsigned long long j = 0; j < n_bodies; ++j) {
        const unsigned long long at = U32(b + h.off_bodytab + j * 4);
        if (at + 8 > size) return false;

        const unsigned char *p = b + at;
        const unsigned long long n_types = U16(p);
        const unsigned long long n_trans = U16(p + 2);
        if (n_types == 0) return false;          // FirstType would read nothing
        if (!StrInPool(h, size, U32(p + 4))) return false;      // POSIX footer

        const unsigned long long types_at = at + 8;
        if (types_at + n_types * 8 > size) return false;
        for (unsigned long long k = 0; k < n_types; ++k)
            if (!StrInPool(h, size, U16(b + types_at + k * 8 + 4))) return false;

        const unsigned long long vhdr = types_at + n_types * 8;
        if (vhdr + 4 > size) return false;
        const unsigned long long span = U32(b + vhdr);
        const unsigned long long times_at = vhdr + 4;
        if (times_at + span > size) return false;
        const unsigned long long codes_at = times_at + span;
        if (codes_at + n_trans > size) return false;

        if (!VarintRunOk(b + times_at, span, static_cast<unsigned>(n_trans)))
            return false;

        // A transition's type nibble indexes the type list; its save nibble
        // indexes the 16-entry save table, which four bits cannot overrun.
        for (unsigned long long k = 0; k < n_trans; ++k)
            if ((b[codes_at + k] & 0x0F) >= n_types) return false;
    }

    // ── the leap seconds ────────────────────────────────────────────────
    // Found by the fuzz rather than by reading: nothing here was checked at
    // all, and LeapAtUtc adds `when + elapsed + value`, so a `when` a few
    // counts below the 64-bit ceiling is signed overflow inside the library.
    // Bounding them by kForever — the same +-2^62 every instant in this
    // format lives inside — removes the arithmetic edge entirely, and
    // demanding the order LeapElapsedAtSys already assumes (it stops at the
    // first `when` past t) closes the silent-wrong-answer half.
    {
        long long prev = -kForever;
        for (unsigned long long i = 0; i < n_leaps; ++i) {
            const unsigned char *p = b + h.off_leaps + i * 16;
            const long long when = I64(p);
            const int value = I32(p + 8);
            if (when < -kForever || when > kForever) return false;
            if (i > 0 && when <= prev) return false;
            if (value != 1 && value != -1) return false;
            prev = when;
        }
    }

    return true;
}

