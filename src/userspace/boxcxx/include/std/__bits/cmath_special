// ── RC(x,y) = RF(x,y,y) ──────────────────────────────────────────────────────
// x ≥ 0, y > 0.  (Cauchy PV for y < 0 handled by callers.)
static double carlson_RC(double x, double y) {
    if (std::isnan(x) || std::isnan(y)) return kQNaN;
    if (x < 0.0 || y <= 0.0) return kQNaN;
    if (x == 0.0) return kPiOver2 / std::sqrt(y);

    const double errtol = 3.5e-9;
    double xn = x, yn = y;

    for (int iter = 0; iter < 60; ++iter) {
        double lam = 2.0 * std::sqrt(xn * yn) + yn;
        xn = 0.25 * (xn + lam);
        yn = 0.25 * (yn + lam);

        double ave = (xn + 2.0 * yn) * (1.0 / 3.0);
        double sdx = (ave - xn) / ave;
        double sdy = (ave - yn) / ave;

        if (std::fabs(sdx) < errtol && std::fabs(sdy) < errtol) {
            double s = sdy * (sdx + 3.0 * sdy) * 0.25;
            return (1.0 + s * (3.0/10.0 + s * (3.0/8.0 + s * (45.0/208.0
                   + s * (105.0/512.0))))) / std::sqrt(ave);
        }
    }
    return 1.0 / std::sqrt((xn + 2.0 * yn) * (1.0 / 3.0));
}

// ── RF(x,y,z) — symmetric integral of the first kind ─────────────────────────
// x,y,z ≥ 0; at most one may be zero.
static double carlson_RF(double x, double y, double z) {
    if (std::isnan(x) || std::isnan(y) || std::isnan(z)) return kQNaN;
    if (x < 0.0 || y < 0.0 || z < 0.0) return kQNaN;
    int zeros = (x == 0.0) + (y == 0.0) + (z == 0.0);
    if (zeros >= 2) return kInf;

    const double errtol = 3.5e-9;
    double xn = x, yn = y, zn = z;

    for (int iter = 0; iter < 60; ++iter) {
        double sx = std::sqrt(xn), sy = std::sqrt(yn), sz = std::sqrt(zn);
        double lam = sx * sy + sx * sz + sy * sz;
        xn = 0.25 * (xn + lam);
        yn = 0.25 * (yn + lam);
        zn = 0.25 * (zn + lam);

        double ave = (xn + yn + zn) * (1.0 / 3.0);
        double dx = (ave - xn) / ave;
        double dy = (ave - yn) / ave;
        double dz = (ave - zn) / ave;

        if (std::fabs(dx) < errtol && std::fabs(dy) < errtol && std::fabs(dz) < errtol) {
            // Carlson 1995 eq. (19):
            double e2 = dx * dy - dz * dz;
            double e3 = dx * dy * dz;
            return (1.0 + e2 * (-1.0/10.0 + e2 * 3.0/44.0)
                        + e3 / 14.0
                        - e2 * e2 * 3.0/44.0
                        + e2 * e3 * (-3.0/66.0)) / std::sqrt(ave);
        }
    }
    return 1.0 / std::sqrt((xn + yn + zn) * (1.0 / 3.0));
}

// ── RD(x,y,z) — degenerate third kind ────────────────────────────────────────
// x,y ≥ 0 (at most one zero), z > 0.
static double carlson_RD(double x, double y, double z) {
    if (std::isnan(x) || std::isnan(y) || std::isnan(z)) return kQNaN;
    if (x < 0.0 || y < 0.0 || z <= 0.0) return kQNaN;
    if (x == 0.0 && y == 0.0) return kInf;

    const double errtol = 3.5e-9;
    double xn = x, yn = y, zn = z;
    double sum = 0.0, fac = 1.0;

    for (int iter = 0; iter < 60; ++iter) {
        double sx = std::sqrt(xn), sy = std::sqrt(yn), sz = std::sqrt(zn);
        double lam = sx * sy + sx * sz + sy * sz;

        sum += fac / (sz * (zn + lam));
        fac *= 0.25;

        xn = 0.25 * (xn + lam);
        yn = 0.25 * (yn + lam);
        zn = 0.25 * (zn + lam);

        double ave = (xn + yn + 3.0 * zn) * 0.2;
        double dx = (ave - xn) / ave;
        double dy = (ave - yn) / ave;
        double dz = (ave - zn) / ave;

        if (std::fabs(dx) < errtol && std::fabs(dy) < errtol && std::fabs(dz) < errtol) {
            // Carlson 1995 eq. (21):
            double e2 = dx * dy - 6.0 * dz * dz;
            double e3 = (3.0 * dx * dy - 8.0 * dz * dz) * dz;
            double e4 = 3.0 * (dx * dy - dz * dz) * dz * dz;
            double e5 = dx * dy * dz * dz * dz;
            double poly = 1.0 + e2 * (-3.0/14.0) + e3 / 6.0
                              + e2 * e2 * (9.0/88.0)
                              - e4 * (45.0/66.0)
                              + e2 * e3 * (-5.0/22.0)
                              + e5 * (5.0/11.0)
                              - e2 * e2 * e2 * (315.0/2288.0);
            return 3.0 * sum + fac * poly / (ave * std::sqrt(ave));
        }
    }
    return 3.0 * sum;
}

// ── RJ(x,y,z,p) — third kind ─────────────────────────────────────────────────
// x,y,z ≥ 0 (at most one zero), p ≠ 0.
// Carlson (1995) duplication formula with:
//   alpha_n = p_n*(√x_n+√y_n+√z_n) + √(x_n*y_n*z_n)
//   beta_n  = p_n*(p_n + lambda_n)²         ← squared lambda factor is critical
//   sum term: 3 * 4^{-n} * RC(alpha_n², beta_n)
//
// For p < 0: p_n converges toward positive after ~log₄(lambda/|p|) steps (lambda > |p_n|
// makes |p_{n+1}| < |p_n|/4). In each step the RC is evaluated via the Cauchy PV formula.
static double carlson_RJ(double x, double y, double z, double p) {
    if (std::isnan(x) || std::isnan(y) || std::isnan(z) || std::isnan(p)) return kQNaN;
    if (x < 0.0 || y < 0.0 || z < 0.0) return kQNaN;
    if (p == 0.0) return kInf;

    const double errtol = 3.5e-9;
    double xn = x, yn = y, zn = z, pn = p;
    double sum = 0.0, fac = 1.0;

    for (int iter = 0; iter < 60; ++iter) {
        double sx = std::sqrt(xn), sy = std::sqrt(yn), sz = std::sqrt(zn);
        double lam = sx * sy + sx * sz + sy * sz;

        // alpha: real regardless of sign of pn (pn can be negative early on).
        double alpha  = pn * (sx + sy + sz) + sx * sy * sz;
        double alpha2 = alpha * alpha;  // always ≥ 0

        // beta = pn*(pn + lam)²
        double pn_plus_lam = pn + lam;
        double beta = pn * pn_plus_lam * pn_plus_lam;

        // Evaluate RC(alpha², beta) with correct handling of beta's sign.
        double rc_term;
        if (beta > 0.0) {
            if (alpha2 == 0.0) {
                // RC(0, beta>0) = pi/(2*sqrt(beta)).
                rc_term = kPiOver2 / std::sqrt(beta);
            } else {
                rc_term = carlson_RC(alpha2, beta);
            }
        } else if (beta < 0.0) {
            // Cauchy PV: RC(x, y<0) = sqrt(x/(x-y)) * RC(x-y, -y).
            if (alpha2 == 0.0) {
                // RC(0, beta<0): PV is 0 (Carlson 1987 §3, eq 5).
                rc_term = 0.0;
            } else {
                double amb = alpha2 - beta;  // > alpha2 > 0
                rc_term = std::sqrt(alpha2 / amb) * carlson_RC(amb, -beta);
            }
        } else {
            // beta == 0: RC diverges unless alpha2 = 0 too (degenerate, measure zero).
            rc_term = (alpha2 == 0.0) ? 0.0 : kInf;
        }

        sum += fac * 3.0 * rc_term;
        fac *= 0.25;

        xn = 0.25 * (xn + lam);
        yn = 0.25 * (yn + lam);
        zn = 0.25 * (zn + lam);
        pn = 0.25 * (pn + lam);

        double ave = (xn + yn + zn + 2.0 * pn) * 0.2;
        double dx = (ave - xn) / ave;
        double dy = (ave - yn) / ave;
        double dz = (ave - zn) / ave;
        double dp = (ave - pn) / ave;

        if (std::fabs(dx) < errtol && std::fabs(dy) < errtol
         && std::fabs(dz) < errtol && std::fabs(dp) < errtol) {
            // Carlson 1995 eq. (22):
            double xyz = dx * dy * dz;
            double e2  = dx * dy + dx * dz + dy * dz - 3.0 * dp * dp;
            double e3  = xyz + 2.0 * e2 * dp + 3.0 * dp * dp * (dx + dy + dz - dp);
            double e4  = dp * (2.0 * xyz + dp * (e2 + 3.0 * dp * dp));
            double e5  = xyz * dp * dp;
            double poly = 1.0 + e2 * (-3.0/14.0) + e3 / 6.0
                              + e2 * e2 * (9.0/88.0)
                              - e4 * (45.0/66.0)
                              + e3 * e2 * (-5.0/22.0)
                              + e5 * (5.0/11.0)
                              - e2 * e2 * e2 * (315.0/2288.0);
            return sum + fac * poly / (ave * std::sqrt(ave));
        }
    }
    return sum;
}

// ─────────────────────────────────────────────────────────────────────────────
// Six C++17 elliptic integrals via Carlson forms.
// Modulus is k (not m = k²).  |k| ≤ 1 for real results.
// φ in radians; period-reduction handles φ outside [−π/2, π/2].
// ─────────────────────────────────────────────────────────────────────────────

// K(k) = RF(0, 1−k², 1).
inline double comp_ellint_1(double k) {
    if (std::isnan(k)) return kQNaN;
    double ak = std::fabs(k);
    if (ak > 1.0) return kQNaN;
    if (ak == 1.0) return kInf;
    return carlson_RF(0.0, 1.0 - k * k, 1.0);
}

// E(k) = RF(0,1−k²,1) − (k²/3)·RD(0,1−k²,1).
inline double comp_ellint_2(double k) {
    if (std::isnan(k)) return kQNaN;
    double ak = std::fabs(k);
    if (ak > 1.0) return kQNaN;
    if (ak == 1.0) return 1.0;
    if (k == 0.0) return kPiOver2;
    double k2 = k * k, kc2 = 1.0 - k2;
    return carlson_RF(0.0, kc2, 1.0) - (k2 / 3.0) * carlson_RD(0.0, kc2, 1.0);
}

// Π(ν, k) = RF(0,1−k²,1) + (ν/3)·RJ(0,1−k²,1, 1−ν).
inline double comp_ellint_3(double k, double nu) {
    if (std::isnan(k) || std::isnan(nu)) return kQNaN;
    double ak = std::fabs(k);
    if (ak > 1.0) return kQNaN;
    if (ak == 1.0) return kInf;
    if (nu == 1.0) return kInf;
    double k2 = k * k, kc2 = 1.0 - k2;
    return carlson_RF(0.0, kc2, 1.0)
         + (nu / 3.0) * carlson_RJ(0.0, kc2, 1.0, 1.0 - nu);
}

// F(φ, k) — reduce φ mod π, then sinφ · RF(cos²φ, 1−k²sin²φ, 1).
// F(φ+nπ, k) = 2n·K(k) + F(φ, k).
inline double ellint_1(double k, double phi) {
    if (std::isnan(k) || std::isnan(phi)) return kQNaN;
    if (std::fabs(k) > 1.0) return kQNaN;
    if (std::isinf(phi)) return kQNaN;

    double nd = std::floor((phi + kPiOver2) / kPi);
    double phi_r = phi - nd * kPi;
    double sgn = 1.0;
    if (phi_r < 0.0) { phi_r = -phi_r; sgn = -1.0; }

    double result;
    if (phi_r >= kPiOver2) {
        result = comp_ellint_1(k);
    } else {
        double s = std::sin(phi_r), c = std::cos(phi_r);
        double k2s2 = k * k * s * s;
        if (k2s2 > 1.0) return kQNaN;
        result = s * carlson_RF(c * c, 1.0 - k2s2, 1.0);
    }
    result = sgn * result;
    if (nd != 0.0) {
        double K = comp_ellint_1(k);
        if (std::isinf(K)) return std::copysign(kInf, phi);
        result += 2.0 * nd * K;
    }
    return result;
}

// E(φ, k) — reduce φ mod π, then use sinφ·RF − (k²/3)sin³φ·RD.
// E(φ+nπ, k) = 2n·E(k) + E(φ, k).
inline double ellint_2(double k, double phi) {
    if (std::isnan(k) || std::isnan(phi)) return kQNaN;
    if (std::fabs(k) > 1.0) return kQNaN;
    if (std::isinf(phi)) return kQNaN;

    double nd = std::floor((phi + kPiOver2) / kPi);
    double phi_r = phi - nd * kPi;
    double sgn = 1.0;
    if (phi_r < 0.0) { phi_r = -phi_r; sgn = -1.0; }

    double result;
    if (phi_r >= kPiOver2) {
        result = comp_ellint_2(k);
    } else {
        double s = std::sin(phi_r), c = std::cos(phi_r);
        double k2 = k * k, k2s2 = k2 * s * s;
        if (k2s2 > 1.0) return kQNaN;
        double c2 = c * c, nc2 = 1.0 - k2s2;
        result = s * carlson_RF(c2, nc2, 1.0)
               - (k2 / 3.0) * s * s * s * carlson_RD(c2, nc2, 1.0);
    }
    result = sgn * result;
    if (nd != 0.0) result += 2.0 * nd * comp_ellint_2(k);
    return result;
}

// Π(ν, φ, k) — reduce φ mod π, then sinφ·RF + (ν/3)sin³φ·RJ(…, 1−ν·sin²φ).
// Π(ν, φ+nπ, k) = 2n·Π(ν,k) + Π(ν,φ,k).
// Pole when 1 − ν·sin²φ = 0.
inline double ellint_3(double k, double nu, double phi) {
    if (std::isnan(k) || std::isnan(nu) || std::isnan(phi)) return kQNaN;
    if (std::fabs(k) > 1.0) return kQNaN;
    if (std::isinf(phi)) return kQNaN;

    double nd = std::floor((phi + kPiOver2) / kPi);
    double phi_r = phi - nd * kPi;
    double sgn = 1.0;
    if (phi_r < 0.0) { phi_r = -phi_r; sgn = -1.0; }

    double result;
    if (phi_r >= kPiOver2) {
        result = comp_ellint_3(k, nu);
    } else {
        double s = std::sin(phi_r), c = std::cos(phi_r);
        double k2 = k * k, k2s2 = k2 * s * s;
        if (k2s2 > 1.0) return kQNaN;
        double c2  = c * c;
        double nc2 = 1.0 - k2s2;
        double p   = 1.0 - nu * s * s;
        if (p == 0.0) return kInf;
        result = s * carlson_RF(c2, nc2, 1.0)
               + (nu / 3.0) * s * s * s * carlson_RJ(c2, nc2, 1.0, p);
    }
    result = sgn * result;
    if (nd != 0.0) {
        double P = comp_ellint_3(k, nu);
        if (std::isinf(P)) return std::copysign(kInf, phi);
        result += 2.0 * nd * P;
    }
    return result;
}

// ── float overloads ──────────────────────────────────────────────────────────
inline float comp_ellint_1(float k)
    { return float(comp_ellint_1(double(k))); }
inline float comp_ellint_2(float k)
    { return float(comp_ellint_2(double(k))); }
inline float comp_ellint_3(float k, float nu)
    { return float(comp_ellint_3(double(k), double(nu))); }
inline float ellint_1(float k, float phi)
    { return float(ellint_1(double(k), double(phi))); }
inline float ellint_2(float k, float phi)
    { return float(ellint_2(double(k), double(phi))); }
inline float ellint_3(float k, float nu, float phi)
    { return float(ellint_3(double(k), double(nu), double(phi))); }

