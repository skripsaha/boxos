constexpr double kBesEps = 1e-17;
constexpr double kBesAsym = 17.5;            // series→asymptotic seam

// J_nu (sgn=-1) or I_nu (sgn=+1) ascending series — small/moderate x, any nu≥0.
inline double bes_series(double nu, double x, double sgn) {
    double hx = 0.5 * x;
    double t  = pow(hx, nu) / tgamma(nu + 1.0);
    double s = t, z = sgn * hx * hx;
    for (int k = 1; k <= 2000; ++k) {
        t *= z / (k * (nu + k));
        s += t;
        if (fabs(t) <= kBesEps * fabs(s)) break;
    }
    return s;
}
// Asymptotic J_nu, Y_nu for x ≫ nu (divergent series → stop at smallest term).
inline void jy_asym(double nu, double x, double &J, double &Y) {
    double mu = 4.0 * nu * nu;
    double a = 1.0, P = 1.0, Q = 0.0, xp = 1.0, prev = kInf;
    for (int k = 1; k <= 40; ++k) {
        a *= (mu - (2 * k - 1) * (2 * k - 1)) / (k * 8.0);
        xp *= x;
        double term = a / xp;
        if (fabs(term) > prev) break;            // asymptotic divergence guard
        prev = fabs(term);
        if (k & 1) Q += (((k - 1) / 2) & 1) ? -term : term;
        else       P += ((k / 2) & 1) ? -term : term;
        if (fabs(term) < kBesEps) break;
    }
    double chi = x - nu * kPiOver2 - kPiOver4;
    double f = sqrt(2.0 / (kPi * x)), c = cos(chi), sn = sin(chi);
    J = f * (P * c - Q * sn);
    Y = f * (P * sn + Q * c);
}
// Asymptotic I_nu, K_nu for x ≫ nu.
inline void ik_asym(double nu, double x, double &I, double &K) {
    double mu = 4.0 * nu * nu;
    double a = 1.0, sumK = 1.0, sumI = 1.0, xp = 1.0, prev = kInf;
    for (int k = 1; k <= 40; ++k) {
        a *= (mu - (2 * k - 1) * (2 * k - 1)) / (k * 8.0);
        xp *= x;
        double term = a / xp;
        if (fabs(term) > prev) break;
        prev = fabs(term);
        sumK += term;
        sumI += (k & 1) ? -term : term;
        if (fabs(term) < kBesEps) break;
    }
    K = sqrt(kPi / (2.0 * x)) * exp(-x) * sumK;
    I = exp(x) / sqrt(2.0 * kPi * x) * sumI;
}
// Integer-order small-x series (digamma form) for Y0,Y1,K0,K1.
inline double Y0_small(double x) {
    double hx = 0.5 * x, hx2 = hx * hx, term = 1.0, J = 1.0, acc = 0.0, H = 0.0;
    for (int k = 1; k <= 300; ++k) {
        term *= -hx2 / (double(k) * k); J += term;
        H += 1.0 / k; acc += H * term;
        if (fabs(term) < kBesEps * fabs(J)) break;
    }
    return (2.0 / kPi) * ((log(hx) + kEulerGamma) * J - acc);
}
inline double K0_small(double x) {
    double hx = 0.5 * x, hx2 = hx * hx, term = 1.0, I = 1.0, acc = 0.0, H = 0.0;
    for (int k = 1; k <= 300; ++k) {
        term *= hx2 / (double(k) * k); I += term;
        H += 1.0 / k; acc += H * term;
        if (fabs(term) < kBesEps * fabs(I)) break;
    }
    return -(log(hx) + kEulerGamma) * I + acc;
}
inline double Y1_small(double x) {
    double hx = 0.5 * x, hx2 = hx * hx;
    double I1 = bes_series(1.0, x, -1.0);        // J_1
    // -(2/(pi x)) + (2/pi)(ln hx)J1 - (1/pi) Σ_{k≥0} (H_k+H_{k+1})(-1)^k (hx)^{2k+1}/(k!(k+1)!)
    double term = hx, acc = 0.0, Hk = 0.0, Hk1 = 1.0;   // k=0: H0=0,H1=1
    for (int k = 0; k <= 300; ++k) {
        acc += (Hk + Hk1) * term;
        double next = -term * hx2 / ((k + 1.0) * (k + 2.0));
        term = next; Hk += 1.0 / (k + 1.0); Hk1 += 1.0 / (k + 2.0);
        if (fabs(term) < kBesEps * (fabs(acc) + 1e-300)) break;
    }
    return (2.0 / kPi) * (log(hx) + kEulerGamma) * I1 - (2.0 / (kPi * x)) - (1.0 / kPi) * acc;
}
inline double K1_small(double x) {
    double hx = 0.5 * x, hx2 = hx * hx;
    double I1 = bes_series(1.0, x, 1.0);
    double term = hx, acc = 0.0, Hk = 0.0, Hk1 = 1.0;
    for (int k = 0; k <= 300; ++k) {
        acc += (Hk + Hk1) * term;
        double next = term * hx2 / ((k + 1.0) * (k + 2.0));
        term = next; Hk += 1.0 / (k + 1.0); Hk1 += 1.0 / (k + 2.0);
        if (fabs(term) < kBesEps * (fabs(acc) + 1e-300)) break;
    }
    return 1.0 / x + (log(hx) + kEulerGamma) * I1 - 0.5 * acc;
}

// ── x≥8 helpers: μ=frac(ν) base via asymptotic (x≫μ<1) + recurrence ────────
constexpr double kBesRecSeam = 8.0;
inline double besJ_rec(double nu, double x) {                 // Miller downward
    double mu = nu - floor(nu);
    double Jm, Ym, Jm1, Ym1; jy_asym(mu, x, Jm, Ym); jy_asym(mu + 1.0, x, Jm1, Ym1);
    int N = (int)floor(nu - mu + 0.5);
    if (N == 0) return Jm;
    int M = N + (int)x + (int)sqrt(40.0 * nu) + 30;           // M ≫ max(ν,x)
    double jhi = 0.0, jc = 1e-280, Jnu_u = 0.0, Jmu_u = 0.0, Jmu1_u = 0.0;
    for (int k = M; k >= 0; --k) {
        if (k == N) Jnu_u = jc;
        if (k == 1) Jmu1_u = jc;
        if (k == 0) Jmu_u = jc;
        double jl = (2.0 * (mu + k) / x) * jc - jhi; jhi = jc; jc = jl;
        if (fabs(jc) > 1e250) { jc *= 1e-280; jhi *= 1e-280; Jnu_u *= 1e-280; Jmu_u *= 1e-280; Jmu1_u *= 1e-280; }
    }
    // normalize by the larger-magnitude fractional anchor (avoids ÷ near-zero)
    double scale = (fabs(Jm) >= fabs(Jm1)) ? Jm / Jmu_u : Jm1 / Jmu1_u;
    return Jnu_u * scale;
}
inline double besI_rec(double nu, double x) {                 // Miller downward (+)
    double mu = nu - floor(nu);
    double Im, Km; ik_asym(mu, x, Im, Km);
    int N = (int)floor(nu - mu + 0.5);
    if (N == 0) return Im;
    int M = N + 25 + (int)sqrt(40.0 * nu);
    double ihi = 0.0, ic = 1e-280, Inu_u = 0.0, Imu_u = 0.0;
    for (int k = M; k >= 0; --k) {
        if (k == N) Inu_u = ic;
        if (k == 0) Imu_u = ic;
        double il = (2.0 * (mu + k) / x) * ic + ihi; ihi = ic; ic = il;
        if (fabs(ic) > 1e250) { ic *= 1e-280; ihi *= 1e-280; Inu_u *= 1e-280; Imu_u *= 1e-280; }
    }
    return Inu_u * (Im / Imu_u);
}
inline double besY_rec(double nu, double x) {                 // upward (stable)
    double mu = nu - floor(nu); int N = (int)floor(nu - mu + 0.5);
    double Jm, Ym; jy_asym(mu, x, Jm, Ym);
    if (N == 0) return Ym;
    double Jm1, Ym1; jy_asym(mu + 1.0, x, Jm1, Ym1);
    double ym = Ym, yc = Ym1;
    for (int k = 1; k < N; ++k) { double yn = (2.0 * (mu + k) / x) * yc - ym; ym = yc; yc = yn; }
    return yc;
}
inline double besK_rec(double nu, double x) {                 // upward (+)
    double mu = nu - floor(nu); int N = (int)floor(nu - mu + 0.5);
    double Im, Km; ik_asym(mu, x, Im, Km);
    if (N == 0) return Km;
    double Im1, Km1; ik_asym(mu + 1.0, x, Im1, Km1);
    double km = Km, kc = Km1;
    for (int k = 1; k < N; ++k) { double kn = (2.0 * (mu + k) / x) * kc + km; km = kc; kc = kn; }
    return kc;
}
// ── public cylindrical ─────────────────────────────────────────────────────
inline double cyl_bessel_j(double nu, double x) {
    if (isnan(nu) || isnan(x) || x < 0.0) return kQNaN;
    if (x == 0.0) return nu == 0.0 ? 1.0 : 0.0;
    // series while x≲ν (decaying, no cancellation); asymptotic for x≫ν.
    if (x <= nu + 10.0) return bes_series(nu, x, -1.0);
    return besJ_rec(nu, x);
}
inline double cyl_bessel_i(double nu, double x) {
    if (isnan(nu) || isnan(x) || x < 0.0) return kQNaN;
    if (x == 0.0) return nu == 0.0 ? 1.0 : 0.0;
    if (x >= kBesRecSeam) return besI_rec(nu, x);
    return bes_series(nu, x, 1.0);
}
inline double cyl_neumann(double nu, double x) {
    if (isnan(nu) || isnan(x) || x < 0.0) return kQNaN;
    if (x == 0.0) return -kInf;
    if (x >= kBesRecSeam) return besY_rec(nu, x);
    double n = floor(nu + 0.5);
    if (fabs(nu - n) > 1e-7) {              // non-integer: reflection
        double s = sin(nu * kPi);
        return (bes_series(nu, x, -1.0) * cos(nu * kPi) - bes_series(-nu, x, -1.0)) / s;
    }
    int ni = (int)n;                        // integer: Y0,Y1 + upward recurrence
    double y0 = Y0_small(x), y1 = Y1_small(x);
    if (ni == 0) return y0;
    if (ni == 1) return y1;
    double ym = y0, yc = y1;
    for (int k = 1; k < ni; ++k) { double yn = (2.0 * k / x) * yc - ym; ym = yc; yc = yn; }
    return yc;
}
inline double cyl_bessel_k(double nu, double x) {
    if (isnan(nu) || isnan(x) || x < 0.0) return kQNaN;
    if (x == 0.0) return kInf;
    if (x >= kBesRecSeam) return besK_rec(nu, x);
    double n = floor(nu + 0.5);
    if (fabs(nu - n) > 1e-7) {              // non-integer: reflection
        double s = sin(nu * kPi);
        return (kPi / (2.0 * s)) * (bes_series(-nu, x, 1.0) - bes_series(nu, x, 1.0));
    }
    int ni = (int)n;                        // integer: K0,K1 + upward recurrence
    double k0 = K0_small(x), k1 = K1_small(x);
    if (ni == 0) return k0;
    if (ni == 1) return k1;
    double km = k0, kc = k1;
    for (int k = 1; k < ni; ++k) { double kn = (2.0 * k / x) * kc + km; km = kc; kc = kn; }
    return kc;
}
// ── spherical ──────────────────────────────────────────────────────────────
inline double sph_bessel(unsigned n, double x) {
    if (isnan(x)) return kQNaN;
    if (x == 0.0) return n == 0 ? 1.0 : 0.0;
    if ((double)n <= x) {                   // upward recurrence stable for x≥n
        double j0 = sin(x) / x, j1 = sin(x) / (x * x) - cos(x) / x;
        if (n == 0) return j0;
        if (n == 1) return j1;
        double jm = j0, jc = j1;
        for (unsigned k = 1; k < n; ++k) { double jn = (2.0 * k + 1.0) / x * jc - jm; jm = jc; jc = jn; }
        return jc;
    }
    // x<n: downward (Miller) recurrence, normalize by true j_0
    int M = (int)n + 15 + (int)sqrt(40.0 * n);
    double jp1 = 0.0, jc = 1e-280, jn_u = 0.0;        // j_{M+1}=0, j_M=eps
    for (int k = M; k >= 1; --k) {
        double jm1 = (2.0 * k + 1.0) / x * jc - jp1;  // j_{k-1}
        if (k == (int)n) jn_u = jc;                   // capture j_n
        jp1 = jc; jc = jm1;
        if (fabs(jc) > 1e250) { jc *= 1e-280; jp1 *= 1e-280; jn_u *= 1e-280; }
    }
    return jn_u * (sin(x) / x) / jc;                  // jc = j_0 (unnormalized)
}
inline double sph_neumann(unsigned n, double x) {
    if (isnan(x)) return kQNaN;
    if (x == 0.0) return -kInf;
    double y0 = -cos(x) / x, y1 = -cos(x) / (x * x) - sin(x) / x;
    if (n == 0) return y0;
    if (n == 1) return y1;
    double ym = y0, yc = y1;
    for (unsigned k = 1; k < n; ++k) { double yn = (2.0 * k + 1.0) / x * yc - ym; ym = yc; yc = yn; }
    return yc;
}
