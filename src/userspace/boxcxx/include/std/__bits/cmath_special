// ── beta(a,b) = Γ(a)Γ(b)/Γ(a+b) ───────────────────────────────────────────
inline double beta(double a, double b) {
    if (isnan(a) || isnan(b)) return kQNaN;
    return exp(lgamma(a) + lgamma(b) - lgamma(a + b));
}

// ── Legendre polynomials P_n(x) ────────────────────────────────────────────
inline double legendre(unsigned n, double x) {
    if (n == 0) return 1.0;
    double p0 = 1.0, p1 = x;
    for (unsigned k = 1; k < n; ++k) {
        double p2 = ((2.0 * k + 1.0) * x * p1 - k * p0) / (k + 1.0);
        p0 = p1; p1 = p2;
    }
    return p1;
}
// ── Associated Legendre P_l^m(x) (no Condon-Shortley phase per [sf.cmath]) ──
inline double assoc_legendre(unsigned l, unsigned m, double x) {
    if (m > l) return 0.0;
    double pmm = 1.0;
    if (m > 0) {
        double s = sqrt((1.0 - x) * (1.0 + x)), f = 1.0;
        for (unsigned i = 1; i <= m; ++i) { pmm *= f * s; f += 2.0; }   // (2m−1)!!·(1−x²)^{m/2}
    }
    if (l == m) return pmm;
    double pmp1 = x * (2.0 * m + 1.0) * pmm;
    if (l == m + 1) return pmp1;
    double pll = 0.0;
    for (unsigned ll = m + 2; ll <= l; ++ll) {
        pll = ((2.0 * ll - 1.0) * x * pmp1 - (ll + m - 1.0) * pmm) / (ll - m);
        pmm = pmp1; pmp1 = pll;
    }
    return pll;
}
// ── Laguerre L_n(x) and associated L_n^m(x) ────────────────────────────────
inline double laguerre(unsigned n, double x) {
    if (n == 0) return 1.0;
    double l0 = 1.0, l1 = 1.0 - x;
    for (unsigned k = 1; k < n; ++k) {
        double l2 = ((2.0 * k + 1.0 - x) * l1 - k * l0) / (k + 1.0);
        l0 = l1; l1 = l2;
    }
    return l1;
}
inline double assoc_laguerre(unsigned n, unsigned m, double x) {
    if (n == 0) return 1.0;
    double l0 = 1.0, l1 = 1.0 + m - x;
    for (unsigned k = 1; k < n; ++k) {
        double l2 = ((2.0 * k + 1.0 + m - x) * l1 - (k + m) * l0) / (k + 1.0);
        l0 = l1; l1 = l2;
    }
    return l1;
}
// ── Hermite H_n(x) (physicists') ───────────────────────────────────────────
inline double hermite(unsigned n, double x) {
    if (n == 0) return 1.0;
    double h0 = 1.0, h1 = 2.0 * x;
    for (unsigned k = 1; k < n; ++k) { double h2 = 2.0 * x * h1 - 2.0 * k * h0; h0 = h1; h1 = h2; }
    return h1;
}
// ── Spherical-harmonic-normalized associated Legendre ──────────────────────
inline double sph_legendre(unsigned l, unsigned m, double theta) {
    if (m > l) return 0.0;
    double x = cos(theta);
    double plm = assoc_legendre(l, m, x);
    double ratio = 1.0;
    for (unsigned k = l - m + 1; k <= l + m; ++k) ratio /= (double)k;   // (l−m)!/(l+m)!
    double norm = sqrt((2.0 * l + 1.0) / (4.0 * kPi) * ratio);
    double cs = (m & 1u) ? -1.0 : 1.0;                                  // Condon-Shortley
    return cs * norm * plm;
}

