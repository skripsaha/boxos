// ── Borwein d-array for the n-term Chebyshev-accelerated Dirichlet eta ──────
// d[0]=n; d[k]=d[k-1]+t[k] where t[k]=t[k-1]*(n+k-1)*(n-k+1)*4/((2k-1)*(2k))
inline void build_borwein_d(int n, double *d) {
    d[0] = (double)n;
    double term = (double)n;
    for (int k = 1; k <= n; ++k) {
        term *= (double)(n + k - 1) * 4.0 * (double)(n - k + 1);
        term /= (double)(2 * k - 1) * (double)(2 * k);
        d[k] = d[k - 1] + term;
    }
}

// ── riemann_zeta ────────────────────────────────────────────────────────────
// s > 1 and 0 < s < 1: Borwein n=34 alternating-eta, η(s)/(1−2^{1−s}).
// s < 0: functional equation ζ(s)=2^s·π^{s−1}·sin(πs/2)·Γ(1−s)·ζ(1−s).
// Negative even integers (trivial zeros): return 0 exactly.
// s=0: −½; s=1: +∞.
inline double riemann_zeta(double s) {
    if (std::isnan(s)) return s;

    if (s < 0.0 && s == std::floor(s) && std::fmod(-s, 2.0) == 0.0)
        return 0.0;

    if (s == 0.0) return -0.5;
    if (s == 1.0) return std::kInf;

    if (s < 0.0) {
        double t = 1.0 - s;
        double sinval = std::sin(std::kPi * s * 0.5);
        if (sinval == 0.0) return 0.0;
        double factor = std::pow(2.0, s)
                      * std::pow(std::kPi, s - 1.0)
                      * sinval
                      * std::tgamma(t);
        return factor * std::riemann_zeta(t);
    }

    const int n = 34;
    double d[n + 1];
    build_borwein_d(n, d);
    double dn = d[n];

    double sum = 0.0, sign = 1.0;
    for (int k = 0; k < n; ++k) {
        sum += sign * (d[k] - dn) * std::pow((double)(k + 1), -s);
        sign = -sign;
    }
    double eta = -sum / dn;
    double denom = 1.0 - std::pow(2.0, 1.0 - s);
    if (std::fabs(denom) < 1e-15) return std::kInf;
    return eta / denom;
}

