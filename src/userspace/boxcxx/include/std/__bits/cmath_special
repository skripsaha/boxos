// ── expint helpers ──────────────────────────────────────────────────────────
constexpr double kEulerGamma = 0.5772156649015328606065120900824;

// E1(z) for z ≤ 1: alternating series -γ - ln(z) + Σ_{k≥1} (-1)^{k+1} z^k/(k·k!)
// term recurrence: term_{k+1} = term_k · z·k / (k+1)²
static double e1_series(double z) {
    double term = z, sum = 0.0, sign = 1.0;
    for (int k = 1; k <= 300; ++k) {
        sum += sign * term;
        sign = -sign;
        term *= z * (double)k / ((double)(k + 1) * (double)(k + 1));
        if (term < 1e-20 * std::fabs(sum) + 1e-308) break;
    }
    return -kEulerGamma - std::log(z) + sum;
}

// E1(z) for z > 1: even-contraction CF (A&S 5.1.22 contraction)
// E1(z)·e^z = 1/(z+1 − 1²/(z+3 − 2²/(z+5 − ...)))
// Modified Lentz: b_n=z+(2n-1), a_n=1 (n=1), -(n-1)² (n≥2)
static double e1_cf(double z) {
    const double tiny = 1e-300;
    double f = tiny, C = f, D = 0.0;
    for (int n = 1; n <= 300; ++n) {
        double bn = z + (double)(2 * n - 1);
        double an = (n == 1) ? 1.0 : -(double)((n - 1) * (n - 1));
        D = bn + an * D; if (std::fabs(D) < tiny) D = tiny; D = 1.0 / D;
        C = bn + an / C; if (std::fabs(C) < tiny) C = tiny;
        double delta = C * D; f *= delta;
        if (std::fabs(delta - 1.0) < 1e-17) break;
    }
    return std::exp(-z) * f;
}

// Ei(x) for 0 < x ≤ 40: convergent series γ + ln x + Σ_{k≥1} x^k/(k·k!)
// (all terms positive; no cancellation; converges in ~x+20 iterations)
static double ei_series(double x) {
    double term = x, sum = 0.0;
    for (int k = 1; k <= 300; ++k) {
        sum += term;
        term *= x * (double)k / ((double)(k + 1) * (double)(k + 1));
        if (term < 1e-20 * sum + 1e-308) break;
    }
    return kEulerGamma + std::log(x) + sum;
}

// Ei(x) for x > 40: asymptotic (e^x/x)·Σ_{k≥0} k!/x^k, truncated at minimum term
// Accurate to ≤ 5 ULP for x ≥ 40; gracefully divergent-truncated for smaller x.
static double ei_asymptotic(double x) {
    double sum = 1.0, term = 1.0, prev = 0.0;
    for (int k = 1; k <= 300; ++k) {
        term *= (double)k / x;
        if (term > prev && k > 4) break;
        sum += term; prev = term;
        if (term < 1e-20 * sum) break;
    }
    return std::exp(x) / x * sum;
}

// ── expint: Ei(x) as defined by std::expint ────────────────────────────────
// x > 0: Ei(x) = γ + ln x + Σ_{k≥1} x^k/(k·k!)
// x < 0: Ei(x) = −E₁(−x)
// x = 0: −∞
inline double expint(double x) {
    if (std::isnan(x)) return x;
    if (x == 0.0) return -std::kInf;
    if (std::isinf(x)) return (x > 0.0) ? std::kInf : 0.0;
    if (x > 0.0) return (x <= 40.0) ? ei_series(x) : ei_asymptotic(x);
    double z = -x;
    return -(z <= 1.0 ? e1_series(z) : e1_cf(z));
}

