// boxcxx — <__bits/ranges_algo_set>
// Ф29b-2, third file: the ranges:: MERGE ([alg.merge]) and SET-operation
// ([alg.set.operations]) niebloids. Pulled in by <algorithm> last, after
// <__bits/ranges_algo_mut> and <__bits/ranges_algo_sort> — it reuses
// ranges::copy (from _mut) to drain the tails and __algo::SortComp (from _sort)
// for the inplace_merge delegation.
//
// merge / set_* are implemented directly rather than delegated: their ranges
// results report where BOTH inputs stopped (in_in_out_result) or the first input
// plus output (in_out_result), which the classic std:: overloads — returning
// only the output iterator — cannot supply. inplace_merge, whose ranges result
// is just the end iterator, delegates to the tested classic engine.
#ifndef BOXCXX_BITS_RANGES_ALGO_SET
#define BOXCXX_BITS_RANGES_ALGO_SET

// Self-contained: in_in_out_result/in_out_result live in <__bits/ranges_algo>;
// merge/set_* also call ranges::copy (<__bits/ranges_algo_mut>) to drain
// tails and __algo::SortComp (<__bits/ranges_algo_sort>) for the
// inplace_merge delegation, plus classic std::inplace_merge directly (from
// <__bits/algorithm_classic>, the classic-algorithms leaf -- see
// ranges_algo_mut's identical note on why not <algorithm> itself). No longer
// relying on <algorithm>'s fixed include order to see any of the four first.
#include <__bits/algorithm_classic>
#include <__bits/ranges_algo>
#include <__bits/ranges_algo_mut>
#include <__bits/ranges_algo_sort>
#include <functional>
#include <ranges>
#include <utility>

namespace std {
namespace ranges {

// ── result-type aliases ([algorithms.results]) ───────────────────────────
template <class I1, class I2, class O>
using merge_result = in_in_out_result<I1, I2, O>;
template <class I1, class I2, class O>
using set_union_result = in_in_out_result<I1, I2, O>;
template <class I1, class I2, class O>
using set_intersection_result = in_in_out_result<I1, I2, O>;
template <class I, class O> using set_difference_result = in_out_result<I, O>;
template <class I1, class I2, class O>
using set_symmetric_difference_result = in_in_out_result<I1, I2, O>;

// ════════════════════════════════════════════════════════════════════════
// merge / inplace_merge ([alg.merge])
// ════════════════════════════════════════════════════════════════════════

struct Merge {
    template <input_iterator I1, sentinel_for<I1> S1, input_iterator I2,
              sentinel_for<I2> S2, weakly_incrementable O,
              class Comp = ranges::less, class Proj1 = identity,
              class Proj2 = identity>
        requires mergeable<I1, I2, O, Comp, Proj1, Proj2>
    constexpr merge_result<I1, I2, O>
    operator()(I1 first1, S1 last1, I2 first2, S2 last2, O result,
               Comp comp = {}, Proj1 proj1 = {}, Proj2 proj2 = {}) const
    {
        for (; first1 != last1 && first2 != last2; ++result) {
            // Take from range 2 only when it compares strictly less — a tie
            // keeps range 1's element first, giving a stable merge.
            if (std::invoke(comp, std::invoke(proj2, *first2),
                            std::invoke(proj1, *first1))) {
                *result = *first2;
                ++first2;
            } else {
                *result = *first1;
                ++first1;
            }
        }
        auto c1 = ranges::copy(std::move(first1), std::move(last1),
                               std::move(result));
        auto c2 = ranges::copy(std::move(first2), std::move(last2),
                               std::move(c1.out));
        return {std::move(c1.in), std::move(c2.in), std::move(c2.out)};
    }
    template <input_range R1, input_range R2, weakly_incrementable O,
              class Comp = ranges::less, class Proj1 = identity,
              class Proj2 = identity>
        requires mergeable<iterator_t<R1>, iterator_t<R2>, O, Comp, Proj1, Proj2>
    constexpr merge_result<borrowed_iterator_t<R1>, borrowed_iterator_t<R2>, O>
    operator()(R1 &&r1, R2 &&r2, O result, Comp comp = {}, Proj1 proj1 = {},
               Proj2 proj2 = {}) const
    {
        return (*this)(ranges::begin(r1), ranges::end(r1), ranges::begin(r2),
                       ranges::end(r2), std::move(result), std::move(comp),
                       std::move(proj1), std::move(proj2));
    }
};
inline constexpr Merge merge{};

struct InplaceMerge {
    template <bidirectional_iterator I, sentinel_for<I> S,
              class Comp = ranges::less, class Proj = identity>
        requires sortable<I, Comp, Proj>
    // Constexpr since P2562R1: the classic std::inplace_merge is the rotate
    // merge and never allocated in the first place.
    constexpr I operator()(I first, I middle, S last, Comp comp = {},
                           Proj proj = {}) const
    {
        I last_it = ranges::next(first, last);
        std::inplace_merge(std::move(first), std::move(middle), last_it,
                          __algo::SortComp(comp, proj));
        return last_it;
    }
    template <bidirectional_range R, class Comp = ranges::less,
              class Proj = identity>
        requires sortable<iterator_t<R>, Comp, Proj>
    constexpr borrowed_iterator_t<R> operator()(R &&r, iterator_t<R> middle,
                                                Comp comp = {}, Proj proj = {}) const
    {
        return (*this)(ranges::begin(r), std::move(middle), ranges::end(r),
                       std::move(comp), std::move(proj));
    }
};
inline constexpr InplaceMerge inplace_merge{};

