// boxcxx — <__bits/pointer>
// pointer_traits + to_address. Lives in __bits so <iterator> can complete
// the contiguous_iterator concept (it needs to_address) before <memory>
// re-exports the full set.
#ifndef BOXCXX_BITS_POINTER
#define BOXCXX_BITS_POINTER

#include <cstddef>
#include <type_traits>

namespace std {

namespace __ptr_impl {

// element_type: Ptr::element_type if present, else the first type argument
// of a Ptr = Template<First, Rest...>.
template <class Ptr>
struct ElemType {};
template <class Ptr>
    requires requires { typename Ptr::element_type; }
struct ElemType<Ptr> {
    using type = typename Ptr::element_type;
};
template <template <class, class...> class T, class First, class... Rest>
    requires(!requires { typename T<First, Rest...>::element_type; })
struct ElemType<T<First, Rest...>> {
    using type = First;
};

// difference_type: Ptr::difference_type if present, else ptrdiff_t.
template <class Ptr>
struct DiffType {
    using type = ptrdiff_t;
};
template <class Ptr>
    requires requires { typename Ptr::difference_type; }
struct DiffType<Ptr> {
    using type = typename Ptr::difference_type;
};

// rebind: Ptr::rebind<U> if present, else Template<U, Rest...>.
template <class Ptr, class U>
struct Rebind {};
template <class Ptr, class U>
    requires requires { typename Ptr::template rebind<U>; }
struct Rebind<Ptr, U> {
    using type = typename Ptr::template rebind<U>;
};
template <template <class, class...> class T, class First, class... Rest,
          class U>
    requires(!requires { typename T<First, Rest...>::template rebind<U>; })
struct Rebind<T<First, Rest...>, U> {
    using type = T<U, Rest...>;
};

} // namespace __ptr_impl

template <class Ptr>
struct pointer_traits {
    using pointer         = Ptr;
    using element_type    = typename __ptr_impl::ElemType<Ptr>::type;
    using difference_type = typename __ptr_impl::DiffType<Ptr>::type;
    template <class U>
    using rebind = typename __ptr_impl::Rebind<Ptr, U>::type;

    static constexpr pointer pointer_to(element_type &r)
        requires requires { Ptr::pointer_to(r); }
    {
        return Ptr::pointer_to(r);
    }
};

template <class T>
struct pointer_traits<T *> {
    using pointer         = T *;
    using element_type    = T;
    using difference_type = ptrdiff_t;
    template <class U>
    using rebind = U *;

    static constexpr pointer pointer_to(
        conditional_t<is_void_v<T>, char, T> &r) noexcept
    {
        return __builtin_addressof(r);
    }
};

// ── to_address ([pointer.conversion]) ────────────────────────────────────

template <class T>
constexpr T *to_address(T *p) noexcept
{
    static_assert(!is_function_v<T>, "to_address must not be a function ptr");
    return p;
}

template <class Ptr>
constexpr auto to_address(const Ptr &p) noexcept
{
    if constexpr (requires { pointer_traits<Ptr>::to_address(p); })
        return pointer_traits<Ptr>::to_address(p);
    else
        return to_address(p.operator->());
}

} // namespace std

#endif // BOXCXX_BITS_POINTER
