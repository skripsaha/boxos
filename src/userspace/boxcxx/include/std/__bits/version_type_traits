// boxcxx — <__bits/version_type_traits>
//
// The feature-test macros [version.syn] owned by <type_traits>.
//
// __cpp_lib_reference_from_temporary mirrors <type_traits>'s own
// __has_builtin guard: both traits it names are compiler-builtin-backed
// with no library fallback, so the macro must appear exactly when they do.
//
// Deliberately absent (see <version>'s list): is_swappable,
// is_layout_compatible, is_pointer_interconvertible, is_implicit_lifetime,
// common_reference, transformation_trait_aliases, result_of_sfinae.
#ifndef BOXCXX_BITS_VERSION_TYPE_TRAITS
#define BOXCXX_BITS_VERSION_TYPE_TRAITS

#ifndef __cpp_lib_bool_constant
#  define __cpp_lib_bool_constant 201505L
#endif
