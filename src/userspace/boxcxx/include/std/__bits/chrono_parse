template <class charT, class traits, class Rep, class Period,
          class Alloc = allocator<charT>>
basic_istream<charT, traits> &
from_stream(basic_istream<charT, traits> &is, const charT *fmt,
            duration<Rep, Period> &d,
            basic_string<charT, traits, Alloc> *abbrev = nullptr,
            minutes *offset = nullptr)
{
    BOXCXX_PARSE_PROLOGUE
    using D = duration<Rep, Period>;

    if (f.q_value != __parse::kNone) {
        // %Q with %q: a number and the unit it is counted in.
        if (f.q_unit_num == __parse::kNone) {
            // %Q alone is the duration's own rep, which is what the writer
            // emitted it as.
            d = D(static_cast<Rep>(f.q_value));
        } else {
            // ticks = value * (unit / period). Routing that through
            // nanoseconds was the obvious way and it loses everything finer
            // than one: an attosecond unit divides to zero before the target
            // ever sees it. The ratio is reduced against the target's period
            // first, so the round trip a writer produces cancels exactly
            // instead of merely coming close.
            using Per = typename D::period;
            long long un = f.q_unit_num, ud = f.q_unit_den;
            long long pn = Per::num,     pd = Per::den;
            const auto gcd = [](long long a, long long b) {
                while (b) { const long long t = a % b; a = b; b = t; }
                return a < 0 ? -a : a;
            };
            long long g = gcd(un, pn); un /= g; pn /= g;
            g = gcd(ud, pd); ud /= g; pd /= g;
            d = D(static_cast<Rep>(f.q_value * un * pd / (ud * pn)));
        }
        return is;
    }

    long long total = 0;
    bool any = false;
    if (f.hour   != __parse::kNone) { total += f.hour * 3600LL;  any = true; }
    if (f.minute != __parse::kNone) { total += f.minute * 60LL;  any = true; }
    if (f.second != __parse::kNone) { total += f.second;         any = true; }
    if (f.yday   != __parse::kNone) { total += f.yday * 86400LL; any = true; }
    if (!any) {
        is.setstate(ios_base::failbit);
        return is;
    }
    d = duration_cast<D>(seconds(total)) + __parse::FractionAs<D>(f);
    if (f.negative) d = -d;
    return is;
}

// ── the calendar types ──────────────────────────────────────────────────────

#define BOXCXX_PARSE_CAL(TYPE, NEED, BUILD)                                    \
    template <class charT, class traits, class Alloc = allocator<charT>>       \
    basic_istream<charT, traits> &from_stream(                                 \
        basic_istream<charT, traits> &is, const charT *fmt, TYPE &out,         \
        basic_string<charT, traits, Alloc> *abbrev = nullptr,                  \
        minutes *offset = nullptr)                                             \
    {                                                                          \
        BOXCXX_PARSE_PROLOGUE                                                  \
        if (!(NEED)) { is.setstate(ios_base::failbit); return is; }            \
        out = BUILD;                                                           \
        return is;                                                             \
    }

BOXCXX_PARSE_CAL(chrono::day, f.day != __parse::kNone,
                 chrono::day(unsigned(f.day)))
BOXCXX_PARSE_CAL(chrono::month, f.month != __parse::kNone,
                 chrono::month(unsigned(f.month)))
BOXCXX_PARSE_CAL(chrono::year, f.year != __parse::kNone,
                 chrono::year(f.year))
BOXCXX_PARSE_CAL(chrono::weekday, f.wday != __parse::kNone,
                 chrono::weekday(unsigned(f.wday)))
BOXCXX_PARSE_CAL(chrono::month_day,
                 f.month != __parse::kNone && f.day != __parse::kNone,
                 chrono::month_day(chrono::month(unsigned(f.month)),
                                   chrono::day(unsigned(f.day))))
BOXCXX_PARSE_CAL(chrono::year_month,
                 f.year != __parse::kNone && f.month != __parse::kNone,
                 chrono::year_month(chrono::year(f.year),
                                    chrono::month(unsigned(f.month))))
BOXCXX_PARSE_CAL(chrono::year_month_day, __parse::HasDate(f),
                 chrono::year_month_day(chrono::year(f.year),
                                        chrono::month(unsigned(f.month)),
                                        chrono::day(unsigned(f.day))))

#undef BOXCXX_PARSE_CAL
#undef BOXCXX_PARSE_PROLOGUE

// ── [time.parse] parse() ────────────────────────────────────────────────────
// The manipulators. Each holds what it was given and does the work in its
// extractor, so `is >> parse("%F", ymd)` reads exactly like every other
// extraction — which is the point of them.

namespace __parse {

template <class charT, class Parsable>
struct Manip {
    const charT *fmt;
    Parsable    *tp;
};

template <class charT, class Parsable, class String>
struct ManipAbbrev {
    const charT *fmt;
    Parsable    *tp;
    String      *abbrev;
};

template <class charT, class Parsable>
struct ManipOffset {
    const charT *fmt;
    Parsable    *tp;
    minutes     *offset;
};

template <class charT, class Parsable, class String>
struct ManipBoth {
    const charT *fmt;
    Parsable    *tp;
    String      *abbrev;
    minutes     *offset;
};

} // namespace __parse

template <class charT, class Parsable>
__parse::Manip<charT, Parsable> parse(const charT *fmt, Parsable &tp)
{
    return {fmt, &tp};
}

template <class charT, class traits, class Alloc, class Parsable>
__parse::Manip<charT, Parsable>
parse(const basic_string<charT, traits, Alloc> &fmt, Parsable &tp)
{
    return {fmt.c_str(), &tp};
}

template <class charT, class Parsable, class traits, class Alloc>
__parse::ManipAbbrev<charT, Parsable, basic_string<charT, traits, Alloc>>
parse(const charT *fmt, Parsable &tp, basic_string<charT, traits, Alloc> &abbrev)
{
    return {fmt, &tp, &abbrev};
}

template <class charT, class traits, class Alloc, class Parsable>
__parse::ManipAbbrev<charT, Parsable, basic_string<charT, traits, Alloc>>
parse(const basic_string<charT, traits, Alloc> &fmt, Parsable &tp,
      basic_string<charT, traits, Alloc> &abbrev)
{
    return {fmt.c_str(), &tp, &abbrev};
}

template <class charT, class Parsable>
__parse::ManipOffset<charT, Parsable>
parse(const charT *fmt, Parsable &tp, minutes &offset)
{
    return {fmt, &tp, &offset};
}

template <class charT, class traits, class Alloc, class Parsable>
__parse::ManipOffset<charT, Parsable>
parse(const basic_string<charT, traits, Alloc> &fmt, Parsable &tp, minutes &offset)
{
    return {fmt.c_str(), &tp, &offset};
}

template <class charT, class Parsable, class traits, class Alloc>
__parse::ManipBoth<charT, Parsable, basic_string<charT, traits, Alloc>>
parse(const charT *fmt, Parsable &tp, basic_string<charT, traits, Alloc> &abbrev,
      minutes &offset)
{
    return {fmt, &tp, &abbrev, &offset};
}

template <class charT, class traits, class Alloc, class Parsable>
__parse::ManipBoth<charT, Parsable, basic_string<charT, traits, Alloc>>
parse(const basic_string<charT, traits, Alloc> &fmt, Parsable &tp,
      basic_string<charT, traits, Alloc> &abbrev, minutes &offset)
{
    return {fmt.c_str(), &tp, &abbrev, &offset};
}

template <class charT, class traits, class Parsable>
basic_istream<charT, traits> &
operator>>(basic_istream<charT, traits> &is, __parse::Manip<charT, Parsable> m)
{
    basic_string<charT, traits> *none = nullptr;
    return from_stream(is, m.fmt, *m.tp, none, static_cast<minutes *>(nullptr));
}

template <class charT, class traits, class Parsable, class String>
basic_istream<charT, traits> &
operator>>(basic_istream<charT, traits> &is,
           __parse::ManipAbbrev<charT, Parsable, String> m)
{
    return from_stream(is, m.fmt, *m.tp, m.abbrev, static_cast<minutes *>(nullptr));
}

template <class charT, class traits, class Parsable>
basic_istream<charT, traits> &
operator>>(basic_istream<charT, traits> &is,
           __parse::ManipOffset<charT, Parsable> m)
{
    basic_string<charT, traits> *none = nullptr;
    return from_stream(is, m.fmt, *m.tp, none, m.offset);
}

template <class charT, class traits, class Parsable, class String>
basic_istream<charT, traits> &
operator>>(basic_istream<charT, traits> &is,
           __parse::ManipBoth<charT, Parsable, String> m)
{
    return from_stream(is, m.fmt, *m.tp, m.abbrev, m.offset);
}

