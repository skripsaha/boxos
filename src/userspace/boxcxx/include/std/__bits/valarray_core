// ── [valarray.special] and [valarray.range] ─────────────────────────────
template <class T> inline void swap(valarray<T> &a, valarray<T> &b) noexcept
{
    a.swap(b);
}

template <class T> inline T *begin(valarray<T> &v)
{
    return v.size() ? &v[0] : nullptr;
}
template <class T> inline const T *begin(const valarray<T> &v)
{
    return v.size() ? &v[0] : nullptr;
}
template <class T> inline T *end(valarray<T> &v)
{
    return begin(v) + v.size();
}
template <class T> inline const T *end(const valarray<T> &v)
{
    return begin(v) + v.size();
}

