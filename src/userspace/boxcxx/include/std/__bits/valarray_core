};

#undef BOXCXX_VA_PROXY_OP
#undef BOXCXX_VA_PROXY_OPS

// ── valarray, the parts that needed the proxies ─────────────────────────
template <class T>
valarray<T>::valarray(const slice_array<T> &s) : valarray(s.GatherOrder())
{
}
template <class T>
valarray<T>::valarray(const gslice_array<T> &s) : valarray(s.GatherOrder())
{
}
template <class T>
valarray<T>::valarray(const mask_array<T> &s) : valarray(s.GatherOrder())
{
}
template <class T>
valarray<T>::valarray(const indirect_array<T> &s) : valarray(s.GatherOrder())
{
}

template <class T> valarray<T> &valarray<T>::operator=(const slice_array<T> &s)
{
    Put(s.GatherOrder(), s.Count());
    return *this;
}
template <class T> valarray<T> &valarray<T>::operator=(const gslice_array<T> &s)
{
    Put(s.GatherOrder(), s.Count());
    return *this;
}
template <class T> valarray<T> &valarray<T>::operator=(const mask_array<T> &s)
{
    Put(s.GatherOrder(), s.Count());
    return *this;
}
template <class T> valarray<T> &valarray<T>::operator=(const indirect_array<T> &s)
{
    Put(s.GatherOrder(), s.Count());
    return *this;
}

template <class T> valarray<T> valarray<T>::operator[](slice s) const
{
    const __va::SliceMap m{s.start(), s.size(), s.stride()};
    return valarray(__va_gather<T, __va::SliceMap>{p_, &m});
}
template <class T> slice_array<T> valarray<T>::operator[](slice s)
{
    return slice_array<T>(p_, __va::SliceMap{s.start(), s.size(), s.stride()});
}

template <class T> valarray<T> valarray<T>::operator[](const gslice &g) const
{
    const __va::GsliceMap m = g.Map();
    return valarray(__va_gather<T, __va::GsliceMap>{p_, &m});
}
template <class T> gslice_array<T> valarray<T>::operator[](const gslice &g)
{
    return gslice_array<T>(p_, g.Map());
}

template <class T> valarray<T> valarray<T>::operator[](const valarray<bool> &mask) const
{
    const __va::OwnMap m = __va::MaskMap(mask, n_);
    return valarray(__va_gather<T, __va::OwnMap>{p_, &m});
}
template <class T> mask_array<T> valarray<T>::operator[](const valarray<bool> &mask)
{
    return mask_array<T>(p_, __va::MaskMap(mask, n_));
}

template <class T> valarray<T> valarray<T>::operator[](const valarray<size_t> &ix) const
{
    const __va::ListMap m{ix.size() ? &ix[0] : nullptr, ix.size()};
    return valarray(__va_gather<T, __va::ListMap>{p_, &m});
}
template <class T> indirect_array<T> valarray<T>::operator[](const valarray<size_t> &ix)
{
    return indirect_array<T>(p_, __va::ListMap{ix.size() ? &ix[0] : nullptr, ix.size()});
}

// ── [valarray.binary], [valarray.comparison], [valarray.transcend] ──────
// Eight forms of each operator, because either side may be an array, an order
// or a scalar, and the standard's three are only the array ones —
// [valarray.syn]/4 asks for "every combination of const valarray<T>& and
// replacement types". They are all in std, for the reason given where the
// order types are defined. The result element type is T for arithmetic and
// bool for the comparisons: `a == b` on two valarray<double> is a
// valarray<bool>, and `a + b` on two valarray<char> is a valarray<char>
// rather than the valarray<int> the promotion would give.
//
// The operator LIST is written once and handed to the form-generating macro.
namespace __va {
template <class R, class Op, class A, class B>
inline __va_bin<R, Op, A, B> Make(const A &a, const B &b)
{
    return __va_bin<R, Op, A, B>{a, b};
}
} // namespace __va

#define BOXCXX_VA_SELF(T) T
#define BOXCXX_VA_BOOL(T) bool
#define BOXCXX_VA_ELEM(E) typename E::value_type

#define BOXCXX_VA_FORMS(OP, FN, RES)                                                       \
    template <class T> inline auto OP(const valarray<T> &a, const valarray<T> &b)          \
    {                                                                                      \
        return __va::Make<RES(T), __va::FN>(__va::MakeRef(a), __va::MakeRef(b));           \
    }                                                                                      \
    template <class T> inline auto OP(const valarray<T> &a, const T &v)                    \
    {                                                                                      \
        return __va::Make<RES(T), __va::FN>(__va::MakeRef(a), __va_same<T>{v});            \
    }                                                                                      \
    template <class T> inline auto OP(const T &v, const valarray<T> &b)                    \
    {                                                                                      \
        return __va::Make<RES(T), __va::FN>(__va_same<T>{v}, __va::MakeRef(b));            \
    }                                                                                      \
    template <class E, class F,                                                            \
              enable_if_t<__va::IsOrder<E> && __va::IsOrder<F>, int> = 0>                  \
    inline auto OP(const E &a, const F &b)                                                 \
    {                                                                                      \
        return __va::Make<RES(BOXCXX_VA_ELEM(E)), __va::FN>(a, b);                         \
    }                                                                                      \
    template <class E, class T, enable_if_t<__va::IsOrder<E>, int> = 0>                    \
    inline auto OP(const E &a, const valarray<T> &b)                                       \
    {                                                                                      \
        return __va::Make<RES(T), __va::FN>(a, __va::MakeRef(b));                          \
    }                                                                                      \
    template <class T, class F, enable_if_t<__va::IsOrder<F>, int> = 0>                    \
    inline auto OP(const valarray<T> &a, const F &b)                                       \
    {                                                                                      \
        return __va::Make<RES(T), __va::FN>(__va::MakeRef(a), b);                          \
    }                                                                                      \
    template <class E, enable_if_t<__va::IsOrder<E>, int> = 0>                             \
    inline auto OP(const E &a, const BOXCXX_VA_ELEM(E) & v)                                \
    {                                                                                      \
        return __va::Make<RES(BOXCXX_VA_ELEM(E)), __va::FN>(                               \
            a, __va_same<BOXCXX_VA_ELEM(E)>{v});                                           \
    }                                                                                      \
    template <class E, enable_if_t<__va::IsOrder<E>, int> = 0>                             \
    inline auto OP(const BOXCXX_VA_ELEM(E) & v, const E &b)                                \
    {                                                                                      \
        return __va::Make<RES(BOXCXX_VA_ELEM(E)), __va::FN>(                               \
            __va_same<BOXCXX_VA_ELEM(E)>{v}, b);                                           \
    }

