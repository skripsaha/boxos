    {
        I last_it   = ranges::next(first, last);
        bool found  = std::next_permutation(std::move(first), last_it,
                                            __algo::SortComp(comp, proj));
        return {std::move(last_it), found};
    }
    template <bidirectional_range R, class Comp = ranges::less,
              class Proj = identity>
        requires sortable<iterator_t<R>, Comp, Proj>
    constexpr next_permutation_result<borrowed_iterator_t<R>>
