// boxcxx — <__bits/par_numeric>
//
// The [numeric.ops] overloads that take an execution policy. Same shape as
// <__bits/par_algo>, one difference that matters: a reduction has a RESULT per
// chunk, so the chunks write into a small array indexed by the chunk number
// the brigade hands them, and the caller folds that array afterwards.
//
// The order of that fold is the caller's to accept, not ours to promise:
// [reduce] requires the operation to be associative AND commutative precisely
// so an implementation may group and order the work as it likes. That is the
// whole difference between reduce and accumulate, and it is why accumulate has
// no parallel overload at all.
#ifndef BOXCXX_BITS_PAR_NUMERIC
#define BOXCXX_BITS_PAR_NUMERIC

#include <__bits/execution_policy>
#include <__bits/par_algo>
#include <__bits/par_engine>

#include <functional>
#include <iterator>
#include <optional>
#include <vector>

namespace std {

namespace __par {

// A partial per chunk. optional, not T, because [reduce] asks only that T be
// move-constructible -- a T that cannot be assigned or default-constructed is
// still a valid reduction type, and emplace is how the partial arrives without
// requiring either.
template <class EP, class T, class Chunked>
inline T Fold(size_t n, const T &init, Chunked chunk, auto op)
{
    const size_t width = (WantsBrigade<EP> && !Nested()) ? Width() : 1;
    vector<optional<T>> partial(width);
    const size_t used = Region<EP>(n, [&](size_t idx, size_t b, size_t e) {
        partial[idx].emplace(chunk(b, e));
    });
    T acc = init;
    for (size_t i = 0; i < used; ++i)
        if (partial[i]) acc = op(acc, *partial[i]);
    return acc;
}

} // namespace __par

// ── [reduce] ────────────────────────────────────────────────────────────
template <class EP, class It, class T, class Binary>
    requires is_execution_policy_v<remove_cvref_t<EP>>
T reduce(EP &&, It first, It last, T init, Binary op)
{
    const size_t n = static_cast<size_t>(distance(first, last));
    if (n == 0) return init;
    return __par::Fold<EP, T>(
        n, init,
        [&](size_t b, size_t e) {
            It it = __par::At(first, b);
            T local(*it);
            ++it;
            for (size_t i = b + 1; i < e; ++i, ++it) local = op(std::move(local), *it);
            return local;
        },
        op);
}

template <class EP, class It, class T>
    requires is_execution_policy_v<remove_cvref_t<EP>>
T reduce(EP &&ep, It first, It last, T init)
{
    return reduce(static_cast<EP &&>(ep), first, last, std::move(init), plus<>());
}

template <class EP, class It>
    requires is_execution_policy_v<remove_cvref_t<EP>>
typename iterator_traits<It>::value_type reduce(EP &&ep, It first, It last)
{
    using T = typename iterator_traits<It>::value_type;
    return reduce(static_cast<EP &&>(ep), first, last, T{}, plus<>());
}

// ── [transform.reduce] ──────────────────────────────────────────────────
template <class EP, class It, class T, class Binary, class Unary>
    requires is_execution_policy_v<remove_cvref_t<EP>>
T transform_reduce(EP &&, It first, It last, T init, Binary reduce_op, Unary transform_op)
{
    const size_t n = static_cast<size_t>(distance(first, last));
    if (n == 0) return init;
    return __par::Fold<EP, T>(
        n, init,
        [&](size_t b, size_t e) {
            It it = __par::At(first, b);
            T local(transform_op(*it));
            ++it;
            for (size_t i = b + 1; i < e; ++i, ++it)
                local = reduce_op(std::move(local), transform_op(*it));
            return local;
        },
        reduce_op);
}

template <class EP, class It1, class It2, class T, class Binary1, class Binary2>
    requires is_execution_policy_v<remove_cvref_t<EP>>
T transform_reduce(EP &&, It1 first1, It1 last1, It2 first2, T init, Binary1 reduce_op,
                   Binary2 transform_op)
{
    const size_t n = static_cast<size_t>(distance(first1, last1));
    if (n == 0) return init;
    return __par::Fold<EP, T>(
        n, init,
        [&](size_t b, size_t e) {
            It1 a = __par::At(first1, b);
            It2 c = __par::At(first2, b);
            T local(transform_op(*a, *c));
            ++a;
            ++c;
            for (size_t i = b + 1; i < e; ++i, ++a, ++c)
                local = reduce_op(std::move(local), transform_op(*a, *c));
            return local;
        },
        reduce_op);
}

template <class EP, class It1, class It2, class T>
    requires is_execution_policy_v<remove_cvref_t<EP>>
T transform_reduce(EP &&ep, It1 first1, It1 last1, It2 first2, T init)
{
    return transform_reduce(static_cast<EP &&>(ep), first1, last1, first2, std::move(init),
                            plus<>(), multiplies<>());
}

// ── [numeric.ops.scan] : TWO PASS ───────────────────────────────────────
namespace __par {

// Chunk totals, a prefix over the totals, then each chunk writes its own scan
// from the offset it was handed. The operation has to be associative for that
// to be the same answer -- which every scan in [numeric.ops] requires, and
// which is the whole reason a scan can be split at all.
template <class EP, class It, class Out, class T, class Binary, class Unary>
inline void ScanCore(It first, size_t n, Out out, const T &init, bool inclusive, Binary op,
                     Unary tr)
{
    if (n == 0) return;

    auto run = [&](size_t b, size_t e, T acc) {
        It  it = At(first, b);
        Out o  = At(out, b);
        for (size_t i = b; i < e; ++i, ++it, ++o) {
            if (inclusive) {
                acc = op(std::move(acc), tr(*it));
                *o  = acc;
            } else {
                *o  = acc;
                acc = op(std::move(acc), tr(*it));
            }
        }
    };

    const size_t chunks = PlanFor<EP>(n);
    if (chunks < 2) {
        run(0, n, init);
        return;
    }

    vector<optional<T>> total(chunks);
    RegionExact<EP>(n, chunks, [&](size_t idx, size_t b, size_t e) {
        It it = At(first, b);
        T   acc(tr(*it));
        ++it;
        for (size_t i = b + 1; i < e; ++i, ++it) acc = op(std::move(acc), tr(*it));
        total[idx].emplace(std::move(acc));
    });

    vector<optional<T>> offset(chunks);
    offset[0].emplace(init);
    for (size_t i = 1; i < chunks; ++i) offset[i].emplace(op(*offset[i - 1], *total[i - 1]));

    RegionExact<EP>(n, chunks, [&](size_t idx, size_t b, size_t e) { run(b, e, *offset[idx]); });
}

struct Identity {
    template <class T>
    constexpr T &&operator()(T &&x) const noexcept
    {
        return static_cast<T &&>(x);
    }
};

} // namespace __par

template <class EP, class It, class Out, class T, class Binary>
    requires is_execution_policy_v<remove_cvref_t<EP>>
Out inclusive_scan(EP &&, It first, It last, Out out, Binary op, T init)
{
    const size_t n = static_cast<size_t>(distance(first, last));
    __par::ScanCore<EP>(first, n, out, init, true, op, __par::Identity{});
    return __par::At(out, n);
}

template <class EP, class It, class Out, class Binary>
    requires is_execution_policy_v<remove_cvref_t<EP>>
Out inclusive_scan(EP &&, It first, It last, Out out, Binary op)
{
    const size_t n = static_cast<size_t>(distance(first, last));
    if (n == 0) return out;
    // Without an init the first element IS the init, and the rest is the same
    // scan one position along.
    using T = typename iterator_traits<It>::value_type;
    T first_value(*first);
    *out = first_value;
    __par::ScanCore<EP>(__par::At(first, 1), n - 1, __par::At(out, 1), first_value, true, op,
                        __par::Identity{});
    return __par::At(out, n);
}

template <class EP, class It, class Out>
    requires is_execution_policy_v<remove_cvref_t<EP>>
Out inclusive_scan(EP &&ep, It first, It last, Out out)
{
    return inclusive_scan(static_cast<EP &&>(ep), first, last, out, plus<>());
}

template <class EP, class It, class Out, class T, class Binary>
    requires is_execution_policy_v<remove_cvref_t<EP>>
Out exclusive_scan(EP &&, It first, It last, Out out, T init, Binary op)
{
    const size_t n = static_cast<size_t>(distance(first, last));
    __par::ScanCore<EP>(first, n, out, init, false, op, __par::Identity{});
    return __par::At(out, n);
}

template <class EP, class It, class Out, class T>
    requires is_execution_policy_v<remove_cvref_t<EP>>
Out exclusive_scan(EP &&ep, It first, It last, Out out, T init)
{
    return exclusive_scan(static_cast<EP &&>(ep), first, last, out, std::move(init), plus<>());
}

template <class EP, class It, class Out, class Binary, class Unary, class T>
    requires is_execution_policy_v<remove_cvref_t<EP>>
Out transform_inclusive_scan(EP &&, It first, It last, Out out, Binary op, Unary tr, T init)
{
    const size_t n = static_cast<size_t>(distance(first, last));
    __par::ScanCore<EP>(first, n, out, init, true, op, tr);
    return __par::At(out, n);
}

template <class EP, class It, class Out, class Binary, class Unary>
    requires is_execution_policy_v<remove_cvref_t<EP>>
Out transform_inclusive_scan(EP &&, It first, It last, Out out, Binary op, Unary tr)
{
    const size_t n = static_cast<size_t>(distance(first, last));
    if (n == 0) return out;
    auto seed = tr(*first);
    *out      = seed;
    __par::ScanCore<EP>(__par::At(first, 1), n - 1, __par::At(out, 1), seed, true, op, tr);
    return __par::At(out, n);
}

template <class EP, class It, class Out, class T, class Binary, class Unary>
    requires is_execution_policy_v<remove_cvref_t<EP>>
Out transform_exclusive_scan(EP &&, It first, It last, Out out, T init, Binary op, Unary tr)
{
    const size_t n = static_cast<size_t>(distance(first, last));
    __par::ScanCore<EP>(first, n, out, init, false, op, tr);
    return __par::At(out, n);
}

// ── [adjacent.difference] : ELEMENT-WISE ────────────────────────────────
// Every output but the first depends on the element BEFORE it, which a chunk
// can read: element b-1 belongs to the chunk before and nobody is writing it,
// because [algorithms.parallel.overloads] forbids the ranges to overlap.
template <class EP, class It, class Out, class Binary>
    requires is_execution_policy_v<remove_cvref_t<EP>>
Out adjacent_difference(EP &&, It first, It last, Out out, Binary op)
{
    const size_t n = static_cast<size_t>(distance(first, last));
    if (n == 0) return out;
    __par::Region<EP>(n, [&](size_t, size_t b, size_t e) {
        Out o = __par::At(out, b);
        for (size_t i = b; i < e; ++i, ++o) {
            if (i == 0) *o = *first;
            else *o = op(*__par::At(first, i), *__par::At(first, i - 1));
        }
    });
    return __par::At(out, n);
}

template <class EP, class It, class Out>
    requires is_execution_policy_v<remove_cvref_t<EP>>
Out adjacent_difference(EP &&ep, It first, It last, Out out)
{
    return adjacent_difference(static_cast<EP &&>(ep), first, last, out, minus<>());
}

} // namespace std

#endif // BOXCXX_BITS_PAR_NUMERIC
