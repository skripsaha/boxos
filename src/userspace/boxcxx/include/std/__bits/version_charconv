// boxcxx — <__bits/version_charconv>
//
// The feature-test macros [version.syn] owned by <charconv>. The integer
// forms are constexpr (P2291); the floating-point forms are out-of-line in
// src/runtime/charconv_float.cpp, which is why to_chars is claimed but
// constexpr_charconv covers only what P2291 actually requires.
//
// Every block below is gated on BOXCXX_OWNS_<stem>, and this file has NO
// include guard: it is meant to be included once per owning header, each time
// defining only what that header declared it owns. [support.limits.general]
// says a macro is defined by <version> AND by the header that provides the
// feature; it does not say every header that happens to include this leaf.
// A header that answers for a feature it does not provide is answering a
// question it was not asked, so it no longer does. <version> defines
// BOXCXX_OWNS_ALL and takes the lot. Checked by tools/cxx_ftm_audit.sh.

#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_constexpr_charconv)) && \
    !defined(__cpp_lib_constexpr_charconv)
#  define __cpp_lib_constexpr_charconv 202207L
#endif
#undef BOXCXX_OWNS_constexpr_charconv
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_to_chars)) && \
    !defined(__cpp_lib_to_chars)
// 202306L = P2497R0's explicit operator bool on to_chars_result and
// from_chars_result (Ф32-e). The current working draft has moved this macro
// on again, to 202606L, for a later paper that is not implemented here; a
// macro names the newest feature you actually have, so this stays at P2497's
// value.
#  define __cpp_lib_to_chars 202306L
#endif
#undef BOXCXX_OWNS_to_chars
