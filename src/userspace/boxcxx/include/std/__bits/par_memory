template <class EP, class It>
    requires is_execution_policy_v<remove_cvref_t<EP>>
void destroy(EP &&, It first, It last)
{
    const size_t n = static_cast<size_t>(distance(first, last));
    __par::Region<EP>(n, [&](size_t, size_t b, size_t e) {
        It it = __par::At(first, b);
        for (size_t i = b; i < e; ++i, ++it) destroy_at(addressof(*it));
    });
}

template <class EP, class It, class Size>
    requires is_execution_policy_v<remove_cvref_t<EP>>
It destroy_n(EP &&, It first, Size count)
{
    const size_t n = count <= Size{} ? 0 : static_cast<size_t>(count);
    __par::Region<EP>(n, [&](size_t, size_t b, size_t e) {
        It it = __par::At(first, b);
        for (size_t i = b; i < e; ++i, ++it) destroy_at(addressof(*it));
    });
    return __par::At(first, n);
}

