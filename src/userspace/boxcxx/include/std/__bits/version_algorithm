// boxcxx — <__bits/version_algorithm>
//
// The feature-test macros [version.syn] owned by <algorithm> ALONE -- every
// ranges:: niebloid these name lives in a __bits/ranges_algo* file
// <algorithm> itself #includes (ranges::contains / find_last / starts_with
// / ends_with in ranges_algo; fold_left / fold_right family in
// ranges_algo_fold). The one macro <algorithm> CO-owns,
// __cpp_lib_constexpr_algorithms, is defined in <__bits/version_utility>
// and pulled in below. Split out of <version> for the same
// [support.limits.general] per-header reason as <__bits/version_ranges> --
// see that file's comment.
//
// Every block below is gated on BOXCXX_OWNS_<stem>, and this file has NO
// include guard: it is meant to be included once per owning header, each time
// defining only what that header declared it owns. [support.limits.general]
// says a macro is defined by <version> AND by the header that provides the
// feature; it does not say every header that happens to include this leaf.
// A header that answers for a feature it does not provide is answering a
// question it was not asked, so it no longer does. <version> defines
// BOXCXX_OWNS_ALL and takes the lot. Checked by tools/cxx_ftm_audit.sh.

#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_sample)) && \
    !defined(__cpp_lib_sample)
#  define __cpp_lib_sample 201603L
#endif
#undef BOXCXX_OWNS_sample

// __cpp_lib_constexpr_algorithms is co-owned by <algorithm> and <utility>,
// so it is DEFINED in <__bits/version_utility> (one definition site for
// every co-owned macro) and reaches <algorithm> through this include.
#include <__bits/version_utility>

// Ф31a-3 backfill: the classic-<algorithm> macros. shift is 202202L, not
// P0769's original 201806L -- P2440R1 added ranges::shift_left/shift_right
// and bumped it, and boxcxx has both the classic and the ranges spellings.
// std::sample is absent (only ranges::sample) and std::mismatch has no
// four-iterator overloads, so __cpp_lib_sample and
// __cpp_lib_robust_nonmodifying_seq_ops both stay undefined; see
// <version>'s list.
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_clamp)) && \
    !defined(__cpp_lib_clamp)
#  define __cpp_lib_clamp 201603L
#endif
#undef BOXCXX_OWNS_clamp
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_robust_nonmodifying_seq_ops)) && \
    !defined(__cpp_lib_robust_nonmodifying_seq_ops)
// N3346. Claimable since Ф31e-b: std::mismatch gained its four-iterator
// overloads, which were the last of the family still missing them.
#  define __cpp_lib_robust_nonmodifying_seq_ops 201304L
#endif
#undef BOXCXX_OWNS_robust_nonmodifying_seq_ops
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_shift)) && \
    !defined(__cpp_lib_shift)
#  define __cpp_lib_shift 202202L
#endif
#undef BOXCXX_OWNS_shift
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_ranges_contains)) && \
    !defined(__cpp_lib_ranges_contains)
#  define __cpp_lib_ranges_contains 202207L
#endif
#undef BOXCXX_OWNS_ranges_contains
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_ranges_find_last)) && \
    !defined(__cpp_lib_ranges_find_last)
#  define __cpp_lib_ranges_find_last 202207L
#endif
#undef BOXCXX_OWNS_ranges_find_last
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_ranges_starts_ends_with)) && \
    !defined(__cpp_lib_ranges_starts_ends_with)
#  define __cpp_lib_ranges_starts_ends_with 202106L
#endif
#undef BOXCXX_OWNS_ranges_starts_ends_with
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_ranges_fold)) && \
    !defined(__cpp_lib_ranges_fold)
#  define __cpp_lib_ranges_fold 202207L
#endif
#undef BOXCXX_OWNS_ranges_fold
