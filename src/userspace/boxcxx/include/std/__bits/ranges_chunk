namespace views {

struct Chunk {
    template <viewable_range R>
        requires input_range<all_t<R>>
    constexpr auto operator()(R &&r, range_difference_t<all_t<R>> n) const
    {
        return chunk_view<all_t<R>>(all(std::forward<R>(r)), n);
    }
    template <typename D>
    constexpr auto operator()(D n) const
    {
        return RangeAdaptorPartial<Chunk, D>(Chunk{}, n);
    }
};
inline constexpr Chunk chunk{};

struct ChunkBy {
    template <viewable_range R, typename Pred>
        requires forward_range<all_t<R>> &&
                 indirect_binary_predicate<remove_cvref_t<Pred>, iterator_t<all_t<R>>, iterator_t<all_t<R>>>
    constexpr auto operator()(R &&r, Pred &&pred) const
    {
        return chunk_by_view<all_t<R>, remove_cvref_t<Pred>>(all(std::forward<R>(r)), std::forward<Pred>(pred));
    }
    template <typename Pred>
        requires(!viewable_range<remove_cvref_t<Pred>>)
    constexpr auto operator()(Pred &&pred) const
    {
        return RangeAdaptorPartial<ChunkBy, remove_cvref_t<Pred>>(ChunkBy{}, std::forward<Pred>(pred));
    }
};
inline constexpr ChunkBy chunk_by{};

