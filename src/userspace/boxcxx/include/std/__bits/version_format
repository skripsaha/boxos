// boxcxx — <__bits/version_format>
//
// The __cpp_lib_* feature-test macro [version.syn] owned by <format> --
// split out for the same [support.limits.general] per-header reason as
// <__bits/version_any>/<__bits/version_bitset> -- see those files' comments.
//
// __cpp_lib_format itself (the base <format> macro) is deliberately NOT
// defined here: backfilling feature-test macros for Ф1-Ф28 is a separate,
// out-of-scope epic-wide item (see <version>'s own header comment).
//
// Every block below is gated on BOXCXX_OWNS_<stem>, and this file has NO
// include guard: it is meant to be included once per owning header, each time
// defining only what that header declared it owns. [support.limits.general]
// says a macro is defined by <version> AND by the header that provides the
// feature; it does not say every header that happens to include this leaf.
// A header that answers for a feature it does not provide is answering a
// question it was not asked, so it no longer does. <version> defines
// BOXCXX_OWNS_ALL and takes the lot. Checked by tools/cxx_ftm_audit.sh.

#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_format_uchar)) && \
    !defined(__cpp_lib_format_uchar)
// P2909R4 "Fix formatting of code units as integers". A char formatted
// with an integer presentation type is a CODE UNIT, so it widens through
// unsigned char: format("{:d}", char(-1)) is 255, not -1, while
// signed char(-1) stays -1. boxcxx's formatter<char, char> has always
// done exactly that ((unsigned long long)(unsigned char)value), which is
// why this is a macro and not a code change -- verified against
// libstdc++ 16.1 in C++26 mode, which prints 255 for the same call.
#  define __cpp_lib_format_uchar 202311L
#endif
#undef BOXCXX_OWNS_format_uchar
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_format_ranges)) && \
    !defined(__cpp_lib_format_ranges)
#  define __cpp_lib_format_ranges 202207L
#endif
#undef BOXCXX_OWNS_format_ranges
