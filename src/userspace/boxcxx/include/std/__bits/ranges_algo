// boxcxx — <__bits/ranges_algo>
// Ф29b-1: the ranges:: constrained algorithm result-type aggregates
// ([algorithms.results]) and the read-oriented [alg.nonmodifying] niebloids
// (find/count/mismatch/equal/search/… + their (iterator,sentinel) and (range)
// overloads with projections). Pulled in at the END of <algorithm> so the
// classic std:: algorithms, the range concepts, and the Ф29a indirect-callable
// foundation are all already in scope.
//
// The fold family + min/max + sorted/binary-search + lexicographical_compare
// live in the sibling <__bits/ranges_algo_fold> (included right after this one)
// because a single b1 file would exceed the project's split threshold; that
// file DEPENDS on the result-types defined here.
#ifndef BOXCXX_BITS_RANGES_ALGO
#define BOXCXX_BITS_RANGES_ALGO

#include <functional>
#include <ranges>
#include <utility>

namespace std {
namespace ranges {

// ── algorithm result aggregates ([algorithms.results]) ───────────────────
// Every member is [[no_unique_address]]; every struct gets a const& and an &&
// converting operator. Those converters are the mechanism that lets a
// (range) overload declared to return e.g.
//   in_in_result<borrowed_iterator_t<R1>, borrowed_iterator_t<R2>>
// simply `return (*this)(begin, end, ...);` (whose static type is
// in_in_result<I1,I2>) and have each dangling-prone slot degrade to `dangling`
// independently, with no manual branching in any algorithm body.

template <class I, class F>
struct in_fun_result {
    [[no_unique_address]] I in;
    [[no_unique_address]] F fun;

    template <class I2, class F2>
        requires convertible_to<const I &, I2> && convertible_to<const F &, F2>
    constexpr operator in_fun_result<I2, F2>() const &
    {
        return {in, fun};
    }
    template <class I2, class F2>
        requires convertible_to<I, I2> && convertible_to<F, F2>
    constexpr operator in_fun_result<I2, F2>() &&
    {
        return {std::move(in), std::move(fun)};
    }
};

template <class I1, class I2>
struct in_in_result {
    [[no_unique_address]] I1 in1;
    [[no_unique_address]] I2 in2;

    template <class II1, class II2>
        requires convertible_to<const I1 &, II1> && convertible_to<const I2 &, II2>
    constexpr operator in_in_result<II1, II2>() const &
    {
        return {in1, in2};
    }
    template <class II1, class II2>
        requires convertible_to<I1, II1> && convertible_to<I2, II2>
    constexpr operator in_in_result<II1, II2>() &&
    {
        return {std::move(in1), std::move(in2)};
    }
};

