// boxcxx — <__bits/version_sync>
//
// The feature-test macros [version.syn] owned by the standalone
// synchronisation headers <latch>, <semaphore> and <shared_mutex>. One
// leaf for the family, included by all three, for the same
// [support.limits.general] per-header reason as <__bits/version_iostreams>
// -- see that file's comment.
//
// <barrier> includes this leaf too, for __cpp_lib_barrier. That macro was
// withheld on a residual arrive_and_drop race that measurement had already
// disproved: arrive_and_drop arrives at the CURRENT phase, so its arrival is
// one the drain needs, and every successful arrive() CAS is acq_rel on the
// packed state word -- whoever reads the count to zero reads a value at or
// after ours in that word's modification order and therefore sees the
// expected-count decrement sequenced before it. The claim was retired in
// Ф31e-d; cxxtest phase139 drives four strands through staggered
// arrive_and_drop rounds against a live completion.
#ifndef BOXCXX_BITS_VERSION_SYNC
#define BOXCXX_BITS_VERSION_SYNC

#ifndef __cpp_lib_barrier
#  define __cpp_lib_barrier 201907L
#endif
#ifndef __cpp_lib_latch
#  define __cpp_lib_latch 201907L
#endif
#ifndef __cpp_lib_semaphore
#  define __cpp_lib_semaphore 201907L
#endif
#ifndef __cpp_lib_shared_mutex
#  define __cpp_lib_shared_mutex 201505L
#endif
#ifndef __cpp_lib_shared_timed_mutex
#  define __cpp_lib_shared_timed_mutex 201402L
#endif

#endif // BOXCXX_BITS_VERSION_SYNC
