// boxcxx — <__bits/version_containers>
//
// The __cpp_lib_* feature-test macros [version.syn] owned JOINTLY by the
// container family -- <vector>, <deque>, <list>, <forward_list>, <map>,
// <set>, <unordered_map>, <unordered_set>, <string>, <stack>, <queue> --
// plus <memory>, which shares ownership of
// __cpp_lib_allocator_traits_is_always_equal. Split out for the same
// [support.limits.general] per-header reason as
// <__bits/version_ranges>/<__bits/version_algorithm>/<__bits/version_numeric>
// -- see those files' comments. Every owning header includes this leaf
// directly so each macro is visible from a TU that includes only one of
// them, not just from <version>.
//
// Like <__bits/version_iostreams>, this is one leaf for a family whose
// members do not all own every macro in it: a header here may expose a
// macro it does not itself own. Every macro exposed is nevertheless true
// of boxcxx as a whole, and <version> exposes all of them anyway.
//
// Deliberately absent (see <version>'s list): erase_if,
// nonmember_container_access, map_try_emplace, unordered_map_try_emplace,
// constexpr_vector, constexpr_string.
#ifndef BOXCXX_BITS_VERSION_CONTAINERS
#define BOXCXX_BITS_VERSION_CONTAINERS

#ifndef __cpp_lib_adaptor_iterator_pair_constructor
#  define __cpp_lib_adaptor_iterator_pair_constructor 202106L
#endif
#ifndef __cpp_lib_allocator_traits_is_always_equal
#  define __cpp_lib_allocator_traits_is_always_equal 201411L
#endif
#ifndef __cpp_lib_associative_heterogeneous_erasure
#  define __cpp_lib_associative_heterogeneous_erasure 202110L
#endif
#ifndef __cpp_lib_containers_ranges
