// ── random_device ([rand.device]) ────────────────────────────────────────
// On-chip RDRAND when published in cpu_caps; otherwise a TSC-mixed fallback
// (non-cryptographic — entropy() reports 0 in that mode).
class random_device {
public:
    using result_type = unsigned int;

    static constexpr result_type min() { return 0; }
    static constexpr result_type max()
    {
        return numeric_limits<result_type>::max();
    }

    random_device() = default;
    explicit random_device(const string &) {}
    random_device(const random_device &)            = delete;
    random_device &operator=(const random_device &) = delete;

    result_type operator()()
    {
        uint64_t v;
        if (cpu_has_rdrand() && cpu_rdrand64(&v))
            return static_cast<result_type>(v);
        return tsc_mix();
    }

    double entropy() const noexcept { return cpu_has_rdrand() ? 32.0 : 0.0; }

private:
    static result_type tsc_mix()
    {
        uint64_t z = cpu_rdtsc();
        z ^= z >> 30;
        z *= 0xbf58476d1ce4e5b9ull;
        z ^= z >> 27;
        z *= 0x94d049bb133111ebull;
        z ^= z >> 31;
        return static_cast<result_type>(z);
    }
};

// ── generate_canonical ([rand.util.canonical]) ──────────────────────────
template <class RealType, size_t bits, class G>
RealType generate_canonical(G &g)
{
    const size_t digits = static_cast<size_t>(numeric_limits<RealType>::digits);
    const size_t B      = bits < digits ? bits : digits;
    const long double R =
        static_cast<long double>(g.max()) - static_cast<long double>(g.min()) + 1.0L;
    long double twoB = 1.0L;
    for (size_t i = 0; i < B; ++i) twoB *= 2.0L;
    size_t      kk = 0;
    long double Rk = 1.0L;
    while (Rk < twoB) { Rk *= R; ++kk; }
    if (kk == 0) kk = 1;
    long double sum = 0.0L, factor = 1.0L;
    for (size_t i = 0; i < kk; ++i) {
        sum += (static_cast<long double>(g()) - static_cast<long double>(g.min())) *
               factor;
        factor *= R;
    }
    RealType result = static_cast<RealType>(sum / factor);
    if (result >= RealType(1)) // clamp to the largest value < 1 (== nextafter(1,0))
        result = RealType(1) - numeric_limits<RealType>::epsilon() / RealType(2);
    return result;
}

} // namespace std

#endif // BOXCXX_BITS_RANDOM_ENGINE
