// min / max / minmax + *_element + clamp ([alg.min.max])
// The *_element niebloids are defined FIRST: min/max/minmax's
// initializer_list overloads delegate to them.
// ════════════════════════════════════════════════════════════════════════

struct MinElement {
    template <forward_iterator I, sentinel_for<I> S, class Proj = identity,
              indirect_strict_weak_order<projected<I, Proj>> Comp = ranges::less>
    constexpr I operator()(I first, S last, Comp comp = {}, Proj proj = {}) const
    {
        if (first == last) return first;
        I smallest = first;
        while (++first != last)
            if (std::invoke(comp, std::invoke(proj, *first),
                            std::invoke(proj, *smallest)))
                smallest = first;
        return smallest;
    }
    template <forward_range R, class Proj = identity,
              indirect_strict_weak_order<projected<iterator_t<R>, Proj>> Comp =
                  ranges::less>
    constexpr borrowed_iterator_t<R> operator()(R &&r, Comp comp = {},
                                                Proj proj = {}) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::move(comp),
                       std::move(proj));
    }
};
inline constexpr MinElement min_element{};

struct MaxElement {
    template <forward_iterator I, sentinel_for<I> S, class Proj = identity,
              indirect_strict_weak_order<projected<I, Proj>> Comp = ranges::less>
    constexpr I operator()(I first, S last, Comp comp = {}, Proj proj = {}) const
    {
        if (first == last) return first;
        I largest = first;
        // Leftmost maximum: strict `largest < *first` — ties do NOT advance.
        while (++first != last)
            if (std::invoke(comp, std::invoke(proj, *largest),
                            std::invoke(proj, *first)))
                largest = first;
        return largest;
    }
    template <forward_range R, class Proj = identity,
              indirect_strict_weak_order<projected<iterator_t<R>, Proj>> Comp =
                  ranges::less>
    constexpr borrowed_iterator_t<R> operator()(R &&r, Comp comp = {},
                                                Proj proj = {}) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::move(comp),
                       std::move(proj));
    }
};
inline constexpr MaxElement max_element{};

template <class I>
using minmax_element_result = min_max_result<I>;

struct MinmaxElement {
    // Pairwise tournament ([alg.min.max]): elements are consumed two at a
    // time. Each pair costs 1 comparison to find its own smaller/larger
    // element, then 1 more each to fold that element into the running mn/mx
    // — 3 comparisons per 2 elements, meeting the mandated
    // floor(3(N-1)/2) bound (the naive min_element-then-max_element
    // composition costs 2(N-1)). A leftover unpaired element (odd N) costs
    // at most 2. Tie-breaking is exactly preserved: mn is the FIRST smallest
    // (strict '<' — an equal later element never displaces it) and mx is the
    // LAST largest ('>=' — via negated '<' — lets a later equal element
    // displace an earlier one), matching [alg.min.max]'s own asymmetry vs
    // plain max_element (which keeps the leftmost max).
    template <forward_iterator I, sentinel_for<I> S, class Proj = identity,
              indirect_strict_weak_order<projected<I, Proj>> Comp = ranges::less>
    constexpr minmax_element_result<I> operator()(I first, S last,
                                                  Comp comp = {},
                                                  Proj proj = {}) const
    {
        if (first == last) return {first, first};
        I mn = first, mx = first;
        I next = first;
        ++next;
        if (next == last) return {mn, mx};

        if (std::invoke(comp, std::invoke(proj, *next), std::invoke(proj, *first))) {
            mn = next;
            mx = first;
        } else {
            mn = first;
            mx = next;
        }
        first = next;
        ++first;

        while (first != last) {
            next = first;
            ++next;
            if (next == last) {
                if (std::invoke(comp, std::invoke(proj, *first), std::invoke(proj, *mn)))
                    mn = first;
                else if (!std::invoke(comp, std::invoke(proj, *first), std::invoke(proj, *mx)))
                    mx = first;
                break;
            }
            if (std::invoke(comp, std::invoke(proj, *next), std::invoke(proj, *first))) {
                if (std::invoke(comp, std::invoke(proj, *next), std::invoke(proj, *mn)))
                    mn = next;
                if (!std::invoke(comp, std::invoke(proj, *first), std::invoke(proj, *mx)))
                    mx = first;
            } else {
                if (std::invoke(comp, std::invoke(proj, *first), std::invoke(proj, *mn)))
                    mn = first;
                if (!std::invoke(comp, std::invoke(proj, *next), std::invoke(proj, *mx)))
                    mx = next;
            }
            first = next;
            ++first;
        }
        return {mn, mx};
    }
    template <forward_range R, class Proj = identity,
              indirect_strict_weak_order<projected<iterator_t<R>, Proj>> Comp =
                  ranges::less>
    constexpr minmax_element_result<borrowed_iterator_t<R>>
    operator()(R &&r, Comp comp = {}, Proj proj = {}) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::move(comp),
                       std::move(proj));
    }
};
inline constexpr MinmaxElement minmax_element{};

struct Min {
    template <class T, class Proj = identity,
              indirect_strict_weak_order<projected<const T *, Proj>> Comp =
                  ranges::less>
    constexpr const T &operator()(const T &a, const T &b, Comp comp = {},
                                  Proj proj = {}) const
    {
        // min favors `a` on ties: pick b only when b < a strictly.
        return std::invoke(comp, std::invoke(proj, b), std::invoke(proj, a)) ? b
                                                                             : a;
    }
    template <copyable T, class Proj = identity,
              indirect_strict_weak_order<projected<const T *, Proj>> Comp =
                  ranges::less>
    constexpr T operator()(initializer_list<T> r, Comp comp = {},
                           Proj proj = {}) const
    {
        return *min_element(r, std::move(comp), std::move(proj));
    }
    template <input_range R, class Proj = identity,
              indirect_strict_weak_order<projected<iterator_t<R>, Proj>> Comp =
                  ranges::less>
        requires indirectly_copyable_storable<iterator_t<R>, range_value_t<R> *>
    constexpr range_value_t<R> operator()(R &&r, Comp comp = {},
                                          Proj proj = {}) const
    {
        auto first = ranges::begin(r);
        auto last  = ranges::end(r);
        range_value_t<R> result(*first);
        while (++first != last)
            if (std::invoke(comp, std::invoke(proj, *first),
                            std::invoke(proj, result)))
                result = *first;
        return result;
    }
};
inline constexpr Min min{};

struct Max {
    template <class T, class Proj = identity,
              indirect_strict_weak_order<projected<const T *, Proj>> Comp =
                  ranges::less>
    constexpr const T &operator()(const T &a, const T &b, Comp comp = {},
                                  Proj proj = {}) const
    {
        // max returns the FIRST argument on ties ([alg.min.max]): comp(a,b) is
        // false when a and b are equivalent, so this yields a.
        return std::invoke(comp, std::invoke(proj, a), std::invoke(proj, b)) ? b
                                                                             : a;
    }
    template <copyable T, class Proj = identity,
              indirect_strict_weak_order<projected<const T *, Proj>> Comp =
                  ranges::less>
    constexpr T operator()(initializer_list<T> r, Comp comp = {},
                           Proj proj = {}) const
    {
        return *max_element(r, std::move(comp), std::move(proj));
    }
    template <input_range R, class Proj = identity,
              indirect_strict_weak_order<projected<iterator_t<R>, Proj>> Comp =
                  ranges::less>
        requires indirectly_copyable_storable<iterator_t<R>, range_value_t<R> *>
    constexpr range_value_t<R> operator()(R &&r, Comp comp = {},
                                          Proj proj = {}) const
    {
        auto first = ranges::begin(r);
        auto last  = ranges::end(r);
        range_value_t<R> result(*first);
        while (++first != last)
            // leftmost maximum ([alg.min.max]: "leftmost element when several
            // are equivalent to the largest"): advance only when result is
            // STRICTLY less than *first, so an equivalent later element does
            // not displace the earlier one.
            if (std::invoke(comp, std::invoke(proj, result),
                            std::invoke(proj, *first)))
                result = *first;
        return result;
    }
};
inline constexpr Max max{};

struct Minmax {
    template <class T, class Proj = identity,
              indirect_strict_weak_order<projected<const T *, Proj>> Comp =
                  ranges::less>
    constexpr min_max_result<const T &>
    operator()(const T &a, const T &b, Comp comp = {}, Proj proj = {}) const
    {
        if (std::invoke(comp, std::invoke(proj, b), std::invoke(proj, a)))
            return {b, a};
        return {a, b};
    }
    template <copyable T, class Proj = identity,
              indirect_strict_weak_order<projected<const T *, Proj>> Comp =
                  ranges::less>
    constexpr min_max_result<T> operator()(initializer_list<T> r,
                                           Comp comp = {}, Proj proj = {}) const
    {
        auto res = minmax_element(r, std::move(comp), std::move(proj));
        return {*res.min, *res.max};
    }
    template <input_range R, class Proj = identity,
              indirect_strict_weak_order<projected<iterator_t<R>, Proj>> Comp =
                  ranges::less>
        requires indirectly_copyable_storable<iterator_t<R>, range_value_t<R> *>
    constexpr min_max_result<range_value_t<R>>
    operator()(R &&r, Comp comp = {}, Proj proj = {}) const
    {
        auto res = minmax_element(r, std::move(comp), std::move(proj));
        return {range_value_t<R>(*res.min), range_value_t<R>(*res.max)};
    }
};
inline constexpr Minmax minmax{};

struct Clamp {
    template <class T, class Proj = identity,
              indirect_strict_weak_order<projected<const T *, Proj>> Comp =
                  ranges::less>
    constexpr const T &operator()(const T &v, const T &lo, const T &hi,
                                  Comp comp = {}, Proj proj = {}) const
    {
        auto &&pv = std::invoke(proj, v);
        if (std::invoke(comp, pv, std::invoke(proj, lo))) return lo;
        if (std::invoke(comp, std::invoke(proj, hi), pv)) return hi;
        return v;
    }
};
inline constexpr Clamp clamp{};

