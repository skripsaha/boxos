namespace __algo {

// The standard's exposition-only indirectly-binary-left-foldable, spelled out.
template <class F, class T, class I, class U>
concept LeftFoldableImpl =
    movable<T> && movable<U> && convertible_to<T, U> &&
    invocable<F &, U, iter_reference_t<I>> &&
    assignable_from<U &, invoke_result_t<F &, U, iter_reference_t<I>>>;

template <class F, class T, class I>
concept LeftFoldable =
    copy_constructible<F> && indirectly_readable<I> &&
    invocable<F &, T, iter_reference_t<I>> &&
    convertible_to<invoke_result_t<F &, T, iter_reference_t<I>>,
                   decay_t<invoke_result_t<F &, T, iter_reference_t<I>>>> &&
    LeftFoldableImpl<F, T, I,
                     decay_t<invoke_result_t<F &, T, iter_reference_t<I>>>>;

// flipped<F>: operator() declared, never defined — used only in the
// unevaluated concept checks below (invocable / invoke_result_t), never
// ODR-used. Same declared-not-defined idiom as projected::operator*.
template <class F>
struct Flipped {
    F f;
    template <class T, class U>
        requires invocable<F &, U, T>
    invoke_result_t<F &, U, T> operator()(T &&, U &&);
};

template <class F, class T, class I>
concept RightFoldable = LeftFoldable<Flipped<F>, T, I>;

} // namespace __algo

struct FoldLeftWithIter {
    template <input_iterator I, sentinel_for<I> S, class T,
              __algo::LeftFoldable<T, I> F>
    constexpr auto operator()(I first, S last, T init, F f) const
    {
        using U = decay_t<invoke_result_t<F &, T, iter_reference_t<I>>>;
        if (first == last)
            return in_value_result<I, U>{std::move(first), U(std::move(init))};
        U accum = std::invoke(f, std::move(init), *first);
        for (++first; first != last; ++first)
            accum = std::invoke(f, std::move(accum), *first);
        return in_value_result<I, U>{std::move(first), std::move(accum)};
    }
    template <input_range R, class T, __algo::LeftFoldable<T, iterator_t<R>> F>
    constexpr in_value_result<borrowed_iterator_t<R>,
                              decay_t<invoke_result_t<F &, T, range_reference_t<R>>>>
    operator()(R &&r, T init, F f) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::move(init),
                       std::move(f));
    }
};
inline constexpr FoldLeftWithIter fold_left_with_iter{};
template <class I, class T>
using fold_left_with_iter_result = in_value_result<I, T>;

struct FoldLeft {
    template <input_iterator I, sentinel_for<I> S, class T,
