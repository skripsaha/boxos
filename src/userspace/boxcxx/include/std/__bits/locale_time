// boxcxx — <__bits/locale_time>
//
// time_base, time_get, time_get_byname, time_put, time_put_byname — the last
// of the six locale categories, and the one that had been blocking
// <iomanip>'s get_time/put_time since Ф30.
//
// ── time_put does not render anything itself, on purpose ────────────────
// <chrono> has carried a complete "%"-conversion renderer since Ф30:
// __chrono_fmt::RenderOne turns one specifier and a filled-in Parts into
// ASCII, and it is the engine behind every chrono formatter, narrow and wide
// alike. A second renderer here would be a second set of month names, a second
// ISO-week calculation, and a second place for either to be wrong.
//
// The call goes through the one declaration in <__bits/time_render>, and that
// indirection is forced rather than chosen: <__bits/chrono_format> includes
// <format>, <format> includes <locale>, so a <locale> leaf that included the
// engine would be including itself. The definition lives beside strftime,
// which was already the engine's other tm-shaped caller — and which already
// had the tm-to-Parts conversion this first draft duplicated.
//
// What that buys is not only brevity: %U/%W/%V/%G/%g come out of the same ISO
// 8601 week calendar <chrono> already had to get right, rather than out of a
// formula written a second time from the same paragraph of the standard.
//
// A conversion RenderOne refuses — one it does not implement, or one whose
// value is not renderable, like %b with a month field of 99 — is written out
// literally, as "%b". That is what strftime does with a specifier it does not
// know, and it loses nothing: the caller can see exactly which conversion had
// no answer, instead of reading a month name that was invented.
//
// ── the zone is UTC, and that is a fact about BoxOS, not a stub ─────────
// %Z is "UTC" and %z is "+0000" because <ctime> makes localtime() BE gmtime():
// there is no timezone database on this system and no second zone to convert
// into. A facet that answered "" or refused would be describing a system that
// does not know its own offset; this one knows it exactly.
//
// ── time_get never puts a character back ───────────────────────────────
// Same discipline as num_get since Ф43-c-2 and money_get since d-2: a
// single-pass iterator cannot retreat, so a name is matched by advancing only
// while at least one candidate still agrees. "Mar" followed by 'c' is still
// inside "March"; "Mar" followed by a space is a complete abbreviation. The
// longest complete match wins, and nothing is ever handed back.
#ifndef BOXCXX_BITS_LOCALE_TIME
#define BOXCXX_BITS_LOCALE_TIME

#include <__bits/locale_core>
#include <__bits/locale_ctype>
#include <ctime>
#include <ios>
#include <iterator>
#include <__bits/time_render>
#include <streambuf>
#include <string>

namespace std {

// ── time_base [category.time] ───────────────────────────────────────────
class time_base {
public:
    enum dateorder { no_order, dmy, mdy, ymd, ydm };
};

// ── time_put [locale.time.put] ──────────────────────────────────────────
template <class charT, class OutputIterator = ostreambuf_iterator<charT>>
class time_put : public locale::facet {
public:
    using char_type = charT;
    using iter_type = OutputIterator;

    constexpr explicit time_put(size_t refs = 0) noexcept : locale::facet(refs) {}

    static locale::id id;

    // The pattern overload is NOT virtual: [locale.time.put] defines it as a
    // walk that calls do_put for each conversion, so overriding do_put changes
    // what a pattern produces without anyone having to override this too.
    iter_type put(iter_type s, ios_base &f, char_type fill, const tm *tmb,
                  const charT *pattern, const charT *pat_end) const
    {
        const locale        loc = f.getloc();
        const ctype<charT> &ct  = use_facet<ctype<charT>>(loc);

        while (pattern != pat_end) {
            if (ct.narrow(*pattern, '\0') != '%') {
                // Literal text is the caller's own characters and is copied
                // untouched — it may hold anything charT can.
                *s++ = *pattern++;
                continue;
            }
            ++pattern;
            if (pattern == pat_end) {   // a trailing '%' is a literal '%'
                *s++ = ct.widen('%');
                break;
            }
            char mod = 0;
            char c   = ct.narrow(*pattern, '\0');
            if (c == 'E' || c == 'O') {
                mod = c;
                ++pattern;
                if (pattern == pat_end) {
                    *s++ = ct.widen('%');
                    *s++ = ct.widen(mod);
                    break;
                }
                c = ct.narrow(*pattern, '\0');
            }
            ++pattern;
            s = do_put(s, f, fill, tmb, c, mod);
        }
        return s;
    }

    iter_type put(iter_type s, ios_base &f, char_type fill, const tm *tmb, char format,
                  char modifier = 0) const
    {
        return do_put(s, f, fill, tmb, format, modifier);
    }

protected:
    ~time_put() = default;

    virtual iter_type do_put(iter_type s, ios_base &f, char_type fill, const tm *tmb,
                             char format, char modifier) const
    {
        (void)fill;   // [locale.time.put.virtuals] gives fill no role here
        const locale        loc = f.getloc();
        const ctype<charT> &ct  = use_facet<ctype<charT>>(loc);

        string out;
        if (!__timeput::RenderTm(out, format, modifier, *tmb)) {
            // Nothing renderable: say which conversion, rather than a value
            // that was made up. This is strftime's own answer for a specifier
            // it does not know.
            out.clear();
            out.push_back('%');
            if (modifier) out.push_back(modifier);
            out.push_back(format);
        }
        for (char c : out) *s++ = ct.widen(c);
        return s;
    }
};

template <class charT, class OutputIterator>
locale::id time_put<charT, OutputIterator>::id{};

template <>
inline locale::id time_put<char, ostreambuf_iterator<char>>::id{__cvt::kIdTimePutChar};
template <>
inline locale::id time_put<wchar_t, ostreambuf_iterator<wchar_t>>::id{__cvt::kIdTimePutWchar};

template <class charT, class OutputIterator = ostreambuf_iterator<charT>>
class time_put_byname : public time_put<charT, OutputIterator> {
public:
    using char_type = charT;
    using iter_type = OutputIterator;

    explicit time_put_byname(const char *name, size_t refs = 0)
        : time_put<charT, OutputIterator>(refs)
    {
        if (!__loc::IsClassicName(name)) __loc::ThrowUnknownLocale(name);
    }
    explicit time_put_byname(const string &name, size_t refs = 0)
        : time_put_byname(name.c_str(), refs)
    {
    }

protected:
    ~time_put_byname() = default;
};

namespace __timeget {

inline constexpr const char *kWdAbbr[] = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
inline constexpr const char *kWdFull[] = {"Sunday",   "Monday", "Tuesday", "Wednesday",
                                          "Thursday", "Friday", "Saturday"};
inline constexpr const char *kMonAbbr[] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun",
                                           "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
inline constexpr const char *kMonFull[] = {"January",   "February", "March",    "April",
                                           "May",       "June",     "July",     "August",
                                           "September", "October",  "November", "December"};

inline char Lower(char c)
{
    return (c >= 'A' && c <= 'Z') ? static_cast<char>(c - 'A' + 'a') : c;
}

// Match one of `count` names, each of which may be the abbreviation or the full
// form of the same thing, WITHOUT ever putting a character back.
//
// Advance while at least one candidate still agrees; the answer is the
// candidate that ends exactly where the walk stopped. "Mar" followed by 'b' is
// March — the 'b' continued nothing, so the walk stopped at three characters
// and "Mar" ends there. "Marc" is NOT March: the 'c' continued "March", so the
// walk consumed it, and no name ends at four. Both reference implementations
// answer exactly this way — measured, including the failure — and a
// single-pass iterator could not offer anything better, since retreating from
// the 'c' is the one thing it cannot do.
//
// Case is not significant. Here the two references part: libstdc++ refuses
// "march", libc++ accepts it. A month is the same month however it is spelled
// in case, the comparison goes through the ctype facet so an installed one
// decides what case means, and refusing would be a refusal with nothing behind
// it.
template <class charT, class Iter>
int MatchName(Iter &in, Iter end, const ctype<charT> &ct, const char *const *names,
              int count)
{
    unsigned long viable = (count >= 64) ? ~0ul : ((1ul << count) - 1ul);
    size_t        i      = 0;

    while (in != end && viable != 0) {
        const char    c    = Lower(ct.narrow(ct.tolower(*in), '\0'));
        unsigned long next = 0;
        for (int k = 0; k < count; ++k) {
            if (!(viable & (1ul << k))) continue;
            const char *n = names[k];
            if (n[i] != '\0' && Lower(n[i]) == c) next |= (1ul << k);
        }
        if (next == 0) break;
        ++in;
        ++i;
        viable = next;
    }

    for (int k = 0; k < count; ++k)
        if ((viable & (1ul << k)) && names[k][i] == '\0') return k;
    return -1;
}

} // namespace __timeget

// ── time_get [locale.time.get] ──────────────────────────────────────────
template <class charT, class InputIterator = istreambuf_iterator<charT>>
class time_get : public locale::facet, public time_base {
public:
    using char_type = charT;
    using iter_type = InputIterator;

    constexpr explicit time_get(size_t refs = 0) noexcept : locale::facet(refs) {}

    static locale::id id;

    dateorder date_order() const { return do_date_order(); }

    iter_type get_time(iter_type s, iter_type end, ios_base &f, ios_base::iostate &err,
                       tm *t) const
    {
        return do_get_time(s, end, f, err, t);
    }
    iter_type get_date(iter_type s, iter_type end, ios_base &f, ios_base::iostate &err,
                       tm *t) const
    {
        return do_get_date(s, end, f, err, t);
    }
    iter_type get_weekday(iter_type s, iter_type end, ios_base &f, ios_base::iostate &err,
                          tm *t) const
    {
        return do_get_weekday(s, end, f, err, t);
    }
    iter_type get_monthname(iter_type s, iter_type end, ios_base &f,
                            ios_base::iostate &err, tm *t) const
    {
        return do_get_monthname(s, end, f, err, t);
    }
    iter_type get_year(iter_type s, iter_type end, ios_base &f, ios_base::iostate &err,
                       tm *t) const
    {
        return do_get_year(s, end, f, err, t);
    }
    iter_type get(iter_type s, iter_type end, ios_base &f, ios_base::iostate &err, tm *t,
                  char format, char modifier = 0) const
    {
        return do_get(s, end, f, err, t, format, modifier);
    }

    // Like time_put's pattern overload, this one is not virtual: the standard
    // defines it as a walk that calls do_get, so replacing do_get replaces
    // what a format string means.
    iter_type get(iter_type s, iter_type end, ios_base &f, ios_base::iostate &err, tm *t,
                  const char_type *fmt, const char_type *fmtend) const
    {
        const locale        loc = f.getloc();
        const ctype<charT> &ct  = use_facet<ctype<charT>>(loc);
        err                     = ios_base::goodbit;

        while (fmt != fmtend) {
            if ((err & ios_base::failbit) != ios_base::goodbit) break;

            const char c = ct.narrow(*fmt, '\0');
            if (c == '%') {
                ++fmt;
                if (fmt == fmtend) break;
                char       mod = 0;
                const char m   = ct.narrow(*fmt, '\0');
                if (m == 'E' || m == 'O') {
                    mod = m;
                    ++fmt;
                    if (fmt == fmtend) break;
                }
                const char spec = ct.narrow(*fmt, '\0');
                ++fmt;
                ios_base::iostate one = ios_base::goodbit;
                s                     = do_get(s, end, f, one, t, spec, mod);
                err |= one;
                continue;
            }

            if (ct.is(ctype_base::space, *fmt)) {
                // Whitespace in the format matches ANY amount of whitespace in
                // the input, including none.
                ++fmt;
                while (s != end && ct.is(ctype_base::space, *s)) ++s;
                continue;
            }

            // Any other character must be there, exactly.
            if (s == end) {
                err |= ios_base::eofbit | ios_base::failbit;
                break;
            }
            if (*s != *fmt) {
                err |= ios_base::failbit;
                break;
            }
            ++s;
            ++fmt;
        }
        if (s == end) err |= ios_base::eofbit;
        return s;
    }

protected:
    ~time_get() = default;

    // %x is "%m/%d/%y" here, so the honest answer is mdy. libstdc++ answers
    // no_order for "C" and libc++ answers mdy; a facet whose own date format
    // IS month-day-year and that reports "not one of the four" would be
    // refusing to read its own output.
    virtual dateorder do_date_order() const { return mdy; }

    virtual iter_type do_get_time(iter_type s, iter_type end, ios_base &f,
                                  ios_base::iostate &err, tm *t) const
    {
        return GetPattern(s, end, f, err, t, "%H:%M:%S");
    }
    virtual iter_type do_get_date(iter_type s, iter_type end, ios_base &f,
                                  ios_base::iostate &err, tm *t) const
    {
        return GetPattern(s, end, f, err, t, "%m/%d/%y");
    }
    virtual iter_type do_get_weekday(iter_type s, iter_type end, ios_base &f,
                                     ios_base::iostate &err, tm *t) const
    {
        return do_get(s, end, f, err, t, 'a', 0);
    }
    virtual iter_type do_get_monthname(iter_type s, iter_type end, ios_base &f,
                                       ios_base::iostate &err, tm *t) const
    {
        return do_get(s, end, f, err, t, 'b', 0);
    }
    virtual iter_type do_get_year(iter_type s, iter_type end, ios_base &f,
                                  ios_base::iostate &err, tm *t) const
    {
        const locale        loc = f.getloc();
        const ctype<charT> &ct  = use_facet<ctype<charT>>(loc);
        err                     = ios_base::goodbit;

        long v = 0;
        if (!ReadUInt(s, end, ct, 4, v, err)) return s;
        // Two digits mean a year in living memory, four mean themselves. Both
        // reference implementations agree, and this is the one place the rule
        // applies — %Y takes "20" as the year 20.
        if (v < 69) v += 2000;
        else if (v < 100) v += 1900;
        t->tm_year = static_cast<int>(v - 1900);
        if (s == end) err |= ios_base::eofbit;
        return s;
    }

    virtual iter_type do_get(iter_type s, iter_type end, ios_base &f,
                             ios_base::iostate &err, tm *t, char format,
                             char modifier) const
    {
        (void)modifier;   // %E and %O select alternative representations the
                          // "C" locale does not have; the base one is right.
        const locale        loc = f.getloc();
        const ctype<charT> &ct  = use_facet<ctype<charT>>(loc);
        err                     = ios_base::goodbit;

        long v = 0;
        switch (format) {
            case 'a':
            case 'A': {
                const char *names[14];
                for (int k = 0; k < 7; ++k) names[k] = __timeget::kWdAbbr[k];
                for (int k = 0; k < 7; ++k) names[7 + k] = __timeget::kWdFull[k];
                SkipSpace(s, end, ct);
                const int k = __timeget::MatchName(s, end, ct, names, 14);
                if (k < 0) { err |= ios_base::failbit; break; }
                t->tm_wday = k % 7;
                break;
            }
            case 'b':
            case 'B':
            case 'h': {
                const char *names[24];
                for (int k = 0; k < 12; ++k) names[k] = __timeget::kMonAbbr[k];
                for (int k = 0; k < 12; ++k) names[12 + k] = __timeget::kMonFull[k];
                SkipSpace(s, end, ct);
                const int k = __timeget::MatchName(s, end, ct, names, 24);
                if (k < 0) { err |= ios_base::failbit; break; }
                t->tm_mon = k % 12;
                break;
            }
            case 'c': return GetPattern(s, end, f, err, t, "%a %b %e %H:%M:%S %Y");
            case 'x':
            case 'D': return GetPattern(s, end, f, err, t, "%m/%d/%y");
            case 'X':
            case 'T': return GetPattern(s, end, f, err, t, "%H:%M:%S");
            case 'F': return GetPattern(s, end, f, err, t, "%Y-%m-%d");
            case 'R': return GetPattern(s, end, f, err, t, "%H:%M");
            case 'r': return GetPattern(s, end, f, err, t, "%I:%M:%S %p");

            case 'Y': {
                bool neg = false;
                SkipSpace(s, end, ct);
                if (s != end && ct.narrow(*s, '\0') == '-') { neg = true; ++s; }
                if (!ReadUInt(s, end, ct, 6, v, err)) break;
                t->tm_year = static_cast<int>((neg ? -v : v) - 1900);
                break;
            }
            case 'y':
                if (!ReadUInt(s, end, ct, 4, v, err)) break;
                if (v < 69) v += 2000;
                else if (v < 100) v += 1900;
                t->tm_year = static_cast<int>(v - 1900);
                break;
            case 'C':
                if (!ReadUInt(s, end, ct, 2, v, err)) break;
                t->tm_year = static_cast<int>(v * 100 - 1900);
                break;
            case 'm':
                if (!ReadUInt(s, end, ct, 2, v, err)) break;
                t->tm_mon = static_cast<int>(v - 1);
                break;
            case 'd':
            case 'e':
                if (!ReadUInt(s, end, ct, 2, v, err)) break;
                t->tm_mday = static_cast<int>(v);
                break;
            case 'H':
                if (!ReadUInt(s, end, ct, 2, v, err)) break;
                t->tm_hour = static_cast<int>(v);
                break;
            case 'I':
                if (!ReadUInt(s, end, ct, 2, v, err)) break;
                t->tm_hour = static_cast<int>(v);
                break;
            case 'M':
                if (!ReadUInt(s, end, ct, 2, v, err)) break;
                t->tm_min = static_cast<int>(v);
                break;
            case 'S':
                if (!ReadUInt(s, end, ct, 2, v, err)) break;
                t->tm_sec = static_cast<int>(v);
                break;
            case 'j':
                if (!ReadUInt(s, end, ct, 3, v, err)) break;
                t->tm_yday = static_cast<int>(v - 1);
                break;
            case 'w':
                if (!ReadUInt(s, end, ct, 1, v, err)) break;
                t->tm_wday = static_cast<int>(v);
                break;
            case 'u':
                if (!ReadUInt(s, end, ct, 1, v, err)) break;
                t->tm_wday = static_cast<int>(v % 7);
                break;
            case 'p': {
                const char *names[2] = {"am", "pm"};
                SkipSpace(s, end, ct);
                const int k = __timeget::MatchName(s, end, ct, names, 2);
                if (k < 0) { err |= ios_base::failbit; break; }
                // %p never stands alone: it corrects the hour %I read.
                if (k == 1) {
                    if (t->tm_hour < 12) t->tm_hour += 12;
                } else if (t->tm_hour == 12) {
                    t->tm_hour = 0;
                }
                break;
            }
            // Read and discarded: `tm` has nowhere to put a week number, and
            // [locale.time.get.virtuals] asks for them to be consumed anyway.
            case 'U':
            case 'W':
            case 'V':
            case 'g':
                if (!ReadUInt(s, end, ct, 2, v, err)) break;
                break;
            case 'G':
                if (!ReadUInt(s, end, ct, 6, v, err)) break;
                break;
            case 'Z': {
                // An alphabetic run. There is one zone here, so the name is
                // checked for shape and not for meaning.
                SkipSpace(s, end, ct);
                int n = 0;
                while (s != end && ct.is(ctype_base::alpha, *s)) { ++s; ++n; }
                if (n == 0) err |= ios_base::failbit;
                break;
            }
            case 'z': {
                SkipSpace(s, end, ct);
                if (s == end) { err |= ios_base::eofbit | ios_base::failbit; break; }
                const char sign = ct.narrow(*s, '\0');
                if (sign != '+' && sign != '-') { err |= ios_base::failbit; break; }
                ++s;
                if (!ReadUInt(s, end, ct, 2, v, err)) break;
                if (s != end && ct.narrow(*s, '\0') == ':') ++s;
                long mins = 0;
                if (!ReadUInt(s, end, ct, 2, mins, err)) break;
                break;
            }
            case 'n':
            case 't':
                SkipSpace(s, end, ct);
                break;
            case '%':
                SkipSpace(s, end, ct);
                if (s == end) { err |= ios_base::eofbit | ios_base::failbit; break; }
                if (ct.narrow(*s, '\0') != '%') { err |= ios_base::failbit; break; }
                ++s;
                break;
            default:
                err |= ios_base::failbit;
                break;
        }
        if (s == end) err |= ios_base::eofbit;
        return s;
    }

private:
    static void SkipSpace(iter_type &s, iter_type end, const ctype<charT> &ct)
    {
        while (s != end && ct.is(ctype_base::space, *s)) ++s;
    }

    // Leading whitespace is skipped, then up to `maxDigits` digits. Fewer than
    // one is a failure; more than the maximum simply end the field, which is
    // what lets "%m%d" read "0309".
    static bool ReadUInt(iter_type &s, iter_type end, const ctype<charT> &ct, int maxDigits,
                         long &out, ios_base::iostate &err)
    {
        SkipSpace(s, end, ct);
        out   = 0;
        int n = 0;
        while (s != end && n < maxDigits && ct.is(ctype_base::digit, *s)) {
            out = out * 10 + (ct.narrow(*s, '0') - '0');
            ++s;
            ++n;
        }
        if (n == 0) {
            if (s == end) err |= ios_base::eofbit;
            err |= ios_base::failbit;
            return false;
        }
        return true;
    }

    // The composite conversions (%c, %x, %X, %D, %F, %T, %R, %r) are patterns,
    // and a pattern is what the public get() already knows how to walk. Written
    // once here so that changing what %x means changes it in one place.
    iter_type GetPattern(iter_type s, iter_type end, ios_base &f, ios_base::iostate &err,
                         tm *t, const char *pattern) const
    {
        const locale        loc = f.getloc();
        const ctype<charT> &ct  = use_facet<ctype<charT>>(loc);

        charT  wide[24];
        size_t n = 0;
        for (const char *p = pattern; *p != '\0' && n < 24; ++p) wide[n++] = ct.widen(*p);
        return get(s, end, f, err, t, wide, wide + n);
    }
};

template <class charT, class InputIterator>
locale::id time_get<charT, InputIterator>::id{};

template <>
inline locale::id time_get<char, istreambuf_iterator<char>>::id{__cvt::kIdTimeGetChar};
template <>
inline locale::id time_get<wchar_t, istreambuf_iterator<wchar_t>>::id{__cvt::kIdTimeGetWchar};

template <class charT, class InputIterator = istreambuf_iterator<charT>>
class time_get_byname : public time_get<charT, InputIterator> {
public:
    using char_type = charT;
    using iter_type = InputIterator;
    using dateorder = time_base::dateorder;

    explicit time_get_byname(const char *name, size_t refs = 0)
        : time_get<charT, InputIterator>(refs)
    {
        if (!__loc::IsClassicName(name)) __loc::ThrowUnknownLocale(name);
    }
    explicit time_get_byname(const string &name, size_t refs = 0)
        : time_get_byname(name.c_str(), refs)
    {
    }

protected:
    ~time_get_byname() = default;
};

