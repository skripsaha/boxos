template <typename It, typename Comp>
constexpr It is_sorted_until(It first, It last, Comp comp)
{
    if (first == last) return last;
    It next_it = first;
    for (++next_it; next_it != last; ++first, ++next_it)
        if (comp(*next_it, *first)) return next_it;
    return last;
}
