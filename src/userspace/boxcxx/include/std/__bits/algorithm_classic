}

namespace __algo_impl {

inline constexpr ptrdiff_t kInsertionThreshold = 16;

template <typename It, typename Comp>
constexpr void InsertionSort(It first, It last, Comp comp)
{
    if (first == last) return;
    for (It i = first + 1; i != last; ++i) {
        // A proxy iterator's operator* returns a fresh reference-holding
        // prvalue (e.g. zip's tuple<int&,int&>) — `auto value = std::move(*i)`
        // would deduce that SAME reference-holding type, so value silently
        // ALIASES the slots *i does rather than snapshotting them; a later
        // `*hole = std::move(*(hole-1))` retroactively corrupts what value
        // "holds". iter_value_t<It> is the OWNED value type, and
        // ranges::iter_move (not std::move(*i)) routes through the wrapped
        // iterator's own customization, so this also works for move-only
        // proxy element types.
        iter_value_t<It> value = ranges::iter_move(i);
        It hole                = i;
        while (hole != first && comp(value, *(hole - 1))) {
            // Same reasoning as the extraction above: hole-1 is about to
            // become the new hole, so its old value must MOVE forward, not
            // alias in place. ranges::iter_move for the same reason.
            *hole = ranges::iter_move(hole - 1);
            --hole;
        }
        *hole = std::move(value);
    }
}

// Median-of-3: order *a, *mid, *(last-1) so *mid holds the median.
template <typename It, typename Comp>
constexpr It MedianPivot(It first, It last, Comp comp)
{
    It mid  = first + (last - first) / 2;
    It back = last - 1;
    if (comp(*mid, *first)) iter_swap(mid, first);
    if (comp(*back, *mid)) {
        iter_swap(back, mid);
        if (comp(*mid, *first)) iter_swap(mid, first);
    }
    return mid;
}

template <typename It, typename Comp>
constexpr void IntroSort(It first, It last, int depth, Comp comp)
{
    for (;;) {
        auto n = last - first;
        if (n <= kInsertionThreshold) {
            InsertionSort(first, last, comp);
            return;
        }
        if (depth-- == 0) {
            make_heap(first, last, comp);
            sort_heap(first, last, comp);
            return;
        }
        It pivot = MedianPivot(first, last, comp);
        // Hoare-style partition around the median value. The classic form
        // snapshots *pivot into a local copy for the comparisons below, but
        // a snapshot needs CopyConstructible -- a move-only element behind a
        // proxy iterator (flat_map's Yoke over unique_ptr<T>, say) has none
        // to take, and moving it out would hollow a slot this function never
        // refills. So `pivot` is tracked instead of snapshotted: comparisons
        // read through it directly, and whenever the partition's own
        // iter_swap(lo,hi) touches the slot pivot currently names, pivot
        // follows the value to its new position. Same value compared the
        // same number of times either way, zero copies either way.
        It lo = first;
        It hi = last - 1;
        for (;;) {
            while (comp(*lo, *pivot)) ++lo;
            while (comp(*pivot, *hi)) --hi;
            if (lo >= hi) break;
            if (pivot == lo)
                pivot = hi;
            else if (pivot == hi)
                pivot = lo;
            iter_swap(lo, hi);
            ++lo;
            --hi;
        }
        // Recurse into the smaller side, loop on the larger one.
        It split = lo;
        if (split - first < last - split) {
            IntroSort(first, split, depth, comp);
            first = split;
        } else {
            IntroSort(split, last, depth, comp);
            last = split;
        }
    }
}

constexpr int Log2(ptrdiff_t n)
{
    int k = 0;
    while (n > 1) {
        n >>= 1;
        ++k;
    }
    return k;
}

} // namespace __algo_impl

template <typename It, typename Comp>
constexpr void sort(It first, It last, Comp comp)
{
    if (last - first > 1)
        __algo_impl::IntroSort(first, last,
                               2 * __algo_impl::Log2(last - first), comp);
}
template <typename It>
constexpr void sort(It first, It last)
{
    sort(first, last, __algo_impl::Less{});
}

template <typename It, typename Comp>
constexpr void partial_sort(It first, It middle, It last, Comp comp)
{
    if (first == middle) return;
    make_heap(first, middle, comp);
    auto heap_size = middle - first;
    for (It scan = middle; scan != last; ++scan) {
        if (comp(*scan, *first)) {
            iter_swap(scan, first);
            __algo_impl::SiftDown(first, decltype(heap_size){0}, heap_size,
                                  comp);
        }
    }
    sort_heap(first, middle, comp);
}
template <typename It>
constexpr void partial_sort(It first, It middle, It last)
{
    partial_sort(first, middle, last, __algo_impl::Less{});
}

template <typename It, typename Comp>
constexpr void nth_element(It first, It nth, It last, Comp comp)
{
    if (first == last || nth == last) return;
    int depth = 2 * __algo_impl::Log2(last - first);
    for (;;) {
        if (last - first <= __algo_impl::kInsertionThreshold) {
            __algo_impl::InsertionSort(first, last, comp);
            return;
        }
        if (depth-- == 0) {
            partial_sort(first, nth + 1, last, comp); // heap fallback
            return;
        }
        It pivot = __algo_impl::MedianPivot(first, last, comp);
        // Same move-only-proxy hazard as IntroSort's identical pivot
        // pattern, fixed the same way: track pivot's position instead of
        // snapshotting its value (see IntroSort above for the reasoning).
        It lo    = first;
        It hi    = last - 1;
        for (;;) {
            while (comp(*lo, *pivot)) ++lo;
            while (comp(*pivot, *hi)) --hi;
            if (lo >= hi) break;
            if (pivot == lo)
                pivot = hi;
            else if (pivot == hi)
                pivot = lo;
            iter_swap(lo, hi);
            ++lo;
            --hi;
        }
        if (nth < lo)
            last = lo;
        else
            first = lo;
    }
}
template <typename It>
constexpr void nth_element(It first, It nth, It last)
{
    nth_element(first, nth, last, __algo_impl::Less{});
}

// ── merge / stable_sort ─────────────────────────────────────────────────

template <typename In1, typename In2, typename Out, typename Comp>
constexpr Out merge(In1 first1, In1 last1, In2 first2, In2 last2, Out out,
                    Comp comp)
{
    while (first1 != last1 && first2 != last2) {
        if (comp(*first2, *first1)) {
            *out = *first2;
            ++first2;
        } else {
            *out = *first1;
            ++first1;
        }
        ++out;
    }
    out = copy(first1, last1, out);
    return copy(first2, last2, out);
}
template <typename In1, typename In2, typename Out>
constexpr Out merge(In1 first1, In1 last1, In2 first2, In2 last2, Out out)
{
    return merge(first1, last1, first2, last2, out, __algo_impl::Less{});
}

namespace __algo_impl {

// In-place rotate merge — O((n+m)·log(n+m)), stable, no extra memory.
template <typename It, typename Comp>
void RotateMerge(It first, It middle, It last, Comp comp)
{
    auto n1 = middle - first;
    auto n2 = last - middle;
    if (n1 == 0 || n2 == 0) return;
    if (n1 + n2 == 2) {
        if (comp(*middle, *first)) iter_swap(first, middle);
        return;
    }
    It cut1 = first;
    It cut2 = middle;
    if (n1 > n2) {
        cut1 = first + n1 / 2;
        cut2 = lower_bound(middle, last, *cut1, comp);
    } else {
        cut2 = middle + n2 / 2;
        cut1 = upper_bound(first, middle, *cut2, comp);
    }
    It new_middle = rotate(cut1, middle, cut2);
    RotateMerge(first, cut1, new_middle, comp);
    RotateMerge(new_middle, cut2, last, comp);
}

// Merge [first,middle)+[middle,last) through raw storage `buf`
// (capacity ≥ middle-first): move-CONSTRUCT the left run into the
// buffer, merge back by move-assignment, destroy the buffer objects.
template <typename It, typename T, typename Comp>
void BufferedMerge(It first, It middle, It last, T *buf, Comp comp)
{
    T *buf_end = buf;
    try {
        // buf is separate storage (no aliasing risk with the source range),
        // but std::move(*p) still bypasses ranges::iter_move — for a
        // move-only element type inside a proxy (T's own converting
        // constructor tries to copy-construct from a forwarded-as-lvalue
        // reference) that hard-fails to compile. ranges::iter_move routes
        // through the wrapped iterator's own customization instead.
        for (It p = first; p != middle; ++p, ++buf_end)
            ::new (static_cast<void *>(buf_end)) T(ranges::iter_move(p));
    } catch (...) {
        for (T *p = buf; p != buf_end; ++p) p->~T();
        throw;
    }
    T *left  = buf;
    It right = middle;
    It out   = first;
    while (left != buf_end && right != last) {
        if (comp(*right, *left)) {
            // right walks the ORIGINAL (possibly proxy) range; left is a
            // real T* into buf. Same iter_move-vs-std::move split as the
            // buffer fill above, for the same reason.
            *out = ranges::iter_move(right);
            ++right;
        } else {
            *out = std::move(*left);
            ++left;
        }
        ++out;
    }
    for (; left != buf_end; ++left, ++out) *out = std::move(*left);
    for (T *p = buf; p != buf_end; ++p) p->~T();
}

template <typename It, typename T, typename Comp>
void StableSortImpl(It first, It last, T *buf, Comp comp)
{
    auto n = last - first;
    if (n <= kInsertionThreshold) {
        InsertionSort(first, last, comp);
        return;
    }
    It middle = first + n / 2;
    StableSortImpl(first, middle, buf, comp);
    StableSortImpl(middle, last, buf, comp);
    if (comp(*middle, *(middle - 1))) {
        if (buf)
            BufferedMerge(first, middle, last, buf, comp);
        else
            RotateMerge(first, middle, last, comp);
    }
}

} // namespace __algo_impl

template <typename It, typename Comp>
void stable_sort(It first, It last, Comp comp)
{
    using T = typename iterator_traits<It>::value_type;
    auto n  = last - first;
    if (n <= 1) return;
    // Raw temp storage for the left halves (≤ n/2 + 1 elements);
    // BufferedMerge constructs/destroys objects in it per merge step.
    // Allocation failure degrades to the in-place rotate merge —
    // slower, equally stable and correct.
    size_t want = static_cast<size_t>(n / 2 + 1);
    T *buf =
        static_cast<T *>(::operator new(want * sizeof(T), nothrow));
    struct RawGuard {
        T *p;
        ~RawGuard()
        {
            if (p) ::operator delete(p);
        }
    } guard{buf};
    __algo_impl::StableSortImpl(first, last, buf, comp);
}
template <typename It>
void stable_sort(It first, It last)
{
    stable_sort(first, last, __algo_impl::Less{});
}

template <typename It, typename Comp>
void inplace_merge(It first, It middle, It last, Comp comp)
{
    __algo_impl::RotateMerge(first, middle, last, comp);
}
template <typename It>
void inplace_merge(It first, It middle, It last)
{
    inplace_merge(first, middle, last, __algo_impl::Less{});
}

