}

template <typename In1, typename In2, typename Out, typename Comp>
constexpr Out set_intersection(In1 first1, In1 last1, In2 first2, In2 last2,
                               Out out, Comp comp)
{
    while (first1 != last1 && first2 != last2) {
        if (comp(*first1, *first2)) {
            ++first1;
        } else if (comp(*first2, *first1)) {
            ++first2;
        } else {
            *out = *first1;
            ++out;
            ++first1;
            ++first2;
        }
    }
    return out;
}
