template <typename In1, typename In2, typename Comp>
constexpr bool includes(In1 first1, In1 last1, In2 first2, In2 last2,
                        Comp comp)
{
    for (; first2 != last2; ++first1) {
        if (first1 == last1 || comp(*first2, *first1)) return false;
        if (!comp(*first1, *first2)) ++first2;
    }
    return true;
}
template <typename In1, typename In2>
constexpr bool includes(In1 first1, In1 last1, In2 first2, In2 last2)
{
    return includes(first1, last1, first2, last2, __algo_impl::Less{});
}

template <typename In1, typename In2, typename Out, typename Comp>
constexpr Out set_union(In1 first1, In1 last1, In2 first2, In2 last2, Out out,
                        Comp comp)
{
    for (; first1 != last1; ++out) {
        if (first2 == last2) return copy(first1, last1, out);
        if (comp(*first2, *first1)) {
            *out = *first2;
            ++first2;
        } else {
            if (!comp(*first1, *first2)) ++first2;
            *out = *first1;
            ++first1;
        }
    }
    return copy(first2, last2, out);
}
