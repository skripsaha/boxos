// boxcxx — <__bits/version_optional>
//
// The feature-test macros [version.syn] owns for <optional>. 202110L was the
// C++23 value (P0798 monadic and_then/transform/or_else); 202506L is C++26
// with P2988R12's optional<T&>, and P3168R2's range support carries its own
// macro. Both features are complete here, including the deleted-not-absent
// constructors that reject a binding through a materialised temporary.
//
// Every block below is gated on BOXCXX_OWNS_<stem>, and this file has NO
// include guard: it is meant to be included once per owning header, each time
// defining only what that header declared it owns. [support.limits.general]
// says a macro is defined by <version> AND by the header that provides the
// feature; it does not say every header that happens to include this leaf.
// A header that answers for a feature it does not provide is answering a
// question it was not asked, so it no longer does. <version> defines
// BOXCXX_OWNS_ALL and takes the lot. Checked by tools/cxx_ftm_audit.sh.

#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_optional)) && \
    !defined(__cpp_lib_optional)
#  define __cpp_lib_optional 202506L        // P2988R12 optional<T&>
#endif
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_optional)) && \
    !defined(__cpp_lib_optional_range_support)
#  define __cpp_lib_optional_range_support 202406L   // P3168R2
#endif
#undef BOXCXX_OWNS_optional
