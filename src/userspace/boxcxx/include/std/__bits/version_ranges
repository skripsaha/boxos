// boxcxx — <__bits/version_ranges>
//
// The __cpp_lib_ranges* feature-test macros [version.syn] owned by <ranges>
// -- every one of these names a view/adaptor that lives in a file <ranges>
// itself #includes. Split out of <version> so <ranges> can #include just
// this fragment directly: per [support.limits.general] a macro must be
// visible to a translation unit that includes ONLY the owning header, not
// just <version>. <version> includes this same file too, to expose the
// complete set from one place.
//
// Values cross-checked against libstdc++'s own bits/version.def (the
// generator source real GCC ships from -- the most authoritative available
// reference), not just the bleeding-edge eel.is/c++draft snapshot, which
// mixes in C++26-only DR bumps boxcxx does not implement.
//
// __cpp_lib_ranges_reserve_hint (P2846R6) IS here and is a C++26 value: the
// CPO, the approximately_sized_range concept, sized_range's rebasing onto it,
// reserve_hint on all seventeen views the paper touches, and ranges::to using
// it in place of ranges::size are all implemented (Ф32-c).
//
// __cpp_lib_ranges itself is NOT here: it is the widest macro in
// [version.syn], covering the whole of [ranges] plus the specialized-memory
// algorithms, and boxcxx is missing 23 of the entities it promises. See
// <version>'s omission list for the enumeration. Neither is
// __cpp_lib_ranges_as_const, for the reason recorded there.
//
// Every block below is gated on BOXCXX_OWNS_<stem>, and this file has NO
// include guard: it is meant to be included once per owning header, each time
// defining only what that header declared it owns. [support.limits.general]
// says a macro is defined by <version> AND by the header that provides the
// feature; it does not say every header that happens to include this leaf.
// A header that answers for a feature it does not provide is answering a
// question it was not asked, so it no longer does. <version> defines
// BOXCXX_OWNS_ALL and takes the lot. Checked by tools/cxx_ftm_audit.sh.

// __cpp_lib_ranges_zip is co-owned by <ranges>, <tuple> and <utility>, so
// it is DEFINED in <__bits/version_utility> (one definition site for every
// co-owned macro) and reaches <ranges> through this include.
#include <__bits/version_utility>

#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_ranges_to_container)) && \
    !defined(__cpp_lib_ranges_to_container)
#  define __cpp_lib_ranges_to_container 202202L
#endif
#undef BOXCXX_OWNS_ranges_to_container
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_ranges_as_const)) && \
    !defined(__cpp_lib_ranges_as_const)
// P2278R4. Claimable since Ф31e-b added the paper's last four names:
// ranges::cbegin / ranges::cend (in <iterator>, beside make_const_iterator)
// and view_interface::cbegin / cend. N4950's value is taken, not the 202311L
// libstdc++ reports -- that is the later P2836R1 DR, which is not built here.
#  define __cpp_lib_ranges_as_const 202207L
#endif
#undef BOXCXX_OWNS_ranges_as_const
