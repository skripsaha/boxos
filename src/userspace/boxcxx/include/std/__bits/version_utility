// boxcxx — <__bits/version_utility>
//
// The feature-test macros [version.syn] that <utility> owns or CO-owns.
// Split out for the same [support.limits.general] per-header reason as
// <__bits/version_ranges> -- see that file's comment.
//
// Three of these are jointly owned, and this leaf is the single definition
// site for all three -- every co-owning header reaches it, so no macro is
// ever spelled twice (two #ifndef-guarded copies in two leaves would make
// the effective value depend on include order the moment they drifted):
//   __cpp_lib_tuples_by_type      <utility> + <tuple>   (get<T> on both)
//   __cpp_lib_constexpr_algorithms <algorithm> + <utility>
//                                 (P0202 made <utility>'s swap/exchange
//                                  constexpr too, not just [algorithms])
//   __cpp_lib_ranges_zip          <ranges> + <tuple> + <utility>
//                                 (P2321 is half a <ranges> paper and half
//                                  a pair/tuple paper)
// <tuple> and <utility> include this leaf directly;
// <__bits/version_algorithm> and <__bits/version_ranges> include it so
// <algorithm> and <ranges> get their share through the leaf they already
// include.
#ifndef BOXCXX_BITS_VERSION_UTILITY
#define BOXCXX_BITS_VERSION_UTILITY

#ifndef __cpp_lib_as_const
#  define __cpp_lib_as_const 201510L
#endif
#ifndef __cpp_lib_constexpr_utility
#  define __cpp_lib_constexpr_utility 201811L
#endif
#ifndef __cpp_lib_exchange_function
#  define __cpp_lib_exchange_function 201304L
#endif
#ifndef __cpp_lib_forward_like
#  define __cpp_lib_forward_like 202207L
#endif
#ifndef __cpp_lib_integer_comparison_functions
#  define __cpp_lib_integer_comparison_functions 202002L
#endif
#ifndef __cpp_lib_integer_sequence
#  define __cpp_lib_integer_sequence 201304L
#endif
#ifndef __cpp_lib_to_underlying
#  define __cpp_lib_to_underlying 202102L
#endif
#ifndef __cpp_lib_tuples_by_type
#  define __cpp_lib_tuples_by_type 201304L
#endif
#ifndef __cpp_lib_tuple_like
#  define __cpp_lib_tuple_like 202207L
#endif
#ifndef __cpp_lib_unreachable
#  define __cpp_lib_unreachable 202202L
#endif

// C++26 value (P2562R1 "constexpr Stable Sorting"), claimed in Ф32-b. P0202
// gave C++20 the 201806L value and excluded three algorithms because they
// need a temporary buffer that C++20 could not allocate in a constant
// expression: stable_sort, stable_partition and inplace_merge. P2562R1
// removes that exclusion, and all six entry points -- the three classic ones
// and ranges::stable_sort / ranges::stable_partition / ranges::inplace_merge
// -- are constexpr here now. inplace_merge never needed the buffer at all
// (it has always been the rotate merge); the other two take their existing
// buffer-free path during constant evaluation, which is what [stable.sort]
// and [alg.partitions] already specify for "no additional memory available".
// The rest of P0202's exclusion list -- shuffle and sample, which want a
// constexpr uniform_random_bit_generator -- is not part of P2562R1 and is
// not part of this macro.
#ifndef __cpp_lib_constexpr_algorithms
#  define __cpp_lib_constexpr_algorithms 202306L
#endif
// P2321R2 "zip". The <ranges> half (zip/zip_transform/adjacent/pairwise and
// their _transform forms) shipped in Ф29d; the <tuple>/<utility> half is
// the converting constructors, the const-qualified assignments and swaps,
// and the basic_common_reference / common_type specializations that let a
// proxy pair/tuple of references meet its value counterpart.
#ifndef __cpp_lib_ranges_zip
#  define __cpp_lib_ranges_zip 202110L
#endif

#endif // BOXCXX_BITS_VERSION_UTILITY
