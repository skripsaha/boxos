// ── money_get [locale.money.get] ────────────────────────────────────────
// The parse follows mp.neg_format() for BOTH signs — [locale.money.get.
// virtuals] says so, and it is why a locale whose two patterns differ can
// write something it cannot read back.
//
// Nothing is ever put back. A single-pass iterator cannot, so a multi-character
// string (the currency symbol, a sign like "()") is only entered when its FIRST
// character matches, and a mismatch after that is a failure rather than a
// retreat. That is the same discipline num_get's stage 2 arrived at in Ф43-c-2.
template <class charT, class InputIterator = istreambuf_iterator<charT>>
class money_get : public locale::facet {
public:
    using char_type   = charT;
    using iter_type   = InputIterator;
    using string_type = basic_string<charT>;

    constexpr explicit money_get(size_t refs = 0) noexcept : locale::facet(refs) {}

    static locale::id id;

    iter_type get(iter_type s, iter_type end, bool intl, ios_base &f,
                  ios_base::iostate &err, long double &units) const
    {
        return do_get(s, end, intl, f, err, units);
    }
    iter_type get(iter_type s, iter_type end, bool intl, ios_base &f,
                  ios_base::iostate &err, string_type &digits) const
    {
        return do_get(s, end, intl, f, err, digits);
    }

protected:
    ~money_get() = default;

    virtual iter_type do_get(iter_type s, iter_type end, bool intl, ios_base &f,
                             ios_base::iostate &err, long double &units) const
    {
        string      ascii;
        string_type wide;
        bool        neg = false;
        const bool  ok  = intl ? Parse<true>(s, end, f, err, ascii, wide, neg)
                               : Parse<false>(s, end, f, err, ascii, wide, neg);
        if (!ok) return s;

        long double v = 0;
        auto        r = from_chars(ascii.data(), ascii.data() + ascii.size(), v,
                                   chars_format::fixed);
        if (r.ec == errc::result_out_of_range) {
            // The clamped extreme carrying the parsed sign, which is the
            // convention num_get already uses for a number too large to hold.
            units = neg ? -numeric_limits<long double>::max()
                        : numeric_limits<long double>::max();
            err |= ios_base::failbit;
            return s;
        }
        if (r.ec != errc{}) {
            err |= ios_base::failbit;
            return s;
        }
        units = neg ? -v : v;
        return s;
    }

    virtual iter_type do_get(iter_type s, iter_type end, bool intl, ios_base &f,
                             ios_base::iostate &err, string_type &digits) const
    {
        string      ascii;
        string_type wide;
        bool        neg = false;
        const bool  ok  = intl ? Parse<true>(s, end, f, err, ascii, wide, neg)
                               : Parse<false>(s, end, f, err, ascii, wide, neg);
        if (!ok) return s;

        // The stored string carries the minus and no plus, which is exactly
        // the form the other do_put overload accepts back. The locale is held
        // by value: use_facet returns a reference INTO the table it names, and
        // getloc() hands back a temporary.
        const locale        loc = f.getloc();
        const ctype<charT> &ct  = use_facet<ctype<charT>>(loc);
        digits.clear();
        if (neg) digits.push_back(ct.widen('-'));
        digits.append(wide);
        return s;
    }

private:
    template <bool Intl>
    bool Parse(iter_type &in, iter_type end, ios_base &str, ios_base::iostate &err,
               string &ascii, string_type &wide, bool &neg) const
    {
        const locale                   loc = str.getloc();
        const ctype<charT>            &ct  = use_facet<ctype<charT>>(loc);
        const moneypunct<charT, Intl> &mp  = use_facet<moneypunct<charT, Intl>>(loc);

        const money_base::pattern pat  = mp.neg_format();
        const basic_string<charT> ps   = mp.positive_sign();
        const basic_string<charT> ns   = mp.negative_sign();
        const basic_string<charT> sym  = mp.curr_symbol();
        const string              grp  = mp.grouping();
        const int                 frac = mp.frac_digits();
        const bool showbase = (str.flags() & ios_base::showbase) != ios_base::fmtflags{};

        bool                hitEnd = false;
        basic_string<charT> tail;      // what is left of a matched sign string
        bool                sawValue = false;
        neg                          = false;

        const auto Fail = [&]() {
            if (hitEnd) err |= ios_base::eofbit;
            err |= ios_base::failbit;
            return false;
        };
        const auto Peek = [&](charT &c) {
            if (in == end) {
                hitEnd = true;
                return false;
            }
            c = *in;
            return true;
        };

        for (int k = 0; k < 4; ++k) {
            switch (pat.field[k]) {
                case money_base::none: {
                    // Whitespace is permitted here — unless `none` ends the
                    // pattern, in which case the field is over and trailing
                    // whitespace belongs to whatever reads next.
                    if (k == 3) break;
                    charT c;
                    while (Peek(c) && ct.is(ctype_base::space, c)) ++in;
                    break;
                }
                case money_base::space: {
                    charT c;
                    if (!Peek(c) || !ct.is(ctype_base::space, c)) return Fail();
                    while (Peek(c) && ct.is(ctype_base::space, c)) ++in;
                    break;
                }
                case money_base::symbol: {
                    if (sym.empty()) break;
                    charT c;
                    if (!Peek(c)) {
                        if (showbase) return Fail();
                        break;
                    }
                    if (c != sym[0]) {
                        // Optional means optional: a symbol that is not there
                        // is only an error when showbase demanded it.
                        if (showbase) return Fail();
                        break;
                    }
                    for (size_t i = 0; i < sym.size(); ++i) {
                        if (!Peek(c) || c != sym[i]) return Fail();
                        ++in;
                    }
                    break;
                }
                case money_base::sign: {
                    charT c;
                    const bool have = Peek(c);
                    if (!ps.empty() && have && c == ps[0]) {
                        neg  = false;
                        tail = ps.substr(1);
                        ++in;
                    } else if (!ns.empty() && have && c == ns[0]) {
                        neg  = true;
                        tail = ns.substr(1);
                        ++in;
                    } else if (ps.empty()) {
                        // An empty sign string matches the empty string, and
                        // when both are empty [locale.money.get.virtuals] makes
                        // the result positive.
                        neg = false;
                    } else if (ns.empty()) {
                        neg = true;
                    } else {
                        return Fail();
                    }
                    break;
                }
                case money_base::value: {
                    if (!Value(in, end, ct, grp, mp, frac, ascii, wide, hitEnd))
                        return Fail();
                    sawValue = true;
                    break;
                }
                default:
                    break;
            }
        }

        if (!sawValue) return Fail();

        // Whatever is left of a multi-character sign is required after every
        // other component, which is what makes "(12.34)" one field.
        for (size_t i = 0; i < tail.size(); ++i) {
            charT c;
            if (!Peek(c) || c != tail[i]) return Fail();
            ++in;
        }

        if (in == end) hitEnd = true;
        if (hitEnd) err |= ios_base::eofbit;
        return true;
    }

    template <bool Intl>
    bool Value(iter_type &in, iter_type end, const ctype<charT> &ct, const string &grp,
               const moneypunct<charT, Intl> &mp, int frac, string &ascii,
               string_type &wide, bool &hitEnd) const
    {
        const charT sep     = mp.thousands_sep();
        const charT point   = mp.decimal_point();
        const bool  grouped = !grp.empty();

        // Separator positions grow with the input, like the digits themselves:
        // put_money can write 4933 digits from a long double, so a fixed mark
        // buffer here would refuse amounts this same facet can produce.
        vector<size_t> seps;

        size_t n = 0;
        for (;;) {
            if (in == end) {
                hitEnd = true;
                break;
            }
            const charT c = *in;
            if (grouped && c == sep) {
                seps.push_back(n);
                ++in;
                continue;
            }
            if (!ct.is(ctype_base::digit, c)) break;
            ascii.push_back(ct.narrow(c, '0'));
            wide.push_back(c);
            ++n;
            ++in;
        }
        if (n == 0) return false;
        if (!__ios::__grouping::ConsistentAt(grp, seps.data(), seps.size(), n)) return false;

        if (frac <= 0) return true;

        // The fraction is not optional when the facet says an amount has one.
        // libstdc++ accepts an amount without it and reads "1234" as 12.34;
        // libc++ requires it. Requiring is the only rule under which no input
        // is silently reinterpreted as a different amount.
        if (in == end) {
            hitEnd = true;
            return false;
        }
        if (*in != point) return false;
        ++in;
        for (int i = 0; i < frac; ++i) {
            if (in == end) {
                hitEnd = true;
                return false;
            }
            const charT c = *in;
            if (!ct.is(ctype_base::digit, c)) return false;
            ascii.push_back(ct.narrow(c, '0'));
            wide.push_back(c);
            ++in;
        }
        return true;
    }
};

template <class charT, class InputIterator>
locale::id money_get<charT, InputIterator>::id{};

template <>
inline locale::id money_get<char, istreambuf_iterator<char>>::id{__cvt::kIdMoneyGetChar};
template <>
inline locale::id money_get<wchar_t, istreambuf_iterator<wchar_t>>::id{
    __cvt::kIdMoneyGetWchar};

