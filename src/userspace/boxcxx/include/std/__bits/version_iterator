// boxcxx — <__bits/version_iterator>
//
// The feature-test macros [version.syn] owned by <iterator>, plus
// __cpp_lib_array_constexpr, which <iterator> and <array> own jointly
// (P1032's constexpr reverse_iterator/move_iterator/insert iterators and
// P1023's constexpr array comparisons are one feature split over two
// headers). Both headers include this leaf.
//
// __cpp_lib_nonmember_container_access is deliberately NOT here -- see
// <version>'s "deliberately NOT defined" list.
//
// Every block below is gated on BOXCXX_OWNS_<stem>, and this file has NO
// include guard: it is meant to be included once per owning header, each time
// defining only what that header declared it owns. [support.limits.general]
// says a macro is defined by <version> AND by the header that provides the
// feature; it does not say every header that happens to include this leaf.
// A header that answers for a feature it does not provide is answering a
// question it was not asked, so it no longer does. <version> defines
// BOXCXX_OWNS_ALL and takes the lot. Checked by tools/cxx_ftm_audit.sh.

#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_nonmember_container_access)) && \
    !defined(__cpp_lib_nonmember_container_access)
#  define __cpp_lib_nonmember_container_access 201411L
#endif
#undef BOXCXX_OWNS_nonmember_container_access

#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_array_constexpr)) && \
    !defined(__cpp_lib_array_constexpr)
#  define __cpp_lib_array_constexpr 201811L
#endif
#undef BOXCXX_OWNS_array_constexpr
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_constexpr_iterator)) && \
    !defined(__cpp_lib_constexpr_iterator)
#  define __cpp_lib_constexpr_iterator 201811L
#endif
#undef BOXCXX_OWNS_constexpr_iterator
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_make_reverse_iterator)) && \
    !defined(__cpp_lib_make_reverse_iterator)
#  define __cpp_lib_make_reverse_iterator 201402L
#endif
#undef BOXCXX_OWNS_make_reverse_iterator
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_move_iterator_concept)) && \
    !defined(__cpp_lib_move_iterator_concept)
#  define __cpp_lib_move_iterator_concept 202207L
#endif
#undef BOXCXX_OWNS_move_iterator_concept
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_null_iterators)) && \
    !defined(__cpp_lib_null_iterators)
#  define __cpp_lib_null_iterators 201304L
#endif
#undef BOXCXX_OWNS_null_iterators
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_ssize)) && \
    !defined(__cpp_lib_ssize)
#  define __cpp_lib_ssize 201902L
#endif
#undef BOXCXX_OWNS_ssize
