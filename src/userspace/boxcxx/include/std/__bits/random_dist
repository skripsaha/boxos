inline constexpr double kPi = 3.14159265358979311600;

template <class G> inline double canon(G &g)
{
    return generate_canonical<double, numeric_limits<double>::digits>(g);
}

// Uniform value in [0, range] (inclusive) from any engine, unbiased.
template <class G>
inline unsigned long long bounded(G &g, unsigned long long range)
{
    using UR             = unsigned long long;
    if (range == 0) return 0;
    const UR gmin  = static_cast<UR>(g.min());
    const UR gspan = static_cast<UR>(g.max()) - gmin; // engine span
    if (gspan >= range) {
        if (gspan == range) return static_cast<UR>(g()) - gmin;
        const UR n       = range + 1; // range < gspan ≤ max ⇒ no overflow
        const UR scaling = gspan / n;
        const UR limit   = n * scaling;
        UR       a;
        do { a = static_cast<UR>(g()) - gmin; } while (a >= limit);
        return a / scaling;
    }
    // gspan < range: assemble a wide value by base-(gspan+1) Horner + reject.
    const UR    m = gspan + 1;
    __uint128_t modulus = static_cast<__uint128_t>(range) + 1;
    for (;;) {
        __uint128_t prod = 1, acc = 0;
        while (prod <= static_cast<__uint128_t>(range)) {
            acc = acc * m + (static_cast<UR>(g()) - gmin);
            prod *= m;
        }
        __uint128_t lim = prod - (prod % modulus);
        if (acc < lim) return static_cast<UR>(acc % modulus);
    }
}

template <class G> inline double normal01(G &g)
{
    double u1;
    do { u1 = canon(g); } while (u1 <= 0.0);
    double u2 = canon(g);
    return std::sqrt(-2.0 * std::log(u1)) * std::cos(2.0 * kPi * u2);
}

template <class G> inline double gamma(G &g, double a, double b)
{
    if (a < 1.0) {
        double u = canon(g);
        return gamma(g, a + 1.0, b) * std::pow(u, 1.0 / a);
    }
    const double d = a - 1.0 / 3.0;
    const double c = 1.0 / std::sqrt(9.0 * d);
    for (;;) {
        double x, v;
        do { x = normal01(g); v = 1.0 + c * x; } while (v <= 0.0);
        v        = v * v * v;
        double u = canon(g);
        if (u < 1.0 - 0.0331 * x * x * x * x) return d * v * b;
        if (std::log(u) < 0.5 * x * x + d * (1.0 - v + std::log(v)))
            return d * v * b;
    }
}

