// ── poisson_distribution ([rand.dist.pois.poisson]) ──────────────────────
template <class IntType = int> class poisson_distribution {
public:
    using result_type = IntType;
    struct param_type {
        using distribution_type = poisson_distribution;
        explicit param_type(double m = 1.0) : mean_(m) {}
        double      mean() const { return mean_; }
        friend bool operator==(const param_type &x, const param_type &y)
        {
            return x.mean_ == y.mean_;
        }
        double mean_;
    };

    poisson_distribution() : poisson_distribution(1.0) {}
    explicit poisson_distribution(double mean) : p_(mean) {}
    explicit poisson_distribution(const param_type &p) : p_(p) {}

    void        reset() {}
    double      mean() const { return p_.mean(); }
    param_type  param() const { return p_; }
    void        param(const param_type &p) { p_ = p; }
    result_type min() const { return 0; }
    result_type max() const { return numeric_limits<result_type>::max(); }

    template <class G> result_type operator()(G &g) { return (*this)(g, p_); }
    template <class G> result_type operator()(G &g, const param_type &p)
    {
        const double lambda = p.mean();
        if (lambda < 12.0) { // Knuth
            const double L = std::exp(-lambda);
            int          k = 0;
            double       pp = 1.0;
            do { ++k; pp *= __rng::canon(g); } while (pp > L);
            return static_cast<result_type>(k - 1);
        }
        // Hörmann PTRS transformed rejection (λ ≥ 12).
        const double b         = 0.931 + 2.53 * std::sqrt(lambda);
        const double a         = -0.059 + 0.02483 * b;
        const double inv_alpha = 1.1239 + 1.1328 / (b - 3.4);
        const double vr        = 0.9277 - 3.6224 / (b - 2.0);
        for (;;) {
            double u  = __rng::canon(g) - 0.5;
            double v  = __rng::canon(g);
            double us = 0.5 - std::fabs(u);
            double k  = std::floor((2.0 * a / us + b) * u + lambda + 0.43);
            if (us >= 0.07 && v <= vr) return static_cast<result_type>(k);
            if (k < 0.0 || (us < 0.013 && v > us)) continue;
            if (std::log(v) + std::log(inv_alpha) - std::log(a / (us * us) + b) <=
                -lambda + k * std::log(lambda) - std::lgamma(k + 1.0))
                return static_cast<result_type>(k);
        }
    }
    friend bool operator==(const poisson_distribution &x,
                           const poisson_distribution &y)
    {
        return x.p_ == y.p_;
    }

private:
    param_type p_;
};

// ── binomial_distribution ([rand.dist.bern.bin]) ─────────────────────────
template <class IntType = int> class binomial_distribution {
public:
    using result_type = IntType;
    struct param_type {
        using distribution_type = binomial_distribution;
        explicit param_type(IntType tt = 1, double pp = 0.5) : t_(tt), p_(pp) {}
        IntType     t() const { return t_; }
        double      p() const { return p_; }
        friend bool operator==(const param_type &x, const param_type &y)
        {
            return x.t_ == y.t_ && x.p_ == y.p_;
        }
        IntType t_;
        double  p_;
    };

    binomial_distribution() : binomial_distribution(1) {}
    explicit binomial_distribution(IntType t, double p = 0.5) : p_(t, p) {}
    explicit binomial_distribution(const param_type &p) : p_(p) {}

    void        reset() {}
    IntType     t() const { return p_.t(); }
    double      p() const { return p_.p(); }
    param_type  param() const { return p_; }
    void        param(const param_type &p) { p_ = p; }
    result_type min() const { return 0; }
    result_type max() const { return p_.t(); }

    template <class G> result_type operator()(G &g) { return (*this)(g, p_); }
    template <class G> result_type operator()(G &g, const param_type &par)
    {
        const IntType t = par.t();
        double        p = par.p();
        if (t <= 0 || p <= 0.0) return 0;
        if (p >= 1.0) return t;
        const bool   flip = p > 0.5;
        const double pp   = flip ? 1.0 - p : p;
        IntType      x;
        if (static_cast<double>(t) * pp < 30.0) { // BINV inversion
            const double q = 1.0 - pp;
            const double s = pp / q;
            const double aa = (t + 1) * s;
            double       r  = std::pow(q, static_cast<double>(t));
            double       u  = __rng::canon(g);
            x               = 0;
            while (u > r && x < t) {
                u -= r;
                ++x;
                r *= (aa / x - s);
            }
        } else { // count Bernoulli trials (correct; O(t))
            x = 0;
            for (IntType i = 0; i < t; ++i)
                if (__rng::canon(g) < pp) ++x;
        }
        return flip ? t - x : x;
    }
    friend bool operator==(const binomial_distribution &x,
                           const binomial_distribution &y)
    {
        return x.p_ == y.p_;
    }

private:
    param_type p_;
};

// ── negative_binomial_distribution ([rand.dist.bern.negbin]) ─────────────
template <class IntType = int> class negative_binomial_distribution {
public:
    using result_type = IntType;
    struct param_type {
        using distribution_type = negative_binomial_distribution;
        explicit param_type(IntType kk = 1, double pp = 0.5) : k_(kk), p_(pp) {}
        IntType     k() const { return k_; }
        double      p() const { return p_; }
        friend bool operator==(const param_type &x, const param_type &y)
        {
            return x.k_ == y.k_ && x.p_ == y.p_;
        }
        IntType k_;
        double  p_;
    };

    negative_binomial_distribution() : negative_binomial_distribution(1) {}
    explicit negative_binomial_distribution(IntType k, double p = 0.5)
        : p_(k, p) {}
    explicit negative_binomial_distribution(const param_type &p) : p_(p) {}

    void        reset() {}
    IntType     k() const { return p_.k(); }
    double      p() const { return p_.p(); }
    param_type  param() const { return p_; }
    void        param(const param_type &p) { p_ = p; }
    result_type min() const { return 0; }
    result_type max() const { return numeric_limits<result_type>::max(); }

    template <class G> result_type operator()(G &g) { return (*this)(g, p_); }
    template <class G> result_type operator()(G &g, const param_type &par)
    {
        // Gamma–Poisson mixture (Pólya): λ ~ Γ(k, (1-p)/p), then Poisson(λ).
        double               lambda = __rng::gamma(g, static_cast<double>(par.k()),
                                     (1.0 - par.p()) / par.p());
        poisson_distribution<IntType> pois(lambda);
        return pois(g);
    }
    friend bool operator==(const negative_binomial_distribution &x,
                           const negative_binomial_distribution &y)
    {
        return x.p_ == y.p_;
    }

private:
    param_type p_;
};

