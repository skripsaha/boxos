    result_type min() const { return -numeric_limits<result_type>::max(); }
    result_type max() const { return numeric_limits<result_type>::max(); }

    template <class G> result_type operator()(G &g) { return (*this)(g, p_); }
    template <class G> result_type operator()(G &g, const param_type &p)
    {
        if (has_saved_) {
            has_saved_ = false;
            return static_cast<result_type>(saved_ * p.stddev() + p.mean());
        }
        double u, v, s;
        do {
            u = 2.0 * __rng::canon(g) - 1.0;
            v = 2.0 * __rng::canon(g) - 1.0;
            s = u * u + v * v;
        } while (s >= 1.0 || s == 0.0);
        double mul = std::sqrt(-2.0 * std::log(s) / s);
        saved_     = v * mul;
        has_saved_ = true;
        return static_cast<result_type>(u * mul * p.stddev() + p.mean());
    }
    friend bool operator==(const normal_distribution &x,
                           const normal_distribution &y)
    {
        return x.p_ == y.p_ && x.has_saved_ == y.has_saved_ &&
               (!x.has_saved_ || x.saved_ == y.saved_);
    }

private:
    param_type p_;
    double     saved_     = 0.0;
    bool       has_saved_ = false;
};

