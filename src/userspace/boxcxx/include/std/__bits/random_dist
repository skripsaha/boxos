// ── discrete_distribution ([rand.dist.samp.discrete]) ────────────────────
template <class IntType = int> class discrete_distribution {
public:
    using result_type = IntType;
    struct param_type {
        using distribution_type = discrete_distribution;
        param_type() : probs_(1, 1.0) {}
        template <class InputIt>
        param_type(InputIt first, InputIt last) : probs_(first, last) { norm(); }
        param_type(initializer_list<double> il) : probs_(il) { norm(); }
        template <class UnaryOp>
        param_type(size_t count, double xmin, double xmax, UnaryOp fw)
        {
            if (count == 0) { probs_.push_back(1.0); return; }
            double delta = (xmax - xmin) / static_cast<double>(count);
            for (size_t k = 0; k < count; ++k)
                probs_.push_back(fw(xmin + delta * (k + 0.5)));
            norm();
        }
        vector<double> probabilities() const { return probs_; }
        friend bool    operator==(const param_type &x, const param_type &y)
        {
            return x.probs_ == y.probs_;
        }
        void norm()
        {
            if (probs_.empty()) { probs_.push_back(1.0); return; }
            double s = 0.0;
            for (double w : probs_) s += w;
            if (s > 0.0)
                for (double &w : probs_) w /= s;
            cum_.assign(probs_.size(), 0.0);
            double c = 0.0;
            for (size_t i = 0; i < probs_.size(); ++i) { c += probs_[i]; cum_[i] = c; }
        }
        vector<double> probs_;
        vector<double> cum_;
    };

    discrete_distribution() : p_() {}
    template <class InputIt>
    discrete_distribution(InputIt first, InputIt last) : p_(first, last) {}
    discrete_distribution(initializer_list<double> il) : p_(il) {}
    template <class UnaryOp>
    discrete_distribution(size_t count, double xmin, double xmax, UnaryOp fw)
        : p_(count, xmin, xmax, fw) {}
    explicit discrete_distribution(const param_type &p) : p_(p) {}

    void           reset() {}
    vector<double> probabilities() const { return p_.probabilities(); }
    param_type     param() const { return p_; }
    void           param(const param_type &p) { p_ = p; }
    result_type    min() const { return 0; }
    result_type    max() const
    {
        return static_cast<result_type>(p_.probs_.size() - 1);
    }

    template <class G> result_type operator()(G &g) { return (*this)(g, p_); }
    template <class G> result_type operator()(G &g, const param_type &p)
    {
        double u = __rng::canon(g);
        for (size_t i = 0; i < p.cum_.size(); ++i)
            if (u < p.cum_[i]) return static_cast<result_type>(i);
        return static_cast<result_type>(p.cum_.size() - 1);
    }
    friend bool operator==(const discrete_distribution &x,
                           const discrete_distribution &y)
    {
        return x.p_ == y.p_;
    }

private:
    param_type p_;
};

// ── piecewise_constant_distribution ([rand.dist.samp.pconst]) ────────────
template <class RealType = double> class piecewise_constant_distribution {
public:
    using result_type = RealType;
    struct param_type {
        using distribution_type = piecewise_constant_distribution;
        param_type() : b_(2), w_(1, 1.0) { b_[0] = 0; b_[1] = 1; build(); }
        template <class InputItB, class InputItW>
        param_type(InputItB bf, InputItB bl, InputItW wf) : b_(bf, bl)
        {
            size_t n = b_.size() > 0 ? b_.size() - 1 : 0;
            for (size_t i = 0; i < n; ++i) w_.push_back(*wf++);
            build();
        }
        template <class UnaryOp>
        param_type(initializer_list<RealType> bl, UnaryOp fw) : b_(bl)
        {
            for (size_t i = 0; i + 1 < b_.size(); ++i)
                w_.push_back(fw((b_[i] + b_[i + 1]) / 2));
            build();
        }
        template <class UnaryOp>
        param_type(size_t nw, RealType xmin, RealType xmax, UnaryOp fw)
        {
            size_t   n     = nw == 0 ? 1 : nw;
            RealType delta = (xmax - xmin) / static_cast<RealType>(n);
            for (size_t i = 0; i <= n; ++i) b_.push_back(xmin + delta * i);
            for (size_t i = 0; i < n; ++i)
                w_.push_back(fw(xmin + delta * (i + RealType(0.5))));
            build();
        }
        vector<RealType> intervals() const { return b_; }
        vector<RealType> densities() const { return dens_; }
        friend bool      operator==(const param_type &x, const param_type &y)
        {
            return x.b_ == y.b_ && x.w_ == y.w_;
        }
        void build()
        {
            if (b_.size() < 2) { b_ = {0, 1}; w_ = {1.0}; }
            double s = 0.0;
            for (double w : w_) s += w;
            cum_.assign(w_.size(), 0.0);
            dens_.assign(w_.size(), 0.0);
            double c = 0.0;
            for (size_t i = 0; i < w_.size(); ++i) {
                double wn = s > 0.0 ? w_[i] / s : 0.0;
                c += wn;
                cum_[i]  = c;
                double width = static_cast<double>(b_[i + 1] - b_[i]);
                dens_[i] = width > 0.0 ? wn / width : 0.0;
            }
        }
        vector<RealType> b_;
        vector<double>   w_;
        vector<double>   cum_;
        vector<RealType> dens_;
    };

    piecewise_constant_distribution() : p_() {}
    template <class InputItB, class InputItW>
    piecewise_constant_distribution(InputItB bf, InputItB bl, InputItW wf)
        : p_(bf, bl, wf) {}
    template <class UnaryOp>
    piecewise_constant_distribution(initializer_list<RealType> bl, UnaryOp fw)
        : p_(bl, fw) {}
    template <class UnaryOp>
    piecewise_constant_distribution(size_t nw, RealType xmin, RealType xmax,
                                    UnaryOp fw)
        : p_(nw, xmin, xmax, fw) {}
    explicit piecewise_constant_distribution(const param_type &p) : p_(p) {}

    void             reset() {}
    vector<RealType> intervals() const { return p_.intervals(); }
    vector<RealType> densities() const { return p_.densities(); }
    param_type       param() const { return p_; }
    void             param(const param_type &p) { p_ = p; }
    result_type      min() const { return p_.b_.front(); }
    result_type      max() const { return p_.b_.back(); }

    template <class G> result_type operator()(G &g) { return (*this)(g, p_); }
    template <class G> result_type operator()(G &g, const param_type &p)
    {
        double u = __rng::canon(g);
        size_t i = 0;
        while (i + 1 < p.cum_.size() && u >= p.cum_[i]) ++i;
        double within = __rng::canon(g);
        return static_cast<result_type>(p.b_[i] +
                                        within * (p.b_[i + 1] - p.b_[i]));
    }
    friend bool operator==(const piecewise_constant_distribution &x,
                           const piecewise_constant_distribution &y)
    {
        return x.p_ == y.p_;
    }

private:
    param_type p_;
};

// ── piecewise_linear_distribution ([rand.dist.samp.plinear]) ─────────────
template <class RealType = double> class piecewise_linear_distribution {
public:
    using result_type = RealType;
    struct param_type {
        using distribution_type = piecewise_linear_distribution;
        param_type() : b_(2), w_(2, 1.0) { b_[0] = 0; b_[1] = 1; build(); }
        template <class InputItB, class InputItW>
        param_type(InputItB bf, InputItB bl, InputItW wf) : b_(bf, bl)
        {
            for (size_t i = 0; i < b_.size(); ++i) w_.push_back(*wf++);
            build();
        }
        template <class UnaryOp>
        param_type(initializer_list<RealType> bl, UnaryOp fw) : b_(bl)
        {
            for (size_t i = 0; i < b_.size(); ++i) w_.push_back(fw(b_[i]));
            build();
        }
        template <class UnaryOp>
        param_type(size_t nw, RealType xmin, RealType xmax, UnaryOp fw)
        {
            size_t   n     = nw == 0 ? 1 : nw;
            RealType delta = (xmax - xmin) / static_cast<RealType>(n);
            for (size_t i = 0; i <= n; ++i) {
                b_.push_back(xmin + delta * i);
                w_.push_back(fw(xmin + delta * i));
            }
            build();
        }
        vector<RealType> intervals() const { return b_; }
        vector<RealType> densities() const { return dens_; }
        friend bool      operator==(const param_type &x, const param_type &y)
        {
            return x.b_ == y.b_ && x.w_ == y.w_;
        }
        void build()
        {
            if (b_.size() < 2) { b_ = {0, 1}; w_ = {1.0, 1.0}; }
            // total area (trapezoids) for normalization
            double area = 0.0;
            for (size_t i = 0; i + 1 < b_.size(); ++i)
                area += 0.5 * (w_[i] + w_[i + 1]) *
                        static_cast<double>(b_[i + 1] - b_[i]);
            dens_.assign(w_.size(), 0.0);
            for (size_t i = 0; i < w_.size(); ++i)
                dens_[i] = area > 0.0 ? w_[i] / area : 0.0;
            cum_.assign(b_.size() - 1, 0.0);
            double c = 0.0;
            for (size_t i = 0; i + 1 < b_.size(); ++i) {
                c += 0.5 * (dens_[i] + dens_[i + 1]) *
                     static_cast<double>(b_[i + 1] - b_[i]);
                cum_[i] = c;
            }
        }
        vector<RealType> b_;
        vector<double>   w_;
        vector<double>   cum_;
        vector<RealType> dens_;
    };

    piecewise_linear_distribution() : p_() {}
    template <class InputItB, class InputItW>
    piecewise_linear_distribution(InputItB bf, InputItB bl, InputItW wf)
        : p_(bf, bl, wf) {}
    template <class UnaryOp>
    piecewise_linear_distribution(initializer_list<RealType> bl, UnaryOp fw)
        : p_(bl, fw) {}
    template <class UnaryOp>
    piecewise_linear_distribution(size_t nw, RealType xmin, RealType xmax,
                                  UnaryOp fw)
        : p_(nw, xmin, xmax, fw) {}
    explicit piecewise_linear_distribution(const param_type &p) : p_(p) {}

    void             reset() {}
    vector<RealType> intervals() const { return p_.intervals(); }
    vector<RealType> densities() const { return p_.densities(); }
    param_type       param() const { return p_; }
    void             param(const param_type &p) { p_ = p; }
    result_type      min() const { return p_.b_.front(); }
    result_type      max() const { return p_.b_.back(); }

    template <class G> result_type operator()(G &g) { return (*this)(g, p_); }
    template <class G> result_type operator()(G &g, const param_type &p)
    {
        double u = __rng::canon(g);
        size_t i = 0;
        while (i + 1 < p.cum_.size() && u >= p.cum_[i]) ++i;
        // invert the linear density over [b_i, b_{i+1}]
        double x0 = static_cast<double>(p.b_[i]);
        double x1 = static_cast<double>(p.b_[i + 1]);
        double d0 = p.dens_[i], d1 = p.dens_[i + 1];
        double cprev = (i == 0) ? 0.0 : p.cum_[i - 1];
        double target = u - cprev; // area into this interval
        double width  = x1 - x0;
        // area(t) = d0*t + (d1-d0)/(2*width)*t^2 = target ; solve for t∈[0,width]
        double aq = (d1 - d0) / (2.0 * width);
        double t;
        if (std::fabs(aq) < 1e-300)
            t = d0 > 0.0 ? target / d0 : 0.0;
        else {
            double disc = d0 * d0 + 4.0 * aq * target;
            if (disc < 0.0) disc = 0.0;
            t = (-d0 + std::sqrt(disc)) / (2.0 * aq);
        }
        return static_cast<result_type>(x0 + t);
    }
    friend bool operator==(const piecewise_linear_distribution &x,
                           const piecewise_linear_distribution &y)
    {
        return x.p_ == y.p_;
    }

private:
    param_type p_;
};

