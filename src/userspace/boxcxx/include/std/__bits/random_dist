        }
        RealType a_, b_;
    };

    uniform_real_distribution() : uniform_real_distribution(0) {}
    explicit uniform_real_distribution(RealType a, RealType b = 1) : p_(a, b) {}
    explicit uniform_real_distribution(const param_type &p) : p_(p) {}

    void        reset() {}
    result_type a() const { return p_.a(); }
    result_type b() const { return p_.b(); }
    param_type  param() const { return p_; }
    void        param(const param_type &p) { p_ = p; }
