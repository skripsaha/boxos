    explicit lognormal_distribution(RealType m, RealType s = 1) : p_(m, s), nd_() {}
    explicit lognormal_distribution(const param_type &p) : p_(p), nd_() {}

    void        reset() { nd_.reset(); }
    RealType    m() const { return p_.m(); }
    RealType    s() const { return p_.s(); }
    param_type  param() const { return p_; }
    void        param(const param_type &p) { p_ = p; }
