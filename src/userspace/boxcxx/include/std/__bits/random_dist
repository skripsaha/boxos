    explicit geometric_distribution(double p) : p_(p) {}
    explicit geometric_distribution(const param_type &p) : p_(p) {}

    void        reset() {}
    double      p() const { return p_.p(); }
    param_type  param() const { return p_; }
    void        param(const param_type &p) { p_ = p; }
