// ── hh_mm_ss ([time.hms]) ───────────────────────────────────────────────
namespace __detail {
constexpr long long ipow10(unsigned n) noexcept
{
    long long r = 1;
    while (n--) r *= 10;
    return r;
}
template <class Duration> constexpr unsigned frac_width() noexcept
{
    long long num = Duration::period::num;
    long long den = Duration::period::den;
    unsigned  w   = 0;
    for (; w < 18; ++w) {
        if (num % den == 0) break;
        num *= 10;
    }
    return (num % den == 0) ? w : 6u;
}
} // namespace __detail

template <class Duration> class hh_mm_ss {
public:
    static constexpr unsigned fractional_width = __detail::frac_width<Duration>();
    using precision =
        duration<common_type_t<typename Duration::rep, chrono::seconds::rep>,
                 ratio<1, __detail::ipow10(fractional_width)>>;

    constexpr hh_mm_ss() noexcept : hh_mm_ss(Duration::zero()) {}
    constexpr explicit hh_mm_ss(Duration d) noexcept
        : neg_(d < Duration::zero())
    {
        // Negate through the rep: operator-(duration) returns
        // common_type_t<Duration>, whose period is *reduced*, so for a Period
        // that is not in lowest terms (ratio<4,2>) the two arms of the
        // conditional would have unrelated types.
        Duration ad = neg_ ? Duration(-d.count()) : d;
        h_  = duration_cast<chrono::hours>(ad);
        m_  = duration_cast<chrono::minutes>(ad - h_);
        s_  = duration_cast<chrono::seconds>(ad - h_ - m_);
        ss_ = duration_cast<precision>(ad - h_ - m_ - s_);
    }

    constexpr bool             is_negative() const noexcept { return neg_; }
    constexpr chrono::hours    hours() const noexcept { return h_; }
    constexpr chrono::minutes  minutes() const noexcept { return m_; }
    constexpr chrono::seconds  seconds() const noexcept { return s_; }
    constexpr precision        subseconds() const noexcept { return ss_; }
    constexpr precision        to_duration() const noexcept
    {
        precision t = duration_cast<precision>(h_) +
                      duration_cast<precision>(m_) +
                      duration_cast<precision>(s_) + ss_;
        return neg_ ? -t : t;
    }
    constexpr explicit operator precision() const noexcept
    {
        return to_duration();
    }

private:
    bool             neg_{};
    chrono::hours    h_{};
    chrono::minutes  m_{};
    chrono::seconds  s_{};
    precision        ss_{};
};

constexpr bool is_am(const hours &h) noexcept
{
    return 0 <= h.count() && h.count() <= 11;
}
constexpr bool is_pm(const hours &h) noexcept
{
    return 12 <= h.count() && h.count() <= 23;
}
constexpr hours make12(const hours &h) noexcept
{
    if (h == hours(0)) return hours(12);
    if (h <= hours(12)) return h;
    return h - hours(12);
}
constexpr hours make24(const hours &h, bool is_pm) noexcept
{
    if (!is_pm) return h == hours(12) ? hours(0) : h;
    return h == hours(12) ? h : h + hours(12);
}

