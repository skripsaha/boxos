    : __chrono_fmt::SpecParser<__chrono_fmt::kTime, CharT> {
    void format(const chrono::hh_mm_ss<Duration> &hms,
                __format::Ctx<CharT> &ctx) const
    {
        __chrono_fmt::Parts p;
        __chrono_fmt::fill_time(p, hms);
        // The empty chrono-specs default is "%T", which this file owns and
        // spells in ASCII; only a caller-supplied spec is CharT. The two
        // cannot share a ternary any more, and separating them is what makes
        // the '-' below belong to the body in both worlds.
        if (this->chrono_.empty()) {
            string body;
            if (p.neg) body.push_back('-');
            __chrono_fmt::render(body, string_view("%T"), p);
            this->EmitStreamed(ctx, body);
            return;
        }
        basic_string<CharT> body;
        if (p.neg) body.push_back(CharT('-'));
        __chrono_fmt::render(body, this->chrono_, p);
        __chrono_fmt::emit(ctx, this->spec_, body);
    }
};

// ── the clock time_points ───────────────────────────────────────────────
namespace __chrono_fmt {

// A floating-point count must be range-checked before floor<days> turns it into
// an integral tick: inf, NaN or a magnitude past the day range would make that
// conversion undefined (-fwrapv does not tame float-to-integral).
template <class Rep, class Period>
inline void RequireCivilRange(const chrono::duration<Rep, Period> &d)
{
    if constexpr (chrono::treat_as_floating_point_v<Rep>) {
        const long double secs = (long double)d.count() *
                                 (long double)Period::num /
                                 (long double)Period::den;
        if (!(secs > -9.0e18L && secs < 9.0e18L)) // also false for NaN
            throw format_error("chrono format: the time point is out of range");
    }
}

// The civil fields of an instant expressed on the sys (Unix-epoch) timeline.
template <class Duration>
inline Parts sys_parts(const chrono::sys_time<Duration> &tp)
{
    using namespace chrono;
    RequireCivilRange(tp.time_since_epoch());
    sys_days                sd  = floor<days>(tp);
    Parts                   p   = date_parts(year_month_day{sd});
    auto                    tod = tp - sd; // common_type duration since midnight
    hh_mm_ss<decltype(tod)> hms{tod};
    fill_time(p, hms);
    return p;
}

// The same, for a clock whose epoch differs from sys by a whole number of days.
// The shift is applied to the *day* count, never to the raw duration: tai's own
// duration is nanoseconds, and 4383 days is 3.8e17 ns, so shifting the ticks
// would overflow twelve years short of nanoseconds::min() — inside the type's
// usable civil range. Flooring first bounds the shift by |rep| / 86400e9.
template <class Duration>
inline Parts shifted_parts(const Duration &since_epoch, long long shift_days)
{
    using namespace chrono;
    RequireCivilRange(since_epoch);
    days                    sd  = floor<days>(since_epoch);
    auto                    tod = since_epoch - sd;
    Parts                   p =
        date_parts(year_month_day{sys_days{sd - days{shift_days}}});
    hh_mm_ss<decltype(tod)> hms{tod};
    fill_time(p, hms);
    return p;
}

// [time.clock.system.nonmembers] streams a sys_time whose duration converts to
// days through the separate sys_days overload, i.e. as the date alone — that is
// every whole multiple of a day (weeks, a 2-day period), not just `days`. Only
// sys_time has that second overload; local_time inherits it by delegating,
// while [time.clock.utc/tai/gps/file.nonmembers] specify "{:L%F %T}"
// unconditionally, so those four never drop the time.
template <class Duration>
inline string_view clock_default()
{
    return is_convertible_v<Duration, chrono::days> ? string_view("%F")
                                                    : string_view("%F %T");
}

// The epoch shifts [time.format] specifies for the tai and gps formatters,
// written as the standard writes them. Both are exact: they are pure civil
// offsets, so neither needs the leap-second table BoxOS has not got.
inline constexpr long long kTaiShiftDays =
    chrono::__detail::days_from_civil(1970, 1, 1) -
    chrono::__detail::days_from_civil(1958, 1, 1); // 4383
inline constexpr long long kGpsShiftDays =
    chrono::__detail::days_from_civil(1980, 1, 6) -
    chrono::__detail::days_from_civil(1970, 1, 1); // 3657

// What a clock knows about its zone. sys/utc/file are UTC, tai and gps carry
// their own abbreviation, local_time has neither, and local-time-format-t has
// whatever the caller passed.
struct ZoneInfo {
    string_view zone;
    bool        has_zone   = false;
    bool        has_offset = false;
    long long   offset_sec = 0;
};
inline constexpr ZoneInfo kZoneUtc{string_view("UTC"), true, true, 0};
inline constexpr ZoneInfo kZoneTai{string_view("TAI"), true, true, 0};
inline constexpr ZoneInfo kZoneGps{string_view("GPS"), true, true, 0};
inline constexpr ZoneInfo kZoneNone{};

// The default chrono-specs ("%F %T" and friends) belong to [time.format], not
// to the caller, so they are ASCII and render narrow; only a caller-supplied
// spec can carry a character the format string chose. The two branches are
// what used to be a ternary — a ternary cannot span two character types.
template <class CharT>
inline void emit_parts(__format::Ctx<CharT> &ctx,
                       const __format::StdSpec<CharT> &spec,
                       basic_string_view<CharT> chrono_specs, string_view deflt,
                       Parts p, const ZoneInfo &z)
{
    p.zone     = z.zone;
    p.has_zone = z.has_zone;
    p.has_zoff = z.has_offset;
    p.zoff_sec = z.offset_sec;
    if (chrono_specs.empty()) {
        string body;
        render(body, deflt, p);
        emit(ctx, spec, body);
        return;
    }
    basic_string<CharT> body;
    render(body, chrono_specs, p);
    emit(ctx, spec, body);
}

// Renders an instant already reduced to the sys timeline, with a zone.
template <class CharT, class Duration>
inline void emit_clock(__format::Ctx<CharT> &ctx,
                       const __format::StdSpec<CharT> &spec,
                       basic_string_view<CharT> chrono_specs, string_view deflt,
                       const chrono::sys_time<Duration> &sys, const ZoneInfo &z)
{
    emit_parts(ctx, spec, chrono_specs, deflt, sys_parts(sys), z);
}

} // namespace __chrono_fmt

template <class Duration, class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<chrono::sys_time<Duration>, CharT>
    : __chrono_fmt::SpecParser<__chrono_fmt::kDate | __chrono_fmt::kTime |
                               __chrono_fmt::kZone, CharT> {
    void format(const chrono::sys_time<Duration> &tp, __format::Ctx<CharT> &ctx) const
    {
        __chrono_fmt::emit_clock(ctx, this->spec_, this->chrono_,
                                 __chrono_fmt::clock_default<Duration>(), tp,
                                 __chrono_fmt::kZoneUtc);
    }
};

// A utc_time renders as the sys_time holding the same count. BoxOS has no
// leap-second table (clock_cast is the identity), so the two differ by however
// many leap seconds have been inserted, and %S never shows the 60th second of
// an insertion — a documented deviation, not an approximation of the shift the
// standard specifies for tai and gps below (those are exact).
template <class Duration, class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<chrono::utc_time<Duration>, CharT>
    : __chrono_fmt::SpecParser<__chrono_fmt::kDate | __chrono_fmt::kTime |
                               __chrono_fmt::kZone, CharT> {
    void format(const chrono::utc_time<Duration> &tp, __format::Ctx<CharT> &ctx) const
    {
        __chrono_fmt::emit_clock(ctx, this->spec_, this->chrono_,
                                 string_view("%F %T"),
                                 chrono::sys_time<Duration>{tp.time_since_epoch()},
                                 __chrono_fmt::kZoneUtc);
    }
};

template <class Duration, class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<chrono::tai_time<Duration>, CharT>
    : __chrono_fmt::SpecParser<__chrono_fmt::kDate | __chrono_fmt::kTime |
                               __chrono_fmt::kZone, CharT> {
    void format(const chrono::tai_time<Duration> &tp, __format::Ctx<CharT> &ctx) const
    {
        __chrono_fmt::emit_parts(
            ctx, this->spec_, this->chrono_, string_view("%F %T"),
            __chrono_fmt::shifted_parts(tp.time_since_epoch(),
                                        __chrono_fmt::kTaiShiftDays),
            __chrono_fmt::kZoneTai);
    }
};

template <class Duration, class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<chrono::gps_time<Duration>, CharT>
    : __chrono_fmt::SpecParser<__chrono_fmt::kDate | __chrono_fmt::kTime |
                               __chrono_fmt::kZone, CharT> {
    void format(const chrono::gps_time<Duration> &tp, __format::Ctx<CharT> &ctx) const
    {
        __chrono_fmt::emit_parts(
            ctx, this->spec_, this->chrono_, string_view("%F %T"),
            __chrono_fmt::shifted_parts(tp.time_since_epoch(),
                                        -__chrono_fmt::kGpsShiftDays),
            __chrono_fmt::kZoneGps);
    }
};

// BoxOS's file_clock shares the system_clock epoch (the epoch is
// implementation-defined and clock_cast is the identity here).
template <class Duration, class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<chrono::file_time<Duration>, CharT>
    : __chrono_fmt::SpecParser<__chrono_fmt::kDate | __chrono_fmt::kTime |
                               __chrono_fmt::kZone, CharT> {
    void format(const chrono::file_time<Duration> &tp, __format::Ctx<CharT> &ctx) const
    {
        __chrono_fmt::emit_clock(ctx, this->spec_, this->chrono_,
                                 string_view("%F %T"),
                                 chrono::sys_time<Duration>{tp.time_since_epoch()},
                                 __chrono_fmt::kZoneUtc);
    }
};

// A local_time carries no zone at all, so %Z and %z are not in its set.
template <class Duration, class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<chrono::local_time<Duration>, CharT>
    : __chrono_fmt::SpecParser<__chrono_fmt::kDate | __chrono_fmt::kTime, CharT> {
    void format(const chrono::local_time<Duration> &tp, __format::Ctx<CharT> &ctx) const
    {
        __chrono_fmt::emit_clock(ctx, this->spec_, this->chrono_,
                                 __chrono_fmt::clock_default<Duration>(),
                                 chrono::sys_time<Duration>{tp.time_since_epoch()},
                                 __chrono_fmt::kZoneNone);
    }
};

// [time.format]'s local-time-format-t: a local_time plus the zone information
// the caller happens to know. %Z and %z throw when the corresponding pointer is
// null, which is the only way a zone specifier can fail at format time.
namespace chrono {

template <class Duration> struct LocalTimeFormat {
    local_time<Duration> time;
    const string        *abbrev     = nullptr;
    const seconds       *offset_sec = nullptr;
};

template <class Duration>
LocalTimeFormat<Duration> local_time_format(local_time<Duration> time,
                                            const string  *abbrev     = nullptr,
                                            const seconds *offset_sec = nullptr)
{
    return {time, abbrev, offset_sec};
}

} // namespace chrono

template <class Duration, class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<chrono::LocalTimeFormat<Duration>, CharT>
    : __chrono_fmt::SpecParser<__chrono_fmt::kDate | __chrono_fmt::kTime |
                               __chrono_fmt::kZone, CharT> {
    void format(const chrono::LocalTimeFormat<Duration> &f,
                __format::Ctx<CharT> &ctx) const
    {
        const __chrono_fmt::ZoneInfo z{
            f.abbrev ? string_view(*f.abbrev) : string_view{},
            f.abbrev != nullptr, f.offset_sec != nullptr,
            f.offset_sec ? f.offset_sec->count() : 0LL};
        __chrono_fmt::emit_clock(
            ctx, this->spec_, this->chrono_, string_view("%F %T %Z"),
            chrono::sys_time<Duration>{f.time.time_since_epoch()}, z);
    }
};

// ── formatter<duration<Rep,Period>> ─────────────────────────────────────
template <class Rep, class Period, class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<chrono::duration<Rep, Period>, CharT>
    // [time.format]/1 allows a precision only when "rep denotes a
    // floating-point type" — is_floating_point_v, not treat_as_floating_point_v
    // (a user rep may specialise the latter without being one).
    : __chrono_fmt::SpecParser<__chrono_fmt::kTime | __chrono_fmt::kDuration |
                               (is_floating_point_v<Rep>
                                    ? unsigned(__chrono_fmt::kPrec)
                                    : 0u), CharT> {
    void format(const chrono::duration<Rep, Period> &d, __format::Ctx<CharT> &ctx) const
    {
        using D         = chrono::duration<Rep, Period>;
        const int prec  = __format::EffectivePrecision(ctx, this->spec_);
        if (this->chrono_.empty()) {
            // [time.format]/7: as if streamed — count() then the unit suffix.
            string body;
            __chrono_fmt::PutRep(body, d.count(), prec, /*shortest=*/false,
                                 /*magnitude=*/false);
            body += __chrono_fmt::unit_suffix<typename D::period>();
            this->EmitStreamed(ctx, body);
            return;
        }
        {
            // [time.format]/4: the positive value, prefixed with '-'.
            string qtext;
            __chrono_fmt::PutRep(qtext, d.count(), prec, /*shortest=*/true,
                                 /*magnitude=*/true);
            string unit = __chrono_fmt::unit_suffix<typename D::period>();
            __chrono_fmt::Parts p;
            // Only decompose when the chrono-specs actually reference a time
            // field: "{:%Q}" of a non-representable-as-time-of-day value (an
            // infinity, or a count whose magnitude overflows the hour range)
            // must still print the value.
            if constexpr (__chrono_fmt::DecomposableDur<D>) {
                if (this->used_ & __chrono_fmt::kTime)
                    __chrono_fmt::fill_time_dur(p, d);
                else
                    p.neg = d < D::zero();
            } else {
                if (this->used_ & __chrono_fmt::kTime)
                    throw format_error("chrono format: this period has no "
                                       "time-of-day decomposition");
                p.neg = d < D::zero();
            }
            p.qtext = string_view(qtext.data(), qtext.size());
            p.unit  = string_view(unit.data(), unit.size());
            basic_string<CharT> body;
            if (p.neg) body.push_back(CharT('-'));
            __chrono_fmt::render(body, this->chrono_, p);
            __chrono_fmt::emit(ctx, this->spec_, body);
        }
    }
};

// [time.format]/8 — chrono is one of the subclauses that "specifies otherwise"
// for enable_nonlocking_formatter_optimization: of all the chrono formatters,
// only duration gets an entry, and its value is inherited from the rep rather
// than being flatly true. Every other chrono type above keeps the primary's
// false. (zoned_time's entry in /9 has no counterpart here — boxcxx has no time
// zones.) libc++ answers false for chrono::seconds, which this contradicts on
// purpose: its rep is long long, whose entry is true.
template <class Rep, class Period>
inline constexpr bool
    enable_nonlocking_formatter_optimization<chrono::duration<Rep, Period>> =
        enable_nonlocking_formatter_optimization<Rep>;

} // namespace std

#endif // BOXCXX_BITS_CHRONO_FORMAT
