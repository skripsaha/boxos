// for the calendar types carries the "… is not a valid …" diagnostics.
template <class CharT>
    requires __format::FmtCharT<CharT>
struct formatter<chrono::day, CharT>
    : __chrono_fmt::SpecParser<__chrono_fmt::kDay, CharT> {
    void format(const chrono::day &d, __format::Ctx<CharT> &ctx) const
    {
        if (this->chrono_.empty()) {
            string body;
            __chrono_fmt::put_day_text(body, d);
            this->EmitStreamed(ctx, body);
            return;
        }
            __chrono_fmt::Parts p;
            p.day = unsigned(d);
        this->EmitWalked(ctx, p);
    }
};

