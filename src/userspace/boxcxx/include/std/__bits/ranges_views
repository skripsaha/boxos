// ── take_while_view ([range.take.while]) ────────────────────────────────
// The cheapest view in the family: begin() is the base's begin, and the whole
// of the work lives in a sentinel that asks the predicate. Nothing is cached
// and nothing is precomputed, so both const and non-const access are free —
// the Const parameter here is only about which V and which Pred are seen.
template <view V, typename Pred>
    requires input_range<V> && is_object_v<Pred> &&
             indirect_unary_predicate<const Pred, iterator_t<V>>
class take_while_view : public view_interface<take_while_view<V, Pred>> {
    V __base = V();
    __views_detail::MovableBox<Pred> __pred;

    template <bool Const>
    struct Sentinel {
        using Base = __views_detail::MaybeConst<Const, V>;

        sentinel_t<Base> __end  = sentinel_t<Base>();
        const Pred      *__pred = nullptr;

        Sentinel() = default;
        constexpr explicit Sentinel(sentinel_t<Base> end, const Pred *p)
            : __end(std::move(end)), __pred(p)
        {
        }
        constexpr Sentinel(Sentinel<!Const> s)   // see transform_view's note
            requires Const && convertible_to<sentinel_t<V>, sentinel_t<Base>>
            : __end(std::move(s.__end)), __pred(s.__pred)
        {
        }
        constexpr sentinel_t<Base> base() const { return __end; }

        // The two ways to stop: the base ran out, or the predicate said so.
        // Testing the base end FIRST is not a style choice -- dereferencing to
        // ask the predicate at the end position would read past the range.
        // Templated on the ITERATOR, not on the standard's OtherConst flag.
        // The two admit the same set — any iterator this sentinel can bound —
        // but OtherConst appears only inside iterator_t<maybe-const<...>>,
        // which is a non-deduced context, so that spelling can never actually
        // be selected. Deducing I also keeps the cross-const pairing working:
        // a caller holding begin() from the non-const overload and end() from
        // the const one must still be able to compare them.
        template <typename I>
            requires sentinel_for<sentinel_t<Base>, I> &&
                     indirect_unary_predicate<const Pred, I>
        friend constexpr bool operator==(const I &i, const Sentinel &s)
        {
            return i == s.__end || !static_cast<bool>(std::invoke(*s.__pred, *i));
        }

        friend Sentinel<true>;
    };

public:
    take_while_view()
        requires default_initializable<V> && default_initializable<Pred>
    = default;
    constexpr take_while_view(V base, Pred pred)
        : __base(std::move(base)), __pred(std::move(pred))
    {
    }

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }
    constexpr const Pred &pred() const { return *__pred; }

    constexpr auto begin()
        requires(!__views_detail::SimpleView<V>)
    {
        return ranges::begin(__base);
    }
    constexpr auto begin() const
        requires range<const V> &&
                 indirect_unary_predicate<const Pred, iterator_t<const V>>
    {
        return ranges::begin(__base);
    }
    constexpr auto end()
        requires(!__views_detail::SimpleView<V>)
    {
        return Sentinel<false>(ranges::end(__base),
                               __builtin_addressof(*__pred));
    }
    constexpr auto end() const
        requires range<const V> &&
                 indirect_unary_predicate<const Pred, iterator_t<const V>>
    {
        return Sentinel<true>(ranges::end(__base),
                              __builtin_addressof(*__pred));
    }
};

template <class R, class Pred>
take_while_view(R &&, Pred) -> take_while_view<views::all_t<R>, Pred>;

namespace views {

struct TakeWhile {
    template <viewable_range R, typename Pred>
    constexpr auto operator()(R &&r, Pred &&p) const
    {
        return take_while_view<all_t<R>, remove_cvref_t<Pred>>(
            all(std::forward<R>(r)), std::forward<Pred>(p));
    }
    template <typename Pred>
        requires(!viewable_range<remove_cvref_t<Pred>>)
    constexpr auto operator()(Pred &&p) const
    {
        return RangeAdaptorPartial<TakeWhile, remove_cvref_t<Pred>>(
            TakeWhile{}, std::forward<Pred>(p));
    }
};

