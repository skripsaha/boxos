// ── transform_view ([range.transform]) ──────────────────────────────────
// Const-iterable, which is what separates this from filter_view: filter
// caches its begin() and so genuinely cannot offer a const one, while
// transform holds nothing that a const walk would disturb. The standard says
// so too — [range.transform.view] gives begin()/end() a const overload gated
// on `range<const V> && regular_invocable<const F&, range_reference_t<const
// V>>` — and without it `range<const transform_view<…>>` is false, so a const
// transform_view cannot be iterated at all and every algorithm taking one by
// const reference fails with "discards qualifiers".
//
// That gate is why Iterator and Sentinel take a Const parameter rather than
// simply being made const-callable: on the const side both the underlying
// iterator AND the invocation of F change type, so there are genuinely two
// iterators here, and the standard names them iterator<false>/iterator<true>.
// Same shape elements_view already uses.

template <input_range V, typename F>
    requires view<V> && is_object_v<F> &&
             regular_invocable<F &, range_reference_t<V>> &&
             requires {
                 typename remove_cvref_t<invoke_result_t<F &,
                                                         range_reference_t<V>>>;
             }
class transform_view : public view_interface<transform_view<V, F>> {
    V __base = V();
    __views_detail::MovableBox<F> __fn;

    template <bool Const> struct Sentinel;

    template <bool Const>
    struct Iterator
        : __views_detail::MaybeCategory<
              __views_detail::MaybeConst<Const, V>, contiguous_iterator_tag,
              random_access_iterator_tag, void,
              !is_lvalue_reference_v<invoke_result_t<
                  __views_detail::MaybeConst<Const, F> &,
                  range_reference_t<__views_detail::MaybeConst<Const, V>>>>> {
        using Base   = __views_detail::MaybeConst<Const, V>;
        using Fn     = __views_detail::MaybeConst<Const, F>;
        using Parent = __views_detail::MaybeConst<Const, transform_view>;

        using iterator_concept =
            conditional_t<random_access_range<Base>, random_access_iterator_tag,
                          conditional_t<bidirectional_range<Base>,
                                        bidirectional_iterator_tag,
                                        conditional_t<forward_range<Base>,
                                                      forward_iterator_tag,
                                                      input_iterator_tag>>>;
        using value_type =
            remove_cvref_t<invoke_result_t<Fn &, range_reference_t<Base>>>;
        using difference_type = range_difference_t<Base>;
        using reference       = invoke_result_t<Fn &, range_reference_t<Base>>;
        using pointer         = void;
        // iterator_category comes from the MaybeCategory base — present only
        // if Base is a forward_range ([range.transform.iterator]).

        Parent          *__parent = nullptr;
        iterator_t<Base> __cur    = iterator_t<Base>();

        Iterator()
            requires default_initializable<iterator_t<Base>>
        = default;
        constexpr Iterator(Parent &p, iterator_t<Base> c)
            : __parent(__builtin_addressof(p)), __cur(std::move(c))
        {
        }
        // [range.transform.iterator]: the non-const iterator converts to the
        // const one, so `for (auto it = v.begin(); it != cv.end(); ...)` and
        // every mixed comparison below have something to convert through.
        // Spelled Iterator<!Const>, not Iterator<false>: at Const == false the
        // latter names THIS class and declares a by-value copy constructor,
        // which is ill-formed on sight — the requires-clause never gets a
        // chance to disable it. At Const == true the two spellings agree,
        // which is the instantiation that matters.
        constexpr Iterator(Iterator<!Const> i)
            requires Const && convertible_to<iterator_t<V>, iterator_t<Base>>
            : __parent(i.__parent), __cur(std::move(i.__cur))
        {
        }

        constexpr const iterator_t<Base> &base() const & noexcept
        {
            return __cur;
        }
        constexpr iterator_t<Base> base() && { return std::move(__cur); }

        constexpr reference operator*() const
        {
            return std::invoke(*__parent->__fn, *__cur);
        }

        constexpr Iterator &operator++()
        {
            ++__cur;
            return *this;
        }
        constexpr void operator++(int) { ++__cur; }
        constexpr Iterator operator++(int)
            requires forward_range<Base>
        {
            auto t = *this;
            ++__cur;
            return t;
        }
        constexpr Iterator &operator--()
            requires bidirectional_range<Base>
        {
            --__cur;
            return *this;
        }
        constexpr Iterator operator--(int)
            requires bidirectional_range<Base>
        {
            auto t = *this;
            --__cur;
            return t;
        }

        constexpr Iterator &operator+=(difference_type n)
            requires random_access_range<Base>
        {
            __cur += n;
            return *this;
        }
        constexpr Iterator &operator-=(difference_type n)
            requires random_access_range<Base>
        {
            __cur -= n;
            return *this;
        }
        constexpr reference operator[](difference_type n) const
            requires random_access_range<Base>
        {
            return std::invoke(*__parent->__fn, __cur[n]);
        }

        friend constexpr Iterator operator+(Iterator i, difference_type n)
            requires random_access_range<Base>
        {
            i += n;
            return i;
        }
        friend constexpr Iterator operator+(difference_type n, Iterator i)
            requires random_access_range<Base>
        {
            i += n;
            return i;
        }
        friend constexpr Iterator operator-(Iterator i, difference_type n)
            requires random_access_range<Base>
        {
            i -= n;
            return i;
        }
        friend constexpr difference_type operator-(const Iterator &a,
                                                   const Iterator &b)
            requires sized_sentinel_for<iterator_t<Base>, iterator_t<Base>>
        {
            return a.__cur - b.__cur;
        }

        friend constexpr bool operator==(const Iterator &a, const Iterator &b)
            requires equality_comparable<iterator_t<Base>>
        {
            return a.__cur == b.__cur;
        }
        friend constexpr auto operator<=>(const Iterator &a, const Iterator &b)
            requires random_access_range<Base> &&
                     three_way_comparable<iterator_t<Base>>
        {
            return a.__cur <=> b.__cur;
        }

        friend Iterator<true>;
    };

    template <bool Const>
    struct Sentinel {
        using Base   = __views_detail::MaybeConst<Const, V>;
        using Parent = __views_detail::MaybeConst<Const, transform_view>;

        sentinel_t<Base> __end = sentinel_t<Base>();

        Sentinel() = default;
        constexpr explicit Sentinel(Parent &p) : __end(ranges::end(p.__base))
        {
        }
        constexpr Sentinel(Sentinel<!Const> s)   // see Iterator's note above
            requires Const && convertible_to<sentinel_t<V>, sentinel_t<Base>>
            : __end(std::move(s.__end))
        {
        }
        constexpr sentinel_t<Base> base() const { return __end; }

        // OtherConst, not Const: a const sentinel must still answer a
        // non-const iterator, which is the pairing end() const produces for a
        // caller that began with begin().
        template <bool OtherConst>
            requires sentinel_for<
                sentinel_t<Base>,
                iterator_t<__views_detail::MaybeConst<OtherConst, V>>>
        friend constexpr bool operator==(const Iterator<OtherConst> &i,
                                         const Sentinel &s)
        {
            return i.__cur == s.__end;
        }
        template <bool OtherConst>
            requires sized_sentinel_for<
                sentinel_t<Base>,
                iterator_t<__views_detail::MaybeConst<OtherConst, V>>>
        friend constexpr range_difference_t<
            __views_detail::MaybeConst<OtherConst, V>>
        operator-(const Iterator<OtherConst> &i, const Sentinel &s)
        {
            return i.__cur - s.__end;
        }
        template <bool OtherConst>
            requires sized_sentinel_for<
                sentinel_t<Base>,
                iterator_t<__views_detail::MaybeConst<OtherConst, V>>>
        friend constexpr range_difference_t<
            __views_detail::MaybeConst<OtherConst, V>>
        operator-(const Sentinel &s, const Iterator<OtherConst> &i)
        {
            return s.__end - i.__cur;
        }

        friend Sentinel<true>;
    };

public:
    transform_view()
        requires default_initializable<V> && default_initializable<F>
    = default;
    constexpr transform_view(V base, F fn)
        : __base(std::move(base)), __fn(std::move(fn))
    {
    }

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }

    constexpr Iterator<false> begin()
    {
        return Iterator<false>{*this, ranges::begin(__base)};
    }
    // Spelled out rather than hoisted into a constexpr bool: `&&` in an
    // ordinary constant expression still SUBSTITUTES its right operand, so
    // range_reference_t<const V> would be formed even for a base whose const
    // overlay is not a range — a hard error, not a false. In a requires-clause
    // the conjunction is one of constraints, and the right atom is never
    // substituted when the left is unsatisfied.
    constexpr Iterator<true> begin() const
        requires range<const V> &&
                 regular_invocable<const F &, range_reference_t<const V>>
    {
        return Iterator<true>{*this, ranges::begin(__base)};
    }
    constexpr auto end()
    {
        if constexpr (common_range<V>)
            return Iterator<false>{*this, ranges::end(__base)};
        else
            return Sentinel<false>{*this};
    }
    constexpr auto end() const
        requires range<const V> &&
                 regular_invocable<const F &, range_reference_t<const V>>
    {
        if constexpr (common_range<const V>)
            return Iterator<true>{*this, ranges::end(__base)};
        else
            return Sentinel<true>{*this};
    }

    constexpr auto size()
        requires sized_range<V>
    {
        return ranges::size(__base);
    }
    constexpr auto size() const
        requires sized_range<const V>
    {
        return ranges::size(__base);
    }
    // P2846R6: element-for-element with the adapted range, so the hint passes
    // straight through.
    constexpr auto reserve_hint()
        requires approximately_sized_range<V>
    {
        return ranges::reserve_hint(__base);
    }
    constexpr auto reserve_hint() const
        requires approximately_sized_range<const V>
    {
        return ranges::reserve_hint(__base);
    }
};

namespace views {

struct Transform {
    template <viewable_range R, typename F>
    constexpr auto operator()(R &&r, F &&f) const
    {
        return transform_view<all_t<R>, remove_cvref_t<F>>(
            all(std::forward<R>(r)), std::forward<F>(f));
    }
    template <typename F>
        requires(!viewable_range<remove_cvref_t<F>>)
    constexpr auto operator()(F &&f) const
    {
        return RangeAdaptorPartial<Transform, remove_cvref_t<F>>(
            Transform{}, std::forward<F>(f));
    }
};

inline constexpr Transform transform{};

} // namespace views

// ── common_view ([range.common]) ────────────────────────────────────────
// Turns a non-common view (iterator ≠ sentinel) into a common_range by
// wrapping both ends in common_iterator — unless the base is already
// random-access + sized, in which case begin()+size() gives a genuine common
// iterator pair with no wrapping cost.

template <view V>
    requires(!common_range<V>) && copyable<iterator_t<V>>
class common_view : public view_interface<common_view<V>> {
    V __base = V();

public:
    common_view()
        requires default_initializable<V>
    = default;
    constexpr explicit common_view(V base) : __base(std::move(base)) {}

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }

    constexpr auto begin()
    {
        if constexpr (random_access_range<V> && sized_range<V>)
            return ranges::begin(__base);
        else
            return common_iterator<iterator_t<V>, sentinel_t<V>>(
                ranges::begin(__base));
    }
    constexpr auto begin() const
        requires range<const V>
    {
        if constexpr (random_access_range<const V> && sized_range<const V>)
            return ranges::begin(__base);
        else
            return common_iterator<iterator_t<const V>, sentinel_t<const V>>(
                ranges::begin(__base));
    }
    constexpr auto end()
    {
        if constexpr (random_access_range<V> && sized_range<V>)
            return ranges::begin(__base) + ranges::size(__base);
        else
            return common_iterator<iterator_t<V>, sentinel_t<V>>(
                ranges::end(__base));
    }
    constexpr auto end() const
        requires range<const V>
    {
        if constexpr (random_access_range<const V> && sized_range<const V>)
            return ranges::begin(__base) + ranges::size(__base);
        else
            return common_iterator<iterator_t<const V>, sentinel_t<const V>>(
                ranges::end(__base));
    }

    constexpr auto size()
        requires sized_range<V>
    {
        return ranges::size(__base);
    }
    constexpr auto size() const
        requires sized_range<const V>
    {
        return ranges::size(__base);
    }
    // P2846R6: element-for-element with the adapted range, so the hint passes
    // straight through.
    constexpr auto reserve_hint()
        requires approximately_sized_range<V>
    {
        return ranges::reserve_hint(__base);
    }
    constexpr auto reserve_hint() const
        requires approximately_sized_range<const V>
    {
        return ranges::reserve_hint(__base);
    }
};

template <typename R>
common_view(R &&) -> common_view<views::all_t<R>>;

// common_iterator only holds a COPY of the base's iterator/sentinel, never a
// back-pointer to the view, so borrowed-ness propagates from the base.
template <typename T>
inline constexpr bool enable_borrowed_range<common_view<T>> =
    enable_borrowed_range<T>;

namespace views {

struct Common : RangeAdaptorClosureBase {
    template <viewable_range R>
        requires common_range<R> || requires { common_view(declval<R>()); }
    constexpr auto operator()(R &&r) const
    {
        if constexpr (common_range<R>)
            return views::all(std::forward<R>(r));
        else
            return common_view(std::forward<R>(r));
    }
};

inline constexpr Common common{};

} // namespace views

// subrange's get lives in std::ranges so structured-binding ADL — which
// searches only the class's own namespace — finds it.
template <size_t Index, typename I, typename S, subrange_kind K>
    requires(Index < 2)
constexpr auto get(const subrange<I, S, K> &r)
{
    if constexpr (Index == 0)
        return r.begin();
    else
        return r.end();
}

} // namespace ranges

namespace views = ranges::views;

// [ranges.syn] hoists ranges::get into namespace std. Structured bindings and
// an ADL-qualified get(s) found it either way; a plain std::get<0>(s) -- what
// generic code written against tuple-like types actually spells -- did not.
using ranges::get;

// ── subrange tuple protocol (structured bindings) ───────────────────────

template <typename I, typename S, ranges::subrange_kind K>
struct tuple_size<ranges::subrange<I, S, K>> : integral_constant<size_t, 2> {};
template <typename I, typename S, ranges::subrange_kind K>
struct tuple_element<0, ranges::subrange<I, S, K>> {
    using type = I;
};
template <typename I, typename S, ranges::subrange_kind K>
struct tuple_element<1, ranges::subrange<I, S, K>> {
    using type = S;
};

// subrange is tuple-like ([tuple.like]/1) but excluded from pair's/tuple's
// generic tuple-like constructor and assignment (P2165R4 [pairs.pair]/15,
// [tuple.cnstr]/29): it has its own dedicated conversion to any
// 2-element-constructible type, and letting both paths compete would make
// that conversion ambiguous. IsSubrangeType is what those constructors
// check to exclude it.
namespace __bits {
template <typename I, typename S, ranges::subrange_kind K>
inline constexpr bool IsTupleLikeType<ranges::subrange<I, S, K>> = true;
template <typename I, typename S, ranges::subrange_kind K>
inline constexpr bool IsSubrangeType<ranges::subrange<I, S, K>> = true;
} // namespace __bits

