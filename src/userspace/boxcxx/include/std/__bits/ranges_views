// ── filter_view ([range.filter]) ────────────────────────────────────────

template <input_range V, typename Pred>
    requires view<V> && is_object_v<Pred> &&
             predicate<Pred &, range_reference_t<V>>
class filter_view : public view_interface<filter_view<V, Pred>> {
    V __base = V();
    __views_detail::MovableBox<Pred> __pred;

    constexpr iterator_t<V> __FindNext(iterator_t<V> it)
    {
        auto e = ranges::end(__base);
        while (it != e && !static_cast<bool>(std::invoke(*__pred, *it))) ++it;
        return it;
    }

    struct Iterator;
    struct Sentinel;

public:
    filter_view()
        requires default_initializable<V> && default_initializable<Pred>
    = default;
    constexpr filter_view(V base, Pred pred)
        : __base(std::move(base)), __pred(std::move(pred))
    {
    }

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }
    constexpr const Pred &pred() const { return *__pred; }

    constexpr Iterator begin()
    {
        return Iterator{*this, __FindNext(ranges::begin(__base))};
    }
    constexpr auto end()
    {
        if constexpr (common_range<V>)
            return Iterator{*this, ranges::end(__base)};
        else
            return Sentinel{*this};
    }
};

template <input_range V, typename Pred>
    requires view<V> && is_object_v<Pred> &&
             predicate<Pred &, range_reference_t<V>>
struct filter_view<V, Pred>::Iterator
    : __views_detail::MaybeCategory<V, bidirectional_iterator_tag,
                                    bidirectional_iterator_tag,
                                    forward_iterator_tag> {
    using iterator_concept =
        conditional_t<bidirectional_range<V>, bidirectional_iterator_tag,
                      conditional_t<forward_range<V>, forward_iterator_tag,
                                    input_iterator_tag>>;
    // iterator_category comes from the MaybeCategory base — present only if
    // V is a forward_range ([range.filter.iterator]).
    using value_type      = range_value_t<V>;
    using difference_type = range_difference_t<V>;
    using pointer         = void;
    using reference       = range_reference_t<V>;

    filter_view *__parent = nullptr;
    iterator_t<V> __cur   = iterator_t<V>();

    Iterator()
        requires default_initializable<iterator_t<V>>
    = default;
    constexpr Iterator(filter_view &p, iterator_t<V> c)
        : __parent(__builtin_addressof(p)), __cur(std::move(c))
    {
    }

    constexpr const iterator_t<V> &base() const & noexcept { return __cur; }
    constexpr iterator_t<V> base() && { return std::move(__cur); }

    constexpr range_reference_t<V> operator*() const { return *__cur; }

    constexpr Iterator &operator++()
    {
        ++__cur;
        __cur = __parent->__FindNext(__cur);
        return *this;
    }
    constexpr void operator++(int) { ++*this; }
    constexpr Iterator operator++(int)
        requires forward_range<V>
    {
        auto t = *this;
        ++*this;
        return t;
    }
    constexpr Iterator &operator--()
        requires bidirectional_range<V>
    {
        do {
            --__cur;
        } while (!static_cast<bool>(std::invoke(*__parent->__pred, *__cur)));
        return *this;
    }
    constexpr Iterator operator--(int)
        requires bidirectional_range<V>
    {
        auto t = *this;
        --*this;
        return t;
    }

    friend constexpr bool operator==(const Iterator &a, const Iterator &b)
        requires equality_comparable<iterator_t<V>>
    {
        return a.__cur == b.__cur;
    }
};

template <input_range V, typename Pred>
    requires view<V> && is_object_v<Pred> &&
             predicate<Pred &, range_reference_t<V>>
struct filter_view<V, Pred>::Sentinel {
    sentinel_t<V> __end = sentinel_t<V>();

    Sentinel() = default;
    constexpr explicit Sentinel(filter_view &p) : __end(ranges::end(p.__base))
    {
    }
    constexpr sentinel_t<V> base() const { return __end; }

    friend constexpr bool operator==(const Iterator &i, const Sentinel &s)
    {
        return i.__cur == s.__end;
    }
};

