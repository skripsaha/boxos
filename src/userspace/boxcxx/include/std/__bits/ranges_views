// ── drop_while_view ([range.drop.while]) ────────────────────────────────
// The mirror of take_while, and much the more expensive one: begin() has to
// FIND the first element the predicate rejects, which is O(n). [range.drop.
// while]/2 makes caching that result mandatory rather than optional -- without
// it begin() is O(n) on every call and the view stops meeting the amortized
// constant-time begin() that the range concept requires. The cache is
// deliberately NOT const-accessible and there is no begin() const: the
// standard gives drop_while_view none either, for exactly this reason.
template <view V, typename Pred>
    requires input_range<V> && is_object_v<Pred> &&
             indirect_unary_predicate<const Pred, iterator_t<V>>
class drop_while_view : public view_interface<drop_while_view<V, Pred>> {
    V __base = V();
    __views_detail::MovableBox<Pred> __pred;
    iterator_t<V> __cached  = iterator_t<V>();
    bool          __hasCache = false;

public:
    drop_while_view()
        requires default_initializable<V> && default_initializable<Pred>
    = default;
    constexpr drop_while_view(V base, Pred pred)
        : __base(std::move(base)), __pred(std::move(pred))
    {
    }

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }
    constexpr const Pred &pred() const { return *__pred; }

    constexpr auto begin()
    {
        if constexpr (forward_range<V>) {
            if (!__hasCache) {
                __cached   = __Find();
                __hasCache = true;
            }
            return __cached;
        } else {
            // An input range cannot be walked twice, so there is nothing to
            // cache: begin() is single-pass by construction and the standard's
            // caching requirement has no bite.
            return __Find();
        }
    }
    constexpr auto end() { return ranges::end(__base); }

private:
    constexpr iterator_t<V> __Find()
    {
        auto it = ranges::begin(__base);
        auto e  = ranges::end(__base);
        while (it != e && static_cast<bool>(std::invoke(*__pred, *it))) ++it;
        return it;
    }
};

template <class R, class Pred>
drop_while_view(R &&, Pred) -> drop_while_view<views::all_t<R>, Pred>;

template <typename T, typename Pred>
inline constexpr bool enable_borrowed_range<drop_while_view<T, Pred>> =
    enable_borrowed_range<T>;

