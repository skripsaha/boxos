                            static_cast<range_difference_t<V>>(n));
    }
    template <typename D>
        requires(!viewable_range<remove_cvref_t<D>>)
    constexpr auto operator()(D &&n) const
    {
        return RangeAdaptorPartial<Take, remove_cvref_t<D>>(
            Take{}, static_cast<remove_cvref_t<D>>(std::forward<D>(n)));
    }
};

