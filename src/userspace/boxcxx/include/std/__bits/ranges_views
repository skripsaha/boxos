// boxcxx — <__bits/ranges_views>
// The range-views layer (Ф7B-3): view_interface, subrange, ref_view,
// owning_view, the range-adaptor pipe machinery, and the all/take/drop/
// filter/transform adaptors. Pulled in by <ranges> AFTER the core
// (CPOs + range/view concepts) so everything below is already in scope.
//
// boxcxx simplifications (documented, safe for the closed type set):
//   • view_interface<D> derives from view_base, so every view_interface
//     subclass satisfies the existing enable_view = derived_from<view_base>.
//   • filter_view is non-const-iterable (no const begin) and recomputes
//     begin() each call (no non-propagating cache); correct for the
//     materialize-then-iterate (range-for) pattern, and the standard's own
//     filter_view has no begin() const either. transform_view USED to share
//     that shape and no longer does — Ф31e-b-2 gave it the conditional const
//     access [range.transform.view] specifies, because unlike filter it
//     caches nothing a const walk could disturb.
#ifndef BOXCXX_BITS_RANGES_VIEWS
#define BOXCXX_BITS_RANGES_VIEWS

#include <compare>
#include <concepts>
#include <cstddef>
#include <functional>
#include <iterator>
#include <new>
#include <tuple>
#include <type_traits>
#include <utility>

namespace std {
namespace ranges {

namespace __views_detail {

// ── MovableBox — the semiregular-box for storing a view's callable ──────
// Wraps a move/copy-constructible (but maybe non-assignable) object so the
// owning view stays movable/copyable. Assignment that the wrapped type
// cannot do directly is emulated by destroy + reconstruct, via
// destroy_at/construct_at (__bits/allocator_core, reached through the
// <iterator> include above) rather than raw placement-new — keeps MovableBox
// usable in constant evaluation.
template <typename T>
    requires move_constructible<T> && is_object_v<T>
class MovableBox {
public:
    constexpr MovableBox()
        requires default_initializable<T>
        : __val()
    {
    }
    constexpr explicit MovableBox(const T &t)
        requires copy_constructible<T>
        : __val(t)
    {
    }
    constexpr explicit MovableBox(T &&t) : __val(std::move(t)) {}
    template <typename... Args>
        requires constructible_from<T, Args...>
    constexpr explicit MovableBox(in_place_t, Args &&...args)
        : __val(std::forward<Args>(args)...)
    {
    }

    constexpr MovableBox(const MovableBox &)
        requires copy_constructible<T>
    = default;
    constexpr MovableBox(MovableBox &&) = default;

    constexpr MovableBox &operator=(const MovableBox &o)
        requires copy_constructible<T>
    {
        if (this != __builtin_addressof(o)) {
            if constexpr (is_copy_assignable_v<T>) {
                __val = o.__val;
            } else {
                destroy_at(__builtin_addressof(__val));
                construct_at(__builtin_addressof(__val), o.__val);
            }
        }
        return *this;
    }
    constexpr MovableBox &operator=(MovableBox &&o)
    {
        if (this != __builtin_addressof(o)) {
            if constexpr (is_move_assignable_v<T>) {
                __val = std::move(o.__val);
            } else {
                destroy_at(__builtin_addressof(__val));
                construct_at(__builtin_addressof(__val), std::move(o.__val));
            }
        }
        return *this;
    }

    constexpr T &operator*() noexcept { return __val; }
    constexpr const T &operator*() const noexcept { return __val; }
    constexpr T *operator->() noexcept { return __builtin_addressof(__val); }
    constexpr const T *operator->() const noexcept
    {
        return __builtin_addressof(__val);
    }

private:
    T __val;
};

// MaybeConst<Const,T>: T under a const-qualified view, T otherwise — every
// const-dual iterator (elements/enumerate/zip/adjacent) picks its Base with
// this.
template <bool Const, typename T>
using MaybeConst = conditional_t<Const, const T, T>;

// [ranges.syn]'s exposition-only simple-view: a view whose const and non-const
// iterations are indistinguishable. Views that gate a non-const begin()/end()
// on `!simple-view<V>` do so to keep the pair from being an ambiguous
// overload set when both would do exactly the same thing.
template <typename R>
concept SimpleView = view<R> && range<const R> &&
                     same_as<iterator_t<R>, iterator_t<const R>> &&
                     same_as<sentinel_t<R>, sentinel_t<const R>>;

// FUN trick: binds only to lvalues that convert to R& (ref_view ctor).
template <typename R>
void RefFun(R &);
template <typename R>
void RefFun(R &&) = delete;

} // namespace __views_detail

// ── view_interface ([view.interface]) ───────────────────────────────────

template <typename D>
    requires is_class_v<D> && same_as<D, remove_cv_t<D>>
class view_interface : public view_base {
private:
    constexpr D &__derived() noexcept { return static_cast<D &>(*this); }
    constexpr const D &__derived() const noexcept
    {
        return static_cast<const D &>(*this);
    }

public:
    template <typename DD = D>
    [[nodiscard]] constexpr bool empty()
        requires forward_range<DD>
    {
        return ranges::begin(__derived()) == ranges::end(__derived());
    }
    template <typename DD = D>
    [[nodiscard]] constexpr bool empty() const
        requires forward_range<const DD>
    {
        return ranges::begin(__derived()) == ranges::end(__derived());
    }

    template <typename DD = D>
    constexpr explicit operator bool()
        requires requires(DD &d) { ranges::empty(d); }
    {
        return !ranges::empty(__derived());
    }
    template <typename DD = D>
    constexpr explicit operator bool() const
        requires requires(const DD &d) { ranges::empty(d); }
    {
        return !ranges::empty(__derived());
    }

    // [view.interface.members] constrains data() on contiguous_iterator<
    // iterator_t<D>>, NOT on contiguous_range<D>: contiguous_range is itself
    // defined through ranges::data, which considers this very member, so a
    // contiguous_range constraint here is self-referential and the compiler
    // rejects it outright ("atomic constraint depends on itself") rather than
    // treating the member as absent. The return is to_address(begin), also as
    // specified -- data() yields a POINTER; returning the iterator would make
    // ranges::data's own same_as<add_pointer_t<range_reference_t<R>>> check
    // fail for every view whose contiguous iterator is a class type.
    template <typename DD = D>
    constexpr auto data()
        requires contiguous_iterator<iterator_t<DD>>
    {
        return to_address(ranges::begin(__derived()));
    }
    template <typename DD = D>
    constexpr auto data() const
        requires range<const DD> && contiguous_iterator<iterator_t<const DD>>
    {
        return to_address(ranges::begin(__derived()));
    }

    // [view.interface.members]: the const-access pair P2278R4 adds. They are
    // the last two names that paper asks for -- ranges::cbegin/cend, defined
    // in <iterator>, are the other two -- and they are what lets a view be
    // read through a constant iterator without the caller having to know
    // whether the view's own const overlay happens to be a range.
    template <typename DD = D>
    constexpr auto cbegin()
        requires input_range<DD>
    {
        return ranges::cbegin(__derived());
    }
    template <typename DD = D>
    constexpr auto cbegin() const
        requires input_range<const DD>
    {
        return ranges::cbegin(__derived());
    }
    template <typename DD = D>
    constexpr auto cend()
        requires input_range<DD>
    {
        return ranges::cend(__derived());
    }
    template <typename DD = D>
    constexpr auto cend() const
        requires input_range<const DD>
    {
        return ranges::cend(__derived());
    }

    template <typename DD = D>
    constexpr auto size()
        requires(forward_range<DD> &&
                 sized_sentinel_for<sentinel_t<DD>, iterator_t<DD>>)
    {
        return static_cast<make_unsigned_t<range_difference_t<DD>>>(
            ranges::end(__derived()) - ranges::begin(__derived()));
    }
    template <typename DD = D>
    constexpr auto size() const
        requires(forward_range<const DD> &&
                 sized_sentinel_for<sentinel_t<const DD>, iterator_t<const DD>>)
    {
        return static_cast<make_unsigned_t<range_difference_t<const DD>>>(
            ranges::end(__derived()) - ranges::begin(__derived()));
    }

    template <typename DD = D>
    constexpr decltype(auto) front()
        requires forward_range<DD>
    {
        return *ranges::begin(__derived());
    }
    template <typename DD = D>
    constexpr decltype(auto) front() const
        requires forward_range<const DD>
    {
        return *ranges::begin(__derived());
    }

    template <typename DD = D>
    constexpr decltype(auto) back()
        requires(bidirectional_range<DD> && common_range<DD>)
    {
        auto it = ranges::end(__derived());
        --it;
        return *it;
    }
    template <typename DD = D>
    constexpr decltype(auto) back() const
        requires(bidirectional_range<const DD> && common_range<const DD>)
    {
        auto it = ranges::end(__derived());
        --it;
        return *it;
    }

    template <typename DD = D>
    constexpr decltype(auto) operator[](range_difference_t<DD> n)
        requires random_access_range<DD>
    {
        return ranges::begin(__derived())[n];
    }
    template <typename DD = D>
    constexpr decltype(auto) operator[](range_difference_t<const DD> n) const
        requires random_access_range<const DD>
    {
        return ranges::begin(__derived())[n];
    }
};

// ── subrange ([range.subrange]) ─────────────────────────────────────────

enum class subrange_kind : bool { unsized, sized };

namespace __views_detail {

template <bool Store>
struct SubrangeSize {
    constexpr SubrangeSize() = default;
    constexpr SubrangeSize(size_t) noexcept {}
};
template <>
struct SubrangeSize<true> {
    size_t __n = 0;
    constexpr SubrangeSize() = default;
    constexpr SubrangeSize(size_t n) noexcept : __n(n) {}
};

// [range.subrange]'s two exposition-only concepts. The point of the pair is
// that plain convertible_to is TOO PERMISSIVE for an iterator: Derived* does
// convert to Base*, but a subrange<Base*> built from a Derived* range would
// then stride by sizeof(Base) over an array of Derived, reading each element
// at the wrong offset. Only a qualification conversion (adding const, say) is
// safe, and that is exactly what the array-of-pointer test below separates
// out -- `Derived(*)[]` does not convert to `Base(*)[]`, while `int(*)[]`
// does convert to `const int(*)[]`.
template <typename From, typename To>
concept UsesNonQualificationPointerConversion =
    is_pointer_v<From> && is_pointer_v<To> &&
    !convertible_to<remove_pointer_t<From> (*)[], remove_pointer_t<To> (*)[]>;

template <typename From, typename To>
concept ConvertibleToNonSlicing =
    convertible_to<From, To> &&
    !UsesNonQualificationPointerConversion<decay_t<From>, decay_t<To>>;

} // namespace __views_detail

template <input_or_output_iterator I, sentinel_for<I> S = I,
          subrange_kind K = (sized_sentinel_for<S, I> ? subrange_kind::sized
                                                      : subrange_kind::unsized)>
    requires(K == subrange_kind::sized || !sized_sentinel_for<S, I>)
class subrange : public view_interface<subrange<I, S, K>> {
    static constexpr bool kStoreSize =
        (K == subrange_kind::sized && !sized_sentinel_for<S, I>);

public:
    subrange()
        requires default_initializable<I>
    = default;

    constexpr subrange(__views_detail::ConvertibleToNonSlicing<I> auto i, S s)
        requires(!kStoreSize)
        : __begin(std::move(i)), __end(std::move(s)), __size(0)
    {
    }
    constexpr subrange(__views_detail::ConvertibleToNonSlicing<I> auto i, S s,
                       make_unsigned_t<iter_difference_t<I>> n)
        requires(K == subrange_kind::sized)
        : __begin(std::move(i)), __end(std::move(s)), __size(n)
    {
    }

    // The range constructors. Without them the two range deduction guides
    // below have nothing to deduce FROM, which is why `subrange(v)` -- the
    // spelling every algorithm returning a borrowed_subrange_t hands back --
    // did not compile at all. borrowed_range is the gate: a subrange into a
    // range that owns its elements and is about to expire would dangle, and
    // the concept is precisely the promise that it will not.
    template <typename R>
        requires(!same_as<remove_cvref_t<R>, subrange>) && borrowed_range<R> &&
                __views_detail::ConvertibleToNonSlicing<iterator_t<R>, I> &&
                convertible_to<sentinel_t<R>, S>
    constexpr subrange(R &&r)
        requires(!kStoreSize || sized_range<R>)
        : __begin(ranges::begin(r)), __end(ranges::end(r)), __size(0)
    {
        // Only the store-the-size shape needs the extra pass; the others
        // compute size() from the sentinel, so asking the range for it here
        // would be a second traversal for nothing.
        if constexpr (kStoreSize)
            __size.__n = static_cast<size_t>(ranges::size(r));
    }
    template <typename R>
        requires borrowed_range<R> &&
                 __views_detail::ConvertibleToNonSlicing<iterator_t<R>, I> &&
                 convertible_to<sentinel_t<R>, S>
    constexpr subrange(R &&r, make_unsigned_t<iter_difference_t<I>> n)
        requires(K == subrange_kind::sized)
        : __begin(ranges::begin(r)), __end(ranges::end(r)), __size(n)
    {
    }

    constexpr I begin() const
        requires copyable<I>
    {
        return __begin;
    }
    constexpr I begin()
        requires(!copyable<I>)
    {
        return std::move(__begin);
    }
    constexpr S end() const { return __end; }

    [[nodiscard]] constexpr bool empty() const { return __begin == __end; }

    constexpr make_unsigned_t<iter_difference_t<I>> size() const
        requires(K == subrange_kind::sized)
    {
        if constexpr (kStoreSize)
            return __size.__n;
        else
            return static_cast<make_unsigned_t<iter_difference_t<I>>>(__end -
                                                                      __begin);
    }

    constexpr subrange &advance(iter_difference_t<I> n)
    {
        if constexpr (bidirectional_iterator<I>) {
            if (n < 0) {
                std::advance(__begin, n);
                if constexpr (kStoreSize)
                    __size.__n += static_cast<size_t>(-n);
                return *this;
            }
        }
        std::advance(__begin, n);
        if constexpr (kStoreSize) __size.__n -= static_cast<size_t>(n);
        return *this;
    }
    [[nodiscard]] constexpr subrange next(iter_difference_t<I> n = 1) const &
        requires forward_iterator<I>
    {
        auto t = *this;
        t.advance(n);
        return t;
    }
    [[nodiscard]] constexpr subrange next(iter_difference_t<I> n = 1) &&
    {
        advance(n);
        return std::move(*this);
    }
    [[nodiscard]] constexpr subrange prev(iter_difference_t<I> n = 1) const
        requires bidirectional_iterator<I>
    {
        auto t = *this;
        t.advance(-n);
        return t;
    }

private:
    I __begin = I();
    S __end   = S();
    [[no_unique_address]] __views_detail::SubrangeSize<kStoreSize> __size;
};

template <input_or_output_iterator I, sentinel_for<I> S>
subrange(I, S) -> subrange<I, S>;
template <input_or_output_iterator I, sentinel_for<I> S>
subrange(I, S,
         make_unsigned_t<iter_difference_t<I>>) -> subrange<I, S,
                                                            subrange_kind::sized>;
// The range guides. Note the kind: a range that can report its own size, or
// whose sentinel can be subtracted from its iterator, yields a SIZED subrange
// even though no size was passed -- so `subrange(v).size()` works on a vector
// without storing anything.
template <borrowed_range R>
subrange(R &&)
    -> subrange<iterator_t<R>, sentinel_t<R>,
                (sized_range<R> ||
                 sized_sentinel_for<sentinel_t<R>, iterator_t<R>>)
                    ? subrange_kind::sized
                    : subrange_kind::unsized>;
template <borrowed_range R>
subrange(R &&, make_unsigned_t<range_difference_t<R>>)
    -> subrange<iterator_t<R>, sentinel_t<R>, subrange_kind::sized>;

template <typename I, typename S, subrange_kind K>
inline constexpr bool enable_borrowed_range<subrange<I, S, K>> = true;

// ── ref_view ([range.ref.view]) ─────────────────────────────────────────

template <range R>
    requires is_object_v<R>
class ref_view : public view_interface<ref_view<R>> {
    R *__r;

public:
    template <typename T>
        requires(!same_as<remove_cvref_t<T>, ref_view>) &&
                convertible_to<T, R &> &&
                requires { __views_detail::RefFun<R>(declval<T>()); }
    constexpr ref_view(T &&t)
        : __r(__builtin_addressof(static_cast<R &>(std::forward<T>(t))))
    {
    }

    constexpr R &base() const { return *__r; }
    constexpr iterator_t<R> begin() const { return ranges::begin(*__r); }
    constexpr sentinel_t<R> end() const { return ranges::end(*__r); }
    constexpr bool empty() const
        requires requires { ranges::empty(*__r); }
    {
        return ranges::empty(*__r);
    }
    constexpr auto size() const
        requires sized_range<R>
    {
        return ranges::size(*__r);
    }
    constexpr auto reserve_hint() const
        requires approximately_sized_range<R>
    {
        return ranges::reserve_hint(*__r);
    }
    constexpr auto data() const
        requires contiguous_range<R>
    {
        return ranges::data(*__r);
    }
};

template <typename R>
ref_view(R &) -> ref_view<R>;

template <typename T>
inline constexpr bool enable_borrowed_range<ref_view<T>> = true;

// ── owning_view ([range.owning.view]) ───────────────────────────────────

template <range R>
    requires movable<R>
class owning_view : public view_interface<owning_view<R>> {
    R __r = R();

public:
    owning_view()
        requires default_initializable<R>
    = default;
    constexpr owning_view(R &&t) : __r(std::move(t)) {}
    owning_view(owning_view &&)            = default;
    owning_view &operator=(owning_view &&) = default;

    constexpr R &base() & noexcept { return __r; }
    constexpr const R &base() const & noexcept { return __r; }
    constexpr R &&base() && noexcept { return std::move(__r); }
    constexpr const R &&base() const && noexcept { return std::move(__r); }

    constexpr iterator_t<R> begin() { return ranges::begin(__r); }
    constexpr sentinel_t<R> end() { return ranges::end(__r); }
    constexpr auto begin() const
        requires range<const R>
    {
        return ranges::begin(__r);
    }
    constexpr auto end() const
        requires range<const R>
    {
        return ranges::end(__r);
    }

    constexpr bool empty()
        requires requires { ranges::empty(__r); }
    {
        return ranges::empty(__r);
    }
    constexpr bool empty() const
        requires requires { ranges::empty(__r); }
    {
        return ranges::empty(__r);
    }
    constexpr auto size()
        requires sized_range<R>
    {
        return ranges::size(__r);
    }
    constexpr auto size() const
        requires sized_range<const R>
    {
        return ranges::size(__r);
    }
    constexpr auto reserve_hint()
        requires approximately_sized_range<R>
    {
        return ranges::reserve_hint(__r);
    }
    constexpr auto reserve_hint() const
        requires approximately_sized_range<const R>
    {
        return ranges::reserve_hint(__r);
    }
    constexpr auto data()
        requires contiguous_range<R>
    {
        return ranges::data(__r);
    }
    constexpr auto data() const
        requires contiguous_range<const R>
    {
        return ranges::data(__r);
    }
};

template <typename R>
owning_view(R) -> owning_view<R>;

// ── range-adaptor pipe machinery ([range.adaptor.object]) ───────────────

struct RangeAdaptorClosureBase {};

// P2387R3's public CRTP hook: the way a program outside this header writes an
// adaptor that composes with `|` like the built-in ones. Deriving from it is
// the whole opt-in -- the pipe operators below already key off the base, so a
// user closure joins the same overload set as views::filter.
//
// The constraints have to hold while D is still INCOMPLETE (it names itself in
// its own base clause), which is why they are is_object_v and a cv check and
// nothing that would require a complete type.
template <typename D>
    requires is_object_v<D> && same_as<D, remove_cv_t<D>>
class range_adaptor_closure : public RangeAdaptorClosureBase {};

// [range.adaptor.object]/3.4: a closure "does not model range". Without that
// clause a user type that is BOTH a range and derived from the hook would be
// taken as the closure operand of `r | c` rather than as the range, and the
// pipe would silently mean the wrong thing.
template <typename T>
concept IsRangeAdaptorClosure =
    derived_from<remove_cvref_t<T>, RangeAdaptorClosureBase> &&
    !range<remove_cvref_t<T>>;

template <typename Adaptor, typename Arg>
struct RangeAdaptorPartial : RangeAdaptorClosureBase {
    Adaptor __ad;
    Arg __arg;
    constexpr RangeAdaptorPartial(Adaptor a, Arg g)
        : __ad(std::move(a)), __arg(std::move(g))
    {
    }
    // Ref-qualified so an rvalue (temporary) partial MOVES its stored argument
    // into the adaptor: a range-valued __arg then reaches views::all as an
    // rvalue and is wrapped in an owning_view, not a dangling ref_view into the
    // closure temporary. join_with is the first adaptor to bind a range payload,
    // so this latent [range.adaptor.object] requirement first bites here.
    template <typename R>
    constexpr auto operator()(R &&r) const &
    {
        return __ad(std::forward<R>(r), __arg);
    }
    template <typename R>
    constexpr auto operator()(R &&r) &&
    {
        return std::move(__ad)(std::forward<R>(r), std::move(__arg));
    }
};

template <typename C, typename D>
struct RangeAdaptorComposed : RangeAdaptorClosureBase {
    C __c;
    D __d;
    constexpr RangeAdaptorComposed(C c, D d)
        : __c(std::move(c)), __d(std::move(d))
    {
    }
    // Same rvalue-forwarding discipline as RangeAdaptorPartial: an rvalue
    // composed closure moves its captured sub-closures, so a range-valued
    // payload buried in either half (e.g. views::join_with(vec) | views::reverse)
    // is owned rather than left dangling into the composed temporary.
    template <typename R>
    constexpr auto operator()(R &&r) const &
    {
        return __d(__c(std::forward<R>(r)));
    }
    template <typename R>
    constexpr auto operator()(R &&r) &&
    {
        return std::move(__d)(std::move(__c)(std::forward<R>(r)));
    }
};

template <typename R, typename C>
    requires(!IsRangeAdaptorClosure<R>) && IsRangeAdaptorClosure<C> &&
            requires(R &&r, C &&c) {
                static_cast<C &&>(c)(static_cast<R &&>(r));
            }
constexpr auto operator|(R &&r, C &&c)
{
    return std::forward<C>(c)(std::forward<R>(r));
}

template <typename C, typename D>
    requires IsRangeAdaptorClosure<C> && IsRangeAdaptorClosure<D>
constexpr auto operator|(C &&c, D &&d)
{
    return RangeAdaptorComposed<remove_cvref_t<C>, remove_cvref_t<D>>(
        std::forward<C>(c), std::forward<D>(d));
}

// ── views::all + all_t ([range.all]) ────────────────────────────────────

namespace views {

struct All : RangeAdaptorClosureBase {
    template <viewable_range R>
    constexpr auto operator()(R &&r) const
    {
        if constexpr (view<remove_cvref_t<R>>)
            return remove_cvref_t<R>(std::forward<R>(r));
        else if constexpr (requires { ref_view(std::forward<R>(r)); })
            return ref_view(std::forward<R>(r));
        else
            return owning_view(std::forward<R>(r));
    }
};

inline constexpr All all{};

template <viewable_range R>
using all_t = decltype(all(declval<R>()));

} // namespace views

// ── take_view ([range.take]) ────────────────────────────────────────────

template <view V>
class take_view : public view_interface<take_view<V>> {
    V __base                      = V();
    range_difference_t<V> __count = 0;

    // For a base that is neither sized nor random-access, take() cannot
    // precompute an offset end, and __MakeBegin hands out a counted_iterator
    // carrying the raw (uncapped) count — so end() must ALSO stop the walk at
    // the base's own end, or a count past the base length runs off it (heap
    // overflow). This bespoke sentinel compares equal to a counted_iterator on
    // EITHER count exhaustion or the iterator reaching the base end
    // ([range.take.sentinel]); default_sentinel alone only checks the count.
    template <typename S>
    struct Sentinel {
        S __end = S();
        Sentinel() = default;
        constexpr explicit Sentinel(S end) : __end(std::move(end)) {}
        constexpr S base() const { return __end; }
        template <typename I>
        friend constexpr bool operator==(const counted_iterator<I> &y, const Sentinel &x)
        {
            return y.count() == 0 || y.base() == x.__end;
        }
    };

    template <typename Base>
    static constexpr auto __MakeBegin(Base &b, range_difference_t<V> count)
    {
        if constexpr (sized_range<Base>) {
            if constexpr (random_access_range<Base>) {
                return ranges::begin(b);
            } else {
                auto sz = static_cast<range_difference_t<V>>(ranges::size(b));
                return counted_iterator(ranges::begin(b),
                                        count < sz ? count : sz);
            }
        } else {
            return counted_iterator(ranges::begin(b), count);
        }
    }
    template <typename Base>
    static constexpr auto __MakeEnd(Base &b, range_difference_t<V> count)
    {
        if constexpr (sized_range<Base> && random_access_range<Base>) {
            auto sz = static_cast<range_difference_t<V>>(ranges::size(b));
            return ranges::begin(b) + (count < sz ? count : sz);
        } else if constexpr (sized_range<Base>) {
            // Sized but not random-access: __MakeBegin already capped the count
            // to the size, so the counted_iterator reaches count()==0 exactly at
            // the base end — default_sentinel is bounded and correct here.
            return default_sentinel;
        } else {
            // Non-sized: the begin count is uncapped, so the end must carry the
            // base end to bound the walk (see Sentinel above).
            return Sentinel<sentinel_t<Base>>(ranges::end(b));
        }
    }

public:
    take_view()
        requires default_initializable<V>
    = default;
    constexpr take_view(V base, range_difference_t<V> count)
        : __base(std::move(base)), __count(count)
    {
    }

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }

    constexpr auto begin() { return __MakeBegin(__base, __count); }
    constexpr auto begin() const
        requires range<const V>
    {
        return __MakeBegin(__base, __count);
    }
    constexpr auto end() { return __MakeEnd(__base, __count); }
    constexpr auto end() const
        requires range<const V>
    {
        return __MakeEnd(__base, __count);
    }

    constexpr auto size()
        requires sized_range<V>
    {
        auto n = ranges::size(__base);
        auto c = static_cast<decltype(n)>(__count);
        return n < c ? n : c;
    }
    constexpr auto size() const
        requires sized_range<const V>
    {
        auto n = ranges::size(__base);
        auto c = static_cast<decltype(n)>(__count);
        return n < c ? n : c;
    }
    // P2846R6, and take_view is the one view whose reserve_hint is
    // UNCONSTRAINED: `r | views::take(n)` is likely to yield n elements even
    // when r offers no hint at all, so with no hint underneath the answer is
    // n, and with one it is min(n, hint). LEWG asked for this explicitly.
    constexpr auto reserve_hint()
    {
        using U = make_unsigned_t<range_difference_t<V>>;
        if constexpr (approximately_sized_range<V>) {
            auto n = static_cast<range_difference_t<V>>(ranges::reserve_hint(__base));
            return static_cast<U>(n < __count ? n : __count);
        } else {
            return static_cast<U>(__count);
        }
    }
    constexpr auto reserve_hint() const
    {
        using U = make_unsigned_t<range_difference_t<const V>>;
        if constexpr (approximately_sized_range<const V>) {
            auto n = static_cast<range_difference_t<const V>>(ranges::reserve_hint(__base));
            return static_cast<U>(n < __count ? n : __count);
        } else {
            return static_cast<U>(__count);
        }
    }
};

template <typename T>
inline constexpr bool enable_borrowed_range<take_view<T>> =
    enable_borrowed_range<T>;

