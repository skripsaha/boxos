// boxcxx — <__bits/ranges_views>
// The range-views layer (Ф7B-3): view_interface, subrange, ref_view,
// owning_view, the range-adaptor pipe machinery, and the all/take/drop/
// filter/transform adaptors. Pulled in by <ranges> AFTER the core
// (CPOs + range/view concepts) so everything below is already in scope.
//
// boxcxx simplifications (documented, safe for the closed type set):
//   • view_interface<D> derives from view_base, so every view_interface
//     subclass satisfies the existing enable_view = derived_from<view_base>.
//   • filter_view / transform_view are non-const-iterable (no const begin)
//     and recompute begin() each call (no non-propagating cache); correct
//     for the materialize-then-iterate (range-for) pattern.
#ifndef BOXCXX_BITS_RANGES_VIEWS
#define BOXCXX_BITS_RANGES_VIEWS

#include <compare>
#include <concepts>
#include <cstddef>
#include <functional>
#include <iterator>
#include <new>
#include <type_traits>
#include <utility>

namespace std {
namespace ranges {

namespace __views_detail {

// ── MovableBox — the semiregular-box for storing a view's callable ──────
// Wraps a move/copy-constructible (but maybe non-assignable) object so the
// owning view stays movable/copyable. Assignment that the wrapped type
// cannot do directly is emulated by destroy + reconstruct.
template <typename T>
    requires move_constructible<T> && is_object_v<T>
class MovableBox {
public:
    constexpr MovableBox()
        requires default_initializable<T>
        : __val()
    {
    }
    constexpr explicit MovableBox(const T &t)
        requires copy_constructible<T>
        : __val(t)
    {
    }
    constexpr explicit MovableBox(T &&t) : __val(std::move(t)) {}

    constexpr MovableBox(const MovableBox &)
        requires copy_constructible<T>
    = default;
    constexpr MovableBox(MovableBox &&) = default;

    constexpr MovableBox &operator=(const MovableBox &o)
        requires copy_constructible<T>
    {
        if (this != __builtin_addressof(o)) {
            if constexpr (is_copy_assignable_v<T>) {
                __val = o.__val;
            } else {
                __val.~T();
                ::new (static_cast<void *>(__builtin_addressof(__val)))
                    T(o.__val);
            }
        }
        return *this;
    }
    constexpr MovableBox &operator=(MovableBox &&o)
    {
        if (this != __builtin_addressof(o)) {
            if constexpr (is_move_assignable_v<T>) {
                __val = std::move(o.__val);
            } else {
                __val.~T();
                ::new (static_cast<void *>(__builtin_addressof(__val)))
                    T(std::move(o.__val));
            }
        }
        return *this;
    }

    constexpr T &operator*() noexcept { return __val; }
    constexpr const T &operator*() const noexcept { return __val; }
    constexpr T *operator->() noexcept { return __builtin_addressof(__val); }
    constexpr const T *operator->() const noexcept
    {
        return __builtin_addressof(__val);
    }

private:
    T __val;
};

// FUN trick: binds only to lvalues that convert to R& (ref_view ctor).
template <typename R>
void RefFun(R &);
template <typename R>
void RefFun(R &&) = delete;

} // namespace __views_detail

// ── view_interface ([view.interface]) ───────────────────────────────────

template <typename D>
    requires is_class_v<D> && same_as<D, remove_cv_t<D>>
class view_interface : public view_base {
private:
    constexpr D &__derived() noexcept { return static_cast<D &>(*this); }
    constexpr const D &__derived() const noexcept
    {
        return static_cast<const D &>(*this);
    }

public:
    template <typename DD = D>
    [[nodiscard]] constexpr bool empty()
        requires forward_range<DD>
    {
        return ranges::begin(__derived()) == ranges::end(__derived());
    }
    template <typename DD = D>
    [[nodiscard]] constexpr bool empty() const
        requires forward_range<const DD>
    {
        return ranges::begin(__derived()) == ranges::end(__derived());
    }

    template <typename DD = D>
    constexpr explicit operator bool()
        requires requires(DD &d) { ranges::empty(d); }
    {
        return !ranges::empty(__derived());
    }
    template <typename DD = D>
    constexpr explicit operator bool() const
        requires requires(const DD &d) { ranges::empty(d); }
    {
        return !ranges::empty(__derived());
    }

    template <typename DD = D>
    constexpr auto data()
        requires contiguous_range<DD>
    {
        return ranges::begin(__derived());
    }
    template <typename DD = D>
    constexpr auto data() const
        requires contiguous_range<const DD>
    {
        return ranges::begin(__derived());
    }

    template <typename DD = D>
    constexpr auto size()
        requires(forward_range<DD> &&
                 sized_sentinel_for<sentinel_t<DD>, iterator_t<DD>>)
    {
        return static_cast<make_unsigned_t<range_difference_t<DD>>>(
            ranges::end(__derived()) - ranges::begin(__derived()));
    }
    template <typename DD = D>
    constexpr auto size() const
        requires(forward_range<const DD> &&
                 sized_sentinel_for<sentinel_t<const DD>, iterator_t<const DD>>)
    {
        return static_cast<make_unsigned_t<range_difference_t<const DD>>>(
            ranges::end(__derived()) - ranges::begin(__derived()));
    }

    template <typename DD = D>
    constexpr decltype(auto) front()
        requires forward_range<DD>
    {
        return *ranges::begin(__derived());
    }
    template <typename DD = D>
    constexpr decltype(auto) front() const
        requires forward_range<const DD>
    {
        return *ranges::begin(__derived());
    }

    template <typename DD = D>
    constexpr decltype(auto) back()
        requires(bidirectional_range<DD> && common_range<DD>)
    {
        auto it = ranges::end(__derived());
        --it;
        return *it;
    }
    template <typename DD = D>
    constexpr decltype(auto) back() const
        requires(bidirectional_range<const DD> && common_range<const DD>)
    {
        auto it = ranges::end(__derived());
        --it;
        return *it;
    }

    template <typename DD = D>
    constexpr decltype(auto) operator[](range_difference_t<DD> n)
        requires random_access_range<DD>
    {
        return ranges::begin(__derived())[n];
    }
    template <typename DD = D>
    constexpr decltype(auto) operator[](range_difference_t<const DD> n) const
        requires random_access_range<const DD>
    {
        return ranges::begin(__derived())[n];
    }
};

// ── subrange ([range.subrange]) ─────────────────────────────────────────

enum class subrange_kind : bool { unsized, sized };

namespace __views_detail {

template <bool Store>
struct SubrangeSize {
    constexpr SubrangeSize() = default;
    constexpr SubrangeSize(size_t) noexcept {}
};
template <>
struct SubrangeSize<true> {
    size_t __n = 0;
    constexpr SubrangeSize() = default;
    constexpr SubrangeSize(size_t n) noexcept : __n(n) {}
};

} // namespace __views_detail

template <input_or_output_iterator I, sentinel_for<I> S = I,
          subrange_kind K = (sized_sentinel_for<S, I> ? subrange_kind::sized
                                                      : subrange_kind::unsized)>
    requires(K == subrange_kind::sized || !sized_sentinel_for<S, I>)
class subrange : public view_interface<subrange<I, S, K>> {
    static constexpr bool kStoreSize =
        (K == subrange_kind::sized && !sized_sentinel_for<S, I>);

public:
    subrange()
        requires default_initializable<I>
    = default;

    constexpr subrange(I i, S s)
        requires(!kStoreSize)
        : __begin(std::move(i)), __end(std::move(s)), __size(0)
    {
    }
    constexpr subrange(I i, S s, make_unsigned_t<iter_difference_t<I>> n)
        requires(K == subrange_kind::sized)
        : __begin(std::move(i)), __end(std::move(s)), __size(n)
    {
    }

    constexpr I begin() const
        requires copyable<I>
    {
        return __begin;
    }
    constexpr I begin()
        requires(!copyable<I>)
    {
        return std::move(__begin);
    }
    constexpr S end() const { return __end; }

    [[nodiscard]] constexpr bool empty() const { return __begin == __end; }

    constexpr make_unsigned_t<iter_difference_t<I>> size() const
        requires(K == subrange_kind::sized)
    {
        if constexpr (kStoreSize)
            return __size.__n;
        else
            return static_cast<make_unsigned_t<iter_difference_t<I>>>(__end -
                                                                      __begin);
    }

    constexpr subrange &advance(iter_difference_t<I> n)
    {
        if constexpr (bidirectional_iterator<I>) {
            if (n < 0) {
                std::advance(__begin, n);
                if constexpr (kStoreSize)
                    __size.__n += static_cast<size_t>(-n);
                return *this;
            }
        }
        std::advance(__begin, n);
        if constexpr (kStoreSize) __size.__n -= static_cast<size_t>(n);
        return *this;
    }
    [[nodiscard]] constexpr subrange next(iter_difference_t<I> n = 1) const &
        requires forward_iterator<I>
    {
        auto t = *this;
        t.advance(n);
        return t;
    }
    [[nodiscard]] constexpr subrange next(iter_difference_t<I> n = 1) &&
    {
        advance(n);
        return std::move(*this);
    }
    [[nodiscard]] constexpr subrange prev(iter_difference_t<I> n = 1) const
        requires bidirectional_iterator<I>
    {
        auto t = *this;
        t.advance(-n);
        return t;
    }

private:
    I __begin = I();
    S __end   = S();
    [[no_unique_address]] __views_detail::SubrangeSize<kStoreSize> __size;
};

template <input_or_output_iterator I, sentinel_for<I> S>
subrange(I, S) -> subrange<I, S>;
template <input_or_output_iterator I, sentinel_for<I> S>
subrange(I, S,
         make_unsigned_t<iter_difference_t<I>>) -> subrange<I, S,
                                                            subrange_kind::sized>;

template <typename I, typename S, subrange_kind K>
inline constexpr bool enable_borrowed_range<subrange<I, S, K>> = true;

// ── ref_view ([range.ref.view]) ─────────────────────────────────────────

template <range R>
    requires is_object_v<R>
class ref_view : public view_interface<ref_view<R>> {
    R *__r;

public:
    template <typename T>
        requires(!same_as<remove_cvref_t<T>, ref_view>) &&
                convertible_to<T, R &> &&
                requires { __views_detail::RefFun<R>(declval<T>()); }
    constexpr ref_view(T &&t)
        : __r(__builtin_addressof(static_cast<R &>(std::forward<T>(t))))
    {
    }

    constexpr R &base() const { return *__r; }
    constexpr iterator_t<R> begin() const { return ranges::begin(*__r); }
    constexpr sentinel_t<R> end() const { return ranges::end(*__r); }
    constexpr bool empty() const
        requires requires { ranges::empty(*__r); }
    {
        return ranges::empty(*__r);
    }
    constexpr auto size() const
        requires sized_range<R>
    {
        return ranges::size(*__r);
    }
    constexpr auto data() const
        requires contiguous_range<R>
    {
        return ranges::data(*__r);
    }
};

template <typename R>
ref_view(R &) -> ref_view<R>;

template <typename T>
inline constexpr bool enable_borrowed_range<ref_view<T>> = true;

// ── owning_view ([range.owning.view]) ───────────────────────────────────

template <range R>
    requires movable<R>
class owning_view : public view_interface<owning_view<R>> {
    R __r = R();

public:
    owning_view()
        requires default_initializable<R>
    = default;
    constexpr owning_view(R &&t) : __r(std::move(t)) {}
    owning_view(owning_view &&)            = default;
    owning_view &operator=(owning_view &&) = default;

    constexpr R &base() & noexcept { return __r; }
    constexpr const R &base() const & noexcept { return __r; }
    constexpr R &&base() && noexcept { return std::move(__r); }
    constexpr const R &&base() const && noexcept { return std::move(__r); }

    constexpr iterator_t<R> begin() { return ranges::begin(__r); }
    constexpr sentinel_t<R> end() { return ranges::end(__r); }
    constexpr auto begin() const
        requires range<const R>
    {
        return ranges::begin(__r);
    }
    constexpr auto end() const
        requires range<const R>
    {
        return ranges::end(__r);
    }

    constexpr bool empty()
        requires requires { ranges::empty(__r); }
    {
        return ranges::empty(__r);
    }
    constexpr bool empty() const
        requires requires { ranges::empty(__r); }
    {
        return ranges::empty(__r);
    }
    constexpr auto size()
        requires sized_range<R>
    {
        return ranges::size(__r);
    }
    constexpr auto size() const
        requires sized_range<const R>
    {
        return ranges::size(__r);
    }
    constexpr auto data()
        requires contiguous_range<R>
    {
        return ranges::data(__r);
    }
    constexpr auto data() const
        requires contiguous_range<const R>
    {
        return ranges::data(__r);
    }
};

template <typename R>
owning_view(R) -> owning_view<R>;

// ── range-adaptor pipe machinery ([range.adaptor.object]) ───────────────

struct RangeAdaptorClosureBase {};

template <typename T>
concept IsRangeAdaptorClosure =
    derived_from<remove_cvref_t<T>, RangeAdaptorClosureBase>;

template <typename Adaptor, typename Arg>
struct RangeAdaptorPartial : RangeAdaptorClosureBase {
    Adaptor __ad;
    Arg __arg;
    constexpr RangeAdaptorPartial(Adaptor a, Arg g)
        : __ad(std::move(a)), __arg(std::move(g))
    {
    }
    template <typename R>
    constexpr auto operator()(R &&r) const
    {
        return __ad(std::forward<R>(r), __arg);
    }
};

template <typename C, typename D>
struct RangeAdaptorComposed : RangeAdaptorClosureBase {
    C __c;
    D __d;
    constexpr RangeAdaptorComposed(C c, D d)
        : __c(std::move(c)), __d(std::move(d))
    {
    }
    template <typename R>
    constexpr auto operator()(R &&r) const
    {
        return __d(__c(std::forward<R>(r)));
    }
};

template <typename R, typename C>
    requires(!IsRangeAdaptorClosure<R>) && IsRangeAdaptorClosure<C> &&
            requires(R &&r, C &&c) {
                static_cast<C &&>(c)(static_cast<R &&>(r));
            }
constexpr auto operator|(R &&r, C &&c)
{
    return std::forward<C>(c)(std::forward<R>(r));
}

template <typename C, typename D>
    requires IsRangeAdaptorClosure<C> && IsRangeAdaptorClosure<D>
constexpr auto operator|(C &&c, D &&d)
{
    return RangeAdaptorComposed<remove_cvref_t<C>, remove_cvref_t<D>>(
        std::forward<C>(c), std::forward<D>(d));
}

// ── views::all + all_t ([range.all]) ────────────────────────────────────

namespace views {

struct All : RangeAdaptorClosureBase {
    template <viewable_range R>
    constexpr auto operator()(R &&r) const
    {
        if constexpr (view<remove_cvref_t<R>>)
            return remove_cvref_t<R>(std::forward<R>(r));
        else if constexpr (requires { ref_view(std::forward<R>(r)); })
            return ref_view(std::forward<R>(r));
        else
            return owning_view(std::forward<R>(r));
    }
};

inline constexpr All all{};

template <viewable_range R>
using all_t = decltype(all(declval<R>()));

} // namespace views

// ── take_view ([range.take]) ────────────────────────────────────────────

template <view V>
class take_view : public view_interface<take_view<V>> {
    V __base                      = V();
    range_difference_t<V> __count = 0;

    template <typename Base>
    static constexpr auto __MakeBegin(Base &b, range_difference_t<V> count)
    {
        if constexpr (sized_range<Base>) {
            if constexpr (random_access_range<Base>) {
                return ranges::begin(b);
            } else {
                auto sz = static_cast<range_difference_t<V>>(ranges::size(b));
                return counted_iterator(ranges::begin(b),
                                        count < sz ? count : sz);
            }
        } else {
            return counted_iterator(ranges::begin(b), count);
        }
    }
    template <typename Base>
    static constexpr auto __MakeEnd(Base &b, range_difference_t<V> count)
    {
        if constexpr (sized_range<Base> && random_access_range<Base>) {
            auto sz = static_cast<range_difference_t<V>>(ranges::size(b));
            return ranges::begin(b) + (count < sz ? count : sz);
        } else {
            return default_sentinel;
        }
    }

public:
    take_view()
        requires default_initializable<V>
    = default;
    constexpr take_view(V base, range_difference_t<V> count)
        : __base(std::move(base)), __count(count)
    {
    }

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }

    constexpr auto begin() { return __MakeBegin(__base, __count); }
    constexpr auto begin() const
        requires range<const V>
    {
        return __MakeBegin(__base, __count);
    }
    constexpr auto end() { return __MakeEnd(__base, __count); }
    constexpr auto end() const
        requires range<const V>
    {
        return __MakeEnd(__base, __count);
    }

    constexpr auto size()
        requires sized_range<V>
    {
        auto n = ranges::size(__base);
        auto c = static_cast<decltype(n)>(__count);
        return n < c ? n : c;
    }
    constexpr auto size() const
        requires sized_range<const V>
    {
        auto n = ranges::size(__base);
        auto c = static_cast<decltype(n)>(__count);
        return n < c ? n : c;
    }
};

template <typename T>
inline constexpr bool enable_borrowed_range<take_view<T>> =
    enable_borrowed_range<T>;

namespace views {

struct Take {
    template <viewable_range R, integral D>
    constexpr auto operator()(R &&r, D n) const
    {
        using V = all_t<R>;
        return take_view<V>(all(std::forward<R>(r)),
                            static_cast<range_difference_t<V>>(n));
    }
    template <typename D>
        requires(!viewable_range<remove_cvref_t<D>>)
    constexpr auto operator()(D &&n) const
    {
        return RangeAdaptorPartial<Take, remove_cvref_t<D>>(
            Take{}, static_cast<remove_cvref_t<D>>(std::forward<D>(n)));
    }
};

inline constexpr Take take{};

} // namespace views

// ── drop_view ([range.drop]) ────────────────────────────────────────────

template <view V>
class drop_view : public view_interface<drop_view<V>> {
    V __base                      = V();
    range_difference_t<V> __count = 0;

    template <typename Base>
    static constexpr auto __MakeBegin(Base &b, range_difference_t<V> count)
    {
        if constexpr (random_access_range<Base> && sized_range<Base>) {
            auto sz = static_cast<range_difference_t<V>>(ranges::size(b));
            return ranges::begin(b) + (count < sz ? count : sz);
        } else {
            auto it = ranges::begin(b);
            auto e  = ranges::end(b);
            for (auto n = count; n > 0 && it != e; --n) ++it;
            return it;
        }
    }

public:
    drop_view()
        requires default_initializable<V>
    = default;
    constexpr drop_view(V base, range_difference_t<V> count)
        : __base(std::move(base)), __count(count)
    {
    }

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }

    constexpr auto begin() { return __MakeBegin(__base, __count); }
    constexpr auto begin() const
        requires range<const V>
    {
        return __MakeBegin(__base, __count);
    }
    constexpr auto end() { return ranges::end(__base); }
    constexpr auto end() const
        requires range<const V>
    {
        return ranges::end(__base);
    }

    constexpr auto size()
        requires sized_range<V>
    {
        auto n = ranges::size(__base);
        auto c = static_cast<decltype(n)>(__count);
        return n > c ? n - c : static_cast<decltype(n)>(0);
    }
    constexpr auto size() const
        requires sized_range<const V>
    {
        auto n = ranges::size(__base);
        auto c = static_cast<decltype(n)>(__count);
        return n > c ? n - c : static_cast<decltype(n)>(0);
    }
};

template <typename T>
inline constexpr bool enable_borrowed_range<drop_view<T>> =
    enable_borrowed_range<T>;

namespace views {

struct Drop {
    template <viewable_range R, integral D>
    constexpr auto operator()(R &&r, D n) const
    {
        using V = all_t<R>;
        return drop_view<V>(all(std::forward<R>(r)),
                            static_cast<range_difference_t<V>>(n));
    }
    template <typename D>
        requires(!viewable_range<remove_cvref_t<D>>)
    constexpr auto operator()(D &&n) const
    {
        return RangeAdaptorPartial<Drop, remove_cvref_t<D>>(
            Drop{}, static_cast<remove_cvref_t<D>>(std::forward<D>(n)));
    }
};

inline constexpr Drop drop{};

} // namespace views

// ── filter_view ([range.filter]) ────────────────────────────────────────

template <input_range V, typename Pred>
    requires view<V> && is_object_v<Pred> &&
             predicate<Pred &, range_reference_t<V>>
class filter_view : public view_interface<filter_view<V, Pred>> {
    V __base = V();
    __views_detail::MovableBox<Pred> __pred;

    constexpr iterator_t<V> __FindNext(iterator_t<V> it)
    {
        auto e = ranges::end(__base);
        while (it != e && !static_cast<bool>(std::invoke(*__pred, *it))) ++it;
        return it;
    }

    struct Iterator;
    struct Sentinel;

public:
    filter_view()
        requires default_initializable<V> && default_initializable<Pred>
    = default;
    constexpr filter_view(V base, Pred pred)
        : __base(std::move(base)), __pred(std::move(pred))
    {
    }

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }
    constexpr const Pred &pred() const { return *__pred; }

    constexpr Iterator begin()
    {
        return Iterator{*this, __FindNext(ranges::begin(__base))};
    }
    constexpr auto end()
    {
        if constexpr (common_range<V>)
            return Iterator{*this, ranges::end(__base)};
        else
            return Sentinel{*this};
    }
};

template <input_range V, typename Pred>
    requires view<V> && is_object_v<Pred> &&
             predicate<Pred &, range_reference_t<V>>
struct filter_view<V, Pred>::Iterator {
    using __BaseCat = typename iterator_traits<iterator_t<V>>::iterator_category;
    using iterator_concept =
        conditional_t<bidirectional_range<V>, bidirectional_iterator_tag,
                      conditional_t<forward_range<V>, forward_iterator_tag,
                                    input_iterator_tag>>;
    using iterator_category = conditional_t<
        derived_from<__BaseCat, bidirectional_iterator_tag>,
        bidirectional_iterator_tag,
        conditional_t<derived_from<__BaseCat, forward_iterator_tag>,
                      forward_iterator_tag, input_iterator_tag>>;
    using value_type      = range_value_t<V>;
    using difference_type = range_difference_t<V>;
    using pointer         = void;
    using reference       = range_reference_t<V>;

    filter_view *__parent = nullptr;
    iterator_t<V> __cur   = iterator_t<V>();

    Iterator()
        requires default_initializable<iterator_t<V>>
    = default;
    constexpr Iterator(filter_view &p, iterator_t<V> c)
        : __parent(__builtin_addressof(p)), __cur(std::move(c))
    {
    }

    constexpr const iterator_t<V> &base() const & noexcept { return __cur; }
    constexpr iterator_t<V> base() && { return std::move(__cur); }

    constexpr range_reference_t<V> operator*() const { return *__cur; }

    constexpr Iterator &operator++()
    {
        ++__cur;
        __cur = __parent->__FindNext(__cur);
        return *this;
    }
    constexpr void operator++(int) { ++*this; }
    constexpr Iterator operator++(int)
        requires forward_range<V>
    {
        auto t = *this;
        ++*this;
        return t;
    }
    constexpr Iterator &operator--()
        requires bidirectional_range<V>
    {
        do {
            --__cur;
        } while (!static_cast<bool>(std::invoke(*__parent->__pred, *__cur)));
        return *this;
    }
    constexpr Iterator operator--(int)
        requires bidirectional_range<V>
    {
        auto t = *this;
        --*this;
        return t;
    }

    friend constexpr bool operator==(const Iterator &a, const Iterator &b)
        requires equality_comparable<iterator_t<V>>
    {
        return a.__cur == b.__cur;
    }
};

template <input_range V, typename Pred>
    requires view<V> && is_object_v<Pred> &&
             predicate<Pred &, range_reference_t<V>>
struct filter_view<V, Pred>::Sentinel {
    sentinel_t<V> __end = sentinel_t<V>();

    Sentinel() = default;
    constexpr explicit Sentinel(filter_view &p) : __end(ranges::end(p.__base))
    {
    }
    constexpr sentinel_t<V> base() const { return __end; }

    friend constexpr bool operator==(const Iterator &i, const Sentinel &s)
    {
        return i.__cur == s.__end;
    }
};

namespace views {

struct Filter {
    template <viewable_range R, typename Pred>
    constexpr auto operator()(R &&r, Pred &&pred) const
    {
        return filter_view<all_t<R>, remove_cvref_t<Pred>>(
            all(std::forward<R>(r)), std::forward<Pred>(pred));
    }
    template <typename Pred>
        requires(!viewable_range<remove_cvref_t<Pred>>)
    constexpr auto operator()(Pred &&pred) const
    {
        return RangeAdaptorPartial<Filter, remove_cvref_t<Pred>>(
            Filter{}, std::forward<Pred>(pred));
    }
};

inline constexpr Filter filter{};

} // namespace views

// ── transform_view ([range.transform]) ──────────────────────────────────

template <input_range V, typename F>
    requires view<V> && is_object_v<F> &&
             regular_invocable<F &, range_reference_t<V>> &&
             requires {
                 typename remove_cvref_t<invoke_result_t<F &,
                                                         range_reference_t<V>>>;
             }
class transform_view : public view_interface<transform_view<V, F>> {
    V __base = V();
    __views_detail::MovableBox<F> __fn;

    struct Iterator;
    struct Sentinel;

public:
    transform_view()
        requires default_initializable<V> && default_initializable<F>
    = default;
    constexpr transform_view(V base, F fn)
        : __base(std::move(base)), __fn(std::move(fn))
    {
    }

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }

    constexpr Iterator begin() { return Iterator{*this, ranges::begin(__base)}; }
    constexpr auto end()
    {
        if constexpr (common_range<V>)
            return Iterator{*this, ranges::end(__base)};
        else
            return Sentinel{*this};
    }

    constexpr auto size()
        requires sized_range<V>
    {
        return ranges::size(__base);
    }
    constexpr auto size() const
        requires sized_range<const V>
    {
        return ranges::size(__base);
    }
};

template <input_range V, typename F>
    requires view<V> && is_object_v<F> &&
             regular_invocable<F &, range_reference_t<V>> &&
             requires {
                 typename remove_cvref_t<invoke_result_t<F &,
                                                         range_reference_t<V>>>;
             }
struct transform_view<V, F>::Iterator {
    using __BaseCat = typename iterator_traits<iterator_t<V>>::iterator_category;
    using iterator_concept =
        conditional_t<random_access_range<V>, random_access_iterator_tag,
                      conditional_t<bidirectional_range<V>,
                                    bidirectional_iterator_tag,
                                    conditional_t<forward_range<V>,
                                                  forward_iterator_tag,
                                                  input_iterator_tag>>>;
    using value_type =
        remove_cvref_t<invoke_result_t<F &, range_reference_t<V>>>;
    using difference_type = range_difference_t<V>;
    using reference       = invoke_result_t<F &, range_reference_t<V>>;
    using pointer         = void;
    using iterator_category = conditional_t<
        is_lvalue_reference_v<reference>,
        conditional_t<derived_from<__BaseCat, random_access_iterator_tag>,
                      random_access_iterator_tag, __BaseCat>,
        input_iterator_tag>;

    transform_view *__parent = nullptr;
    iterator_t<V> __cur      = iterator_t<V>();

    Iterator()
        requires default_initializable<iterator_t<V>>
    = default;
    constexpr Iterator(transform_view &p, iterator_t<V> c)
        : __parent(__builtin_addressof(p)), __cur(std::move(c))
    {
    }

    constexpr const iterator_t<V> &base() const & noexcept { return __cur; }
    constexpr iterator_t<V> base() && { return std::move(__cur); }

    constexpr reference operator*() const
    {
        return std::invoke(*__parent->__fn, *__cur);
    }

    constexpr Iterator &operator++()
    {
        ++__cur;
        return *this;
    }
    constexpr void operator++(int) { ++__cur; }
    constexpr Iterator operator++(int)
        requires forward_range<V>
    {
        auto t = *this;
        ++__cur;
        return t;
    }
    constexpr Iterator &operator--()
        requires bidirectional_range<V>
    {
        --__cur;
        return *this;
    }
    constexpr Iterator operator--(int)
        requires bidirectional_range<V>
    {
        auto t = *this;
        --__cur;
        return t;
    }

    constexpr Iterator &operator+=(difference_type n)
        requires random_access_range<V>
    {
        __cur += n;
        return *this;
    }
    constexpr Iterator &operator-=(difference_type n)
        requires random_access_range<V>
    {
        __cur -= n;
        return *this;
    }
    constexpr reference operator[](difference_type n) const
        requires random_access_range<V>
    {
        return std::invoke(*__parent->__fn, __cur[n]);
    }

    friend constexpr Iterator operator+(Iterator i, difference_type n)
        requires random_access_range<V>
    {
        i += n;
        return i;
    }
    friend constexpr Iterator operator+(difference_type n, Iterator i)
        requires random_access_range<V>
    {
        i += n;
        return i;
    }
    friend constexpr Iterator operator-(Iterator i, difference_type n)
        requires random_access_range<V>
    {
        i -= n;
        return i;
    }
    friend constexpr difference_type operator-(const Iterator &a,
                                               const Iterator &b)
        requires sized_sentinel_for<iterator_t<V>, iterator_t<V>>
    {
        return a.__cur - b.__cur;
    }

    friend constexpr bool operator==(const Iterator &a, const Iterator &b)
        requires equality_comparable<iterator_t<V>>
    {
        return a.__cur == b.__cur;
    }
    friend constexpr auto operator<=>(const Iterator &a, const Iterator &b)
        requires random_access_range<V> && three_way_comparable<iterator_t<V>>
    {
        return a.__cur <=> b.__cur;
    }
};

template <input_range V, typename F>
    requires view<V> && is_object_v<F> &&
             regular_invocable<F &, range_reference_t<V>> &&
             requires {
                 typename remove_cvref_t<invoke_result_t<F &,
                                                         range_reference_t<V>>>;
             }
struct transform_view<V, F>::Sentinel {
    sentinel_t<V> __end = sentinel_t<V>();

    Sentinel() = default;
    constexpr explicit Sentinel(transform_view &p)
        : __end(ranges::end(p.__base))
    {
    }
    constexpr sentinel_t<V> base() const { return __end; }

    friend constexpr bool operator==(const Iterator &i, const Sentinel &s)
    {
        return i.__cur == s.__end;
    }
    friend constexpr range_difference_t<V> operator-(const Iterator &i,
                                                     const Sentinel &s)
        requires sized_sentinel_for<sentinel_t<V>, iterator_t<V>>
    {
        return i.__cur - s.__end;
    }
    friend constexpr range_difference_t<V> operator-(const Sentinel &s,
                                                     const Iterator &i)
        requires sized_sentinel_for<sentinel_t<V>, iterator_t<V>>
    {
        return s.__end - i.__cur;
    }
};

namespace views {

struct Transform {
    template <viewable_range R, typename F>
    constexpr auto operator()(R &&r, F &&f) const
    {
        return transform_view<all_t<R>, remove_cvref_t<F>>(
            all(std::forward<R>(r)), std::forward<F>(f));
    }
    template <typename F>
        requires(!viewable_range<remove_cvref_t<F>>)
    constexpr auto operator()(F &&f) const
    {
        return RangeAdaptorPartial<Transform, remove_cvref_t<F>>(
            Transform{}, std::forward<F>(f));
    }
};

inline constexpr Transform transform{};

} // namespace views

// subrange's get lives in std::ranges so structured-binding ADL — which
// searches only the class's own namespace — finds it.
template <size_t Index, typename I, typename S, subrange_kind K>
    requires(Index < 2)
constexpr auto get(const subrange<I, S, K> &r)
{
    if constexpr (Index == 0)
        return r.begin();
    else
        return r.end();
}

} // namespace ranges

