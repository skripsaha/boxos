    template <typename D>
        requires(!viewable_range<remove_cvref_t<D>>)
    constexpr auto operator()(D &&n) const
    {
        return RangeAdaptorPartial<Drop, remove_cvref_t<D>>(
            Drop{}, static_cast<remove_cvref_t<D>>(std::forward<D>(n)));
    }
};

