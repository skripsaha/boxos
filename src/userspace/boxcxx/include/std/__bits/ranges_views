// ── drop_view ([range.drop]) ────────────────────────────────────────────

template <view V>
class drop_view : public view_interface<drop_view<V>> {
    V __base                      = V();
    range_difference_t<V> __count = 0;

    template <typename Base>
    static constexpr auto __MakeBegin(Base &b, range_difference_t<V> count)
    {
        if constexpr (random_access_range<Base> && sized_range<Base>) {
            auto sz = static_cast<range_difference_t<V>>(ranges::size(b));
            return ranges::begin(b) + (count < sz ? count : sz);
        } else {
            auto it = ranges::begin(b);
            auto e  = ranges::end(b);
            for (auto n = count; n > 0 && it != e; --n) ++it;
            return it;
        }
    }

public:
    drop_view()
        requires default_initializable<V>
    = default;
    constexpr drop_view(V base, range_difference_t<V> count)
        : __base(std::move(base)), __count(count)
    {
    }

    constexpr V base() const &
        requires copy_constructible<V>
    {
        return __base;
    }
    constexpr V base() && { return std::move(__base); }

    constexpr auto begin() { return __MakeBegin(__base, __count); }
    constexpr auto begin() const
        requires range<const V>
    {
        return __MakeBegin(__base, __count);
    }
    constexpr auto end() { return ranges::end(__base); }
    constexpr auto end() const
        requires range<const V>
    {
        return ranges::end(__base);
    }

    constexpr auto size()
        requires sized_range<V>
    {
        auto n = ranges::size(__base);
        auto c = static_cast<decltype(n)>(__count);
        return n > c ? n - c : static_cast<decltype(n)>(0);
    }
    constexpr auto size() const
        requires sized_range<const V>
    {
        auto n = ranges::size(__base);
        auto c = static_cast<decltype(n)>(__count);
        return n > c ? n - c : static_cast<decltype(n)>(0);
    }
    // P2846R6: the same arithmetic size() does, on the hint instead.
    constexpr auto reserve_hint()
        requires approximately_sized_range<V>
    {
        const auto s = static_cast<range_difference_t<V>>(ranges::reserve_hint(__base));
        return static_cast<make_unsigned_t<range_difference_t<V>>>(s < __count ? 0 : s - __count);
    }
    constexpr auto reserve_hint() const
        requires approximately_sized_range<const V>
    {
        const auto s = static_cast<range_difference_t<const V>>(ranges::reserve_hint(__base));
        return static_cast<make_unsigned_t<range_difference_t<const V>>>(
            s < __count ? 0 : s - __count);
    }
};

