// boxcxx — <__bits/format_escape>
//
// [format.string.escaped] — builds the escaped basic_string<CharT> that the
// '?' presentation type copies to the output: quote-delimited for a string,
// apostrophe-delimited for a single character. Pure text transform: reads
// the source, returns a complete string through an out-parameter.
// <format> then feeds that string through its existing FormatString /
// EmitField for width/fill/align/precision, so nothing here ever touches a
// format context.
//
// ── the one thing that differs between the two character types ──────────
// [format.string.escaped] is written over SCALAR VALUES, not code units, so
// the whole classification below — the table, the escape categories, the
// grapheme-extend rule — is code-point work and is shared verbatim. What
// differs is only how a scalar value is READ out of the source:
//
//   char     a UTF-8 code unit sequence, decoded by Utf8Decode, which can
//            fail (a lone continuation byte, an overlong form, a truncated
//            sequence, an encoded surrogate) — 2.2.3's ill-formed case.
//   wchar_t  the unit IS the value, 32 bits of it. It still has an
//            ill-formed case, and it is a real one rather than a formality:
//            a surrogate or anything past U+10FFFF is not a scalar value,
//            and nothing stops a program from putting one in a wstring.
//
// So NextScalar is the only if-constexpr in this file, and everything after
// it is written once. The escape TEXT is ASCII in both worlds and is widened
// on append.
//
// Includes <string>/<string_view> itself, so its position in <format>'s
// include list is not order-sensitive.
#ifndef BOXCXX_BITS_FORMAT_ESCAPE
#define BOXCXX_BITS_FORMAT_ESCAPE

#include <__bits/unicode_escape>
#include <string>
#include <string_view>
#include <type_traits>

namespace std {
namespace __format {

// The UTF-8 decoder the escaping loop drives. It lives here rather
// than in <__bits/unicode_escape> because that file is generated in
// full by tools/gen_unicode_escape.py and would lose any hand-written
// code on the next regeneration -- the generated file holds UCD facts,
// this one holds the algorithm.
// Decodes one UTF-8 code unit sequence starting at p (p != e is a
// precondition). On success, cp is the decoded scalar value — always
// inside [0, 0x10FFFF] and never a surrogate, so it is always safe to pass
// on to NeedsEscapeCategory/IsGraphemeExtend — and p advances past the
// whole sequence. On failure (lone continuation byte, an invalid lead
// byte, a truncated or mis-continued sequence, an overlong encoding, or a
// surrogate-range result), cp is set to the first code unit's value and p
// advances by exactly one byte, so a caller that keeps calling this in a
// loop recovers one bad byte at a time, in order
// ([format.string.escaped]/2.2.3).
//
// The legal range of the byte right after the lead is narrowed for
// E0/ED/F0/F4 (Unicode's Table 3-7, "Well-Formed UTF-8 Byte Sequences");
// that alone is what keeps overlong encodings and UTF-8-encoded surrogates
// out of a well-formed result, with no separate range check needed once
// the value is assembled.
constexpr bool Utf8Decode(const char *&p, const char *e, char32_t &cp) noexcept
{
    const unsigned char lead = static_cast<unsigned char>(*p);

    if (lead < 0x80) {
        cp = lead;
        ++p;
        return true;
    }

    unsigned len;
    char32_t value;
    unsigned char lo = 0x80, hi = 0xBF;  // legal range of the byte after the lead

    if (lead >= 0xC2 && lead <= 0xDF) {
        len   = 2;
        value = char32_t(lead & 0x1F);
    } else if (lead >= 0xE0 && lead <= 0xEF) {
        len   = 3;
        value = char32_t(lead & 0x0F);
        if (lead == 0xE0) lo = 0xA0;
        else if (lead == 0xED) hi = 0x9F;
    } else if (lead >= 0xF0 && lead <= 0xF4) {
        len   = 4;
        value = char32_t(lead & 0x07);
        if (lead == 0xF0) lo = 0x90;
        else if (lead == 0xF4) hi = 0x8F;
    } else {
        // lone continuation byte, overlong lead 0xC0/0xC1, or invalid lead
        // 0xF5..0xFF.
        cp = lead;
        ++p;
        return false;
    }

    const char *q = p + 1;
    for (unsigned i = 1; i < len; ++i) {
        if (q == e) {
            cp = lead;
            ++p;
            return false;
        }
        const unsigned char b = static_cast<unsigned char>(*q);
        if (b < lo || b > hi) {
            cp = lead;
            ++p;
            return false;
        }
        value = (value << 6) | char32_t(b & 0x3F);
        lo = 0x80;  // only the byte right after the lead is range-restricted
        hi = 0xBF;
        ++q;
    }

    cp = value;
    p  = q;
    return true;
}

// Read one [format.string.escaped]/2.2 unit out of the source. Same contract
// as Utf8Decode for both character types: true means cp is a scalar value and
// p advanced past the whole sequence; false means the unit at the ORIGINAL p
// is ill-formed, cp carries that unit's own value for the \x{} escape, and p
// advanced by exactly one unit so the caller recovers in order.
//
// The wide branch is not the trivial one it looks like. wchar_t here is a
// signed 32-bit type, so the range test is written on the unsigned value:
// a negative unit is past 0x10FFFF once read as a magnitude, which is the
// right answer, and reading it as a signed compare would have let it pass.
template <class CharT>
constexpr bool NextScalar(const CharT *&p, const CharT *e, char32_t &cp) noexcept
{
    if constexpr (is_same_v<CharT, char>) {
        return Utf8Decode(p, e, cp);
    } else {
        (void)e;
        const auto v = static_cast<make_unsigned_t<CharT>>(*p);
        ++p;
        cp = char32_t(v);
        return v <= 0x10FFFFu && !(v >= 0xD800u && v <= 0xDFFFu);
    }
}

// The escape text is ASCII wherever it appears, and ASCII is its own code
// point, so widening is the cast and not a conversion. Spelt through
// unsigned char because the source characters here come from narrow literals
// and a signed char would sign-extend — the defect Ф42-f found in <ios>'s
// widen(), which is the reason this is a named helper rather than an
// open-coded cast at each of the six append sites.
template <class CharT> inline void PutAscii(basic_string<CharT> &out, char c)
{
    out += CharT(static_cast<unsigned char>(c));
}
template <class CharT>
inline void PutAscii(basic_string<CharT> &out, const char *s)
{
    for (; *s; ++s) PutAscii(out, *s);
}

// Table 114 — the two-character escape for one of the five characters
// [format.string.escaped] maps directly. Returns false for everything else.
template <class CharT>
inline bool EscapeTableChar(basic_string<CharT> &out, char32_t cp)
{
    switch (cp) {
    case U'\t': PutAscii(out, "\\t"); return true;
    case U'\n': PutAscii(out, "\\n"); return true;
    case U'\r': PutAscii(out, "\\r"); return true;
    case U'"':  PutAscii(out, "\\\""); return true;
    case U'\\': PutAscii(out, "\\\\"); return true;
    default: return false;
    }
}

// Appends \prefix{hex}: lowercase hex digits, no leading zeros (D7).
template <class CharT>
inline void EscapeHex(basic_string<CharT> &out, char prefix, char32_t value)
{
    char     digits[8];
    unsigned n = 0;
    do {
        const unsigned nibble = unsigned(value & 0xF);
        digits[n++] = char(nibble < 10 ? '0' + nibble : 'a' + (nibble - 10));
        value >>= 4;
    } while (value != 0);
    PutAscii(out, '\\');
    PutAscii(out, prefix);
    PutAscii(out, '{');
    while (n > 0) PutAscii(out, digits[--n]);
    PutAscii(out, '}');
}

// Classifies and appends exactly one [format.string.escaped]/2.2 unit
// starting at p (p != e is a precondition): a whole scalar value (table
// escape, \u{} escape, or a raw copy) when NextScalar succeeds, otherwise
// the complete run of ill-formed code units at *p — NextScalar only ever
// recovers one unit per call, so the run ends the moment a well-formed
// unit follows. Advances p past whatever it consumed and updates
// prevEscaped per 2.2.1.2.2: reset to true exactly once per ill-formed
// run, not once per code unit inside it (this only matters if NextScalar
// is ever changed to recover more than one unit at a time).
template <class CharT>
inline void EscapeUnit(basic_string<CharT> &out, const CharT *&p, const CharT *e,
                       bool &prevEscaped)
{
    const CharT *start = p;
    char32_t     cp;
    if (NextScalar(p, e, cp)) {
        if (EscapeTableChar(out, cp)) {
            prevEscaped = true;
        } else if (cp != U' ' && __unicode::NeedsEscapeCategory(cp)) {
            EscapeHex(out, 'u', cp);
            prevEscaped = true;
        } else if (prevEscaped && __unicode::IsGraphemeExtend(cp)) {
            EscapeHex(out, 'u', cp);
            prevEscaped = true;
        } else {
            out.append(start, size_t(p - start));
            prevEscaped = false;
        }
        return;
    }

    EscapeHex(out, 'x', cp);
    for (;;) {
        if (p == e) break;
        const CharT *attempt = p;
        char32_t     peek;
        if (NextScalar(attempt, e, peek)) break;  // run ends here
        EscapeHex(out, 'x', peek);
        p = attempt;
    }
    prevEscaped = true;
}

// [format.string.escaped]/2 — the quote-delimited escaped representation
// of a string.
template <class CharT>
inline void EscapeInto(basic_string<CharT> &out, basic_string_view<CharT> s)
{
    PutAscii(out, '"');
    const CharT *p = s.data();
    const CharT *e = p + s.size();
    bool         prevEscaped = true;
    while (p != e) EscapeUnit(out, p, e, prevEscaped);
    PutAscii(out, '"');
}

// [format.string.escaped]/3 — the apostrophe-delimited escaped
// representation of a single character, with the apostrophe/quote
// asymmetry of 3.2/3.3 (which both take priority over the table: an
// apostrophe is escaped here even though it has no Table 114 entry, and a
// quote is left raw even though Table 114 maps it for the string form).
template <class CharT> inline void EscapeChar(basic_string<CharT> &out, CharT c)
{
    PutAscii(out, '\'');
    if (c == CharT('\'')) {
        PutAscii(out, "\\'");
    } else if (c == CharT('"')) {
        PutAscii(out, '"');
    } else {
        const CharT *p           = &c;
        bool         prevEscaped = true;  // a lone character has no real predecessor
        EscapeUnit(out, p, &c + 1, prevEscaped);
    }
    PutAscii(out, '\'');
}

} // namespace __format
} // namespace std

#endif // BOXCXX_BITS_FORMAT_ESCAPE
