// boxcxx — <__bits/allocator_core>
// std::allocator + allocator_traits + construct_at/destroy machinery.
// Lives in __bits so Ф7A containers can use it before Ф8's <memory>
// re-exports the full surface. allocator rides the boxcxx operator new
// set (heap = boxlib malloc_impl), including the align_val_t forms for
// over-aligned value types.
#ifndef BOXCXX_BITS_ALLOCATOR_CORE
#define BOXCXX_BITS_ALLOCATOR_CORE

#include <cstddef>
#include <new>
#include <type_traits>
#include <utility>

namespace std {

// ── addressof / construct_at / destroy ─────────────────────────────────

template <typename T>
constexpr T *addressof(T &r) noexcept
{
    return __builtin_addressof(r);
}
template <typename T>
const T *addressof(const T &&) = delete;

template <typename T, typename... Args>
constexpr T *construct_at(T *p, Args &&...args)
{
    return ::new (static_cast<void *>(p)) T(std::forward<Args>(args)...);
}

template <typename T>
constexpr void destroy_at(T *p)
{
    if constexpr (is_array_v<T>) {
        for (auto &elem : *p) destroy_at(addressof(elem));
    } else {
        p->~T();
    }
}

template <typename It>
constexpr void destroy(It first, It last)
{
    for (; first != last; ++first) destroy_at(addressof(*first));
}

template <typename It>
constexpr It destroy_n(It first, size_t n)
{
    for (; n > 0; --n, ++first) destroy_at(addressof(*first));
    return first;
}

// ── allocator_arg / uses_allocator ([allocator.tag] / [allocator.uses]) ──

struct allocator_arg_t {
    explicit allocator_arg_t() = default;
};
inline constexpr allocator_arg_t allocator_arg{};

template <typename T, typename Alloc>
struct uses_allocator : false_type {};
template <typename T, typename Alloc>
    requires requires { typename T::allocator_type; }
struct uses_allocator<T, Alloc>
    : bool_constant<is_convertible_v<Alloc, typename T::allocator_type>> {};
template <typename T, typename Alloc>
inline constexpr bool uses_allocator_v = uses_allocator<T, Alloc>::value;

// ── allocation_result ([allocator.traits] / [default.allocator]) ─────────
// The return of the allocate_at_least family: the pointer AND the count
// the allocator actually gave out, which is what makes the "at least"
// worth asking for -- a vector that asks for 100 and is handed 128 can
// use all 128 instead of throwing the slack away. An aggregate by
// mandate, so structured bindings work: auto [p, n] = a.allocate_at_least(k).
template <typename Pointer, typename SizeType = size_t>
struct allocation_result {
    Pointer  ptr;
    SizeType count;
};

// ── std::allocator ──────────────────────────────────────────────────────

template <typename T>
class allocator {
public:
    using value_type      = T;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;
    using propagate_on_container_move_assignment = true_type;

    constexpr allocator() noexcept = default;
    constexpr allocator(const allocator &) noexcept = default;
    template <typename U>
    constexpr allocator(const allocator<U> &) noexcept
    {
    }
    constexpr ~allocator() = default;
    constexpr allocator &operator=(const allocator &) = default;

    [[nodiscard]] constexpr T *allocate(size_type n)
    {
        if (n > size_type(-1) / sizeof(T)) throw bad_array_new_length{};
        if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
            return static_cast<T *>(
                ::operator new(n * sizeof(T), align_val_t{alignof(T)}));
        else
            return static_cast<T *>(::operator new(n * sizeof(T)));
    }

    // The default allocator has no way to learn what the heap rounded the
    // request up to -- boxlib's malloc_impl does not report its bucket
    // size back -- so it hands back exactly what was asked for. That is a
    // conforming answer ([allocator.members]: count >= n), and it is the
    // same answer libstdc++ and libc++ give.
    [[nodiscard]] constexpr allocation_result<T *> allocate_at_least(size_type n)
    {
        return {allocate(n), n};
    }

    constexpr void deallocate(T *p, size_type n)
    {
        if constexpr (alignof(T) > __STDCPP_DEFAULT_NEW_ALIGNMENT__)
            ::operator delete(p, n * sizeof(T), align_val_t{alignof(T)});
        else
            ::operator delete(p, n * sizeof(T));
    }
};

template <typename A, typename B>
constexpr bool operator==(const allocator<A> &, const allocator<B> &) noexcept
{
    return true;
}

// ── allocator_traits ([allocator.traits]) ───────────────────────────────
// Member detection via constrained partial specializations — each
// defaulted typedef is one tiny template instead of void_t gymnastics.

namespace __alloc_impl {

template <typename A, typename D>
struct Pointer {
    using type = D;
};
template <typename A, typename D>
    requires requires { typename A::pointer; }
struct Pointer<A, D> {
    using type = typename A::pointer;
};

template <typename A, typename D>
struct ConstPointer {
    using type = D;
};
template <typename A, typename D>
    requires requires { typename A::const_pointer; }
struct ConstPointer<A, D> {
    using type = typename A::const_pointer;
};

template <typename A, typename D>
struct VoidPointer {
    using type = D;
};
template <typename A, typename D>
    requires requires { typename A::void_pointer; }
struct VoidPointer<A, D> {
    using type = typename A::void_pointer;
};

template <typename A, typename D>
struct ConstVoidPointer {
    using type = D;
};
template <typename A, typename D>
    requires requires { typename A::const_void_pointer; }
struct ConstVoidPointer<A, D> {
    using type = typename A::const_void_pointer;
};

template <typename A>
struct DifferenceType {
    using type = ptrdiff_t;
};
template <typename A>
    requires requires { typename A::difference_type; }
struct DifferenceType<A> {
    using type = typename A::difference_type;
};

template <typename A, typename D>
struct SizeType {
    using type = make_unsigned_t<D>;
};
template <typename A, typename D>
    requires requires { typename A::size_type; }
struct SizeType<A, D> {
    using type = typename A::size_type;
};

template <typename A>
struct Pocca {
    using type = false_type;
};
template <typename A>
    requires requires { typename A::propagate_on_container_copy_assignment; }
struct Pocca<A> {
    using type = typename A::propagate_on_container_copy_assignment;
};

template <typename A>
struct Pocma {
    using type = false_type;
};
template <typename A>
    requires requires { typename A::propagate_on_container_move_assignment; }
struct Pocma<A> {
    using type = typename A::propagate_on_container_move_assignment;
};

template <typename A>
struct Pocs {
    using type = false_type;
};
template <typename A>
    requires requires { typename A::propagate_on_container_swap; }
struct Pocs<A> {
    using type = typename A::propagate_on_container_swap;
};

template <typename A>
struct AlwaysEqual {
    using type = typename is_empty<A>::type;
};
template <typename A>
    requires requires { typename A::is_always_equal; }
struct AlwaysEqual<A> {
    using type = typename A::is_always_equal;
};

template <typename A, typename U>
struct RebindFallback {
};
template <template <typename, typename...> class AT, typename T,
          typename... Rest, typename U>
struct RebindFallback<AT<T, Rest...>, U> {
    using type = AT<U, Rest...>;
};

template <typename A, typename U>
struct Rebind : RebindFallback<A, U> {
};
template <typename A, typename U>
    requires requires { typename A::template rebind<U>::other; }
struct Rebind<A, U> {
    using type = typename A::template rebind<U>::other;
};

} // namespace __alloc_impl

template <typename Alloc>
struct allocator_traits {
    using allocator_type = Alloc;
    using value_type     = typename Alloc::value_type;

    using pointer = typename __alloc_impl::Pointer<Alloc, value_type *>::type;
    using const_pointer =
        typename __alloc_impl::ConstPointer<Alloc, const value_type *>::type;
    using void_pointer = typename __alloc_impl::VoidPointer<Alloc, void *>::type;
    using const_void_pointer =
        typename __alloc_impl::ConstVoidPointer<Alloc, const void *>::type;
    using difference_type = typename __alloc_impl::DifferenceType<Alloc>::type;
    using size_type =
        typename __alloc_impl::SizeType<Alloc, difference_type>::type;

    using propagate_on_container_copy_assignment =
        typename __alloc_impl::Pocca<Alloc>::type;
    using propagate_on_container_move_assignment =
        typename __alloc_impl::Pocma<Alloc>::type;
    using propagate_on_container_swap = typename __alloc_impl::Pocs<Alloc>::type;
    using is_always_equal = typename __alloc_impl::AlwaysEqual<Alloc>::type;

    template <typename U>
    using rebind_alloc = typename __alloc_impl::Rebind<Alloc, U>::type;
    template <typename U>
    using rebind_traits = allocator_traits<rebind_alloc<U>>;

    [[nodiscard]] static constexpr pointer allocate(Alloc &a, size_type n)
    {
        return a.allocate(n);
    }
    [[nodiscard]] static constexpr pointer allocate(Alloc &a, size_type n,
                                                    const_void_pointer hint)
    {
        if constexpr (requires { a.allocate(n, hint); })
            return a.allocate(n, hint);
        else
            return a.allocate(n);
    }

    // Opts the allocator in if it has the member, otherwise synthesises the
    // honest {exactly n} answer -- so callers can always ask, and only
    // allocators that can do better have to say so.
    [[nodiscard]] static constexpr allocation_result<pointer, size_type>
    allocate_at_least(Alloc &a, size_type n)
    {
        if constexpr (requires { a.allocate_at_least(n); })
            return a.allocate_at_least(n);
        else
            return {a.allocate(n), n};
    }

    static constexpr void deallocate(Alloc &a, pointer p, size_type n)
    {
        a.deallocate(p, n);
    }

    template <typename T, typename... Args>
    static constexpr void construct(Alloc &a, T *p, Args &&...args)
    {
        if constexpr (requires { a.construct(p, std::forward<Args>(args)...); })
            a.construct(p, std::forward<Args>(args)...);
        else
            construct_at(p, std::forward<Args>(args)...);
    }

    template <typename T>
    static constexpr void destroy(Alloc &a, T *p)
    {
        if constexpr (requires { a.destroy(p); })
            a.destroy(p);
        else
            destroy_at(p);
    }

    static constexpr size_type max_size(const Alloc &a) noexcept
    {
        if constexpr (requires { a.max_size(); })
            return a.max_size();
        else
            return size_type(-1) / sizeof(value_type);
    }

    static constexpr Alloc select_on_container_copy_construction(const Alloc &a)
    {
        if constexpr (requires { a.select_on_container_copy_construction(); })
            return a.select_on_container_copy_construction();
        else
            return a;
    }
};

// ── allocator-like detection (for CTAD guide disambiguation) ────────────
// A container's deduction guides need to tell an allocator argument apart
// from a comparator/hash argument occupying the same trailing slot (e.g.
// map(from_range_t, R&&, Alloc) vs the Comp-taking guide, both matching a
// 3-argument call). Mirrors the shape every mainstream standard library
// uses for this exact problem (libstdc++: __is_allocator).
template <class A>
concept AllocatorLike = requires(A &a) {
    typename A::value_type;
    a.allocate(size_t{});
};
template <class A>
concept NotAllocatorLike = !AllocatorLike<A>;

} // namespace std

#endif // BOXCXX_BITS_ALLOCATOR_CORE
