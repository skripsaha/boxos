// boxcxx — <__bits/char_traits>
// char_traits for the five character types. Shared by <string_view> and
// <string>. The generic base uses plain loops; the char specialization rides
// two GCC builtins at run time and walks the same loops at compile time --
// see length()/compare() for the measurement that forced the split.
#ifndef BOXCXX_BITS_CHAR_TRAITS
#define BOXCXX_BITS_CHAR_TRAITS

#include <cstddef>
#include <cstdint>
#include <iosfwd>
#include <type_traits>   // is_constant_evaluated

namespace std {

namespace __char_impl {

template <typename C, typename I>
struct TraitsBase {
    using char_type  = C;
    using int_type   = I;
    using pos_type   = fpos<mbstate_t>;
    using off_type   = streamoff;
    using state_type = mbstate_t;

    static constexpr void assign(char_type &dst, const char_type &src) noexcept
    {
        dst = src;
    }
    static constexpr bool eq(char_type a, char_type b) noexcept
    {
        return a == b;
    }
    static constexpr bool lt(char_type a, char_type b) noexcept
    {
        return a < b;
    }

    static constexpr int compare(const char_type *a, const char_type *b,
                                 size_t n)
    {
        for (size_t i = 0; i < n; ++i) {
            if (lt(a[i], b[i])) return -1;
            if (lt(b[i], a[i])) return 1;
        }
        return 0;
    }

    static constexpr size_t length(const char_type *s)
    {
        size_t n = 0;
        while (!eq(s[n], char_type())) ++n;
        return n;
    }

    static constexpr const char_type *find(const char_type *s, size_t n,
                                           const char_type &c)
    {
        for (size_t i = 0; i < n; ++i)
            if (eq(s[i], c)) return s + i;
        return nullptr;
    }

    // Which way to walk is decided by "is dst above src", and that question
    // has two legal forms. At run time it is one address comparison. During
    // constant evaluation a relational comparison of pointers into different
    // objects is not a constant expression at all, so the overlap is found
    // with the one comparison that is -- equality: dst sits above src exactly
    // when some destination element IS the last source element. Ranges that
    // do not overlap answer false and are copied forward, which is correct
    // for them either way.
    static constexpr bool DstAboveSrc(const char_type *dst,
                                      const char_type *src, size_t n)
    {
        if (is_constant_evaluated()) {
            const char_type *last = src + (n - 1);
            for (size_t i = 0; i < n; ++i)
                if (dst + i == last) return true;
            return false;
        }
        return !(dst < src);
    }

    static constexpr char_type *move(char_type *dst, const char_type *src,
                                     size_t n)
    {
        if (dst == src || n == 0) return dst;
        if (!DstAboveSrc(dst, src, n)) {
            for (size_t i = 0; i < n; ++i) dst[i] = src[i];
        } else {
            for (size_t i = n; i > 0; --i) dst[i - 1] = src[i - 1];
        }
        return dst;
    }

    static constexpr char_type *copy(char_type *dst, const char_type *src,
                                     size_t n)
    {
        for (size_t i = 0; i < n; ++i) dst[i] = src[i];
        return dst;
    }

    static constexpr char_type *assign(char_type *dst, size_t n, char_type c)
    {
        for (size_t i = 0; i < n; ++i) dst[i] = c;
        return dst;
    }

    static constexpr int_type to_int_type(char_type c) noexcept
    {
        return static_cast<int_type>(c);
    }
    static constexpr char_type to_char_type(int_type i) noexcept
    {
        return static_cast<char_type>(i);
    }
    static constexpr bool eq_int_type(int_type a, int_type b) noexcept
    {
        return a == b;
    }
    static constexpr int_type not_eof(int_type i) noexcept
    {
        return eq_int_type(i, eof()) ? 0 : i;
    }
    static constexpr int_type eof() noexcept
    {
        return static_cast<int_type>(-1);
    }
};

} // namespace __char_impl

template <typename C>
struct char_traits;

template <>
struct char_traits<char> : __char_impl::TraitsBase<char, int> {
    // char compares as UNSIGNED ([char.traits.specializations.char]).
    static constexpr bool lt(char a, char b) noexcept
    {
        return static_cast<unsigned char>(a) < static_cast<unsigned char>(b);
    }
    // Both builtins are folded by GCC only over storage it can see through:
    // string literals, static objects, automatic arrays. Over the storage
    // std::allocator hands out DURING constant evaluation it folds neither
    // (measured on x86_64-elf-g++ 15.2.0: "'__builtin_strlen(((const char*)(&
    // heap )))' is not a constant expression"). That is not a corner: it is
    // every character a constexpr basic_string ever owns, and it already bit
    // basic_string_view -- a view built over allocator storage was not a
    // constant expression here while it is one in both mainstream libraries.
    // So the constant-evaluated path walks and the run-time path keeps the
    // builtin, which is where the generated code is worth caring about.
    static constexpr int compare(const char *a, const char *b, size_t n)
    {
        if (n == 0) return 0;
        if (is_constant_evaluated()) {
            for (size_t i = 0; i < n; ++i) {
                if (lt(a[i], b[i])) return -1;
                if (lt(b[i], a[i])) return 1;
            }
            return 0;
        }
        return __builtin_memcmp(a, b, n);
    }
    static constexpr size_t length(const char *s)
    {
        if (is_constant_evaluated()) {
            size_t n = 0;
            while (s[n] != '\0') ++n;
            return n;
        }
        return __builtin_strlen(s);
    }
    // __builtin_memchr lowers to a real `call memchr` on this target once
    // n is not a compile-time constant -- no memchr exists under boxcxx's
    // -nostdlib link. A plain loop is constexpr-safe AND link-safe, so it
    // is used unconditionally (no is_constant_evaluated() split needed).
    static constexpr const char *find(const char *s, size_t n, const char &c)
    {
        for (size_t i = 0; i < n; ++i)
            if (s[i] == c) return s + i;
        return nullptr;
    }
    static constexpr int to_int_type(char c) noexcept
    {
        return static_cast<unsigned char>(c);
    }
};

template <>
struct char_traits<wchar_t>
    : __char_impl::TraitsBase<wchar_t, unsigned int> {
    static constexpr unsigned int eof() noexcept { return 0xFFFFFFFFu; }
    static constexpr unsigned int not_eof(unsigned int i) noexcept
    {
        return i == eof() ? 0 : i;
    }
};

template <>
struct char_traits<char8_t>
    : __char_impl::TraitsBase<char8_t, unsigned int> {
    static constexpr unsigned int eof() noexcept { return 0xFFFFFFFFu; }
    static constexpr unsigned int not_eof(unsigned int i) noexcept
    {
        return i == eof() ? 0 : i;
    }
};

template <>
struct char_traits<char16_t>
    : __char_impl::TraitsBase<char16_t, uint_least16_t> {
    static constexpr uint_least16_t eof() noexcept { return 0xFFFFu; }
    static constexpr uint_least16_t not_eof(uint_least16_t i) noexcept
    {
        return i == eof() ? 0 : i;
    }
};

template <>
struct char_traits<char32_t>
    : __char_impl::TraitsBase<char32_t, uint_least32_t> {
    static constexpr uint_least32_t eof() noexcept { return 0xFFFFFFFFu; }
    static constexpr uint_least32_t not_eof(uint_least32_t i) noexcept
    {
        return i == eof() ? 0 : i;
    }
};

} // namespace std

#endif // BOXCXX_BITS_CHAR_TRAITS
