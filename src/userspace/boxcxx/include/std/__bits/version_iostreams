// boxcxx — <__bits/version_iostreams>
//
// The __cpp_lib_* feature-test macros [version.syn] owned jointly by
// <ios>/<streambuf>/<ostream>/<istream>/<sstream>/<iomanip> -- split out
// for the same [support.limits.general] per-header reason as
// <__bits/version_numeric>/<__bits/version_any> -- see those files'
// comments.
//
// Ф30e commit 1 (ios_base/basic_ios/basic_streambuf): openmode::noreplace
// (P2467R1) is a real enumerator now -- __cpp_lib_ios_noreplace.
// Ф30e commit 4 (sstream stream-wrapper classes + new <iomanip>): quoted
// is a real, complete [quoted.manip] facility -- __cpp_lib_quoted_string_io.
//
// Ф32a: __cpp_lib_sstream_from_string_view is the first C++26 macro this
// library claims, and it is claimed unconditionally -- see <version>'s
// preamble for the whole policy. P2495R3 is complete here: all three
// string_view-like constructors (t / t+which / t+allocator) and the str(t)
// setter, on basic_stringbuf and on all three stream wrappers.
//
// Every block below is gated on BOXCXX_OWNS_<stem>, and this file has NO
// include guard: it is meant to be included once per owning header, each time
// defining only what that header declared it owns. [support.limits.general]
// says a macro is defined by <version> AND by the header that provides the
// feature; it does not say every header that happens to include this leaf.
// A header that answers for a feature it does not provide is answering a
// question it was not asked, so it no longer does. <version> defines
// BOXCXX_OWNS_ALL and takes the lot. Checked by tools/cxx_ftm_audit.sh.

#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_ios_noreplace)) && \
    !defined(__cpp_lib_ios_noreplace)
#  define __cpp_lib_ios_noreplace 202207L
#endif
#undef BOXCXX_OWNS_ios_noreplace
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_quoted_string_io)) && \
    !defined(__cpp_lib_quoted_string_io)
#  define __cpp_lib_quoted_string_io 201304L
#endif
#undef BOXCXX_OWNS_quoted_string_io
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_sstream_from_string_view)) && \
    !defined(__cpp_lib_sstream_from_string_view)
#  define __cpp_lib_sstream_from_string_view 202306L
#endif
#undef BOXCXX_OWNS_sstream_from_string_view
// Ф36: <fstream> exists, and its native handle is the thing a BoxOS program
// can actually use for more than a stream does -- the Current itself, not an
// fd, because BoxOS has no descriptor table. P1759R6.
#if (defined(BOXCXX_OWNS_ALL) || defined(BOXCXX_OWNS_fstream_native_handle)) && \
    !defined(__cpp_lib_fstream_native_handle)
#  define __cpp_lib_fstream_native_handle 202306L
#endif
#undef BOXCXX_OWNS_fstream_native_handle
