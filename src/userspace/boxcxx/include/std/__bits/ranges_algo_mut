struct Unique {
    template <permutable I, sentinel_for<I> S, class Proj = identity,
              indirect_equivalence_relation<projected<I, Proj>> C =
                  ranges::equal_to>
    constexpr subrange<I> operator()(I first, S last, C comp = {},
                                     Proj proj = {}) const
    {
        if (first == last) return {first, first};
        I result = first;
        I i      = first;
        while (++i != last) {
            if (!std::invoke(comp, std::invoke(proj, *result),
                             std::invoke(proj, *i))) {
                ++result;
                if (result != i) *result = ranges::iter_move(i);
            }
        }
        ++result;
        return {std::move(result), std::move(i)};
    }
    template <forward_range R, class Proj = identity,
              indirect_equivalence_relation<projected<iterator_t<R>, Proj>> C =
                  ranges::equal_to>
        requires permutable<iterator_t<R>>
    constexpr borrowed_subrange_t<R> operator()(R &&r, C comp = {},
                                                Proj proj = {}) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::move(comp),
                       std::move(proj));
    }
};
inline constexpr Unique unique{};

struct UniqueCopy {
    template <input_iterator I, sentinel_for<I> S, weakly_incrementable O,
              class Proj = identity,
              indirect_equivalence_relation<projected<I, Proj>> C =
                  ranges::equal_to>
        requires indirectly_copyable<I, O> &&
                 (forward_iterator<I> ||
                  (input_iterator<O> &&
                   same_as<iter_value_t<I>, iter_value_t<O>>) ||
                  indirectly_copyable_storable<I, O>)
    constexpr unique_copy_result<I, O> operator()(I first, S last, O result,
                                                  C comp = {},
                                                  Proj proj = {}) const
    {
        if (first == last) return {std::move(first), std::move(result)};
        if constexpr (forward_iterator<I>) {
            I prev   = first;
            *result  = *prev;
            ++result;
            while (++first != last)
                if (!std::invoke(comp, std::invoke(proj, *prev),
                                 std::invoke(proj, *first))) {
                    *result = *first;
                    ++result;
                    prev = first;
                }
        } else if constexpr (input_iterator<O> &&
                             same_as<iter_value_t<I>, iter_value_t<O>>) {
            *result = *first;
            while (++first != last)
                if (!std::invoke(comp, std::invoke(proj, *result),
                                 std::invoke(proj, *first))) {
                    ++result;
                    *result = *first;
                }
            ++result;
        } else {
            iter_value_t<I> val(*first);
            *result = val;
            ++result;
            while (++first != last)
                if (!std::invoke(comp, std::invoke(proj, val),
                                 std::invoke(proj, *first))) {
                    val     = *first;
                    *result = val;
                    ++result;
                }
        }
        return {std::move(first), std::move(result)};
    }
    template <input_range R, weakly_incrementable O, class Proj = identity,
              indirect_equivalence_relation<projected<iterator_t<R>, Proj>> C =
                  ranges::equal_to>
        requires indirectly_copyable<iterator_t<R>, O> &&
                 (forward_iterator<iterator_t<R>> ||
                  (input_iterator<O> &&
                   same_as<range_value_t<R>, iter_value_t<O>>) ||
                  indirectly_copyable_storable<iterator_t<R>, O>)
    constexpr unique_copy_result<borrowed_iterator_t<R>, O>
    operator()(R &&r, O result, C comp = {}, Proj proj = {}) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::move(result),
                       std::move(comp), std::move(proj));
    }
};
inline constexpr UniqueCopy unique_copy{};

// ════════════════════════════════════════════════════════════════════════
// reverse / reverse_copy ([alg.reverse])
// ════════════════════════════════════════════════════════════════════════

struct Reverse {
    template <bidirectional_iterator I, sentinel_for<I> S>
        requires permutable<I>
    constexpr I operator()(I first, S last) const
    {
        I tail   = ranges::next(first, last);
        I result = tail;
        for (;;) {
            if (first == tail) break;
            --tail;
            if (first == tail) break;
            ranges::iter_swap(first, tail);
            ++first;
        }
        return result;
    }
    template <bidirectional_range R>
        requires permutable<iterator_t<R>>
    constexpr borrowed_iterator_t<R> operator()(R &&r) const
    {
        return (*this)(ranges::begin(r), ranges::end(r));
    }
};
inline constexpr Reverse reverse{};

struct ReverseCopy {
    template <bidirectional_iterator I, sentinel_for<I> S,
              weakly_incrementable O>
        requires indirectly_copyable<I, O>
    constexpr reverse_copy_result<I, O> operator()(I first, S last,
                                                   O result) const
    {
        I last_it = ranges::next(first, last);
        I cur     = last_it;
        while (cur != first) {
            --cur;
            *result = *cur;
            ++result;
        }
        return {std::move(last_it), std::move(result)};
    }
    template <bidirectional_range R, weakly_incrementable O>
        requires indirectly_copyable<iterator_t<R>, O>
    constexpr reverse_copy_result<borrowed_iterator_t<R>, O>
    operator()(R &&r, O result) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::move(result));
    }
};
inline constexpr ReverseCopy reverse_copy{};

// ════════════════════════════════════════════════════════════════════════
// rotate / rotate_copy ([alg.rotate]) — rotate delegates to the tested classic
// ════════════════════════════════════════════════════════════════════════

struct Rotate {
    template <permutable I, sentinel_for<I> S>
    constexpr subrange<I> operator()(I first, I middle, S last) const
    {
        I last_it = ranges::next(first, last);
        I np      = std::rotate(std::move(first), std::move(middle), last_it);
        return {std::move(np), std::move(last_it)};
    }
    template <forward_range R>
        requires permutable<iterator_t<R>>
    constexpr borrowed_subrange_t<R> operator()(R &&r, iterator_t<R> middle) const
    {
        return (*this)(ranges::begin(r), std::move(middle), ranges::end(r));
    }
};
inline constexpr Rotate rotate{};

struct RotateCopy {
    template <forward_iterator I, sentinel_for<I> S, weakly_incrementable O>
        requires indirectly_copyable<I, O>
    constexpr rotate_copy_result<I, O> operator()(I first, I middle, S last,
                                                  O result) const
    {
        auto c1 = ranges::copy(middle, std::move(last), std::move(result));
        auto c2 = ranges::copy(std::move(first), std::move(middle),
                               std::move(c1.out));
        return {std::move(c1.in), std::move(c2.out)};
    }
    template <forward_range R, weakly_incrementable O>
        requires indirectly_copyable<iterator_t<R>, O>
    constexpr rotate_copy_result<borrowed_iterator_t<R>, O>
    operator()(R &&r, iterator_t<R> middle, O result) const
    {
        return (*this)(ranges::begin(r), std::move(middle), ranges::end(r),
                       std::move(result));
    }
};
inline constexpr RotateCopy rotate_copy{};

// ════════════════════════════════════════════════════════════════════════
// shift_left / shift_right ([alg.shift])
// shift_left is a direct forward move; shift_right delegates to the classic on
// bidirectional iterators and uses a forward-safe leapfrog otherwise.
// ════════════════════════════════════════════════════════════════════════

struct ShiftLeft {
    template <permutable I, sentinel_for<I> S>
    constexpr subrange<I> operator()(I first, S last,
                                     iter_difference_t<I> n) const
    {
        if (n <= 0) {
            I e = ranges::next(first, last);
            return {std::move(first), std::move(e)};
        }
        I mid = first;
        for (iter_difference_t<I> i = 0; i < n; ++i) {
            if (mid == last) return {first, first};
            ++mid;
        }
        auto res = ranges::move(std::move(mid), std::move(last), first);
        return {std::move(first), std::move(res.out)};
    }
    template <forward_range R>
        requires permutable<iterator_t<R>>
    constexpr borrowed_subrange_t<R> operator()(R &&r,
                                                range_difference_t<R> n) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), n);
    }
};
inline constexpr ShiftLeft shift_left{};

struct ShiftRight {
    template <permutable I, sentinel_for<I> S>
    constexpr subrange<I> operator()(I first, S last,
                                     iter_difference_t<I> n) const
    {
        I last_it = ranges::next(first, last);
        if (n <= 0) return {std::move(first), std::move(last_it)};
        if constexpr (bidirectional_iterator<I>) {
            I np = std::shift_right(first, last_it, n);
            return {std::move(np), std::move(last_it)};
        } else {
            // Forward leapfrog: advance `result` to first+n (detecting n≥size),
            // then swap a rolling window of width n forward so the survivors
            // land at [first+n, last). Exactly (size−n) swaps.
            I result = first;
            for (iter_difference_t<I> k = 0; k < n; ++k) {
                if (result == last_it) return {last_it, last_it};
                ++result;
            }
            I lead  = result;
            I trail = first;
            while (lead != last_it) {
                ranges::iter_swap(trail, lead);
                ++trail;
                ++lead;
                if (trail == result) trail = first;
            }
            return {std::move(result), std::move(last_it)};
        }
    }
    template <forward_range R>
        requires permutable<iterator_t<R>>
    constexpr borrowed_subrange_t<R> operator()(R &&r,
                                                range_difference_t<R> n) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), n);
    }
};
inline constexpr ShiftRight shift_right{};

// ════════════════════════════════════════════════════════════════════════
// sample / shuffle ([alg.random.sample]/[alg.random.shuffle])
// ════════════════════════════════════════════════════════════════════════

namespace __algo {

// Unbiased uniform integer in [0, bound) (bound ≥ 1) from a uniform random bit
// generator. 128-bit accumulation keeps any 64-bit generator span combined with
// any 63-bit bound overflow-free: build a positional number base-(generator
// span) wide enough to cover bound, then reject the top partial bucket.
template <class Gen>
unsigned long long BoundedRand(Gen &g, unsigned long long bound)
{
    using GR       = invoke_result_t<Gen &>;
    const GR gmin  = Gen::min();
    using W        = unsigned __int128;
    const W span   = static_cast<W>(static_cast<GR>(Gen::max() - gmin)) + 1;
    const W b      = bound;
    if (b <= 1) return 0;
    W acc   = static_cast<W>(static_cast<GR>(g() - gmin));
    W range = span;
    while (range < b) {
        acc   = acc * span + static_cast<W>(static_cast<GR>(g() - gmin));
        range = range * span;
    }
    const W buckets = range / b;
    const W limit   = buckets * b;
    while (acc >= limit) {
        acc   = static_cast<W>(static_cast<GR>(g() - gmin));
        range = span;
        while (range < b) {
            acc   = acc * span + static_cast<W>(static_cast<GR>(g() - gmin));
            range = range * span;
        }
    }
    return static_cast<unsigned long long>(acc / buckets);
}

} // namespace __algo

struct Sample {
    template <input_iterator I, sentinel_for<I> S, weakly_incrementable O,
              class Gen>
        requires (forward_iterator<I> || random_access_iterator<O>) &&
                 indirectly_copyable<I, O> &&
                 uniform_random_bit_generator<remove_reference_t<Gen>>
    O operator()(I first, S last, O out, iter_difference_t<I> n, Gen &&g) const
    {
        if constexpr (forward_iterator<I>) {
            // Selection sampling (Knuth S): output preserves input order; O need
            // not be random-access.
            auto pop = ranges::distance(first, last);
            if (n > pop) n = pop;
            while (n > 0) {
                if (static_cast<iter_difference_t<I>>(__algo::BoundedRand(
                        g, static_cast<unsigned long long>(pop))) < n) {
                    *out = *first;
                    ++out;
                    --n;
                }
                --pop;
                ++first;
            }
            return out;
        } else {
            // Reservoir sampling into out[0, n); requires random-access O.
            iter_difference_t<I> sz = 0;
            for (; first != last && sz < n; ++first, ++sz) out[sz] = *first;
            iter_difference_t<I> pop = sz;
            for (; first != last; ++first) {
                ++pop;
                auto j = static_cast<iter_difference_t<I>>(
                    __algo::BoundedRand(g, static_cast<unsigned long long>(pop)));
                if (j < n) out[j] = *first;
            }
            return out + sz;
        }
    }
    template <input_range R, weakly_incrementable O, class Gen>
        requires (forward_range<R> || random_access_iterator<O>) &&
                 indirectly_copyable<iterator_t<R>, O> &&
                 uniform_random_bit_generator<remove_reference_t<Gen>>
    O operator()(R &&r, O out, range_difference_t<R> n, Gen &&g) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::move(out), n,
                       std::forward<Gen>(g));
    }
};
inline constexpr Sample sample{};

struct Shuffle {
    template <random_access_iterator I, sentinel_for<I> S, class Gen>
        requires permutable<I> &&
                 uniform_random_bit_generator<remove_reference_t<Gen>>
    I operator()(I first, S last, Gen &&g) const
    {
        I last_it   = ranges::next(first, last);
        auto extent = last_it - first;
        for (auto i = extent - 1; i > 0; --i) {
            auto j = static_cast<iter_difference_t<I>>(
                __algo::BoundedRand(g, static_cast<unsigned long long>(i) + 1));
            ranges::iter_swap(first + i, first + j);
        }
        return last_it;
    }
    template <random_access_range R, class Gen>
        requires permutable<iterator_t<R>> &&
                 uniform_random_bit_generator<remove_reference_t<Gen>>
    borrowed_iterator_t<R> operator()(R &&r, Gen &&g) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::forward<Gen>(g));
    }
};
inline constexpr Shuffle shuffle{};

