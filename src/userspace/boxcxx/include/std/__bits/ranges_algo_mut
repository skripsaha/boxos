// move / move_backward ([alg.move]) — via ranges::iter_move
// ════════════════════════════════════════════════════════════════════════

struct Move {
    template <input_iterator I, sentinel_for<I> S, weakly_incrementable O>
        requires indirectly_movable<I, O>
    constexpr move_result<I, O> operator()(I first, S last, O result) const
    {
        for (; first != last; ++first, ++result)
            *result = ranges::iter_move(first);
        return {std::move(first), std::move(result)};
    }
    template <input_range R, weakly_incrementable O>
        requires indirectly_movable<iterator_t<R>, O>
    constexpr move_result<borrowed_iterator_t<R>, O> operator()(R &&r,
                                                                O result) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::move(result));
    }
};
inline constexpr Move move{};

struct MoveBackward {
    template <bidirectional_iterator I1, sentinel_for<I1> S1,
              bidirectional_iterator I2>
        requires indirectly_movable<I1, I2>
    constexpr move_backward_result<I1, I2> operator()(I1 first, S1 last,
                                                      I2 result) const
    {
        I1 last_it = ranges::next(first, last);
        I1 cur     = last_it;
        while (cur != first) {
            --cur;
            --result;
            *result = ranges::iter_move(cur);
        }
        return {std::move(last_it), std::move(result)};
    }
    template <bidirectional_range R, bidirectional_iterator I>
        requires indirectly_movable<iterator_t<R>, I>
    constexpr move_backward_result<borrowed_iterator_t<R>, I>
    operator()(R &&r, I result) const
    {
        return (*this)(ranges::begin(r), ranges::end(r), std::move(result));
    }
};
inline constexpr MoveBackward move_backward{};

