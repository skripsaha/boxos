// boxcxx — <__bits/ranges_algo_mut>
// Ф29b-2, first file: the ranges:: constrained MODIFYING sequence operations
// ([alg.modifying.operations]) — copy/move/swap_ranges/transform/replace/fill/
// generate/remove/unique/reverse/rotate/shift plus the two RNG-driven ones
// (sample/shuffle). Pulled in by <algorithm> AFTER <__bits/ranges_algo> and
// <__bits/ranges_algo_fold>, so the result-type aggregates (in_out_result,
// in_in_result, in_in_out_result) and the read-oriented niebloids this file
// reuses (ranges::find / ranges::adjacent_find / ranges::copy / ranges::move)
// are already in scope, together with the Ф29a indirect-callable foundation and
// the classic std:: algorithms it delegates the tricky reordering to.
//
// The complex reordering algorithms that already have a battle-tested classic
// implementation in <algorithm> (rotate, shift_right on bidirectional) are
// delegated to via sentinel-materialisation rather than re-implemented; the rest
// are direct loops matching the house style of the sibling ranges_algo files.
#ifndef BOXCXX_BITS_RANGES_ALGO_MUT
#define BOXCXX_BITS_RANGES_ALGO_MUT

#include <__bits/urng>
#include <functional>
#include <ranges>
#include <utility>

