// boxcxx — <__bits/ranges_core>
// The CPO + range-concept substrate, split out of <ranges> so container
// headers (vector/deque/list/map/set/unordered_*/string) can reach
// ContainerCompatibleRange and the concepts it needs without pulling in
// the full views/adaptors graph (~7900 lines: zip/join/chunk/cartesian/
// split/...) that <ranges> proper drags in. <ranges> includes this file
// first — zero behavior change for existing <ranges> users.
//
// CPO resolution here is member → ADL (std::begin/end being visible
// generic fallbacks) → array decay; the full poison-pill ceremony is
// deliberately simplified — tracked in the epic leftovers.
//
// Depends on __bits/iterator_concepts (input_iterator/contiguous_iterator/
// iter_difference_t/...), NOT the whole of <iterator> — <iterator> itself
// depends on this file for ranges::distance's range-taking overload, so
// pulling in all of <iterator> here would be a genuine include cycle. See
// __bits/iterator_concepts's own header comment for the full reasoning.
#ifndef BOXCXX_BITS_RANGES_CORE
#define BOXCXX_BITS_RANGES_CORE

#include <__bits/iterator_concepts>
#include <concepts>
#include <cstddef>
#include <type_traits>

namespace std {

// [ranges.syn] — from_range_t / from_range (namespace std, NOT std::ranges)
struct from_range_t {
    explicit from_range_t() = default;
};
inline constexpr from_range_t from_range{};

namespace ranges {

// ── CPOs ────────────────────────────────────────────────────────────────

namespace __cpo {

struct Begin {
    template <typename T, size_t N>
    constexpr T *operator()(T (&arr)[N]) const noexcept
    {
        return arr;
    }
    template <typename R>
        requires requires(R &r) {
            { r.begin() } -> input_or_output_iterator;
        }
    constexpr auto operator()(R &r) const noexcept(noexcept(r.begin()))
    {
        return r.begin();
    }
    template <typename R>
        requires(!requires(R &r) {
            { r.begin() } -> input_or_output_iterator;
        }) && requires(R &r) {
            { begin(r) } -> input_or_output_iterator;
        }
    constexpr auto operator()(R &r) const noexcept(noexcept(begin(r)))
    {
        return begin(r);
    }
};

struct End {
    template <typename T, size_t N>
    constexpr T *operator()(T (&arr)[N]) const noexcept
    {
        return arr + N;
    }
    template <typename R>
        requires requires(R &r) { r.begin(); r.end(); }
    constexpr auto operator()(R &r) const noexcept(noexcept(r.end()))
    {
        return r.end();
    }
    template <typename R>
        requires(!requires(R &r) { r.end(); }) && requires(R &r) {
            begin(r);
            end(r);
        }
    constexpr auto operator()(R &r) const noexcept(noexcept(end(r)))
    {
        return end(r);
    }
};

struct Size {
    template <typename T, size_t N>
    constexpr size_t operator()(const T (&)[N]) const noexcept
    {
        return N;
    }
    template <typename R>
        requires requires(R &r) {
            { r.size() } -> integral;
        }
    constexpr auto operator()(R &r) const noexcept(noexcept(r.size()))
    {
        return r.size();
    }
    template <typename R>
        requires(!requires(R &r) {
            { r.size() } -> integral;
        }) && requires(R &r) {
            { End{}(r) - Begin{}(r) } -> integral;
        }
    constexpr auto operator()(R &r) const
    {
        auto d = End{}(r) - Begin{}(r);
        return static_cast<make_unsigned_t<decltype(d)>>(d);
    }
};

// ranges::reserve_hint ([range.prim.size.hint], P2846R6): how many elements a
// container should reserve for this range. A range can answer this without
// being able to answer size() -- a lazily transcoding or normalising view knows
// it will produce "about as many" elements as it consumes but cannot say
// exactly how many, and before this there was no way for ranges::to to ask.
//
// size() comes FIRST in the resolution order, and that is what makes the two
// concepts nest: every sized_range models approximately_sized_range without
// writing a second member, so only views whose size is genuinely unknown need
// one. Unqualified reserve_hint(r) in the last overload is the same ADL shape
// Begin/End above use -- ranges::reserve_hint is declared below this namespace,
// so ordinary lookup at definition context finds nothing and only ADL applies.
struct ReserveHint {
    // The parameter is a forwarding reference, not the plain R& the older CPOs
    // in this file take: [range.prim.size.hint] reifies its argument into an
    // lvalue, so `ranges::reserve_hint(v | views::take(3))` on a materialised
    // temporary is well-formed, and a hint is asked for pipelines far more
    // often than for named views.
    template <typename R>
        requires requires(remove_reference_t<R> &r) { Size{}(r); }
    constexpr auto operator()(R &&r) const noexcept(noexcept(Size{}(r)))
    {
        return Size{}(r);
    }
    template <typename R>
        requires(!requires(remove_reference_t<R> &r) { Size{}(r); }) &&
                requires(remove_reference_t<R> &r) {
                    { auto(r.reserve_hint()) } -> integral;
                }
    constexpr auto operator()(R &&r) const noexcept(noexcept(r.reserve_hint()))
    {
        return auto(r.reserve_hint());
    }
    template <typename R>
        requires(!requires(remove_reference_t<R> &r) { Size{}(r); }) &&
                (!requires(remove_reference_t<R> &r) {
                    { auto(r.reserve_hint()) } -> integral;
                }) &&
                requires(remove_reference_t<R> &r) {
                    { auto(reserve_hint(r)) } -> integral;
                }
    constexpr auto operator()(R &&r) const noexcept(noexcept(reserve_hint(r)))
    {
        return auto(reserve_hint(r));
    }
};

struct Empty {
    template <typename R>
        requires requires(R &r) {
            { r.empty() } -> convertible_to<bool>;
        }
    constexpr bool operator()(R &r) const
    {
        return static_cast<bool>(r.empty());
    }
    template <typename R>
        requires(!requires(R &r) { r.empty(); }) &&
                requires(R &r) { Size{}(r); }
    constexpr bool operator()(R &r) const
    {
        return Size{}(r) == 0;
    }
    template <typename R>
        requires(!requires(R &r) { r.empty(); }) &&
                (!requires(R &r) { Size{}(r); }) &&
                requires(R &r) { Begin{}(r) == End{}(r); }
    constexpr bool operator()(R &r) const
    {
        return Begin{}(r) == End{}(r);
    }
};

struct Data {
    template <typename R>
        requires requires(R &r) {
            { r.data() } -> same_as<add_pointer_t<remove_reference_t<
                                decltype(*Begin{}(declval<R &>()))>>>;
        }
    constexpr auto operator()(R &r) const noexcept(noexcept(r.data()))
    {
        return r.data();
    }
    template <typename R>
        requires(!requires(R &r) { r.data(); }) && requires(R &r) {
            requires is_pointer_v<decltype(Begin{}(r))>;
        }
    constexpr auto operator()(R &r) const
    {
        return Begin{}(r);
    }
};

// [range.prim.ssize] is a customization point object like its twelve
// siblings, not a function template. The difference is not cosmetic: only an
// object can be passed by value, stored, or bound — `auto f = ranges::ssize;`
// is what a function template cannot do — and only an object is immune to
// being found by ADL and hijacked by a user-declared ssize in an associated
// namespace, which is the whole reason [range.access] specifies CPOs.
struct SSize {
    template <typename R>
        requires requires(R &r) { Size{}(r); }
    constexpr auto operator()(R &r) const
    {
        auto n = Size{}(r);
        return static_cast<
            common_type_t<ptrdiff_t, make_signed_t<decltype(n)>>>(n);
    }
};

} // namespace __cpo

inline namespace __cpo_objects {
inline constexpr __cpo::Begin begin{};
inline constexpr __cpo::End end{};
inline constexpr __cpo::Size size{};
inline constexpr __cpo::ReserveHint reserve_hint{};
inline constexpr __cpo::SSize ssize{};
inline constexpr __cpo::Empty empty{};
inline constexpr __cpo::Data data{};
} // namespace __cpo_objects

// ── associated types ([range.access], [range.req]) ──────────────────────

template <typename R>
using iterator_t = decltype(ranges::begin(declval<R &>()));
template <typename R>
using sentinel_t = decltype(ranges::end(declval<R &>()));
template <typename R>
using range_difference_t = iter_difference_t<iterator_t<R>>;
template <typename R>
using range_value_t = iter_value_t<iterator_t<R>>;
template <typename R>
using range_reference_t = iter_reference_t<iterator_t<R>>;
// [range.range]'s last two associated types. range_rvalue_reference_t is what
// views::as_rvalue and ranges::uninitialized_move actually move THROUGH -- it
// routes via ranges::iter_move, so a proxy iterator's own ADL iter_move
// participates instead of a hand-rolled std::move(*i) that would synthesize a
// dangling reference into an expired temporary.
template <typename R>
using range_rvalue_reference_t = iter_rvalue_reference_t<iterator_t<R>>;
template <typename R>
using range_common_reference_t = iter_common_reference_t<iterator_t<R>>;
template <typename R>
using range_size_t = decltype(ranges::size(declval<R &>()));

// ── range concepts ([range.range] ff.) ──────────────────────────────────

template <typename R>
concept range = requires(R &r) {
    ranges::begin(r);
    ranges::end(r);
};

template <typename R>
inline constexpr bool enable_borrowed_range = false;

template <typename R>
concept borrowed_range =
    range<R> && (is_lvalue_reference_v<R> ||
                 enable_borrowed_range<remove_cvref_t<R>>);

// P2846R6 rebases sized_range on approximately_sized_range rather than on
// range: knowing the exact size is a refinement of knowing an approximate one,
// not something beside it. Nothing is lost by the change -- reserve_hint falls
// back to size, so anything that satisfied the old sized_range satisfies the
// new one.
template <typename R>
concept approximately_sized_range = range<R> && requires(R &r) { ranges::reserve_hint(r); };
template <typename R>
concept sized_range = approximately_sized_range<R> && requires(R &r) { ranges::size(r); };

template <typename R>
concept input_range = range<R> && input_iterator<iterator_t<R>>;
template <typename R>
concept forward_range = input_range<R> && forward_iterator<iterator_t<R>>;
template <typename R>
concept bidirectional_range =
    forward_range<R> && bidirectional_iterator<iterator_t<R>>;
template <typename R>
concept random_access_range =
    bidirectional_range<R> && random_access_iterator<iterator_t<R>>;
template <typename R>
concept contiguous_range =
    random_access_range<R> && contiguous_iterator<iterator_t<R>> &&
    requires(R &r) {
        { ranges::data(r) } -> same_as<add_pointer_t<range_reference_t<R>>>;
    };
template <typename R, typename T>
concept output_range = range<R> && output_iterator<iterator_t<R>, T>;

template <typename R>
concept common_range =
    range<R> && same_as<iterator_t<R>, sentinel_t<R>>;

// ── dangling / borrowed_iterator_t ([range.dangling]) ────────────────────
// Inert marker returned in place of an iterator by algorithms that took an
// rvalue non-borrowed range, so a would-be-dangling iterator can never be
// used by accident. Its variadic ctor absorbs any argument list.
struct dangling {
    constexpr dangling() noexcept = default;
    template <typename... Args>
    constexpr dangling(Args &&...) noexcept
    {
    }
};

template <range R>
using borrowed_iterator_t =
    conditional_t<borrowed_range<R>, iterator_t<R>, dangling>;

// ── in_out_result ([algorithms.results]) ─────────────────────────────────
// Second aggregate to move here for the same reason as out_value_result
// below: <memory>'s ranges:: uninitialized_copy / _copy_n / _move / _move_n
// all return it, and <memory> is included by every container — pulling
// ranges_algo in behind it would put the whole of <algorithm> under each one.
template <class I, class O>
struct in_out_result {
    [[no_unique_address]] I in;
    [[no_unique_address]] O out;

    template <class I2, class O2>
        requires convertible_to<const I &, I2> && convertible_to<const O &, O2>
    constexpr operator in_out_result<I2, O2>() const &
    {
        return {in, out};
    }
    template <class I2, class O2>
        requires convertible_to<I, I2> && convertible_to<O, O2>
    constexpr operator in_out_result<I2, O2>() &&
    {
        return {std::move(in), std::move(out)};
    }
};

// ── out_value_result ([algorithms.results]) ──────────────────────────────
// Used by <numeric>'s ranges::iota (iota_result = out_value_result<O,T>);
// lives here rather than in ranges_algo so <numeric> can reach it without
// pulling in the rest of <algorithm>/<ranges>.
template <class O, class T>
struct out_value_result {
    [[no_unique_address]] O out;
    [[no_unique_address]] T value;

    template <class O2, class T2>
        requires convertible_to<const O &, O2> && convertible_to<const T &, T2>
    constexpr operator out_value_result<O2, T2>() const &
    {
        return {out, value};
    }
    template <class O2, class T2>
        requires convertible_to<O, O2> && convertible_to<T, T2>
    constexpr operator out_value_result<O2, T2>() &&
    {
        return {std::move(out), std::move(value)};
    }
};

namespace __views_detail {

// [range.transform.iterator], [range.filter.iterator], [range.stride.iterator],
// [range.elements.iterator] all declare iterator_category "present only if
// Base models forward_range". Since [iterator.traits]/3.4 that is not a
// formality: a single-pass C++20 iterator may have NO iterator_traits
// members at all, so a non-forward base has no legacy category to inherit
// and merely NAMING it is a hard error. Deriving from this supplies the
// member exactly when the base earns it, and never forms the base's
// category otherwise.
//
// The clauses are ladders, and Test is NOT the same tag as Result: given the
// base category C,
//   * if C derives from Test    -> Result
//   * else if C derives from Mid -> Mid          (omit Mid with void)
//   * else                       -> C itself
// [range.filter.iterator] genuinely needs the middle rung: a user tag derived
// from forward_iterator_tag but not bidirectional_iterator_tag must come out
// as forward_iterator_tag, not as the user tag. [range.transform.iterator]
// needs Test != Result: it tests derived_from<C, contiguous_iterator_tag> and
// yields random_access_iterator_tag, which differs from "test random access"
// exactly for a user tag derived from random_access_iterator_tag.
// ForceInput drops the whole thing to input for an adaptor that hands back a
// prvalue, which cannot satisfy a LegacyForwardIterator's stable-reference
// requirement.
template <typename Base, typename Test, typename Result, typename Mid = void,
          bool ForceInput = false, bool Present = forward_range<Base>>
struct MaybeCategory {};

template <typename Base, typename Test, typename Result, typename Mid,
          bool ForceInput>
struct MaybeCategory<Base, Test, Result, Mid, ForceInput, true> {
private:
    using BaseCat = typename iterator_traits<iterator_t<Base>>::iterator_category;

public:
    using iterator_category = conditional_t<
        ForceInput, input_iterator_tag,
        conditional_t<derived_from<BaseCat, Test>, Result,
                      conditional_t<!is_void_v<Mid> && derived_from<BaseCat, Mid>,
                                    Mid, BaseCat>>>;
};

} // namespace __views_detail

} // namespace ranges

// [container.intro.reqmts] p2 — container-compatible-range.
// Namespace std (unqualified), matching the standard's own placement and
// how container ctors spell it: template<container-compatible-range<T> R>.
template <typename R, typename T>
concept ContainerCompatibleRange =
    ranges::input_range<R> && convertible_to<ranges::range_reference_t<R>, T>;

} // namespace std

#endif // BOXCXX_BITS_RANGES_CORE
