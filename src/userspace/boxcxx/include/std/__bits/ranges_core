// boxcxx — <__bits/ranges_core>
// The CPO + range-concept substrate, split out of <ranges> so container
// headers (vector/deque/list/map/set/unordered_*/string) can reach
// ContainerCompatibleRange and the concepts it needs without pulling in
// the full views/adaptors graph (~7900 lines: zip/join/chunk/cartesian/
// split/...) that <ranges> proper drags in. <ranges> includes this file
// first — zero behavior change for existing <ranges> users.
//
// CPO resolution here is member → ADL (std::begin/end being visible
// generic fallbacks) → array decay; the full poison-pill ceremony is
// deliberately simplified — tracked in the epic leftovers.
#ifndef BOXCXX_BITS_RANGES_CORE
#define BOXCXX_BITS_RANGES_CORE

#include <concepts>
#include <cstddef>
#include <iterator>
#include <type_traits>

namespace std {

// [ranges.syn] — from_range_t / from_range (namespace std, NOT std::ranges)
struct from_range_t {
    explicit from_range_t() = default;
};
inline constexpr from_range_t from_range{};

namespace ranges {

// ── CPOs ────────────────────────────────────────────────────────────────

namespace __cpo {

struct Begin {
    template <typename T, size_t N>
    constexpr T *operator()(T (&arr)[N]) const noexcept
    {
        return arr;
    }
    template <typename R>
        requires requires(R &r) {
            { r.begin() } -> input_or_output_iterator;
        }
    constexpr auto operator()(R &r) const noexcept(noexcept(r.begin()))
    {
        return r.begin();
    }
    template <typename R>
        requires(!requires(R &r) {
            { r.begin() } -> input_or_output_iterator;
        }) && requires(R &r) {
            { begin(r) } -> input_or_output_iterator;
        }
    constexpr auto operator()(R &r) const noexcept(noexcept(begin(r)))
    {
        return begin(r);
    }
};

struct End {
    template <typename T, size_t N>
    constexpr T *operator()(T (&arr)[N]) const noexcept
    {
        return arr + N;
    }
    template <typename R>
        requires requires(R &r) { r.begin(); r.end(); }
    constexpr auto operator()(R &r) const noexcept(noexcept(r.end()))
    {
        return r.end();
    }
    template <typename R>
        requires(!requires(R &r) { r.end(); }) && requires(R &r) {
            begin(r);
            end(r);
        }
    constexpr auto operator()(R &r) const noexcept(noexcept(end(r)))
    {
        return end(r);
    }
};

struct Size {
    template <typename T, size_t N>
    constexpr size_t operator()(const T (&)[N]) const noexcept
    {
        return N;
    }
    template <typename R>
        requires requires(R &r) {
            { r.size() } -> integral;
        }
    constexpr auto operator()(R &r) const noexcept(noexcept(r.size()))
    {
        return r.size();
    }
    template <typename R>
        requires(!requires(R &r) {
            { r.size() } -> integral;
        }) && requires(R &r) {
            { End{}(r) - Begin{}(r) } -> integral;
        }
    constexpr auto operator()(R &r) const
    {
        auto d = End{}(r) - Begin{}(r);
        return static_cast<make_unsigned_t<decltype(d)>>(d);
    }
};

struct Empty {
    template <typename R>
        requires requires(R &r) {
            { r.empty() } -> convertible_to<bool>;
        }
    constexpr bool operator()(R &r) const
    {
        return static_cast<bool>(r.empty());
    }
    template <typename R>
        requires(!requires(R &r) { r.empty(); }) &&
                requires(R &r) { Size{}(r); }
    constexpr bool operator()(R &r) const
    {
        return Size{}(r) == 0;
    }
    template <typename R>
        requires(!requires(R &r) { r.empty(); }) &&
                (!requires(R &r) { Size{}(r); }) &&
                requires(R &r) { Begin{}(r) == End{}(r); }
    constexpr bool operator()(R &r) const
    {
        return Begin{}(r) == End{}(r);
    }
};

struct Data {
    template <typename R>
        requires requires(R &r) {
            { r.data() } -> same_as<add_pointer_t<remove_reference_t<
                                decltype(*Begin{}(declval<R &>()))>>>;
        }
    constexpr auto operator()(R &r) const noexcept(noexcept(r.data()))
    {
        return r.data();
    }
    template <typename R>
        requires(!requires(R &r) { r.data(); }) && requires(R &r) {
            requires is_pointer_v<decltype(Begin{}(r))>;
        }
    constexpr auto operator()(R &r) const
    {
        return Begin{}(r);
    }
};

} // namespace __cpo

inline namespace __cpo_objects {
inline constexpr __cpo::Begin begin{};
inline constexpr __cpo::End end{};
inline constexpr __cpo::Size size{};
inline constexpr __cpo::Empty empty{};
inline constexpr __cpo::Data data{};
} // namespace __cpo_objects

template <typename R>
constexpr auto ssize(R &&r)
{
    auto n = ranges::size(r);
    return static_cast<common_type_t<ptrdiff_t, make_signed_t<decltype(n)>>>(
        n);
}

// ── associated types ([range.access], [range.req]) ──────────────────────

template <typename R>
using iterator_t = decltype(ranges::begin(declval<R &>()));
template <typename R>
using sentinel_t = decltype(ranges::end(declval<R &>()));
template <typename R>
using range_difference_t = iter_difference_t<iterator_t<R>>;
template <typename R>
using range_value_t = iter_value_t<iterator_t<R>>;
template <typename R>
using range_reference_t = iter_reference_t<iterator_t<R>>;
template <typename R>
using range_size_t = decltype(ranges::size(declval<R &>()));

// ── range concepts ([range.range] ff.) ──────────────────────────────────

template <typename R>
concept range = requires(R &r) {
    ranges::begin(r);
    ranges::end(r);
};

template <typename R>
inline constexpr bool enable_borrowed_range = false;

template <typename R>
concept borrowed_range =
    range<R> && (is_lvalue_reference_v<R> ||
                 enable_borrowed_range<remove_cvref_t<R>>);

template <typename R>
concept sized_range = range<R> && requires(R &r) { ranges::size(r); };

template <typename R>
concept input_range = range<R> && input_iterator<iterator_t<R>>;
template <typename R>
concept forward_range = input_range<R> && forward_iterator<iterator_t<R>>;
template <typename R>
concept bidirectional_range =
    forward_range<R> && bidirectional_iterator<iterator_t<R>>;
template <typename R>
concept random_access_range =
    bidirectional_range<R> && random_access_iterator<iterator_t<R>>;
template <typename R>
concept contiguous_range =
    random_access_range<R> && contiguous_iterator<iterator_t<R>> &&
    requires(R &r) {
        { ranges::data(r) } -> same_as<add_pointer_t<range_reference_t<R>>>;
    };
template <typename R, typename T>
concept output_range = range<R> && output_iterator<iterator_t<R>, T>;

template <typename R>
concept common_range =
    range<R> && same_as<iterator_t<R>, sentinel_t<R>>;

} // namespace ranges

// [container.intro.reqmts] p2 — container-compatible-range.
// Namespace std (unqualified), matching the standard's own placement and
// how container ctors spell it: template<container-compatible-range<T> R>.
template <typename R, typename T>
concept ContainerCompatibleRange =
    ranges::input_range<R> && convertible_to<ranges::range_reference_t<R>, T>;

} // namespace std

#endif // BOXCXX_BITS_RANGES_CORE
