// boxcxx — <compare>
// The compiler synthesizes defaulted operator<=> against these exact
// class names and their static members; the literal-0 comparison uses
// the unspecified-pointer-parameter idiom ([cmp.categories.pre]).
#ifndef BOXCXX_COMPARE
#define BOXCXX_COMPARE

#include <type_traits>
#include <bit>          // bit_cast for the IEEE strong/weak total orders (acyclic:
                        // bit -> type_traits,limits; neither includes compare)

namespace std {

namespace __cmp {
using ValueT = signed char;
struct Unspec {
    consteval Unspec(Unspec *) noexcept {}
};
} // namespace __cmp

class partial_ordering {
    __cmp::ValueT _value;
    constexpr explicit partial_ordering(__cmp::ValueT v) noexcept : _value(v) {}
    friend class weak_ordering;
    friend class strong_ordering;

public:
    static const partial_ordering less;
    static const partial_ordering equivalent;
    static const partial_ordering greater;
    static const partial_ordering unordered;

    [[nodiscard]] friend constexpr bool operator==(partial_ordering v,
                                                   __cmp::Unspec) noexcept
    { return v._value == 0; }
    [[nodiscard]] friend constexpr bool operator==(partial_ordering,
                                                   partial_ordering) noexcept = default;
    [[nodiscard]] friend constexpr bool operator<(partial_ordering v,
                                                  __cmp::Unspec) noexcept
    { return v._value == -1; }
    [[nodiscard]] friend constexpr bool operator>(partial_ordering v,
                                                  __cmp::Unspec) noexcept
    { return v._value == 1; }
    [[nodiscard]] friend constexpr bool operator<=(partial_ordering v,
                                                   __cmp::Unspec) noexcept
    { return v._value == -1 || v._value == 0; }
    [[nodiscard]] friend constexpr bool operator>=(partial_ordering v,
                                                   __cmp::Unspec) noexcept
    { return v._value == 1 || v._value == 0; }
    [[nodiscard]] friend constexpr bool operator<(__cmp::Unspec,
                                                  partial_ordering v) noexcept
    { return v._value == 1; }
    [[nodiscard]] friend constexpr bool operator>(__cmp::Unspec,
                                                  partial_ordering v) noexcept
    { return v._value == -1; }
    [[nodiscard]] friend constexpr bool operator<=(__cmp::Unspec,
                                                   partial_ordering v) noexcept
    { return v._value == 1 || v._value == 0; }
    [[nodiscard]] friend constexpr bool operator>=(__cmp::Unspec,
                                                   partial_ordering v) noexcept
    { return v._value == -1 || v._value == 0; }
    [[nodiscard]] friend constexpr partial_ordering
    operator<=>(partial_ordering v, __cmp::Unspec) noexcept
    { return v; }
    [[nodiscard]] friend constexpr partial_ordering
    operator<=>(__cmp::Unspec, partial_ordering v) noexcept
    {
        if (v._value == -1) return partial_ordering(1);
        if (v._value == 1) return partial_ordering(-1);
        return v;
    }
};

inline constexpr partial_ordering partial_ordering::less(-1);
inline constexpr partial_ordering partial_ordering::equivalent(0);
inline constexpr partial_ordering partial_ordering::greater(1);
inline constexpr partial_ordering partial_ordering::unordered(2);

class weak_ordering {
    __cmp::ValueT _value;
    constexpr explicit weak_ordering(__cmp::ValueT v) noexcept : _value(v) {}
    friend class strong_ordering;

public:
    static const weak_ordering less;
    static const weak_ordering equivalent;
    static const weak_ordering greater;

    [[nodiscard]] constexpr operator partial_ordering() const noexcept
    { return partial_ordering(_value); }

    [[nodiscard]] friend constexpr bool operator==(weak_ordering v,
                                                   __cmp::Unspec) noexcept
    { return v._value == 0; }
    [[nodiscard]] friend constexpr bool operator==(weak_ordering,
                                                   weak_ordering) noexcept = default;
    [[nodiscard]] friend constexpr bool operator<(weak_ordering v,
                                                  __cmp::Unspec) noexcept
    { return v._value < 0; }
    [[nodiscard]] friend constexpr bool operator>(weak_ordering v,
                                                  __cmp::Unspec) noexcept
    { return v._value > 0; }
    [[nodiscard]] friend constexpr bool operator<=(weak_ordering v,
                                                   __cmp::Unspec) noexcept
    { return v._value <= 0; }
    [[nodiscard]] friend constexpr bool operator>=(weak_ordering v,
                                                   __cmp::Unspec) noexcept
    { return v._value >= 0; }
    [[nodiscard]] friend constexpr bool operator<(__cmp::Unspec,
                                                  weak_ordering v) noexcept
    { return v._value > 0; }
    [[nodiscard]] friend constexpr bool operator>(__cmp::Unspec,
                                                  weak_ordering v) noexcept
    { return v._value < 0; }
    [[nodiscard]] friend constexpr bool operator<=(__cmp::Unspec,
                                                   weak_ordering v) noexcept
    { return v._value >= 0; }
    [[nodiscard]] friend constexpr bool operator>=(__cmp::Unspec,
                                                   weak_ordering v) noexcept
    { return v._value <= 0; }
    [[nodiscard]] friend constexpr weak_ordering
    operator<=>(weak_ordering v, __cmp::Unspec) noexcept
    { return v; }
    [[nodiscard]] friend constexpr weak_ordering
    operator<=>(__cmp::Unspec, weak_ordering v) noexcept
    { return weak_ordering(static_cast<__cmp::ValueT>(-v._value)); }
};

inline constexpr weak_ordering weak_ordering::less(-1);
inline constexpr weak_ordering weak_ordering::equivalent(0);
inline constexpr weak_ordering weak_ordering::greater(1);

class strong_ordering {
    __cmp::ValueT _value;
    constexpr explicit strong_ordering(__cmp::ValueT v) noexcept : _value(v) {}

public:
    static const strong_ordering less;
    static const strong_ordering equal;
    static const strong_ordering equivalent;
    static const strong_ordering greater;

    [[nodiscard]] constexpr operator partial_ordering() const noexcept
    { return partial_ordering(_value); }
    [[nodiscard]] constexpr operator weak_ordering() const noexcept
    { return weak_ordering(_value); }

    [[nodiscard]] friend constexpr bool operator==(strong_ordering v,
                                                   __cmp::Unspec) noexcept
    { return v._value == 0; }
    [[nodiscard]] friend constexpr bool operator==(strong_ordering,
                                                   strong_ordering) noexcept = default;
    [[nodiscard]] friend constexpr bool operator<(strong_ordering v,
                                                  __cmp::Unspec) noexcept
    { return v._value < 0; }
    [[nodiscard]] friend constexpr bool operator>(strong_ordering v,
                                                  __cmp::Unspec) noexcept
    { return v._value > 0; }
    [[nodiscard]] friend constexpr bool operator<=(strong_ordering v,
                                                   __cmp::Unspec) noexcept
    { return v._value <= 0; }
    [[nodiscard]] friend constexpr bool operator>=(strong_ordering v,
                                                   __cmp::Unspec) noexcept
    { return v._value >= 0; }
    [[nodiscard]] friend constexpr bool operator<(__cmp::Unspec,
                                                  strong_ordering v) noexcept
    { return v._value > 0; }
    [[nodiscard]] friend constexpr bool operator>(__cmp::Unspec,
                                                  strong_ordering v) noexcept
    { return v._value < 0; }
    [[nodiscard]] friend constexpr bool operator<=(__cmp::Unspec,
                                                   strong_ordering v) noexcept
    { return v._value >= 0; }
    [[nodiscard]] friend constexpr bool operator>=(__cmp::Unspec,
                                                   strong_ordering v) noexcept
    { return v._value <= 0; }
    [[nodiscard]] friend constexpr strong_ordering
    operator<=>(strong_ordering v, __cmp::Unspec) noexcept
    { return v; }
    [[nodiscard]] friend constexpr strong_ordering
    operator<=>(__cmp::Unspec, strong_ordering v) noexcept
    { return strong_ordering(static_cast<__cmp::ValueT>(-v._value)); }
};

inline constexpr strong_ordering strong_ordering::less(-1);
inline constexpr strong_ordering strong_ordering::equal(0);
inline constexpr strong_ordering strong_ordering::equivalent(0);
inline constexpr strong_ordering strong_ordering::greater(1);

// ── named comparison functions ──────────────────────────────────────────

[[nodiscard]] constexpr bool is_eq(partial_ordering cmp) noexcept
{ return cmp == 0; }
[[nodiscard]] constexpr bool is_neq(partial_ordering cmp) noexcept
{ return cmp != 0; }
[[nodiscard]] constexpr bool is_lt(partial_ordering cmp) noexcept
{ return cmp < 0; }
[[nodiscard]] constexpr bool is_lteq(partial_ordering cmp) noexcept
{ return cmp <= 0; }
[[nodiscard]] constexpr bool is_gt(partial_ordering cmp) noexcept
{ return cmp > 0; }
[[nodiscard]] constexpr bool is_gteq(partial_ordering cmp) noexcept
{ return cmp >= 0; }

// ── common_comparison_category ──────────────────────────────────────────

namespace __cmp {
// 0 none, 1 partial, 2 weak, 4 strong — min strength wins.
template <class T> inline constexpr unsigned CatCode = 0;
template <> inline constexpr unsigned CatCode<partial_ordering> = 1;
template <> inline constexpr unsigned CatCode<weak_ordering> = 2;
template <> inline constexpr unsigned CatCode<strong_ordering> = 4;
} // namespace __cmp

template <class... Ts>
struct common_comparison_category {
private:
    static constexpr unsigned Fold()
    {
        constexpr unsigned codes[] = {4u, __cmp::CatCode<Ts>...};
        unsigned strength = 4;
        for (unsigned c : codes) {
            if (c == 0) return 0;
            if (c < strength) strength = c;
        }
        return strength;
    }
    static constexpr unsigned kStrength = Fold();

public:
    using type = conditional_t<
        kStrength == 4, strong_ordering,
        conditional_t<kStrength == 2, weak_ordering,
                      conditional_t<kStrength == 1, partial_ordering, void>>>;
};
template <class... Ts>
using common_comparison_category_t =
    typename common_comparison_category<Ts...>::type;

// ── three_way_comparable machinery / compare_three_way ─────────────────

namespace __cmp {
template <class T, class Cat>
concept ComparesAs = is_same_v<common_comparison_category_t<T, Cat>, Cat>;

template <class T>
concept BooleanLike = is_convertible_v<T, bool>;

template <class T, class U>
concept WeaklyEqCmpWith =
    requires(const remove_reference_t<T> &t, const remove_reference_t<U> &u) {
        { t == u } -> BooleanLike;
        { t != u } -> BooleanLike;
        { u == t } -> BooleanLike;
        { u != t } -> BooleanLike;
    };

template <class T, class U>
concept PartiallyOrderedWith =
    requires(const remove_reference_t<T> &t, const remove_reference_t<U> &u) {
        { t < u }  -> BooleanLike;
        { t > u }  -> BooleanLike;
        { t <= u } -> BooleanLike;
        { t >= u } -> BooleanLike;
        { u < t }  -> BooleanLike;
        { u > t }  -> BooleanLike;
        { u <= t } -> BooleanLike;
        { u >= t } -> BooleanLike;
    };
} // namespace __cmp

template <class T, class Cat = partial_ordering>
concept three_way_comparable =
    __cmp::WeaklyEqCmpWith<T, T> && __cmp::PartiallyOrderedWith<T, T> &&
    requires(const remove_reference_t<T> &a, const remove_reference_t<T> &b) {
        { a <=> b } -> __cmp::ComparesAs<Cat>;
    };

// common_reference_with's requirements are replicated inline so <compare>
// stays independent of <concepts> (which includes this header).
template <class T, class U, class Cat = partial_ordering>
concept three_way_comparable_with =
    three_way_comparable<T, Cat> && three_way_comparable<U, Cat> &&
    is_same_v<common_reference_t<const remove_reference_t<T> &,
                                 const remove_reference_t<U> &>,
              common_reference_t<const remove_reference_t<U> &,
                                 const remove_reference_t<T> &>> &&
    is_convertible_v<const remove_reference_t<T> &,
                     common_reference_t<const remove_reference_t<T> &,
                                        const remove_reference_t<U> &>> &&
    is_convertible_v<const remove_reference_t<U> &,
                     common_reference_t<const remove_reference_t<T> &,
                                        const remove_reference_t<U> &>> &&
    three_way_comparable<
        common_reference_t<const remove_reference_t<T> &,
                           const remove_reference_t<U> &>,
        Cat> &&
    __cmp::WeaklyEqCmpWith<T, U> && __cmp::PartiallyOrderedWith<T, U> &&
    requires(const remove_reference_t<T> &t, const remove_reference_t<U> &u) {
        { t <=> u } -> __cmp::ComparesAs<Cat>;
        { u <=> t } -> __cmp::ComparesAs<Cat>;
    };

template <class T, class U>
struct compare_three_way_result {};
template <class T, class U>
    requires requires(const remove_reference_t<T> &t,
                      const remove_reference_t<U> &u) { t <=> u; }
struct compare_three_way_result<T, U> {
    using type = decltype(declval<const remove_reference_t<T> &>() <=>
                          declval<const remove_reference_t<U> &>());
};
template <class T, class U = T>
using compare_three_way_result_t =
    typename compare_three_way_result<T, U>::type;

struct compare_three_way {
    template <class T, class U>
        requires requires(T &&t, U &&u) {
            static_cast<T &&>(t) <=> static_cast<U &&>(u);
        }
    constexpr auto operator()(T &&t, U &&u) const
        noexcept(noexcept(static_cast<T &&>(t) <=> static_cast<U &&>(u)))
    {
        return static_cast<T &&>(t) <=> static_cast<U &&>(u);
    }
    using is_transparent = void;
};

// synth-three-way ([expos.only.func]): use <=> when available, otherwise a
// weak_ordering derived from < (and the implied ==). Lets pair/tuple/containers
// stay <=>-comparable for legacy element types that provide only < / ==.
namespace __cmp {
struct SynthThreeWay {
    template <class T, class U>
    [[nodiscard]] constexpr auto operator()(const T &t, const U &u) const
        requires requires {
            { t < u } -> BooleanLike;
            { u < t } -> BooleanLike;
        }
    {
        if constexpr (three_way_comparable_with<const T &, const U &>)
            return t <=> u;
        else
            return t < u ? weak_ordering::less
                 : u < t ? weak_ordering::greater
                         : weak_ordering::equivalent;
    }
};
template <class T, class U = T>
using synth_three_way_result_t =
    decltype(SynthThreeWay{}(declval<const remove_reference_t<T> &>(),
                             declval<const remove_reference_t<U> &>()));
} // namespace __cmp

// ── [cmp.alg] ordering customization-point objects ──────────────────────
// boxcxx deviation (documented): the ADL "user strong_order(E,F)" step of
// [cmp.alg] is intentionally omitted (mirrors <ranges>' simplified CPO note).
// boxcxx is a closed type set; user types customize via operator<=>, which
// partial_order honors directly and the *_fallback CPOs consume via ==/<.
namespace __cmp {

// Fixed-width selector for the float/double bit kernels. long double (x87
// 80-bit in a 16-byte slot, 6 indeterminate padding bytes) is NOT bit_cast
// whole — its kernel (LdKey below) reads only the 10 meaningful bytes.
template <class T> struct FpBits;
template <> struct FpBits<float> {
    using S = __INT32_TYPE__;  using U = __UINT32_TYPE__;
    static constexpr int kBits = 32;
    static constexpr U kExp = 0x7F800000u, kMan = 0x007FFFFFu;
};
template <> struct FpBits<double> {
    using S = __INT64_TYPE__;  using U = __UINT64_TYPE__;
    static constexpr int kBits = 64;
    static constexpr U kExp = 0x7FF0000000000000ull, kMan = 0x000FFFFFFFFFFFFFull;
};
template <class T>
concept StrongFp =
    is_same_v<remove_cv_t<T>, float> || is_same_v<remove_cv_t<T>, double> ||
    is_same_v<remove_cv_t<T>, long double>;

// x87 80-bit long double total-order key. Reads ONLY the 10 meaningful bytes
// of the 16-byte slot (padding bytes 10-15 are never touched): mant = bytes
// 0-7 (bit 63 = explicit integer bit J), se = bytes 8-9 (bit 15 = sign, bits
// 0-14 = 15-bit biased exponent). (exp<<64)|mant is monotone in real value
// (denorm exp 0 → normal → inf exp 0x7FFF/mant=J-bit → NaN mant!=J-bit) and
// injective over every bit pattern incl. x87 pseudo-encodings; sign at bit 127
// plus the sign-magnitude flip yields the IEEE totalOrder. weak_zero folds -0
// onto +0 for weak_order.
[[nodiscard]] constexpr __int128 LdKey(long double x, bool weak_zero) noexcept
{
    unsigned __int128 bits = bit_cast<unsigned __int128>(x);
    __UINT64_TYPE__ mant = (__UINT64_TYPE__)bits;
    unsigned se = (unsigned)(__UINT16_TYPE__)(bits >> 64);
    bool sign = se >> 15;
    unsigned exp = se & 0x7FFFu;
    __int128 mag = ((__int128)exp << 64) | (__int128)(unsigned __int128)mant;
    if (weak_zero && mag == 0) sign = false;                 // -0 ≡ +0
    __int128 ia = ((__int128)(sign ? 1 : 0) << 127) | mag;
    ia ^= (__int128)((unsigned __int128)(ia >> 127) >> 1);   // sign-mag → monotone
    return ia;
}

// std::strong_order total order: signed bit_cast + sign-magnitude flip.
//  -0<+0, -inf<everything<+inf, NaNs by sign then payload, every bit pattern
//  distinct.
template <class T>
[[nodiscard]] constexpr strong_ordering StrongFpOrder(T a, T b) noexcept
{
    if constexpr (is_same_v<remove_cv_t<T>, long double>) {
        return LdKey(a, false) <=> LdKey(b, false);
    } else {
        using S = typename FpBits<T>::S; using U = typename FpBits<T>::U;
        constexpr int B = FpBits<T>::kBits;
        S ia = bit_cast<S>(a), ib = bit_cast<S>(b);
        ia ^= S(U(ia >> (B - 1)) >> 1);
        ib ^= S(U(ib >> (B - 1)) >> 1);
        return ia <=> ib;
    }
}

// std::weak_order: WEAKER than strong. -0 equivalent +0; all same-sign NaNs
//  equivalent; ordering is  -NaN < -inf < ... < +inf < +NaN.  Compare a
//  NaN/sign tier first, then the sign-magnitude integer — NOT a single packed
//  key (a packed key overflows for double: max-finite magnitude > NaN band).
template <class T>
[[nodiscard]] constexpr weak_ordering WeakFpOrder(T a, T b) noexcept
{
    if constexpr (is_same_v<remove_cv_t<T>, long double>) {
        auto nan_sign = [](long double x) -> int {
            unsigned __int128 bits = bit_cast<unsigned __int128>(x);
            __UINT64_TYPE__ mant = (__UINT64_TYPE__)bits;
            unsigned se = (unsigned)(__UINT16_TYPE__)(bits >> 64);
            bool nan = ((se & 0x7FFFu) == 0x7FFFu) &&
                       (mant != 0x8000000000000000ull);   // x87 inf mant = J-bit only
            if (!nan) return 0;
            return (se >> 15) ? -1 : 1;                    // -NaN below, +NaN above
        };
        int ta = nan_sign(a), tb = nan_sign(b);
        if (ta != tb) return ta < tb ? weak_ordering::less : weak_ordering::greater;
        if (ta != 0) return weak_ordering::equivalent;     // same-sign NaN
        __int128 ka = LdKey(a, true), kb = LdKey(b, true);
        if (ka < kb) return weak_ordering::less;
        if (ka > kb) return weak_ordering::greater;
        return weak_ordering::equivalent;
    } else {
        using S = typename FpBits<T>::S; using U = typename FpBits<T>::U;
        constexpr int B = FpBits<T>::kBits;
        auto tier = [](T x) -> int {
            U u = bit_cast<U>(x);
            bool nan = ((u & FpBits<T>::kExp) == FpBits<T>::kExp) &&
                       ((u & FpBits<T>::kMan) != 0);
            if (!nan) return 0;
            return (u >> (B - 1)) ? -1 : 1;       // -NaN below, +NaN above
        };
        int ta = tier(a), tb = tier(b);
        if (ta != tb) return ta < tb ? weak_ordering::less : weak_ordering::greater;
        if (ta != 0) return weak_ordering::equivalent;          // same-sign NaN
        S ia = bit_cast<S>(a), ib = bit_cast<S>(b);
        if ((bit_cast<U>(a) & (U(~U(0)) >> 1)) == 0) ia = 0;    // -0 ≡ +0
        if ((bit_cast<U>(b) & (U(~U(0)) >> 1)) == 0) ib = 0;
        ia ^= S(U(ia >> (B - 1)) >> 1);
        ib ^= S(U(ib >> (B - 1)) >> 1);
        if (ia < ib) return weak_ordering::less;
        if (ia > ib) return weak_ordering::greater;
        return weak_ordering::equivalent;
    }
}

namespace __cpo {

struct StrongOrder {
    template <StrongFp T>
    [[nodiscard]] constexpr strong_ordering operator()(T a, T b) const noexcept
    { return StrongFpOrder<remove_cv_t<T>>(a, b); }

    template <class T, class U>
        requires(!StrongFp<T>) &&
                requires(const T &a, const U &b) {
                    { a == b } -> BooleanLike; { a < b } -> BooleanLike;
                }
    [[nodiscard]] constexpr strong_ordering operator()(const T &a, const U &b) const
        noexcept(noexcept(a == b) && noexcept(a < b))
    {
        return a == b ? strong_ordering::equal
             : a < b  ? strong_ordering::less : strong_ordering::greater;
    }
};

struct WeakOrder {
    template <StrongFp T>
    [[nodiscard]] constexpr weak_ordering operator()(T a, T b) const noexcept
    { return WeakFpOrder<remove_cv_t<T>>(a, b); }

    template <class T, class U>
        requires(!StrongFp<T>) &&
                requires(const T &a, const U &b) {
                    { a == b } -> BooleanLike; { a < b } -> BooleanLike;
                }
    [[nodiscard]] constexpr weak_ordering operator()(const T &a, const U &b) const
        noexcept(noexcept(a == b) && noexcept(a < b))
    {
        return a == b ? weak_ordering::equivalent
             : a < b  ? weak_ordering::less : weak_ordering::greater;
    }
};

struct PartialOrder {
    template <class T, class U>
        requires requires(const T &a, const U &b) { a <=> b; }
    [[nodiscard]] constexpr partial_ordering operator()(const T &a, const U &b) const
        noexcept(noexcept(a <=> b))
    { return a <=> b; }

    template <class T, class U>
        requires(!requires(const T &a, const U &b) { a <=> b; }) &&
                requires(const T &a, const U &b) {
                    { a == b } -> BooleanLike; { a < b } -> BooleanLike;
                    { b < a } -> BooleanLike;
                }
    [[nodiscard]] constexpr partial_ordering operator()(const T &a, const U &b) const
        noexcept(noexcept(a == b) && noexcept(a < b) && noexcept(b < a))
    {
        return a == b ? partial_ordering::equivalent
             : a < b  ? partial_ordering::less
             : b < a  ? partial_ordering::greater : partial_ordering::unordered;
    }
};

struct CompareStrongFallback {
    template <class T, class U>
        requires requires(const T &a, const U &b) {
            { a == b } -> BooleanLike; { a < b } -> BooleanLike;
        }
    [[nodiscard]] constexpr strong_ordering operator()(const T &a, const U &b) const
        noexcept(noexcept(a == b) && noexcept(a < b))
    {
        // [cmp.alg]: prefer strong_order (the IEEE total order for float/
        // double/long double) and use ==/< only when it is unavailable (a
        // user type with ==/< but no <=>). strong_order never routes back
        // here (float paths inline; long double routes to LdKey), no recursion.
        if constexpr (requires { StrongOrder{}(a, b); })
            return StrongOrder{}(a, b);
        else
            return a == b ? strong_ordering::equal
                 : a < b  ? strong_ordering::less : strong_ordering::greater;
    }
};

struct CompareWeakFallback {
    template <class T, class U>
        requires requires(const T &a, const U &b) {
            { a == b } -> BooleanLike; { a < b } -> BooleanLike;
        }
    [[nodiscard]] constexpr weak_ordering operator()(const T &a, const U &b) const
        noexcept(noexcept(a == b) && noexcept(a < b))
    {
        if constexpr (requires { WeakOrder{}(a, b); })
            return WeakOrder{}(a, b);
        else
            return a == b ? weak_ordering::equivalent
                 : a < b  ? weak_ordering::less : weak_ordering::greater;
    }
};

struct ComparePartialFallback {
    template <class T, class U>
        requires requires(const T &a, const U &b) {
            { a == b } -> BooleanLike; { a < b } -> BooleanLike;
            { b < a } -> BooleanLike;
        }
    [[nodiscard]] constexpr partial_ordering operator()(const T &a, const U &b) const
        noexcept(noexcept(a == b) && noexcept(a < b) && noexcept(b < a))
    {
        if constexpr (requires { PartialOrder{}(a, b); })
            return PartialOrder{}(a, b);
        else
            return a == b ? partial_ordering::equivalent
                 : a < b  ? partial_ordering::less
                 : b < a  ? partial_ordering::greater : partial_ordering::unordered;
    }
};

