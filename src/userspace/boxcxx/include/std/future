// ── shared_future<T> ──────────────────────────────────────────────────────────
//
// Refcounted multi-retrieve: copies share the state (ref_inc), every copy may
// get() repeatedly, the result is returned by const reference (T) / reference
// (T&) / void. The state lives until the last copy drops.

template <class T>
class shared_future {
public:
    shared_future() noexcept = default;

    shared_future(const shared_future &o) noexcept : __st(o.__st)
    {
        if (__st) __st->ref_inc();
    }
    shared_future(shared_future &&o) noexcept : __st(o.__st) { o.__st = nullptr; }

    // From a future ([futures.unique.future]/share): steal the future's handle.
    shared_future(future<T> &&f) noexcept : __st(f.__st) { f.__st = nullptr; }

    shared_future &operator=(const shared_future &o) noexcept
    {
        if (this != &o) {
            if (o.__st) o.__st->ref_inc();
            __release();
            __st = o.__st;
        }
        return *this;
    }
    shared_future &operator=(shared_future &&o) noexcept
    {
        if (this != &o) {
            __release();
            __st   = o.__st;
            o.__st = nullptr;
        }
        return *this;
    }

    ~shared_future() { __release(); }

    [[nodiscard]] bool valid() const noexcept { return __st != nullptr; }

    const T &get() const
    {
        if (!__st) throw future_error(future_errc::no_state);
        __st->__wait();
        __rethrow_if_stored(__st);
        return static_cast<__future_state<T> *>(__st)->__ref();
    }

    void wait() const
    {
        if (!__st) throw future_error(future_errc::no_state);
        __st->__wait();
    }
    template <class Rep, class Period>
    future_status wait_for(const chrono::duration<Rep, Period> &rel) const
    {
        if (!__st) throw future_error(future_errc::no_state);
        return __st->__wait_until(chrono::steady_clock::now() + rel);
    }
    template <class Clock, class Duration>
    future_status wait_until(const chrono::time_point<Clock, Duration> &abs) const
    {
        if (!__st) throw future_error(future_errc::no_state);
