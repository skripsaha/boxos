// Arm a deferred __ready publish on this strand's thread_local exit drain. The
// value/exception is already stashed; the callback publishes + notifies + drops
// the ref the arm took. ref_inc keeps the state alive until the callback runs;
// on __cxa_thread_atexit OOM (nonzero) run the publish inline so the result is
// never lost and the ref is balanced.
inline void __arm_thread_exit(__future_state_base *st)
{
    st->ref_inc();
    auto cb = +[](void *p) {
        auto *s = static_cast<__future_state_base *>(p);
        s->__publish();
        s->ref_dec();
    };
    if (__cxa_thread_atexit(cb, st, nullptr) != 0)
        cb(st);
}

// ── packaged_task<R(A...)> ──────────────────────────────────────────────────────
//
// Hand-rolled type erasure (no std::function): a heap __callable_base with an
// invoke + destroy vtable-by-pointer, holding the decay-copied callable. The
// invoke runs f(args...) and publishes the value/exception into the state.

// The erased callable carries two runners and a deleter. `invoke` runs the body
// and PUBLISHES (operator()); `invoke_stash` runs the body and STASHES without
// publishing (make_ready_at_thread_exit, which arms the publish for strand exit)
// — one source of truth for the body, two publish disciplines. Both follow the
// capture-then-publish ordering: an exception is captured inside the catch and
// the state is only touched after the catch window has closed.
template <class R, class... A>
struct __pt_callable_base {
    void (*invoke)(__pt_callable_base *, __future_state<R> *, A &&...)       = nullptr;
    void (*invoke_stash)(__pt_callable_base *, __future_state<R> *, A &&...) = nullptr;
    void (*destroy)(__pt_callable_base *)                                   = nullptr;
};

template <class F, class R, class... A>
struct __pt_callable : __pt_callable_base<R, A...> {
    F f;
    explicit __pt_callable(F &&fn) : f(std::move(fn)) { __wire(); }
    explicit __pt_callable(const F &fn) : f(fn) { __wire(); }

    void __wire()
    {
        this->invoke       = &__do<false>;
        this->invoke_stash = &__do<true>;
        this->destroy      = &__do_destroy;
    }

    // Run f(args...), capture any exception, then either publish or stash both the
    // value and the exception (the Stash flag selects which). The result is built
    // in a local buffer so the success path also publishes/stashes only AFTER the
    // catch window has closed.
    template <bool Stash>
    static void __do(__pt_callable_base<R, A...> *b, __future_state<R> *st,
                     A &&...args)
    {
        auto         *self = static_cast<__pt_callable *>(b);
        exception_ptr ep;
        if constexpr (is_void_v<R>) {
            bool ok = false;
            try {
                invoke(self->f, std::forward<A>(args)...);
                ok = true;
            } catch (...) {
                ep = current_exception();
            }
            if (ok) {
                if constexpr (Stash) st->__stash_value();
                else st->__set_value();
            } else {
                st->__claim_or_throw();
                if constexpr (Stash) {
                    st->__eptr     = std::move(ep);
                    st->__has_eptr = true;
                } else
                    st->__set_exception(std::move(ep));
            }
        } else {
            alignas(R) unsigned char buf[sizeof(R)];
            bool ok = false;
            try {
                ::new (static_cast<void *>(&buf[0]))
                    R(invoke(self->f, std::forward<A>(args)...));
                ok = true;
            } catch (...) {
                ep = current_exception();
            }
            if (ok) {
                R *rp = __builtin_launder(reinterpret_cast<R *>(&buf[0]));
                struct Drop {
                    R *p;
                    ~Drop() { p->~R(); }
                } drop{rp};
                if constexpr (Stash) st->__stash_value(std::move(*rp));
                else st->__set_value(std::move(*rp));
            } else {
                st->__claim_or_throw();
                if constexpr (Stash) {
                    st->__eptr     = std::move(ep);
                    st->__has_eptr = true;
                } else
                    st->__set_exception(std::move(ep));
            }
        }
    }
    static void __do_destroy(__pt_callable_base<R, A...> *b)
    {
        delete static_cast<__pt_callable *>(b);
    }
};

template <class R, class... A>
class packaged_task<R(A...)> {
public:
    packaged_task() noexcept = default;

    template <class F, class = enable_if_t<
                           !is_same_v<remove_cvref_t<F>, packaged_task>>>
    explicit packaged_task(F &&f)
    {
        using FD = decay_t<F>;
        __fn     = new __pt_callable<FD, R, A...>(std::forward<F>(f));
        try {
            __st = new __future_state<R>();
        } catch (...) {
            __fn->destroy(__fn);
            throw;
        }
    }

    packaged_task(const packaged_task &)            = delete;
    packaged_task &operator=(const packaged_task &) = delete;

    packaged_task(packaged_task &&o) noexcept : __fn(o.__fn), __st(o.__st)
    {
        o.__fn = nullptr;
        o.__st = nullptr;
    }
    packaged_task &operator=(packaged_task &&o) noexcept
    {
        if (this != &o) {
            __destroy();
            __fn   = o.__fn;
            __st   = o.__st;
            o.__fn = nullptr;
            o.__st = nullptr;
        }
        return *this;
    }

    ~packaged_task() { __destroy(); }

    [[nodiscard]] bool valid() const noexcept
    {
        return __fn != nullptr && __st != nullptr;
    }

    void swap(packaged_task &o) noexcept
    {
        std::swap(__fn, o.__fn);
        std::swap(__st, o.__st);
    }

    future<R> get_future()
    {
        if (!__st) throw future_error(future_errc::no_state);
        uint8_t e = 0;
        if (!__st->__future_retrieved.compare_exchange_strong(e, 1,
                                                              memory_order_acq_rel))
            throw future_error(future_errc::future_already_retrieved);
        __st->ref_inc();
        return future<R>(__st);
    }

    void operator()(A... args)
    {
        if (!__st) throw future_error(future_errc::no_state);
        if (__st->__satisfied.load(memory_order_acquire) != 0)
            throw future_error(future_errc::promise_already_satisfied);
        __fn->invoke(__fn, __st, std::forward<A>(args)...);
    }

    // Run NOW into a stash, arm the __ready publish for this strand's exit. The
    // single-set gate flips inside invoke_stash, so a 2nd call sees __satisfied.
    void make_ready_at_thread_exit(A... args)
    {
        if (!__st) throw future_error(future_errc::no_state);
        if (__st->__satisfied.load(memory_order_acquire) != 0)
            throw future_error(future_errc::promise_already_satisfied);
        __fn->invoke_stash(__fn, __st, std::forward<A>(args)...);
        __arm_thread_exit(__st);
    }

    // Re-arm with a FRESH state, keeping the stored callable ([futures.task]).
    void reset()
    {
        if (!__st) throw future_error(future_errc::no_state);
        // [futures.task]: reset is "as if *this = packaged_task(move(f))". Allocate
        // the fresh state FIRST (a throw then leaves *this unchanged), then abandon
        // the old one with broken_promise if it was never satisfied — a future
        // already retrieved from it must get broken_promise, not hang forever.
        __future_state<R> *fresh = new __future_state<R>();
        uint8_t e = 0;
        if (__st->__satisfied.compare_exchange_strong(e, 1, memory_order_acq_rel))
            __st->__set_exception(
                make_exception_ptr(future_error(future_errc::broken_promise)));
        __st->ref_dec();
        __st = fresh;
    }

private:
    void __destroy() noexcept
    {
        if (__st) {
            // Abandon an unsatisfied state (broken_promise) — a packaged_task
            // destroyed without being invoked breaks its promise.
            uint8_t e = 0;
            if (__st->__satisfied.compare_exchange_strong(e, 1,
                                                          memory_order_acq_rel))
                __st->__set_exception(make_exception_ptr(
                    future_error(future_errc::broken_promise)));
            __st->ref_dec();
            __st = nullptr;
        }
        if (__fn) {
            __fn->destroy(__fn);
            __fn = nullptr;
        }
    }

    __pt_callable_base<R, A...> *__fn = nullptr;
    __future_state<R>           *__st = nullptr;
};

template <class R, class... A>
inline void swap(packaged_task<R(A...)> &a, packaged_task<R(A...)> &b) noexcept
{
    a.swap(b);
}

// ── async ─────────────────────────────────────────────────────────────────────
//
// launch::async  — decay-copy f+args, spawn a std::thread that runs them and
//                  publishes; the thread is stored in the state so the LAST owner
//                  joins it (conformant ~future). The worker captures any
//                  exception INSIDE its catch and publishes AFTER leaving the
//                  catch (capture-then-publish, see file header).
// launch::deferred — store the decay-copied callable+args in a heap holder on the
//                  state; the first get()/wait() runs it lazily on the CALLER's
//                  strand. wait_for/wait_until return future_status::deferred
//                  WITHOUT running it.
//
// Both bits set, or the default policy, choose ASYNC ([futures.async]/3 leaves
// this implementation-defined; async is the more useful default since it makes
// real forward progress).

namespace __future_impl {

// Run the decay-copied tuple (callable first) and return the result.
template <class R, class Tup>
inline R RunTuple(Tup &t)
{
    return apply(
        [](auto &&fn, auto &&...a) -> R {
            return invoke(static_cast<decltype(fn)>(fn),
                          static_cast<decltype(a)>(a)...);
        },
        t);
}

// async worker closure: owns the decay-copied tuple + a ref to the state.
template <class R, class Tup>
struct AsyncWorker {
    Tup                __tup;
    __future_state<R> *__st;

    void operator()()
    {
        exception_ptr ep;
        if constexpr (is_void_v<R>) {
            bool ok = false;
            try {
                RunTuple<void>(__tup);
                ok = true;
            } catch (...) {
                ep = current_exception();   // capture inside the catch
            }
            // out of the catch now (__cxa_end_catch ran on THIS strand) → publish
            if (ok)
                __st->__set_value();
            else {
                __st->__claim_or_throw();
                __st->__set_exception(std::move(ep));
            }
        } else {
            alignas(R) unsigned char buf[sizeof(R)];
            bool ok = false;
            try {
                ::new (static_cast<void *>(&buf[0])) R(RunTuple<R>(__tup));
                ok = true;
            } catch (...) {
                ep = current_exception();
            }
            if (ok) {
                R *rp = __builtin_launder(reinterpret_cast<R *>(&buf[0]));
                struct Drop {
                    R *p;
                    ~Drop() { p->~R(); }
                } drop{rp};
                __st->__set_value(std::move(*rp));
            } else {
                __st->__claim_or_throw();
                __st->__set_exception(std::move(ep));
            }
        }
        // The worker holds NO refcount of its own. The state is owned by the
        // future side; the last future's ref_dec joins this worker (blocking
        // until it has fully exited — the conformant ~future of an async future)
        // and only then frees the state. A worker ref here would let the worker
        // become the last owner and join ITSELF (deadlock). The writes above are
        // safe precisely because that join cannot free the state until this
        // strand has run to exit, which is strictly after every write.
    }
};

// deferred holder: owns the decay-copied tuple, lives on the state, runs once.
template <class R, class Tup>
struct DeferredState : __future_state<R> {
    Tup __tup;
    explicit DeferredState(Tup &&t) : __tup(std::move(t))
    {
        this->__run_deferred = &Run;
    }
    static void Run(__future_state_base *base)
    {
        auto *self = static_cast<DeferredState *>(base);
        if constexpr (is_void_v<R>) {
            try {
                RunTuple<void>(self->__tup);
                self->__set_value();
            } catch (...) {
                exception_ptr ep = current_exception();
                self->__claim_or_throw();
                self->__set_exception(std::move(ep));
            }
        } else {
            try {
                self->__set_value(RunTuple<R>(self->__tup));
            } catch (...) {
                exception_ptr ep = current_exception();
                self->__claim_or_throw();
                self->__set_exception(std::move(ep));
            }
        }
    }
};

} // namespace __future_impl

template <class F, class... Args>
[[nodiscard]] future<invoke_result_t<decay_t<F>, decay_t<Args>...>>
async(launch policy, F &&f, Args &&...args)
{
    using R   = invoke_result_t<decay_t<F>, decay_t<Args>...>;
    using Tup = tuple<decay_t<F>, decay_t<Args>...>;

    const bool want_async =
        (policy & launch::async) == launch::async ||
        (policy & (launch::async | launch::deferred)) == launch{0};
    // ↑ async bit set, OR neither bit set → async (so the default async|deferred,
    //   both-bits, and an empty policy all run async). [futures.async]/3 leaves
    //   both-bits and the empty policy implementation-defined; async makes real
    //   forward progress, so it is the safe default.

    if (want_async) {
        // refs starts at 1 — that single ref is the returned future's. The worker
        // holds NO ref of its own: the state is owned by the future side, and the
        // last future's ref_dec joins the worker (blocking until it finishes — the
        // conformant ~future of an async future) before freeing. See AsyncWorker.
        __future_state<R> *st = new __future_state<R>();
        try {
            __future_impl::AsyncWorker<R, Tup> w{
                Tup{forward<F>(f), forward<Args>(args)...}, st};
            // Move the worker thread INTO the state so the last owner joins it.
            thread worker(std::move(w));
            st->__worker = std::move(worker);
        } catch (...) {
            // Spawn (or arg decay-copy) failed: no worker ran, so just free the
            // state. Its __worker is still default-constructed, so the join in
            // ref_dec is a no-op.
            st->ref_dec();
            throw;
        }
        return future<R>(st);
    }

    // deferred
    using DS               = __future_impl::DeferredState<R, Tup>;
    DS *st                 = new DS(Tup{forward<F>(f), forward<Args>(args)...});
    return future<R>(st);
}

template <class F, class... Args>
[[nodiscard]] future<invoke_result_t<decay_t<F>, decay_t<Args>...>>
async(F &&f, Args &&...args)
{
    return async(launch::async | launch::deferred, forward<F>(f),
                 forward<Args>(args)...);
}

