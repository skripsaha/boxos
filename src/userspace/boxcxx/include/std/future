// set_value_at_thread_exit / set_exception_at_thread_exit / packaged_task::
// make_ready_at_thread_exit defer the __ready publish to this strand's
// thread_local destructor drain (Itanium __cxa_thread_atexit, run by
// __boxcxx_thread_storage_exit when the strand ends) — forward-declared the same
// way <condition_variable> declares it for notify_all_at_thread_exit.
extern "C" int __cxa_thread_atexit(void (*fn)(void *), void *arg, void *dso);

namespace std {

// ── future_errc / future_category / future_error ───────────────────────────────
//
// An honest fresh enumeration with its own fresh category — NOT an alias of the
// generic/system category, so &future_category() is distinct from both. The
// category is a function-local static singleton (object identity is its identity,
// valid in a single static image), so no extra .cpp TU is needed.

enum class future_errc {
    broken_promise            = 1,
    future_already_retrieved  = 2,
    promise_already_satisfied = 3,
    no_state                  = 4
};

template <>
struct is_error_code_enum<future_errc> : true_type {};

namespace __future_impl {

class FutureCategory final : public error_category {
public:
    const char *name() const noexcept override { return "future"; }

    string message(int code) const override
    {
        switch (static_cast<future_errc>(code)) {
        case future_errc::broken_promise:
            return "broken promise: the producing strand abandoned the shared "
                   "state before a result was set";
        case future_errc::future_already_retrieved:
            return "future already retrieved from this promise";
        case future_errc::promise_already_satisfied:
            return "promise already satisfied: a result was already set";
        case future_errc::no_state:
            return "no associated shared state";
        default:
            return "unknown future error";
        }
    }
};

} // namespace __future_impl

inline const error_category &future_category() noexcept
{
    static __future_impl::FutureCategory __cat;
    return __cat;
}

inline error_code make_error_code(future_errc e) noexcept
{
    return error_code(static_cast<int>(e), future_category());
}
inline error_condition make_error_condition(future_errc e) noexcept
{
    return error_condition(static_cast<int>(e), future_category());
}

// logic_error stores only a what() string, so future_error carries its own
// error_code member and builds the logic_error base from the category message.
class future_error : public logic_error {
public:
    explicit future_error(future_errc e)
        : logic_error(future_category().message(static_cast<int>(e))),
          __ec(make_error_code(e))
    {
    }
    explicit future_error(error_code ec)
        : logic_error(ec.message()), __ec(ec)
    {
    }

    const error_code &code() const noexcept { return __ec; }

private:
    error_code __ec;
};

// ── future_status / launch ─────────────────────────────────────────────────────

enum class future_status { ready, timeout, deferred };

enum class launch { async = 1, deferred = 2 };

// launch is a bitmask type ([futures.async]): launch::async | launch::deferred
// must be well-formed. Provide the full set of bitmask operators.
constexpr launch operator|(launch a, launch b) noexcept
{
    return static_cast<launch>(static_cast<int>(a) | static_cast<int>(b));
}
constexpr launch operator&(launch a, launch b) noexcept
{
    return static_cast<launch>(static_cast<int>(a) & static_cast<int>(b));
}
constexpr launch operator^(launch a, launch b) noexcept
{
    return static_cast<launch>(static_cast<int>(a) ^ static_cast<int>(b));
}
constexpr launch operator~(launch a) noexcept
{
    return static_cast<launch>(~static_cast<int>(a));
}
constexpr launch &operator|=(launch &a, launch b) noexcept { return a = a | b; }
constexpr launch &operator&=(launch &a, launch b) noexcept { return a = a & b; }
constexpr launch &operator^=(launch &a, launch b) noexcept { return a = a ^ b; }

// ── shared state ────────────────────────────────────────────────────────────────
//
// Refcounted by hand exactly like __stop_state: __refs starts at 1, every owner
// (promise/future/shared_future/packaged_task/the async worker) ref_inc()s, and
// the party whose ref_dec() reaches 0 frees it. ref_dec joins the async worker
// FIRST (if armed) — that is the conformant ~future blocking join — then deletes.
// The value lives in the derived __future_state<T>, so the dtor is virtual.

struct __future_state_base {
    atomic<uint32_t> __refs{1};

    // The wake word: 0 = result not yet published, 1 = published. Width 4, mask
    // ~0 — the producer's release-store pairs with a waiter's acquire-load.
    atomic<uint32_t> __ready{0};

    // Single-set gate (CAS 0→1); the loser of set_value/set_exception throws
    // promise_already_satisfied. SEPARATE from __ready: __satisfied flips when a
    // producer claims the right to set, __ready flips when the value is visible
    // and a waiter may proceed (the at_thread_exit paths set __satisfied now but
    // publish __ready later).
    atomic<uint8_t> __satisfied{0};

    // get_future single-issue gate (CAS 0→1) — a 2nd get_future throws
    // future_already_retrieved. This is NOT consulted by future::get()/wait():
    // a future is single-use because get() nulls its own handle, not because of
    // this shared flag.
    atomic<uint8_t> __future_retrieved{0};

    exception_ptr __eptr;
    bool          __has_eptr = false;

    // async-join: the worker std::thread is moved in here so the LAST owner joins
    // it exactly once. __join_owner is the exactly-once CAS guard.
    thread          __worker;
    atomic<uint8_t> __join_owner{0};

    // deferred: the lazy run, forced by the first get()/wait() on the GET caller's
    // strand. __run_deferred is the type-erased runner (set by async's deferred
    // path); __deferred_ran is the single-run CAS guard.
    atomic<uint8_t> __deferred_ran{0};
    void (*__run_deferred)(__future_state_base *) = nullptr;

    virtual ~__future_state_base() = default;

    void ref_inc() noexcept { __refs.fetch_add(1u, memory_order_acq_rel); }
    void ref_dec() noexcept
    {
        if (__refs.fetch_sub(1u, memory_order_acq_rel) == 1u) {
            __join_if_armed();   // conformant ~future blocking join (last owner)
            delete this;
        }
    }

    // Join the async worker exactly once. Only the owner that wins __join_owner
    // (and finds a joinable worker) blocks here; everyone else returns at once.
    // The last ref_dec may run on a different strand than async(); it observes the
    // fully-written __worker because every cross-strand handle transfer passes
    // through an acq_rel __refs RMW (the state is reachable only via ref_inc/dec).
    void __join_if_armed()
    {
        uint8_t e = 0;
        if (__join_owner.compare_exchange_strong(e, 1, memory_order_acq_rel) &&
            __worker.joinable())
            __worker.join();
    }

    // Claim the right to publish a result; the loser throws. Used by every
    // set_value/set_exception entry (immediate and at_thread_exit).
    void __claim_or_throw()
    {
        uint8_t e = 0;
        if (!__satisfied.compare_exchange_strong(e, 1, memory_order_acq_rel))
            throw future_error(future_errc::promise_already_satisfied);
    }

    // Make the stored result visible and wake every parked waiter.
    void __publish() noexcept
    {
        __ready.store(1, memory_order_release);
        __boxcxx_atomic_notify(&__ready, true);
    }

    // Store an exception and publish (immediate path). Precondition: caller won
    // __claim_or_throw (or this is the abandon path, which CAS-guards itself).
    void __set_exception(exception_ptr p) noexcept
    {
        __eptr     = std::move(p);
        __has_eptr = true;
        __publish();
    }

    bool __is_ready() const noexcept
    {
        return __ready.load(memory_order_acquire) != 0;
    }

    // Untimed wait: park on __ready until the producer publishes. Forces a
    // deferred run first (the lazy result is produced on THIS strand).
    void __wait()
    {
        __run_deferred_if_any();
        unsigned spin = 0;
        uint32_t zero = 0;
        while (__ready.load(memory_order_acquire) == 0)
            __boxcxx_atomic_wait_cycle(&__ready, &zero, sizeof(uint32_t), ~0ull,
                                       &spin);
    }

    // Timed wait ([futures.state]): a not-yet-run deferred function reports
    // future_status::deferred WITHOUT running it; otherwise park on __ready with
    // the remaining budget — a publish wakes us early, the deadline is exact.
    template <class Clock, class Duration>
    future_status __wait_until(const chrono::time_point<Clock, Duration> &abs)
    {
        if (__run_deferred != nullptr &&
            __deferred_ran.load(memory_order_acquire) == 0)
            return future_status::deferred;

        unsigned spin = 0;
        uint32_t zero = 0;
        for (;;) {
            if (__ready.load(memory_order_acquire) != 0)
                return future_status::ready;
            unsigned ms = __mutex_impl::RemainingMs(abs);
            if (ms == 0) return future_status::timeout;
            __boxcxx_atomic_wait_until(&__ready, &zero, 4, ~0ull, ms, &spin);
        }
    }

    // Force the deferred function exactly once, on the caller's strand.
    void __run_deferred_if_any()
    {
        if (__run_deferred == nullptr) return;
        uint8_t e = 0;
        if (__deferred_ran.compare_exchange_strong(e, 1, memory_order_acq_rel))
            __run_deferred(this);
    }
};

// Value-carrying state. The value lives in an aligned buffer placement-new'd on
// set and destroyed in the dtor (guarded by __has_value).
template <class T>
struct __future_state : __future_state_base {
    alignas(T) unsigned char __buf[sizeof(T)];
    bool __has_value = false;

    ~__future_state() override
    {
        if (__has_value) __ptr()->~T();
    }

    T *__ptr() noexcept
    {
        return __builtin_launder(reinterpret_cast<T *>(&__buf[0]));
    }

    // Construct OFF TO THE SIDE first, then claim the single-set gate, then move
    // into the shared buffer. A throwing copy/move of T therefore leaves the
    // state UNCLAIMED (retryable, or broken_promise on abandon) instead of
    // wedging a satisfied-but-never-ready state, and a losing 2nd set throws
    // BEFORE the already-published buffer is touched ([futures.promise]). The one
    // residual is a throwing MOVE of T after the claim — pathological, since all
    // std result types are noexcept-move.
    void __set_value(const T &v)
    {
        T tmp(v);
        __claim_or_throw();
        ::new (static_cast<void *>(&__buf[0])) T(std::move(tmp));
        __has_value = true;
        __publish();
    }
    void __set_value(T &&v)
    {
        T tmp(std::move(v));
        __claim_or_throw();
        ::new (static_cast<void *>(&__buf[0])) T(std::move(tmp));
        __has_value = true;
        __publish();
    }

    // at_thread_exit: construct + claim NOW (same construct-then-claim discipline
    // as __set_value), publish later. The store happens-before the deferred
    // __publish (same strand, sequenced), so the release in __publish carries it.
    void __stash_value(const T &v)
    {
        T tmp(v);
        __claim_or_throw();
        ::new (static_cast<void *>(&__buf[0])) T(std::move(tmp));
        __has_value = true;
    }
    void __stash_value(T &&v)
    {
        T tmp(std::move(v));
        __claim_or_throw();
        ::new (static_cast<void *>(&__buf[0])) T(std::move(tmp));
        __has_value = true;
    }

    // Read out the value after a successful wait. future::get MOVES; shared_future
    // returns a const reference.
    T &&__take() { return std::move(*__ptr()); }
    const T &__ref() { return *__ptr(); }
};

// Reference state: store the pointer.
template <class T>
struct __future_state<T &> : __future_state_base {
    T *__p = nullptr;

    void __set_value(T &v)
    {
        __claim_or_throw();
        __p = __builtin_addressof(v);
        __publish();
    }
    void __stash_value(T &v)
    {
        __claim_or_throw();
        __p = __builtin_addressof(v);
    }
    T &__take() { return *__p; }
    T &__ref() { return *__p; }
};

// void state: flag-only.
template <>
struct __future_state<void> : __future_state_base {
    void __set_value()
    {
        __claim_or_throw();
        __publish();
    }
    void __stash_value()
    {
        __claim_or_throw();
    }
};

// Rethrow the stored exception if there is one, after a successful wait.
inline void __rethrow_if_stored(__future_state_base *st)
{
    if (st->__has_eptr) rethrow_exception(st->__eptr);
}

// ── forward declarations ────────────────────────────────────────────────────────

// Arm a deferred __ready publish on the calling strand's thread_local exit drain
// (defined after the promise classes; declared here so they can call it).
inline void __arm_thread_exit(__future_state_base *st);

template <class T> class future;
template <class T> class shared_future;
template <class T> class promise;
template <class> class packaged_task;

// ── future<T> ─────────────────────────────────────────────────────────────────
//
// Single-use: get() waits, rethrows the stored exception or MOVES the value out,
// then releases its own handle so a 2nd get()/wait() throws no_state. The
// ctor-from-state is private and friended to its producers.

template <class T>
class future {
public:
    future() noexcept = default;

    future(const future &)            = delete;
    future &operator=(const future &) = delete;

    future(future &&o) noexcept : __st(o.__st) { o.__st = nullptr; }
    future &operator=(future &&o) noexcept
    {
        if (this != &o) {
            __release();
            __st   = o.__st;
            o.__st = nullptr;
        }
        return *this;
    }

    ~future() { __release(); }

    [[nodiscard]] bool valid() const noexcept { return __st != nullptr; }

    T get()
    {
        if (!__st) throw future_error(future_errc::no_state);
        __st->__wait();
        // Detach the state from this future BEFORE handing the value out, so the
        // future is single-use even if the move/rethrow below escapes.
        __future_state<T> *st = static_cast<__future_state<T> *>(__st);
        __st                  = nullptr;
        struct Drop {
            __future_state<T> *p;
            ~Drop() { p->ref_dec(); }
        } drop{st};
        __rethrow_if_stored(st);
        return st->__take();
    }

    void wait() const
    {
        if (!__st) throw future_error(future_errc::no_state);
        __st->__wait();
    }
    template <class Rep, class Period>
    future_status wait_for(const chrono::duration<Rep, Period> &rel) const
    {
        if (!__st) throw future_error(future_errc::no_state);
        return __st->__wait_until(chrono::steady_clock::now() + rel);
    }
    template <class Clock, class Duration>
    future_status wait_until(const chrono::time_point<Clock, Duration> &abs) const
    {
        if (!__st) throw future_error(future_errc::no_state);
        return __st->__wait_until(abs);
    }

    shared_future<T> share() noexcept;

private:
    friend class promise<T>;
    friend class shared_future<T>;
    template <class> friend class packaged_task;
    template <class F, class... A>
    friend future<invoke_result_t<decay_t<F>, decay_t<A>...>> async(launch, F &&,
                                                                    A &&...);

    explicit future(__future_state<T> *st) noexcept : __st(st) {}

    void __release() noexcept
    {
        if (__st) {
            __st->ref_dec();
            __st = nullptr;
        }
    }

    __future_state_base *__st = nullptr;
};

