// ── promise<T> ────────────────────────────────────────────────────────────────
//
// move-only producer. The ctor allocates a fresh state (refs=1); get_future hands
// out a future (ref_inc) under a single-issue gate; set_value/set_exception
// publish once; the dtor abandons (broken_promise) an unsatisfied state.
//
// uses_allocator support: the (allocator_arg_t, const Alloc&) ctors are accepted
// for conformance but the allocator is a NO-OP — every state is global-new
// allocated (consistent with the rest of boxcxx, which does not thread custom
// allocators through its concurrency state). Documented deviation.

template <class T>
class promise {
public:
    promise() : __st(new __future_state<T>()) {}
    template <class Alloc>
    promise(allocator_arg_t, const Alloc &) : __st(new __future_state<T>())
    {
    }

    promise(const promise &)            = delete;
    promise &operator=(const promise &) = delete;

    promise(promise &&o) noexcept : __st(o.__st) { o.__st = nullptr; }
    promise &operator=(promise &&o) noexcept
    {
        if (this != &o) {
            __abandon_and_release();
            __st   = o.__st;
            o.__st = nullptr;
        }
        return *this;
    }

    ~promise() { __abandon_and_release(); }

    void swap(promise &o) noexcept { std::swap(__st, o.__st); }

    future<T> get_future()
    {
        if (!__st) throw future_error(future_errc::no_state);
        uint8_t e = 0;
        if (!__st->__future_retrieved.compare_exchange_strong(e, 1,
                                                              memory_order_acq_rel))
            throw future_error(future_errc::future_already_retrieved);
        __st->ref_inc();
        return future<T>(__st);
    }

    void set_value(const T &v)
    {
        if (!__st) throw future_error(future_errc::no_state);
        __st->__set_value(v);
    }
    void set_value(T &&v)
    {
        if (!__st) throw future_error(future_errc::no_state);
        __st->__set_value(std::move(v));
    }

    void set_exception(exception_ptr p)
    {
        if (!__st) throw future_error(future_errc::no_state);
        __st->__claim_or_throw();
        __st->__set_exception(std::move(p));
    }

    // Claim + store NOW (a 2nd set throws immediately), publish at strand exit.
    void set_value_at_thread_exit(const T &v)
    {
        if (!__st) throw future_error(future_errc::no_state);
        __st->__stash_value(v);
        __arm_thread_exit(__st);
    }
    void set_value_at_thread_exit(T &&v)
    {
        if (!__st) throw future_error(future_errc::no_state);
        __st->__stash_value(std::move(v));
        __arm_thread_exit(__st);
    }
    void set_exception_at_thread_exit(exception_ptr p)
    {
        if (!__st) throw future_error(future_errc::no_state);
        __st->__claim_or_throw();
        __st->__eptr     = std::move(p);
        __st->__has_eptr = true;
        __arm_thread_exit(__st);
    }

private:
    void __abandon_and_release() noexcept
    {
        if (!__st) return;
        // Unsatisfied at destruction ⇒ break the promise. CAS-guarded so it is a
        // no-op if a producer already claimed (the claim's publish wins).
        uint8_t e = 0;
        if (__st->__satisfied.compare_exchange_strong(e, 1, memory_order_acq_rel))
            __st->__set_exception(
                make_exception_ptr(future_error(future_errc::broken_promise)));
        __st->ref_dec();
        __st = nullptr;
    }

    __future_state<T> *__st = nullptr;
};

