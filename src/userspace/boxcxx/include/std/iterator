// boxcxx — <iterator>
// Grows __bits/iterator_core into the full header: C++20 iterator
// concepts + associated-type aliases, move_iterator, counted_iterator, the
// inserter family, default/unreachable sentinels, the ranges::iter_move/
// iter_swap CPOs, and (Ф29a) the indirect-callable foundation: projected +
// indirect_result_t, the indirect-callable / indirect-movement / algorithm-
// requirement concepts, and common_iterator.
//
// Deferred (epic leftovers): istream/ostream iterators (Ф9B).
#ifndef BOXCXX_ITERATOR
#define BOXCXX_ITERATOR

#include <__bits/iterator_core>
#include <__bits/pointer>
#include <compare>
#include <concepts>
#include <cstddef>
#include <functional>
#include <new>
#include <type_traits>
#include <utility>

namespace std {

// ── incrementable_traits ([incrementable.traits]) ───────────────────────
// Supplies difference_type for weakly_incrementable when the type is not a
// full iterator carrying iterator_traits — most importantly bare integral
// values, so iota_view<int> can satisfy weakly_incrementable<int> (whose
// difference type is otherwise ill-formed under the iterator_traits-only
// resolution below). Shape mirrors the standard's constrained partial
// specializations; `<const I>` is preferred over the constrained `<T>`
// forms by partial-ordering, so a cv-qualified type resolves once.
template <typename>
struct incrementable_traits {};

template <typename T>
    requires is_object_v<T>
struct incrementable_traits<T *> {
    using difference_type = ptrdiff_t;
};

template <typename I>
struct incrementable_traits<const I> : incrementable_traits<I> {};

template <typename T>
    requires requires { typename T::difference_type; }
struct incrementable_traits<T> {
    using difference_type = typename T::difference_type;
};

template <typename T>
    requires(!requires { typename T::difference_type; }) &&
            requires(const T &a, const T &b) {
                { a - b } -> integral;
            }
struct incrementable_traits<T> {
    using difference_type =
        make_signed_t<decltype(declval<T>() - declval<T>())>;
};

// ── associated types ([iterator.assoc.types]) ───────────────────────────

namespace __iter_impl {

template <typename I>
concept HasTraitsDifference =
    requires { typename iterator_traits<I>::difference_type; };
template <typename I>
concept HasTraitsValue = requires { typename iterator_traits<I>::value_type; };
template <typename I>
concept HasIncrementableDiff =
    requires { typename incrementable_traits<remove_cvref_t<I>>::difference_type; };

// iter_difference_t resolution ([iterator.traits]): a genuine iterator
// carries iterator_traits::difference_type (pointer spec, or a type whose
// five member typedefs synthesised the traits) — use it verbatim, keeping
// every existing result unchanged. Only when that is absent (a bare
// incrementable such as int) do we consult incrementable_traits.
template <typename I>
auto DiffTypeOf()
{
    if constexpr (HasTraitsDifference<I>)
        return type_identity<typename iterator_traits<I>::difference_type>{};
    else
        return type_identity<
            typename incrementable_traits<remove_cvref_t<I>>::difference_type>{};
}

} // namespace __iter_impl

template <typename I>
    requires(__iter_impl::HasTraitsDifference<I> ||
             __iter_impl::HasIncrementableDiff<I>)
using iter_difference_t = typename decltype(__iter_impl::DiffTypeOf<I>())::type;

template <typename I>
    requires __iter_impl::HasTraitsValue<I>
using iter_value_t = typename iterator_traits<I>::value_type;

template <typename I>
    requires requires(I &i) { *i; }
using iter_reference_t = decltype(*declval<I &>());

// ranges::iter_move's CPO is defined here — rather than alongside
// ranges::iter_swap's, later in this file — because iter_rvalue_reference_t
// directly below needs it: `ranges::iter_move` is a non-dependent qualified
// name, resolved by ordinary qualified lookup at the point this alias
// template is PARSED, not deferred to instantiation the way an unqualified,
// ADL-eligible call would be. So it must already be declared here, in the
// source text, full stop — no amount of "declare it later and let ADL find
// it" helps, because there is no ADL step in a qualified call at all.
// iter_swap has no equivalent early dependent and stays at its original
// position, alongside advance/next/prev/distance.
namespace ranges {

namespace __iter_move {
void iter_move(); // poison pill — force ADL-only lookup of the customisation
template <class I>
concept HasAdl = requires(I &&i) { iter_move(static_cast<I &&>(i)); };

// noexcept mirrors [iterator.cust.move]/1: expression-equivalent to the ADL
// call when one exists, else to *E (both branches of the *E fallback share
// one noexcept — std::move is always noexcept, so the lvalue/rvalue split
// below doesn't matter here).
template <class I>
constexpr bool NoexceptOf()
{
    if constexpr (HasAdl<I>)
        return noexcept(iter_move(declval<I &&>()));
    else
        return noexcept(*declval<I &&>());
}

struct Fn {
    template <class I>
    constexpr decltype(auto) operator()(I &&i) const noexcept(NoexceptOf<I>())
    {
        if constexpr (HasAdl<I>)
            return iter_move(static_cast<I &&>(i));
        else if constexpr (is_lvalue_reference_v<decltype(*static_cast<I &&>(
                               i))>)
            return static_cast<remove_reference_t<decltype(*static_cast<I &&>(
                i))> &&>(*static_cast<I &&>(i));
        else
            return *static_cast<I &&>(i);
    }
};
} // namespace __iter_move
inline namespace __cpo {
inline constexpr __iter_move::Fn iter_move{};
}

} // namespace ranges

// fixed per [readable.traits] / LWG 2106 (a prvalue-returning base iterator,
// e.g. a proxy view's operator*, must not synthesize a dangling
// reference-typed alias here) — routes through the customization point
// instead of a hand-rolled move(*i), so a wrapped proxy's own ADL iter_move
// participates instead of silently downgrading to a reference into a
// temporary that's already gone.
template <typename I>
    requires requires(I &i) { ranges::iter_move(i); }
using iter_rvalue_reference_t = decltype(ranges::iter_move(declval<I &>()));

// ── iterator concepts ([iterator.concepts]) ─────────────────────────────

namespace __iter_impl {
// [iterator.concept.readable]: indirectly_readable is defined over
// remove_cvref_t<In>, so a const/ref-qualified iterator type still reads as
// readable (its value/reference come from the unqualified iterator). boxcxx
// keeps the rest simplified (no common_reference clause — a documented epic
// simplification), but the cvref strip is load-bearing: without it
// indirectly_swappable's own `requires(const I1 i1)` probe — and the
// iter_swap CPO — reject `const I` operands.
template <typename I>
concept IndirectlyReadableImpl = requires(const I i) {
    typename iter_value_t<I>;
    typename iter_reference_t<I>;
    { *i } -> same_as<iter_reference_t<I>>;
};
} // namespace __iter_impl

template <typename In>
concept indirectly_readable =
    __iter_impl::IndirectlyReadableImpl<remove_cvref_t<In>>;

// [iterator.concept.writable]: the two const_cast expressions reject
// iterators with prvalue non-proxy reference types that permit rvalue
// assignment but not also CONST rvalue assignment (Note 2) — e.g. an
// iterator returning std::string by value must NOT model
// indirectly_writable<I, std::string>. This is what correctly distinguishes
// zip/adjacent/cartesian's all-reference proxy tuples (writable — P2321's
// const-qualified tuple::operator= makes const_cast<const tuple<T&,...>&&>
// still assign through the references) from enumerate_view's MIXED
// tuple<difference_type, T&> (not writable — no const-qualified assignment
// can write through a genuine const value member).
template <typename Out, typename T>
concept indirectly_writable = requires(Out &&o, T &&t) {
    *o = std::forward<T>(t);
    *std::forward<Out>(o) = std::forward<T>(t);
    const_cast<const iter_reference_t<Out> &&>(*o) = std::forward<T>(t);
    const_cast<const iter_reference_t<Out> &&>(*std::forward<Out>(o)) =
        std::forward<T>(t);
};

template <typename I>
concept weakly_incrementable = movable<I> && requires(I i) {
    typename iter_difference_t<I>;
    requires signed_integral<iter_difference_t<I>>;
    { ++i } -> same_as<I &>;
    i++;
};

template <typename I>
concept incrementable = regular<I> && weakly_incrementable<I> &&
                        requires(I i) {
                            { i++ } -> same_as<I>;
                        };

template <typename I>
concept input_or_output_iterator = requires(I i) {
    *i;
} && weakly_incrementable<I>;

template <typename S, typename I>
concept sentinel_for = semiregular<S> && input_or_output_iterator<I> &&
                       requires(const I &i, const S &s) {
                           { i == s } -> convertible_to<bool>;
                       };

template <typename S, typename I>
inline constexpr bool disable_sized_sentinel_for = false;

template <typename S, typename I>
concept sized_sentinel_for =
    sentinel_for<S, I> &&
    !disable_sized_sentinel_for<remove_cv_t<S>, remove_cv_t<I>> &&
    requires(const I &i, const S &s) {
        { s - i } -> same_as<iter_difference_t<I>>;
        { i - s } -> same_as<iter_difference_t<I>>;
    };

namespace __iter_impl {

template <typename I>
concept HasCategory =
    requires { typename iterator_traits<I>::iterator_category; };

template <typename I, typename Tag>
concept CategoryAtLeast =
    HasCategory<I> &&
    derived_from<typename iterator_traits<I>::iterator_category, Tag>;

} // namespace __iter_impl

namespace __iter_impl {

// ITER_CONCEPT(I) ([iterator.concepts.general]): I::iterator_concept, else
// iterator_traits<I>::iterator_concept, else iterator_traits<I>::
// iterator_category. The two probes below make forming IterConcept<I> a
// genuine substitution failure (not a hard error) when I has none of the
// three members — load-bearing for input_iterator's own
// "requires { typename IterConcept<I>; }" guard just below: without the
// requires-clause on the alias template, the else-branch of
// IterConceptHelper would name iterator_traits<I>::iterator_category
// unconditionally, which is a hard error (not SFINAE) when nothing at all
// is declared.
template <typename I>
concept HasIterConceptMember = requires { typename I::iterator_concept; };
template <typename I>
concept HasTraitsIterConcept =
    requires { typename iterator_traits<I>::iterator_concept; };

template <class I>
constexpr auto IterConceptHelper()
{
    if constexpr (HasIterConceptMember<I>)
        return type_identity<typename I::iterator_concept>{};
    else if constexpr (HasTraitsIterConcept<I>)
        return type_identity<typename iterator_traits<I>::iterator_concept>{};
    else
        return type_identity<typename iterator_traits<I>::iterator_category>{};
}
template <class I>
    requires HasIterConceptMember<I> || HasTraitsIterConcept<I> || HasCategory<I>
using IterConcept = typename decltype(IterConceptHelper<I>())::type;

} // namespace __iter_impl

template <typename I>
concept input_iterator =
    input_or_output_iterator<I> && indirectly_readable<I> &&
    requires { typename __iter_impl::IterConcept<I>; } &&
    derived_from<__iter_impl::IterConcept<I>, input_iterator_tag>;

template <typename I, typename T>
concept output_iterator =
    input_or_output_iterator<I> && indirectly_writable<I, T> &&
    requires(I i, T &&t) { *i++ = std::forward<T>(t); };

template <typename I>
concept forward_iterator =
    input_iterator<I> &&
    derived_from<__iter_impl::IterConcept<I>, forward_iterator_tag> &&
    incrementable<I> && sentinel_for<I, I>;

template <typename I>
concept bidirectional_iterator =
    forward_iterator<I> &&
    derived_from<__iter_impl::IterConcept<I>, bidirectional_iterator_tag> &&
    requires(I i) {
        { --i } -> same_as<I &>;
        { i-- } -> same_as<I>;
    };

template <typename I>
concept random_access_iterator =
    bidirectional_iterator<I> &&
    derived_from<__iter_impl::IterConcept<I>, random_access_iterator_tag> &&
    totally_ordered<I> && sized_sentinel_for<I, I> &&
    requires(I i, const I j, const iter_difference_t<I> n) {
        { i += n } -> same_as<I &>;
        { j + n } -> same_as<I>;
        { n + j } -> same_as<I>;
        { i -= n } -> same_as<I &>;
        { j - n } -> same_as<I>;
        { j[n] } -> same_as<iter_reference_t<I>>;
    };

template <typename I>
concept contiguous_iterator =
    random_access_iterator<I> &&
    derived_from<__iter_impl::IterConcept<I>, contiguous_iterator_tag> &&
    is_lvalue_reference_v<iter_reference_t<I>> &&
    same_as<iter_value_t<I>, remove_cvref_t<iter_reference_t<I>>> &&
    requires(const I &i) {
        { std::to_address(i) } -> same_as<add_pointer_t<iter_reference_t<I>>>;
    };

// ── reverse_iterator's iterator_concept ([reverse.iterator]) ─────────────
// reverse_iterator itself lives in __bits/iterator_core (textually before
// the four concepts above, and included standalone by containers that want
// the pre-C++20 substrate without the concept machinery) — its class body
// carries only the five legacy iterator_traits members, no iterator_concept.
// Rather than move the class (which would drag every such container into
// depending on <concepts>), this dedicated specialization — the same
// mechanism common_iterator's and counted_iterator's own specializations
// use — supplies iterator_concept (and the iterator_category RA-cap) from
// here, where random_access_iterator/bidirectional_iterator are already in
// scope. reverse_iterator's own class body stays untouched.
template <typename It>
struct iterator_traits<reverse_iterator<It>> {
    using iterator_concept = conditional_t<random_access_iterator<It>,
                                           random_access_iterator_tag,
                                           bidirectional_iterator_tag>;
    using iterator_category = conditional_t<
        derived_from<typename reverse_iterator<It>::iterator_category,
                     random_access_iterator_tag>,
        random_access_iterator_tag, typename reverse_iterator<It>::iterator_category>;
    using value_type      = typename reverse_iterator<It>::value_type;
    using difference_type = typename reverse_iterator<It>::difference_type;
    using pointer          = typename reverse_iterator<It>::pointer;
    using reference         = typename reverse_iterator<It>::reference;
};

// ── sentinels ───────────────────────────────────────────────────────────

struct default_sentinel_t {};
inline constexpr default_sentinel_t default_sentinel{};

struct unreachable_sentinel_t {
    template <weakly_incrementable I>
    friend constexpr bool operator==(unreachable_sentinel_t, const I &) noexcept
    {
        return false;
    }
};
inline constexpr unreachable_sentinel_t unreachable_sentinel{};

// ── move_iterator ([move.iterators]) ────────────────────────────────────

// iter_move/iter_swap hidden friends ([move.iter.elem]) are deliberately NOT
// added here: they would need to call ranges::iter_move/ranges::iter_swap,
// but those CPOs are defined LATER in this same file (below), so the names
// are not yet declared at this point — the identical layering blocker
// __bits/iterator_core's reverse_iterator hits (see <iterator>'s
// iterator_traits<reverse_iterator<It>> specialization), just from file
// order within <iterator> itself rather than a cross-file split. Without the
// hidden friends, ranges::iter_move/iter_swap on a move_iterator still fall
// through to the CPOs' own generic (correct) fallback — the only loss is a
// wrapped iterator's own custom iter_move/iter_swap not participating.
// Deferred to Ф29f-3 alongside reverse_iterator's identical gap.
template <typename It>
class move_iterator {
public:
    using iterator_type    = It;
    using iterator_concept = conditional_t<
        random_access_iterator<It>, random_access_iterator_tag,
        conditional_t<bidirectional_iterator<It>, bidirectional_iterator_tag,
                      conditional_t<forward_iterator<It>, forward_iterator_tag,
                                    input_iterator_tag>>>;
    using iterator_category = conditional_t<
        derived_from<typename iterator_traits<It>::iterator_category,
                     random_access_iterator_tag>,
        random_access_iterator_tag, typename iterator_traits<It>::iterator_category>;
    using value_type        = typename iterator_traits<It>::value_type;
    using difference_type   = typename iterator_traits<It>::difference_type;
    using pointer           = It;
    using reference         = iter_rvalue_reference_t<It>;

    constexpr move_iterator() : __cur() {}
    constexpr explicit move_iterator(It it) : __cur(std::move(it)) {}
    template <typename U>
        requires(!is_same_v<U, It> && is_convertible_v<const U &, It>)
    constexpr move_iterator(const move_iterator<U> &other)
        : __cur(other.base())
    {
    }

    constexpr const It &base() const & noexcept { return __cur; }
    constexpr It base() && { return std::move(__cur); }

    constexpr reference operator*() const { return ranges::iter_move(__cur); }
    constexpr reference operator[](difference_type n) const
    {
        return std::move(__cur[n]);
    }

    constexpr move_iterator &operator++()
    {
        ++__cur;
        return *this;
    }
    constexpr move_iterator operator++(int)
    {
        move_iterator tmp = *this;
        ++__cur;
        return tmp;
    }
    constexpr move_iterator &operator--()
    {
        --__cur;
        return *this;
    }
    constexpr move_iterator operator--(int)
    {
        move_iterator tmp = *this;
        --__cur;
        return tmp;
    }
    constexpr move_iterator operator+(difference_type n) const
    {
        return move_iterator(__cur + n);
    }
    constexpr move_iterator operator-(difference_type n) const
    {
        return move_iterator(__cur - n);
    }
    constexpr move_iterator &operator+=(difference_type n)
    {
        __cur += n;
        return *this;
    }
    constexpr move_iterator &operator-=(difference_type n)
    {
        __cur -= n;
        return *this;
    }

private:
    It __cur;
};

template <typename A, typename B>
constexpr bool operator==(const move_iterator<A> &a, const move_iterator<B> &b)
{
    return a.base() == b.base();
}
template <typename A, typename B>
constexpr bool operator!=(const move_iterator<A> &a, const move_iterator<B> &b)
{
    return !(a.base() == b.base());
}
template <typename A, typename B>
constexpr bool operator<(const move_iterator<A> &a, const move_iterator<B> &b)
{
    return a.base() < b.base();
}
template <typename A, typename B>
constexpr bool operator>(const move_iterator<A> &a, const move_iterator<B> &b)
{
    return b.base() < a.base();
}
template <typename A, typename B>
constexpr bool operator<=(const move_iterator<A> &a, const move_iterator<B> &b)
{
    return !(b.base() < a.base());
}
template <typename A, typename B>
constexpr bool operator>=(const move_iterator<A> &a, const move_iterator<B> &b)
{
    return !(a.base() < b.base());
}
template <typename A, typename B>
constexpr auto operator-(const move_iterator<A> &a, const move_iterator<B> &b)
    -> decltype(a.base() - b.base())
{
    return a.base() - b.base();
}
template <typename It>
constexpr move_iterator<It> operator+(typename move_iterator<It>::difference_type n,
                                      const move_iterator<It> &it)
{
    return it + n;
}

template <typename It>
constexpr move_iterator<It> make_move_iterator(It it)
{
    return move_iterator<It>(std::move(it));
}

// ── move_sentinel ([move.sentinel]) ─────────────────────────────────────
// The sentinel companion to move_iterator: wraps an underlying sentinel so
// a move_iterator can be bounded by a non-iterator end (as_rvalue_view over
// a non-common range hands one of these back from end()).

template <semiregular S>
class move_sentinel {
public:
    constexpr move_sentinel() = default;
    constexpr explicit move_sentinel(S s) : __last(std::move(s)) {}
    template <typename S2>
        requires convertible_to<const S2 &, S>
    constexpr move_sentinel(const move_sentinel<S2> &s) : __last(s.base())
    {
    }
    template <typename S2>
        requires assignable_from<S &, const S2 &>
    constexpr move_sentinel &operator=(const move_sentinel<S2> &s)
    {
        __last = s.base();
        return *this;
    }

    constexpr S base() const { return __last; }

private:
    S __last = S();
};

template <typename I, typename S>
    requires sentinel_for<S, I>
constexpr bool operator==(const move_iterator<I> &i, const move_sentinel<S> &s)
{
    return i.base() == s.base();
}
template <typename I, typename S>
    requires sized_sentinel_for<S, I>
constexpr iter_difference_t<I> operator-(const move_sentinel<S> &s,
                                         const move_iterator<I> &i)
{
    return s.base() - i.base();
}
template <typename I, typename S>
    requires sized_sentinel_for<S, I>
constexpr iter_difference_t<I> operator-(const move_iterator<I> &i,
                                         const move_sentinel<S> &s)
{
    return i.base() - s.base();
}

// ── counted_iterator ([counted.iterator]) ───────────────────────────────
// boxcxx: bounds a base iterator by a remaining count and compares equal
// to default_sentinel once the count reaches zero — take_view leans on
// this for bases that are neither sized nor random-access (filter_view,
// the input-category transform_view). All five iterator_traits member
// types are spelled out so iter_value_t / iter_difference_t resolve.

template <typename I>
class counted_iterator {
public:
    using iterator_type    = I;
    // Computed via concepts applied directly to I (matching move_iterator's
    // own pattern), NOT forwarded from iterator_traits<I> — boxcxx's generic
    // TraitsImpl only ever synthesises the five legacy members, never
    // iterator_concept, so a wrapped view iterator (which declares
    // iterator_concept as its own direct class member, not through a
    // dedicated iterator_traits specialization) would otherwise silently
    // fall back to its pinned legacy iterator_category here.
    // Contiguous rung included so counted_iterator<int*> (etc.) classifies
    // as contiguous, not merely random-access — matching what a wrapped I's
    // own I::iterator_concept passthrough would preserve automatically, and
    // matching contiguous_iterator's own derived_from<IterConcept<I>,
    // contiguous_iterator_tag> check.
    using iterator_concept = conditional_t<
        contiguous_iterator<I>, contiguous_iterator_tag,
        conditional_t<random_access_iterator<I>, random_access_iterator_tag,
                      conditional_t<bidirectional_iterator<I>, bidirectional_iterator_tag,
                                    conditional_t<forward_iterator<I>, forward_iterator_tag,
                                                  input_iterator_tag>>>>;
    using value_type        = iter_value_t<I>;
    using difference_type   = iter_difference_t<I>;
    using iterator_category = typename iterator_traits<I>::iterator_category;
    using pointer           = conditional_t<contiguous_iterator<I>,
                                            add_pointer_t<iter_reference_t<I>>, void>;
    using reference         = iter_reference_t<I>;

    constexpr counted_iterator() = default;
    constexpr counted_iterator(I i, iter_difference_t<I> n)
        : __cur(std::move(i)), __cnt(n)
    {
    }

    constexpr const I &base() const &noexcept { return __cur; }
    constexpr I base() && { return std::move(__cur); }
    constexpr iter_difference_t<I> count() const noexcept { return __cnt; }

    constexpr decltype(auto) operator*() noexcept(noexcept(*__cur)) { return *__cur; }
    constexpr decltype(auto) operator*() const noexcept(noexcept(*__cur)) { return *__cur; }
    constexpr decltype(auto) operator[](iter_difference_t<I> n) const
        requires random_access_iterator<I>
    {
        return __cur[n];
    }

    constexpr counted_iterator &operator++()
    {
        ++__cur;
        --__cnt;
        return *this;
    }
    constexpr counted_iterator operator++(int)
        requires forward_iterator<I>
    {
        counted_iterator tmp = *this;
        ++*this;
        return tmp;
    }
    constexpr counted_iterator &operator--()
        requires bidirectional_iterator<I>
    {
        --__cur;
        ++__cnt;
        return *this;
    }
    constexpr counted_iterator operator--(int)
        requires bidirectional_iterator<I>
    {
        counted_iterator tmp = *this;
        --*this;
        return tmp;
    }

    constexpr counted_iterator operator+(iter_difference_t<I> n) const
        requires random_access_iterator<I>
    {
        return counted_iterator(__cur + n, __cnt - n);
    }
    friend constexpr counted_iterator operator+(iter_difference_t<I> n,
                                                const counted_iterator &it)
        requires random_access_iterator<I>
    {
        return it + n;
    }
    constexpr counted_iterator &operator+=(iter_difference_t<I> n)
        requires random_access_iterator<I>
    {
        __cur += n;
        __cnt -= n;
        return *this;
    }
    constexpr counted_iterator operator-(iter_difference_t<I> n) const
        requires random_access_iterator<I>
    {
        return counted_iterator(__cur - n, __cnt + n);
    }
    constexpr counted_iterator &operator-=(iter_difference_t<I> n)
        requires random_access_iterator<I>
    {
        __cur -= n;
        __cnt += n;
        return *this;
    }

    template <typename I2>
        requires common_with<I2, I>
    friend constexpr iter_difference_t<I2>
    operator-(const counted_iterator &a, const counted_iterator<I2> &b)
    {
        return b.count() - a.count();
    }
    friend constexpr iter_difference_t<I> operator-(const counted_iterator &a,
                                                    default_sentinel_t)
    {
        return -a.__cnt;
    }
    friend constexpr iter_difference_t<I> operator-(default_sentinel_t,
                                                    const counted_iterator &b)
    {
        return b.__cnt;
    }

    friend constexpr bool operator==(const counted_iterator &a,
                                     default_sentinel_t) noexcept
    {
        return a.__cnt == 0;
    }
    template <typename I2>
        requires common_with<I2, I>
    friend constexpr bool operator==(const counted_iterator &a,
                                     const counted_iterator<I2> &b)
    {
        return a.count() == b.count();
    }
    template <typename I2>
        requires common_with<I2, I>
    friend constexpr auto operator<=>(const counted_iterator &a,
                                      const counted_iterator<I2> &b)
    {
        return b.count() <=> a.count(); // larger count = earlier position
    }

private:
    I __cur                    = I();
    iter_difference_t<I> __cnt = 0;
};

template <typename I>
constexpr counted_iterator<I> make_counted_iterator(I i, iter_difference_t<I> n)
{
    return counted_iterator<I>(std::move(i), n);
}

// ── inserters ([insert.iterators]) ──────────────────────────────────────

template <typename Container>
class back_insert_iterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type        = void;
    using difference_type   = ptrdiff_t;
    using pointer           = void;
    using reference         = void;
    using container_type    = Container;

    constexpr explicit back_insert_iterator(Container &c)
        : __c(__builtin_addressof(c))
    {
    }
    constexpr back_insert_iterator &
    operator=(const typename Container::value_type &value)
    {
        __c->push_back(value);
        return *this;
    }
    constexpr back_insert_iterator &
    operator=(typename Container::value_type &&value)
    {
        __c->push_back(std::move(value));
        return *this;
    }
    constexpr back_insert_iterator &operator*() { return *this; }
    constexpr back_insert_iterator &operator++() { return *this; }
    constexpr back_insert_iterator operator++(int) { return *this; }

private:
    Container *__c;
};

template <typename Container>
constexpr back_insert_iterator<Container> back_inserter(Container &c)
{
    return back_insert_iterator<Container>(c);
}

template <typename Container>
class front_insert_iterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type        = void;
    using difference_type   = ptrdiff_t;
    using pointer           = void;
    using reference         = void;
    using container_type    = Container;

    constexpr explicit front_insert_iterator(Container &c)
        : __c(__builtin_addressof(c))
    {
    }
    constexpr front_insert_iterator &
    operator=(const typename Container::value_type &value)
    {
        __c->push_front(value);
        return *this;
    }
    constexpr front_insert_iterator &
    operator=(typename Container::value_type &&value)
    {
        __c->push_front(std::move(value));
        return *this;
    }
    constexpr front_insert_iterator &operator*() { return *this; }
    constexpr front_insert_iterator &operator++() { return *this; }
    constexpr front_insert_iterator operator++(int) { return *this; }

private:
    Container *__c;
};

template <typename Container>
constexpr front_insert_iterator<Container> front_inserter(Container &c)
{
    return front_insert_iterator<Container>(c);
}

template <typename Container>
class insert_iterator {
public:
    using iterator_category = output_iterator_tag;
    using value_type        = void;
    using difference_type   = ptrdiff_t;
    using pointer           = void;
    using reference         = void;
    using container_type    = Container;

    constexpr insert_iterator(Container &c, typename Container::iterator it)
        : __c(__builtin_addressof(c)), __it(it)
    {
    }
    constexpr insert_iterator &
    operator=(const typename Container::value_type &value)
    {
        __it = __c->insert(__it, value);
        ++__it;
        return *this;
    }
    constexpr insert_iterator &
    operator=(typename Container::value_type &&value)
    {
        __it = __c->insert(__it, std::move(value));
        ++__it;
        return *this;
    }
    constexpr insert_iterator &operator*() { return *this; }
    constexpr insert_iterator &operator++() { return *this; }
    constexpr insert_iterator &operator++(int) { return *this; }

private:
    Container *__c;
    typename Container::iterator __it;
};

template <typename Container>
constexpr insert_iterator<Container> inserter(Container &c,
                                              typename Container::iterator it)
{
    return insert_iterator<Container>(c, it);
}

// ── indirect movement / storage concepts ([alg.req.ind.move]) ────────────
// Defined here, ahead of the iter_move/iter_swap CPOs, because the iter_swap
// CPO's fallback branch ([iterator.cust.swap]/4.3) is constrained on
// indirectly_movable_storable (both directions). The rest of the indirect
// movement family (copyable / swappable / comparable) lives with the Ф29a
// block after the CPOs — indirectly_swappable in particular DEPENDS on the
// iter_swap CPO.

template <typename In, typename Out>
concept indirectly_movable =
    indirectly_readable<In> &&
    indirectly_writable<Out, iter_rvalue_reference_t<In>>;

template <typename In, typename Out>
concept indirectly_movable_storable =
    indirectly_movable<In, Out> && indirectly_writable<Out, iter_value_t<In>> &&
    movable<iter_value_t<In>> &&
    constructible_from<iter_value_t<In>, iter_rvalue_reference_t<In>> &&
    assignable_from<iter_value_t<In> &, iter_rvalue_reference_t<In>>;

// ── ranges::iter_swap ([iterator.cust.swap]) ─────────────────────────────
// ranges::iter_move's own CPO now lives earlier in this file, right after
// iter_reference_t and before iter_rvalue_reference_t — see the comment
// there. iter_swap has no early dependent forcing the same move, so it
// stays here, alongside advance/next/prev/distance below.

namespace ranges {

namespace __iter_swap {
template <class T, class U>
void iter_swap(T, U) = delete; // poison
template <class A, class B>
concept HasAdl = requires(A &&a, B &&b) {
    iter_swap(static_cast<A &&>(a), static_cast<B &&>(b));
};
template <class A, class B>
concept Readswap = indirectly_readable<remove_reference_t<A>> &&
                   indirectly_readable<remove_reference_t<B>> &&
                   swappable_with<iter_reference_t<remove_reference_t<A>>,
                                  iter_reference_t<remove_reference_t<B>>>;
// Third branch ([iterator.cust.swap]/4.3): the move-through-temporary
// fallback, gated exactly as the standard requires — indirectly_movable_storable
// in BOTH directions, so the swap is symmetric (iter_swap(a,b) valid ⟺
// iter_swap(b,a) valid). The move-through-temporary body only reads one
// direction, but the symmetric gate is what makes the CPO a genuine swap.
template <class A, class B>
concept FallbackSwap =
    indirectly_movable_storable<remove_reference_t<A>, remove_reference_t<B>> &&
    indirectly_movable_storable<remove_reference_t<B>, remove_reference_t<A>>;

// noexcept mirrors [iterator.cust.swap]/2-4: the exposition-only
// iter-exchange-move's own noexcept clause for the fallback branch, or the
// noexcept of whichever of the ADL/ranges::swap alternatives the CPO selects.
template <class A, class B>
constexpr bool NoexceptOf()
{
    if constexpr (HasAdl<A, B>)
        return noexcept(iter_swap(declval<A &&>(), declval<B &&>()));
    else if constexpr (Readswap<A, B>)
        return noexcept(ranges::swap(*declval<A &&>(), *declval<B &&>()));
    else
        return noexcept(iter_value_t<remove_reference_t<A>>(
                   ranges::iter_move(declval<A &&>()))) &&
               noexcept(*declval<A &&>() = ranges::iter_move(declval<B &&>())) &&
               noexcept(*declval<B &&>() =
                            declval<iter_value_t<remove_reference_t<A>> &&>());
}

struct Fn {
    // The CPO is a partial function: without this constraint operator() is
    // callable for ANY pair (the ill-formed body only bites on instantiation),
    // which would make indirectly_swappable — and thus sortable/permutable —
    // wrongly hold for non-swappable iterators (e.g. const int*).
    template <class A, class B>
        requires HasAdl<A, B> || Readswap<A, B> || FallbackSwap<A, B>
    constexpr void operator()(A &&a, B &&b) const noexcept(NoexceptOf<A, B>())
    {
        if constexpr (HasAdl<A, B>)
            iter_swap(static_cast<A &&>(a), static_cast<B &&>(b));
        else if constexpr (Readswap<A, B>)
            ranges::swap(*static_cast<A &&>(a), *static_cast<B &&>(b));
        else {
            iter_value_t<remove_reference_t<A>> tmp =
                ranges::iter_move(a);
            *a = ranges::iter_move(b);
            *b = static_cast<decltype(tmp) &&>(tmp);
        }
    }
};
} // namespace __iter_swap
inline namespace __cpo {
inline constexpr __iter_swap::Fn iter_swap{};
}

// ── ranges::advance / next / prev / distance ([range.iter.op]) ───────────
// Niebloids over raw (iterator, sentinel/count) pairs — the ranges algorithms
// (and fold_right / find_last, which must walk a sentinel down to a real I
// via next(first,last)) build on these. The range-taking distance(R&&)
// overload is deliberately omitted here: it needs the range concepts that
// live in <ranges> (which includes THIS header, not the reverse) — spell
// distance(begin(r), end(r)) instead.

struct Advance {
    template <input_or_output_iterator I>
    constexpr void operator()(I &i, iter_difference_t<I> n) const
    {
        if constexpr (random_access_iterator<I>)
            i += n;
        else if constexpr (bidirectional_iterator<I>) {
            for (; n > 0; --n) ++i;
            for (; n < 0; ++n) --i;
        } else
            for (; n > 0; --n) ++i;
    }
    template <input_or_output_iterator I, sentinel_for<I> S>
    constexpr void operator()(I &i, S bound) const
    {
        if constexpr (assignable_from<I &, S>)
            i = std::move(bound);
        else if constexpr (sized_sentinel_for<S, I>)
            (*this)(i, bound - i);
        else
            while (i != bound) ++i;
    }
    template <input_or_output_iterator I, sentinel_for<I> S>
    constexpr iter_difference_t<I> operator()(I &i, iter_difference_t<I> n,
                                              S bound) const
    {
        if constexpr (sized_sentinel_for<S, I>) {
            auto m = bound - i; // signed steps remaining to bound
            // |n| >= |m| ⇒ equivalent to advance(i, bound) (covers m == 0,
            // where any n is a no-op — guarding on m's sign would wrongly
            // exclude m == 0 with n < 0 and overshoot past bound).
            if ((n >= 0 && n >= m) || (n < 0 && n <= m)) {
                (*this)(i, std::move(bound));
                return n - m;
            }
            (*this)(i, n);
            return 0;
        } else if constexpr (bidirectional_iterator<I>) {
            for (; n > 0 && i != bound; --n) ++i;
            for (; n < 0 && i != bound; ++n) --i;
            return n;
        } else {
            for (; n > 0 && i != bound; --n) ++i;
            return n;
        }
    }
};
inline constexpr Advance advance{};

struct Next {
    template <input_or_output_iterator I>
    constexpr I operator()(I x) const
    {
        ++x;
        return x;
    }
    template <input_or_output_iterator I>
    constexpr I operator()(I x, iter_difference_t<I> n) const
    {
        advance(x, n);
        return x;
    }
    template <input_or_output_iterator I, sentinel_for<I> S>
    constexpr I operator()(I x, S bound) const
    {
        advance(x, std::move(bound));
        return x;
    }
    template <input_or_output_iterator I, sentinel_for<I> S>
    constexpr I operator()(I x, iter_difference_t<I> n, S bound) const
    {
        advance(x, n, std::move(bound));
        return x;
    }
};
inline constexpr Next next{};

struct Prev {
    template <bidirectional_iterator I>
    constexpr I operator()(I x) const
    {
        --x;
        return x;
    }
    template <bidirectional_iterator I>
    constexpr I operator()(I x, iter_difference_t<I> n) const
    {
        advance(x, -n);
        return x;
    }
    template <bidirectional_iterator I>
    constexpr I operator()(I x, iter_difference_t<I> n, I bound) const
    {
        advance(x, -n, bound);
        return x;
    }
};
inline constexpr Prev prev{};

struct Distance {
    template <input_or_output_iterator I, sentinel_for<I> S>
    constexpr iter_difference_t<I> operator()(I first, S last) const
    {
        if constexpr (sized_sentinel_for<S, I>)
            return last - first;
        else {
            iter_difference_t<I> n = 0;
            for (; first != last; ++first) ++n;
            return n;
        }
    }
};
inline constexpr Distance distance{};

} // namespace ranges

// ════════════════════════════════════════════════════════════════════════
// Ф29a — indirect-callable foundation ([indirectcallable], [projected],
// [alg.req.*]) + common_iterator ([common.iterator]). Placed AFTER the
// ranges::iter_move/iter_swap CPO section above because the swap concepts and
// common_iterator's hidden friends qualified-call those CPOs.
// ════════════════════════════════════════════════════════════════════════

// ── indirect-value-t (exposition-only in the std; internal helper) ───────
// [iterator.concepts.general]: for a plain readable I it is iter_value_t<I>&;
// for projected<I,Proj> it is the projection applied to I's indirect value
// (recursive — the specialization lands just after projected below). Every
// ranges algorithm substitutes projected<...> as its I, so the recursive
// case is the common path, not an edge case.
namespace __iter_impl {

template <typename T>
struct IndirectValueImpl {
    using type = iter_value_t<T> &;
};
template <typename T>
using IndirectValueT = typename IndirectValueImpl<T>::type;

} // namespace __iter_impl

// ── indirect callable concepts ([indirectcallable.indirectinvocable]) ────

template <typename F, typename I>
concept indirectly_unary_invocable =
    indirectly_readable<I> && copy_constructible<F> &&
    invocable<F &, __iter_impl::IndirectValueT<I>> &&
    invocable<F &, iter_reference_t<I>> &&
    common_reference_with<
        invoke_result_t<F &, __iter_impl::IndirectValueT<I>>,
        invoke_result_t<F &, iter_reference_t<I>>>;

template <typename F, typename I>
concept indirectly_regular_unary_invocable =
    indirectly_readable<I> && copy_constructible<F> &&
    regular_invocable<F &, __iter_impl::IndirectValueT<I>> &&
    regular_invocable<F &, iter_reference_t<I>> &&
    common_reference_with<
        invoke_result_t<F &, __iter_impl::IndirectValueT<I>>,
        invoke_result_t<F &, iter_reference_t<I>>>;

template <typename F, typename I>
concept indirect_unary_predicate =
    indirectly_readable<I> && copy_constructible<F> &&
    predicate<F &, __iter_impl::IndirectValueT<I>> &&
    predicate<F &, iter_reference_t<I>>;

template <typename F, typename I1, typename I2>
concept indirect_binary_predicate =
    indirectly_readable<I1> && indirectly_readable<I2> &&
    copy_constructible<F> &&
    predicate<F &, __iter_impl::IndirectValueT<I1>,
              __iter_impl::IndirectValueT<I2>> &&
    predicate<F &, __iter_impl::IndirectValueT<I1>, iter_reference_t<I2>> &&
    predicate<F &, iter_reference_t<I1>, __iter_impl::IndirectValueT<I2>> &&
    predicate<F &, iter_reference_t<I1>, iter_reference_t<I2>>;

template <typename F, typename I1, typename I2 = I1>
concept indirect_equivalence_relation =
    indirectly_readable<I1> && indirectly_readable<I2> &&
    copy_constructible<F> &&
    equivalence_relation<F &, __iter_impl::IndirectValueT<I1>,
                         __iter_impl::IndirectValueT<I2>> &&
    equivalence_relation<F &, __iter_impl::IndirectValueT<I1>,
                         iter_reference_t<I2>> &&
    equivalence_relation<F &, iter_reference_t<I1>,
                         __iter_impl::IndirectValueT<I2>> &&
    equivalence_relation<F &, iter_reference_t<I1>, iter_reference_t<I2>>;

template <typename F, typename I1, typename I2 = I1>
concept indirect_strict_weak_order =
    indirectly_readable<I1> && indirectly_readable<I2> &&
    copy_constructible<F> &&
    strict_weak_order<F &, __iter_impl::IndirectValueT<I1>,
                      __iter_impl::IndirectValueT<I2>> &&
    strict_weak_order<F &, __iter_impl::IndirectValueT<I1>,
                      iter_reference_t<I2>> &&
    strict_weak_order<F &, iter_reference_t<I1>,
                      __iter_impl::IndirectValueT<I2>> &&
    strict_weak_order<F &, iter_reference_t<I1>, iter_reference_t<I2>>;

template <typename F, typename... Is>
    requires(indirectly_readable<Is> && ...) &&
            invocable<F, iter_reference_t<Is>...>
using indirect_result_t = invoke_result_t<F, iter_reference_t<Is>...>;

// ── projected ([projected]) ──────────────────────────────────────────────
// A compile-time-only readable marker: projected<I,Proj> models
// indirectly_readable with reference = the projection applied to *I. Its
// operator* is DECLARED, never defined — every use is an unevaluated operand
// (decltype / declval / requires), so it is never ODR-used; the linker never
// looks for it. (Accidentally constructing+dereferencing a projected in an
// EVALUATED context would surface as "undefined reference" at link time.)
namespace __iter_impl {
template <typename I, typename = void>
struct ProjectedDiff {};
template <typename I>
    requires requires { typename iter_difference_t<I>; }
struct ProjectedDiff<I> {
    using difference_type = iter_difference_t<I>;
};
} // namespace __iter_impl

template <indirectly_readable I, indirectly_regular_unary_invocable<I> Proj>
struct projected : __iter_impl::ProjectedDiff<I> {
    using value_type = remove_cvref_t<indirect_result_t<Proj &, I>>;
    indirect_result_t<Proj &, I> operator*() const; // declared, never defined
};

// The value-type projection default that the ranges algorithms spell as
// `class T = projected_value_t<I, Proj>` (find/count/lower_bound/…). Projects
// the VALUE type by lvalue (iter_value_t<I>&), NOT iter_reference_t<I> — the
// two coincide for every non-proxy iterator but differ for proxy iterators,
// and the value-based form is the one [projected] / LWG 3859 mandate.
template <indirectly_readable I, indirectly_regular_unary_invocable<I> Proj>
using projected_value_t =
    remove_cvref_t<invoke_result_t<Proj &, iter_value_t<I> &>>;

namespace __iter_impl {
template <typename I, typename Proj>
struct IndirectValueImpl<projected<I, Proj>> {
    using type = invoke_result_t<Proj &, IndirectValueT<I>>;
};
} // namespace __iter_impl

// boxcxx keys iter_value_t/iter_difference_t off iterator_traits (there is no
// incrementable_traits/indirectly_readable_traits), and the primary traits
// yields an EMPTY set unless all five member typedefs are present — projected
// only has value_type — so it needs an explicit specialization. difference_type
// is INHERITED from ProjectedDiff (present iff iter_difference_t<I> resolves),
// keeping it conditionally present per the standard with no hard error when I
// is not weakly_incrementable.
template <typename I, typename Proj>
struct iterator_traits<projected<I, Proj>> : __iter_impl::ProjectedDiff<I> {
    using iterator_category = input_iterator_tag;
    using value_type        = typename projected<I, Proj>::value_type;
    using pointer           = void;
    using reference         = indirect_result_t<Proj &, I>;
};

// ── indirect copy / swap / compare ([alg.req.ind.*]) ─────────────────────
// (indirectly_movable / indirectly_movable_storable are defined earlier,
// ahead of the iter_swap CPO whose fallback branch consumes them.)

template <typename In, typename Out>
concept indirectly_copyable =
    indirectly_readable<In> && indirectly_writable<Out, iter_reference_t<In>>;

template <typename In, typename Out>
concept indirectly_copyable_storable =
    indirectly_copyable<In, Out> &&
    indirectly_writable<Out, iter_value_t<In> &> &&
    indirectly_writable<Out, const iter_value_t<In> &> &&
    indirectly_writable<Out, iter_value_t<In> &&> &&
    indirectly_writable<Out, const iter_value_t<In> &&> &&
    copyable<iter_value_t<In>> &&
    constructible_from<iter_value_t<In>, iter_reference_t<In>> &&
    assignable_from<iter_value_t<In> &, iter_reference_t<In>>;

template <typename I1, typename I2 = I1>
concept indirectly_swappable =
    indirectly_readable<I1> && indirectly_readable<I2> &&
    requires(const I1 i1, const I2 i2) {
        ranges::iter_swap(i1, i1);
        ranges::iter_swap(i2, i2);
        ranges::iter_swap(i1, i2);
        ranges::iter_swap(i2, i1);
    };

template <typename I1, typename I2, typename R, typename P1 = identity,
          typename P2 = identity>
concept indirectly_comparable =
    indirect_binary_predicate<R, projected<I1, P1>, projected<I2, P2>>;

// ── ADL escape hatch: iter_move/iter_swap for pre-CPO adaptors
//    ([move.iter.elem], [counted.iter.cust], [reverse.iter.nav]) ──────────
// move_iterator, counted_iterator (both above, pre-CPO in THIS file) and
// reverse_iterator (__bits/iterator_core, can never see the CPOs from
// inside its own class body) each need a real customization so a wrapped
// proxy's OWN iter_move/iter_swap participates instead of the CPOs' generic
// fallback silently downgrading move to copy (or, for move_iterator,
// dangling — see iter_rvalue_reference_t's own fix above). Free functions
// in their enclosing namespace (std, not std::ranges) are ADL-discoverable
// exactly like hidden friends — the actual lookup happens at the point
// external code calls ranges::iter_move/iter_swap on one of these types,
// always after this whole header has been parsed, so textual position
// relative to the class body doesn't matter, only namespace + "declared
// before use". Placed here (needs indirectly_swappable, just above, for the
// iter_swap overloads' constraint) rather than up near move_iterator's own
// definition.

template <typename It>
constexpr iter_rvalue_reference_t<It> iter_move(const move_iterator<It> &i)
    noexcept(noexcept(ranges::iter_move(i.base())))
{
    return ranges::iter_move(i.base());
}
template <typename It, typename It2>
    requires indirectly_swappable<It, It2>
constexpr void iter_swap(const move_iterator<It> &x, const move_iterator<It2> &y)
    noexcept(noexcept(ranges::iter_swap(x.base(), y.base())))
{
    ranges::iter_swap(x.base(), y.base());
}

template <typename I>
    requires input_iterator<I>
constexpr decltype(auto) iter_move(const counted_iterator<I> &i)
    noexcept(noexcept(ranges::iter_move(i.base())))
{
    return ranges::iter_move(i.base());
}
template <typename I, typename I2>
    requires indirectly_swappable<I, I2>
constexpr void iter_swap(const counted_iterator<I> &x, const counted_iterator<I2> &y)
    noexcept(noexcept(ranges::iter_swap(x.base(), y.base())))
{
    ranges::iter_swap(x.base(), y.base());
}

// reverse_iterator's "current element" is always one-before its stored
// position (its own operator* makes an identical local copy-then-decrement:
// "It tmp = __cur; return *--tmp;", __bits/iterator_core) — mirrored here
// via base() (which already returns It by value) rather than reaching for
// the private __cur, so no class-body access is needed.
template <typename It>
constexpr iter_rvalue_reference_t<It> iter_move(const reverse_iterator<It> &i)
    noexcept(is_nothrow_copy_constructible_v<It> &&
             noexcept(--declval<It &>()) &&
             noexcept(ranges::iter_move(declval<It &>())))
{
    It tmp = i.base();
    --tmp;
    return ranges::iter_move(tmp);
}
template <typename It, typename It2>
    requires indirectly_swappable<It, It2>
constexpr void iter_swap(const reverse_iterator<It> &x, const reverse_iterator<It2> &y)
    noexcept(is_nothrow_copy_constructible_v<It> && is_nothrow_copy_constructible_v<It2> &&
             noexcept(--declval<It &>()) && noexcept(--declval<It2 &>()) &&
             noexcept(ranges::iter_swap(declval<It &>(), declval<It2 &>())))
{
    It xtmp = x.base();
    --xtmp;
    It2 ytmp = y.base();
    --ytmp;
    ranges::iter_swap(xtmp, ytmp);
}

// ── algorithm-requirement concepts ([alg.req.*]) ─────────────────────────

template <typename I>
concept permutable = forward_iterator<I> &&
                     indirectly_movable_storable<I, I> &&
                     indirectly_swappable<I, I>;

template <typename I1, typename I2, typename Out, typename R = ranges::less,
          typename P1 = identity, typename P2 = identity>
concept mergeable =
    input_iterator<I1> && input_iterator<I2> && weakly_incrementable<Out> &&
    indirectly_copyable<I1, Out> && indirectly_copyable<I2, Out> &&
    indirect_strict_weak_order<R, projected<I1, P1>, projected<I2, P2>>;

template <typename I, typename R = ranges::less, typename P = identity>
concept sortable =
    permutable<I> && indirect_strict_weak_order<R, projected<I, P>>;

// ── common_iterator ([common.iterator]) ──────────────────────────────────
// Fuses a distinct iterator/sentinel pair (I ≠ S) into one iterator type so a
// non-common range can feed classic [first,last) algorithms. Storage is a
// hand-rolled tagged union (index 0=iterator, 1=sentinel, 2=valueless) rather
// than std::variant — like libstdc++/libc++ — to keep <iterator> from pulling
// <variant> into every ranges/algorithm TU. Under -fexceptions the valueless
// state is a genuine requirement: a throwing move/copy mid-reassignment must
// not leave the union double-destroyed. Placement-new mirrors MovableBox's
// house style (raw ::new, not construct_at — avoids a <memory> include cycle),
// so like MovableBox common_iterator is not usable in constant evaluation.

namespace __iter_impl {

template <typename T>
using WithRef = T &;
template <typename T>
concept CanReference = requires { typename WithRef<T>; };

template <typename T>
concept Dereferenceable = requires(T &t) {
    { *t } -> CanReference;
};

template <typename I>
concept CommonIterHasArrow =
    indirectly_readable<const I> &&
    (requires(const I &it) { it.operator->(); } ||
     is_reference_v<iter_reference_t<I>> ||
     constructible_from<iter_value_t<I>, iter_reference_t<I>>);

template <typename I>
concept CommonIterUsePostfixProxy =
    (!requires(I &i) {
        { *i++ } -> CanReference;
    }) &&
    constructible_from<iter_value_t<I>, iter_reference_t<I>> &&
    movable<iter_value_t<I>>;

} // namespace __iter_impl

template <input_or_output_iterator I, sentinel_for<I> S>
    requires(!same_as<I, S>) && copyable<I>
class common_iterator {
    class ArrowProxy {
        iter_value_t<I> __keep;
        constexpr explicit ArrowProxy(iter_reference_t<I> &&x)
            : __keep(std::move(x))
        {
        }
        friend class common_iterator;

    public:
        constexpr const iter_value_t<I> *operator->() const noexcept
        {
            return __builtin_addressof(__keep);
        }
    };
    class PostfixProxy {
        iter_value_t<I> __keep;
        constexpr explicit PostfixProxy(iter_reference_t<I> &&x)
            : __keep(std::forward<iter_reference_t<I>>(x))
        {
        }
        friend class common_iterator;

    public:
        constexpr const iter_value_t<I> &operator*() const noexcept
        {
            return __keep;
        }
    };

    union {
        I __it;
        S __sent;
        unsigned char __valueless;
    };
    unsigned char __index; // 0 = __it, 1 = __sent, 2 = valueless
    static constexpr unsigned char kValueless = 2;

    template <typename Other>
    constexpr void __Assign(Other &&x)
    {
        if (__index == x.__index) {
            if (__index == 0)
                __it = std::forward<Other>(x).__it;
            else if (__index == 1)
                __sent = std::forward<Other>(x).__sent;
            return;
        }
        if (__index == 0)
            __it.~I();
        else if (__index == 1)
            __sent.~S();
        __index = kValueless;
        if (x.__index == 0)
            ::new (static_cast<void *>(__builtin_addressof(__it)))
                I(std::forward<Other>(x).__it);
        else if (x.__index == 1)
            ::new (static_cast<void *>(__builtin_addressof(__sent)))
                S(std::forward<Other>(x).__sent);
        __index = x.__index;
    }

    template <input_or_output_iterator I2, sentinel_for<I2> S2>
        requires(!same_as<I2, S2>) && copyable<I2>
    friend class common_iterator;

public:
    constexpr common_iterator()
        requires default_initializable<I>
        : __it(), __index(0)
    {
    }
    constexpr common_iterator(I i) : __it(std::move(i)), __index(0) {}
    constexpr common_iterator(S s) : __sent(std::move(s)), __index(1) {}

    constexpr common_iterator(const common_iterator &x)
        : __valueless(), __index(x.__index)
    {
        if (__index == 0)
            ::new (static_cast<void *>(__builtin_addressof(__it))) I(x.__it);
        else if (__index == 1)
            ::new (static_cast<void *>(__builtin_addressof(__sent))) S(x.__sent);
    }
    constexpr common_iterator(common_iterator &&x)
        : __valueless(), __index(x.__index)
    {
        if (__index == 0)
            ::new (static_cast<void *>(__builtin_addressof(__it)))
                I(std::move(x.__it));
        else if (__index == 1)
            ::new (static_cast<void *>(__builtin_addressof(__sent)))
                S(std::move(x.__sent));
    }
    template <typename I2, typename S2>
        requires convertible_to<const I2 &, I> && convertible_to<const S2 &, S>
    constexpr common_iterator(const common_iterator<I2, S2> &x)
        : __valueless(), __index(x.__index)
    {
        if (__index == 0)
            ::new (static_cast<void *>(__builtin_addressof(__it))) I(x.__it);
        else if (__index == 1)
            ::new (static_cast<void *>(__builtin_addressof(__sent))) S(x.__sent);
    }

    constexpr common_iterator &operator=(const common_iterator &x)
    {
        __Assign(x);
        return *this;
    }
    constexpr common_iterator &operator=(common_iterator &&x)
    {
        __Assign(std::move(x));
        return *this;
    }
    template <typename I2, typename S2>
        requires convertible_to<const I2 &, I> &&
                 convertible_to<const S2 &, S> &&
                 assignable_from<I &, const I2 &> &&
                 assignable_from<S &, const S2 &>
    constexpr common_iterator &operator=(const common_iterator<I2, S2> &x)
    {
        __Assign(x);
        return *this;
    }

    constexpr ~common_iterator()
    {
        if (__index == 0)
            __it.~I();
        else if (__index == 1)
            __sent.~S();
    }

    [[nodiscard]] constexpr decltype(auto) operator*() { return *__it; }
    [[nodiscard]] constexpr decltype(auto) operator*() const
        requires __iter_impl::Dereferenceable<const I>
    {
        return *__it;
    }

    [[nodiscard]] constexpr auto operator->() const
        requires __iter_impl::CommonIterHasArrow<I>
    {
        if constexpr (is_pointer_v<I> ||
                      requires(const I &it) { it.operator->(); })
            return __it;
        else if constexpr (is_reference_v<iter_reference_t<I>>) {
            auto &&tmp = *__it;
            return __builtin_addressof(tmp);
        } else
            return ArrowProxy{*__it};
    }

    constexpr common_iterator &operator++()
    {
        ++__it;
        return *this;
    }
    constexpr decltype(auto) operator++(int)
    {
        if constexpr (forward_iterator<I>) {
            common_iterator tmp = *this;
            ++*this;
            return tmp;
        } else if constexpr (!__iter_impl::CommonIterUsePostfixProxy<I>)
            return __it++;
        else {
            PostfixProxy p(**this);
            ++*this;
            return p;
        }
    }

    template <typename I2, sentinel_for<I> S2>
        requires sentinel_for<S, I2>
    friend constexpr bool operator==(const common_iterator &x,
                                     const common_iterator<I2, S2> &y)
    {
        if (x.__index == 0 && y.__index == 0)
            return true;
        if (x.__index == 1 && y.__index == 1)
            return true;
        if (x.__index == 0 && y.__index == 1)
            return x.__it == y.__sent;
        if (x.__index == 1 && y.__index == 0)
            return x.__sent == y.__it;
        __builtin_unreachable();
    }
    template <typename I2, sentinel_for<I> S2>
        requires sentinel_for<S, I2> && equality_comparable_with<I, I2>
    friend constexpr bool operator==(const common_iterator &x,
                                     const common_iterator<I2, S2> &y)
    {
        if (x.__index == 1 && y.__index == 1)
            return true;
        if (x.__index == 0 && y.__index == 0)
            return x.__it == y.__it;
        if (x.__index == 0 && y.__index == 1)
            return x.__it == y.__sent;
        if (x.__index == 1 && y.__index == 0)
            return x.__sent == y.__it;
        __builtin_unreachable();
    }

    template <sized_sentinel_for<I> I2, sized_sentinel_for<I> S2>
        requires sized_sentinel_for<S, I2>
    friend constexpr iter_difference_t<I2>
    operator-(const common_iterator &x, const common_iterator<I2, S2> &y)
    {
        if (x.__index == 1 && y.__index == 1)
            return 0;
        if (x.__index == 0 && y.__index == 0)
            return x.__it - y.__it;
        if (x.__index == 0 && y.__index == 1)
            return x.__it - y.__sent;
        if (x.__index == 1 && y.__index == 0)
            return x.__sent - y.__it;
        __builtin_unreachable();
    }

    [[nodiscard]] friend constexpr iter_rvalue_reference_t<I>
    iter_move(const common_iterator &i)
        requires input_iterator<I>
    {
        return ranges::iter_move(i.__it);
    }
    template <typename I2, typename S2>
        requires indirectly_swappable<I, I2>
    friend constexpr void iter_swap(const common_iterator &x,
                                    const common_iterator<I2, S2> &y)
        noexcept(noexcept(ranges::iter_swap(declval<const I &>(),
                                            declval<const I2 &>())))
    {
        ranges::iter_swap(x.__it, y.__it);
    }
};

template <input_iterator I, typename S>
struct iterator_traits<common_iterator<I, S>> {
private:
    template <typename I2, typename = void>
    struct Pointer {
        using type = void;
    };
    template <typename I2>
        requires __iter_impl::CommonIterHasArrow<I2>
    struct Pointer<I2, void> {
        using type =
            decltype(declval<const common_iterator<I2, S> &>().operator->());
    };

public:
    using iterator_concept =
        conditional_t<forward_iterator<I>, forward_iterator_tag,
                      input_iterator_tag>;
    using iterator_category =
        conditional_t<__iter_impl::CategoryAtLeast<I, forward_iterator_tag>,
                      forward_iterator_tag, input_iterator_tag>;
    using value_type      = iter_value_t<I>;
    using difference_type = iter_difference_t<I>;
    using pointer         = typename Pointer<I>::type;
    using reference       = iter_reference_t<I>;
};

// ── const-iterators ([const.iterators], C++23) ───────────────────────────
// basic_const_iterator wraps an iterator so its reference becomes a const
// view of the element (iter_const_reference_t) — the substrate views::as_const
// / as_const_view lean on. const_iterator/const_sentinel collapse to the
// underlying type when it is already a constant iterator (no wrapping cost).

template <indirectly_readable It>
using iter_const_reference_t =
    common_reference_t<const iter_value_t<It> &&, iter_reference_t<It>>;

namespace __iter_impl {

template <typename I>
concept ConstantIterator =
    input_iterator<I> &&
    same_as<iter_const_reference_t<I>, iter_reference_t<I>>;

// iterator_category is a member of basic_const_iterator only when the base
// is a forward iterator ([const.iterators.types]); a base carries it in.
template <typename I>
struct BccCategory {};
template <forward_iterator I>
struct BccCategory<I> {
    using iterator_category = typename iterator_traits<I>::iterator_category;
};

} // namespace __iter_impl

template <input_iterator Iterator>
class basic_const_iterator : public __iter_impl::BccCategory<Iterator> {
    Iterator __cur = Iterator();

    using __RvalRef =
        common_reference_t<const iter_value_t<Iterator> &&,
                           iter_rvalue_reference_t<Iterator>>;

public:
    using iterator_concept = conditional_t<
        contiguous_iterator<Iterator>, contiguous_iterator_tag,
        conditional_t<
            random_access_iterator<Iterator>, random_access_iterator_tag,
            conditional_t<bidirectional_iterator<Iterator>,
                          bidirectional_iterator_tag,
                          conditional_t<forward_iterator<Iterator>,
                                        forward_iterator_tag,
                                        input_iterator_tag>>>>;
    using value_type      = iter_value_t<Iterator>;
    using difference_type = iter_difference_t<Iterator>;
    using reference       = iter_const_reference_t<Iterator>;

    basic_const_iterator()
        requires default_initializable<Iterator>
    = default;
    constexpr basic_const_iterator(Iterator current) : __cur(std::move(current))
    {
    }
    template <convertible_to<Iterator> U>
    constexpr basic_const_iterator(basic_const_iterator<U> current)
        : __cur(std::move(current.base()))
    {
    }
    template <typename T>
        requires(!same_as<remove_cvref_t<T>, basic_const_iterator>) &&
                convertible_to<T, Iterator>
    constexpr basic_const_iterator(T &&current)
        : __cur(std::forward<T>(current))
    {
    }

    constexpr const Iterator &base() const & noexcept { return __cur; }
    constexpr Iterator base() && { return std::move(__cur); }

    constexpr reference operator*() const
    {
        return static_cast<reference>(*__cur);
    }
    constexpr const auto *operator->() const
        requires is_lvalue_reference_v<iter_reference_t<Iterator>> &&
                 same_as<remove_cvref_t<iter_reference_t<Iterator>>, value_type>
    {
        if constexpr (contiguous_iterator<Iterator>)
            return std::to_address(__cur);
        else
            return __builtin_addressof(static_cast<reference>(*__cur));
    }

    constexpr basic_const_iterator &operator++()
    {
        ++__cur;
        return *this;
    }
    constexpr void operator++(int) { ++__cur; }
    constexpr basic_const_iterator operator++(int)
        requires forward_iterator<Iterator>
    {
        auto t = *this;
        ++__cur;
        return t;
    }
    constexpr basic_const_iterator &operator--()
        requires bidirectional_iterator<Iterator>
    {
        --__cur;
        return *this;
    }
    constexpr basic_const_iterator operator--(int)
        requires bidirectional_iterator<Iterator>
    {
        auto t = *this;
        --__cur;
        return t;
    }

    constexpr basic_const_iterator &operator+=(difference_type n)
        requires random_access_iterator<Iterator>
    {
        __cur += n;
        return *this;
    }
    constexpr basic_const_iterator &operator-=(difference_type n)
        requires random_access_iterator<Iterator>
    {
        __cur -= n;
        return *this;
    }
    constexpr reference operator[](difference_type n) const
        requires random_access_iterator<Iterator>
    {
        return static_cast<reference>(__cur[n]);
    }

    // comparisons with the underlying sentinel (bounds a const range). The
    // same-type case is handled by the homogeneous friends below; the
    // !same_as guard is written FIRST so that when S is basic_const_iterator
    // the conjunction short-circuits before sized_sentinel_for<S, Iterator>
    // is ever evaluated — otherwise that satisfaction check recurses on
    // itself (it looks for exactly these operators).
    template <typename S>
        requires(!same_as<S, basic_const_iterator>) && sentinel_for<S, Iterator>
    constexpr bool operator==(const S &s) const
    {
        return __cur == s;
    }
    template <typename S>
        requires(!same_as<S, basic_const_iterator>) &&
                sized_sentinel_for<S, Iterator>
    constexpr difference_type operator-(const S &s) const
    {
        return __cur - s;
    }
    template <typename S>
        requires(!same_as<S, basic_const_iterator>) &&
                sized_sentinel_for<S, Iterator>
    friend constexpr difference_type operator-(const S &s,
                                               const basic_const_iterator &i)
    {
        return s - i.__cur;
    }

    // homogeneous ordering (a common const range compares two of these).
    friend constexpr bool operator==(const basic_const_iterator &a,
                                     const basic_const_iterator &b)
        requires equality_comparable<Iterator>
    {
        return a.__cur == b.__cur;
    }
    friend constexpr bool operator<(const basic_const_iterator &a,
                                    const basic_const_iterator &b)
        requires random_access_iterator<Iterator>
    {
        return a.__cur < b.__cur;
    }
    friend constexpr bool operator>(const basic_const_iterator &a,
                                    const basic_const_iterator &b)
        requires random_access_iterator<Iterator>
    {
        return a.__cur > b.__cur;
    }
    friend constexpr bool operator<=(const basic_const_iterator &a,
                                     const basic_const_iterator &b)
        requires random_access_iterator<Iterator>
    {
        return a.__cur <= b.__cur;
    }
    friend constexpr bool operator>=(const basic_const_iterator &a,
                                     const basic_const_iterator &b)
        requires random_access_iterator<Iterator>
    {
        return a.__cur >= b.__cur;
    }
    friend constexpr auto operator<=>(const basic_const_iterator &a,
                                      const basic_const_iterator &b)
        requires random_access_iterator<Iterator> &&
                 three_way_comparable<Iterator>
    {
        return a.__cur <=> b.__cur;
    }

    friend constexpr basic_const_iterator operator+(basic_const_iterator i,
                                                    difference_type n)
        requires random_access_iterator<Iterator>
    {
        return basic_const_iterator(i.__cur + n);
    }
    friend constexpr basic_const_iterator operator+(difference_type n,
                                                    basic_const_iterator i)
        requires random_access_iterator<Iterator>
    {
        return basic_const_iterator(i.__cur + n);
    }
    friend constexpr basic_const_iterator operator-(basic_const_iterator i,
                                                    difference_type n)
        requires random_access_iterator<Iterator>
    {
        return basic_const_iterator(i.__cur - n);
    }
    friend constexpr difference_type operator-(const basic_const_iterator &a,
                                               const basic_const_iterator &b)
        requires sized_sentinel_for<Iterator, Iterator>
    {
        return a.__cur - b.__cur;
    }

    friend constexpr __RvalRef iter_move(const basic_const_iterator &i) noexcept(
        noexcept(static_cast<__RvalRef>(ranges::iter_move(i.__cur))))
    {
        return static_cast<__RvalRef>(ranges::iter_move(i.__cur));
    }
};

// boxcxx keys its category concepts on iterator_traits, so spell the five
// member types out (the class itself omits pointer / a non-forward category
// per the standard). iterator_concept comes from the member above.
template <input_iterator I>
struct iterator_traits<basic_const_iterator<I>> {
    using iterator_concept =
        typename basic_const_iterator<I>::iterator_concept;
    using iterator_category =
        conditional_t<forward_iterator<I>,
                      typename iterator_traits<I>::iterator_category,
                      input_iterator_tag>;
    using value_type      = iter_value_t<I>;
    using difference_type = iter_difference_t<I>;
    using pointer         = void;
    using reference       = iter_const_reference_t<I>;
};

template <input_iterator I>
using const_iterator =
    conditional_t<__iter_impl::ConstantIterator<I>, I, basic_const_iterator<I>>;

namespace __iter_impl {
// const_sentinel must be S itself when S is not an input_iterator. A bare
// conditional_t would eagerly form const_iterator<S> — a *constrained* alias
// — for the false branch too, hard-erroring on the constraint instead of
// yielding S. Defer it to the specialization so it is only formed when S
// really is an input_iterator.
template <semiregular S>
struct ConstSentinelT {
    using type = S;
};
template <semiregular S>
    requires input_iterator<S>
struct ConstSentinelT<S> {
    using type = const_iterator<S>;
};
} // namespace __iter_impl

template <semiregular S>
using const_sentinel = typename __iter_impl::ConstSentinelT<S>::type;

template <input_iterator I>
constexpr const_iterator<I> make_const_iterator(I it)
{
    return it;
}
template <semiregular S>
constexpr const_sentinel<S> make_const_sentinel(S s)
{
    return s;
}

} // namespace std

#endif // BOXCXX_ITERATOR
