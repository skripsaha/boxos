// boxcxx — <exception>
// exception/bad_exception, terminate machinery, uncaught_exceptions, and
// the exception_ptr / nested_exception propagation surface (over the
// Itanium refcounted-primary + dependent-exception ABI).
#ifndef BOXCXX_EXCEPTION
#define BOXCXX_EXCEPTION

#include <__bits/exception_base>  // std::exception / std::bad_exception (shared with <typeinfo>)
#include <cstddef>
#include <type_traits>
#include <typeinfo>   // typeid / type_info — exception_ptr_cast (P2927R3)

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_exception_ptr_cast
#define BOXCXX_OWNS_uncaught_exceptions
#include <__bits/version_exception>

namespace std {

using terminate_handler = void (*)();

terminate_handler set_terminate(terminate_handler handler) noexcept;
terminate_handler get_terminate() noexcept;
[[noreturn]] void terminate() noexcept;

int uncaught_exceptions() noexcept;

} // namespace std

// Itanium exception-propagation ABI — defined in cxa_exception.cpp.
extern "C" {
void *__cxa_current_primary_exception() noexcept;
void  __cxa_increment_exception_refcount(void *) noexcept;
void  __cxa_decrement_exception_refcount(void *) noexcept;
[[noreturn]] void __cxa_rethrow_primary_exception(void *);
}

namespace std {

// ── exception_ptr ([propagation]) ────────────────────────────────────────

class exception_ptr;
exception_ptr             current_exception() noexcept;
[[noreturn]] void         rethrow_exception(exception_ptr);

class exception_ptr {
    void *ptr_ = nullptr;

    struct Adopt {};
    exception_ptr(void *p, Adopt) noexcept : ptr_(p) {}

    friend exception_ptr current_exception() noexcept;
    friend void          rethrow_exception(exception_ptr);

public:
    exception_ptr() noexcept = default;
    exception_ptr(nullptr_t) noexcept {}
    exception_ptr(const exception_ptr &o) noexcept : ptr_(o.ptr_)
    {
        if (ptr_) __cxa_increment_exception_refcount(ptr_);
    }
    exception_ptr(exception_ptr &&o) noexcept : ptr_(o.ptr_) { o.ptr_ = nullptr; }
    exception_ptr &operator=(exception_ptr o) noexcept // copy/move-and-swap
    {
        void *t = ptr_;
        ptr_    = o.ptr_;
        o.ptr_  = t;
        return *this;
    }
    ~exception_ptr()
    {
        if (ptr_) __cxa_decrement_exception_refcount(ptr_);
    }

    explicit operator bool() const noexcept { return ptr_ != nullptr; }

    friend bool operator==(const exception_ptr &a,
                           const exception_ptr &b) noexcept
    {
        return a.ptr_ == b.ptr_;
    }

private:
    // Only exception_ptr_cast below reads this: the raw thrown-object pointer,
    // which the runtime turns back into the Itanium exception header.
    void *__object() const noexcept { return ptr_; }
    template <class E>
    friend const E *exception_ptr_cast(const exception_ptr &) noexcept;
};

inline exception_ptr current_exception() noexcept
{
    return exception_ptr(__cxa_current_primary_exception(),
                         exception_ptr::Adopt{});
}

[[noreturn]] inline void rethrow_exception(exception_ptr p)
{
    __cxa_rethrow_primary_exception(p.ptr_);
    __builtin_unreachable();
}

// P2927R3. Looking inside an exception_ptr previously meant rethrowing it into
// a try block: an unwind, a pair of catch handlers, and impossible from a
// noexcept function. This asks the runtime the same question the personality
// routine asks -- would a handler of type E catch this? -- and gets the
// base-adjusted pointer back, or null.
//
// The returned pointer is valid for as long as the exception_ptr owns the
// exception, and no longer; there is deliberately no rvalue overload that
// would hand back a pointer into a temporary.
extern "C" void *__boxcxx_exception_ptr_cast(void *, const type_info *) noexcept;

template <class E>
const E *exception_ptr_cast(const exception_ptr &p) noexcept
{
    static_assert(!is_const_v<E> && !is_volatile_v<E>,
                  "exception_ptr_cast: E must be cv-unqualified [propagation]");
    static_assert(!is_reference_v<E> && !is_array_v<E> && !is_function_v<E>,
                  "exception_ptr_cast: E must be an object type that is not an array");
    return static_cast<const E *>(__boxcxx_exception_ptr_cast(p.__object(), &typeid(E)));
}

template <class E>
exception_ptr make_exception_ptr(E e) noexcept
{
    try {
        throw e;
    } catch (...) {
        return current_exception();
    }
}

// ── nested_exception ([except.nested]) ───────────────────────────────────

class nested_exception {
    exception_ptr nested_;

public:
    nested_exception() noexcept : nested_(current_exception()) {}
    nested_exception(const nested_exception &) noexcept            = default;
    nested_exception &operator=(const nested_exception &) noexcept = default;
    virtual ~nested_exception()                                    = default;

    [[noreturn]] void rethrow_nested() const
    {
        if (nested_) rethrow_exception(nested_);
        terminate();
    }
    exception_ptr nested_ptr() const noexcept { return nested_; }
};

namespace __exc {
template <class U>
struct NestedWrap : U, nested_exception {
    explicit NestedWrap(const U &u) : U(u) {}
    explicit NestedWrap(U &&u) : U(static_cast<U &&>(u)) {}
};
} // namespace __exc

template <class T>
[[noreturn]] void throw_with_nested(T &&t)
{
    using U = remove_cvref_t<T>;
    if constexpr (is_class_v<U> && !is_final_v<U> &&
                  !is_base_of_v<nested_exception, U>)
        throw __exc::NestedWrap<U>(static_cast<T &&>(t));
    else
        throw static_cast<T &&>(t);
}

template <class E>
void rethrow_if_nested(const E &e)
{
    if constexpr (is_class_v<E> && is_polymorphic_v<E>) {
        const nested_exception *p =
            dynamic_cast<const nested_exception *>(__builtin_addressof(e));
        if (p) p->rethrow_nested();
    }
}

} // namespace std

#endif // BOXCXX_EXCEPTION
