// boxcxx — <locale>
//
// One locale, and the facets the standard requires it to carry.
//
// ── what a locale is here ───────────────────────────────────────────────
// In the standard a locale is a CONTAINER of facets: it owns a vector of
// them indexed by locale::id, refcounts each one, and use_facet<F> is a
// lookup in that vector. That shape exists because a program may hold several
// locales at once and install its own facets into them. BoxOS has exactly one
// locale and no way to make another, so a per-locale vector would be a table
// with one row, and the row would be the program.
//
// So a locale here is not a container of facets — it is a NAME for the one
// behaviour the system has, and the facets are part of the image, the same
// way Ф37's Nameplate is a table inside the image rather than something a
// process carries. use_facet<F>(loc) ignores loc and hands back the F that
// was linked in. Measured consequences, all of them the point:
//
//   * locale stays an EMPTY, trivially copyable class. ios_base and every
//     basic_streambuf hold one by value; had it grown a refcounted registry,
//     every stream copy would have become an atomic pair.
//   * a facet is EIGHT BYTES OF .rodata — its vtable pointer, and nothing
//     else. Constant-initialized, so building it costs nothing at startup:
//     no guard variable, no __cxa_guard_acquire, no _GLOBAL__sub_I. It lands
//     in .rodata rather than .data.rel.ro because this target links -fno-pic
//     and static, so the vtable address is settled at link time and no load-
//     time relocation is left to make the page writable for. Measured in the
//     generated object, not assumed.
//   * they can be asked at ANY instant — during static teardown, inside a
//     fault handler — because nothing ever destroys them. See the note on
//     ~facet() below for the one place that cost something.
//
// ── still deliberately absent ───────────────────────────────────────────
// The category facets: ctype<>, num_get<>, num_put<>, numpunct<>, collate<>,
// moneypunct<>, money_get<>, money_put<>, time_get<>, time_put<>, messages<>.
// Also facet INSTALLATION — locale(const locale&, Facet*) and the
// category-combining constructors — and the _byname family, codecvt_byname
// included. A codecvt_byname("ru_RU.KOI8-R") that quietly produced UTF-8
// would be exactly the silent lie this header refuses to tell; a program that
// needs real facet-based i18n fails to COMPILE, because there is nothing here
// to call. use_facet<F> for an F this image does not carry is likewise a
// compile error rather than a bad_cast at run time — the same answer, moved
// to where it costs nothing to act on.
#ifndef BOXCXX_LOCALE
#define BOXCXX_LOCALE

#include <__bits/c_mbstate>
#include <__bits/codecvt_engine>
#include <cstddef>
#include <string>

namespace std {

class locale {
public:
    class id;
    class facet;

    using category = int;
    static constexpr category none     = 0;
    static constexpr category ctype    = 1 << 0;
    static constexpr category numeric  = 1 << 1;
    static constexpr category collate  = 1 << 2;
    static constexpr category time     = 1 << 3;
    static constexpr category monetary = 1 << 4;
    static constexpr category messages = 1 << 5;
    static constexpr category all      = ctype | numeric | collate | time | monetary | messages;

    locale() noexcept                  = default;
    locale(const locale &) noexcept    = default;
    locale &operator=(const locale &) noexcept = default;
    ~locale()                          = default;

    // Accepts and ignores any name — every locale this type can construct
    // behaves as "C". A real implementation would throw runtime_error for
    // an unknown name; this is a documented, deliberate simplification.
    explicit locale(const char *) noexcept {}

    string name() const { return "C"; }
    bool operator==(const locale &) const noexcept { return true; }

    static const locale &classic() noexcept
    {
        static const locale c;
        return c;
    }
    static locale global(const locale &) noexcept { return classic(); }
};

// ── locale::id [locale.id] ──────────────────────────────────────────────
// Present because every facet's synopsis declares `static locale::id id;` and
// a program is entitled to name it. It carries no index: lookup here is by
// TYPE, so there is no vector for an index to point into. Non-copyable, as
// the standard says, which is the whole of its observable behaviour.
class locale::id {
public:
    constexpr id() noexcept = default;
    id(const id &)          = delete;
    void operator=(const id &) = delete;
};

// ── locale::facet [locale.facet] ────────────────────────────────────────
// ‼ ~facet() is NOT virtual, and that is the one deviation this design pays
// for. The standard makes it virtual because a locale OWNS its facets and
// deletes them through a facet* when the refcount drops. Nothing here owns a
// facet — they are part of the image — so the virtual destructor would buy
// exactly one thing: mortality. Measured with x86_64-elf-g++ 15.2.0: give
// this destructor `virtual` and every facet object gains a __cxa_atexit
// registration, so it is torn down during static destruction and its vptr is
// rewritten to a base that has no do_in; GCC does not implement the
// no_destroy attribute that would suppress that (it warns -Wattributes and
// ignores it). A facet that stops answering before the program stops running
// is worse than one that cannot be deleted polymorphically, in a system where
// nothing deletes one at all.
//
// The refs parameter is likewise kept and not stored. Its meaning is "0: the
// locale destroys this facet; nonzero: it does not" — and here no locale
// destroys any facet ever, so a counter would be a field that no code can
// read and no test can move.
class locale::facet {
public:
    facet(const facet &)      = delete;
    void operator=(const facet &) = delete;

protected:
    constexpr explicit facet(size_t = 0) noexcept {}
    ~facet() = default;
};

// ── codecvt_base ────────────────────────────────────────────────────────
// Defined in <__bits/codecvt_engine>, which needs to name its own result
// type. It is re-exported here unchanged, which is where [locale.syn] puts it.

// ── codecvt [locale.codecvt] ────────────────────────────────────────────
// Declared for every triple, defined for the four Table 104 requires:
// <char, char>, <wchar_t, char>, <char16_t, char8_t> and <char32_t, char8_t>.
// Any other combination is an incomplete type rather than a silently wrong
// conversion. The two Annex D pairs deprecated in C++20 —
// codecvt<char16_t, char, mbstate_t> and codecvt<char32_t, char, mbstate_t> —
// are not here: C++26 is already removing the neighbouring deprecated Unicode
// conversion machinery (P2871R3), and building new code onto a surface the
// standard is walking away from is taking on a debt at the moment of writing.
template <class InternT, class ExternT, class StateT>
class codecvt;

namespace __cvt {

// The public half of every codecvt: seven members that do nothing but call
// the virtual half. Written once because it IS once — [locale.codecvt] gives
// every specialization the same seven, and four hand-copied sets would be
// four chances for a forwarder to reach the wrong virtual. That failure mode
// is not hypothetical: Ф42-a found iswpunct reading the blank table, and an
// exhaustive sweep of the tables themselves could never have seen it.
template <class I, class E, class S>
class Face : public locale::facet, public codecvt_base {
public:
    using intern_type = I;
    using extern_type = E;
    using state_type  = S;

    result out(S &state, const I *from, const I *from_end, const I *&from_next,
               E *to, E *to_end, E *&to_next) const
    {
        return do_out(state, from, from_end, from_next, to, to_end, to_next);
    }

    result in(S &state, const E *from, const E *from_end, const E *&from_next,
              I *to, I *to_end, I *&to_next) const
    {
        return do_in(state, from, from_end, from_next, to, to_end, to_next);
    }

    result unshift(S &state, E *to, E *to_end, E *&to_next) const
    {
        return do_unshift(state, to, to_end, to_next);
    }

    int  encoding() const noexcept       { return do_encoding(); }
    bool always_noconv() const noexcept  { return do_always_noconv(); }
    int  max_length() const noexcept     { return do_max_length(); }

    int length(S &state, const E *from, const E *end, size_t max) const
    {
        return do_length(state, from, end, max);
    }

protected:
    constexpr explicit Face(size_t refs = 0) noexcept : locale::facet(refs) {}
    ~Face() = default;

    virtual result do_out(S &, const I *, const I *, const I *&,
                          E *, E *, E *&) const = 0;
    virtual result do_in(S &, const E *, const E *, const E *&,
                         I *, I *, I *&) const = 0;
    virtual result do_unshift(S &, E *, E *, E *&) const = 0;
    virtual int    do_encoding() const noexcept          = 0;
    virtual bool   do_always_noconv() const noexcept     = 0;
    virtual int    do_length(S &, const E *, const E *, size_t) const = 0;
    virtual int    do_max_length() const noexcept        = 0;
};

// The three converting facets, which differ only in their unit types and in
// whether a code point above the BMP takes one internal unit or a surrogate
// pair. mbstate_t is named in every signature and read in none: UTF-8 has no
// shift state, and the protocol lets a converter say so by stopping at an
// unfinished character instead of swallowing it. See <__bits/codecvt_engine>.
template <class I, class E, bool Utf16>
class Utf8Face : public Face<I, E, mbstate_t> {
    using Base   = Face<I, E, mbstate_t>;
    using Engine = Utf8<I, E, Utf16>;

public:
    using result = typename Base::result;

protected:
    constexpr explicit Utf8Face(size_t refs = 0) noexcept : Base(refs) {}
    ~Utf8Face() = default;

    result do_out(mbstate_t &, const I *from, const I *from_end, const I *&from_next,
                  E *to, E *to_end, E *&to_next) const override
    {
        return Engine::Out(from, from_end, from_next, to, to_end, to_next);
    }

    result do_in(mbstate_t &, const E *from, const E *from_end, const E *&from_next,
                 I *to, I *to_end, I *&to_next) const override
    {
        return Engine::In(from, from_end, from_next, to, to_end, to_next);
    }

    // noconv, not ok: [locale.codecvt.virtuals] gives noconv the meaning "no
    // termination sequence is needed for this state_type", which is precisely
    // true of an encoding with no shift state. libc++'s own char8_t facets
    // answer noconv here too; only its wchar_t facet — the one delegating to
    // the platform — answers ok.
    result do_unshift(mbstate_t &, E *to, E *, E *&to_next) const override
    {
        to_next = to;
        return codecvt_base::noconv;
    }

    // 0 = "variable number of external units per internal one", which is what
    // UTF-8 is. -1 would mean state-dependent, and this encoding is not.
    int  do_encoding() const noexcept override      { return 0; }
    bool do_always_noconv() const noexcept override { return false; }

    // 4 for all three, and for char16_t that is deliberately NOT the literal
    // answer. [locale.codecvt.virtuals] defines max_length as the largest
    // do_length(state, from, from_end, 1) can return, and with room for one
    // UTF-16 unit an astral character yields nothing at all, so the literal
    // maximum is 3 — the longest BMP sequence. But what every caller uses this
    // number for is sizing the byte buffer that must hold one character's
    // worth of input, and a surrogate pair's is four. Both reference
    // implementations answer 4 here for the same reason.
    int  do_max_length() const noexcept override    { return 4; }

    int do_length(mbstate_t &, const E *from, const E *end, size_t max) const override
    {
        return Engine::Length(from, end, max);
    }
};

} // namespace __cvt

// codecvt<char, char, mbstate_t> — the identity. [locale.codecvt.virtuals]
// requires noconv from a facet whose internal and external types are the
// same, and noconv means the caller should move the characters itself: from_next
// and to_next stay where they started and nothing is written.
template <>
class codecvt<char, char, mbstate_t> : public __cvt::Face<char, char, mbstate_t> {
    using Base = __cvt::Face<char, char, mbstate_t>;

public:
    constexpr explicit codecvt(size_t refs = 0) noexcept : Base(refs) {}

    static locale::id id;

protected:
    ~codecvt() = default;

    result do_out(mbstate_t &, const char *from, const char *, const char *&from_next,
                  char *to, char *, char *&to_next) const override
    {
        from_next = from;
        to_next   = to;
        return noconv;
    }

    result do_in(mbstate_t &, const char *from, const char *, const char *&from_next,
                 char *to, char *, char *&to_next) const override
    {
        from_next = from;
        to_next   = to;
        return noconv;
    }

    result do_unshift(mbstate_t &, char *to, char *, char *&to_next) const override
    {
        to_next = to;
        return noconv;
    }

    int  do_encoding() const noexcept override      { return 1; }
    bool do_always_noconv() const noexcept override { return true; }
    int  do_max_length() const noexcept override    { return 1; }

    int do_length(mbstate_t &, const char *from, const char *end, size_t max) const override
    {
        const size_t have = static_cast<size_t>(end - from);
        return static_cast<int>(have < max ? have : max);
    }
};

inline locale::id codecvt<char, char, mbstate_t>::id{};

// codecvt<wchar_t, char, mbstate_t> — the one <fstream> and the wide console
// stand on. wchar_t is 32-bit here and holds a code point, so this is UTF-8
// against UTF-32 with no surrogate arithmetic at all.
template <>
class codecvt<wchar_t, char, mbstate_t>
    : public __cvt::Utf8Face<wchar_t, char, false> {
    using Base = __cvt::Utf8Face<wchar_t, char, false>;

public:
    constexpr explicit codecvt(size_t refs = 0) noexcept : Base(refs) {}

    static locale::id id;

protected:
    ~codecvt() = default;
};

inline locale::id codecvt<wchar_t, char, mbstate_t>::id{};

// codecvt<char16_t, char8_t, mbstate_t> — the only one that pairs surrogates.
template <>
class codecvt<char16_t, char8_t, mbstate_t>
    : public __cvt::Utf8Face<char16_t, char8_t, true> {
    using Base = __cvt::Utf8Face<char16_t, char8_t, true>;

public:
    constexpr explicit codecvt(size_t refs = 0) noexcept : Base(refs) {}

    static locale::id id;

protected:
    ~codecvt() = default;
};

inline locale::id codecvt<char16_t, char8_t, mbstate_t>::id{};

// codecvt<char32_t, char8_t, mbstate_t> — the same conversion as the wchar_t
// facet, told in the unit types the standard chose for it.
template <>
class codecvt<char32_t, char8_t, mbstate_t>
    : public __cvt::Utf8Face<char32_t, char8_t, false> {
    using Base = __cvt::Utf8Face<char32_t, char8_t, false>;

public:
    constexpr explicit codecvt(size_t refs = 0) noexcept : Base(refs) {}

    static locale::id id;

protected:
    ~codecvt() = default;
};

inline locale::id codecvt<char32_t, char8_t, mbstate_t>::id{};

// ── the facets this image carries [locale.convenience] ──────────────────
// The list is a property of the PROGRAM, not of a locale object, so it is a
// variable template rather than a runtime table. has_facet answers from it;
// use_facet refuses to compile against anything not on it.
template <class Facet>
inline constexpr bool __is_facet = false;
template <> inline constexpr bool __is_facet<codecvt<char, char, mbstate_t>>         = true;
template <> inline constexpr bool __is_facet<codecvt<wchar_t, char, mbstate_t>>      = true;
template <> inline constexpr bool __is_facet<codecvt<char16_t, char8_t, mbstate_t>>  = true;
template <> inline constexpr bool __is_facet<codecvt<char32_t, char8_t, mbstate_t>>  = true;

// Where a facet lives. Deriving is what reaches its protected destructor, and
// `final` is what stops anyone reaching further. The object is constant-
// initialized: no guard, no atexit, no initializer function — asking for a
// facet is an address, not a call.
template <class Facet>
class __FacetHome final : public Facet {
public:
    constexpr __FacetHome() noexcept : Facet(1) {}
};

// const, so the object is read-only memory rather than writable data. On this
// target that is literally .rodata (measured): -fno-pic and a static link
// settle the vtable address before the program ever runs, so nothing has to
// stay writable for a relocation, and a stray write cannot turn a facet into
// something else.
template <class Facet>
inline constinit const __FacetHome<Facet> __facet_home{};

static_assert(is_trivially_destructible_v<__FacetHome<codecvt<wchar_t, char, mbstate_t>>>,
              "a facet must outlive every caller: a non-trivial destructor would "
              "register __cxa_atexit and stop it answering during teardown");

template <class Facet>
bool has_facet(const locale &) noexcept
{
    return __is_facet<Facet>;
}

template <class Facet>
const Facet &use_facet(const locale &)
{
    static_assert(__is_facet<Facet>,
                  "boxcxx carries no such facet: <locale> has the four codecvt "
                  "specializations Table 104 requires and no others, and facets "
                  "cannot be installed into a locale here");
    return __facet_home<Facet>;
}

} // namespace std

#endif // BOXCXX_LOCALE
