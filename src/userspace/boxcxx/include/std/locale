// boxcxx — <locale>
//
// A locale is a container of facets, and this is the header that hands you
// both. The types are split across leaves, and the split is forced by a cycle
// rather than chosen for tidiness. The line that decides where a facet lives
// is one question: does it take an `ios_base&`?
//
// Free of ios_base, and so safe for <ios> itself to include:
//
//   <__bits/locale_core>    locale, locale::id, locale::facet, the four
//                           codecvt facets and codecvt_byname. <ios> DOES
//                           include this one, because ios_base holds a locale
//                           by value.
//   <__bits/locale_ctype>   ctype_base, ctype, ctype_byname. <ios> includes
//                           this one too — [basic.ios.members] defines
//                           widen/narrow as calls into it, so a stream that
//                           could not see it would have to answer for itself.
//   <__bits/locale_text>    collate, messages and locale::operator(). Free of
//                           ios_base as well, but <ios> has no use for it, so
//                           only <locale> pulls it in.
//
// Needing a COMPLETE ios_base — each reads flags(), width() or precision() out
// of one — and therefore out of <ios>'s reach:
//
//   <__bits/locale_facets>  numpunct, numpunct_byname, num_put
//   <__bits/locale_numget>  num_get
//   <__bits/locale_money>   money_base, moneypunct, moneypunct_byname,
//                           money_get, money_put
//   <__bits/locale_time>    time_base, time_get, time_get_byname, time_put,
//                           time_put_byname
//
// Include <locale> and you get all seven. Every leaf in the second group
// includes leaves from the first; none in the first includes any of the
// second, which is the acyclicity the whole split exists to preserve.
//
// ── the one locale, and what it now contains ────────────────────────────
// There is still exactly one locale on this system: locale("C"), locale("")
// and locale("POSIX") name it, and any other name is refused rather than
// quietly answered as "C". What changed in Ф43 is that a locale is a
// CONTAINER — a program can install its own facet into a copy of it and imbue
// a stream with the result, which is what the standard's whole facet
// mechanism is for and what boxcxx could not do before.
//
// The reasoning behind the container's shape — why a facet's destructor is
// virtual, why the image's facets live in union cells, what it cost in bytes
// and where that was measured — is at the top of <__bits/locale_core>.
#ifndef BOXCXX_LOCALE
#define BOXCXX_LOCALE

#include <__bits/locale_core>
#include <__bits/locale_ctype>
#include <__bits/locale_facets>
#include <__bits/locale_money>
#include <__bits/locale_numget>
#include <__bits/locale_time>
#include <__bits/locale_text>

#endif // BOXCXX_LOCALE
