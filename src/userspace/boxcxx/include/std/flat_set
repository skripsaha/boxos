// A flat adaptor has no allocator of its own; it uses one exactly when its
// key container does.
template <typename Key, typename Compare, typename KeyContainer, typename Alloc>
struct uses_allocator<flat_set<Key, Compare, KeyContainer>, Alloc>
    : bool_constant<uses_allocator_v<KeyContainer, Alloc>> {};
template <typename Key, typename Compare, typename KeyContainer, typename Alloc>
struct uses_allocator<flat_multiset<Key, Compare, KeyContainer>, Alloc>
    : bool_constant<uses_allocator_v<KeyContainer, Alloc>> {};

// ── [flat.set.erasure] / [flat.multiset.erasure] ────────────────────────
// Routed through the PUBLIC extract()/replace() pair, which gives the whole
// specification for free: exactly size() predicate applications (one pass,
// one call each), stable (survivors keep their order), and -- if the
// predicate throws -- a valid-but-empty container, because extract() has
// already emptied the set and replace() never runs. replace()'s sortedness
// precondition holds by construction: deleting from a sorted range leaves
// it sorted, and deleting from a range with no equal elements leaves it
// with none.

namespace __flat {

template <typename S, typename Pred>
typename S::size_type EraseIfVia(S &s, Pred &pred)
{
    auto cont  = std::move(s).extract();
    auto first = cont.begin();
    auto last  = cont.end();
    auto out   = first;
    for (; first != last; ++first)
        if (!bool(pred(std::as_const(*first)))) {
            if (out != first) *out = std::move(*first);
            ++out;
        }
    auto removed = static_cast<typename S::size_type>(last - out);
    cont.erase(out, last);
    s.replace(std::move(cont));
    return removed;
}

} // namespace __flat

template <typename Key, typename Compare, typename KeyContainer, typename Pred>
typename flat_set<Key, Compare, KeyContainer>::size_type
erase_if(flat_set<Key, Compare, KeyContainer> &c, Pred pred)
{
    return __flat::EraseIfVia(c, pred);
}
template <typename Key, typename Compare, typename KeyContainer, typename Pred>
typename flat_multiset<Key, Compare, KeyContainer>::size_type
erase_if(flat_multiset<Key, Compare, KeyContainer> &c, Pred pred)
{
    return __flat::EraseIfVia(c, pred);
}

// ── deduction guides ────────────────────────────────────────────────────
// Twelve per class. The constraints are [container.adaptors.general]/6
// written out: /6.1 (InputIterator must be one) through the tree's
// Cpp17InputIterator, /6.2 and /6.3 (a Compare or a KeyContainer parameter
// must not deduce an allocator) through NotAllocatorLike / !AllocatorLike,
// /6.4 (a lone Allocator parameter must deduce one) through AllocatorLike,
// /6.6 (uses_allocator_v) and /6.7 (the comparator must be callable on two
// keys) as requires-clauses.

template <typename KeyContainer,
          NotAllocatorLike Compare = less<typename KeyContainer::value_type>>
    requires(!AllocatorLike<KeyContainer>) &&
            is_invocable_v<const Compare &, const typename KeyContainer::value_type &,
                           const typename KeyContainer::value_type &>
flat_set(KeyContainer, Compare = Compare())
    -> flat_set<typename KeyContainer::value_type, Compare, KeyContainer>;

template <typename KeyContainer, AllocatorLike Allocator>
    requires(!AllocatorLike<KeyContainer>) && uses_allocator_v<KeyContainer, Allocator>
flat_set(KeyContainer, Allocator)
    -> flat_set<typename KeyContainer::value_type,
                less<typename KeyContainer::value_type>, KeyContainer>;

template <typename KeyContainer, NotAllocatorLike Compare, AllocatorLike Allocator>
    requires(!AllocatorLike<KeyContainer>) && uses_allocator_v<KeyContainer, Allocator> &&
            is_invocable_v<const Compare &, const typename KeyContainer::value_type &,
                           const typename KeyContainer::value_type &>
flat_set(KeyContainer, Compare, Allocator)
    -> flat_set<typename KeyContainer::value_type, Compare, KeyContainer>;

template <typename KeyContainer,
          NotAllocatorLike Compare = less<typename KeyContainer::value_type>>
    requires(!AllocatorLike<KeyContainer>) &&
            is_invocable_v<const Compare &, const typename KeyContainer::value_type &,
                           const typename KeyContainer::value_type &>
flat_set(sorted_unique_t, KeyContainer, Compare = Compare())
    -> flat_set<typename KeyContainer::value_type, Compare, KeyContainer>;

template <typename KeyContainer, AllocatorLike Allocator>
    requires(!AllocatorLike<KeyContainer>) && uses_allocator_v<KeyContainer, Allocator>
flat_set(sorted_unique_t, KeyContainer, Allocator)
    -> flat_set<typename KeyContainer::value_type,
