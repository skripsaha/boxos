// ── range access const/rvalue aliases ([range.access], C++23) ───────────
// const_iterator_t / const_sentinel_t / range_const_reference_t live here
// (not in <iterator>) because they lean on ranges::iterator_t / sentinel_t.
namespace std {
namespace ranges {

template <range R>
using const_iterator_t = const_iterator<iterator_t<R>>;
template <range R>
using const_sentinel_t = const_sentinel<sentinel_t<R>>;
template <range R>
using range_const_reference_t = iter_const_reference_t<iterator_t<R>>;

} // namespace ranges
} // namespace std

#endif // BOXCXX_RANGES
