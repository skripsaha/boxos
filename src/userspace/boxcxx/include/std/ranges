// boxcxx — <ranges> (core)
// The range concepts, CPOs and associated type aliases now live in
// <__bits/ranges_core> (a leaf header shared with the containers that need
// ContainerCompatibleRange; dangling/borrowed_iterator_t live there too, for
// <numeric>'s sake). This file adds the view machinery (elements_of,
// view_base/view/viewable_range) plus, via the includes below, the
// full views/adaptors graph (view_interface, ref/owning_view, the pipe
// machinery, all/take/drop/filter/transform, the range factories, and every
// Ф29 view) and ranges::to.
#ifndef BOXCXX_RANGES
#define BOXCXX_RANGES

#include <__bits/ranges_core>
#include <__bits/version_ranges>
#include <concepts>
#include <cstddef>
#include <iterator>
#include <type_traits>

namespace std {

// Forward declarations for the borrowed/view markers below — pulling
// the full headers in would be a heavyweight include for every <ranges>
// user that wants neither.
template <typename C>
struct char_traits;
template <typename C, typename Traits>
class basic_string_view;
template <typename T, size_t Extent>
class span;
template <typename T>
class allocator;

namespace ranges {

// ── elements_of ([range.elementsof], C++23) ─────────────────────────────
// Tags a range (plus an allocator) for recursive yielding by std::generator
// (co_yield ranges::elements_of(inner)). allocator<byte> is the default;
// std::allocator is forward-declared above — the complete type is only
// needed where elements_of is actually instantiated (e.g. <generator>,
// which pulls in <memory>).
template <range _Range, typename _Allocator = allocator<byte>>
struct elements_of {
    [[no_unique_address]] _Range range;
    [[no_unique_address]] _Allocator allocator = _Allocator();
};

template <typename _Range, typename _Allocator = allocator<byte>>
elements_of(_Range &&, _Allocator = _Allocator())
    -> elements_of<_Range &&, _Allocator>;

// ── view machinery ([range.view]) ───────────────────────────────────────

struct view_base {};

template <typename R>
inline constexpr bool enable_view = derived_from<R, view_base>;

template <typename R>
concept view = range<R> && movable<R> && enable_view<R>;

template <typename R>
concept viewable_range =
    range<R> && ((view<remove_cvref_t<R>> &&
                  constructible_from<remove_cvref_t<R>, R>) ||
                 (!view<remove_cvref_t<R>> &&
                  (is_lvalue_reference_v<R> ||
                   movable<remove_reference_t<R>>)));

} // namespace ranges

// ── borrowed/view markers for the boxcxx view-like types ────────────────

namespace ranges {

template <typename C, typename T>
inline constexpr bool enable_borrowed_range<basic_string_view<C, T>> = true;
template <typename T, size_t E>
inline constexpr bool enable_borrowed_range<span<T, E>> = true;

template <typename C, typename T>
inline constexpr bool enable_view<basic_string_view<C, T>> = true;
template <typename T, size_t E>
inline constexpr bool enable_view<span<T, E>> =
    E == size_t(-1) || E == 0; // dynamic_extent (value spelled out — the
                               // constant lives in <span>)

} // namespace ranges

} // namespace std

// The views layer (view_interface, subrange, ref/owning_view, the pipe
// machinery, all/take/drop/filter/transform) builds on everything above.
#include <__bits/ranges_views>

// borrowed_subrange_t needs subrange, which is defined by the include above.
namespace std {
namespace ranges {

template <range R>
using borrowed_subrange_t =
    conditional_t<borrowed_range<R>, subrange<iterator_t<R>>, dangling>;

} // namespace ranges
} // namespace std

// The range factories (empty/single/iota/repeat) and the simple adaptors
// (reverse/as_const/as_rvalue/counted) build on the views layer above.
// Order matters: the adaptor chunk references empty_view from the factory.
#include <__bits/ranges_factory>
#include <__bits/ranges_adaptor_simple>

// elements/zip/adjacent (Ф29d-1): tuple-slice + enumerate, then the
// multi-range zip/zip_transform, then adjacent/adjacent_transform (which
// reuses TupleTransform and zip_transform's N==0 case from ranges_zip).
#include <__bits/ranges_elements>
#include <__bits/ranges_zip>
#include <__bits/ranges_adjacent>
#include <__bits/ranges_cartesian>

// join/join_with (Ф29e-1): join_view flattens a range of ranges; join_with
// additionally splices a delimiter between the flattened elements. Both
// reuse the NonPropagatingCache substrate defined in ranges_join.
#include <__bits/ranges_join>
#include <__bits/ranges_join_with>

// split/lazy_split (Ф29e-2): split_view yields eager subrange pieces;
// lazy_split_view yields lazily-materialized inner-view pieces. Both reuse
// MaybeConst/SimpleView from ranges_views and NonPropagatingCache/PresentIf
// from ranges_join.
#include <__bits/ranges_split>

// chunk/slide/stride (Ф29e-3): windowing + partition adaptors. chunk_view
// (both specializations) and chunk_by_view share DivCeil/ToUnsignedLike, so
// ranges_chunk is included first; ranges_slide and ranges_stride reuse those
// two helpers by name (defined once, not redefined — avoids an ODR clash
// across the three headers).
#include <__bits/ranges_chunk>  // chunk_view (2 specs) + chunk_by_view
#include <__bits/ranges_slide>  // slide_view (reuses ToUnsignedLike)
#include <__bits/ranges_stride> // stride_view (reuses DivCeil, ToUnsignedLike)

// ranges::to (Ф29f-2): conversion from a range to a container. Tail
// position — needs views::transform for its range-of-ranges recursive case.
#include <__bits/ranges_to>

// ── range access const/rvalue aliases ([range.access], C++23) ───────────
// const_iterator_t / const_sentinel_t / range_const_reference_t live here
// (not in <iterator>) because they lean on ranges::iterator_t / sentinel_t.
namespace std {
namespace ranges {

template <range R>
using const_iterator_t = const_iterator<iterator_t<R>>;
template <range R>
using const_sentinel_t = const_sentinel<sentinel_t<R>>;
template <range R>
using range_const_reference_t = iter_const_reference_t<iterator_t<R>>;

} // namespace ranges
} // namespace std

// ── basic_istream_view / views::istream ([range.istream]) ───────────────
// The one view whose source is a stream rather than a range: each ++ pulls
// the next value with operator>>, so a whole file of numbers becomes a
// pipeline stage. This library used to record it as unbuildable on BoxOS
// "because there are no global istream objects" — which was never the
// obstacle. It names no global: it binds whatever basic_istream& it is
// handed, and Ф30e put <istream> and <sstream> in the tree.
//
// Only <iosfwd> is included, and that is forced rather than chosen. An edge
// from <ranges> to <istream> is a GENUINE CYCLE in this tree, measured, not
// feared: <istream> → <ostream> → <ios>, and ios_base keeps its iword/pword
// and callback tables in std::vector, while <vector> → <algorithm> →
// <__bits/ranges_algo> → <ranges>. Including <istream> here therefore
// re-enters <ranges> with its guard already set and reaches <ios> with
// std::vector still mid-definition. (libc++ can afford the edge because its
// ios_base uses raw arrays for those three tables.)
//
// The consequence is one documented deviation, in CONFORMANCE §2 <ranges>:
// stream-extractable asks whether `is >> t` is valid, which needs the
// COMPLETE basic_istream, so a translation unit that includes only <ranges>
// finds the constraint unsatisfied rather than the type. Any program that
// can actually call it has a stream, and therefore has <istream> or
// <sstream> included already.
#include <iosfwd>

namespace std {
namespace ranges {

template <class Val, class CharT, class Traits>
concept __stream_extractable =
    requires(basic_istream<CharT, Traits> &is, Val &t) { is >> t; };

template <movable Val, class CharT, class Traits = char_traits<CharT>>
    requires default_initializable<Val> &&
             __stream_extractable<Val, CharT, Traits>
class basic_istream_view
    : public view_interface<basic_istream_view<Val, CharT, Traits>> {
public:
    constexpr explicit basic_istream_view(basic_istream<CharT, Traits> &stream)
        : __stream(addressof(stream))
    {
    }

    // begin() EXTRACTS. [range.istream.view]/1 specifies it that way, and it
    // is why this view is single-pass and why calling begin() twice consumes
    // two values — the standard's own shape, not a shortcut.
    constexpr auto begin()
    {
        *__stream >> __value;
        return __iterator{*this};
    }
    constexpr default_sentinel_t end() const noexcept { return default_sentinel; }

private:
    struct __iterator {
        using iterator_concept = input_iterator_tag;
        using difference_type  = ptrdiff_t;
        using value_type       = Val;

        constexpr explicit __iterator(basic_istream_view &parent) noexcept
            : __parent(addressof(parent))
        {
        }
        __iterator(const __iterator &)            = delete;
        __iterator(__iterator &&)                 = default;
        __iterator &operator=(const __iterator &) = delete;
        __iterator &operator=(__iterator &&)      = default;

        __iterator &operator++()
        {
            *__parent->__stream >> __parent->__value;
            return *this;
        }
        void operator++(int) { ++*this; }

        Val &operator*() const { return __parent->__value; }

        friend bool operator==(const __iterator &x, default_sentinel_t)
        {
            return !*x.__parent->__stream;
        }

    private:
        basic_istream_view *__parent;
    };

    basic_istream<CharT, Traits> *__stream;
    Val                           __value = Val();
};

template <class Val>
using istream_view = basic_istream_view<Val, char>;

namespace views {

// Not a range adaptor closure: it consumes a STREAM, so there is nothing for
// `|` to pipe into it, and deriving it from the closure base would let
// `vec | views::istream<int>` look plausible.
template <class Val>
struct __IstreamFn {
    template <class E>
        requires requires(E &&e) {
            basic_istream_view<Val, typename remove_cvref_t<E>::char_type,
                               typename remove_cvref_t<E>::traits_type>(e);
        }
    constexpr auto operator()(E &&e) const
    {
        return basic_istream_view<Val, typename remove_cvref_t<E>::char_type,
                                  typename remove_cvref_t<E>::traits_type>(e);
    }
};

template <class Val>
inline constexpr __IstreamFn<Val> istream{};

} // namespace views

} // namespace ranges
} // namespace std

#endif // BOXCXX_RANGES
