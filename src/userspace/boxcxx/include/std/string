template <typename C, typename T, typename A>
basic_string<C, T, A> operator+(const basic_string<C, T, A> &a,
                                const basic_string<C, T, A> &b)
{
    basic_string<C, T, A> r;
    r.reserve(a.size() + b.size());
    r.append(a);
    r.append(b);
    return r;
}
template <typename C, typename T, typename A>
basic_string<C, T, A> operator+(const basic_string<C, T, A> &a, const C *b)
{
    basic_string<C, T, A> r;
    r.reserve(a.size() + T::length(b));
    r.append(a);
    r.append(b);
    return r;
}
template <typename C, typename T, typename A>
basic_string<C, T, A> operator+(const C *a, const basic_string<C, T, A> &b)
{
    basic_string<C, T, A> r;
    r.reserve(T::length(a) + b.size());
    r.append(a);
    r.append(b);
    return r;
}
template <typename C, typename T, typename A>
basic_string<C, T, A> operator+(const basic_string<C, T, A> &a, C ch)
{
    basic_string<C, T, A> r(a);
    r.push_back(ch);
    return r;
}
template <typename C, typename T, typename A>
basic_string<C, T, A> operator+(C ch, const basic_string<C, T, A> &b)
{
    basic_string<C, T, A> r(1, ch);
    r.append(b);
    return r;
}
template <typename C, typename T, typename A>
basic_string<C, T, A> operator+(basic_string<C, T, A> &&a,
                                const basic_string<C, T, A> &b)
{
    a.append(b);
    return std::move(a);
}
template <typename C, typename T, typename A>
basic_string<C, T, A> operator+(basic_string<C, T, A> &&a, const C *b)
{
    a.append(b);
    return std::move(a);
}
template <typename C, typename T, typename A>
basic_string<C, T, A> operator+(basic_string<C, T, A> &&a, C ch)
{
    a.push_back(ch);
    return std::move(a);
}

template <typename C, typename T, typename A>
bool operator==(const basic_string<C, T, A> &a,
                const basic_string<C, T, A> &b) noexcept
{
    return basic_string_view<C, T>(a) == basic_string_view<C, T>(b);
}
