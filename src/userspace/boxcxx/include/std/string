// to_wstring: the same six overloads, and the same engine again. The digits
// to_string produces are ASCII, so widening them is the cast — and because
// this delegates rather than reimplementing, to_wstring inherits P2587R3 for
// free: to_wstring(1e-9) is L"1e-09" here, where libc++ 22 still answers
// L"0.000000" (measured, and its to_string says the same, so the reference is
// consistently behind rather than wrong about the wide half only).
namespace __string_impl {

inline wstring WidenAscii(const string &s)
{
    wstring out;
    out.reserve(s.size());
    for (char c : s) out.push_back(wchar_t(static_cast<unsigned char>(c)));
    return out;
}

} // namespace __string_impl

