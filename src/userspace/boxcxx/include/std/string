// boxcxx — <string>
// basic_string with SSO, libstdc++ layout shape: data pointer + size +
// union{heap capacity | inline buffer}. data() never branches; for char
// the inline buffer holds 15 chars + NUL in a 32-byte object. The whole
// find/compare family delegates to basic_string_view — one algorithm
// set, two types.
//
// P0980R1 (Ф39): the whole class is constexpr, SSO included, so a string
// short enough to live in the inline buffer can be a constant object and not
// merely a value computed at compile time. The one thing that took care is
// the union: see BeginSso() below. A LONG string cannot be a constexpr
// variable -- its characters come from an allocation, and no allocation
// outlives constant evaluation -- which is also true of both mainstream
// libraries, measured. to_string/stof/stod/stold (Ф9A-2/9A-3) are wired on
// <charconv> and stay run-time-only, as the standard has them.
//
// [string.io] (Ф30e commit 4): operator<</operator>>/getline are declared
// below using ONLY <iosfwd> (a forward-declared basic_ostream/
// basic_istream — a genuine leaf, no cycle) and DEFINED out-of-line in
// src/runtime/string_io.cpp, which alone includes both <string> and
// <ostream>/<istream> together. <string> cannot include <ostream> itself:
// <ios> (needed by every stream header) already transitively needs
// <string> (ios_base::failure : system_error : runtime_error(const
// string&)), so <string>#include<ostream> would cycle back through
// <ios>. Same out-of-line pattern already used for __bits/throw_helpers.
#ifndef BOXCXX_STRING
#define BOXCXX_STRING

#include <__bits/allocator_core>
#include <__bits/char_traits>
#include <__bits/iterator_core>
#include <__bits/ranges_core>
#include <__bits/throw_helpers>
#include <charconv>
#include <compare>
#include <cstddef>
#include <cstdint>
#include <initializer_list>
#include <iosfwd>
#include <limits>
#include <string_view>
#include <type_traits>
#include <utility>

// [version.syn] names this header as an owner of the macros below;
// nothing else here is declared, so nothing else is answered for.
#define BOXCXX_OWNS_algorithm_default_value_type
#define BOXCXX_OWNS_allocator_traits_is_always_equal
#define BOXCXX_OWNS_containers_ranges
#define BOXCXX_OWNS_erase_if
#include <__bits/version_containers>
#include <__bits/version_algorithm>   // algorithm_default_value_type
#define BOXCXX_OWNS_nonmember_container_access
#include <__bits/version_iterator>
#define BOXCXX_OWNS_constexpr_string
#define BOXCXX_OWNS_starts_ends_with
#define BOXCXX_OWNS_string_contains
#define BOXCXX_OWNS_string_resize_and_overwrite
#define BOXCXX_OWNS_string_subview
#define BOXCXX_OWNS_string_udls
#define BOXCXX_OWNS_string_view
#define BOXCXX_OWNS_to_string
#include <__bits/version_string>

namespace std {

template <typename C, typename Traits = char_traits<C>,
          typename Alloc = allocator<C>>
class basic_string {
    using AllocTraits = allocator_traits<Alloc>;

public:
    using traits_type            = Traits;
    using value_type             = C;
    using allocator_type         = Alloc;
    using size_type              = size_t;
    using difference_type        = ptrdiff_t;
    using reference              = C &;
    using const_reference        = const C &;
    using pointer                = C *;
    using const_pointer          = const C *;
    using iterator               = C *;
    using const_iterator         = const C *;
    using reverse_iterator       = std::reverse_iterator<iterator>;
    using const_reverse_iterator = std::reverse_iterator<const_iterator>;

    using __view = basic_string_view<C, Traits>;

    static constexpr size_type npos = size_type(-1);

private:
    // 16 bytes of inline storage — 15 chars + NUL for char.
    static constexpr size_type kSsoChars =
        16 / sizeof(C) > 1 ? 16 / sizeof(C) - 1 : 1;

    template <typename SV>
    static constexpr bool IsViewLike =
        is_convertible_v<const SV &, __view> &&
        !is_convertible_v<const SV &, const C *>;

public:
    // ── constructors ────────────────────────────────────────────────────

    constexpr basic_string() noexcept(noexcept(Alloc())) : basic_string(Alloc())
    {
    }
    constexpr explicit basic_string(const Alloc &a) noexcept : __alloc(a)
    {
        SetShort(0);
    }

    constexpr basic_string(size_type count, C ch, const Alloc &a = Alloc())
        : __alloc(a)
    {
        InitFill(count, ch);
    }
    constexpr basic_string(const C *s, size_type n, const Alloc &a = Alloc())
        : __alloc(a)
    {
        InitCopy(s, n);
    }
    constexpr basic_string(const C *s, const Alloc &a = Alloc()) : __alloc(a)
    {
        InitCopy(s, Traits::length(s));
    }
    basic_string(nullptr_t) = delete;

    template <typename It>
        requires(!is_integral_v<It>)
    // Only the walking branch is wrapped, and deliberately so. DropStorage
    // decides via IsLong(), i.e. by reading __data, which has no default
    // member initializer: it is meaningful only once SetShort(0) has run.
    // The pointer branch cannot leak anyway — InitCopy allocates last, and
    // both of its throw points (the length check, the allocation) happen
    // before anything is owned.
    constexpr basic_string(It first, It last, const Alloc &a = Alloc())
        : __alloc(a)
    {
        if constexpr (is_pointer_v<It>) {
            InitCopy(first, static_cast<size_type>(last - first));
        } else {
            SetShort(0);
            try {
                for (; first != last; ++first) push_back(*first);
            } catch (...) {
                DropStorage();
                throw;
            }
        }
    }

    constexpr basic_string(initializer_list<C> il, const Alloc &a = Alloc())
        : __alloc(a)
    {
        InitCopy(il.begin(), il.size());
    }

    template <ContainerCompatibleRange<C> R>
    constexpr basic_string(from_range_t, R &&rg, const Alloc &a = Alloc())
        : __alloc(a)
    {
        SetShort(0);
        try {
            for (auto &&ch : rg) push_back(ch);
        } catch (...) {
            DropStorage();
            throw;
        }
    }

    template <typename SV>
        requires IsViewLike<SV>
    constexpr explicit basic_string(const SV &t, const Alloc &a = Alloc())
        : __alloc(a)
    {
        __view v(t);
        InitCopy(v.data(), v.size());
    }
    template <typename SV>
        requires IsViewLike<SV>
    constexpr basic_string(const SV &t, size_type pos, size_type n,
                           const Alloc &a = Alloc())
        : __alloc(a)
    {
        __view v = __view(t).substr(pos, n);
        InitCopy(v.data(), v.size());
    }

    constexpr basic_string(const basic_string &other)
        : __alloc(AllocTraits::select_on_container_copy_construction(
              other.__alloc))
    {
        InitCopy(other.__data, other.__size);
    }
    constexpr basic_string(const basic_string &other, const Alloc &a)
        : __alloc(a)
    {
        InitCopy(other.__data, other.__size);
    }
    constexpr basic_string(const basic_string &other, size_type pos,
                           size_type n = npos, const Alloc &a = Alloc())
        : __alloc(a)
    {
        __view v = __view(other).substr(pos, n);
        InitCopy(v.data(), v.size());
    }

    constexpr basic_string(basic_string &&other) noexcept
        : __alloc(std::move(other.__alloc))
    {
        StealFrom(other);
    }
    constexpr basic_string(basic_string &&other, const Alloc &a) : __alloc(a)
    {
        if (AllocTraits::is_always_equal::value || a == other.__alloc) {
            StealFrom(other);
        } else {
            // Unequal allocator: copy the chars through our own allocator,
            // then empty the moved-from source (matches libstdc++/libc++ and
            // the map/set/unordered_* element-wise move path).
            InitCopy(other.__data, other.__size);
            other.clear();
        }
    }

    constexpr ~basic_string() { DropStorage(); }

    // ── assignment ──────────────────────────────────────────────────────

    constexpr basic_string &operator=(const basic_string &other)
    {
        if (this == &other) return *this;
        if constexpr (AllocTraits::propagate_on_container_copy_assignment::
                          value) {
            if (!(__alloc == other.__alloc)) {
                DropStorage();
                SetShort(0);
                __alloc = other.__alloc;
            } else {
                __alloc = other.__alloc;
            }
        }
        return assign(other.__data, other.__size);
    }

    constexpr basic_string &operator=(basic_string &&other) noexcept(
        AllocTraits::propagate_on_container_move_assignment::value ||
        AllocTraits::is_always_equal::value)
    {
        if (this == &other) return *this;
        constexpr bool pocma =
            AllocTraits::propagate_on_container_move_assignment::value;
        if (pocma || AllocTraits::is_always_equal::value ||
            __alloc == other.__alloc) {
            DropStorage();
            if constexpr (pocma) __alloc = std::move(other.__alloc);
            StealFrom(other);
            return *this;
        }
        // Unequal allocator without propagation: copy the chars through our
        // own allocator, then empty the moved-from source (matches
        // libstdc++/libc++ and the map/set/unordered_* element-wise path).
        assign(other.__data, other.__size);
        other.clear();
        return *this;
    }

    constexpr basic_string &operator=(const C *s)
    {
        return assign(s, Traits::length(s));
    }
    constexpr basic_string &operator=(C ch) { return assign(&ch, 1); }
    constexpr basic_string &operator=(initializer_list<C> il)
    {
        return assign(il.begin(), il.size());
    }
    template <typename SV>
        requires IsViewLike<SV>
    constexpr basic_string &operator=(const SV &t)
    {
        __view v(t);
        return assign(v.data(), v.size());
    }
    basic_string &operator=(nullptr_t) = delete;

    constexpr basic_string &assign(const C *s, size_type n)
    {
        // s may alias *this (self-assign substrings) — Traits::move.
        if (n > capacity()) {
            basic_string tmp(s, n, __alloc);
            swap(tmp);
            return *this;
        }
        Traits::move(__data, s, n);
        SetSize(n);
        return *this;
    }
    constexpr basic_string &assign(const C *s)
    {
        return assign(s, Traits::length(s));
    }
    constexpr basic_string &assign(const basic_string &other)
    {
        return assign(other.__data, other.__size);
    }
    constexpr basic_string &assign(basic_string &&other) noexcept(
        noexcept(declval<basic_string &>() = std::move(other)))
    {
        return *this = std::move(other);
    }
    constexpr basic_string &assign(size_type count, C ch)
    {
        if (count > capacity()) Reallocate(count, 0);
        Traits::assign(__data, count, ch);
        SetSize(count);
        return *this;
    }
    constexpr basic_string &assign(initializer_list<C> il)
    {
        return assign(il.begin(), il.size());
    }
    template <typename SV>
        requires IsViewLike<SV>
    constexpr basic_string &assign(const SV &t)
    {
        __view v(t);
        return assign(v.data(), v.size());
    }
    template <ContainerCompatibleRange<C> R>
    constexpr basic_string &assign_range(R &&rg)
    {
        return assign(basic_string(from_range, std::forward<R>(rg), get_allocator()));
    }

    constexpr allocator_type get_allocator() const noexcept { return __alloc; }

    // ── element access ──────────────────────────────────────────────────

    constexpr reference operator[](size_type i) { return __data[i]; }
    constexpr const_reference operator[](size_type i) const
    {
        return __data[i];
    }
    constexpr reference at(size_type i)
    {
        if (i >= __size) boxcxx::ThrowOutOfRange("string::at");
        return __data[i];
    }
    constexpr const_reference at(size_type i) const
    {
        if (i >= __size) boxcxx::ThrowOutOfRange("string::at");
        return __data[i];
    }
    constexpr reference front() { return __data[0]; }
    constexpr const_reference front() const { return __data[0]; }
    constexpr reference back() { return __data[__size - 1]; }
    constexpr const_reference back() const { return __data[__size - 1]; }
    constexpr C *data() noexcept { return __data; }
    constexpr const C *data() const noexcept { return __data; }
    constexpr const C *c_str() const noexcept { return __data; }
    constexpr operator __view() const noexcept
    {
        return __view(__data, __size);
    }

    // ── iterators ───────────────────────────────────────────────────────

    constexpr iterator begin() noexcept { return __data; }
    constexpr const_iterator begin() const noexcept { return __data; }
    constexpr const_iterator cbegin() const noexcept { return __data; }
    constexpr iterator end() noexcept { return __data + __size; }
    constexpr const_iterator end() const noexcept { return __data + __size; }
    constexpr const_iterator cend() const noexcept { return __data + __size; }
    constexpr reverse_iterator rbegin() noexcept
    {
        return reverse_iterator(end());
    }
    constexpr const_reverse_iterator rbegin() const noexcept
    {
        return const_reverse_iterator(end());
    }
    constexpr reverse_iterator rend() noexcept
    {
        return reverse_iterator(begin());
    }
    constexpr const_reverse_iterator rend() const noexcept
    {
        return const_reverse_iterator(begin());
    }
    constexpr const_reverse_iterator crbegin() const noexcept
    {
        return const_reverse_iterator(cend());
    }
    constexpr const_reverse_iterator crend() const noexcept
    {
        return const_reverse_iterator(cbegin());
    }

    // ── capacity ────────────────────────────────────────────────────────

    [[nodiscard]] constexpr bool empty() const noexcept { return __size == 0; }
    constexpr size_type size() const noexcept { return __size; }
    constexpr size_type length() const noexcept { return __size; }
    constexpr size_type max_size() const noexcept
    {
        return (size_type(-1) / sizeof(C)) / 2;
    }
    constexpr size_type capacity() const noexcept
    {
        return IsLong() ? __cap : kSsoChars;
    }

    constexpr void reserve(size_type want)
    {
        if (want > capacity()) Reallocate(want, __size);
    }

    constexpr void shrink_to_fit()
    {
        if (!IsLong() || __size == __cap) return;
        basic_string tmp(__data, __size, __alloc);
        swap(tmp);
    }

    constexpr void clear() noexcept { SetSize(0); }

    // ── modifiers ───────────────────────────────────────────────────────

    constexpr void push_back(C ch)
    {
        if (__size == capacity()) Reallocate(GrownCapacity(__size + 1), __size);
        Traits::assign(__data[__size], ch);
        SetSize(__size + 1);
    }

    constexpr void pop_back() { SetSize(__size - 1); }

    constexpr basic_string &append(const C *s, size_type n)
    {
        if (__size + n > capacity()) {
            // s may point into *this — reallocation invalidates it.
            size_type off  = SelfOffset(s);
            Reallocate(GrownCapacity(__size + n), __size);
            if (off != npos) s = __data + off;
        }
        Traits::copy(__data + __size, s, n);
        SetSize(__size + n);
        return *this;
    }
    constexpr basic_string &append(const C *s)
    {
        return append(s, Traits::length(s));
    }
    constexpr basic_string &append(const basic_string &other)
    {
        return append(other.__data, other.__size);
    }
    constexpr basic_string &append(const basic_string &other, size_type pos,
                                   size_type n = npos)
    {
        __view v = __view(other).substr(pos, n);
        return append(v.data(), v.size());
    }
    constexpr basic_string &append(size_type count, C ch)
    {
        if (__size + count > capacity())
            Reallocate(GrownCapacity(__size + count), __size);
        Traits::assign(__data + __size, count, ch);
        SetSize(__size + count);
        return *this;
    }
    constexpr basic_string &append(initializer_list<C> il)
    {
        return append(il.begin(), il.size());
    }
    template <typename SV>
        requires IsViewLike<SV>
    constexpr basic_string &append(const SV &t)
    {
        __view v(t);
        return append(v.data(), v.size());
    }
    template <ContainerCompatibleRange<C> R>
    constexpr basic_string &append_range(R &&rg)
    {
        return append(basic_string(from_range, std::forward<R>(rg), get_allocator()));
    }

    constexpr basic_string &operator+=(const basic_string &other)
    {
        return append(other);
    }
    constexpr basic_string &operator+=(const C *s) { return append(s); }
    constexpr basic_string &operator+=(C ch)
    {
        push_back(ch);
        return *this;
    }
    constexpr basic_string &operator+=(initializer_list<C> il)
    {
        return append(il);
    }
    template <typename SV>
        requires IsViewLike<SV>
    constexpr basic_string &operator+=(const SV &t)
    {
        return append(t);
    }

    constexpr basic_string &insert(size_type pos, const C *s, size_type n)
    {
        if (pos > __size) boxcxx::ThrowOutOfRange("string::insert");
        if (n == 0) return *this;
        if (__size + n > capacity()) {
            size_type off  = SelfOffset(s);
            Reallocate(GrownCapacity(__size + n), __size);
            if (off != npos) s = __data + off;
        }
        // If s points into the gap-shifted region, copy through a check:
        // shift the tail first, then place from the (possibly moved) src.
        size_type off = SelfOffset(s);
        Traits::move(__data + pos + n, __data + pos, __size - pos);
        if (off == npos) {
            Traits::copy(__data + pos, s, n);
        } else {
            // Source inside *this: recompute around the shifted tail.
            const C *src = __data + off;
            if (off >= pos) src += n;
            // The source may straddle the insertion point — copy in two
            // pieces when it does.
            if (off < pos && off + n > pos) {
                size_type head = pos - off;
                Traits::copy(__data + pos, __data + off, head);
                Traits::copy(__data + pos + head, __data + pos + n,
                             n - head);
            } else {
                Traits::copy(__data + pos, src, n);
            }
        }
        SetSize(__size + n);
        return *this;
    }
    constexpr basic_string &insert(size_type pos, const C *s)
    {
        return insert(pos, s, Traits::length(s));
    }
    constexpr basic_string &insert(size_type pos, const basic_string &other)
    {
        return insert(pos, other.__data, other.__size);
    }
    constexpr basic_string &insert(size_type pos, size_type count, C ch)
    {
        if (pos > __size) boxcxx::ThrowOutOfRange("string::insert");
        if (count == 0) return *this;
        if (__size + count > capacity())
            Reallocate(GrownCapacity(__size + count), __size);
        Traits::move(__data + pos + count, __data + pos, __size - pos);
        Traits::assign(__data + pos, count, ch);
        SetSize(__size + count);
        return *this;
    }
    constexpr iterator insert(const_iterator where, C ch)
    {
        size_type pos = static_cast<size_type>(where - __data);
        insert(pos, 1, ch);
        return __data + pos;
    }
    template <typename SV>
        requires IsViewLike<SV>
    constexpr basic_string &insert(size_type pos, const SV &t)
    {
        __view v(t);
        return insert(pos, v.data(), v.size());
    }
    template <ContainerCompatibleRange<C> R>
    constexpr iterator insert_range(const_iterator p, R &&rg)
    {
        size_type pos = static_cast<size_type>(p - __data);
        insert(pos, basic_string(from_range, std::forward<R>(rg), get_allocator()));
        return __data + pos;
    }

    constexpr basic_string &erase(size_type pos = 0, size_type count = npos)
    {
        if (pos > __size) boxcxx::ThrowOutOfRange("string::erase");
        size_type n = count < __size - pos ? count : __size - pos;
        Traits::move(__data + pos, __data + pos + n, __size - pos - n);
        SetSize(__size - n);
        return *this;
    }
    constexpr iterator erase(const_iterator where)
    {
        size_type pos = static_cast<size_type>(where - __data);
        erase(pos, 1);
        return __data + pos;
    }
    constexpr iterator erase(const_iterator first, const_iterator last)
    {
        size_type pos = static_cast<size_type>(first - __data);
        erase(pos, static_cast<size_type>(last - first));
        return __data + pos;
    }

    constexpr basic_string &replace(size_type pos, size_type count, const C *s,
                                    size_type n)
    {
        if (pos > __size) boxcxx::ThrowOutOfRange("string::replace");
        size_type erased   = count < __size - pos ? count : __size - pos;
        size_type new_size = __size - erased + n;

        if (new_size > capacity()) {
            // Fresh-buffer assembly: three copies, alias-safe by
            // construction (the old buffer lives until DropStorage).
            size_type want = GrownCapacity(new_size);
            C *fresh       = AllocTraits::allocate(__alloc, want + 1);
            Traits::copy(fresh, __data, pos);
            Traits::copy(fresh + pos, s, n);
            Traits::copy(fresh + pos + n, __data + pos + erased,
                         __size - pos - erased);
            DropStorage();
            __data = fresh;
            __cap  = want;
            SetSize(new_size);
            return *this;
        }

        // In-place single pass. A source aliasing *this while the tail
        // shifts is the rare hard case — detour through a copy.
        if (SelfOffset(s) != npos && n != erased) {
            basic_string tmp(s, n, __alloc);
            return replace(pos, count, tmp.data(), n);
        }
        Traits::move(__data + pos + n, __data + pos + erased,
                     __size - pos - erased);
        Traits::move(__data + pos, s, n);
        SetSize(new_size);
        return *this;
    }
    constexpr basic_string &replace(size_type pos, size_type count, const C *s)
    {
        return replace(pos, count, s, Traits::length(s));
    }
    constexpr basic_string &replace(size_type pos, size_type count,
                                    const basic_string &other)
    {
        return replace(pos, count, other.__data, other.__size);
    }
    constexpr basic_string &replace(size_type pos, size_type count, size_type n,
                                    C ch)
    {
        if (pos > __size) boxcxx::ThrowOutOfRange("string::replace");
        size_type erased = count < __size - pos ? count : __size - pos;
        erase(pos, erased);
        insert(pos, n, ch);
        return *this;
    }
    template <typename SV>
        requires IsViewLike<SV>
    constexpr basic_string &replace(size_type pos, size_type count, const SV &t)
    {
        __view v(t);
        return replace(pos, count, v.data(), v.size());
    }
    // [string.replace] bonus surface (not in the original brief, found
    // while surveying <string>'s range members) — same delegate-through-a-
    // temporary shape as insert_range/append_range above.
    template <ContainerCompatibleRange<C> R>
    constexpr basic_string &replace_with_range(const_iterator i1,
                                               const_iterator i2, R &&rg)
    {
        size_type pos   = static_cast<size_type>(i1 - __data);
        size_type count = static_cast<size_type>(i2 - i1);
        return replace(pos, count, basic_string(from_range, std::forward<R>(rg), get_allocator()));
    }

    constexpr void resize(size_type n, C ch)
    {
        if (n > __size) append(n - __size, ch);
        else SetSize(n);
    }
    constexpr void resize(size_type n) { resize(n, C()); }

    // P1072R10 ([string.capacity]): grow to n and let the caller fill the raw
    // buffer, then TRUNCATE to what it says it wrote. The point is the one
    // thing resize() cannot avoid — value-initializing n characters the
    // caller is about to overwrite anyway. The operation is specified to move
    // the buffer before calling op, and op must not throw or look at the
    // string; a returned length above n is undefined, so it is caught here
    // rather than silently trusted.
    template <typename Op>
    constexpr void resize_and_overwrite(size_type n, Op op)
    {
        reserve(n);
        size_type old = __size;
        if (n > old) SetSize(n); // the tail is raw, deliberately unwritten
        size_type written = static_cast<size_type>(std::move(op)(data(), n));
        // A returned length above n is undefined ([string.capacity]/32); the
        // string would report characters that were never written. Caught, and
        // loudly, because the alternative is a buffer that lies about its
        // own length.
        if (written > n)
            boxcxx::ThrowLengthError("basic_string::resize_and_overwrite: the "
                                     "callable reported writing more than it "
                                     "was given");
        SetSize(written);
    }

    constexpr size_type copy(C *dst, size_type count, size_type pos = 0) const
    {
        return __view(*this).copy(dst, count, pos);
    }

    constexpr void swap(basic_string &other) noexcept(
        AllocTraits::propagate_on_container_swap::value ||
        AllocTraits::is_always_equal::value)
    {
        if (this == &other) return;
        if constexpr (AllocTraits::propagate_on_container_swap::value) {
            Alloc tmp    = __alloc;
            __alloc      = other.__alloc;
            other.__alloc = tmp;
        }
        // Three repr shapes: long/long is a plain member swap; any sso
        // side moves bytes through a temp inline buffer.
        bool l1 = IsLong(), l2 = other.IsLong();
        C buf[kSsoChars + 1];
        size_type s1 = __size, s2 = other.__size;
        if (l1 && l2) {
            C *d1 = __data;
            size_type c1 = __cap;
            __data = other.__data; __cap = other.__cap;
            other.__data = d1; other.__cap = c1;
        } else if (!l1 && !l2) {
            Traits::copy(buf, __sso, s1 + 1);
            Traits::copy(__sso, other.__sso, s2 + 1);
            Traits::copy(other.__sso, buf, s1 + 1);
        } else {
            basic_string &lng = l1 ? *this : other;
            basic_string &sso = l1 ? other : *this;
            C *d = lng.__data;
            size_type cap = lng.__cap;
            // lng's union holds __cap right now; the copy below writes the
            // inline buffer through a pointer, so its lifetime has to start
            // first -- and only after cap has been read out of it.
            lng.BeginSso();
            Traits::copy(lng.__sso, sso.__sso, sso.__size + 1);
            lng.__data = lng.__sso;
            sso.__data = d;
            sso.__cap  = cap;
        }
        __size       = s2;
        other.__size = s1;
    }

    // ── search / comparison (delegated to string_view) ──────────────────

    constexpr size_type find(__view v, size_type pos = 0) const noexcept
