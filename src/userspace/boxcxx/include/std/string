// C++20 uniform erasure.
template <typename C, typename T, typename A, typename V = C>
constexpr typename basic_string<C, T, A>::size_type
erase(basic_string<C, T, A> &s, const V &value)
{
    typename basic_string<C, T, A>::size_type removed = 0;
    typename basic_string<C, T, A>::size_type w       = 0;
    for (typename basic_string<C, T, A>::size_type r = 0; r < s.size(); ++r) {
        if (s[r] == value) {
            ++removed;
        } else {
            s[w++] = s[r];
        }
    }
    s.resize(w);
    return removed;
}

// The predicate half of the same paper. It was the only one of the thirteen
// uniform-erasure overloads missing, which is why __cpp_lib_erase_if stayed
// undefined while erase_if worked on every container.
template <typename C, typename T, typename A, typename Pred>
constexpr typename basic_string<C, T, A>::size_type
erase_if(basic_string<C, T, A> &s, Pred pred)
{
    typename basic_string<C, T, A>::size_type removed = 0;
    typename basic_string<C, T, A>::size_type w       = 0;
    for (typename basic_string<C, T, A>::size_type r = 0; r < s.size(); ++r) {
        if (pred(s[r])) {
            ++removed;
        } else {
            s[w++] = s[r];
        }
    }
    s.resize(w);
    return removed;
}

