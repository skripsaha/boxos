template <typename C, typename T, typename A>
void swap(basic_string<C, T, A> &a, basic_string<C, T, A> &b) noexcept
{
    a.swap(b);
}

// C++20 uniform erasure.
template <typename C, typename T, typename A, typename V>
typename basic_string<C, T, A>::size_type erase(basic_string<C, T, A> &s,
                                                const V &value)
{
    typename basic_string<C, T, A>::size_type removed = 0;
    typename basic_string<C, T, A>::size_type w       = 0;
    for (typename basic_string<C, T, A>::size_type r = 0; r < s.size(); ++r) {
        if (s[r] == value) {
            ++removed;
        } else {
            s[w++] = s[r];
        }
    }
    s.resize(w);
    return removed;
}

