private:
    // ── representation ──────────────────────────────────────────────────

    constexpr bool IsLong() const noexcept { return __data != __sso; }

    // The inline buffer becomes the union's active member only when something
    // writes it THROUGH ITS NAME ([class.union]/6). A write through __data
    // does not count, and in constant evaluation GCC says exactly that:
    // "initializing '__sso' requires a member access expression as the left
    // operand of the assignment".
    //
    // Every element is written, not just one. A single element is enough to
    // begin the array's lifetime -- measured -- and that is all a TRANSIENT
    // string needs. A string that is itself a constant needs more: the value
    // of a constexpr variable has to be complete, and GCC rejects one whose
    // buffer is half indeterminate ("is not a constant expression because it
    // refers to an incompletely initialized variable"). Since a short string
    // being a real constant is the whole point of keeping SSO alive here, the
    // loop fills the buffer. At run time a union has no active member to
    // track and the fill would be pure waste, so it is not made.
    constexpr void BeginSso() noexcept
    {
        if (is_constant_evaluated())
            for (size_type i = 0; i <= kSsoChars; ++i) __sso[i] = C();
    }

    constexpr void SetShort(size_type n) noexcept
    {
        BeginSso();
        __data         = __sso;
        __size         = n;
        __sso[n]       = C();
    }

    constexpr void SetSize(size_type n) noexcept
    {
        __size     = n;
        __data[n] = C();
    }

    constexpr void InitCopy(const C *s, size_type n)
    {
        if (n > max_size()) boxcxx::ThrowLengthError("string: too long");
        if (n <= kSsoChars) {
            BeginSso();
            __data = __sso;
        } else {
            __data = AllocTraits::allocate(__alloc, n + 1);
            __cap  = n;
        }
        Traits::copy(__data, s, n);
        SetSize(n);
    }

    constexpr void InitFill(size_type n, C ch)
    {
        if (n > max_size()) boxcxx::ThrowLengthError("string: too long");
        if (n <= kSsoChars) {
            BeginSso();
            __data = __sso;
        } else {
            __data = AllocTraits::allocate(__alloc, n + 1);
            __cap  = n;
        }
        Traits::assign(__data, n, ch);
        SetSize(n);
    }

    constexpr void StealFrom(basic_string &other) noexcept
    {
        if (other.IsLong()) {
            __data = other.__data;
            __size = other.__size;
            __cap  = other.__cap;
        } else {
            BeginSso();
            __data = __sso;
            __size = other.__size;
            Traits::copy(__sso, other.__sso, other.__size + 1);
        }
        other.SetShort(0);
    }

    constexpr void DropStorage() noexcept
    {
        if (IsLong()) AllocTraits::deallocate(__alloc, __data, __cap + 1);
    }

    constexpr size_type GrownCapacity(size_type needed) const
    {
        if (needed > max_size()) boxcxx::ThrowLengthError("string: too long");
        size_type doubled = capacity() * 2;
        return doubled > needed ? doubled : needed;
    }

    // Keeps the first `keep` chars; gives at least `want` capacity.
    constexpr void Reallocate(size_type want, size_type keep)
    {
        if (want > max_size()) boxcxx::ThrowLengthError("string: too long");
        C *fresh = AllocTraits::allocate(__alloc, want + 1);
        Traits::copy(fresh, __data, keep);
        DropStorage();
        __data = fresh;
        __cap  = want;
        SetSize(keep);
    }

    // npos when `s` points outside this string's buffer.
    //
    // Two evaluations, because the question has two different legal answers.
    // At run time the address comparison decides it in two instructions.
    // During constant evaluation it cannot be asked that way at all: `<` and
    // `>=` between pointers into different objects are not constant
    // expressions, and GCC refuses outright ("'(((const char*)"!!!") >=
    // ((const char*)(& heap )))' is not a constant expression"). Equality is
    // the one comparison a constant expression may make between unrelated
    // pointers, so the compile-time answer is found by asking it -- once per
    // character, which costs nothing next to the shift the callers are about
    // to perform anyway.
    constexpr size_type SelfOffset(const C *s) const noexcept
    {
        if (is_constant_evaluated()) {
            for (size_type i = 0; i <= __size; ++i)
                if (__data + i == s) return i;
            return npos;
        }
        if (s >= __data && s <= __data + __size)
            return static_cast<size_type>(s - __data);
        return npos;
    }

    C *__data;
    size_type __size;
    union {
        size_type __cap;
        C __sso[kSsoChars + 1];
    };
    [[no_unique_address]] Alloc __alloc;
};

