// boxcxx — <fstream>
// basic_filebuf<CharT,Traits> [filebuf] and the three stream wrappers over
// it. The backing is a "file:" Current — the BoxOS I/O spine — not a POSIX
// descriptor: there is no fd here, no FILE*, and no path. The `s` a filebuf
// opens is a TagFS NAME, and TagFS is tag-addressed, so there is no directory
// to walk and no separator to parse. That is also why the C++23
// filesystem::path overloads of open() and of the stream constructors are
// absent rather than stubbed — see CONFORMANCE §1.1.
//
// ── what made this header possible ──────────────────────────────────────
// [filebuf.members] Table 122 says plain ios_base::out means "w", and "w"
// truncates. TagFS could not truncate: tagfs_write only ever grew a file, so
// rewriting one shorter left the old tail readable behind the new content.
// Writing this header honestly required building that primitive first, from
// tagfs_truncate_file up through STORAGE_OBJ_TRUNCATE, file_truncate and
// current_resize. Every row of Table 122 below is therefore real; none of
// them is approximated.
//
// ── the buffer strategy ─────────────────────────────────────────────────
// ONE buffer, serving the get area or the put area but never both at once. A
// file has ONE position, and Table 122's read/write modes are defined around
// switching between the two rather than running them in parallel: every
// transition (EnterRead / EnterWrite) flushes what the other side had
// pending and re-anchors __base. __base is the file BYTE offset of the first
// character of whichever area is live, so the logical position is always
// __base + (how far into that area we are) — LogicalPos() is the single
// place that arithmetic is written.
//
// Sizeable transfers skip the buffer entirely (xsgetn / xsputn): routing a
// megabyte through a 4 KiB window would be hundreds of Manifest round-trips
// where one will do.
//
// ── the codecvt boundary (Ф42-f) ────────────────────────────────────────
// This comment used to say that wide characters were a documented exclusion
// and that a character moved to and from the file as sizeof(CharT) raw
// bytes. That was true, and it was also the reason a wofstream would have
// written UTF-32 to a file every other program on the system reads as UTF-8.
// Ф42-e built the facet; this is where it plugs in.
//
// Two paths, and the switch between them is the standard's own:
// always_noconv(). For char it is true, the identity facet says "move them
// yourself", and every byte path below is exactly what it was. For wchar_t
// it is false and the characters cross an EXTERNAL buffer of bytes on the
// way to and from the file.
//
// ‼ The one thing a variable-width encoding takes away is arithmetic on
// positions, and the standard takes it away explicitly: [filebuf.virtuals]
// makes seekoff with a nonzero offset an ERROR when encoding() <= 0. So
// LogicalPos() cannot be `characters × sizeof(CharT)` any more. It asks the
// facet instead — length() answers "how many bytes make these N characters",
// which is the question, and it is the reason that virtual exists.
//
// What this backing gives that a POSIX filebuf does not have: the file is
// always seekable, so a character split across a read boundary needs no
// leftover-byte carry. The unconsumed tail is simply read again.
#ifndef BOXCXX_FSTREAM
#define BOXCXX_FSTREAM

#include <ios>
#include <istream>
#include <locale>
#include <ostream>
#include <streambuf>
#include <string>
#include <cstddef>
#include <new>
#include <utility>

#include "box/current.h"  // the file backing is a Current, not a descriptor
#include "box/file.h"     // find_file_by_name — the noreplace ("x") question

// [version.syn] names this header as an owner of the macro below.
#define BOXCXX_OWNS_fstream_native_handle
#include <__bits/version_iostreams>

namespace std {

// ── basic_filebuf<CharT,Traits> [filebuf] ───────────────────────────────

template <class CharT, class Traits>
class basic_filebuf : public basic_streambuf<CharT, Traits> {
public:
    using char_type   = CharT;
    using traits_type = Traits;
    using int_type    = typename Traits::int_type;
    using pos_type    = typename Traits::pos_type;
    using off_type    = typename Traits::off_type;

    // P1759R6. The handle a BoxOS program can actually use for more than a
    // stream does: the Current itself. Not an int, because BoxOS has no
    // descriptor table to index into.
    using native_handle_type = ::Current *;

private:
    static constexpr streamsize S             = (streamsize)sizeof(char_type);
    static constexpr streamsize kDefaultBuf   = 4096 / (streamsize)sizeof(char_type);

    using Codecvt = codecvt<char_type, char, mbstate_t>;

    // The facet is NOT cached in a member, and that is a decision Ф42-e paid
    // for: a facet lives in the image, so asking for it is a `lea` and not a
    // lookup. A cached pointer would have to be carried by the move
    // constructor, the move assignment, swap() and Disown() — four more
    // places for two objects' state to drift apart, bought for nothing.
    const Codecvt &Cvt() const { return use_facet<Codecvt>(this->__loc_ref()); }
    bool Conv() const { return !Cvt().always_noconv(); }

    static constexpr bool Has(ios_base::openmode m, ios_base::openmode f) noexcept
    {
        return (m & f) != ios_base::openmode{};
    }

    // [filebuf.members] Table 122, plus the noreplace column P2467R1 added.
    // `binary` is accepted and changes nothing: a Current is a byte channel
    // and boxcxx does no text translation, so binary and text are one road.
    struct OpenPlan {
        bool valid     = false;
        bool read      = false;   // a get area is permitted
        bool write     = false;   // a put area is permitted
        bool create    = false;   // bring the file into being if absent
        bool truncate  = false;   // discard what is there
        bool append    = false;   // every write lands at the end
        bool exclusive = false;   // noreplace: refuse if it already exists
    };

    static OpenPlan Plan(ios_base::openmode m) noexcept
    {
        const bool in    = Has(m, ios_base::in);
        const bool out   = Has(m, ios_base::out);
        const bool trunc = Has(m, ios_base::trunc);
        const bool app   = Has(m, ios_base::app);
        const bool excl  = Has(m, ios_base::noreplace);

        OpenPlan p;
        p.read      = in;
        p.write     = out || app;
        p.exclusive = excl;

        if (!in && (out || app)) {
            if (app) {                                   // "a"   — out|app, app
                p.create = true;
                p.append = true;
                p.valid  = !trunc;
            } else {                                     // "w"   — out, out|trunc
                p.create   = true;
                p.truncate = true;
                p.valid    = true;
            }
        } else if (in && !out && !app) {                 // "r"   — must exist
            p.valid = !trunc;
        } else if (in && out && !app) {
            if (trunc) {                                 // "w+"
                p.create   = true;
                p.truncate = true;
                p.valid    = true;
            } else {                                     // "r+"  — must exist
                p.valid = true;
            }
        } else if (in && app) {                          // "a+"  — in|out|app, in|app
            p.create = true;
            p.append = true;
            p.write  = true;
            p.valid  = !trunc;
        }

        // noreplace is the "x" of "wx" / "w+x", and C allows "x" only on the
        // w-family. On any other row it is not a stricter open, it is a
        // meaningless one — so it is rejected rather than ignored.
        if (excl && !p.truncate) p.valid = false;
        return p;
    }

public:
    basic_filebuf() = default;

    basic_filebuf(const basic_filebuf &)            = delete;
    basic_filebuf &operator=(const basic_filebuf &) = delete;

    // The buffer is always heap- or caller-owned, never a member array, so
    // the six get/put-area pointers the base copies stay valid across a move
    // without re-basing. That is why basic_streambuf's protected copy ctor is
    // exactly the right thing to call here.
    basic_filebuf(basic_filebuf &&rhs)
        : basic_streambuf<CharT, Traits>(rhs),
          __c(rhs.__c), __mode(rhs.__mode),
          __buf(rhs.__buf), __bufn(rhs.__bufn), __owns(rhs.__owns),
          __base(rhs.__base),
          __ext(rhs.__ext), __extcap(rhs.__extcap), __extUsed(rhs.__extUsed),
          __reading(rhs.__reading), __writing(rhs.__writing),
          __canRead(rhs.__canRead), __canWrite(rhs.__canWrite), __append(rhs.__append),
          __userBuf(rhs.__userBuf), __userN(rhs.__userN), __unbufReq(rhs.__unbufReq)
    {
        rhs.Disown();
    }
    basic_filebuf &operator=(basic_filebuf &&rhs)
    {
        if (this == &rhs) return *this;
        close();
        basic_streambuf<CharT, Traits>::operator=(rhs);
        __c        = rhs.__c;
        __mode     = rhs.__mode;
        __buf      = rhs.__buf;
        __bufn     = rhs.__bufn;
        __owns     = rhs.__owns;
        __base     = rhs.__base;
        __reading  = rhs.__reading;
        __writing  = rhs.__writing;
        __canRead  = rhs.__canRead;
        __canWrite = rhs.__canWrite;
        __append   = rhs.__append;
        __ext      = rhs.__ext;
        __extcap   = rhs.__extcap;
        __extUsed  = rhs.__extUsed;
        __userBuf  = rhs.__userBuf;
        __userN    = rhs.__userN;
        __unbufReq = rhs.__unbufReq;
        rhs.Disown();
        return *this;
    }

    void swap(basic_filebuf &rhs)
    {
        if (this == &rhs) return;
        basic_streambuf<CharT, Traits>::swap(rhs);
        using std::swap;
        swap(__c, rhs.__c);
        swap(__mode, rhs.__mode);
        swap(__buf, rhs.__buf);
        swap(__bufn, rhs.__bufn);
        swap(__owns, rhs.__owns);
        swap(__base, rhs.__base);
        swap(__reading, rhs.__reading);
        swap(__writing, rhs.__writing);
        swap(__canRead, rhs.__canRead);
        swap(__canWrite, rhs.__canWrite);
        swap(__append, rhs.__append);
        swap(__ext, rhs.__ext);
        swap(__extcap, rhs.__extcap);
        swap(__extUsed, rhs.__extUsed);
        swap(__userBuf, rhs.__userBuf);
        swap(__userN, rhs.__userN);
        swap(__unbufReq, rhs.__unbufReq);
    }

    // [filebuf.cons]: the destructor calls close() and swallows whatever it
    // throws. Nothing below throws today, but a destructor that could let one
    // out is a destructor that terminates the program on a failed flush.
    ~basic_filebuf() override
    {
        try {
            close();
        } catch (...) {
        }
    }

    bool is_open() const noexcept { return __c != nullptr; }

    basic_filebuf *open(const char *s, ios_base::openmode which)
    {
        if (is_open() || !s || *s == '\0') return nullptr;

        const OpenPlan p = Plan(which);
        if (!p.valid) return nullptr;

        // noreplace ("x") has to be asked BEFORE the open: a Current that
        // creates on demand cannot afterwards tell us whether it created the
        // file or adopted one that was already there.
        if (p.exclusive) {
            uint32_t    ids[1];
            file_info_t infos[1];
            if (::find_file_by_name(s, ids, infos, 1) > 0) return nullptr;
        }

        uint32_t role = 0;
        if (p.read)  role |= CURRENT_READ;
        if (p.write) role |= CURRENT_WRITE;
        uint32_t flags = 0;
        if (p.create)   flags |= CURRENT_CREATE;
        if (p.truncate) flags |= CURRENT_TRUNCATE;

        // "file:" is the Current tag scheme for TagFS-backed byte storage.
        string tag("file:");
        tag += s;

        ::Current *c = ::current_open(tag.c_str(), role, 0, flags);
        if (!c) return nullptr;

        // A state-dependent encoding would make every position a PAIR —
        // an offset and the shift state to reach it — and every seek a
        // replay from the start. [locale.codecvt] spells that as
        // encoding() < 0. boxcxx has no such facet, and this refuses one
        // instead of assuming it will never appear: the assumption
        // LogicalPos() rests on is checked where it is made.
        if (Cvt().encoding() < 0) {
            ::current_release(c);
            return nullptr;
        }

        char_type  *buf   = nullptr;
        streamsize  bufn  = 0;
        bool        owns  = false;
        if (__userBuf && __userN > 0) {
            buf  = __userBuf;
            bufn = __userN;
        } else {
            // Unbuffered is a one-character buffer: behaviourally identical,
            // and it keeps every path below single, so "unbuffered" cannot
            // rot into a second implementation nobody exercises.
            bufn = __unbufReq ? 1 : kDefaultBuf;
            buf  = new (nothrow) char_type[(size_t)bufn];
            if (!buf) {
                ::current_release(c);
                return nullptr;
            }
            owns = true;
        }

        // The external buffer exists only when there is something to convert,
        // and it is sized so one full character buffer always fits: a
        // conversion that could not make progress in one pass would be a loop
        // with no floor.
        char      *ext    = nullptr;
        streamsize extcap = 0;
        if (Conv()) {
            extcap = bufn * (streamsize)Cvt().max_length();
            ext    = new (nothrow) char[(size_t)extcap];
            if (!ext) {
                if (owns) delete[] buf;
                ::current_release(c);
                return nullptr;
            }
        }

        __c        = c;
        __mode     = which;
        __buf      = buf;
        __bufn     = bufn;
        __owns     = owns;
        __base     = 0;
        __ext      = ext;
        __extcap   = extcap;
        __extUsed  = 0;
        __reading  = false;
        __writing  = false;
        __canRead  = p.read;
        __canWrite = p.write;
        __append   = p.append;
        this->setg(nullptr, nullptr, nullptr);
        this->setp(nullptr, nullptr);

        // ate is orthogonal to Table 122: the row decides how the file is
        // opened, ate decides where the position starts afterwards. A seek
        // that fails leaves the caller pointing nowhere, so the open fails
        // with it rather than silently starting at the beginning.
        if (Has(which, ios_base::ate)) {
            // Seek with the direction the PLAN worked out, not with the raw
            // `which`. `app` alone means output without ever setting the out
            // bit, so passing `which` through would hand seekoff a mode that
            // names neither direction — and it rejects that, correctly, as
            // not a seek at all. `filebuf.open(name, app|ate)` failed to open
            // because of it; the three stream wrappers hid the bug by OR-ing
            // their own direction in before they ever got here.
            ios_base::openmode dir{};
            if (p.read)  dir |= ios_base::in;
            if (p.write) dir |= ios_base::out;
            if (seekoff(0, ios_base::end, dir) == pos_type(off_type(-1))) {
                close();
                return nullptr;
            }
        }
        return this;
    }

    basic_filebuf *open(const string &s, ios_base::openmode which)
    {
        return open(s.c_str(), which);
    }

    basic_filebuf *close()
    {
        if (!__c) return nullptr;
        bool ok = true;
        if (__writing && !FlushPut()) ok = false;
        ::current_flush(__c);
        ::current_release(__c);
        __c = nullptr;

        this->setg(nullptr, nullptr, nullptr);
        this->setp(nullptr, nullptr);
        if (__owns) delete[] __buf;
        delete[] __ext;
        __buf      = nullptr;
        __bufn     = 0;
        __owns     = false;
        __base     = 0;
        __ext      = nullptr;
        __extcap   = 0;
        __extUsed  = 0;
        __reading  = false;
        __writing  = false;
        __canRead  = false;
        __canWrite = false;
        __append   = false;
        __mode     = ios_base::openmode{};
        return ok ? this : nullptr;
    }

    native_handle_type native_handle() const noexcept { return __c; }

protected:
    // ── positioning ─────────────────────────────────────────────────────

    basic_streambuf<CharT, Traits> *setbuf(char_type *s, streamsize n) override
    {
        // [filebuf.virtuals] only defines setbuf before any I/O has happened.
        // Recorded as a request and honoured at the next open; applying it to
        // a live buffer would strand whatever that buffer is holding.
        if (is_open()) return this;
        if (!s || n <= 0) {
            __userBuf  = nullptr;
            __userN    = 0;
            __unbufReq = true;
        } else {
            __userBuf  = s;
            __userN    = n;
            __unbufReq = false;
        }
        return this;
    }

    pos_type seekoff(off_type off, ios_base::seekdir way,
                     ios_base::openmode which = ios_base::in | ios_base::out) override
    {
        const pos_type fail(off_type(-1));
        if (!__c) return fail;
        // One file, one position: `which` cannot move the get side and leave
        // the put side behind, and naming neither is not a seek at all.
        if (!Has(which, ios_base::in) && !Has(which, ios_base::out)) return fail;
        // [filebuf.virtuals]: with encoding() <= 0 a nonzero offset is an
        // ERROR, not an approximation. Characters are one to four bytes wide,
        // so `off` characters from here is not a number anyone can compute
        // without reading them — and landing between two bytes of one
        // character is worse than failing. off == 0 still works for all three
        // directions, and seekpos with a pos_type this filebuf handed out
        // works for any position, which is what tellg()/seekg() is for.
        if (Conv() && off != 0) return fail;
        if (__writing && !FlushPut()) return fail;

        off_type target = 0;
        switch (way) {
        case ios_base::beg:
            target = off;
            break;
        case ios_base::cur:
            target = LogicalPos() + off;
            break;
        case ios_base::end: {
            const int64_t n = ::current_size(__c);
            if (n < 0) return fail;
            target = (off_type)n + off;
            break;
        }
        default:
            return fail;
        }
        return SeekTo(target);
    }

    // ‼ NOT `seekoff(off_type(sp), beg, which)`, which is what this was until
    // Ф42-f and what a wide stream caught within a run of writing the test.
    // seekoff refuses a nonzero offset when the encoding is variable-width —
    // and seekpos is precisely the way around that refusal: the pos_type came
    // from this filebuf's own tellg, so it is a byte offset it can honour
    // exactly. Routing one through the other made tellg()/seekg() unusable on
    // every wide file, while every other check in the phase passed.
    pos_type seekpos(pos_type sp,
                     ios_base::openmode which = ios_base::in | ios_base::out) override
    {
        const pos_type fail(off_type(-1));
        if (!__c) return fail;
        if (!Has(which, ios_base::in) && !Has(which, ios_base::out)) return fail;
        if (__writing && !FlushPut()) return fail;
        return SeekTo(off_type(sp));
    }

    int sync() override
    {
        if (!__c) return -1;
        if (__writing && !FlushPut()) return -1;
        // Drop the get area too, so the next read genuinely re-reads. A
        // sync() that left a stale window would answer from memory a question
        // the caller asked of the file.
        if (__reading) DropAreas();
        ::current_flush(__c);
        return 0;
    }

    // ── input ───────────────────────────────────────────────────────────

    streamsize showmanyc() override
    {
        if (!__c || !__canRead) return 0;
        // While writing there is no get area, so there is nothing available
        // to read without blocking — and saying so keeps LogicalPos() out of
        // the one situation where it cannot price an unflushed put area.
        if (__writing) return 0;
        const int64_t n = ::current_size(__c);
        if (n < 0) return 0;
        // in_avail() consults this only when the get area is empty, so what
        // is left in the file from the logical position is the whole answer.
        const off_type ahead = (off_type)n - LogicalPos();
        if (ahead <= 0) return 0;
        // [streambuf.virt.get] wants a count the caller can rely on, so with
        // a variable-width encoding it has to be the FLOOR: those bytes are
        // at least ahead/max_length characters and at most ahead.
        const streamsize per = Conv() ? (streamsize)Cvt().max_length() : S;
        return (streamsize)(ahead / per);
    }

    int_type underflow() override
    {
        if (!__c || !__canRead) return Traits::eof();
        if (this->gptr() && this->gptr() < this->egptr())
            return Traits::to_int_type(*this->gptr());

        // Flush BEFORE asking where we are. In append mode the pending bytes
        // land at the end of the file, so the position after the flush is the
        // end — reading LogicalPos() first would answer with where the write
        // was staged rather than where it went.
        if (__writing && !FlushPut()) return Traits::eof();
        const off_type at = LogicalPos();
        DropAreas();
        __base = at;

        if (::current_seek(__c, (uint64_t)__base) != 0) return Traits::eof();

        if (!Conv()) {
            const int got = ::current_read(__c, __buf, (size_t)(__bufn * S));
            if (got <= 0) return Traits::eof();
            const streamsize chars = (streamsize)got / S;
            if (chars <= 0) return Traits::eof();

            this->setg(__buf, __buf, __buf + chars);
            __reading = true;
            return Traits::to_int_type(*this->gptr());
        }

        // Converting. The byte window GROWS until it holds at least one whole
        // character or the file has no more to give: a four-byte character
        // can straddle any read, and a decoder handed only its first two
        // bytes must be handed the rest rather than told the file ended.
        // Whatever the conversion did not consume is simply left in the file;
        // the next refill seeks back to it. A filebuf over a pipe would have
        // to carry those bytes forward — a Current is seekable, so it does
        // not.
        streamsize extn = 0;
        streamsize made = 0;
        for (;;) {
            const int got = ::current_read(__c, __ext + extn, (size_t)(__extcap - extn));
            if (got <= 0) break;
            extn += got;

            const char *fn = nullptr;
            char_type  *tn = nullptr;
            mbstate_t   st{};
            const codecvt_base::result r =
                Cvt().in(st, __ext, __ext + extn, fn, __buf, __buf + __bufn, tn);
            if (r == codecvt_base::error) return Traits::eof();
            made      = (streamsize)(tn - __buf);
            __extUsed = (streamsize)(fn - __ext);
            if (made > 0) break;
            if (extn >= __extcap) break;   // the window cannot widen further
        }
        if (made <= 0) return Traits::eof();

        this->setg(__buf, __buf, __buf + made);
        __reading = true;
        return Traits::to_int_type(*this->gptr());
    }

    streamsize xsgetn(char_type *s, streamsize n) override
    {
        if (n <= 0 || !s || !__c || !__canRead) return 0;

        if (Conv()) {
            // Bytes cannot go straight into the caller's buffer while they are
            // not characters yet, so the bulk path IS the buffered one, driven
            // by underflow. A second decoder here would be a second thing to
            // verify, and the sweep that verified the first cannot see it.
            streamsize done = 0;
            while (done < n) {
                if (!this->gptr() || this->gptr() >= this->egptr())
                    if (Traits::eq_int_type(underflow(), Traits::eof())) break;
                const streamsize avail = this->egptr() - this->gptr();
                if (avail <= 0) break;
                const streamsize take = (n - done) < avail ? (n - done) : avail;
                Traits::copy(s + done, this->gptr(), (size_t)take);
                this->gbump((int)take);
                done += take;
            }
            return done;
        }

        streamsize done = 0;

        if (__reading) {
            const streamsize avail = this->egptr() - this->gptr();
            const streamsize take  = avail < n ? avail : n;
            if (take > 0) {
                Traits::copy(s, this->gptr(), (size_t)take);
                this->gbump((int)take);
                done += take;
            }
        }
        if (done == n) return done;

        // The rest goes from the file straight into the caller's buffer.
        if (__writing && !FlushPut()) return done;
        const off_type at = LogicalPos();
        DropAreas();
        __base = at;

        while (done < n) {
            if (::current_seek(__c, (uint64_t)__base) != 0) break;
            const int got = ::current_read(__c, s + done, (size_t)((n - done) * S));
            if (got <= 0) break;
            const streamsize chars = (streamsize)got / S;
            if (chars <= 0) break;   // a partial character is no character
            done   += chars;
            __base += chars * S;
        }
        return done;
    }

    int_type pbackfail(int_type c = Traits::eof()) override
    {
        if (!__c || !__canRead) return Traits::eof();
        if (__writing && !FlushPut()) return Traits::eof();
        const off_type at = LogicalPos();

        off_type start;
        if (!Conv()) {
            if (at < S) return Traits::eof();      // nothing behind us
            start = at - S;
        } else {
            // Where does the character BEFORE `at` begin? Subtracting a width
            // is no answer when characters are one to four bytes long, so the
            // question goes to the facet: the start is the k for which
            // exactly k bytes make exactly one character. UTF-8 admits only
            // one such k — a lead byte is never a continuation byte — and any
            // encoding this filebuf accepts is state-independent, so the walk
            // needs no state to replay.
            if (at <= 0) return Traits::eof();
            const int maxl = Cvt().max_length();
            start = -1;
            for (int k = 1; k <= maxl && (off_type)k <= at; k++) {
                char probe[8];
                if (k > (int)sizeof(probe)) break;
                if (::current_seek(__c, (uint64_t)(at - k)) != 0) return Traits::eof();
                if (::current_read(__c, probe, (size_t)k) != k) continue;
                mbstate_t st{};
                if (Cvt().length(st, probe, probe + k, 1) == k) {
                    start = at - k;
                    break;
                }
            }
            if (start < 0) return Traits::eof();
        }

        DropAreas();
        __base = start;
        if (Traits::eq_int_type(underflow(), Traits::eof())) return Traits::eof();

        if (Traits::eq_int_type(c, Traits::eof()))
            return Traits::not_eof(c);             // sungetc: the position is enough
        if (Traits::eq(Traits::to_char_type(c), *this->gptr()))
            return c;                              // the file already holds it

        // A character the file does not have. Putting it only in our buffer
        // would be a lie about the file, so it is written through — and that
        // is impossible without a writable, non-appending mode.
        //
        // ‼ And impossible outright when the facet converts: the replacement
        // character need not encode to the same number of bytes as the one it
        // displaces, so writing it through would shift everything after it.
        // Refusing is the only honest answer; putting it in the buffer alone
        // would be the lie this path already refuses to tell for char.
        if (Conv()) return Traits::eof();
        if (!__canWrite || __append) return Traits::eof();
        const char_type ch = Traits::to_char_type(c);
        *this->gptr() = ch;
        if (::current_seek(__c, (uint64_t)__base) != 0) return Traits::eof();
        if (::current_write(__c, &ch, (size_t)S) != (int)S) return Traits::eof();
        return c;
    }

    // ── output ──────────────────────────────────────────────────────────

    int_type overflow(int_type c = Traits::eof()) override
    {
        if (!__c || !__canWrite) return Traits::eof();
        if (!EnterWrite()) return Traits::eof();
        if (this->pptr() >= this->epptr() && !FlushPut()) return Traits::eof();
        if (!Traits::eq_int_type(c, Traits::eof())) {
            *this->pptr() = Traits::to_char_type(c);
            this->pbump(1);
            // A one-character buffer IS the unbuffered mode setbuf(nullptr, 0)
            // asks for, so it has to reach the file now rather than sit here
            // until something else forces a flush.
            if (__bufn == 1 && !FlushPut()) return Traits::eof();
        }
        return Traits::not_eof(c);
    }

    streamsize xsputn(const char_type *s, streamsize n) override
    {
        if (n <= 0 || !s || !__c || !__canWrite) return 0;
        if (!EnterWrite()) return 0;

        if (Conv()) {
            // The mirror of xsgetn: characters are not bytes yet, so the bulk
            // path is the buffered one and FlushPut does the converting. The
            // direct large-write shortcut below exists to skip a copy, and
            // there is no copy to skip when the bytes have to be made anyway.
            streamsize done = 0;
            while (done < n) {
                if (this->pptr() >= this->epptr() && !FlushPut()) break;
                const streamsize room = this->epptr() - this->pptr();
                if (room <= 0) break;
                const streamsize take = (n - done) < room ? (n - done) : room;
                Traits::copy(this->pptr(), s + done, (size_t)take);
                this->pbump((int)take);
                done += take;
                if (__bufn == 1 && !FlushPut()) break;
            }
            return done;
        }

        if (n <= this->epptr() - this->pptr()) {
            Traits::copy(this->pptr(), s, (size_t)n);
            this->pbump((int)n);
            return n;
        }
        if (!FlushPut()) return 0;
        if (n <= this->epptr() - this->pptr()) {   // it fits in an empty buffer
            Traits::copy(this->pptr(), s, (size_t)n);
            this->pbump((int)n);
            return n;
        }

        const uint64_t at = __append ? EndOffset() : (uint64_t)__base;
        if (::current_seek(__c, at) != 0) return 0;
        const int w = ::current_write(__c, s, (size_t)(n * S));
        if (w <= 0) return 0;
        const streamsize chars = (streamsize)w / S;
        __base = (off_type)(at + (uint64_t)(chars * S));
        return chars;
    }

private:
    // The file byte offset the logical position sits at, wherever the live
    // area happens to be. Every seek, flush and refill is expressed through
    // this one expression so the two areas cannot drift apart.
    // The tail both seeks share, once the target byte offset is settled.
    pos_type SeekTo(off_type target)
    {
        if (target < 0) return pos_type(off_type(-1));
        DropAreas();
        __base = target;
        return pos_type(target);
    }

    off_type LogicalPos() const noexcept
    {
        if (__reading) {
            if (!Conv())
                return __base + (off_type)((this->gptr() - this->eback()) * S);
            // Characters × width is not a byte count when the width varies,
            // and length() is the virtual whose whole job is answering the
            // question that replaces it: how many of the bytes in __ext did
            // the characters up to gptr() consume. The state passed in is a
            // fresh one because this filebuf refuses to open over a
            // state-dependent facet — see open().
            mbstate_t st{};
            return __base + (off_type)Cvt().length(
                                st, __ext, __ext + __extUsed,
                                (size_t)(this->gptr() - this->eback()));
        }
        if (__writing) {
            if (!Conv())
                return __base + (off_type)((this->pptr() - this->pbase()) * S);
            // What the buffered characters will WEIGH is not known without
            // converting them, and converting has a side effect nobody asked
            // for here. Every caller that needs an exact position while
            // writing flushes first, after which the put area is empty and
            // this is exactly __base; showmanyc, the one that does not,
            // answers 0 while writing.
            return __base;
        }
        return __base;
    }

    uint64_t EndOffset() const noexcept
    {
        const int64_t n = ::current_size(__c);
        return n > 0 ? (uint64_t)n : 0u;
    }

    void DropAreas() noexcept
    {
        this->setg(nullptr, nullptr, nullptr);
        this->setp(nullptr, nullptr);
        __reading = false;
        __writing = false;
    }

    // Push out whatever the put area holds and leave it empty, with __base
    // re-anchored at the resulting position. In append mode the write goes to
    // the end of the file whatever the position was — which is what "a"
    // means, and why the position after an append is the new end.
    bool FlushPut()
    {
        if (!__writing) return true;
        const streamsize n = this->pptr() - this->pbase();
        if (n > 0) {
            const uint64_t at = __append ? EndOffset() : (uint64_t)__base;
            if (::current_seek(__c, at) != 0) return false;

            if (!Conv()) {
                const int w = ::current_write(__c, this->pbase(), (size_t)(n * S));
                if (w != (int)(n * S)) return false;
                __base = (off_type)(at + (uint64_t)(n * S));
            } else {
                // Convert in as many passes as the external buffer needs. It
                // holds a full character buffer's worth by construction, so
                // one pass normally suffices; the loop is what makes "one
                // pass" a fact rather than a hope.
                const char_type       *from = this->pbase();
                const char_type *const end  = this->pptr();
                uint64_t               wrote = 0;
                while (from < end) {
                    const char_type *fn = nullptr;
                    char            *tn = nullptr;
                    mbstate_t        st{};
                    const codecvt_base::result r =
                        Cvt().out(st, from, end, fn, __ext, __ext + __extcap, tn);
                    // error is a character no byte sequence can carry — an
                    // unpaired surrogate, or a value past U+10FFFF. The file
                    // keeps what was already written and the stream goes bad,
                    // which is what a failed flush means everywhere else.
                    if (r == codecvt_base::error) return false;
                    const streamsize bytes = (streamsize)(tn - __ext);
                    if (bytes <= 0 || fn == from) return false;  // no progress
                    if (::current_write(__c, __ext, (size_t)bytes) != (int)bytes)
                        return false;
                    wrote += (uint64_t)bytes;
                    from = fn;
                }
                __base = (off_type)(at + wrote);
            }
        }
        this->setp(__buf, __buf + __bufn);
        return true;
    }

    bool EnterWrite()
    {
        if (__writing) return true;
        const off_type at = LogicalPos();
        DropAreas();
        __base = at;
        this->setp(__buf, __buf + __bufn);
        __writing = true;
        return true;
    }

    // Hand everything over to a moved-to filebuf and leave this one closed
    // but usable — a moved-from streambuf must still be destructible and
    // re-openable, not merely not-crash.
    void Disown() noexcept
    {
        this->setg(nullptr, nullptr, nullptr);
        this->setp(nullptr, nullptr);
        __c        = nullptr;
        __buf      = nullptr;
        __bufn     = 0;
        __owns     = false;
        __base     = 0;
        __reading  = false;
        __writing  = false;
        __canRead  = false;
        __canWrite = false;
        __append   = false;
        __ext      = nullptr;
        __extcap   = 0;
        __extUsed  = 0;
        __mode     = ios_base::openmode{};
    }

    ::Current         *__c    = nullptr;
    ios_base::openmode __mode{};
    char_type         *__buf  = nullptr;
    streamsize         __bufn = 0;
    bool               __owns = false;
    off_type           __base = 0;
    // The external side, allocated only when the facet converts. __extUsed is
    // how many of the bytes in __ext the characters now in the get area
    // actually consumed — the anchor LogicalPos() measures against.
    char              *__ext     = nullptr;
    streamsize         __extcap  = 0;
    streamsize         __extUsed = 0;
    bool               __reading  = false;
    bool               __writing  = false;
    bool               __canRead  = false;
    bool               __canWrite = false;
    bool               __append   = false;
    // setbuf's request, remembered until the next open.
    char_type         *__userBuf  = nullptr;
    streamsize         __userN    = 0;
    bool               __unbufReq = false;
};

template <class CharT, class Traits>
void swap(basic_filebuf<CharT, Traits> &a, basic_filebuf<CharT, Traits> &b)
{
    a.swap(b);
}

// ── basic_ifstream<CharT,Traits> [ifstream] ─────────────────────────────
// Every constructor and open() forces `mode | ios_base::in`, per the Effects
// clauses: an ifstream is always at least readable. The move members carry
// the same rdbuf() fixup <sstream>'s wrappers document — basic_ios::move()
// nulls the moved-into object's rdbuf() pointer, which is right for a bare
// basic_istream and wrong for a class that owns its buffer.

template <class CharT, class Traits>
class basic_ifstream : public basic_istream<CharT, Traits> {
public:
    using char_type          = CharT;
    using traits_type        = Traits;
    using int_type           = typename Traits::int_type;
    using pos_type           = typename Traits::pos_type;
    using off_type           = typename Traits::off_type;
    using native_handle_type = typename basic_filebuf<CharT, Traits>::native_handle_type;

    basic_ifstream() : basic_istream<CharT, Traits>(&sb_) {}

    explicit basic_ifstream(const char *s, ios_base::openmode mode = ios_base::in)
        : basic_istream<CharT, Traits>(&sb_)
    {
        if (!sb_.open(s, mode | ios_base::in)) this->setstate(ios_base::failbit);
    }
    explicit basic_ifstream(const string &s, ios_base::openmode mode = ios_base::in)
        : basic_ifstream(s.c_str(), mode)
    {
    }

    basic_ifstream(const basic_ifstream &)            = delete;
    basic_ifstream &operator=(const basic_ifstream &) = delete;

    basic_ifstream(basic_ifstream &&rhs)
        : basic_istream<CharT, Traits>(std::move(rhs)), sb_(std::move(rhs.sb_))
    {
        this->set_rdbuf(&sb_);
    }
    basic_ifstream &operator=(basic_ifstream &&rhs)
    {
        basic_istream<CharT, Traits>::operator=(std::move(rhs));
        sb_ = std::move(rhs.sb_);
        this->set_rdbuf(&sb_);
        return *this;
    }
    void swap(basic_ifstream &rhs)
    {
        basic_istream<CharT, Traits>::swap(rhs);
        sb_.swap(rhs.sb_);
    }

    basic_filebuf<CharT, Traits> *rdbuf() const
    {
        return const_cast<basic_filebuf<CharT, Traits> *>(&sb_);
    }
    bool is_open() const { return sb_.is_open(); }

    void open(const char *s, ios_base::openmode mode = ios_base::in)
    {
        if (sb_.open(s, mode | ios_base::in)) this->clear();
        else                                  this->setstate(ios_base::failbit);
    }
    void open(const string &s, ios_base::openmode mode = ios_base::in)
    {
        open(s.c_str(), mode);
    }
    void close()
    {
        if (!sb_.close()) this->setstate(ios_base::failbit);
    }

    native_handle_type native_handle() const noexcept { return sb_.native_handle(); }

private:
    basic_filebuf<CharT, Traits> sb_;
};

template <class CharT, class Traits>
void swap(basic_ifstream<CharT, Traits> &a, basic_ifstream<CharT, Traits> &b)
{
    a.swap(b);
}

