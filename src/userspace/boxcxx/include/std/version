// boxcxx — <version>
//
// Library feature-test macros [version.syn]. This is the one header a
// translation unit can include to probe every library feature-test macro
// in one place. Per [support.limits.general], each macro must ALSO be
// visible to a translation unit that includes only the macro's OWNING
// header (not <version>) — so the actual #define bodies live in shared
// leaf files under __bits/, one per header or per header-family, and each
// owning header includes its own leaf directly. <version> just pulls in
// the complete set. <coroutine> and <generator> self-declare their own
// single macro directly, a separate, pre-existing pattern this file
// doesn't change.
//
// The baseline is C++23: every value is cross-checked against N4950's own
// [version.syn] and against libstdc++'s bits/version.def, and a macro whose
// C++26 feature is not implemented keeps its C++23 value rather than the
// later, DR-applied one a reference library may ship (__cpp_lib_out_ptr
// stays 202106L, not P2833's 202311L; __cpp_lib_bind_back stays 202202L,
// not P2714's 202306L).
//
// On top of that baseline boxcxx implements named C++26 features, and from
// Ф32 on it CLAIMS THEIR MACROS — unconditionally, with no __cplusplus
// gate. That is a deliberate deviation from both reference libraries, which
// hide every C++26 macro behind `__cplusplus > 202302L`, and the reason is
// what a feature-test macro is for: it answers "does the library in front
// of me have this?", not "which -std did you pass?". boxcxx is compiled at
// -std=gnu++23 and std::views::concat is genuinely reachable there, so
// hiding the macro would be a lie by omission — the far worse direction of
// the two. libstdc++ and libc++ gate because they must not put C++26 names
// into a strictly-conforming C++23 program; boxcxx is the single library of
// a single target and has no such second audience.
//
// This is not a new posture so much as an honest one: three C++26 features
// were already in the tree by owner decision before Ф32 — P2510R3's pointer
// '0' presentation, enable_nonlocking_formatter_optimization with its
// [time.format] / [format.tuple] rules, and P2495R3's string_view-like
// basic_stringbuf constructors — the library simply stayed silent about
// them. Every C++26 macro that IS claimed names its paper at the definition
// site in the owning leaf.
//
// A macro appears here only if the feature it names is COMPLETE. A macro
// that overstates is worse than a missing one: it makes portable code take
// a branch this library cannot honour. Everything verified as partial is
// listed below with the specific reason.
#ifndef BOXCXX_VERSION
#define BOXCXX_VERSION

#include <__bits/version_algorithm>       // <algorithm>
#include <__bits/version_any>             // <any>
#include <__bits/version_array>           // <array>
#include <__bits/version_atomic>          // <atomic> (+ <memory>)
#include <__bits/version_bit>             // <bit>
#include <__bits/version_bitset>          // <bitset>
#include <__bits/version_charconv>        // <charconv>
#include <__bits/version_chrono>          // <chrono>
#include <__bits/version_cmath>           // <cmath>
#include <__bits/version_compare>         // <compare>
#include <__bits/version_concepts>        // <concepts> (+ <compare>)
#include <__bits/version_complex>         // <complex>
#include <__bits/version_containers>      // container family (+ <memory>)
#include <__bits/version_cstddef>         // <cstddef>
#include <__bits/version_exception>       // <exception>
#include <__bits/version_expected>        // <expected>
#include <__bits/version_flat_map>        // <flat_map>
#include <__bits/version_flat_set>        // <flat_set>
#include <__bits/version_format>          // <format>
#include <__bits/version_functional>      // <functional>
#include <__bits/version_iostreams>       // <ios>/<streambuf>/<iomanip>
#include <__bits/version_iterator>        // <iterator> (+ <array>)
#include <__bits/version_memory>          // <memory>
#include <__bits/version_memory_resource> // <memory_resource>
#include <__bits/version_mutex>           // <mutex>
#include <__bits/version_new>             // <new>
#include <__bits/version_numbers>         // <numbers>
#include <__bits/version_numeric>         // <numeric>
#include <__bits/version_optional>        // <optional>
#include <__bits/version_print>           // <print> (+ <ostream>)
#include <__bits/version_ranges>          // <ranges>
#include <__bits/version_source_location> // <source_location>
#include <__bits/version_span>            // <span>
#include <__bits/version_string>          // <string>/<string_view>
#include <__bits/version_sync>            // <latch>/<semaphore>/<shared_mutex>
#include <__bits/version_thread>          // <thread>/<stop_token>
#include <__bits/version_tuple>           // <tuple>
#include <__bits/version_type_traits>     // <type_traits>
#include <__bits/version_typeinfo>        // <typeinfo>
#include <__bits/version_utility>         // <utility> (+ <tuple>)
#include <__bits/version_variant>         // <variant>

// <coroutine> and <generator> self-declare their own single macro, a
// pre-existing pattern with no leaf. Repeating the two definitions here —
// both sides are #ifndef-guarded, so include order is irrelevant — is what
// makes <version> actually complete without dragging those two whole
// headers in.
#ifndef __cpp_lib_coroutine
#  define __cpp_lib_coroutine 201902L
#endif
#ifndef __cpp_lib_generator
#  define __cpp_lib_generator 202207L
#endif

// ── Deliberately NOT defined ────────────────────────────────────────────
//
// Each line names a C++23 feature-test macro whose feature boxcxx does not
// implement completely — for nine of them, does not implement at all,
// because the owning header does not exist — with the exact reason. This
// list is the backlog: when the reason is fixed, the macro moves into the
// owning header's leaf.
//
// C++26 macros are NOT listed here. This list is the C++23 backlog and is
// meant to be finishable; the C++26 surface is an open frontier, and
// enumerating everything not yet built there would say nothing an absent
// macro does not already say. A C++26 macro is defined here only once its
// feature is complete, by the same rule as everything else.
//
// algorithm_iterator_requirements
//     P2408R5 is a pure requirements relaxation spanning every algorithm
//     in [algorithms], [numeric.ops] and [specialized.algorithms]. Spot
//     checks pass (std::sort over views::zip, std::find/std::count/
//     std::accumulate over views::iota, std::uninitialized_copy from
//     views::iota), but a whole-clause guarantee cannot be established by
//     inspection, so it is not claimed.
// char8_t                  [version.syn] names <locale> among this macro's
//                          owning headers, and it means it: P0482R6 adds
//                          codecvt<char16_t, char8_t, mbstate_t>,
//                          codecvt<char32_t, char8_t, mbstate_t> and their
//                          _byname forms to [locale.syn]. boxcxx's <locale>
//                          has no facets AT ALL (a permanent, owner-approved
//                          exclusion -- CONFORMANCE §1.2), and there is no
//                          <filesystem> for path's char8_t members either,
//                          so this macro can never be claimed here. That is
//                          the whole reason, and it is NOT the one this
//                          entry gave before -- it said pmr::u8string was
//                          the last gap and the macro was "one alias away",
//                          which was measured and is wrong. pmr::u8string
//                          exists as of Ф31e-g-3, with pmr::basic_string
//                          and pmr::forward_list, and the macro is no
//                          closer. Everything else P0482R6 asks
//                          for -- char8_t, u8string, u8string_view,
//                          char_traits<char8_t>, atomic_char8_t,
//                          hash<u8string>, numeric_limits<char8_t> and the
//                          deleted <ostream> inserters (Ф31e-a) -- is
//                          present and verified.
// chrono                   <chrono> excludes time zones by design: no
//                          tzdb, time_zone, zoned_time or leap seconds.
// constexpr_bitset         every bit operation IS constexpr, but the
//                          basic_string-taking constructor bitset(str, pos,
//                          n, zero, one) and both to_string() forms are not
//                          usable in constant evaluation -- same root cause
//                          as constexpr_string below (they touch
//                          basic_string, which is not constexpr).
// constexpr_cmath          fabs/ceil/floor/trunc/round/fmod/... are not
//                          constexpr.
// constexpr_string         basic_string is not constexpr at all (it needs
//                          the compiler-blessed constexpr allocator path).
// constexpr_vector         vector is not constexpr at all, same reason.
// execution                no <execution> header.
// filesystem               no <filesystem> header.
// format                   <format> is char-only: no wchar_t, no
//                          wformat_context, no wformat/wformat_to.
// formatters               formatter<thread::id, wchar_t> is absent, and
//                          there is no <stacktrace> / formatter<
//                          stacktrace_entry> at all.
// is_implicit_lifetime     the trait cannot be written correctly without
//                          compiler support, and x86_64-elf-g++ 15.2.0 has
//                          no __builtin_is_implicit_lifetime (measured; nor
//                          does libstdc++ 15 define the macro). A
//                          library-only approximation gets a whole class of
//                          type wrong in each direction: [class.prop]/9 asks
//                          for "an aggregate whose destructor is not
//                          user-provided", and no trait can tell a
//                          destructor that is non-trivial because the USER
//                          wrote it (struct S { int x; ~S(){} } -- NOT an
//                          implicit-lifetime type) from one that is
//                          non-trivial because a MEMBER made it so
//                          (struct S { std::string s; } -- which IS one).
//                          std::start_lifetime_as ships without enforcing
//                          that half of its Mandates for the same reason,
//                          and says so at the call site.
// mdspan                   no <mdspan> header.
// modules                  no `import std;` — boxcxx ships headers only.
// parallel_algorithm       no <execution>, so no ExecutionPolicy overloads.
// ranges                   the widest macro in [version.syn] — it stands for
//                          the whole of [ranges] plus [specialized.
//                          algorithms] — and 23 of the entities it promises
//                          were absent. **All 23 now exist**, closed across
//                          Ф31e-b and Ф31e-e: the thirteen [range.access]
//                          CPOs and ssize-as-a-CPO (b-1); take_while,
//                          drop_while and ranges::is_permutation (b-2); and
//                          in e, the fourteen-name ranges:: specialized-
//                          memory family, range_rvalue_reference_t,
//                          range_common_reference_t, subrange's range
//                          constructors AND the two guides that were useless
//                          without them, and views::istream /
//                          basic_istream_view / istream_view. Ф31e-e also
//                          added P2387R3's range_adaptor_closure, which the
//                          202202L step of this macro requires.
//                          **The macro is still not defined, for a reason
//                          that is now entirely different and much narrower.**
//                          Its C++23 value is not one number the field agrees
//                          on — LWG 3931 exists because FOUR papers bumped
//                          this one macro (P2387R3, P2494R2, P2602R2,
//                          P2609R3); the C++23 working drafts reached 202302L,
//                          libc++ 22 reports 202211L under -std=c++23, and
//                          libstdc++ gates P2494R2 on >= 202207L. Of those
//                          four, only P2387R3 is implemented and verified
//                          here. The other three are whole-clause
//                          requirements relaxations, and a whole-clause
//                          guarantee cannot be established by inspection —
//                          the same bar that keeps
//                          algorithm_iterator_requirements above undefined.
//                          Defining it at a value this library cannot stand
//                          behind would be exactly the overstatement this
//                          file exists to prevent.
// result_of_sfinae         std::result_of does not exist (removed in
//                          C++20); the macro names exactly that template.
// spanstream               no <spanstream> header.
// stacktrace               no <stacktrace> header.
// stdatomic_h              no <stdatomic.h> header.
// syncbuf                  no <syncbuf> header.

#endif // BOXCXX_VERSION
