# Build artifacts
build/

# macOS metadata
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# macOS disk images
*.dmg
*.sparseimage

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Debug
*.log


*.o
*.a
*.bin
*.elf
*.backup

# Host build tools, each compiled from the .c beside it by a Makefile rule.
# They are build products that happen to live outside build/ — and one of them
# was tracked for years, so a macOS binary rode in the repository and every
# edit to its source produced a second, meaningless diff of 53 kilobytes.
tools/nameplate
tools/create_tagfs
tools/buildplate

# Compiler-generated header-dependency files (-MMD). One per object; they are
# build output, not source, and every clean target removes them.
*.d

# Build stamps: one recipe per sub-make, not one per binary (see Makefile).
src/userspace/apps/.apps.stamp
src/userspace/utils/.utils.stamp

# The display's build key mark (`make MEASURE=on`, display/Makefile).
src/userspace/display/.measure.*

# Saved reference pages read during a session (OSDev threads and wiki copies).
# Kept on disk on purpose — they are the material a wave of work was read
# against — but they are somebody else's HTML, not this repository's source.
osdev_other/

# Photographs of the board taken during a real-hardware run.
*.jpeg
*.jpg

# Written by tooling that runs inside a session, not by this project.
.claude/hook-log.txt
.claude/design-context.json
boardlogs/

# Python bytecode
__pycache__/
*.pyc
